% yeban-manual.sty -- shared style for the Yeban manual set.
% Engine: XeLaTeX. Chinese volumes load ctex before this package;
% English volumes load fontspec only. Keep package deps minimal so a
% stock TeX Live (scheme-medium + ctex + tikz) can build every volume.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{yeban-manual}[2026/11/25 Yeban manual shared style]

\RequirePackage[a4paper,margin=2.2cm,headheight=28pt]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{caption}
\RequirePackage{amsmath}
\RequirePackage{tikz}
% Chapters place nodes with the positioning syntax (below=of,
% right=of), compute coordinates with calc ($(a)+(1,0)$), and draw
% on background layers; load those libraries centrally so every
% volume builds without per-volume setup.
\usetikzlibrary{positioning,calc,backgrounds,arrows,arrows.meta,decorations.pathreplacing}
% English volumes quote Chinese classical texts in the original
% (chapter epigraphs keep the source text plus a translation), so
% they need a CJK fallback font; Chinese volumes already load ctex.
\@ifpackageloaded{ctex}{}{%
  \RequirePackage{xeCJK}%
  \setCJKmainfont{Noto Serif CJK SC}%
  \setCJKsansfont{Noto Sans CJK SC}%
}
\RequirePackage{makeidx}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
% Chapters name identifiers with underscores inside \texttt and
% backtick code spans (pitch_keycenter, tape_drive); the underscore
% package typesets _ in text mode while keeping math subscripts.
\RequirePackage{underscore}
\RequirePackage[colorlinks=true,linkcolor=yebanblue,urlcolor=yebanblue,citecolor=yebanblue]{hyperref}

\definecolor{yebanblue}{RGB}{31,78,120}
\definecolor{yebangrey}{RGB}{89,89,89}
\definecolor{yebanboxbg}{RGB}{240,245,250}
\definecolor{yebanwarnbg}{RGB}{252,243,230}

\setlist{itemsep=2pt,topsep=4pt}
\captionsetup{font=small,labelfont=bf}
\titleformat{\chapter}[display]{\normalfont\huge\bfseries\color{yebanblue}}{\chaptertitlename\ \thechapter}{12pt}{\Huge\raggedright\hyphenpenalty=10000}
\titleformat{\section}{\normalfont\Large\bfseries\color{yebanblue}\hyphenpenalty=10000}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalfont\large\bfseries\hyphenpenalty=10000}{\thesubsection}{0.6em}{}
% Keep headings with their first lines: never strand a heading at a page foot.
\let\yeban@section\section
\renewcommand{\section}{\needspace{11\baselineskip}\yeban@section}
\let\yeban@subsection\subsection
\renewcommand{\subsection}{\needspace{8\baselineskip}\yeban@subsection}
\emergencystretch=3em
\widowpenalty=10000
\clubpenalty=10000
\setlength{\tabcolsep}{4pt}
\AtBeginEnvironment{table}{\small\setlength{\tabcolsep}{4pt}}
\AtBeginEnvironment{longtable}{\small\setlength{\tabcolsep}{4pt}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\begin{minipage}[t]{0.84\textwidth}\nouppercase{\leftmark}\end{minipage}}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}

% Box built from colorbox+minipage only (no tcolorbox dependency).
\newcommand{\yebanbox}[2]{%
  \par\smallskip\noindent
  \colorbox{#1}{\begin{minipage}{\dimexpr\textwidth-2\fboxsep\relax}#2\end{minipage}}%
  \par\smallskip}
% tipbox/warnbox are used as environments at every call site; capture the
% body in an lrbox so the whole text lands inside the colour box.
\@ifpackageloaded{ctex}{%
  \newcommand{\yeban@tip@label}{提示.}%
  \newcommand{\yeban@note@label}{注意.}%
  \newcommand{\yeban@ex@label}{动手练习.}%
  \newcommand{\yeban@help@label}{帮助主题映射.}%
}{%
  \newcommand{\yeban@tip@label}{Tip.}%
  \newcommand{\yeban@note@label}{Note.}%
  \newcommand{\yeban@ex@label}{Exercise.}%
  \newcommand{\yeban@help@label}{Help-topic mapping.}%
}
\newsavebox{\yeban@box}
\newenvironment{tipbox}{\par\smallskip\noindent\begin{lrbox}{\yeban@box}\begin{minipage}{\dimexpr\textwidth-2\fboxsep\relax}\textbf{\yeban@tip@label}\ }{\end{minipage}\end{lrbox}\colorbox{yebanboxbg}{\usebox{\yeban@box}}\par\smallskip}
\newenvironment{warnbox}{\par\smallskip\noindent\begin{lrbox}{\yeban@box}\begin{minipage}{\dimexpr\textwidth-2\fboxsep\relax}\textbf{\yeban@note@label}\ }{\end{minipage}\end{lrbox}\colorbox{yebanwarnbg}{\usebox{\yeban@box}}\par\smallskip}
\newcommand{\zhbox}[2]{\yebanbox{#1}{#2}}

% Arity compatibility (2026-11-26 assembly): chapters use
% \screenshot{name}{caption} (165 sites) and a legacy 3-arg form
% whose third argument duplicates the caption (9 sites, all in
% music-theory/en); \term{term}{index} (104 sites) and \term{term}
% (50 sites). One macro-side compatibility layer covers both forms
% instead of rewriting 59 call sites. A non-duplicate third
% \screenshot argument warns loudly instead of being dropped.
\RequirePackage{xparse}

% Screenshot: load a real UI capture from <volume>/figures/ when it
% exists; otherwise keep the old placeholder and emit a loud compile
% warning.  The build script runs inside <volume>/<lang>/, so the shared
% figures directory is one level up.  A second local figures/ lookup is
% kept for a volume built from its own root.
\newcommand{\yeban@includegraphics}[1]{%
  \includegraphics[width=\linewidth,height=0.72\textheight,keepaspectratio]{#1}}
\NewDocumentCommand{\screenshot}{m m g}{%
  \IfValueT{#3}{%
    \def\yeban@ss@third{#3}%
    \def\yeban@ss@caption{#2}%
    \ifx\yeban@ss@third\yeban@ss@caption\else
      \PackageWarning{yeban-manual}{\string\screenshot{#1}: third argument differs from caption and is ignored}%
    \fi}%
  \begin{figure}[htbp]
    \centering
    \IfFileExists{../figures/#1.png}{%
      \yeban@includegraphics{../figures/#1.png}%
    }{%
      \IfFileExists{figures/#1.png}{%
        \yeban@includegraphics{figures/#1.png}%
      }{%
        \PackageWarning{yeban-manual}{MISSING SCREENSHOT: figures/#1.png (volume-relative); placeholder kept}%
        \typeout{!! yeban-manual: MISSING SCREENSHOT #1}%
        \fbox{\begin{minipage}[c][5.2cm][c]{0.82\textwidth}
          \centering\color{yebangrey}\textbf{Screenshot placeholder}\\[4pt]
          \texttt{#1}
        \end{minipage}}%
      }%
    }%
    \caption{#2}
    \label{fig:#1}
  \end{figure}}

% Bilingual term: \term{轨道}{track} prints the term and indexes it;
% \term{轨道} indexes the term itself.
\NewDocumentCommand{\term}{m g}{#1\IfValueTF{#2}{\index{#2}}{\index{#1}}}

% Classical epigraph at the top right of the chapter opening:
% right-aligned block (kai/large original, small source under it),
% then a clear blank gap. The gloss is a left-aligned body lead-in,
% not part of the epigraph block.
% \classquote{original}{source}{gloss}; source and gloss may be
% empty (chapter mottos use the same block).
\newcommand{\classquote}[3]{%
  \par\vspace{6pt}%
  \begin{flushright}%
    \begin{minipage}{0.70\textwidth}\raggedleft
      \@ifpackageloaded{ctex}{{\kaishu\Large #1}}{{\Large #1}}\par
      \def\yeban@cq@src{#2}\ifx\yeban@cq@src\empty\else
        \vspace{3pt}{\small\color{yebangrey}—— #2}\par\fi
    \end{minipage}%
  \end{flushright}%
  \vspace{1.2cm}%
  \def\yeban@cq@gloss{#3}\ifx\yeban@cq@gloss\empty\else
    \par\noindent{\small #3}\par\vspace{0.8cm}\fi}

\newenvironment{exercise}{\par\smallskip\noindent\textbf{\yeban@ex@label}\ }{\par\smallskip}
\newenvironment{helpmapping}{\par\smallskip\noindent\textbf{\yeban@help@label}\par\smallskip}{\par\smallskip}


% Concept-drawing primitives for chapters that intentionally have no UI shot.
% The chapter supplies the figure/tikzpicture wrapper, so the source tree
% itself records one real TikZ picture per zero-image chapter.
\newcommand{\yebangenreddraw}[4]{%
  \node[font=\small\bfseries] at (3.8,4.9) {#1};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=3.2cm,minimum height=0.95cm,align=center] (lo) at (0,3.8) {低频 / Low\\#2};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=3.2cm,minimum height=0.95cm,align=center] (mi) at (3.8,3.8) {中频 / Mid\\#3};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=3.2cm,minimum height=0.95cm,align=center] (hi) at (7.6,3.8) {高频 / High\\#4};
  \draw[->,thick,yebanblue] (lo) -- (mi); \draw[->,thick,yebanblue] (mi) -- (hi);
  \draw[step=0.42cm,thin,gray!55] (0,0.1) grid (3.6,1.45);
  \node[anchor=north] at (1.8,-0.05) {鼓组网格 / Drum grid: 16 bars};
  \foreach \x in {1,...,8} {\draw[gray!70] (\x*0.42,0.1) -- (\x*0.42,1.45);}
  \foreach \x in {0,4} {\fill[yebanblue!35] (\x*0.42,0.1) rectangle ++(0.42,0.26);}
  \foreach \x in {2,6} {\fill[yebangrey!40] (\x*0.42,0.36) rectangle ++(0.42,0.26);}
  \foreach \x in {1,3,5,7} {\fill[yebanblue!18] (\x*0.42,0.62) rectangle ++(0.42,0.26);}
  \node[anchor=north] at (6.3,-0.05) {段落能量 / Section energy};
  \draw[->,gray] (4.4,0.1) -- (4.4,2.1) node[above,font=\scriptsize] {E};
  \draw[->,gray] (4.4,0.1) -- (8.8,0.1) node[right,font=\scriptsize] {时间 / time};
  \draw[very thick,yebanblue] (4.6,0.55) .. controls (5.2,0.35) and (5.6,1.6) .. (6.4,1.75)
    .. controls (7.2,1.9) and (7.8,1.1) .. (8.6,0.55);
  \node[anchor=north] at (6.3,2.4) {起 / 展开 / 高潮 / 收束};
  \draw[decorate,decoration={brace,amplitude=4pt}] (4.6,0.5) -- (8.6,0.5);
}
\newcommand{\yebaniconicdraw}{%
  \node[font=\small\bfseries] at (3.8,5.0) {808 / 909 / 303};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=2.2cm,minimum height=0.9cm,align=center] (a) at (0,3.9) {TR-808\\节奏 / rhythm};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=2.2cm,minimum height=0.9cm,align=center] (b) at (3.8,3.9) {TR-909\\节奏 / rhythm};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=2.2cm,minimum height=0.9cm,align=center] (c) at (7.6,3.9) {TB-303\\低音 / bass};
  \draw[->,thick] (a) -- (b); \draw[->,thick] (b) -- (c);
  \node[anchor=west] at (0,2.6) {\textbf{信号流 / signal flow}};
  \draw[->,very thick,yebanblue] (0,2.0) -- (7.6,2.0);
  \node[fill=white,draw,rounded corners] at (1.8,2.0) {Sequencer};
  \node[fill=white,draw,rounded corners] at (5.8,2.0) {Filter / Mix};
  \node[anchor=west,fill=white,inner sep=1pt] at (0,1.2) {\textbf{面板布局 / panel layout}};
  \foreach \x/\lab in {0/KICK,2.5/SNARE,5/HAT,7.5/MIX} {
    \draw[rounded corners,fill=yebanboxbg] (\x,0.05) rectangle ++(2.0,0.95);
    \node at (\x+1,0.75) {\lab};
    \foreach \k in {0.35,0.7,1.05,1.4} {\draw[fill=yebangrey] (\x+\k,0.35) circle (0.09);}
  }
}
\newcommand{\yebanflowdraw}{%
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=2.4cm,minimum height=0.9cm] (src) {Source / 音源};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=2.4cm,minimum height=0.9cm,right=of src] (ins) {Insert / 设备链};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=2.4cm,minimum height=0.9cm,right=of ins] (bus) {Bus / 总线};
  \node[draw,rounded corners,fill=yebanboxbg,minimum width=2.4cm,minimum height=0.9cm,right=of bus] (out) {Master / 输出};
  \draw[->,very thick,yebanblue] (src) -- (ins); \draw[->,very thick,yebanblue] (ins) -- (bus); \draw[->,very thick,yebanblue] (bus) -- (out);
  \node[below=5mm of ins,align=center] {增益 / 染色\\动态 / 空间};
  \node[below=5mm of bus,align=center] {发送 / 回收\\电平预算};
}
