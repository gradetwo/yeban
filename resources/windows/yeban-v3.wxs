<?xml version="1.0" encoding="UTF-8"?>
<!--
  夜半 (Yeban) Windows MSI 的 WiX **v3** 源文件 —— 与 yeban.wxs (v4 语法) 是同一
  个包的两种方言, 由 scripts/dev/package-windows-msi.sh 按实际找到的工具链二选一。

  为什么需要 v3 版: runner 上 `choco install wixtoolset` 给的是 WiX 3.14.1
  (candle/light, 没有 v4 的 wix CLI) —— 2026-11-16 nightly 分支 run 43820577463
  的 Windows 腿日志实证。故脚本先找 v4 的 wix, 找不到就用 v3 的 candle+light
  编这一份。两份的产品身份 (UpgradeCode / 组件 GUID) 必须逐字一致, 改一处改两处。

  约定同 yeban.wxs: 版本占位 `__YEBAN_VERSION__` 由脚本替换; 源目录经
  candle 的 `-d SourceDir=<stage 目录>` 传入; 元数据只用 ASCII (codepage 无实证)。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Yeban" Language="1033" Version="__YEBAN_VERSION__"
           Manufacturer="Yeban Contributors"
           UpgradeCode="{71181B90-2B67-4E6F-A03F-4D5F037B912B}">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Yeban is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Yeban">
          <Component Id="cmp.MainExecutables" Guid="{B041BD78-45FD-40BE-82C2-09D5BDB6E784}">
            <File Id="fil.YebanApp" Source="$(var.SourceDir)\yeban-app.exe" KeyPath="yes" />
            <File Id="fil.YebanMcp" Source="$(var.SourceDir)\yeban-mcp.exe" />
            <File Id="fil.License" Source="$(var.SourceDir)\LICENSE" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="dir.ProgramsYeban" Name="Yeban">
          <Component Id="cmp.StartMenuShortcut" Guid="{42FA4724-7992-4ED4-B14A-244220AE7C3B}">
            <Shortcut Id="sct.Yeban" Name="Yeban" Description="Yeban - AI-native DAW"
                      Target="[INSTALLFOLDER]yeban-app.exe" WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="rmf.ProgramsYeban" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Yeban" Name="installed"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="fea.Main" Title="Yeban" Level="1">
      <ComponentRef Id="cmp.MainExecutables" />
      <ComponentRef Id="cmp.StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
