{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeban.org/schemas/ops.schema.json",
  "title": "StampedOp",
  "description": "Domain reversible operation log entry with provenance origin",
  "type": "object",
  "required": [
    "origin",
    "timestamp",
    "op"
  ],
  "properties": {
    "origin": {
      "description": "Op provenance. Unit variants serialize as plain strings; McpProposal carries {proposal_id, agent_name} and McpEdit carries {agent_name}; both serialize as externally tagged objects. Branch ORDER is part of the contract: oneOf[0] is the unit enum, oneOf[1] is McpProposal, oneOf[2] is McpEdit (two judges address branches by index).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "UserUi",
            "MidiInput",
            "UndoRedo",
            "AutomationRecord",
            "Import",
            "Migration"
          ]
        },
        {
          "type": "object",
          "required": [
            "McpProposal"
          ],
          "additionalProperties": false,
          "properties": {
            "McpProposal": {
              "type": "object",
              "required": [
                "proposal_id",
                "agent_name"
              ],
              "additionalProperties": false,
              "properties": {
                "proposal_id": {
                  "type": "string",
                  "description": "EntityId, 26-char Crockford Base32"
                },
                "agent_name": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "McpEdit"
          ],
          "additionalProperties": false,
          "properties": {
            "McpEdit": {
              "type": "object",
              "required": [
                "agent_name"
              ],
              "additionalProperties": false,
              "properties": {
                "agent_name": {
                  "type": "string",
                  "description": "Direct-edit agent name (no proposal identity: McpEdit never creates a proposal)"
                }
              }
            }
          }
        }
      ]
    },
    "timestamp": {
      "type": "integer"
    },
    "op": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "AddNote"
          ],
          "properties": {
            "AddNote": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "DeleteNote"
          ],
          "properties": {
            "DeleteNote": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "MoveNote"
          ],
          "properties": {
            "MoveNote": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "ModifyNoteVelocity"
          ],
          "properties": {
            "ModifyNoteVelocity": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "AddClipPlacement"
          ],
          "properties": {
            "AddClipPlacement": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveClipPlacement"
          ],
          "properties": {
            "RemoveClipPlacement": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "MoveClipPlacement"
          ],
          "properties": {
            "MoveClipPlacement": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "AddTrack"
          ],
          "properties": {
            "AddTrack": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveTrack"
          ],
          "properties": {
            "RemoveTrack": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "ConnectRouting"
          ],
          "properties": {
            "ConnectRouting": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "DisconnectRouting"
          ],
          "properties": {
            "DisconnectRouting": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "SetRoutingGain"
          ],
          "properties": {
            "SetRoutingGain": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "InsertDevice"
          ],
          "properties": {
            "InsertDevice": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveDevice"
          ],
          "properties": {
            "RemoveDevice": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "SetParam"
          ],
          "properties": {
            "SetParam": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "SetMacro"
          ],
          "properties": {
            "SetMacro": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "SetAutomationPoint"
          ],
          "properties": {
            "SetAutomationPoint": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveAutomationPoint"
          ],
          "properties": {
            "RemoveAutomationPoint": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "SetSection"
          ],
          "properties": {
            "SetSection": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveSection"
          ],
          "properties": {
            "RemoveSection": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "SetScene"
          ],
          "properties": {
            "SetScene": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveScene"
          ],
          "properties": {
            "RemoveScene": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "Batch"
          ],
          "properties": {
            "Batch": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "AddClip"
          ],
          "properties": {
            "AddClip": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveClip"
          ],
          "properties": {
            "RemoveClip": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveRoutingNode"
          ],
          "properties": {
            "RemoveRoutingNode": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "AddRoutingNode"
          ],
          "properties": {
            "AddRoutingNode": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "RemoveAutomationLane"
          ],
          "properties": {
            "RemoveAutomationLane": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "SetAutomationLane"
          ],
          "properties": {
            "SetAutomationLane": {
              "type": "object"
            }
          }
        }
,
        {
          "required": [
            "SetTrackMute"
          ],
          "properties": {
            "SetTrackMute": {
              "type": "object"
            }
          }
        },
        {
          "required": [
            "SetTrackSolo"
          ],
          "properties": {
            "SetTrackSolo": {
              "type": "object"
            }
          }
        }
      ],
      "description": "Domain reversible operation. oneOf must cover every Op variant: exactly one branch may match."
    }
  }
}
