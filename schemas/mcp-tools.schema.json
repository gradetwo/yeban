{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeban.org/schemas/mcp-tools.schema.json",
  "title": "YebanMcpTools",
  "description": "Standard JSON-RPC 2.0 interface and tool definitions for Yeban MCP. 根为 oneOf(ToolCall, ToolResponse)：工具调用与工具响应的样本都必须通过根校验，否则本契约只是一堆没人引用的类型定义（ADR-0001 D25）。",
  "definitions": {
    "ToolCall": {
      "type": "object",
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "yeban_open_project",
            "yeban_save_project",
            "yeban_close_project",
            "yeban_query_project",
            "yeban_propose_section",
            "yeban_edit_notes",
            "yeban_set_macro",
            "yeban_render_master",
            "yeban_merge_proposal",
            "yeban_reject_proposal",
            "yeban_undo",
            "yeban_redo",
            "yeban_edit_automation",
            "yeban_query_engine_state",
            "yeban_import_audio",
            "yeban_export_diagnostics"
          ]
        },
        "arguments": {
          "type": "object",
          "properties": {
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "yeban_undo"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/definitions/ExtensionToolArguments/$defs/yeban_undo"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "yeban_redo"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/definitions/ExtensionToolArguments/$defs/yeban_redo"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "yeban_edit_automation"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/definitions/ExtensionToolArguments/$defs/yeban_edit_automation"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "yeban_query_engine_state"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/definitions/ExtensionToolArguments/$defs/yeban_query_engine_state"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "yeban_import_audio"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/definitions/ExtensionToolArguments/$defs/yeban_import_audio"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "yeban_export_diagnostics"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/definitions/ExtensionToolArguments/$defs/yeban_export_diagnostics"
              }
            }
          }
        }
      ]
    },
    "ToolResponse": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "description": "工具级错误码。契约必须覆盖架构 §7.2 逐工具列出的并集：只看 schema 原有的 7 个值，会让 13 个领域失败（如 DISK_FULL / CLIP_NOT_FOUND / CONFLICT）产出被本 schema 判为非法的响应。本 enum 是 schema 原有集合与规范并集的联集（ADR-0001 D25）。",
              "enum": [
                "BUSY",
                "CLIP_NOT_FOUND",
                "CONFLICT",
                "CYCLE_DETECTED",
                "DISK_FULL",
                "ENTITY_NOT_FOUND",
                "FILE_NOT_FOUND",
                "INDEX_OUT_OF_BOUNDS",
                "INVALID_FIELD_SELECTOR",
                "INVALID_PARAMETER_RANGE",
                "IO_ERROR",
                "NO_ACTIVE_PROJECT",
                "OUT_OF_RANGE",
                "PERMISSION_DENIED",
                "PROJECT_LOCKED",
                "PROPOSAL_NOT_FOUND",
                "RENDER_FAILED",
                "ROUTING_CYCLE_DETECTED",
                "STYLE_NOT_FOUND",
                "TRACK_NOT_FOUND"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "ExtensionToolArguments": {
      "title": "ExtensionToolArguments",
      "description": "ADR-0001 D46 说\"十工具是起点不是上限, 扩充时必须同步本契约\"。本节的**五条**扩展工具(D45 的撤销入口 + D46 的三类能力: 自动化泳道 / 设备与引擎 / 音频导入)因此在这里逐条声明实参约束。判据 tests/contract.rs::extension_argument_constraints_match_the_registry 要求本节与 Rust 注册表(crate::tools::TOOLS)的声明**逐字段一致**, 且**既有十工具不得出现在本节**(参数语义未被改动), 因此这里不是第二份会漂移的手写 schema。",
      "type": "object",
      "$defs": {
        "yeban_undo": {
          "title": "yeban_undo",
          "type": "object",
          "description": "撤销最近 N 步领域操作 (默认 1)。与 UI 的 Cmd+Z 共用 crate::undo_session 的实现。",
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "description": "撤销/重做步数; 一次提交算一步 (Op::Batch 整批算一步)。缺省 = 1, 即一次 Cmd+Z / Cmd+Shift+Z。"
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          }
        },
        "yeban_redo": {
          "title": "yeban_redo",
          "type": "object",
          "description": "重做最近 N 步被撤销的领域操作 (默认 1)。与 UI 的 Cmd+Shift+Z 共用同一实现。",
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "description": "撤销/重做步数; 一次提交算一步 (Op::Batch 整批算一步)。缺省 = 1, 即一次 Cmd+Z / Cmd+Shift+Z。"
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          }
        },
        "yeban_edit_automation": {
          "title": "yeban_edit_automation",
          "type": "object",
          "description": "读某条自动化泳道的点与值 (走**唯一**求值入口 automation_value_at) 并写入一个点 (Op::SetAutomationPoint, 可逆)。lane 只接受与 project.json 逐字相同的变体名。",
          "properties": {
            "trackId": {
              "type": "string",
              "description": "目标音轨 EntityId (26 字符 ULID)"
            },
            "lane": {
              "type": "string",
              "description": "自动化目标变体名: TrackVolume | TrackPan | SendGain | DeviceParam | Macro"
            },
            "edgeId": {
              "type": "string",
              "description": "SendGain 必需: 路由边 EntityId"
            },
            "slotIndex": {
              "type": "integer",
              "description": "DeviceParam: 设备链插槽下标 (默认 0)"
            },
            "paramIndex": {
              "type": "integer",
              "description": "DeviceParam: 参数下标 (默认 0)"
            },
            "macroIndex": {
              "type": "integer",
              "description": "Macro: 宏下标 (默认 0)"
            },
            "ticks": {
              "type": "array",
              "description": "要读取自动化值的 tick 列表 (保持给定顺序; 最多 256 个)",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "point": {
              "type": "object",
              "description": "要写入的一个点 {tick, value, curve?}; 缺省 = 只读调用 (一位都不改)",
              "properties": {
                "tick": {
                  "type": "integer",
                  "minimum": 0
                },
                "value": {
                  "type": "number"
                },
                "curve": {
                  "type": "string",
                  "description": "Linear | Exponential | Logarithmic | SCurve (默认 Linear)"
                }
              }
            },
            "pointId": {
              "type": "string",
              "description": "点的显式 EntityId; 缺省由 (目标, tick) 确定性派生"
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          },
          "required": [
            "trackId",
            "lane"
          ]
        },
        "yeban_query_engine_state": {
          "title": "yeban_query_engine_state",
          "type": "object",
          "description": "查询某轨的设备链与引擎/会话读数 (采样率/缓冲/走带位置/是否播放)。只读: 三份状态各有唯一来源 (project.audio_config / SessionRuntimeState / 宿主注入的引擎镜像)。",
          "properties": {
            "trackId": {
              "type": "string",
              "description": "要展开设备链的音轨 EntityId; 缺省只报引擎与会话读数"
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          }
        },
        "yeban_import_audio": {
          "title": "yeban_import_audio",
          "type": "object",
          "description": "把会话资产池里的哈希或磁盘音频文件登记成 clip_pool 音频条目 (走既有 yeban-decode + Op::AddClip; PcmBudget 全程生效)。assetHash 与 path 恰好给一个。",
          "properties": {
            "name": {
              "type": "string",
              "description": "片段显示名"
            },
            "assetHash": {
              "type": "string",
              "description": "已在会话 CAS 池 (assets/{sha256}) 里的资产哈希; 与 path 恰好给一个"
            },
            "path": {
              "type": "string",
              "description": "磁盘音频文件路径 (WAV/FLAC/OGG); 与 assetHash 恰好给一个"
            },
            "gainDb": {
              "type": "number",
              "description": "片段增益 (dB); 默认 0.0"
            },
            "clipId": {
              "type": "string",
              "description": "片段的显式 EntityId; 缺省由 (来源, 名字, 增益) 确定性派生"
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "yeban_export_diagnostics": {
          "title": "yeban_export_diagnostics",
          "type": "object",
          "description": "把调试信息与相关文件采集并导出成 zip 诊断包 (人工触发, 供复现排查)。与 UI 的「导出诊断包」共用 crate::domain::diagnostics 的实现 (D56)。",
          "properties": {
            "outDir": {
              "type": "string",
              "description": "输出目录; 缺省为进程当前目录。"
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/ToolCall"
    },
    {
      "$ref": "#/definitions/ToolResponse"
    }
  ]
}
