{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeban.org/schemas/mcp-tools.schema.json",
  "title": "YebanMcpTools",
  "description": "Standard JSON-RPC 2.0 interface and tool definitions for Yeban MCP. 根为 oneOf(ToolCall, ToolResponse)：工具调用与工具响应的样本都必须通过根校验，否则本契约只是一堆没人引用的类型定义（ADR-0001 D25）。",
  "definitions": {
    "ToolCall": {
      "type": "object",
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "yeban_open_project",
            "yeban_save_project",
            "yeban_close_project",
            "yeban_query_project",
            "yeban_propose_section",
            "yeban_edit_notes",
            "yeban_set_macro",
            "yeban_render_master",
            "yeban_merge_proposal",
            "yeban_reject_proposal",
            "yeban_undo",
            "yeban_redo"
          ]
        },
        "arguments": {
          "type": "object",
          "properties": {
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "yeban_undo"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/definitions/ExtensionToolArguments/$defs/yeban_undo"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "yeban_redo"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "$ref": "#/definitions/ExtensionToolArguments/$defs/yeban_redo"
              }
            }
          }
        }
      ]
    },
    "ToolResponse": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ]
        },
        "data": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "description": "工具级错误码。契约必须覆盖架构 §7.2 逐工具列出的并集：只看 schema 原有的 7 个值，会让 13 个领域失败（如 DISK_FULL / CLIP_NOT_FOUND / CONFLICT）产出被本 schema 判为非法的响应。本 enum 是 schema 原有集合与规范并集的联集（ADR-0001 D25）。",
              "enum": [
                "BUSY",
                "CLIP_NOT_FOUND",
                "CONFLICT",
                "CYCLE_DETECTED",
                "DISK_FULL",
                "ENTITY_NOT_FOUND",
                "FILE_NOT_FOUND",
                "INDEX_OUT_OF_BOUNDS",
                "INVALID_FIELD_SELECTOR",
                "INVALID_PARAMETER_RANGE",
                "IO_ERROR",
                "NO_ACTIVE_PROJECT",
                "OUT_OF_RANGE",
                "PERMISSION_DENIED",
                "PROJECT_LOCKED",
                "PROPOSAL_NOT_FOUND",
                "RENDER_FAILED",
                "ROUTING_CYCLE_DETECTED",
                "STYLE_NOT_FOUND",
                "TRACK_NOT_FOUND"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "ExtensionToolArguments": {
      "title": "ExtensionToolArguments",
      "description": "ADR-0001 D46 说\"十工具是起点不是上限, 扩充时必须同步本契约\"。本节的**两条**扩展工具(D45 的撤销入口)因此在这里逐条声明实参约束 —— 含 `steps` 的类型 / 上下界 / 缺省值。判据 tests/contract.rs::extension_argument_constraints_match_the_registry 要求本节与 Rust 注册表(crate::tools::TOOLS)的声明**逐字段一致**, 因此这里不是第二份会漂移的手写 schema。",
      "type": "object",
      "$defs": {
        "yeban_undo": {
          "title": "yeban_undo",
          "type": "object",
          "description": "撤销最近 N 步领域操作 (默认 1)。与 UI 的 Cmd+Z 共用 crate::undo_session 的实现。",
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "description": "撤销/重做步数; 一次提交算一步 (Op::Batch 整批算一步)。缺省 = 1, 即一次 Cmd+Z / Cmd+Shift+Z。"
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          }
        },
        "yeban_redo": {
          "title": "yeban_redo",
          "type": "object",
          "description": "重做最近 N 步被撤销的领域操作 (默认 1)。与 UI 的 Cmd+Shift+Z 共用同一实现。",
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1,
              "description": "撤销/重做步数; 一次提交算一步 (Op::Batch 整批算一步)。缺省 = 1, 即一次 Cmd+Z / Cmd+Shift+Z。"
            },
            "dryRun": {
              "type": "boolean",
              "default": false
            },
            "idempotencyKey": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/ToolCall"
    },
    {
      "$ref": "#/definitions/ToolResponse"
    }
  ]
}
