import { Theme, TrackData, TimelineBlockData, Tokens, TooltipBubble } from "tokens.slint";

export component ArrangementViewport inherits Rectangle {
    in-out property <[TrackData]> tracks;
    // ⭐ D1/D2：轨道行电平柱接**引擎实时电平**（与混音台同一份 `track-meter-levels`）。
    // 以前这里的柱高绑的是 `trk.meter_peak`（工程/演示数据里的静态值），播放时纹丝不动；
    // 现在只要 `is-playing` 且该轨有实时值就用实时值，否则回落到静态值（保持 1920×1080 golden 不变）。
    in property <[float]> meter-levels: [];
    in property <bool> is-playing: false;
    // 电平值取值：播放中且该轨有实时值 → 用实时值（钳到 0..1）；否则回落到静态 `meter_peak`。
    // 用函数而不是内联三元，是为了两处电平柱（第一份/第二份轨道行）共用同一条判据。
    pure function meter-val(i: int) -> float {
        if (root.is-playing && root.meter-levels.length > i) {
            Math.min(1.0, Math.max(0.0, root.meter-levels[i]))
        } else {
            root.tracks[i].meter_peak
        }
    }
    in property <[string]> track-volumes: [];
    in-out property <[TimelineBlockData]> timeline-blocks;
    in-out property <int> selected-track-id: 1;
    in property <int> playhead-ticks: 0;
    in property <int> ticks-per-pixel: 30;
    in-out property <length> playhead-px: (root.playhead-ticks / max(1, root.ticks-per-pixel)) * 1px;
    in-out property <bool> is-looping: false;
    property <length> timeline-origin-x: Theme.track-headers-on-right ? 0px : (root.headers-width + 5px);
    property <length> timeline-width: max(0px, root.width - root.headers-width - 5px);
    out property <length> playhead-origin-x: root.timeline-origin-x;
    out property <length> playhead-screen-x: root.timeline-origin-x + root.playhead-px - root.scroll-x;
    // [Q6] 标尺读数：可见小节数 / 小节宽 / 循环区间（全部由宿主从投影写入）。
    in-out property <[length]> bar-positions: [];
    in-out property <int> bar-start-index: 0;
    in-out property <int> bar-count: 0;
    in-out property <length> bar-width-px: 128px;
    // 拍位来源：投影的拍号分子（`bridge::ViewState::time_signature_numerator`），
    // 宿主在 `apply_view` 与小节读数同批写入。标尺拍刻度与车道拍线共用这一份
    // 读数（Wang 2026-11-17：网格以拍为常显基本单位，每拍一刻度 / 一线）。
    in-out property <int> beats-per-bar: 4;
    // 网格密度读数（五版自适应，Wang 2026-11-17 14:37 按 Logic Pro 实测
    // 规格）：宿主 `grid_density` 按当前小节宽与拍号分子算出、与小节读数
    // 同批写入。编号步长／线条单位为 2 的幂（小节）；细分份数 0／2／4。
    // 默认值 = 本组件默认小节宽 128px、4 拍时的 `grid_density` 读数
    // （宿主在真实装配里必然覆盖，默认值只供独立渲染时自洽）。
    in-out property <int> grid-label-stride: 1;
    in-out property <int> grid-line-unit: 1;
    in-out property <bool> grid-show-beat-ticks: true;
    in-out property <bool> grid-show-lane-beats: true;
    in-out property <int> grid-subdiv-per-beat: 4;
    in-out property <length> cycle-start-px: 0px;
    in-out property <length> cycle-end-px: 0px;
    in-out property <bool> show-chord-track: false; // 默认收缩折叠和弦轨，给予主工作区更充裕的高度空间
    in-out property <length> headers-width: 216px; // 支持拖拽调整大小 [min: 170px, max: 300px]
    // ⭐ 轨道行几何 / 内容高 / 横向滚动：全部来自宿主投影（track-ys / track-heights /
    // arrangement-sheet-height / roll-scroll-x），界面⛔ 不自己乘行高、⛔ 不自己算内容高。
    in-out property <[length]> track-ys: [];
    in-out property <[length]> track-heights: [];
    in-out property <length> sheet-height: 0px;
    in-out property <length> scroll-x: 0px;
    /// 当前选中的**剪辑摆放身份**（空串 = 没有选中）—— 块边框高亮与点击回填共用。
    in-out property <string> selected-clip-ulid: "";

    callback select-track(int);
    callback toggle-mute(int);
    callback toggle-solo(int);
    callback toggle-arm(int);
    callback add-track();
    callback audition-chord(string);
    callback ruler-seek(length);
    callback scrub-timeline(length);
    /// 滚轮分流：`shift` = 横向滚动、`alt` = 纵向缩放、`shift+alt` = 横向缩放。
    /// 无修饰由界面 `reject` ⇒ 冒泡给 `Flickable` 做纵向滚动。
    callback arrangement-wheel(length, length, bool, bool);
    callback zoom-h-step(bool);
    callback zoom-v-step(bool);

    function handle-arr-scroll(
        delta-x: length,
        delta-y: length,
        shift: bool,
        alt: bool,
        allow-vertical: bool
    ) -> EventResult {
        if shift || alt {
            root.arrangement-wheel(delta-x, delta-y, shift, alt);
            return accept;
        }
        if delta-x != 0px {
            root.arrangement-wheel(delta-x, delta-y, false, false);
            if allow-vertical && delta-y != 0px {
                arr_tracks_flickable.content-y = Math.max(
                    Math.min(0px, arr_tracks_flickable.height - arr_tracks_flickable.content-height),
                    Math.min(0px, arr_tracks_flickable.content-y + delta-y)
                );
            }
            return accept;
        }
        return reject;
    }
    /// 点击时间线块：只报**摆放身份**（`host::wire_clip_scope` 用它把卷帘作用域切到该片段）。
    in-out property <int> local-menu-track-id: 0;
    in-out property <string> active-local-menu: ""; // "", "tracks", "instrument"

    callback track-pan-change(int, float);
    callback track-volume-change(int, float);
    callback track-instrument-change(int, string);
    callback mixer-fader-grab(int, length);
    callback mixer-fader-drag(int, length);
    callback mixer-fader-release(int);
    callback mixer-fader-reset(int);
    callback mixer-pan-grab(int, length);
    callback mixer-pan-drag(int, length);
    callback mixer-pan-release(int);
    callback mixer-pan-reset(int);
    callback execute-action(string);
    callback clip-select(string);

    background: Theme.bg-canvas;
    clip: true;
    accessible-role: main;
    accessible-id: "workspace-arrangement-canvas";
    accessible-label: @tr("工作区编曲画布");

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // TOP HEADER ROW: Track header top box + Ruler + Chord Progression Track (Collapsible)
        Rectangle {
            height: root.show-chord-track ? 54px : 26px;
            // 顶部带底色（Wang 2026-11-16：学 Logic，标尺带比轨道背景浅一档）：
            // 取令牌阶梯里紧邻车道背景 Theme.bg-canvas 的上一档 Theme.bg-panel；
            // 底边显式 1px 分隔线，理顺工具行/标尺与轨道区之间的横线。
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                spacing: 0px;

                // Left top box (if headers on left)
                if !Theme.track-headers-on-right : Rectangle {
                    width: root.headers-width;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        alignment: space-between;

                        // 工具行 (负责人 2026-11-16 四条之 1 / 2): 旧标题
                        // 「轨道控制头 (TRACKS)」只说明区域名、不承载信息, 已删;
                        // 「轨道菜单」置整行最前 (下拉浮层锚点 x=8px 与之对齐),
                        // 其后依次 + 轨道、和弦展开/收起。三钮行为与回调不变。
                        HorizontalLayout {
                            alignment: space-between;
                            // 编曲区本地视图菜单开关（Wang 2026-11-16 令：置于轨道头工具行最前）。
                            // 用可渲染的中文标签，⛔ 不再依赖不渲染的下拉箭头字形；详见细节实测 §5.9。
                            Rectangle {
                                // i18n 合入后（d10ab38）：文案走 @tr，长度随语种变化（9 语词表）。
                                // 因此宽度改为「随 preferred-width 自适应，下限 72px / 上限 96px」，
                                // 超长语种由 elide 兜底，避免把同行右侧的"和弦展开/＋轨道"挤出去。
                                width: Math.min(96px, Math.max(72px, menu-label.preferred-width + 10px));
                                height: 18px;
                                background: root.active-local-menu == "tracks" ? Theme.accent : (arr-menu-touch.has-hover ? Tokens.bg-panel-alt : Tokens.bg-panel-alt);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: root.active-local-menu == "tracks" ? Theme.accent : Tokens.skin-active;
                                menu-label := Text {
                                    text: @tr("轨道菜单");
                                    width: Math.min(menu-label.preferred-width, parent.width - 6px);
                                    overflow: elide;
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: root.active-local-menu == "tracks" ? Tokens.skin-inset : Tokens.skin-text-body;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                arr-menu-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.active-local-menu = root.active-local-menu == "tracks" ? "" : "tracks";
                                    }
                                    scroll-event(event) => {
                                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                    }
                                }
                                TooltipBubble {
                                    text: @tr("编曲轨道与视图本地菜单");
                                    is-visible: arr-menu-touch.has-hover;
                                    tip-offset-y: 22px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                // Chord Track fold toggle
                                Rectangle {
                                    background: root.show-chord-track ? Theme.accent.with-alpha(0.25) : (chord-toggle-touch.has-hover ? Tokens.skin-hover : transparent);
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: root.show-chord-track ? Theme.accent : Tokens.skin-hairline;
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: root.show-chord-track ? @tr("和弦收起") : @tr("和弦展开");
                                            font-family: Tokens.font-ui;
                                            font-size: 9.5px;
                                            font-weight: 600;
                                            color: root.show-chord-track ? Theme.accent : Tokens.skin-text-body;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-toggle-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.show-chord-track = !root.show-chord-track; }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: root.show-chord-track ? @tr("折叠和弦音轨") : @tr("展开和弦音轨");
                                        is-visible: chord-toggle-touch.has-hover;
                                        tip-offset-y: 22px;
                                    }
                                }
                                Rectangle {
                                    background: add-track-top-touch.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.20);
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: Theme.accent.with-alpha(0.6);
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: @tr("+ 轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-top-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("添加新音轨 [Ctrl+T]");
                                        is-visible: add-track-top-touch.has-hover;
                                        tip-offset-y: 22px;
                                    }
                                }

                            }
                        }

                        if root.show-chord-track : Rectangle {
                            height: 22px;
                            background: Tokens.bg-lane2;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Tokens.bg-panel;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: space-between;
                                Text {
                                    text: @tr("全局和弦轨");
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: Tokens.skin-text-body;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: @tr("智能和声声学");
                                    font-family: Tokens.font-ui;
                                    font-size: 9px;
                                    color: Tokens.skin-text-dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Splitter Divider between Left Track Header top box and Timeline Ruler
                if !Theme.track-headers-on-right : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-header-top-left.has-hover ? Theme.accent : Tokens.divider-row;
                    }
                    split-header-top-left := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                        }
                        double-clicked => {
                            root.headers-width = 240px;
                        }
                        scroll-event(event) => {
                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                        }
                    }
                }

                // Center Timeline Ruler + Chord Progression Blocks
                Rectangle {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        spacing: 0px;

                        // Ruler (24px) - Spans across 24 bars (High contrast WCAG AA labels)
                        // 标尺带 (负责人 2026-11-16 四条之 4): 底比编曲区浅一档;
                        // 小节号走 `Tokens.ruler-ink`; 底部刻度与下方网格竖线
                        // 同 x 同源 (bar-positions / bar-width-px / scroll-x)。
                        // 标尺带底自 2026-11-17 合入起走质感三元 (Wang 裁决
                        // 甲, 19:58): 拟物支走令牌 `Tokens.ruler-brush`,
                        // 扁平支用十一版定值 (见下方 background 行注释)。
                        Rectangle {
                            height: 24px;
                            // 标尺带底 (裁决甲): 拟物支 = main 令牌形态
                            // `Tokens.ruler-brush`; 扁平支 = 十一版定值
                            // #1d2733 (Wang 2026-11-17 三版口径: 与车道底
                            // 的相对亮度比 1.30:1, 旧 `Theme.bg-panel`
                            // #0e1118 只有 1.04:1, 带与车道几乎同色;
                            // 轨道头底色同值, 整条头部带同面)。边框色
                            // 同理: main 形态无边框色 (透明), 扁平支
                            // 保留十一版 Tokens.skin-hover。
                            background: Tokens.texture-physical ? Tokens.ruler-brush : Tokens.bg-shell;
                            border-color: Tokens.texture-physical ? transparent : Tokens.skin-hover;
                            clip: true;

                            // [Q6] 标尺格数与间距来自投影（`host::apply_view` 的
                            // `bar-count` / `bar-width-px`），与下方片段块共用同一个
                            // 水平刻度（`blk.start_px = tick / ticks_per_pixel`）。
                            for i in root.bar-count : Text {
                                // 编号步长（五版自适应）：只在步长整数倍的
                                // 小节上标号（步长由宿主按小节宽算，间距
                                // >= 96px；Logic 图二极端缩小时每 16 小节
                                // 一个编号）。
                                // 净空区（六版，Wang 15:06 终判「刻度上
                                // 数字有点遮盖」）：编号只占标尺带上部
                                // 9px 净空区（字形在区内垂直居中），下方
                                // 刻度行仍是带下半 12px，编号区底与刻度
                                // 行顶之间留 3px（24 = 9 + 3 + 12），
                                // 任何刻度不得进入编号区。几何常量由
                                // arrangement_grid_density 判据 ⑥ 钉住。
                                visible: (root.bar-start-index + i).mod(max(1, root.grid-label-stride)) == 0;
                                x: ((root.bar-start-index + i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + i] : (root.bar-start-index + i) * root.bar-width-px) - root.scroll-x;
                                y: 0px;
                                width: root.bar-width-px;
                                height: 9px;
                                horizontal-alignment: left;
                                text: "" + (root.bar-start-index + i + 1);
                                font-family: Tokens.font-mono;
                                font-size: 9px;
                                font-weight: 600;
                                color: Tokens.ruler-ink;
                                vertical-alignment: center;
                            }

                            // 刻度三档 (小节 / 拍 / 拍内细分), 2026-11-18 起
                            // **两套主题共用**这一块: 拟物先前只有一条 5px 的小节
                            // 刻度 (刻蚀感), 扁平有三档字面色阶, 用户要求拟物也按
                            // 扁平那样加拍内刻度 ⇒ 合并成一套几何 (1 : 1/2 : 1/4,
                            // 12 / 6 / 3 px, 下对齐), 色值改走 `Tokens.ruler-tick-*`
                            // (拟物各降一档, 见 tokens.slint 该组注释)。
                            // 可见性仍走宿主密度读数 (`grid_density`): 小节刻度只在
                            // 线条单位整数倍的小节上画; 拍刻度须每拍 >= 8px; 细分
                            // 份数 (每拍 4/2/0) 由宿主按细分距 >= 8px 逐档退。

                            // 小节刻度 + 拍刻度 + 细分刻度（五版，Wang
                            // 2026-11-17 14:37 按 Logic Pro 实测规格定）：
                            // Logic 图一实测——刻度全 1px 宽，长度分级：
                            // 小节刻度满刻度行高、拍刻度约半行（下对齐）。
                            // 本带高 24px，刻度行取带下半 12px：小节 12px、
                            // 拍 6px、细分 3px（1 : 1/2 : 1/4，下对齐）。
                            // 亮度门槛（扁平套，对标尺带底 #1d2733 实算）：
                            // 小节 4.64:1（≥4.5）；拍 3.67:1（≥3）；
                            // 细分 3.32:1（≥3 硬下限）。拟物套同门槛、各降一档。
                            // 小节编号 Tokens.ruler-ink 对标尺带 10.17:1。
                            // 可见性走宿主密度读数（`grid_density`）：小节
                            // 刻度只在线条单位整数倍的小节上画；拍刻度须
                            // 每拍 >= 8px；细分份数（每拍 4/2/0）由宿主
                            // 按细分距 >= 8px 逐档退。
                            for i in root.bar-count : Rectangle {
                                x: ((root.bar-start-index + i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + i] : (root.bar-start-index + i) * root.bar-width-px) - root.scroll-x;
                                y: 0px;
                                width: root.bar-width-px;
                                height: parent.height;
                                background: transparent;

                                Rectangle {
                                    visible: (root.bar-start-index + i).mod(max(1, root.grid-line-unit)) == 0;
                                    x: 0px;
                                    y: parent.height - 12px;
                                    width: 1px;
                                    height: 12px;
                                    background: Tokens.ruler-tick-bar;
                                }

                                for beat in root.beats-per-bar : Rectangle {
                                    visible: beat > 0 && root.grid-show-beat-ticks;
                                    x: beat * (root.bar-width-px / max(1, root.beats-per-bar));
                                    y: parent.height - 6px;
                                    width: 1px;
                                    height: 6px;
                                    background: Tokens.ruler-tick-beat;
                                }

                                for beat in root.beats-per-bar : Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: root.bar-width-px;
                                    height: parent.height;
                                    background: transparent;

                                    for sub in root.grid-subdiv-per-beat : Rectangle {
                                        visible: sub > 0;
                                        x: beat * (root.bar-width-px / max(1, root.beats-per-bar)) + sub * (root.bar-width-px / max(1, root.beats-per-bar) / max(1, root.grid-subdiv-per-beat));
                                        y: parent.height - 3px;
                                        width: 1px;
                                        height: 3px;
                                        background: Tokens.ruler-tick-sub;
                                    }
                                }
                            }

                            // 循环指示带：区间来自视图态（`cycle-start/end-ticks`），
                            // ⛔ 不再是写死的 `x: 150px / width: 220px`。
                            if root.is-looping && root.cycle-end-px > root.cycle-start-px : Rectangle {
                                x: root.cycle-start-px - root.scroll-x;
                                y: 0px;
                                width: root.cycle-end-px - root.cycle-start-px;
                                height: 3px;
                                background: Theme.accent;
                                border-radius: 1.5px;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        root.ruler-seek(self.mouse-x);
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        root.ruler-seek(self.mouse-x);
                                    }
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                }
                            }

                            // ⭐ 可见缩放控件：横向 / 纵向各一对（与滚轮、快捷键同一条宿主入口
                            // `zoom-h-step` / `zoom-v-step`）。滚轮 / 快捷键仍可用。
                            Rectangle {
                                x: parent.width - 120px;
                                y: 2px;
                                width: 114px;
                                height: 20px;
                                background: Tokens.bg-void.with-alpha(0.80);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Tokens.skin-hairline;

                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    spacing: 2px;
                                    alignment: space-between;

                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: hz-out-touch.has-hover ? Tokens.skin-chip : transparent;
                                        Text { text: "H−"; font-family: Tokens.font-mono; font-size: 9.5px; color: Tokens.skin-text-body; horizontal-alignment: center; vertical-alignment: center; }
                                        hz-out-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-h-step(false); } }
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: hz-in-touch.has-hover ? Tokens.skin-chip : transparent;
                                        Text { text: "H+"; font-family: Tokens.font-mono; font-size: 9.5px; color: Tokens.skin-text-body; horizontal-alignment: center; vertical-alignment: center; }
                                        hz-in-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-h-step(true); } }
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: vt-out-touch.has-hover ? Tokens.skin-chip : transparent;
                                        Text { text: "V−"; font-family: Tokens.font-mono; font-size: 9.5px; color: Tokens.skin-text-body; horizontal-alignment: center; vertical-alignment: center; }
                                        vt-out-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-v-step(false); } }
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: vt-in-touch.has-hover ? Tokens.skin-chip : transparent;
                                        Text { text: "V+"; font-family: Tokens.font-mono; font-size: 9.5px; color: Tokens.skin-text-body; horizontal-alignment: center; vertical-alignment: center; }
                                        vt-in-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-v-step(true); } }
                                    }
                                }
                            }
                        }

                        // Chord Progression Track (30px) - Harmonized with mineral color order (Collapsible)
                        if root.show-chord-track : Rectangle {
                            height: 30px;
                            background: Tokens.skin-inset;

                            HorizontalLayout {
                                padding: 3px;
                                spacing: 4px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    // 九版（Wang 16:43）：和弦块底改和弦色纯色本体
                                    // Theme.track-synth（八版合成等效实色 = 和弦色混黑，废）。
                                    // hover 按同色明度微调（±0.04，方向取文字仍
                                    // >= 4.5 的一侧，本块为 -0.04）；边框为同色更深
                                    // 一档实色（明度 -0.10 / hover -0.05），不用
                                    // alpha。文字按底色选近白/纯白/纯黑（>= 4.5）。
                                    // 五块同规则，数值各自按其和弦色算。
                                    background: chord-1-touch.has-hover ? Theme.track-synth.brighter(0.18) : Theme.track-synth;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-1-touch.has-hover ? Theme.track-synth.brighter(0.08) : Theme.track-synth.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Cm9 (i9)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-1-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Cm9"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Cm9 (主和弦) 配置");
                                        is-visible: chord-1-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-2-touch.has-hover ? Theme.track-pad.brighter(0.18) : Theme.track-pad;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-2-touch.has-hover ? Theme.track-pad.brighter(0.08) : Theme.track-pad.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "AbMaj7 (VI7)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-2-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("AbMaj7"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 AbMaj7 (下中音和弦) 配置");
                                        is-visible: chord-2-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-3-touch.has-hover ? Theme.track-vocal.brighter(0.18) : Theme.track-vocal;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-3-touch.has-hover ? Theme.track-vocal.brighter(0.08) : Theme.track-vocal.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Fm11 (iv11)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-3-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Fm11"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Fm11 (下属和弦) 配置");
                                        is-visible: chord-3-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-4-touch.has-hover ? Theme.track-drum.brighter(0.18) : Theme.track-drum;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-4-touch.has-hover ? Theme.track-drum.brighter(0.08) : Theme.track-drum.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "G7#9 (V7#9)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-4-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("G7#9"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 G7#9 (属和弦变化音) 配置");
                                        is-visible: chord-4-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-5-touch.has-hover ? Theme.track-synth.brighter(0.18) : Theme.track-synth;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-5-touch.has-hover ? Theme.track-synth.brighter(0.08) : Theme.track-synth.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Cm11 (i11)";
                                            font-family: Tokens.font-mono;
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 8px;
                                            // 九版：底改和弦色纯色 Theme.track-synth，文字随块统一
                                            // 用 Tokens.skin-text-strong（对纯色底实算 4.60:1，>= 4.5）。
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-5-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Cm11"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Cm11 (扩展主和弦) 配置");
                                        is-visible: chord-5-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }
                    }
                }

                // Splitter Divider between Timeline Ruler and Right Track Header top box
                if Theme.track-headers-on-right : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-header-top-right.has-hover ? Theme.accent : Tokens.divider-row;
                    }
                    split-header-top-right := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                        }
                        double-clicked => {
                            root.headers-width = 240px;
                        }
                        scroll-event(event) => {
                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                        }
                    }
                }

                // Right top box (if headers on right)
                if Theme.track-headers-on-right : Rectangle {
                    width: root.headers-width;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        alignment: space-between;

                        // 右置变体同左置口径 (负责人 2026-11-16 四条之 1):
                        // 旧标题「轨道控制头 (右置)」只说明区域名, 已删。
                        HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                background: add-track-right-touch.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.18);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.accent;
                                height: 18px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: @tr("+ 轨道");
                                        font-family: Tokens.font-ui;
                                        font-size: 9px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                                add-track-right-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.add-track(); }
                                    scroll-event(event) => {
                                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                    }
                                }
                                TooltipBubble {
                                    text: @tr("添加新音轨 [Ctrl+T]");
                                    is-visible: add-track-right-touch.has-hover;
                                    tip-offset-y: 22px;
                                }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            background: Theme.accent.with-alpha(0.12);
                            border-radius: 3px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: @tr("右置轨道头模式 (镜像工作区)");
                                    font-family: Tokens.font-ui;
                                    font-size: 8px;
                                    color: Tokens.skin-text-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 工具行 / 标尺与轨道区之间的横线 (负责人 2026-11-16 四条之 3):
            // 一条 1px 线跨整个顶行 (工具盒 + 标尺同色同高), 走令牌层
            // `Tokens.divider-row`, ⛔ 不再靠顶行 Rectangle 的 border 兼任。
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Tokens.divider-row;
            }

            // 刻蚀高光 (只拟物套有值, 扁平套 alpha=0): 主线下方 1px。
            Rectangle {
                x: 0px;
                y: parent.height;
                width: parent.width;
                height: 1px;
                background: Tokens.divider-row-highlight;
            }
        }

        // TRACK LANES CONTAINER
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            // 车道底（十一版，Wang 2026-11-17 18:51 + 18:53 亲定）：
            // 十版把车道底抬到中性灰（相对亮度 0.0273），与全应用的
            // 深蓝色系（轨道头 #1d2733、标尺带）差异太大 ⇒ 改回九版
            // #090b10 的色相/饱和（HSV 222.9° / 0.4375）只抬明度：
            // 定值 #1d2333，相对亮度实算 0.0170（目标带 0.014–0.020，
            // 仍低于十版中性灰）。只落本容器（行与行下空置区同底），
            // ⛔ 不动 Theme.bg-canvas 本体（窗口底与其它面共用）、
            // 不动标尺带 Theme.bg-panel。
            // 合入裁决甲 (Wang 2026-11-17 19:58) 补: 本容器在 main
            // 侧原本无底色 (透出 root 的 Theme.bg-canvas), 十一版
            // 字面底只许落扁平支 ⇒ 写成质感三元, 拟物支 transparent
            // 逐像素复现 main 形态。
            background: Tokens.texture-physical ? transparent : Tokens.bg-lane;

            // ⭐ 轨道一多（16 轨 × 56px = 896px）时，固定高度的 VerticalLayout 会把
            // 内容撑出工作区、把下方钢琴卷帘/混音台顶出窗口。这里改成纵向 Flickable：
            // 内容高 = 投影的 `sheet-height`，行 y / 行高 = 投影的 `track-ys` /
            // `track-heights` ⇒ 轨道再多也只在自己的窗口里滚动，⛔ 不挤占下坞。
            arr_tracks_flickable := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: max(self.height, root.sheet-height + 42px + 46px);
                interactive: true;
                // ─── 轨道区背景网格（整幅铺满）───────────────────────
                // 负责人 2026-11-18 口径：网格是**背景**，不是行内装饰——
                // 一层铺满 Flickable 全高（含轨道行与下方空置区），空轨道
                // 与空置区同样有网格；层级自下而上 =
                // 车道底色 → 行分隔线 → 小节/拍/细分线 → 行选中态 → 片段。
                // 两套主题同一套 mark：同 x、同 1px、同门槛，只有线色不同
                //（§13 skin-grid-*，Logic 式低反差：线只比底色亮一档）。
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: max(parent.height, root.sheet-height + 88px);
                    background: Tokens.bg-lane;

                    // 行底分隔线（先画，网格后画 ⇒ 竖线压在横线之上）
                    for _row[idx] in root.tracks : Rectangle {
                        x: 0px;
                        y: root.track-ys[idx] + root.track-heights[idx] - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Tokens.skin-grid-row;
                    }

                    // 小节线
                    for _bar in root.bar-count : Rectangle {
                        visible: (root.bar-start-index + _bar).mod(max(1, root.grid-line-unit)) == 0;
                        x: ((root.bar-start-index + _bar) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + _bar] : (root.bar-start-index + _bar) * root.bar-width-px) - root.scroll-x;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Tokens.skin-grid-bar;
                    }

                    // 拍线 + 拍内细分（每拍 >= 24px 画拍线；>= 48px 再画 1/4 细分）
                    for _beat_bar in root.bar-count : Rectangle {
                        x: ((root.bar-start-index + _beat_bar) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + _beat_bar] : (root.bar-start-index + _beat_bar) * root.bar-width-px) - root.scroll-x;
                        y: 0px;
                        width: root.bar-width-px;
                        height: parent.height;
                        background: transparent;

                        for beat in root.beats-per-bar : Rectangle {
                            visible: beat > 0 && root.grid-show-lane-beats;
                            x: beat * (root.bar-width-px / max(1, root.beats-per-bar));
                            y: 0px;
                            width: 1px;
                            height: parent.height;
                            background: Tokens.skin-grid-beat;

                            for sub in [1, 2, 3] : Rectangle {
                                visible: (root.bar-width-px / max(1, root.beats-per-bar)) >= 48px;
                                x: sub * ((root.bar-width-px / max(1, root.beats-per-bar)) / 4);
                                y: 0px;
                                width: 1px;
                                height: parent.height;
                                background: Tokens.skin-grid-sub;
                            }
                        }
                    }

                    // 行选中态（半透明提亮，压在网格上、片段下）
                    for _sel[idx] in root.tracks : Rectangle {
                        visible: _sel.id == root.selected-track-id;
                        x: 0px;
                        y: root.track-ys[idx];
                        width: parent.width;
                        height: root.track-heights[idx];
                        background: Theme.accent.with-alpha(0.06);
                    }
                }


                // 背景滚轮兜底（含顶部 42px 留白与末尾空白区），保证双指横向/纵向滑动在整块区域均响应
                TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: arr_tracks_flickable.content-height;
                    scroll-event(event) => {
                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                    }
                }

                for trk[idx] in root.tracks : Rectangle {
                    y: root.track-ys[idx];
                    height: root.track-heights[idx];
                    width: parent.width;
                    // 选中呈现（裁决甲，Wang 2026-11-17 19:58）：质感三元。
                    // 扁平支 = 十一版形态（八版 Logic 式：七版纯白边框
                    // 作废，选中只由提亮承载——车道底改回蓝调 #1d2333
                    // 后选中行底按相对亮度比 1.80 重算为 #273146，相对
                    // 亮度 0.0307；行边框 Tokens.skin-hover 0px 与未选中行同款；
                    // 轨道色与 accent 双脱钩，色条仍保留轨道色）。
                    // 拟物支 = main 形态（选中行 accent α0.08 底 +
                    // α0.70 边 1.5px，未选中 Tokens.skin-hover 淡框）。
                    // 行底与选中态统一由轨道区背景层绘制（网格在上面、片段再压上来）；
                    // 行本体保持透明，避免把整幅网格挡住。
                    background: transparent;
                    border-width: 0px;
                    HorizontalLayout {
                        spacing: 0px;

                        // Left Track Header (if not headers on right)
                        if !Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            // 轨道头选中呈现 (裁决甲, Wang 2026-11-17 19:58):
                            // 质感三元。拟物支 = main 形态 (选中 accent
                            // α0.10 底 + α0.80 边, 未选中 track-head-brush);
                            // 扁平支 = 十一版定值 (选中头底 #293645——八版
                            // Logic 式: 未选中头底 #1d2733 按亮度比 1.80
                            // 线性提亮; 边框恒 Theme.border-subtle 与未选中
                            // 行同款, 七版 #16232b 与纯白边框同废)。
                            background: Tokens.texture-physical ? (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.10) : Tokens.track-head-brush) : (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.12) : Tokens.bg-panel);
                            border-color: Tokens.texture-physical ? (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.80) : Theme.border-subtle) : Theme.border-subtle;

                            // Left color strip (illuminated on focus)
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: trk.id == root.selected-track-id ? 5px : 3.5px;
                                height: parent.height;
                                background: trk.color;
                            }

                            TouchArea {
                                clicked => { root.select-track(trk.id); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 4px;
                                    Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: trk.id == root.selected-track-id ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        background: badge-left-touch.has-hover ? Tokens.line : Tokens.skin-scrim;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: badge-left-touch.has-hover ? Theme.accent : Tokens.skin-hairline;
                                        // 108px 在 1460 宽窗口下仍然差几个像素：`Yeban PolySynth [v]`
                                        // 实测被省成「Yeban PolySyn…」，名字尾巴和 `[v]` 换音色入口都读不清。
                                        // 抬到 140px，长音色名能整段显示（轨道名是 stretch + elide，不会溢出）。
                                        max-width: 140px;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            // 「Yeban PolySynth [v]」在 9px 等宽下约 100px，旧的 82px 上限把
                                            // 尾巴 `[v]` 一起省成「Yeban PolySy…」，看不见"可换音色"的入口。
                                            // 拆成两段：名字用 elide 自适应，`[v]` 单独且永远完整。
                                            Text {
                                                text: trk.insert1 != "" ? trk.insert1 : trk.kind;
                                                horizontal-stretch: 1;
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-left-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                                font-weight: 400;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: " [v]";
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-left-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                                font-weight: 400;
                                                vertical-alignment: center;
                                            }
                                        }
                                        badge-left-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.select-track(trk.id);
                                                root.local-menu-track-id = trk.id;
                                                root.active-local-menu = root.active-local-menu == "instrument" ? "" : "instrument";
                                            }
                                            scroll-event(event) => {
                                                root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                            }
                                        }
                                        TooltipBubble {
                                            text: @tr("点击更换音色/效果 [当前: {}]", trk.insert1 != "" ? trk.insert1 : trk.kind);
                                            is-visible: badge-left-touch.has-hover;
                                            tip-offset-y: 22px;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: space-between;

                                    // M S R buttons (Studio colors: Amber / Gold / Crimson)
                                    HorizontalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.muted ? Tokens.skin-mute : (m-btn-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.muted ? Tokens.skin-mute : Tokens.skin-hairline;
                                            Text {
                                                text: "M";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.muted ? Tokens.bg-lane2 : (m-btn-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            m-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-mute(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.muted ? @tr("取消静音 [M]") : @tr("静音轨道 [M]");
                                                is-visible: m-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.soloed ? Tokens.skin-mute : (s-btn-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.soloed ? Tokens.skin-mute : Tokens.skin-hairline;
                                            Text {
                                                text: "S";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.soloed ? Tokens.bg-lane2 : (s-btn-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            s-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-solo(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.soloed ? @tr("取消独奏 [S]") : @tr("独奏轨道 [S]");
                                                is-visible: s-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.armed ? Tokens.skin-arm : (r-btn-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.armed ? Tokens.skin-arm : Tokens.skin-hairline;
                                            Text {
                                                text: "R";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.armed ? Tokens.skin-text-strong : (r-btn-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            r-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-arm(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.armed ? @tr("取消录音准备 [R]") : @tr("录音准备 (Arm) [R]");
                                                is-visible: r-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                    }

                                    // Pan widget + Volume dB + Vertical precision meter
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        // Pan widget
                                        Rectangle {
                                            width: 38px;
                                            height: 20px;
                                            background: pan-touch.has-hover ? Tokens.skin-chip : Tokens.skin-inset;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: Tokens.skin-hairline;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "P";
                                                    font-family: Tokens.font-mono;
                                                    font-size: 8.5px;
                                                    font-weight: 400;
                                                    color: Tokens.skin-text-dim;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: trk.pan;
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9px;
                                                    font-weight: 400;
                                                    color: Tokens.skin-text-body;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            pan-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ew-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-pan-grab(trk.id - 1, self.mouse-x);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-pan-drag(trk.id - 1, self.mouse-x);
                                                    } else {
                                                        root.mixer-pan-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-pan-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("声像: {} (左右拖拽调节，双击归中)", trk.pan);
                                                is-visible: pan-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        // Volume dB text
                                        Rectangle {
                                            width: 44px;
                                            height: 20px;
                                            background: vol-touch.has-hover ? Tokens.skin-chip : transparent;
                                            border-radius: 3px;
                                            border-width: vol-touch.has-hover ? 1px : 0px;
                                            border-color: Tokens.skin-hairline;
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.track-volumes.length > idx ? (root.track-volumes[idx] + "dB") : ("" + (Math.round(trk.volume_db * 10.0) / 10.0) + "dB");
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9.5px;
                                                    color: Tokens.skin-text-body;
                                                    font-weight: 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            vol-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ns-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-fader-grab(trk.id - 1, self.mouse-y);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-fader-drag(trk.id - 1, self.mouse-y);
                                                    } else {
                                                        root.mixer-fader-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-fader-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("推子增益: {} dB (上下拖拽调节，双击归 0dB)", root.track-volumes.length > idx ? root.track-volumes[idx] : ("" + Math.round(trk.volume_db * 10.0) / 10.0));
                                                is-visible: vol-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        // Vertical Level Meter with Peak Indicator
                                        Rectangle {
                                            width: 6px;
                                            height: 20px;
                                            background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane;
                                            border-radius: 1.5px;
                                            border-width: 0.8px;
                                            border-color: Tokens.skin-hairline;
                                            clip: true;

                                            Rectangle {
                                                x: 0;
                                                y: parent.height - (trk.muted ? 0px : (meter-val(idx) * parent.height));
                                                width: 6px;
                                                height: trk.muted ? 0px : (meter-val(idx) * parent.height);
                                                border-radius: 1px;
                                                background: meter-val(idx) > 0.8 ? Tokens.skin-arm : (meter-val(idx) > 0.6 ? Tokens.skin-mute : Tokens.skin-meter-low);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Splitter Divider between Left Track Header and Timeline Lane
                        if !Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-left.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-left := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Center Timeline Lane
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;

                            // 背景选择与滚轮面必须先于片段块声明，避免遮挡 Clip 点击
                            TouchArea {
                                clicked => { root.select-track(trk.id); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            // Timeline Clips for this track
                            for blk in root.timeline-blocks : Rectangle {
                                if blk.track_id == trk.id : Rectangle {
                                    x: blk.start_px - root.scroll-x;
                                    y: 4px;
                                    width: blk.width_px;
                                    height: Math.max(52px, parent.height - 8px);
                                    border-radius: 4px;
                                    // 片段底（九版，Wang 2026-11-17 16:43 亲定，照 Logic Pro
                                    // 区域）：轨道色纯色本体 blk.base-color（投影层
                                    // bridge::clip_base_color 算：纯色不混黑；太浅的色按
                                    // 统一规则只降 HSL 明度，使白色对比 >= 3.05:1——
                                    // 十版标记虽改同色相派生浅色，其明度同量级，
                                    // 本规则原样兜底）。
                                    // 八版「不透明近黑底 + 轨道色 0.12 叠层 = 合成等效
                                    // 实色」废——那是轨道色混黑，暗且脏。轨道标识色
                                    // trk.color 本身不动，轨道头色条仍是原色。
                                    background: blk.base-color;
                                    // 同色边框去除（九版，Wang 16:43）：未选中片段原有
                                    // trk.color α0.55 同色边框整圈去掉（宽 0，无边框）；
                                    // 选中片段的 2px 纯白边框保留（选中指示，非同色边框）。
                                    border-width: blk.clip_ulid != "" && blk.clip_ulid == root.selected-clip-ulid ? 2px : 0px;
                                    border-color: Tokens.skin-text-strong;
                                    clip: true;

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: blk.label;
                                                font-family: Tokens.font-ui;
                                                font-size: 10px;
                                                font-weight: 600;
                                                // 九版：文字色按底色选（blk.text-color，
                                                // 投影层保证对纯色底 >= 4.5:1）。
                                                color: blk.text-color;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            // 自动隐藏规则：宽度不足 110px 时隐藏 Gain 标签，优先完整显示标题，避免截断遮挡
                                            if blk.width_px >= 110px : Text {
                                                text: blk.gain_label;
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: blk.text-color;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // ⭐ 真实波形（ADR-0076 B1）：`blk.waveform-peaks` 非空时按柱画
                                        // （每柱取该段 |sample| 最大值，由 bridge::compute_waveform_peaks 算）；
                                        // 空 = 尚未分析 ⇒ 只留 0dB 基准线并标「示意」，
                                        // ⛔ 绝不画常量折线冒充包络（细节实测 §3.1）。
                                        if blk.is_audio : Rectangle {
                                            height: Math.max(22px, parent.height - 26px);
                                            clip: true;

                                            // 0dB Centerline（基准线，不是编造的包络；十版：
                                            // 色由 blk.guide-color 给——与峰值柱同出投影层
                                            // 派生（轨道色同色相浅色版，bridge::clip_marker_color）
                                            Rectangle {
                                                x: 0px;
                                                y: parent.height / 2;
                                                width: parent.width;
                                                height: 1px;
                                                background: blk.guide-color;
                                            }

                                            // 真实峰值柱：peaks 为空时 0 个（不画）。
                                            for peak_index in blk.waveform-peaks.length : Rectangle {
                                                x: 4px + peak_index * ((parent.width - 8px) / blk.waveform-peaks.length);
                                                width: Math.max(1px, (parent.width - 8px) / blk.waveform-peaks.length - 1px);
                                                // ⚠ Slint 里 length × float 必须显式换算：先除 1px 变成数，
                                                // 乘完再乘 1px 变回 length（否则编译期报
                                                // 「Cannot convert float to length」）。
                                                height: Math.max(1px, ((parent.height - 8px) / 1px) * blk.waveform-peaks[peak_index] * 1px);
                                                y: (parent.height - self.height) / 2;
                                                // 峰值柱十版改同色相派生色 blk.marker-color
                                                // （Wang 2026-11-17 18:28，照 Logic 波形色）：
                                                // 轨道色 HSV 派生（H 不变、V = 0.99、
                                                // S × 1/3），是底色的浅色版而非纯白——
                                                // 纯白在彩色底上引入外来色且对比过冲，
                                                // 故刺眼（八版/九版纯白废）。逐色落码值
                                                // 由判据 ⑧ 普查钉死。
                                                background: blk.marker-color;
                                            }

                                            Text {
                                                x: 4px;
                                                y: 2px;
                                                width: parent.width - 8px;
                                                text: @tr("波形待分析 · 示意");
                                                // 窄片段放不下整句 ⇒ 不显示被裁成「波形」的半截误导文案；
                                                // 完整语义仍保留在代码与 accessible-label 里。
                                                // 有真实峰值时不再显示该标注。
                                                visible: parent.width >= 88px && blk.waveform-peaks.length == 0;
                                                accessible-role: text;
                                                accessible-label: @tr("波形待分析 · 示意（资产不在会话池或解码失败，当前为 0dB 基准线占位）");
                                                font-family: Tokens.font-mono;
                                                font-size: 8.5px;
                                                color: blk.text-color;
                                                horizontal-alignment: left;
                                                vertical-alignment: top;
                                            }
                                        }

                                        // MIDI Polyphonic Score Display (driven strictly by real blk.note_count)
                                        if !blk.is_audio : Rectangle {
                                            height: Math.max(22px, parent.height - 26px);
                                            clip: true;

                                            // Pitch division guideline（十版：色由
                                            // blk.guide-color 给，口径同波形基准线——
                                            // 同出投影层同色相派生）
                                            Rectangle {
                                                x: 0px;
                                                y: parent.height / 2;
                                                width: parent.width;
                                                height: 1px;
                                                background: blk.guide-color;
                                            }

                                            if blk.note_count <= 0 && blk.width_px >= 90px : Text {
                                                x: 8px;
                                                y: (parent.height - self.height) / 2;
                                                text: @tr("空片段");
                                                font-family: Tokens.font-ui;
                                                font-size: 9.5px;
                                                color: blk.text-color;
                                            }

                                            if blk.note_count > 0 : HorizontalLayout {
                                                x: 8px;
                                                y: 6px;
                                                width: Math.max(12px, parent.width - 16px);
                                                height: Math.max(10px, parent.height - 10px);
                                                spacing: 3px;
                                                for n_idx in Math.min(16, blk.note_count) : Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 4px;
                                                    border-radius: 1px;
                                                    // 音符条十版改同色相派生色
                                                    // blk.marker-color（口径同峰值柱）：
                                                    // 轨道色浅色版，⛔ 不再用纯白。
                                                    background: blk.marker-color;
                                                    y: Math.mod(n_idx * 5, 14) * 1px;
                                                }
                                            }
                                        }
                                    }

                                    // 片段面无质感叠层: 负责人 2026-11-17 拟物重点
                                    // 口径 —— 编辑区域 (画布与片段) 保持平坦, 二期
                                    // 加的片段顶光/底影已撤销, 片段本体就是数据色
                                    // (轨道色 + alpha, 信息编码), 两套主题同形。

                                    // ⭐ 点击片段 = 选中该**摆放**：卷帘作用域随 `clip-select` 切到它
                                    // （⛔ 不再"所有轨道的全部音符混在一起"）。
                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.clip-select(blk.clip_ulid); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                        }
                                    }
                                }
                            }
                        }

                        // Splitter Divider between Timeline Lane and Right Track Header
                        if Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-right.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-right := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Right Track Header (if right mode)
                        if Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            // 选中头底与边框同左头 (裁决甲质感三元: 拟物支
                            // main 形态, 扁平支十一版定值 #293645 / 边框
                            // Theme.border-subtle, 七版 #16232b 与纯白边框
                            // 同废; 解法与左头逐字一致)。
                            background: Tokens.texture-physical ? (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.10) : Tokens.track-head-brush) : (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.12) : Tokens.bg-panel);
                            border-color: Tokens.texture-physical ? (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.80) : Theme.border-subtle) : Theme.border-subtle;

                            Rectangle {
                                x: parent.width - 4px;
                                y: 0;
                                width: trk.id == root.selected-track-id ? 5px : 3.5px;
                                height: parent.height;
                                background: trk.color;
                            }

                            TouchArea {
                                clicked => { root.select-track(trk.id); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 4px;
                                    Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: trk.id == root.selected-track-id ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        background: badge-right-touch.has-hover ? Tokens.line : Tokens.skin-scrim;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: badge-right-touch.has-hover ? Theme.accent : Tokens.skin-hairline;
                                        max-width: 140px;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            // 同左侧轨道头：名字 elide、`[v]` 尾巴恒定可见。
                                            Text {
                                                text: trk.insert1 != "" ? trk.insert1 : trk.kind;
                                                horizontal-stretch: 1;
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-right-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                                font-weight: 400;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: " [v]";
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-right-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                                font-weight: 400;
                                                vertical-alignment: center;
                                            }
                                        }
                                        badge-right-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.select-track(trk.id);
                                                root.local-menu-track-id = trk.id;
                                                root.active-local-menu = root.active-local-menu == "instrument" ? "" : "instrument";
                                            }
                                            scroll-event(event) => {
                                                root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                            }
                                        }
                                        TooltipBubble {
                                            text: @tr("点击更换音色/效果 [当前: {}]", trk.insert1 != "" ? trk.insert1 : trk.kind);
                                            is-visible: badge-right-touch.has-hover;
                                            tip-offset-y: 22px;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 3px;
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.muted ? Tokens.skin-mute : (m-btn-r-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.muted ? Tokens.skin-mute : Tokens.skin-hairline;
                                            Text {
                                                text: "M";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.muted ? Tokens.bg-lane2 : (m-btn-r-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            m-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-mute(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.muted ? @tr("取消静音 [M]") : @tr("静音轨道 [M]");
                                                is-visible: m-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.soloed ? Tokens.skin-mute : (s-btn-r-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.soloed ? Tokens.skin-mute : Tokens.skin-hairline;
                                            Text {
                                                text: "S";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.soloed ? Tokens.bg-lane2 : (s-btn-r-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            s-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-solo(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.soloed ? @tr("取消独奏 [S]") : @tr("独奏轨道 [S]");
                                                is-visible: s-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.armed ? Tokens.skin-arm : (r-btn-r-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.armed ? Tokens.skin-arm : Tokens.skin-hairline;
                                            Text {
                                                text: "R";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.armed ? Tokens.skin-text-strong : (r-btn-r-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            r-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-arm(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.armed ? @tr("取消录音准备 [R]") : @tr("录音准备 (Arm) [R]");
                                                is-visible: r-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        Rectangle {
                                            width: 38px;
                                            height: 20px;
                                            background: pan-r-touch.has-hover ? Tokens.skin-chip : Tokens.skin-inset;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: Tokens.skin-hairline;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "P";
                                                    font-family: Tokens.font-mono;
                                                    font-size: 8.5px;
                                                    font-weight: 400;
                                                    color: Tokens.skin-text-dim;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: trk.pan;
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9px;
                                                    font-weight: 400;
                                                    color: Tokens.skin-text-body;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            pan-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ew-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-pan-grab(trk.id - 1, self.mouse-x);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-pan-drag(trk.id - 1, self.mouse-x);
                                                    } else {
                                                        root.mixer-pan-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-pan-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("声像: {} (左右拖拽调节，双击归中)", trk.pan);
                                                is-visible: pan-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 44px;
                                            height: 20px;
                                            background: vol-r-touch.has-hover ? Tokens.skin-chip : transparent;
                                            border-radius: 3px;
                                            border-width: vol-r-touch.has-hover ? 1px : 0px;
                                            border-color: Tokens.skin-hairline;
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.track-volumes.length > idx ? (root.track-volumes[idx] + "dB") : ("" + (Math.round(trk.volume_db * 10.0) / 10.0) + "dB");
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9.5px;
                                                    color: Tokens.skin-text-body;
                                                    font-weight: 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            vol-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ns-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-fader-grab(trk.id - 1, self.mouse-y);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-fader-drag(trk.id - 1, self.mouse-y);
                                                    } else {
                                                        root.mixer-fader-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-fader-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("推子增益: {} dB (上下拖拽调节，双击归 0dB)", root.track-volumes.length > idx ? root.track-volumes[idx] : ("" + Math.round(trk.volume_db * 10.0) / 10.0));
                                                is-visible: vol-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 6px;
                                            height: 20px;
                                            background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane;
                                            border-radius: 1.5px;
                                            border-width: 0.8px;
                                            border-color: Tokens.skin-hairline;
                                            clip: true;

                                            Rectangle {
                                                x: 0;
                                                y: parent.height - (trk.muted ? 0px : (meter-val(idx) * parent.height));
                                                width: 6px;
                                                height: trk.muted ? 0px : (meter-val(idx) * parent.height);
                                                border-radius: 1px;
                                                background: meter-val(idx) > 0.8 ? Tokens.skin-arm : (meter-val(idx) > 0.6 ? Tokens.skin-mute : Tokens.skin-meter-low);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Empty Track Lane Canvas / Add Track Drop Zone (Placed strictly below sheet-height + top offset inside Flickable)
                Rectangle {
                    y: root.sheet-height + 42px;
                    vertical-stretch: 0;
                    height: 38px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 0px;

                        // Left Header Box placeholder
                        if !Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 24px;
                                    background: add-track-btm-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel-alt;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Tokens.skin-hairline;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: @tr("+ 点击添加新轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Tokens.skin-text-body;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-btm-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("创建新音频或MIDI轨道 [Ctrl+T]");
                                        is-visible: add-track-btm-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }

                        // Splitter Divider between Left Placeholder and Bottom Grid Area
                        if !Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-btm-left.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-btm-left := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Center Grid Area
                        Rectangle {
                            horizontal-stretch: 1;


                            // 空态提示按**视口**居中：此前放在内容网格的同级
                            // HorizontalLayout 里，按 bar-count × bar-width 的内容宽度
                            // 居中，整句被推到右缘只剩半句（细节实测 §4.8）。
                            // 显式 width = parent.width（视口）+ word-wrap ⇒ 不再被裁断。
                            Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("在此区域拖拽音频、MIDI 文件或双击以新增轨道");
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 500;
                                color: Tokens.skin-text-dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            drop_zone_touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.add-track(); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                            TooltipBubble {
                                text: @tr("双击或点击此区域添加新轨道 [Ctrl+T]");
                                is-visible: drop_zone_touch.has-hover;
                                tip-offset-y: 20px;
                            }
                        }

                        // Splitter Divider between Bottom Grid Area and Right Placeholder
                        if Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-btm-right.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-btm-right := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Right Header Box placeholder (if right mode)
                        if Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 24px;
                                    background: add-track-btm-r-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel-alt;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Tokens.skin-hairline;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: @tr("+ 点击添加新轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Tokens.skin-text-body;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-btm-r-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("创建新音频或MIDI轨道 [Ctrl+T]");
                                        is-visible: add-track-btm-r-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Animated Playhead Overlay (clipped strictly to Center Timeline region, spanning Ruler down through Track Lanes)
    Rectangle {
        x: root.timeline-origin-x;
        y: 0px;
        width: root.timeline-width;
        height: parent.height;
        clip: true;

        // 播放头颜色（六版，Wang 2026-11-17 15:09）：竖线与头部改
        // 纯白 Tokens.skin-text-strong——播放头是视觉中心，对最深车道行底 #181719
        // 实算 17.87:1，醒目度最高。只改编曲区这一处落点，⛔ 不动
        // Theme.accent 本体（全局唯一强调色，录音键 ● 与循环带等
        // 仍用它）；钢琴卷帘播放头不在本笔范围。
        Rectangle {
            x: root.playhead-px - root.scroll-x;
            y: 0px;
            width: 2px;
            height: parent.height;
            background: Tokens.skin-text-strong;

            // Diamond head at ruler top
            Rectangle {
                x: -4px;
                y: 0px;
                width: 10px;
                height: 10px;
                background: Tokens.skin-text-strong;
                border-radius: 2px;
            }
        }
    }

    // ─── Arrangement Local Menus Backdrop & Popovers ───────────
        if root.active-local-menu != "" : TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.active-local-menu = ""; }
        }

        if root.active-local-menu == "tracks" : Rectangle {
            x: Theme.track-headers-on-right ? parent.width - root.headers-width + 8px : 8px;
            y: 50px;
            width: 196px;
            height: Math.min(parent.height - 58px, arr_tracks_menu_col.preferred-height);
            background: Tokens.bg-panel;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.accent;
            drop-shadow-blur: 14px;
            drop-shadow-color: Tokens.skin-scrim;
            arr_tracks_menu_col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for opt in [
                    { id: "track-add-midi", label: @tr("+ 新建 MIDI 乐器轨") },
                    { id: "track-add-audio", label: @tr("+ 新建音频轨") },
                    { id: "track-add-bus", label: @tr("+ 新建辅助发送轨") },
                    { id: "new-midi-clip", label: @tr("+ 新建 4 小节 MIDI 片段") },
                    { id: "place-audio-clip", label: @tr("将最新导入音频摆放到音频轨") },
                    { id: "track-equal-heights", label: @tr("均分所有轨道高度") },
                    { id: "toggle-chord-lane", label: @tr("显示 / 隐藏和弦轨") },
                    { id: "track-toggle-headers-side", label: @tr("左 / 右侧切换轨道头") },
                ] : Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: trk-m-touch.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: opt.label;
                            font-family: Tokens.font-ui;
                            font-size: 10.5px;
                            color: trk-m-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                            vertical-alignment: center;
                        }
                    }
                    trk-m-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.active-local-menu = "";
                            root.execute-action(opt.id);
                        }
                    }
                }
            }
        }

        if root.active-local-menu == "instrument" : Rectangle {
            x: Theme.track-headers-on-right ? parent.width - root.headers-width - 10px : 10px;
            y: 54px;
            width: 228px;
            height: Math.min(parent.height - 62px, arr_inst_menu_col.preferred-height);
            background: Tokens.bg-panel;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.accent;
            drop-shadow-blur: 16px;
            drop-shadow-color: Tokens.skin-scrim;
            arr_inst_menu_col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Text {
                    text: @tr("更换轨道 #{} 音色 / 插入", root.local-menu-track-id);
                    font-family: Tokens.font-ui;
                    font-size: 10px;
                    font-weight: 600;
                    color: Theme.accent;
                    height: 20px;
                    vertical-alignment: center;
                }
                for preset in [
                    { id: "synth:hollow", label: @tr("合成器 • 柔和主音 (Hollow Lead)") },
                    { id: "synth:organ", label: @tr("合成器 • 风琴键音 (Warm Organ)") },
                    { id: "synth:vocal", label: @tr("合成器 • 人声铺底 (Choir Pad)") },
                    { id: "synth:metallic", label: @tr("合成器 • 金属 FM (FM Bell)") },
                    { id: "synth:glass", label: @tr("合成器 • 水晶拨弦 (Glass Pluck)") },
                    { id: "synth:bass", label: @tr("合成器 • 次低音 (Sub Bass)") },
                    { id: "sfz:default", label: @tr("采样库 • 加载 SFZ 音色...") },
                    { id: "fx:eq", label: @tr("效果槽 • 插入 参量均衡 EQ") },
                    { id: "fx:reverb", label: @tr("效果槽 • 插入 空间混响 Reverb") },
                    { id: "fx:compressor", label: @tr("效果槽 • 插入 动态压缩 Compressor") },
                ] : Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: inst-m-touch.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: preset.label;
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            color: inst-m-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    inst-m-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.active-local-menu = "";
                            root.track-instrument-change(
                                root.local-menu-track-id > 0 ? root.local-menu-track-id : root.selected-track-id,
                                preset.id
                            );
                        }
                    }
                }
            }
        }
}
