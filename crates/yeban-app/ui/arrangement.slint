import { Theme, TrackData, TimelineBlockData, Tokens, TooltipBubble } from "tokens.slint";

export component ArrangementViewport inherits Rectangle {
    in-out property <[TrackData]> tracks;
    in property <[string]> track-volumes: [];
    in-out property <[TimelineBlockData]> timeline-blocks;
    in-out property <int> selected-track-id: 1;
    in property <int> playhead-ticks: 0;
    in property <int> ticks-per-pixel: 30;
    in-out property <length> playhead-px: (root.playhead-ticks / max(1, root.ticks-per-pixel)) * 1px;
    in-out property <bool> is-looping: false;
    property <length> timeline-origin-x: Theme.track-headers-on-right ? 0px : (root.headers-width + 5px);
    property <length> timeline-width: max(0px, root.width - root.headers-width - 5px);
    out property <length> playhead-origin-x: root.timeline-origin-x;
    out property <length> playhead-screen-x: root.timeline-origin-x + root.playhead-px - root.scroll-x;
    // [Q6] 标尺读数：可见小节数 / 小节宽 / 循环区间（全部由宿主从投影写入）。
    in-out property <[length]> bar-positions: [];
    in-out property <int> bar-start-index: 0;
    in-out property <int> bar-count: 0;
    in-out property <length> bar-width-px: 128px;
    in-out property <length> cycle-start-px: 0px;
    in-out property <length> cycle-end-px: 0px;
    in-out property <bool> show-chord-track: false; // 默认收缩折叠和弦轨，给予主工作区更充裕的高度空间
    in-out property <length> headers-width: 216px; // 支持拖拽调整大小 [min: 170px, max: 300px]
    // ⭐ 轨道行几何 / 内容高 / 横向滚动：全部来自宿主投影（track-ys / track-heights /
    // arrangement-sheet-height / roll-scroll-x），界面⛔ 不自己乘行高、⛔ 不自己算内容高。
    in-out property <[length]> track-ys: [];
    in-out property <[length]> track-heights: [];
    in-out property <length> sheet-height: 0px;
    in-out property <length> scroll-x: 0px;
    /// 当前选中的**剪辑摆放身份**（空串 = 没有选中）—— 块边框高亮与点击回填共用。
    in-out property <string> selected-clip-ulid: "";

    callback select-track(int);
    callback toggle-mute(int);
    callback toggle-solo(int);
    callback toggle-arm(int);
    callback add-track();
    callback audition-chord(string);
    callback ruler-seek(length);
    callback scrub-timeline(length);
    /// 滚轮分流：`shift` = 横向滚动、`alt` = 纵向缩放、`shift+alt` = 横向缩放。
    /// 无修饰由界面 `reject` ⇒ 冒泡给 `Flickable` 做纵向滚动。
    callback arrangement-wheel(length, length, bool, bool);
    callback zoom-h-step(bool);
    callback zoom-v-step(bool);

    function handle-arr-scroll(
        delta-x: length,
        delta-y: length,
        shift: bool,
        alt: bool,
        allow-vertical: bool
    ) -> EventResult {
        if shift || alt {
            root.arrangement-wheel(delta-x, delta-y, shift, alt);
            return accept;
        }
        if delta-x != 0px {
            root.arrangement-wheel(delta-x, delta-y, false, false);
            if allow-vertical && delta-y != 0px {
                arr_tracks_flickable.content-y = Math.max(
                    Math.min(0px, arr_tracks_flickable.height - arr_tracks_flickable.content-height),
                    Math.min(0px, arr_tracks_flickable.content-y + delta-y)
                );
            }
            return accept;
        }
        return reject;
    }
    /// 点击时间线块：只报**摆放身份**（`host::wire_clip_scope` 用它把卷帘作用域切到该片段）。
    in-out property <int> local-menu-track-id: 0;
    in-out property <string> active-local-menu: ""; // "", "tracks", "instrument"

    callback track-pan-change(int, float);
    callback track-volume-change(int, float);
    callback track-instrument-change(int, string);
    callback mixer-fader-grab(int, length);
    callback mixer-fader-drag(int, length);
    callback mixer-fader-release(int);
    callback mixer-fader-reset(int);
    callback mixer-pan-grab(int, length);
    callback mixer-pan-drag(int, length);
    callback mixer-pan-release(int);
    callback mixer-pan-reset(int);
    callback execute-action(string);
    callback clip-select(string);

    background: Theme.bg-canvas;
    clip: true;
    accessible-role: main;
    accessible-id: "workspace-arrangement-canvas";
    accessible-label: @tr("工作区编曲画布");

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // TOP HEADER ROW: Track header top box + Ruler + Chord Progression Track (Collapsible)
        Rectangle {
            height: root.show-chord-track ? 54px : 26px;
            // 顶部带底色（Wang 2026-11-16：学 Logic，标尺带比轨道背景浅一档）：
            // 取令牌阶梯里紧邻车道背景 Theme.bg-canvas 的上一档 Theme.bg-panel；
            // 底边显式 1px 分隔线，理顺工具行/标尺与轨道区之间的横线。
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                spacing: 0px;

                // Left top box (if headers on left)
                if !Theme.track-headers-on-right : Rectangle {
                    width: root.headers-width;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        alignment: space-between;

                        // 工具行 (负责人 2026-11-16 四条之 1 / 2): 旧标题
                        // 「轨道控制头 (TRACKS)」只说明区域名、不承载信息, 已删;
                        // 「轨道菜单」置整行最前 (下拉浮层锚点 x=8px 与之对齐),
                        // 其后依次 + 轨道、和弦展开/收起。三钮行为与回调不变。
                        HorizontalLayout {
                            alignment: space-between;
                            // 编曲区本地视图菜单开关（Wang 2026-11-16 令：置于轨道头工具行最前）。
                            // 用可渲染的中文标签，⛔ 不再依赖不渲染的下拉箭头字形；详见细节实测 §5.9。
                            Rectangle {
                                width: 60px;
                                height: 18px;
                                background: root.active-local-menu == "tracks" ? Theme.accent : (arr-menu-touch.has-hover ? #253045 : #161b28);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: root.active-local-menu == "tracks" ? Theme.accent : #ffffff18;
                                Text {
                                    text: @tr("轨道菜单");
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: root.active-local-menu == "tracks" ? #020617 : #e2e8f0;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                arr-menu-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.active-local-menu = root.active-local-menu == "tracks" ? "" : "tracks";
                                    }
                                    scroll-event(event) => {
                                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                    }
                                }
                                TooltipBubble {
                                    text: @tr("编曲轨道与视图本地菜单");
                                    is-visible: arr-menu-touch.has-hover;
                                    tip-offset-y: 22px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                // Chord Track fold toggle
                                Rectangle {
                                    background: root.show-chord-track ? Theme.accent.with-alpha(0.25) : (chord-toggle-touch.has-hover ? #ffffff0d : transparent);
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: root.show-chord-track ? Theme.accent : #ffffff14;
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: root.show-chord-track ? @tr("和弦收起") : @tr("和弦展开");
                                            font-family: Tokens.font-ui;
                                            font-size: 9.5px;
                                            font-weight: 600;
                                            color: root.show-chord-track ? Theme.accent : #cbd5e1;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-toggle-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.show-chord-track = !root.show-chord-track; }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: root.show-chord-track ? @tr("折叠和弦音轨") : @tr("展开和弦音轨");
                                        is-visible: chord-toggle-touch.has-hover;
                                        tip-offset-y: 22px;
                                    }
                                }
                                Rectangle {
                                    background: add-track-top-touch.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.20);
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: Theme.accent.with-alpha(0.6);
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: @tr("+ 轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-top-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("添加新音轨 [Ctrl+T]");
                                        is-visible: add-track-top-touch.has-hover;
                                        tip-offset-y: 22px;
                                    }
                                }

                            }
                        }

                        if root.show-chord-track : Rectangle {
                            height: 22px;
                            background: #141a26;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #1e2638;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: space-between;
                                Text {
                                    text: @tr("全局和弦轨");
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: #cbd5e1;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: @tr("智能和声声学");
                                    font-family: Tokens.font-ui;
                                    font-size: 9px;
                                    color: #b6c2d2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Splitter Divider between Left Track Header top box and Timeline Ruler
                if !Theme.track-headers-on-right : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-header-top-left.has-hover ? Theme.accent : Tokens.divider-row;
                    }
                    split-header-top-left := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                        }
                        double-clicked => {
                            root.headers-width = 240px;
                        }
                        scroll-event(event) => {
                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                        }
                    }
                }

                // Center Timeline Ruler + Chord Progression Blocks
                Rectangle {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        spacing: 0px;

                        // Ruler (24px) - Spans across 24 bars (High contrast WCAG AA labels)
                        // 标尺带 (负责人 2026-11-16 四条之 4): 底比编曲区浅一档,
                        // 走令牌 `Tokens.ruler-brush` (bg-shell), ⛔ 不写死;
                        // 小节号走 `Tokens.ruler-ink`; 底部刻度与下方网格竖线
                        // 同 x 同源 (bar-positions / bar-width-px / scroll-x)。
                        Rectangle {
                            height: 24px;
                            background: Tokens.ruler-brush;
                            clip: true;

                            // [Q6] 标尺格数与间距来自投影（`host::apply_view` 的
                            // `bar-count` / `bar-width-px`），与下方片段块共用同一个
                            // 水平刻度（`blk.start_px = tick / ticks_per_pixel`）。
                            for i in root.bar-count : Text {
                                x: ((root.bar-start-index + i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + i] : (root.bar-start-index + i) * root.bar-width-px) - root.scroll-x;
                                y: 0px;
                                width: root.bar-width-px;
                                height: parent.height;
                                horizontal-alignment: left;
                                text: "" + (root.bar-start-index + i + 1);
                                font-family: Tokens.font-mono;
                                font-size: 9px;
                                font-weight: 600;
                                color: Tokens.ruler-ink;
                                vertical-alignment: center;
                            }

                            // 小节刻度线: 标尺底部 5px, 与编曲区网格竖线同 x ——
                            // 眼睛从小节号垂直落下即对上网格 (四条之 4 的对齐要求)。
                            for i in root.bar-count : Rectangle {
                                x: ((root.bar-start-index + i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + i] : (root.bar-start-index + i) * root.bar-width-px) - root.scroll-x;
                                y: parent.height - 5px;
                                width: 1px;
                                height: 5px;
                                background: Tokens.divider-grid-strong;
                            }

                            // 循环指示带：区间来自视图态（`cycle-start/end-ticks`），
                            // ⛔ 不再是写死的 `x: 150px / width: 220px`。
                            if root.is-looping && root.cycle-end-px > root.cycle-start-px : Rectangle {
                                x: root.cycle-start-px - root.scroll-x;
                                y: 0px;
                                width: root.cycle-end-px - root.cycle-start-px;
                                height: 3px;
                                background: Theme.accent;
                                border-radius: 1.5px;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        root.ruler-seek(self.mouse-x);
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        root.ruler-seek(self.mouse-x);
                                    }
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                }
                            }

                            // ⭐ 可见缩放控件：横向 / 纵向各一对（与滚轮、快捷键同一条宿主入口
                            // `zoom-h-step` / `zoom-v-step`）。滚轮 / 快捷键仍可用。
                            Rectangle {
                                x: parent.width - 120px;
                                y: 2px;
                                width: 114px;
                                height: 20px;
                                background: #0b0e16cc;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff14;

                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    spacing: 2px;
                                    alignment: space-between;

                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: hz-out-touch.has-hover ? #1f2736 : transparent;
                                        Text { text: "H−"; font-family: Tokens.font-mono; font-size: 9.5px; color: #cbd5e1; horizontal-alignment: center; vertical-alignment: center; }
                                        hz-out-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-h-step(false); } }
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: hz-in-touch.has-hover ? #1f2736 : transparent;
                                        Text { text: "H+"; font-family: Tokens.font-mono; font-size: 9.5px; color: #cbd5e1; horizontal-alignment: center; vertical-alignment: center; }
                                        hz-in-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-h-step(true); } }
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: vt-out-touch.has-hover ? #1f2736 : transparent;
                                        Text { text: "V−"; font-family: Tokens.font-mono; font-size: 9.5px; color: #cbd5e1; horizontal-alignment: center; vertical-alignment: center; }
                                        vt-out-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-v-step(false); } }
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: vt-in-touch.has-hover ? #1f2736 : transparent;
                                        Text { text: "V+"; font-family: Tokens.font-mono; font-size: 9.5px; color: #cbd5e1; horizontal-alignment: center; vertical-alignment: center; }
                                        vt-in-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-v-step(true); } }
                                    }
                                }
                            }
                        }

                        // Chord Progression Track (30px) - Harmonized with mineral color order (Collapsible)
                        if root.show-chord-track : Rectangle {
                            height: 30px;
                            background: #0d1017;

                            HorizontalLayout {
                                padding: 3px;
                                spacing: 4px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-1-touch.has-hover ? #1b283835 : #1b283818;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-1-touch.has-hover ? #38769170 : #38769135;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Cm9 (i9)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: #8cb8cc;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: #b6c2d2;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-1-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Cm9"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Cm9 (主和弦) 配置");
                                        is-visible: chord-1-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-2-touch.has-hover ? #2d203835 : #2d203818;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-2-touch.has-hover ? #705e8870 : #705e8835;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "AbMaj7 (VI7)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: #b39cc7;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: #b6c2d2;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-2-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("AbMaj7"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 AbMaj7 (下中音和弦) 配置");
                                        is-visible: chord-2-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-3-touch.has-hover ? #182c2635 : #182c2618;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-3-touch.has-hover ? #34786470 : #34786435;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Fm11 (iv11)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: #80bca8;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: #b6c2d2;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-3-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Fm11"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Fm11 (下属和弦) 配置");
                                        is-visible: chord-3-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-4-touch.has-hover ? #34261635 : #34261618;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-4-touch.has-hover ? #9a6a3870 : #9a6a3835;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "G7#9 (V7#9)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: #c7a46e;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: #b6c2d2;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-4-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("G7#9"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 G7#9 (属和弦变化音) 配置");
                                        is-visible: chord-4-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-5-touch.has-hover ? #1b283835 : #1b283818;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-5-touch.has-hover ? #38769170 : #38769135;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Cm11 (i11)";
                                            font-family: Tokens.font-mono;
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: #8cb8cc;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 8px;
                                            // ⭐ WCAG AA：8px 小字也须 ≥3:1（实测 #64748b 在 #161b28 上仅 3.61:1）。
                                            // 改用「次要文字下限」#7c8aa0（最亮底 #161b28 上 4.91:1）。
                                            color: #7c8aa0;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-5-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Cm11"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Cm11 (扩展主和弦) 配置");
                                        is-visible: chord-5-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }
                    }
                }

                // Splitter Divider between Timeline Ruler and Right Track Header top box
                if Theme.track-headers-on-right : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-header-top-right.has-hover ? Theme.accent : Tokens.divider-row;
                    }
                    split-header-top-right := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                        }
                        double-clicked => {
                            root.headers-width = 240px;
                        }
                        scroll-event(event) => {
                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                        }
                    }
                }

                // Right top box (if headers on right)
                if Theme.track-headers-on-right : Rectangle {
                    width: root.headers-width;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        alignment: space-between;

                        // 右置变体同左置口径 (负责人 2026-11-16 四条之 1):
                        // 旧标题「轨道控制头 (右置)」只说明区域名, 已删。
                        HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                background: add-track-right-touch.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.18);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.accent;
                                height: 18px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: @tr("+ 轨道");
                                        font-family: Tokens.font-ui;
                                        font-size: 9px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                                add-track-right-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.add-track(); }
                                    scroll-event(event) => {
                                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                    }
                                }
                                TooltipBubble {
                                    text: @tr("添加新音轨 [Ctrl+T]");
                                    is-visible: add-track-right-touch.has-hover;
                                    tip-offset-y: 22px;
                                }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            background: Theme.accent.with-alpha(0.12);
                            border-radius: 3px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: @tr("右置轨道头模式 (镜像工作区)");
                                    font-family: Tokens.font-ui;
                                    font-size: 8px;
                                    color: #cbd5e1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 工具行 / 标尺与轨道区之间的横线 (负责人 2026-11-16 四条之 3):
            // 一条 1px 线跨整个顶行 (工具盒 + 标尺同色同高), 走令牌层
            // `Tokens.divider-row`, ⛔ 不再靠顶行 Rectangle 的 border 兼任。
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Tokens.divider-row;
            }

            // 刻蚀高光 (只拟物套有值, 扁平套 alpha=0): 主线下方 1px。
            Rectangle {
                x: 0px;
                y: parent.height;
                width: parent.width;
                height: 1px;
                background: Tokens.divider-row-highlight;
            }
        }

        // TRACK LANES CONTAINER
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // ⭐ 轨道一多（16 轨 × 56px = 896px）时，固定高度的 VerticalLayout 会把
            // 内容撑出工作区、把下方钢琴卷帘/混音台顶出窗口。这里改成纵向 Flickable：
            // 内容高 = 投影的 `sheet-height`，行 y / 行高 = 投影的 `track-ys` /
            // `track-heights` ⇒ 轨道再多也只在自己的窗口里滚动，⛔ 不挤占下坞。
            arr_tracks_flickable := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: max(self.height, root.sheet-height + 42px + 46px);
                interactive: true;

                // 背景滚轮兜底（含顶部 42px 留白与末尾空白区），保证双指横向/纵向滑动在整块区域均响应
                TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: arr_tracks_flickable.content-height;
                    scroll-event(event) => {
                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                    }
                }

                for trk[idx] in root.tracks : Rectangle {
                    y: root.track-ys[idx];
                    height: root.track-heights[idx];
                    width: parent.width;
                    background: trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.08) : transparent;
                    border-color: trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.70) : #ffffff0a;
                    border-width: trk.id == root.selected-track-id ? 1.5px : 0px;

                    HorizontalLayout {
                        spacing: 0px;

                        // Left Track Header (if not headers on right)
                        if !Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            background: trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.10) : (Tokens.texture-physical ? Tokens.track-head-brush : #0b0e16);
                            border-color: trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.80) : Theme.border-subtle;

                            // Left color strip (illuminated on focus)
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: trk.id == root.selected-track-id ? 5px : 3.5px;
                                height: parent.height;
                                background: trk.color;
                            }

                            TouchArea {
                                clicked => { root.select-track(trk.id); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 4px;
                                    Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: trk.id == root.selected-track-id ? #ffffff : #cbd5e1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        background: badge-left-touch.has-hover ? #1e293b : #00000050;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: badge-left-touch.has-hover ? Theme.accent : #ffffff14;
                                        max-width: 82px;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            Text {
                                                text: (trk.insert1 != "" ? trk.insert1 : trk.kind) + " [v]";
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-left-touch.has-hover ? #f8fafc : #cbd5e1;
                                                font-weight: 400;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                        badge-left-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.select-track(trk.id);
                                                root.local-menu-track-id = trk.id;
                                                root.active-local-menu = root.active-local-menu == "instrument" ? "" : "instrument";
                                            }
                                            scroll-event(event) => {
                                                root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                            }
                                        }
                                        TooltipBubble {
                                            text: @tr("点击更换音色/效果 [当前: {}]", trk.insert1 != "" ? trk.insert1 : trk.kind);
                                            is-visible: badge-left-touch.has-hover;
                                            tip-offset-y: 22px;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: space-between;

                                    // M S R buttons (Studio colors: Amber / Gold / Crimson)
                                    HorizontalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.muted ? #f59e0b : (m-btn-touch.has-hover ? #1f2432 : #141822);
                                            border-width: 1px;
                                            border-color: trk.muted ? #d97706 : #ffffff14;
                                            Text {
                                                text: "M";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.muted ? #0f172a : (m-btn-touch.has-hover ? #f8fafc : #cbd5e1);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            m-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-mute(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.muted ? @tr("取消静音 [M]") : @tr("静音轨道 [M]");
                                                is-visible: m-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.soloed ? #eab308 : (s-btn-touch.has-hover ? #1f2432 : #141822);
                                            border-width: 1px;
                                            border-color: trk.soloed ? #ca8a04 : #ffffff14;
                                            Text {
                                                text: "S";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.soloed ? #0f172a : (s-btn-touch.has-hover ? #f8fafc : #cbd5e1);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            s-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-solo(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.soloed ? @tr("取消独奏 [S]") : @tr("独奏轨道 [S]");
                                                is-visible: s-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.armed ? #ef4444 : (r-btn-touch.has-hover ? #1f2432 : #141822);
                                            border-width: 1px;
                                            border-color: trk.armed ? #dc2626 : #ffffff14;
                                            Text {
                                                text: "R";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.armed ? #ffffff : (r-btn-touch.has-hover ? #f8fafc : #cbd5e1);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            r-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-arm(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.armed ? @tr("取消录音准备 [R]") : @tr("录音准备 (Arm) [R]");
                                                is-visible: r-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                    }

                                    // Pan widget + Volume dB + Vertical precision meter
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        // Pan widget
                                        Rectangle {
                                            width: 38px;
                                            height: 20px;
                                            background: pan-touch.has-hover ? #182030 : #10141e;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: #ffffff14;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "P";
                                                    font-family: Tokens.font-mono;
                                                    font-size: 8.5px;
                                                    font-weight: 400;
                                                    color: #b6c2d2;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: trk.pan;
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9px;
                                                    font-weight: 400;
                                                    color: #e2e8f0;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            pan-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ew-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-pan-grab(trk.id - 1, self.mouse-x);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-pan-drag(trk.id - 1, self.mouse-x);
                                                    } else {
                                                        root.mixer-pan-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-pan-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("声像: {} (左右拖拽调节，双击归中)", trk.pan);
                                                is-visible: pan-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        // Volume dB text
                                        Rectangle {
                                            width: 44px;
                                            height: 20px;
                                            background: vol-touch.has-hover ? #182030 : transparent;
                                            border-radius: 3px;
                                            border-width: vol-touch.has-hover ? 1px : 0px;
                                            border-color: #ffffff14;
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.track-volumes.length > idx ? (root.track-volumes[idx] + "dB") : ("" + (Math.round(trk.volume_db * 10.0) / 10.0) + "dB");
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9.5px;
                                                    color: #e2e8f0;
                                                    font-weight: 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            vol-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ns-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-fader-grab(trk.id - 1, self.mouse-y);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-fader-drag(trk.id - 1, self.mouse-y);
                                                    } else {
                                                        root.mixer-fader-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-fader-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("推子增益: {} dB (上下拖拽调节，双击归 0dB)", root.track-volumes.length > idx ? root.track-volumes[idx] : ("" + Math.round(trk.volume_db * 10.0) / 10.0));
                                                is-visible: vol-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        // Vertical Level Meter with Peak Indicator
                                        Rectangle {
                                            width: 6px;
                                            height: 20px;
                                            background: Tokens.texture-physical ? Tokens.void-brush : #06080d;
                                            border-radius: 1.5px;
                                            border-width: 0.8px;
                                            border-color: #ffffff14;
                                            clip: true;

                                            Rectangle {
                                                x: 0;
                                                y: parent.height - (trk.muted ? 0px : (trk.meter_peak * parent.height));
                                                width: 6px;
                                                height: trk.muted ? 0px : (trk.meter_peak * parent.height);
                                                border-radius: 1px;
                                                background: trk.meter_peak > 0.8 ? #ef4444 : (trk.meter_peak > 0.6 ? #f59e0b : #10b981);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Splitter Divider between Left Track Header and Timeline Lane
                        if !Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-left.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-left := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Center Timeline Lane
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;

                            // [Q6] 小节网格：位置 / 间距与标尺、片段块同源
                            // （每 4 小节一条强调线，索引 0 起 ⇒ `i.mod(4) == 0`）。
                            // 线色走令牌 (四条之 3 / 4): 强档 = divider-grid-strong,
                            // 弱档 = divider-grid; 与标尺底部刻度同 x 对齐。
                            for i in root.bar-count : Rectangle {
                                x: ((root.bar-start-index + i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + i] : (root.bar-start-index + i) * root.bar-width-px) - root.scroll-x;
                                y: 0px;
                                width: 1px;
                                height: parent.height;
                                background: (root.bar-start-index + i).mod(4) == 0 ? Tokens.divider-grid-strong : Tokens.divider-grid;
                            }

                            // 背景选择与滚轮面必须先于片段块声明，避免遮挡 Clip 点击
                            TouchArea {
                                clicked => { root.select-track(trk.id); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            // Timeline Clips for this track
                            for blk in root.timeline-blocks : Rectangle {
                                if blk.track_id == trk.id : Rectangle {
                                    x: blk.start_px - root.scroll-x;
                                    y: 4px;
                                    width: blk.width_px;
                                    height: Math.max(52px, parent.height - 8px);
                                    border-radius: 4px;
                                    background: trk.color.with-alpha(0.12);
                                    border-width: blk.clip_ulid != "" && blk.clip_ulid == root.selected-clip-ulid ? 2px : 1px;
                                    border-color: blk.clip_ulid != "" && blk.clip_ulid == root.selected-clip-ulid ? #ffffff : trk.color.with-alpha(0.55);
                                    clip: true;

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: blk.label;
                                                font-family: Tokens.font-ui;
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: #f1f5f9;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            // 自动隐藏规则：宽度不足 110px 时隐藏 Gain 标签，优先完整显示标题，避免截断遮挡
                                            if blk.width_px >= 110px : Text {
                                                text: blk.gain_label;
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: #cbd5e1;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // ⭐ 真实波形（ADR-0076 B1）：`blk.waveform-peaks` 非空时按柱画
                                        // （每柱取该段 |sample| 最大值，由 bridge::compute_waveform_peaks 算）；
                                        // 空 = 尚未分析 ⇒ 只留 0dB 基准线并标「示意」，
                                        // ⛔ 绝不画常量折线冒充包络（细节实测 §3.1）。
                                        if blk.is_audio : Rectangle {
                                            height: Math.max(22px, parent.height - 26px);
                                            clip: true;

                                            // 0dB Centerline（基准线，不是编造的包络）
                                            Rectangle {
                                                x: 0px;
                                                y: parent.height / 2;
                                                width: parent.width;
                                                height: 1px;
                                                background: trk.color.with-alpha(0.20);
                                            }

                                            // 真实峰值柱：peaks 为空时 0 个（不画）。
                                            for peak_index in blk.waveform-peaks.length : Rectangle {
                                                x: 4px + peak_index * ((parent.width - 8px) / blk.waveform-peaks.length);
                                                width: Math.max(1px, (parent.width - 8px) / blk.waveform-peaks.length - 1px);
                                                // ⚠ Slint 里 length × float 必须显式换算：先除 1px 变成数，
                                                // 乘完再乘 1px 变回 length（否则编译期报
                                                // 「Cannot convert float to length」）。
                                                height: Math.max(1px, ((parent.height - 8px) / 1px) * blk.waveform-peaks[peak_index] * 1px);
                                                y: (parent.height - self.height) / 2;
                                                background: trk.color.with-alpha(0.85);
                                            }

                                            Text {
                                                x: 4px;
                                                y: 2px;
                                                width: parent.width - 8px;
                                                text: @tr("波形待分析 · 示意");
                                                // 窄片段放不下整句 ⇒ 不显示被裁成「波形」的半截误导文案；
                                                // 完整语义仍保留在代码与 accessible-label 里。
                                                // 有真实峰值时不再显示该标注。
                                                visible: parent.width >= 88px && blk.waveform-peaks.length == 0;
                                                accessible-role: text;
                                                accessible-label: @tr("波形待分析 · 示意（资产不在会话池或解码失败，当前为 0dB 基准线占位）");
                                                font-family: Tokens.font-mono;
                                                font-size: 8.5px;
                                                color: #b6c2d2;
                                                horizontal-alignment: left;
                                                vertical-alignment: top;
                                            }
                                        }

                                        // MIDI Polyphonic Score Display (driven strictly by real blk.note_count)
                                        if !blk.is_audio : Rectangle {
                                            height: Math.max(22px, parent.height - 26px);
                                            clip: true;

                                            // Pitch division guideline
                                            Rectangle {
                                                x: 0px;
                                                y: parent.height / 2;
                                                width: parent.width;
                                                height: 1px;
                                                background: trk.color.with-alpha(0.15);
                                            }

                                            if blk.note_count <= 0 && blk.width_px >= 90px : Text {
                                                x: 8px;
                                                y: (parent.height - self.height) / 2;
                                                text: @tr("空片段");
                                                font-family: Tokens.font-ui;
                                                font-size: 9.5px;
                                                color: #b6c2d2;
                                            }

                                            if blk.note_count > 0 : HorizontalLayout {
                                                x: 8px;
                                                y: 6px;
                                                width: Math.max(12px, parent.width - 16px);
                                                height: Math.max(10px, parent.height - 10px);
                                                spacing: 3px;
                                                for n_idx in Math.min(16, blk.note_count) : Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 4px;
                                                    border-radius: 1px;
                                                    background: trk.color;
                                                    y: Math.mod(n_idx * 5, 14) * 1px;
                                                }
                                            }
                                        }
                                    }

                                    // 二期质感: 片段顶光/底影 (只 physical; flat 下 alpha
                                    // 为 0, 不画像素)。本体是数据色 (轨道色 + alpha, 信息
                                    // 编码), 只在其上下沿各叠 1px, 不动本体。
                                    // ⚠ 两条线必须内缩一个边框宽: 本片段 `clip: true` 把
                                    // 子元素裁到边框内侧, 贴边 (y=0 / height-1) 的 1px 线
                                    // 会被整条裁掉 (盒上实证: α 拉到 0.5 仍零像素; 内缩
                                    // 后正常出图)。边框宽与本块 border-width 同表达式。
                                    Rectangle {
                                        x: 0;
                                        y: blk.clip_ulid != "" && blk.clip_ulid == root.selected-clip-ulid ? 2px : 1px;
                                        width: parent.width;
                                        height: 1px;
                                        background: Tokens.clip-sheen;
                                    }
                                    Rectangle {
                                        x: 0;
                                        y: parent.height - (blk.clip_ulid != "" && blk.clip_ulid == root.selected-clip-ulid ? 3px : 2px);
                                        width: parent.width;
                                        height: 1px;
                                        background: Tokens.clip-shade;
                                    }

                                    // ⭐ 点击片段 = 选中该**摆放**：卷帘作用域随 `clip-select` 切到它
                                    // （⛔ 不再"所有轨道的全部音符混在一起"）。
                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.clip-select(blk.clip_ulid); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                        }
                                    }
                                }
                            }
                        }

                        // Splitter Divider between Timeline Lane and Right Track Header
                        if Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-right.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-right := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Right Track Header (if right mode)
                        if Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            background: trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.10) : (Tokens.texture-physical ? Tokens.track-head-brush : #0b0e16);
                            border-color: trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.80) : Theme.border-subtle;

                            Rectangle {
                                x: parent.width - 4px;
                                y: 0;
                                width: trk.id == root.selected-track-id ? 5px : 3.5px;
                                height: parent.height;
                                background: trk.color;
                            }

                            TouchArea {
                                clicked => { root.select-track(trk.id); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 4px;
                                    Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: trk.id == root.selected-track-id ? #ffffff : #cbd5e1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        background: badge-right-touch.has-hover ? #1e293b : #00000050;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: badge-right-touch.has-hover ? Theme.accent : #ffffff14;
                                        max-width: 82px;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            Text {
                                                text: (trk.insert1 != "" ? trk.insert1 : trk.kind) + " [v]";
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-right-touch.has-hover ? #f8fafc : #cbd5e1;
                                                font-weight: 400;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                        badge-right-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.select-track(trk.id);
                                                root.local-menu-track-id = trk.id;
                                                root.active-local-menu = root.active-local-menu == "instrument" ? "" : "instrument";
                                            }
                                            scroll-event(event) => {
                                                root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                            }
                                        }
                                        TooltipBubble {
                                            text: @tr("点击更换音色/效果 [当前: {}]", trk.insert1 != "" ? trk.insert1 : trk.kind);
                                            is-visible: badge-right-touch.has-hover;
                                            tip-offset-y: 22px;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 3px;
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.muted ? #f59e0b : (m-btn-r-touch.has-hover ? #1f2432 : #141822);
                                            border-width: 1px;
                                            border-color: trk.muted ? #d97706 : #ffffff14;
                                            Text {
                                                text: "M";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.muted ? #0f172a : (m-btn-r-touch.has-hover ? #f8fafc : #cbd5e1);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            m-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-mute(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.muted ? @tr("取消静音 [M]") : @tr("静音轨道 [M]");
                                                is-visible: m-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.soloed ? #eab308 : (s-btn-r-touch.has-hover ? #1f2432 : #141822);
                                            border-width: 1px;
                                            border-color: trk.soloed ? #ca8a04 : #ffffff14;
                                            Text {
                                                text: "S";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.soloed ? #0f172a : (s-btn-r-touch.has-hover ? #f8fafc : #cbd5e1);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            s-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-solo(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.soloed ? @tr("取消独奏 [S]") : @tr("独奏轨道 [S]");
                                                is-visible: s-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.armed ? #ef4444 : (r-btn-r-touch.has-hover ? #1f2432 : #141822);
                                            border-width: 1px;
                                            border-color: trk.armed ? #dc2626 : #ffffff14;
                                            Text {
                                                text: "R";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.armed ? #ffffff : (r-btn-r-touch.has-hover ? #f8fafc : #cbd5e1);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            r-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-arm(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.armed ? @tr("取消录音准备 [R]") : @tr("录音准备 (Arm) [R]");
                                                is-visible: r-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        Rectangle {
                                            width: 38px;
                                            height: 20px;
                                            background: pan-r-touch.has-hover ? #182030 : #10141e;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: #ffffff14;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "P";
                                                    font-family: Tokens.font-mono;
                                                    font-size: 8.5px;
                                                    font-weight: 400;
                                                    color: #b6c2d2;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: trk.pan;
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9px;
                                                    font-weight: 400;
                                                    color: #e2e8f0;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            pan-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ew-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-pan-grab(trk.id - 1, self.mouse-x);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-pan-drag(trk.id - 1, self.mouse-x);
                                                    } else {
                                                        root.mixer-pan-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-pan-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("声像: {} (左右拖拽调节，双击归中)", trk.pan);
                                                is-visible: pan-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 44px;
                                            height: 20px;
                                            background: vol-r-touch.has-hover ? #182030 : transparent;
                                            border-radius: 3px;
                                            border-width: vol-r-touch.has-hover ? 1px : 0px;
                                            border-color: #ffffff14;
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.track-volumes.length > idx ? (root.track-volumes[idx] + "dB") : ("" + (Math.round(trk.volume_db * 10.0) / 10.0) + "dB");
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9.5px;
                                                    color: #e2e8f0;
                                                    font-weight: 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            vol-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ns-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-fader-grab(trk.id - 1, self.mouse-y);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-fader-drag(trk.id - 1, self.mouse-y);
                                                    } else {
                                                        root.mixer-fader-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-fader-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("推子增益: {} dB (上下拖拽调节，双击归 0dB)", root.track-volumes.length > idx ? root.track-volumes[idx] : ("" + Math.round(trk.volume_db * 10.0) / 10.0));
                                                is-visible: vol-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 6px;
                                            height: 20px;
                                            background: Tokens.texture-physical ? Tokens.void-brush : #06080d;
                                            border-radius: 1.5px;
                                            border-width: 0.8px;
                                            border-color: #ffffff14;
                                            clip: true;

                                            Rectangle {
                                                x: 0;
                                                y: parent.height - (trk.muted ? 0px : (trk.meter_peak * parent.height));
                                                width: 6px;
                                                height: trk.muted ? 0px : (trk.meter_peak * parent.height);
                                                border-radius: 1px;
                                                background: trk.meter_peak > 0.8 ? #ef4444 : (trk.meter_peak > 0.6 ? #f59e0b : #10b981);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // 行底分界线（Wang 2026-11-16：学 Logic 的行间低对比细线）：整行一根
                    // ⇒ 轨道头列与车道侧同一 y 位对齐；色用既有分隔令牌 Theme.border-subtle。
                    // 选中行已有 accent 边框，不再叠加本线。
                    Rectangle {
                        x: 0px;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Tokens.divider-row;
                        visible: trk.id != root.selected-track-id;
                    }

                    // 刻蚀高光 (只拟物套): 主线下方 1px (下一行顶沿)。
                    Rectangle {
                        x: 0px;
                        y: parent.height;
                        width: parent.width;
                        height: 1px;
                        background: Tokens.divider-row-highlight;
                    }
                }

                // Empty Track Lane Canvas / Add Track Drop Zone (Placed strictly below sheet-height + top offset inside Flickable)
                Rectangle {
                    y: root.sheet-height + 42px;
                    vertical-stretch: 0;
                    height: 38px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 0px;

                        // Left Header Box placeholder
                        if !Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 24px;
                                    background: add-track-btm-touch.has-hover ? #1f2736 : #141a24;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #ffffff14;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: @tr("+ 点击添加新轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: #cbd5e1;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-btm-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("创建新音频或MIDI轨道 [Ctrl+T]");
                                        is-visible: add-track-btm-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }

                        // Splitter Divider between Left Placeholder and Bottom Grid Area
                        if !Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-btm-left.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-btm-left := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Center Grid Area
                        Rectangle {
                            horizontal-stretch: 1;

                            // [Q6] 行内网格与顶部标尺同源（bar-count / bar-width-px / scroll-x）
                            for _i in root.bar-count : Rectangle {
                                visible: ((root.bar-start-index + _i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + _i] : (root.bar-start-index + _i) * root.bar-width-px) - root.scroll-x >= 0px;
                                x: ((root.bar-start-index + _i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + _i] : (root.bar-start-index + _i) * root.bar-width-px) - root.scroll-x;
                                y: 0px;
                                width: 1px;
                                height: parent.height;
                                background: Tokens.divider-grid;
                            }

                            // 空态提示按**视口**居中：此前放在内容网格的同级
                            // HorizontalLayout 里，按 bar-count × bar-width 的内容宽度
                            // 居中，整句被推到右缘只剩半句（细节实测 §4.8）。
                            // 显式 width = parent.width（视口）+ word-wrap ⇒ 不再被裁断。
                            Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("在此区域拖拽音频、MIDI 文件或双击以新增轨道");
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 500;
                                color: #b6c2d2;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            drop_zone_touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.add-track(); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                            TooltipBubble {
                                text: @tr("双击或点击此区域添加新轨道 [Ctrl+T]");
                                is-visible: drop_zone_touch.has-hover;
                                tip-offset-y: 20px;
                            }
                        }

                        // Splitter Divider between Bottom Grid Area and Right Placeholder
                        if Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-btm-right.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-btm-right := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Right Header Box placeholder (if right mode)
                        if Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 24px;
                                    background: add-track-btm-r-touch.has-hover ? #1f2736 : #141a24;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #ffffff14;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: @tr("+ 点击添加新轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: #cbd5e1;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-btm-r-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("创建新音频或MIDI轨道 [Ctrl+T]");
                                        is-visible: add-track-btm-r-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Animated Playhead Overlay (clipped strictly to Center Timeline region, spanning Ruler down through Track Lanes)
    Rectangle {
        x: root.timeline-origin-x;
        y: 0px;
        width: root.timeline-width;
        height: parent.height;
        clip: true;

        Rectangle {
            x: root.playhead-px - root.scroll-x;
            y: 0px;
            width: 2px;
            height: parent.height;
            background: Theme.accent;

            // Diamond head at ruler top
            Rectangle {
                x: -4px;
                y: 0px;
                width: 10px;
                height: 10px;
                background: Theme.accent;
                border-radius: 2px;
            }
        }
    }

    // ─── Arrangement Local Menus Backdrop & Popovers ───────────
        if root.active-local-menu != "" : TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.active-local-menu = ""; }
        }

        if root.active-local-menu == "tracks" : Rectangle {
            x: Theme.track-headers-on-right ? parent.width - root.headers-width + 8px : 8px;
            y: 50px;
            width: 196px;
            height: Math.min(parent.height - 58px, arr_tracks_menu_col.preferred-height);
            background: #141923;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.accent;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000090;
            arr_tracks_menu_col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for opt in [
                    { id: "track-add-midi", label: @tr("+ 新建 MIDI 乐器轨") },
                    { id: "track-add-audio", label: @tr("+ 新建音频轨") },
                    { id: "track-add-bus", label: @tr("+ 新建辅助发送轨") },
                    { id: "new-midi-clip", label: @tr("+ 新建 4 小节 MIDI 片段") },
                    { id: "place-audio-clip", label: @tr("将最新导入音频摆放到音频轨") },
                    { id: "track-equal-heights", label: @tr("均分所有轨道高度") },
                    { id: "toggle-chord-lane", label: @tr("显示 / 隐藏和弦轨") },
                    { id: "track-toggle-headers-side", label: @tr("左 / 右侧切换轨道头") },
                ] : Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: trk-m-touch.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: opt.label;
                            font-family: Tokens.font-ui;
                            font-size: 10.5px;
                            color: trk-m-touch.has-hover ? #ffffff : #cbd5e1;
                            vertical-alignment: center;
                        }
                    }
                    trk-m-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.active-local-menu = "";
                            root.execute-action(opt.id);
                        }
                    }
                }
            }
        }

        if root.active-local-menu == "instrument" : Rectangle {
            x: Theme.track-headers-on-right ? parent.width - root.headers-width - 10px : 10px;
            y: 54px;
            width: 228px;
            height: Math.min(parent.height - 62px, arr_inst_menu_col.preferred-height);
            background: #141923;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.accent;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;
            arr_inst_menu_col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Text {
                    text: @tr("更换轨道 #{} 音色 / 插入", root.local-menu-track-id);
                    font-family: Tokens.font-ui;
                    font-size: 10px;
                    font-weight: 600;
                    color: Theme.accent;
                    height: 20px;
                    vertical-alignment: center;
                }
                for preset in [
                    { id: "synth:hollow", label: @tr("合成器 • 柔和主音 (Hollow Lead)") },
                    { id: "synth:organ", label: @tr("合成器 • 风琴键音 (Warm Organ)") },
                    { id: "synth:vocal", label: @tr("合成器 • 人声铺底 (Choir Pad)") },
                    { id: "synth:metallic", label: @tr("合成器 • 金属 FM (FM Bell)") },
                    { id: "synth:glass", label: @tr("合成器 • 水晶拨弦 (Glass Pluck)") },
                    { id: "synth:bass", label: @tr("合成器 • 次低音 (Sub Bass)") },
                    { id: "sfz:default", label: @tr("采样库 • 加载 SFZ 音色...") },
                    { id: "fx:eq", label: @tr("效果槽 • 插入 参量均衡 EQ") },
                    { id: "fx:reverb", label: @tr("效果槽 • 插入 空间混响 Reverb") },
                    { id: "fx:compressor", label: @tr("效果槽 • 插入 动态压缩 Compressor") },
                ] : Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: inst-m-touch.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: preset.label;
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            color: inst-m-touch.has-hover ? #ffffff : #cbd5e1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    inst-m-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.active-local-menu = "";
                            root.track-instrument-change(
                                root.local-menu-track-id > 0 ? root.local-menu-track-id : root.selected-track-id,
                                preset.id
                            );
                        }
                    }
                }
            }
        }
}
