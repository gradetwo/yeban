import { ImeAwareTextInput, Theme, TrackData, TimelineBlockData, Tokens, TooltipBubble, UiMonoText, UiText } from "tokens.slint";

// T-FIX-166：轨道头右键菜单的单条。`a11y-id` 必须是**调用点字面量**——仓库的
// `slint_accessible_ids_and_registry_cover_each_other` 会逐行扫 `a11y-id:` 并和
// `elements.rs` 注册表双向对账；写成 `for` 循环里的 `accessible-id: opt.a11y`
// 会让静态扫描看不到成员（实测红：注册表有 8 条、ui/ 一条都找不到）。
component TrackContextMenuItem inherits Rectangle {
    in property <string> a11y-id;
    in property <string> label;
    callback activate();

    height: 30px;
    border-radius: 4px;
    background: item-touch.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
    accessible-role: button;
    accessible-id: root.a11y-id;
    accessible-label: root.label;
    accessible-action-default => {
        root.activate();
    }

    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.label;
        font-family: Tokens.font-ui;
        font-size: Tokens.font-size-xs;
        color: item-touch.has-hover ? Tokens.skin-text-strong : Tokens.ink-1;
        vertical-alignment: center;
        overflow: elide;
    }

    item-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.activate();
        }
    }
}

export component ArrangementViewport inherits Rectangle {
    in-out property <[TrackData]> tracks;
    // ⭐ D1/D2：轨道行电平柱接**引擎实时电平**（与混音台同一份 `track-meter-levels`）。
    // 以前这里的柱高绑的是 `trk.meter_peak`（工程/演示数据里的静态值），播放时纹丝不动；
    // 现在只要 `is-playing` 且该轨有实时值就用实时值；没有读数时回落到 0（下限），
    // ⛔ 不再回落到 `TrackData.meter_peak` —— 那个字段已从投影里删除（生产路径恒 0）。
    in property <[float]> meter-levels: [];
    in property <bool> is-playing: false;
    // 电平值取值：播放中且该轨有实时值 → 用实时值（钳到 0..1）；否则 0.0（下限）。
    // 用函数而不是内联三元，是为了两处电平柱（第一份/第二份轨道行）共用同一条判据。
    pure function meter-val(i: int) -> float {
        if (root.is-playing && root.meter-levels.length > i) {
            Math.min(1.0, Math.max(0.0, root.meter-levels[i]))
        } else {
            0.0
        }
    }
    in property <[string]> track-volumes: [];
    in-out property <[TimelineBlockData]> timeline-blocks;
    in-out property <int> selected-track-id: 1;
    in property <int> playhead-ticks: 0;
    in property <int> ticks-per-pixel: 30;
    in-out property <length> playhead-px: (root.playhead-ticks / max(1, root.ticks-per-pixel)) * 1px;
    in-out property <bool> is-looping: false;
    property <length> timeline-origin-x: Theme.track-headers-on-right ? 0px : (root.headers-width + 5px);
    // 时间线**可见宽**（已扣包头与 5px 缝）。几何只在这里算一次：宿主 ⛔ 不复制
    // `- headers - 5` 这串算术（包头宽度可拖，缝宽改一次就会两边不同步）。
    out property <length> timeline-width: max(0px, root.width - root.headers-width - 5px);
    /// 把上面那格几何回读给宿主（T-FIX-110 的播放跟进要判「播放头是否越出可见区」）。
    ///
    /// 用回调而⛔ 不用「宿主直接读本组件的 `out` 属性」：本组件在 `app.slint` 里坐在
    /// `if !root.console-maximized` 的条件分支内，而**条件元素里的 id 无法从根作用域引用**
    /// （Slint 的 id 只在声明处之后、同一作用域内可见）⇒ 只能自下而上报一格。
    callback timeline-width-changed(length);
    changed timeline-width => { root.timeline-width-changed(root.timeline-width); }
    out property <length> playhead-origin-x: root.timeline-origin-x;
    out property <length> playhead-screen-x: root.timeline-origin-x + root.playhead-px - root.scroll-x;
    // [Q6] 标尺读数：可见小节数 / 小节宽 / 循环区间（全部由宿主从投影写入）。
    in-out property <[length]> bar-positions: [];
    in-out property <int> bar-start-index: 0;
    in-out property <int> bar-count: 0;
    in-out property <length> bar-width-px: 128px;
    // T-FIX-152 曲式段落带：数据来自 ViewState.sections，宿主经 apply_view 注入
    // section-names / section-colors / section-positions / section-widths。
    in property <[string]> section-names: [];
    in property <[color]> section-colors: [];
    in property <[length]> section-positions: [];
    in property <[length]> section-widths: [];
    // 拍位来源：投影的拍号分子（`bridge::ViewState::time_signature_numerator`），
    // 宿主在 `apply_view` 与小节读数同批写入。标尺拍刻度与车道拍线共用这一份
    // 读数（Wang 2026-11-17：网格以拍为常显基本单位，每拍一刻度 / 一线）。
    in-out property <int> beats-per-bar: 4;
    // 网格密度读数（五版自适应，Wang 2026-11-17 14:37 按 Logic Pro 实测
    // 规格）：宿主 `grid_density` 按当前小节宽与拍号分子算出、与小节读数
    // 同批写入。编号步长／线条单位为 2 的幂（小节）；细分份数 0／2／4。
    // 默认值 = 本组件默认小节宽 128px、4 拍时的 `grid_density` 读数
    // （宿主在真实装配里必然覆盖，默认值只供独立渲染时自洽）。
    in-out property <int> grid-label-stride: 1;
    in-out property <int> grid-line-unit: 1;
    in-out property <bool> grid-show-beat-ticks: true;
    in-out property <bool> grid-show-lane-beats: true;
    in-out property <int> grid-subdiv-per-beat: 4;
    in-out property <length> cycle-start-px: 0px;
    in-out property <length> cycle-end-px: 0px;
    in-out property <bool> show-chord-track: false; // 默认收缩折叠和弦轨，给予主工作区更充裕的高度空间
    in-out property <length> headers-width: 216px; // 支持拖拽调整大小 [min: 170px, max: 300px]
    // ⭐ 轨道行几何 / 内容高 / 横向滚动：全部来自宿主投影（track-ys / track-heights /
    // arrangement-sheet-height / roll-scroll-x），界面⛔ 不自己乘行高、⛔ 不自己算内容高。
    in-out property <[length]> track-ys: [];
    in-out property <[length]> track-heights: [];
    in-out property <length> sheet-height: 0px;
    in-out property <length> scroll-x: 0px;
    /// 当前选中的**剪辑摆放身份**（空串 = 没有选中）—— 块边框高亮与点击回填共用。
    in-out property <string> selected-clip-ulid: "";
    /// 框选选区（line/blank-drag-selection）：命中的片段身份集（宿主拥有，
    /// 单击时 = [主选中]、框选时 = 命中集）；与 `timeline-block-selected` 标志
    /// 是同一份状态的两个投影，界面只读。
    in property <[string]> selected-clip-ulids: [];
    /// 与 `timeline-blocks` 同序同长的选中标志（宿主重算）；长度不一致时
    /// 块高亮回落到只认主选中（投影刚换、标志未跟上的那一帧不许误亮）。
    in property <[bool]> timeline-block-selected: [];
    // ---- 剪辑拖动（T-FIX-234）：拖动期只写这两个草稿属性，松手才提交一次 Op ----
    // clip-drag-ulid = 正在拖的摆放身份（空串 = 没有手势）；preview-dx = 宿主算好的
    // 预览位移（逻辑像素，已吸附）。拖动面上的指针坐标系因此保持稳定（见 clip-…-body）。
    in-out property <string> clip-drag-ulid: "";
    in-out property <float> clip-drag-preview-dx: 0.0;
    /// ⭐ T-FIX-491：按下那一刻冻结的拖动组**是否多成员**（组 = 选区集包含这一按时
    /// 的全部成员，见 `host::snapshot_clip_drag_group`）。为 true ⇒ 组内**每一条**都读
    /// 同一份 `clip-drag-preview-dx` —— 与松手提交的口径一致（`commit_clip_drag`：
    /// 各成员新起点 = 各自现起点 + **同一** delta，⛔ 不逐条吸附）。为 false ⇒ 只有按下
    /// 那条读草稿（单条拖动的旧行为，逐像素不变）。⛔ 界面不自己算组成员。
    in property <bool> clip-drag-is-group: false;
    /// ⭐ T-FIX-491：这一块在拖动期是否读预览位移。
    ///
    /// 两个充分条件（与宿主冻结的组同源）：
    /// ① 它就是按下的那条（`clip-drag-ulid`，单选拖动永远走这条）；
    /// ② 组是多成员 **且** 它在选区标志里 —— 选区标志与 `timeline-blocks` 同序同长
    ///    时才读（长度对不上 ⇒ 回落只认按下那条，⛔ 不让刚换投影的那一帧误动）。
    pure function drag-preview-in-group(ulid: string, index: int) -> bool {
        ulid == root.clip-drag-ulid
            || (root.clip-drag-is-group
                && root.timeline-block-selected.length == root.timeline-blocks.length
                && root.timeline-block-selected[index])
    }
    // ⭐ T-FIX-209：纵向预览 —— 目标行下标（-1 = 与起始行相同，不画线）与目标行顶沿
    // （行空间 y，与 `track-ys` 同帧；落点金线画在该顶沿，与重排插入线同款）。
    in property <int> clip-drag-preview-track-index: -1;
    in property <float> clip-drag-preview-track-y: 0.0;
    private property <bool> clip-dragging: false;
    private property <length> clip-drag-origin-x: 0px;
    private property <length> clip-drag-origin-y: 0px;
    private property <bool> clip-drag-moved: false;

    // ---- 轨道头手势（T-FIX-232：从死文件 `workspace/arrangement_view.slint` 搬进活视图）----
    //
    // 重排手势态（根 → 视图单向；`preview-index` < 0 ⇒ 不画插入线），与死文件同款口径。
    // 宿主（`host::wire_track_reorder`）在拖动中写 `preview-index` / `preview-y`，松手提交
    // 一次 `Op::MoveTrack`；高度手势态仍由宿主持有（`track-height-drag-active` 等在根上，
    // 见 `app.slint`，视图不另建第二份）。
    in property <bool> track-reorder-active: false;
    in property <int> track-reorder-index: -1;
    in property <int> track-reorder-preview-index: -1;
    in property <float> track-reorder-preview-y: 0.0;

    // ---- 自动化泳道（`T-FIX-227`：从死文件 `workspace/arrangement_view.slint` 搬进活视图）----
    //
    // 九个平行数组全部由 `src/automation.rs` 的投影派生、`host::apply_view` 单向注入；
    // 界面只按下标取数（位置与数值都已是逻辑像素 / 文本），⛔ 不做算术。
    // `automation-visible` 是 `Ctrl+Shift+A` / 菜单「视图 → 自动化泳道」的**唯一**开关，
    // 写者仍是宿主（`Action::ToggleAutomation` 与 `toggle-automation` 命令同一条落点）。
    in property <bool> automation-visible: true;
    in property <[string]> automation-lane-target-keys: [];
    in property <[int]> automation-lane-track-indexes: [];
    in property <[string]> automation-lane-labels: [];
    in property <[string]> automation-lane-axis-labels: [];
    in property <[length]> automation-lane-band-ys: [];
    in property <[length]> automation-lane-band-heights: [];
    in property <[bool]> automation-lane-read-enabled: [];
    in property <[string]> automation-lane-badges: [];
    in property <[string]> automation-path-commands: [];
    // 点击泳道 = 增/改一个自动化点（宿主 `wire_automation_lane_click`）。
    // 坐标口径与死文件一致：x 是时间轴像素（tick 0 起，不含 scroll），
    // y 是**行区帧**（首行顶 = 0），宿主按 `band_y − 42` 找泳道。
    callback automation-lane-click(length, length);

    // 框选草稿（界面本地瞬态，⛔ 不进宿主 / 不进撤销栈）：坐标是 **Flickable
    // 内容帧**（与 `track-ys` 同帧）；`marquee-active` = 已越过 4px 阈值。
    property <length> marquee-x0: 0px;
    property <length> marquee-y0: 0px;
    property <length> marquee-x1: 0px;
    property <length> marquee-y1: 0px;
    property <bool> marquee-pressed: false;
    property <bool> marquee-active: false;
    property <bool> marquee-additive: false;

    callback select-track(int);
    // ⭐ T-FIX-232：包头手势的直接选轨（死文件 `workspace/arrangement_view.slint:200,713` 同款）。
    // 0-based 下标 ⇒ 根 `track-select` ⇒ 宿主 `wire_track_select`（写字符串身份 + 1-based
    // 下标 + `apply_view` 精准联动）。⛔ 不走 `select-track`：那条是 1-based 经 `track-selected`
    // 再 `invoke_track_select` 的迂回路，其宿主落点 `wire_aether_actions` 在测试装配里不跑，
    // 包头按下会选不上（实测：`selected-track-index` 变了，`selected-track-id` 仍是 ""）。
    callback track-select(int);
    callback toggle-mute(int);
    callback toggle-solo(int);
    callback toggle-arm(int);
    callback add-track();
    callback audition-chord(string);
    callback ruler-seek(length);
    callback scrub-timeline(length);
    /// 滚轮分流：`shift` = 横向滚动、`alt` = 纵向缩放、`shift+alt` = 横向缩放。
    /// 无修饰由界面 `reject` ⇒ 冒泡给 `Flickable` 做纵向滚动。
    callback arrangement-wheel(length, length, bool, bool);
    callback zoom-h-step(bool);
    callback zoom-v-step(bool);

    function handle-arr-scroll(
        delta-x: length,
        delta-y: length,
        shift: bool,
        alt: bool,
        allow-vertical: bool
    ) -> EventResult {
        if shift || alt {
            root.arrangement-wheel(delta-x, delta-y, shift, alt);
            return accept;
        }
        if delta-x != 0px {
            root.arrangement-wheel(delta-x, delta-y, false, false);
            if allow-vertical && delta-y != 0px {
                arr_tracks_flickable.content-y = Math.max(
                    Math.min(0px, arr_tracks_flickable.height - arr_tracks_flickable.content-height),
                    Math.min(0px, arr_tracks_flickable.content-y + delta-y)
                );
            }
            return accept;
        }
        return reject;
    }
    /// 点击时间线块：只报**摆放身份**（`host::wire_clip_scope` 用它把卷帘作用域切到该片段）。
    in-out property <int> local-menu-track-id: 0;
    in-out property <string> active-local-menu: ""; // "", "tracks", "instrument"

    // T-FIX-166：选中轨道头的右键菜单（Logic Pro 轨道头口径）。
    // `track-context-track-id` 是**菜单作用的轨道身份**（不是下标）；右键未选中轨时
    // 先把该轨选中再开菜单，因此菜单条目全部走已有「作用于选中轨」的真实操作。
    property <int> track-context-track-id: 0;
    property <int> track-context-track-index: 0;
    property <bool> track-context-armed: false;
    // T-FIX-195：轨道头内联改名态。`rename-track-index` 是当前正在编辑的行下标；
    // 草稿由输入框双向绑定，确认/取消后关闭（不落第二份工程状态）。
    property <int> rename-track-index: -1;
    property <string> rename-draft: "";
    // 弹出位置是 **ArrangementViewport 局部坐标**（与卷帘右键菜单同款；菜单 250×278，
    // 贴边时向内收，不得被窗口边缘裁掉）。
    property <length> track-context-menu-x: 0px;
    property <length> track-context-menu-y: 0px;

    function open-track-context-menu(track-id: int, track-index: int, armed: bool, local-x: length, local-y: length) {
        if root.selected-track-id != track-id {
            root.select-track(track-id);
        }
        root.track-context-track-id = track-id;
        root.track-context-track-index = track-index;
        root.track-context-armed = armed;
        root.track-context-menu-x = Math.min(root.width - 250px, Math.max(0px, local-x));
        root.track-context-menu-y = Math.min(root.height - 278px, Math.max(0px, local-y));
        track-context-popup.show();
    }

    // T-FIX-195：右键菜单「重命名」→ 轨道头内联编辑。确认只走既有
    // `track-rename` 回调（宿主 `wire_track_rename` 提交 `Op::SetTrackName`）；
    // 空名不提交，Esc 只关闭编辑器。
    function begin-track-rename() {
        let index = root.track-context-track-index;
        if index >= 0 && index < root.tracks.length {
            root.rename-track-index = index;
            root.rename-draft = root.tracks[index].name;
        }
    }
    function commit-track-rename() {
        let index = root.rename-track-index;
        if index >= 0 && index < root.tracks.length && root.rename-draft != "" {
            root.track-rename(index, root.rename-draft);
        }
        root.rename-track-index = -1;
    }
    function cancel-track-rename() {
        root.rename-track-index = -1;
    }

    function activate-track-context-item(kind: string, action: string) {
        track-context-popup.close();
        if kind == "arm" {
            root.toggle-arm(root.track-context-track-id);
        } else if kind == "rename" {
            root.begin-track-rename();
        } else if kind == "instrument" {
            root.track-instrument-change(root.track-context-track-id, action);
        } else {
            // delete / add-midi / add-audio / add-bus 都走**既有** execute-action 表；
            // 右键按下时已经选中目标轨 ⇒ 删轨 / 建轨的落点就是这条轨。
            root.execute-action(action);
        }
    }

    callback track-pan-change(int, float);
    callback track-volume-change(int, float);
    callback track-rename(int, string);
    callback track-instrument-change(int, string);
    callback mixer-fader-grab(int, length);
    callback mixer-fader-drag(int, length);
    callback mixer-fader-release(int);
    callback mixer-fader-reset(int);
    callback mixer-pan-grab(int, length);
    callback mixer-pan-drag(int, length);
    callback mixer-pan-release(int);
    callback mixer-pan-reset(int);
    callback execute-action(string);
    callback clip-select(string);
    // ⭐ T-FIX-232：活视图的轨道头手势（从死文件 `workspace/arrangement_view.slint` 搬进活视图）。
    // 与 `clip-drag-*` 同一条分工：界面只报**下标 + 指针坐标**，位移换算 / 夹紧 / 提交全在宿主
    // （`host::wire_track_height_drag` / `host::wire_track_reorder`）。
    /// 轨道头底边按下：`(轨道下标, 指针在轨道头坐标系里的 y)`。
    callback track-height-grab(int, length);
    /// 轨道头底边拖动：同一个下标、同一个坐标系里的当前 y（位移由宿主算）。
    callback track-height-drag(int, length);
    /// 轨道头底边收尾：松开 / 指针离开窗口（上游把离开导出成 `PointerEventKind.cancel`）。
    callback track-height-release(int);
    /// 轨道头名称区按下：`(轨道下标, 行空间 y = track-ys[下标] + 头内 y)`。
    callback track-reorder-grab(int, length);
    /// 轨道头名称区拖动：同一个下标、行空间里的当前 y（插入位置由宿主算）。
    callback track-reorder-drag(int, length);
    /// 轨道头名称区收尾：松开 / 指针离开窗口。
    callback track-reorder-release(int);
    /// 包头无障碍动作：`(轨道下标, 方向)`（-1 = 上移一格，+1 = 下移一格）⇒ 直接提交。
    callback track-reorder-step(int, int);
    // ⭐ T-FIX-234：活视图的片段手势（拖动 / 双击 / 空白处新建）。
    callback clip-create();
    callback clip-double-click(string);
    // ⭐ T-FIX-209：拖动回调带行空间 y（与 `track-ys` 同帧）—— 横向仍只用 x 的差值，
    // 纵向落点行由 y 命中。`grab` 返回是否接管。
    callback clip-drag-grab(string, length, length) -> bool;
    callback clip-drag-move(string, length, length);
    callback clip-drag-release(string, length, length);
    callback clip-drag-cancel();
    /// 框选收尾：矩形四边（x = **时间轴像素帧**，与 `blk.start_px` 同帧；
    /// y = Flickable 内容帧，与 `track-ys` 同帧；未归一化）+ 加选标志。
    /// 界面只做坐标帧换算，命中判定在宿主。
    callback clip-marquee-select(length, length, length, length, bool);

    background: Theme.bg-canvas;
    clip: true;
    accessible-role: main;
    accessible-id: "workspace-arrangement-canvas";
    accessible-label: @tr("工作区编曲画布");

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // TOP HEADER ROW: Track header top box + Ruler + Chord Progression Track (Collapsible)
        Rectangle {
            height: root.show-chord-track ? 54px : 26px;
            // 顶部带底色（Wang 2026-11-16：学 Logic，标尺带比轨道背景浅一档）：
            // 取令牌阶梯里紧邻车道背景 Theme.bg-canvas 的上一档 Theme.bg-panel；
            // 底边显式 1px 分隔线，理顺工具行/标尺与轨道区之间的横线。
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                spacing: 0px;

                // Left top box (if headers on left)
                if !Theme.track-headers-on-right : Rectangle {
                    width: root.headers-width;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        alignment: space-between;

                        // 工具行 (负责人 2026-11-16 四条之 1 / 2): 旧标题
                        // 「轨道控制头 (TRACKS)」只说明区域名、不承载信息, 已删;
                        // 「轨道菜单」置整行最前 (下拉浮层锚点 x=8px 与之对齐),
                        // 其后依次 + 轨道、和弦展开/收起。三钮行为与回调不变。
                        HorizontalLayout {
                            alignment: space-between;
                            // 编曲区本地视图菜单开关（Wang 2026-11-16 令：置于轨道头工具行最前）。
                            // 用可渲染的中文标签，⛔ 不再依赖不渲染的下拉箭头字形；详见细节实测 §5.9。
                            Rectangle {
                                // i18n 合入后（d10ab38）：文案走 @tr，长度随语种变化（9 语词表）。
                                // 因此宽度改为「随 preferred-width 自适应，下限 72px / 上限 96px」，
                                // 超长语种由 elide 兜底，避免把同行右侧的"和弦展开/＋轨道"挤出去。
                                width: Math.min(96px, Math.max(72px, menu-label.preferred-width + 10px));
                                height: 18px;
                                background: root.active-local-menu == "tracks" ? Theme.accent : (arr-menu-touch.has-hover ? Tokens.bg-panel-alt : Tokens.bg-panel-alt);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: root.active-local-menu == "tracks" ? Theme.accent : Tokens.skin-active;
                                menu-label := Text {
                                    text: @tr("轨道菜单");
                                    width: Math.min(menu-label.preferred-width, parent.width - 6px);
                                    overflow: elide;
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: root.active-local-menu == "tracks" ? Tokens.skin-inset : Tokens.skin-text-body;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                arr-menu-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.active-local-menu = root.active-local-menu == "tracks" ? "" : "tracks";
                                    }
                                    scroll-event(event) => {
                                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                    }
                                }
                                TooltipBubble {
                                    text: @tr("编曲轨道与视图本地菜单");
                                    is-visible: arr-menu-touch.has-hover;
                                    tip-offset-y: 22px;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                // Chord Track fold toggle
                                Rectangle {
                                    background: root.show-chord-track ? Theme.accent.with-alpha(0.25) : (chord-toggle-touch.has-hover ? Tokens.skin-hover : transparent);
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: root.show-chord-track ? Theme.accent : Tokens.skin-hairline;
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: root.show-chord-track ? @tr("和弦收起") : @tr("和弦展开");
                                            font-family: Tokens.font-ui;
                                            font-size: 9.5px;
                                            font-weight: 600;
                                            color: root.show-chord-track ? Theme.accent : Tokens.skin-text-body;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-toggle-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.show-chord-track = !root.show-chord-track; }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: root.show-chord-track ? @tr("折叠和弦音轨") : @tr("展开和弦音轨");
                                        is-visible: chord-toggle-touch.has-hover;
                                        tip-offset-y: 22px;
                                    }
                                }
                                Rectangle {
                                    background: add-track-top-touch.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.20);
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: Theme.accent.with-alpha(0.6);
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: @tr("+ 轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-top-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("添加新音轨");
                                        is-visible: add-track-top-touch.has-hover;
                                        tip-offset-y: 22px;
                                    }
                                }

                            }
                        }

                        if root.show-chord-track : Rectangle {
                            height: 22px;
                            background: Tokens.bg-lane2;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Tokens.bg-panel;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: space-between;
                                Text {
                                    text: @tr("全局和弦轨");
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: Tokens.skin-text-body;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: @tr("智能和声声学");
                                    font-family: Tokens.font-ui;
                                    font-size: 9px;
                                    color: Tokens.skin-text-dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Splitter Divider between Left Track Header top box and Timeline Ruler
                if !Theme.track-headers-on-right : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-header-top-left.has-hover ? Theme.accent : Tokens.divider-row;
                    }
                    split-header-top-left := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                        }
                        double-clicked => {
                            root.headers-width = 240px;
                        }
                        scroll-event(event) => {
                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                        }
                    }
                }

                // Center Timeline Ruler + Chord Progression Blocks
                Rectangle {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        spacing: 0px;

                        // T-FIX-152：曲式段落带（18px）——按小节范围绘制，名字可读、色标来自工程。
                        Rectangle {
                            // 无段落数据的工程高度为 0 ⇒ 既有布局/基准帧一位不动。
                            height: root.section-names.length > 0 ? 18px : 0px;
                            clip: true;
                            background: Tokens.bg-shell;
                            for section-name[section-index] in root.section-names : Rectangle {
                                x: (section-index < root.section-positions.length ? root.section-positions[section-index] : 0px) - root.scroll-x;
                                width: section-index < root.section-widths.length ? root.section-widths[section-index] : 0px;
                                height: parent.height;
                                background: section-index < root.section-colors.length ? root.section-colors[section-index] : Theme.accent;
                                border-width: 1px;
                                border-color: Tokens.divider-row;
                                Text {
                                    x: 6px;
                                    width: parent.width - 12px;
                                    height: parent.height;
                                    text: section-name;
                                    font-size: 11px;
                                    color: Tokens.ink-1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // Ruler (24px) - Spans across 24 bars (High contrast WCAG AA labels)
                        // 标尺带 (负责人 2026-11-16 四条之 4): 底比编曲区浅一档;
                        // 小节号走 `Tokens.ruler-ink`; 底部刻度与下方网格竖线
                        // 同 x 同源 (bar-positions / bar-width-px / scroll-x)。
                        // 标尺带底自 2026-11-17 合入起走质感三元 (Wang 裁决
                        // 甲, 19:58): 拟物支走令牌 `Tokens.ruler-brush`,
                        // 扁平支用十一版定值 (见下方 background 行注释)。
                        Rectangle {
                            height: 24px;
                            // 标尺带底 (裁决甲): 拟物支 = main 令牌形态
                            // `Tokens.ruler-brush`; 扁平支 = 十一版定值
                            // #1d2733 (Wang 2026-11-17 三版口径: 与车道底
                            // 的相对亮度比 1.30:1, 旧 `Theme.bg-panel`
                            // #0e1118 只有 1.04:1, 带与车道几乎同色;
                            // 轨道头底色同值, 整条头部带同面)。边框色
                            // 同理: main 形态无边框色 (透明), 扁平支
                            // 保留十一版 Tokens.skin-hover。
                            background: Tokens.texture-physical ? Tokens.ruler-brush : Tokens.bg-shell;
                            border-color: Tokens.texture-physical ? transparent : Tokens.skin-hover;
                            clip: true;

                            // [Q6] 标尺格数与间距来自投影（`host::apply_view` 的
                            // `bar-count` / `bar-width-px`），与下方片段块共用同一个
                            // 水平刻度（`blk.start_px = tick / ticks_per_pixel`）。
                            for i in root.bar-count : Text {
                                // 编号步长（五版自适应）：只在步长整数倍的
                                // 小节上标号（步长由宿主按小节宽算，间距
                                // >= 96px；Logic 图二极端缩小时每 16 小节
                                // 一个编号）。
                                // 净空区（六版，Wang 15:06 终判「刻度上
                                // 数字有点遮盖」）：编号只占标尺带上部
                                // 9px 净空区（字形在区内垂直居中），下方
                                // 刻度行仍是带下半 12px，编号区底与刻度
                                // 行顶之间留 3px（24 = 9 + 3 + 12），
                                // 任何刻度不得进入编号区。几何常量由
                                // arrangement_grid_density 判据 ⑥ 钉住。
                                visible: (root.bar-start-index + i).mod(max(1, root.grid-label-stride)) == 0;
                                x: ((root.bar-start-index + i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + i] : (root.bar-start-index + i) * root.bar-width-px) - root.scroll-x;
                                y: 0px;
                                width: root.bar-width-px;
                                height: 9px;
                                horizontal-alignment: left;
                                text: "" + (root.bar-start-index + i + 1);
                                font-family: Tokens.font-mono;
                                font-size: 9px;
                                font-weight: 600;
                                color: Tokens.ruler-ink;
                                vertical-alignment: center;
                            }

                            // 刻度三档 (小节 / 拍 / 拍内细分), 2026-11-18 起
                            // **两套主题共用**这一块: 拟物先前只有一条 5px 的小节
                            // 刻度 (刻蚀感), 扁平有三档字面色阶, 用户要求拟物也按
                            // 扁平那样加拍内刻度 ⇒ 合并成一套几何 (1 : 1/2 : 1/4,
                            // 12 / 6 / 3 px, 下对齐), 色值改走 `Tokens.ruler-tick-*`
                            // (拟物各降一档, 见 tokens.slint 该组注释)。
                            // 可见性仍走宿主密度读数 (`grid_density`): 小节刻度只在
                            // 线条单位整数倍的小节上画; 拍刻度须每拍 >= 8px; 细分
                            // 份数 (每拍 4/2/0) 由宿主按细分距 >= 8px 逐档退。

                            // 小节刻度 + 拍刻度 + 细分刻度（五版，Wang
                            // 2026-11-17 14:37 按 Logic Pro 实测规格定）：
                            // Logic 图一实测——刻度全 1px 宽，长度分级：
                            // 小节刻度满刻度行高、拍刻度约半行（下对齐）。
                            // 本带高 24px，刻度行取带下半 12px：小节 12px、
                            // 拍 6px、细分 3px（1 : 1/2 : 1/4，下对齐）。
                            // 亮度门槛（扁平套，对标尺带底 #1d2733 实算）：
                            // 小节 4.64:1（≥4.5）；拍 3.67:1（≥3）；
                            // 细分 3.32:1（≥3 硬下限）。拟物套同门槛、各降一档。
                            // 小节编号 Tokens.ruler-ink 对标尺带 10.17:1。
                            // 可见性走宿主密度读数（`grid_density`）：小节
                            // 刻度只在线条单位整数倍的小节上画；拍刻度须
                            // 每拍 >= 8px；细分份数（每拍 4/2/0）由宿主
                            // 按细分距 >= 8px 逐档退。
                            for i in root.bar-count : Rectangle {
                                x: ((root.bar-start-index + i) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + i] : (root.bar-start-index + i) * root.bar-width-px) - root.scroll-x;
                                y: 0px;
                                width: root.bar-width-px;
                                height: parent.height;
                                background: transparent;

                                Rectangle {
                                    visible: (root.bar-start-index + i).mod(max(1, root.grid-line-unit)) == 0;
                                    x: 0px;
                                    y: parent.height - 12px;
                                    width: 1px;
                                    height: 12px;
                                    background: Tokens.ruler-tick-bar;
                                }

                                for beat in root.beats-per-bar : Rectangle {
                                    visible: beat > 0 && root.grid-show-beat-ticks;
                                    x: beat * (root.bar-width-px / max(1, root.beats-per-bar));
                                    y: parent.height - 6px;
                                    width: 1px;
                                    height: 6px;
                                    background: Tokens.ruler-tick-beat;
                                }

                                for beat in root.beats-per-bar : Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: root.bar-width-px;
                                    height: parent.height;
                                    background: transparent;

                                    for sub in root.grid-subdiv-per-beat : Rectangle {
                                        visible: sub > 0;
                                        x: beat * (root.bar-width-px / max(1, root.beats-per-bar)) + sub * (root.bar-width-px / max(1, root.beats-per-bar) / max(1, root.grid-subdiv-per-beat));
                                        y: parent.height - 3px;
                                        width: 1px;
                                        height: 3px;
                                        background: Tokens.ruler-tick-sub;
                                    }
                                }
                            }

                            // 循环指示带：区间来自视图态（`cycle-start/end-px`，由根属性
                            // `cycle-start/end-ticks` 换算），⛔ 不再是写死的 150px/220px。
                            // ⭐ T-FIX-569：加 Slint id 供审阅定位；无真实区间时根属性恒 0 ⇒
                            //    两端 px 相等 ⇒ 此节点不入树。开关 (is-looping) 与区间同源：
                            //    开关关或区间空都不画。（不挂 accessible-id：不在语义控件树注册）
                            if root.is-looping && root.cycle-end-px > root.cycle-start-px : cycle-range-band := Rectangle {
                                x: root.cycle-start-px - root.scroll-x;
                                y: 0px;
                                width: root.cycle-end-px - root.cycle-start-px;
                                height: 3px;
                                background: Theme.accent;
                                border-radius: 1.5px;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        root.ruler-seek(self.mouse-x);
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        root.ruler-seek(self.mouse-x);
                                    }
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                }
                            }

                            // ⭐ 可见缩放控件：横向 / 纵向各一对（与滚轮、快捷键同一条宿主入口
                            // `zoom-h-step` / `zoom-v-step`）。滚轮 / 快捷键仍可用。
                            // ⭐ 这组控件是**浮在标尺带上**的：编号与刻度先画、它后画，
                            // 所以底色一旦半透明，下面的小节编号（如 `4`）和刻度线就会
                            // 从胶囊里透出来，看着像坏图（1460×900 实机实测）。
                            // ⇒ 底色改**实底** `bg-void`（与标尺带 `bg-shell` 区分开），
                            //    并 `clip: true`，让悬停胶囊不越出圆角。
                            // ⇒ 上沿贴住带顶（`y: 0px`、高 22px）：编号区占带上部 12px，
                            //    浮层若从 2px 起，编号顶端仍会有 2px 从上沿露出。
                            Rectangle {
                                x: parent.width - 120px;
                                y: 0px;
                                width: 114px;
                                height: 22px;
                                clip: true;
                                background: Tokens.bg-void;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Tokens.skin-hairline;

                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    spacing: 2px;
                                    alignment: space-between;

                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: hz-out-touch.has-hover ? Tokens.skin-chip : transparent;
                                        Text { text: "H−"; font-family: Tokens.font-mono; font-size: 9.5px; color: Tokens.skin-text-body; horizontal-alignment: center; vertical-alignment: center; }
                                        hz-out-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-h-step(false); } }
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: hz-in-touch.has-hover ? Tokens.skin-chip : transparent;
                                        Text { text: "H+"; font-family: Tokens.font-mono; font-size: 9.5px; color: Tokens.skin-text-body; horizontal-alignment: center; vertical-alignment: center; }
                                        hz-in-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-h-step(true); } }
                                    }
                                    // 横向缩放（H−/H+）与纵向缩放（V−/V+）是两组不同的手势：
                                    // 四个 25×16 的按钮以 2px 间距排成一串时读起来像"四档同一种缩放"，
                                    // 加一条 1px 竖分隔把两组分开（必须是**兄弟**节点，别落进某个按钮里）。
                                    Rectangle {
                                        width: 1px;
                                        height: 16px;
                                        background: Tokens.line;
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: vt-out-touch.has-hover ? Tokens.skin-chip : transparent;
                                        Text { text: "V−"; font-family: Tokens.font-mono; font-size: 9.5px; color: Tokens.skin-text-body; horizontal-alignment: center; vertical-alignment: center; }
                                        vt-out-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-v-step(false); } }
                                    }
                                    Rectangle {
                                        width: 25px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: vt-in-touch.has-hover ? Tokens.skin-chip : transparent;
                                        Text { text: "V+"; font-family: Tokens.font-mono; font-size: 9.5px; color: Tokens.skin-text-body; horizontal-alignment: center; vertical-alignment: center; }
                                        vt-in-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.zoom-v-step(true); } }
                                    }
                                }
                            }
                        }

                        // Chord Progression Track (30px) - Harmonized with mineral color order (Collapsible)
                        if root.show-chord-track : Rectangle {
                            height: 30px;
                            background: Tokens.skin-inset;

                            HorizontalLayout {
                                padding: 3px;
                                spacing: 4px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    // 九版（Wang 16:43）：和弦块底改和弦色纯色本体
                                    // Theme.track-synth（八版合成等效实色 = 和弦色混黑，废）。
                                    // hover 按同色明度微调（±0.04，方向取文字仍
                                    // >= 4.5 的一侧，本块为 -0.04）；边框为同色更深
                                    // 一档实色（明度 -0.10 / hover -0.05），不用
                                    // alpha。文字按底色选近白/纯白/纯黑（>= 4.5）。
                                    // 五块同规则，数值各自按其和弦色算。
                                    background: chord-1-touch.has-hover ? Theme.track-synth.brighter(0.18) : Theme.track-synth;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-1-touch.has-hover ? Theme.track-synth.brighter(0.08) : Theme.track-synth.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Cm9 (i9)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-1-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Cm9"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Cm9 (主和弦) 配置");
                                        is-visible: chord-1-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-2-touch.has-hover ? Theme.track-pad.brighter(0.18) : Theme.track-pad;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-2-touch.has-hover ? Theme.track-pad.brighter(0.08) : Theme.track-pad.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "AbMaj7 (VI7)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-2-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("AbMaj7"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 AbMaj7 (下中音和弦) 配置");
                                        is-visible: chord-2-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-3-touch.has-hover ? Theme.track-vocal.brighter(0.18) : Theme.track-vocal;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-3-touch.has-hover ? Theme.track-vocal.brighter(0.08) : Theme.track-vocal.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Fm11 (iv11)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-3-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Fm11"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Fm11 (下属和弦) 配置");
                                        is-visible: chord-3-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-4-touch.has-hover ? Theme.track-drum.brighter(0.18) : Theme.track-drum;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-4-touch.has-hover ? Theme.track-drum.brighter(0.08) : Theme.track-drum.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "G7#9 (V7#9)";
                                            font-family: Tokens.font-mono;
                                            font-size: 10px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 9px;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-4-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("G7#9"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 G7#9 (属和弦变化音) 配置");
                                        is-visible: chord-4-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    background: chord-5-touch.has-hover ? Theme.track-synth.brighter(0.18) : Theme.track-synth;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: chord-5-touch.has-hover ? Theme.track-synth.brighter(0.08) : Theme.track-synth.darker(0.12);

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: space-between;
                                        Text {
                                            text: "Cm11 (i11)";
                                            font-family: Tokens.font-mono;
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: @tr("▶ 试听");
                                            font-family: Tokens.font-ui;
                                            font-size: 8px;
                                            // 九版：底改和弦色纯色 Theme.track-synth，文字随块统一
                                            // 用 Tokens.skin-text-strong（对纯色底实算 4.60:1，>= 4.5）。
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                    chord-5-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.audition-chord("Cm11"); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("试听 Cm11 (扩展主和弦) 配置");
                                        is-visible: chord-5-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }
                    }
                }

                // Splitter Divider between Timeline Ruler and Right Track Header top box
                if Theme.track-headers-on-right : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-header-top-right.has-hover ? Theme.accent : Tokens.divider-row;
                    }
                    split-header-top-right := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                        }
                        double-clicked => {
                            root.headers-width = 240px;
                        }
                        scroll-event(event) => {
                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                        }
                    }
                }

                // Right top box (if headers on right)
                if Theme.track-headers-on-right : Rectangle {
                    width: root.headers-width;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        alignment: space-between;

                        // 右置变体同左置口径 (负责人 2026-11-16 四条之 1):
                        // 旧标题「轨道控制头 (右置)」只说明区域名, 已删。
                        HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                background: add-track-right-touch.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.18);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.accent;
                                height: 18px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: @tr("+ 轨道");
                                        font-family: Tokens.font-ui;
                                        font-size: 9px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                                add-track-right-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.add-track(); }
                                    scroll-event(event) => {
                                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, false)
                                    }
                                }
                                TooltipBubble {
                                    text: @tr("添加新音轨");
                                    is-visible: add-track-right-touch.has-hover;
                                    tip-offset-y: 22px;
                                }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            background: Theme.accent.with-alpha(0.12);
                            border-radius: 3px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: @tr("右置轨道头模式 (镜像工作区)");
                                    font-family: Tokens.font-ui;
                                    font-size: 8px;
                                    color: Tokens.skin-text-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 工具行 / 标尺与轨道区之间的横线 (负责人 2026-11-16 四条之 3):
            // 一条 1px 线跨整个顶行 (工具盒 + 标尺同色同高), 走令牌层
            // `Tokens.divider-row`, ⛔ 不再靠顶行 Rectangle 的 border 兼任。
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Tokens.divider-row;
            }

            // 刻蚀高光 (只拟物套有值, 扁平套 alpha=0): 主线下方 1px。
            Rectangle {
                x: 0px;
                y: parent.height;
                width: parent.width;
                height: 1px;
                background: Tokens.divider-row-highlight;
            }
        }

        // TRACK LANES CONTAINER
        arr_lanes_container := Rectangle {
            vertical-stretch: 1;
            clip: true;
            // 车道底（十一版，Wang 2026-11-17 18:51 + 18:53 亲定）：
            // 十版把车道底抬到中性灰（相对亮度 0.0273），与全应用的
            // 深蓝色系（轨道头 #1d2733、标尺带）差异太大 ⇒ 改回九版
            // #090b10 的色相/饱和（HSV 222.9° / 0.4375）只抬明度：
            // 定值 #1d2333，相对亮度实算 0.0170（目标带 0.014–0.020，
            // 仍低于十版中性灰）。只落本容器（行与行下空置区同底），
            // ⛔ 不动 Theme.bg-canvas 本体（窗口底与其它面共用）、
            // 不动标尺带 Theme.bg-panel。
            // 合入裁决甲 (Wang 2026-11-17 19:58) 补: 本容器在 main
            // 侧原本无底色 (透出 root 的 Theme.bg-canvas), 十一版
            // 字面底只许落扁平支 ⇒ 写成质感三元, 拟物支 transparent
            // 逐像素复现 main 形态。
            background: Tokens.texture-physical ? transparent : Tokens.bg-lane;

            // ⭐ 轨道一多（16 轨 × 56px = 896px）时，固定高度的 VerticalLayout 会把
            // 内容撑出工作区、把下方钢琴卷帘/混音台顶出窗口。这里改成纵向 Flickable：
            // 内容高 = 投影的 `sheet-height`，行 y / 行高 = 投影的 `track-ys` /
            // `track-heights` ⇒ 轨道再多也只在自己的窗口里滚动，⛔ 不挤占下坞。
            arr_tracks_flickable := Flickable {
                width: parent.width;
                height: parent.height;
                accessible-role: list;
                accessible-id: "arr-lanes-flickable";
                content-width: self.width;
                // ⚠ 不再写 `max(self.height, …)`：Flickable 的高度由父槽位决定，
                // 内容高只由轨道投影决定。两者分开，`content-height > height` 才能在
                // 轨道装不下时成立 —— 滚轮与滚动条都靠这个判据。
                content-height: root.sheet-height + 42px + 46px;
                // ⭐ 框选优先于拖拽滚动（Wang 2026-11-18 口径）：空白车道拖拽 =
                // 橡皮筋框选，⛔ 不做拖拽滚动；滚动只走滚轮 / Shift+滚轮 / 滚动条
                //（滚轮与滚动条不依赖本面的拖拽手势：前者冒泡给 Flickable 自身
                // 的 PointerScrolled，后者直接写 `content-y`）。
                // `interactive: true` 时内容一旦高出视口（演示工程 6 轨内容
                // 424px；b5e1b00d 加的 Songmap A/B 条把视口从 436px 压到
                // 406px ⇒ 刚好溢出），Flickable 会把纵向拖拽认领为滚动、给车道
                // TouchArea 发 `cancel` ⇒ 框选永远到不了宿主（ISS-MWTNA3DX）。
                // 关掉拖拽手势后滚轮与滚动条照常工作（`arrangement_vertical_scroll`
                // 4/4），框选在任何轨道数下都不再被抢。
                interactive: false;
                // ─── 轨道区背景网格（铺满整块车道区）──────────────────
                // 2026-11-18 口径（负责人）：
                //   ① **轨道头列是纯色面**，不许出现任何格线（横向/纵向都不许）；
                //   ② 水平行线铺满整个车道编辑区——空轨道、轨道列表以下的
                //      空置区、滚动出来的区域都要有线，线距沿用最后一轨的行高；
                //   ③ 网格是背景，竖线压在水平行线之上；两套主题同一套 mark。
                // 层级自下而上 = 底色 → 轨道头纯色列 → 行线 → 小节/拍/细分 → 行选中态。
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: max(parent.height, root.sheet-height + 88px);
                    background: Tokens.bg-lane;

                    // ① 轨道头列：纯色背景，不叠网格
                    Rectangle {
                        x: Theme.track-headers-on-right ? parent.width - root.headers-width : 0px;
                        y: 0px;
                        width: root.headers-width;
                        height: parent.height;
                        background: Tokens.bg-panel;
                    }

                    // ② 车道容器：所有格线只在这一块里画，x 从车道原点起算
                    arr_lane_bg := Rectangle {
                        x: Theme.track-headers-on-right ? 0px : root.headers-width;
                        y: 0px;
                        width: parent.width - root.headers-width;
                        height: parent.height;
                        background: Tokens.bg-lane;
                        clip: true;

                        // 行线续画到整区所需的几何（末尾一行以下的空置区同样有线）
                        property <length> lane-bottom: root.track-heights.length > 0
                            ? root.track-ys[root.track-heights.length - 1] + root.track-heights[root.track-heights.length - 1]
                            : 0px;
                        property <length> ghost-pitch: root.track-heights.length > 0
                            ? max(24px, root.track-heights[root.track-heights.length - 1])
                            : 32px;
                        property <int> ghost-rows: Math.max(0, Math.floor((parent.height - self.lane-bottom) / self.ghost-pitch));

                        // 行底分隔线（已有轨道）
                        for _row[idx] in root.tracks : Rectangle {
                            x: 0px;
                            y: root.track-ys[idx] + root.track-heights[idx] - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Tokens.grid-row;
                        }

                        // 行底分隔线（末轨以下续画，铺满整块编辑区）
                        for _ghost in arr_lane_bg.ghost-rows : Rectangle {
                            x: 0px;
                            y: arr_lane_bg.lane-bottom + _ghost * arr_lane_bg.ghost-pitch + arr_lane_bg.ghost-pitch - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Tokens.grid-row;
                        }

                        // 小节线
                        for _bar in root.bar-count : Rectangle {
                            visible: (root.bar-start-index + _bar).mod(max(1, root.grid-line-unit)) == 0;
                            x: ((root.bar-start-index + _bar) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + _bar] : (root.bar-start-index + _bar) * root.bar-width-px) - root.scroll-x;
                            y: 0px;
                            width: 1px;
                            height: parent.height;
                            background: Tokens.grid-bar;
                        }

                        // 拍线 + 拍内细分（每拍 >= 24px 画拍线；>= 48px 再画 1/4 细分）
                        for _beat_bar in root.bar-count : Rectangle {
                            x: ((root.bar-start-index + _beat_bar) < root.bar-positions.length ? root.bar-positions[root.bar-start-index + _beat_bar] : (root.bar-start-index + _beat_bar) * root.bar-width-px) - root.scroll-x;
                            y: 0px;
                            width: root.bar-width-px;
                            height: parent.height;
                            background: transparent;

                            for beat in root.beats-per-bar : Rectangle {
                                visible: beat > 0 && root.grid-show-lane-beats;
                                x: beat * (root.bar-width-px / max(1, root.beats-per-bar));
                                y: 0px;
                                width: 1px;
                                height: parent.height;
                                background: Tokens.grid-beat;

                                for sub in [1, 2, 3] : Rectangle {
                                    visible: (root.bar-width-px / max(1, root.beats-per-bar)) >= 48px;
                                    x: sub * ((root.bar-width-px / max(1, root.beats-per-bar)) / 4);
                                    y: 0px;
                                    width: 1px;
                                    height: parent.height;
                                    background: Tokens.grid-sub;
                                }
                            }
                        }

                        // 行选中态（半透明提亮，压在网格上、片段下）
                        for _sel[idx] in root.tracks : Rectangle {
                            visible: _sel.id == root.selected-track-id;
                            x: 0px;
                            y: root.track-ys[idx];
                            width: parent.width;
                            height: root.track-heights[idx];
                            background: Theme.accent.with-alpha(0.06);
                        }
                    }
                }
                // 背景滚轮兜底（含顶部 42px 留白与末尾空白区），保证双指横向/纵向滑动在整块区域均响应
                TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: arr_tracks_flickable.content-height;
                    scroll-event(event) => {
                        root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                    }
                }

                for trk[idx] in root.tracks : Rectangle {
                    y: root.track-ys[idx];
                    height: root.track-heights[idx];
                    width: parent.width;
                    // 选中呈现（裁决甲，Wang 2026-11-17 19:58）：质感三元。
                    // 扁平支 = 十一版形态（八版 Logic 式：七版纯白边框
                    // 作废，选中只由提亮承载——车道底改回蓝调 #1d2333
                    // 后选中行底按相对亮度比 1.80 重算为 #273146，相对
                    // 亮度 0.0307；行边框 Tokens.skin-hover 0px 与未选中行同款；
                    // 轨道色与 accent 双脱钩，色条仍保留轨道色）。
                    // 拟物支 = main 形态（选中行 accent α0.08 底 +
                    // α0.70 边 1.5px，未选中 Tokens.skin-hover 淡框）。
                    // 行底与选中态统一由轨道区背景层绘制（网格在上面、片段再压上来）；
                    // 行本体保持透明，避免把整幅网格挡住。
                    background: transparent;
                    border-width: 0px;
                    HorizontalLayout {
                        spacing: 0px;

                        // Left Track Header (if not headers on right)
                        if !Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            // ⭐ T-FIX-232：稳定的自动化元素 ID（`UI-TEST-001` 语义寻址；死文件同款）。
                            // 无障碍默认动作 = 选中这条轨；增 / 减 = 下移 / 上移一格（落点
                            // `host::wire_track_reorder` 的 `track-reorder-step`，直接提交）。
                            accessible-role: list-item;
                            accessible-id: "track-" + idx + "-header";
                            accessible-label: @tr("轨道 {}", trk.name);
                            accessible-item-index: idx;
                            accessible-item-count: root.tracks.length;
                            accessible-item-selectable: true;
                            accessible-item-selected: trk.id == root.selected-track-id;
                            accessible-action-default => { root.track-select(idx); }
                            accessible-action-increment => { root.track-reorder-step(idx, 1); }
                            accessible-action-decrement => { root.track-reorder-step(idx, -1); }
                            // `[UI-A11Y-003]` §7.3：展开动作 = 徽章 `[v]` 的点击落点（选中这条轨并切换
                            // 乐器本地菜单）。徽章 `TouchArea` 自己没有角色，而 `accessible-action-*`
                            // 只能挂在有角色的元素上 ⇒ 落点挂在包头元素块里（T-FIX-335；静音 / 独奏 /
                            // 录音准备三处各有自己的 `button` 角色块，见下）。
                            accessible-action-expand => {
                                root.select-track(trk.id);
                                root.local-menu-track-id = trk.id;
                                root.active-local-menu = root.active-local-menu == "instrument" ? "" : "instrument";
                            }
                            // 轨道头选中呈现 (裁决甲, Wang 2026-11-17 19:58):
                            // 质感三元。拟物支 = main 形态 (选中 accent
                            // α0.10 底 + α0.80 边, 未选中 track-head-brush);
                            // 扁平支 = 十一版定值 (选中头底 #293645——八版
                            // Logic 式: 未选中头底 #1d2733 按亮度比 1.80
                            // 线性提亮; 边框恒 Theme.border-subtle 与未选中
                            // 行同款, 七版 #16232b 与纯白边框同废)。
                            background: Tokens.texture-physical ? (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.10) : Tokens.track-head-brush) : (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.12) : Tokens.bg-panel);
                            border-color: Tokens.texture-physical ? (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.80) : Theme.border-subtle) : Theme.border-subtle;

                            // Left color strip (illuminated on focus)
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: trk.id == root.selected-track-id ? 5px : 3.5px;
                                height: parent.height;
                                background: trk.color;
                            }

                            // ⭐ T-FIX-232：轨道头手势（从死文件 `workspace/arrangement_view.slint`
                            // 搬进活视图；手势分区与死文件逐字一致）。名称区按下 ⇒ 重排（报行空间 y）；
                            // 底边 6px 按下 ⇒ 高度。按下即选中（一次点击 = 选中这条轨，⛔ 不提交工程）。
                            // ⚠ 按下时的选中会走 `apply_view` 重注模型、重建包头项 ⇒ 按下那一刻的指针
                            // 抓取随之失效，`move` / `up` 落到新建的 TouchArea（见下面两条路由注释）。
                            // 按钮是后置子元素，命中测试先拿到点击，拖拽面只接管剩下的区域。
                            // 零视觉：`TouchArea` 不画任何东西 ⇒ 默认帧一位不变。
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right
                                        && event.kind == PointerEventKind.down {
                                        root.open-track-context-menu(
                                            trk.id,
                                            idx,
                                            trk.armed,
                                            (Theme.track-headers-on-right ? root.width - root.headers-width : 0px) + self.mouse-x,
                                            arr_lanes_container.y + root.track-ys[idx] + arr_tracks_flickable.content-y + self.mouse-y,
                                        );
                                    } else if event.kind == PointerEventKind.down {
                                        root.track-select(idx);
                                        if self.mouse-y < self.height - 6px {
                                            root.track-reorder-grab(idx, root.track-ys[idx] + self.mouse-y);
                                        } else {
                                            root.track-height-grab(idx, self.mouse-y);
                                        }
                                    } else if event.kind == PointerEventKind.move {
                                        if root.track-reorder-active {
                                            // 重排进行中按**已抓取下标**路由（见死文件注释：按下时的选中会
                                            // 重建包头项，`move` 可能落在另一行的 TouchArea；行空间 y 仍由
                                            // 接收头的自身几何算，在哪一行收到都是同一个行空间点）。
                                            root.track-reorder-drag(root.track-reorder-index, root.track-ys[idx] + self.mouse-y);
                                        } else {
                                            // 悬浮的 `move` 不会误改行高：宿主以 `track-height-drag-active`
                                            // 为唯一读数，孤立的 move 直接 return（见 `host.rs` 注释）。
                                            root.track-height-drag(idx, self.mouse-y);
                                        }
                                    } else {
                                        // `up` 与 `cancel` 都是收尾（拖到窗口外松手也走这条路）。
                                        if root.track-reorder-active {
                                            root.track-reorder-release(root.track-reorder-index);
                                        } else {
                                            root.track-height-release(idx);
                                        }
                                    }
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 4px;
                                    if root.rename-track-index == idx : ImeAwareTextInput {
                                        horizontal-stretch: 1;
                                        text <=> root.rename-draft;
                                        single-line: true;
                                        font-family: Tokens.font-ui;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Tokens.skin-text-strong;
                                        vertical-alignment: center;
                                        accessible-role: text-input;
                                        accessible-id: "arrangement-track-rename-input";
                                        accessible-label: @tr("轨道重命名");
                                        accessible-value: root.rename-draft;
                                        accessible-read-only: false;
                                        init => { self.focus(); }
                                        accepted => { root.commit-track-rename(); }
                                        key-pressed(event) => {
                                            if event.text == Key.Escape {
                                                root.cancel-track-rename();
                                                accept
                                            } else {
                                                reject
                                            }
                                        }
                                    }
                                    if root.rename-track-index != idx : Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: trk.id == root.selected-track-id ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        background: badge-left-touch.has-hover ? Tokens.line : Tokens.skin-scrim;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: badge-left-touch.has-hover ? Theme.accent : Tokens.skin-hairline;
                                        // 108px 在 1460 宽窗口下仍然差几个像素：`Yeban PolySynth [v]`
                                        // 实测被省成「Yeban PolySyn…」，名字尾巴和 `[v]` 换音色入口都读不清。
                                        // 抬到 140px，长音色名能整段显示（轨道名是 stretch + elide，不会溢出）。
                                        max-width: 140px;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            // 「Yeban PolySynth [v]」在 9px 等宽下约 100px，旧的 82px 上限把
                                            // 尾巴 `[v]` 一起省成「Yeban PolySy…」，看不见"可换音色"的入口。
                                            // 拆成两段：名字用 elide 自适应，`[v]` 单独且永远完整。
                                            Text {
                                                text: trk.insert1 != "" ? trk.insert1 : trk.kind;
                                                horizontal-stretch: 1;
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-left-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                                font-weight: 400;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: " [v]";
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-left-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                                font-weight: 400;
                                                vertical-alignment: center;
                                            }
                                        }
                                        badge-left-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.select-track(trk.id);
                                                root.local-menu-track-id = trk.id;
                                                root.active-local-menu = root.active-local-menu == "instrument" ? "" : "instrument";
                                            }
                                            scroll-event(event) => {
                                                root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                            }
                                        }
                                        TooltipBubble {
                                            text: @tr("点击更换音色/效果 [当前: {}]", trk.insert1 != "" ? trk.insert1 : trk.kind);
                                            is-visible: badge-left-touch.has-hover;
                                            tip-offset-y: 22px;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: space-between;

                                    // M S R buttons (Studio colors: Amber / Gold / Crimson)
                                    HorizontalLayout {
                                        spacing: 3px;

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.muted ? Tokens.skin-mute : (m-btn-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.muted ? Tokens.skin-mute : Tokens.skin-hairline;
                                            // `[UI-A11Y-003]` §7.3：按钮角色 + 动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
                                            // T-FIX-335：包头 Rectangle 挂了 `list-item` 角色后，这处点击落入其元素块，
                                            // 须有自己的角色块，否则 `every_clickable_…` 否决（死文件同款形态）。
                                            accessible-role: button;
                                            accessible-id: "track-" + idx + "-mute-button";
                                            accessible-label: @tr("轨道 {} 静音", trk.name);
                                            accessible-checkable: true;
                                            accessible-checked: trk.muted;
                                            accessible-action-default => { root.toggle-mute(trk.id); }
                                            Text {
                                                text: "M";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.muted ? Tokens.bg-lane2 : (m-btn-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            m-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-mute(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.muted ? @tr("取消静音 [M]") : @tr("静音轨道 [M]");
                                                is-visible: m-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.soloed ? Tokens.skin-mute : (s-btn-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.soloed ? Tokens.skin-mute : Tokens.skin-hairline;
                                            // `[UI-A11Y-003]` §7.3：按钮角色 + 动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
                                            // T-FIX-335：包头 Rectangle 挂了 `list-item` 角色后，这处点击落入其元素块，
                                            // 须有自己的角色块，否则 `every_clickable_…` 否决（死文件同款形态）。
                                            accessible-role: button;
                                            accessible-id: "track-" + idx + "-solo-button";
                                            accessible-label: @tr("轨道 {} 独奏", trk.name);
                                            accessible-checkable: true;
                                            accessible-checked: trk.soloed;
                                            accessible-action-default => { root.toggle-solo(trk.id); }
                                            Text {
                                                text: "S";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.soloed ? Tokens.bg-lane2 : (s-btn-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            s-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-solo(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.soloed ? @tr("取消独奏 [S]") : @tr("独奏轨道 [S]");
                                                is-visible: s-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.armed ? Tokens.skin-arm : (r-btn-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.armed ? Tokens.skin-arm : Tokens.skin-hairline;
                                            // `[UI-A11Y-003]` §7.3：按钮角色 + 动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
                                            // T-FIX-335：包头 Rectangle 挂了 `list-item` 角色后，这处点击落入其元素块，
                                            // 须有自己的角色块，否则 `every_clickable_…` 否决（死文件同款形态）。
                                            accessible-role: button;
                                            accessible-id: "track-" + idx + "-arm-button";
                                            accessible-label: @tr("轨道 {} 录音准备", trk.name);
                                            accessible-checkable: true;
                                            accessible-checked: trk.armed;
                                            accessible-action-default => { root.toggle-arm(trk.id); }
                                            Text {
                                                text: "R";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.armed ? Tokens.skin-text-strong : (r-btn-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            r-btn-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-arm(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.armed ? @tr("取消录音准备 [R]") : @tr("录音准备 (Arm) [R]");
                                                is-visible: r-btn-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                    }

                                    // Pan widget + Volume dB + Vertical precision meter
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        // Pan widget
                                        Rectangle {
                                            width: 38px;
                                            height: 20px;
                                            background: pan-touch.has-hover ? Tokens.skin-chip : Tokens.skin-inset;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: Tokens.skin-hairline;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "P";
                                                    font-family: Tokens.font-mono;
                                                    font-size: 8.5px;
                                                    font-weight: 400;
                                                    color: Tokens.skin-text-dim;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: trk.pan;
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9px;
                                                    font-weight: 400;
                                                    color: Tokens.skin-text-body;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            pan-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ew-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-pan-grab(trk.id - 1, self.mouse-x);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-pan-drag(trk.id - 1, self.mouse-x);
                                                    } else {
                                                        root.mixer-pan-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-pan-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("声像: {} (左右拖拽调节，双击归中)", trk.pan);
                                                is-visible: pan-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        // Volume dB text
                                        Rectangle {
                                            width: 44px;
                                            height: 20px;
                                            background: vol-touch.has-hover ? Tokens.skin-chip : transparent;
                                            border-radius: 3px;
                                            border-width: vol-touch.has-hover ? 1px : 0px;
                                            border-color: Tokens.skin-hairline;
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.track-volumes.length > idx ? (root.track-volumes[idx] + "dB") : ("" + (Math.round(trk.volume_db * 10.0) / 10.0) + "dB");
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9.5px;
                                                    color: Tokens.skin-text-body;
                                                    font-weight: 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            vol-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ns-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-fader-grab(trk.id - 1, self.mouse-y);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-fader-drag(trk.id - 1, self.mouse-y);
                                                    } else {
                                                        root.mixer-fader-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-fader-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("推子增益: {} dB (上下拖拽调节，双击归 0dB)", root.track-volumes.length > idx ? root.track-volumes[idx] : ("" + Math.round(trk.volume_db * 10.0) / 10.0));
                                                is-visible: vol-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        // Vertical Level Meter with Peak Indicator
                                        Rectangle {
                                            width: 6px;
                                            height: 20px;
                                            // 电平表井：条体与轨道头同色（bg-lane）时整格读成一块
                                            // 无字灰板 —— 凹陷用 bg-void（比头暗一档）、边界用
                                            // line（比 hairline 实），静默时也看得出这是一格表。
                                            background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-void;
                                            border-radius: 1.5px;
                                            border-width: 1px;
                                            border-color: Tokens.line;
                                            clip: true;

                                            Rectangle {
                                                x: 0;
                                                y: parent.height - (trk.muted ? 0px : (meter-val(idx) * parent.height));
                                                width: 6px;
                                                height: trk.muted ? 0px : (meter-val(idx) * parent.height);
                                                border-radius: 1px;
                                                background: meter-val(idx) > 0.8 ? Tokens.skin-arm : (meter-val(idx) > 0.6 ? Tokens.skin-mute : Tokens.skin-meter-low);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Splitter Divider between Left Track Header and Timeline Lane
                        if !Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-left.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-left := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Center Timeline Lane
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;

                            // 背景选择与滚轮面必须先于片段块声明，避免遮挡 Clip 点击
                            //
                            // ⭐ 框选（line/blank-drag-selection，Wang 2026-11-18 口径，
                            // 照 Logic Pro）：空白车道拖拽 = 橡皮筋框选，⛔ 不做拖拽滚动；
                            // 滚动只走滚轮 / Shift+滚轮 / 滚动条（`scroll-event` 不变）。
                            // 手势状态机（与剪辑体拖拽同款 4px 阈值）：按下记起点（内容帧），
                            // 越阈值才激活框选；松手未激活 ⇒ 仍是原来的单击选轨；
                            // 激活 ⇒ 把矩形（换算到时间轴像素帧）报给宿主算命中。
                            // 起点所在车道的 TouchArea 靠指针捕获继续收 move/up，
                            // 因此跨车道拖拽的坐标仍在本面局部帧里，换算用本行偏移。
                            TouchArea {
                                // ⭐ T-FIX-234：空白车道双击 = 新建一个空 MIDI 片段（宿主 wire_clip_create）。
                                double-clicked => { root.clip-create(); }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                        root.marquee-x0 = self.mouse-x + root.timeline-origin-x;
                                        root.marquee-y0 = self.mouse-y + root.track-ys[idx];
                                        root.marquee-x1 = root.marquee-x0;
                                        root.marquee-y1 = root.marquee-y0;
                                        root.marquee-additive = event.modifiers.shift;
                                        root.marquee-pressed = true;
                                        root.marquee-active = false;
                                    } else if event.kind == PointerEventKind.move && root.marquee-pressed {
                                        root.marquee-x1 = self.mouse-x + root.timeline-origin-x;
                                        root.marquee-y1 = self.mouse-y + root.track-ys[idx];
                                        if !root.marquee-active
                                            && (Math.abs(root.marquee-x1 - root.marquee-x0) > 4px
                                                || Math.abs(root.marquee-y1 - root.marquee-y0) > 4px) {
                                            root.marquee-active = true;
                                        }
                                    } else if event.kind == PointerEventKind.up {
                                        if root.marquee-pressed && root.marquee-active {
                                            root.clip-marquee-select(
                                                root.marquee-x0 - root.timeline-origin-x + root.scroll-x,
                                                root.marquee-y0,
                                                root.marquee-x1 - root.timeline-origin-x + root.scroll-x,
                                                root.marquee-y1,
                                                root.marquee-additive);
                                        } else if root.marquee-pressed {
                                            // 未越阈值 = 单击：保持原语义（选中本轨）。
                                            root.select-track(trk.id);
                                            // ⭐ T-FIX-227：同一次空白单击也报给自动化点编辑
                                            // （死文件的 G-A1 口径）。宿主只在 y 落在某条
                                            // 泳道带内时才产 op；无泳道的行/项目行为不变。
                                            if root.automation-visible {
                                                root.automation-lane-click(
                                                    self.mouse-x,
                                                    root.track-ys[idx] - 42px + self.mouse-y);
                                            }
                                        }
                                        root.marquee-pressed = false;
                                        root.marquee-active = false;
                                    } else if event.kind == PointerEventKind.cancel {
                                        root.marquee-pressed = false;
                                        root.marquee-active = false;
                                    }
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            // Timeline Clips for this track
                            for blk[blk_idx] in root.timeline-blocks : Rectangle {
                                // ⭐ 视口裁剪（2026-11-19 实测修复）：片段块宽度 = 片段真实长度，
                                // 长工程里一个铺满全曲的片段可达 18688px。渲染器对超过 ~16K px 的
                                // 矩形**背景填充失效**（只剩边缘几像素有底色，内部纯黑、文字与音符
                                // 条全不见；2048/8192/16384px 均正常，18688px 复现）。这里把每个块
                                // 裁到视口内再交给渲染器：x/width 取与 [0, root.width] 的交集，
                                // 内容层按 (raw-x − vis-x) 补偿（恒 ≤ 0），于是文字仍停在片段的
                                // **真实起点**（起点在视口外时被父级 clip 正常裁掉），语义不变。
                                // ⛔ 不是"截断宽度"：截断会让块在滚动到后半段时提前消失。
                                // ⚠ 2026-11-23 实证修复：补偿曾写成 max(0, −raw-x) 且宽度同步
                                // 缩短 ⇒ 起点滚出左界的片段，其名字与整条波形被推向右侧并压缩
                                // 进可见区右段（滚动越深推得越远，双指左滑时内容反而右移）；
                                // 短片段（起点在屏内）不触发，长工程单片段（《失语》88 小节）
                                // 一滚就错位。现行公式下起点在屏内时补偿恒 0，行为与旧版一致。
                                // T-FIX-234：拖动期被拖的那一条加预览位移（宿主已吸附）。
                                // T-FIX-491：整组拖动时**每条组员**都加同一份位移（组在按下
                                // 那一刻冻结；松手按同一 delta 一次提交，预览因此与提交一致）。
                                property <length> blk-raw-x: blk.start_px - root.scroll-x
                                    + (root.drag-preview-in-group(blk.clip_ulid, blk_idx) ? root.clip-drag-preview-dx * 1px : 0px);
                                property <length> blk-vis-x: Math.max(blk-raw-x, 0px);
                                property <length> blk-vis-r: Math.min(blk-raw-x + blk.width_px, root.width);
                                if blk.track_id == trk.id && blk-vis-r > blk-vis-x : Rectangle {
                                    x: blk-vis-x;
                                    y: 4px;
                                    width: Math.max(2px, blk-vis-r - blk-vis-x);
                                    height: Math.max(52px, parent.height - 8px);
                                    border-radius: 4px;
                                    // 片段底（九版，Wang 2026-11-17 16:43 亲定，照 Logic Pro
                                    // 区域）：轨道色纯色本体 blk.base-color（投影层
                                    // bridge::clip_base_color 算：纯色不混黑；太浅的色按
                                    // 统一规则只降 HSL 明度，使白色对比 >= 3.05:1——
                                    // 十版标记虽改同色相派生浅色，其明度同量级，
                                    // 本规则原样兜底）。
                                    // 八版「不透明近黑底 + 轨道色 0.12 叠层 = 合成等效
                                    // 实色」废——那是轨道色混黑，暗且脏。轨道标识色
                                    // trk.color 本身不动，轨道头色条仍是原色。
                                    background: blk.base-color;
                                    // 同色边框去除（九版，Wang 16:43）：未选中片段原有
                                    // trk.color α0.55 同色边框整圈去掉（宽 0，无边框）；
                                    // 选中片段的 2px 纯白边框保留（选中指示，非同色边框）。
                                    // 选中 = 主选中 **或** 框选标志（标志与块同序同长时才读，
                                    // 长度对不上 ⇒ 只认主选中，⛔ 不错位误亮）。
                                    border-width: blk.clip_ulid != "" && (blk.clip_ulid == root.selected-clip-ulid || (root.timeline-block-selected.length == root.timeline-blocks.length && root.timeline-block-selected[blk_idx])) ? 2px : 0px;
                                    border-color: Tokens.skin-text-strong;
                                    clip: true;
                                    accessible-role: list-item;
                                    accessible-id: "clip-" + blk.clip_ulid + "-header";
                                    accessible-label: @tr("剪辑 {}", blk.label);
                                    accessible-item-selectable: true;
                                    accessible-item-selected: blk.clip_ulid != "" && (blk.clip_ulid == root.selected-clip-ulid || (root.timeline-block-selected.length == root.timeline-blocks.length && root.timeline-block-selected[blk_idx]));
                                    accessible-action-default => { root.clip-select(blk.clip_ulid); }

                                    VerticalLayout {
                                        // 内容层锚在片段的真实起点：块已被裁到视口内（x = vis-x），
                                        // 内容层相对块的偏移 = raw-x − vis-x（起点在屏内时为 0，
                                        // 在左界外时为负），宽度保持片段全长；超出可见区的内容
                                        // 由本块的 clip 裁掉。⛔ 不得写成正偏移 + 缩短宽度——那会
                                        // 把名字与波形压缩进可见区右段（2026-11-23 实证修复）。
                                        x: blk-raw-x - blk-vis-x;
                                        width: blk.width_px;
                                        padding: 4px;
                                        spacing: 2px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: blk.label;
                                                font-family: Tokens.font-ui;
                                                font-size: 10px;
                                                font-weight: 600;
                                                // 九版：文字色按底色选（blk.text-color，
                                                // 投影层保证对纯色底 >= 4.5:1）。
                                                color: blk.text-color;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            // 自动隐藏规则：宽度不足 110px 时隐藏 Gain 标签，优先完整显示标题，避免截断遮挡
                                            if blk.width_px >= 110px : Text {
                                                text: blk.gain_label;
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: blk.text-color;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // ⭐ 真实波形（ADR-0076 B1）：`blk.waveform-peaks` 非空时按柱画
                                        // （每柱取该段 |sample| 最大值，由 bridge::compute_waveform_peaks 算）；
                                        // 空 = 尚未分析 ⇒ 只留 0dB 基准线并标「示意」，
                                        // ⛔ 绝不画常量折线冒充包络（细节实测 §3.1）。
                                        if blk.is_audio : Rectangle {
                                            height: Math.max(22px, parent.height - 26px);
                                            clip: true;

                                            // 0dB Centerline（基准线，不是编造的包络；十版：
                                            // 色由 blk.guide-color 给——与峰值柱同出投影层
                                            // 派生（轨道色同色相浅色版，bridge::clip_marker_color）
                                            Rectangle {
                                                // 只画可见段：内容层已恢复片段全长，高缩放下整线
                                                // 可达 18K px+，会重蹈块背景的填充失效（2026-11-19
                                                // 实测）；直线只画可见段与整条被裁像素无区别。
                                                x: Math.max(0px, blk-vis-x - blk-raw-x - 4px);
                                                y: parent.height / 2;
                                                width: Math.max(0px, Math.min(parent.width - self.x, blk-vis-r - blk-vis-x));
                                                height: 1px;
                                                background: blk.guide-color;
                                            }

                                            // 真实峰值柱：peaks 为空时 0 个（不画）。
                                            for peak_index in blk.waveform-peaks.length : Rectangle {
                                                x: 4px + peak_index * ((parent.width - 8px) / blk.waveform-peaks.length);
                                                width: Math.max(1px, (parent.width - 8px) / blk.waveform-peaks.length - 1px);
                                                // ⚠ Slint 里 length × float 必须显式换算：先除 1px 变成数，
                                                // 乘完再乘 1px 变回 length（否则编译期报
                                                // 「Cannot convert float to length」）。
                                                height: Math.max(1px, ((parent.height - 8px) / 1px) * blk.waveform-peaks[peak_index] * 1px);
                                                y: (parent.height - self.height) / 2;
                                                // 峰值柱十版改同色相派生色 blk.marker-color
                                                // （Wang 2026-11-17 18:28，照 Logic 波形色）：
                                                // 轨道色 HSV 派生（H 不变、V = 0.99、
                                                // S × 1/3），是底色的浅色版而非纯白——
                                                // 纯白在彩色底上引入外来色且对比过冲，
                                                // 故刺眼（八版/九版纯白废）。逐色落码值
                                                // 由判据 ⑧ 普查钉死。
                                                background: blk.marker-color;
                                            }

                                            Text {
                                                x: 4px;
                                                y: 2px;
                                                width: parent.width - 8px;
                                                text: @tr("波形待分析 · 示意");
                                                // 窄片段放不下整句 ⇒ 不显示被裁成「波形」的半截误导文案；
                                                // 完整语义仍保留在代码与 accessible-label 里。
                                                // 有真实峰值时不再显示该标注。
                                                visible: parent.width >= 88px && blk.waveform-peaks.length == 0;
                                                accessible-role: text;
                                                accessible-label: @tr("波形待分析 · 示意（资产不在会话池或解码失败，当前为 0dB 基准线占位）");
                                                font-family: Tokens.font-mono;
                                                font-size: 8.5px;
                                                color: blk.text-color;
                                                horizontal-alignment: left;
                                                vertical-alignment: top;
                                            }
                                        }

                                        // MIDI Polyphonic Score Display (driven strictly by real blk.note_count)
                                        if !blk.is_audio : Rectangle {
                                            height: Math.max(22px, parent.height - 26px);
                                            clip: true;

                                            // Pitch division guideline（十版：色由
                                            // blk.guide-color 给，口径同波形基准线——
                                            // 同出投影层同色相派生）
                                            Rectangle {
                                                // 只画可见段：同波形基准线（内容层全长下防填充失效）。
                                                x: Math.max(0px, blk-vis-x - blk-raw-x - 4px);
                                                y: parent.height / 2;
                                                width: Math.max(0px, Math.min(parent.width - self.x, blk-vis-r - blk-vis-x));
                                                height: 1px;
                                                background: blk.guide-color;
                                            }

                                            if blk.note_count <= 0 && blk.width_px >= 90px : Text {
                                                x: 8px;
                                                y: (parent.height - self.height) / 2;
                                                text: @tr("空片段");
                                                font-family: Tokens.font-ui;
                                                font-size: 9.5px;
                                                color: blk.text-color;
                                            }

                                            if blk.note_count > 0 : HorizontalLayout {
                                                x: 8px;
                                                y: 6px;
                                                width: Math.max(12px, parent.width - 16px);
                                                height: Math.max(10px, parent.height - 10px);
                                                spacing: 3px;
                                                for n_idx in Math.min(16, blk.note_count) : Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 4px;
                                                    border-radius: 1px;
                                                    // 音符条十版改同色相派生色
                                                    // blk.marker-color（口径同峰值柱）：
                                                    // 轨道色浅色版，⛔ 不再用纯白。
                                                    background: blk.marker-color;
                                                    y: Math.mod(n_idx * 5, 14) * 1px;
                                                }
                                            }
                                        }
                                    }

                                    // 片段面无质感叠层: 负责人 2026-11-17 拟物重点
                                    // 口径 —— 编辑区域 (画布与片段) 保持平坦, 二期
                                    // 加的片段顶光/底影已撤销, 片段本体就是数据色
                                    // (轨道色 + alpha, 信息编码), 两套主题同形。

                                    // ⭐ T-FIX-234：片段拖动面（语义 ID clip-<ulid>-body）。外层矩形随预览位移右移，
                                    // 本体反向抵消 ⇒ 拖动面的**绝对几何不动**（mouse-x 的坐标系稳定，位移读数不会自我抵消）。
                                    // ⭐ T-FIX-491：反向抵消必须与外层位移**同一条件**（组员全抵消），
                                    // 否则组内非按下项的拖动面会被外层右移带走 ⇒ 指针坐标系漂移。
                                    Rectangle {
                                        x: root.drag-preview-in-group(blk.clip_ulid, blk_idx) ? 0px - root.clip-drag-preview-dx * 1px : 0px;
                                        y: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        background: transparent;
                                        accessible-role: region;
                                        accessible-id: "clip-" + blk.clip_ulid + "-body";
                                        accessible-label: @tr("剪辑拖动面 {}", blk.label);
                                    
                                        TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            mouse-cursor: MouseCursor.pointer;
                                    
                                            pointer-event(event) => {
                                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                                    root.clip-drag-origin-x = self.mouse-x;
                                                    root.clip-drag-origin-y = self.mouse-y;
                                                    root.clip-drag-moved = false;
                                                    // ⭐ T-FIX-209：行空间 y = 所在行顶沿 + 剪辑矩形在行内的 4px +
                                                    // 指针在拖动面内的 y（与 `track-ys` 同帧；宿主据此命中落点行）。
                                                    root.clip-dragging = root.clip-drag-grab(blk.clip_ulid, self.mouse-x, root.track-ys[idx] + 4px + self.mouse-y);
                                                } else if event.kind == PointerEventKind.up {
                                                    if root.clip-dragging {
                                                        root.clip-dragging = false;
                                                        if root.clip-drag-moved {
                                                            root.clip-drag-release(blk.clip_ulid, self.mouse-x, root.track-ys[idx] + 4px + self.mouse-y);
                                                        } else {
                                                            root.clip-drag-cancel();
                                                            root.clip-select(blk.clip_ulid);
                                                        }
                                                    }
                                                    root.clip-drag-moved = false;
                                                } else if event.kind == PointerEventKind.move {
                                                    // ⭐ T-FIX-209：横向超过 4px **或**纵向超过 4px 才算拖动
                                                    // （纯纵向拖动没有横向位移，旧口径会把它当点击放掉）。
                                                    if !root.clip-drag-moved
                                                        && ((self.mouse-x - root.clip-drag-origin-x) > 4px
                                                            || (root.clip-drag-origin-x - self.mouse-x) > 4px
                                                            || (self.mouse-y - root.clip-drag-origin-y) > 4px
                                                            || (root.clip-drag-origin-y - self.mouse-y) > 4px) {
                                                        root.clip-drag-moved = true;
                                                    }
                                                    if root.clip-dragging && root.clip-drag-moved {
                                                        root.clip-drag-move(blk.clip_ulid, self.mouse-x, root.track-ys[idx] + 4px + self.mouse-y);
                                                    }
                                                } else {
                                                    root.clip-dragging = false;
                                                    root.clip-drag-moved = false;
                                                    root.clip-drag-cancel();
                                                }
                                            }
                                    
                                            double-clicked => { root.clip-double-click(blk.clip_ulid); }
                                    
                                            scroll-event(event) => {
                                                root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                            }
                                        }
                                    }
                                }
                            }
                            // ⭐ T-FIX-227：本轨的自动化泳道（覆盖模式）。绘制顺序 = 片段在前、
                            //   泳道在后 ⇒ **曲线可见**（修前泳道整块不存在）；命中判定仍归片段
                            //   （泳道不接指针），空白车道的单击在下面的手势状态机里报给宿主
                            //   （automation-lane-click，与死文件「只在空白车道生效」同口径）。
                            //   `y` 与 `track-ys` 同帧（投影的 `band_y` 由同一份行几何算出），
                            //   ⛔ 不减 `rows-top`（那是死文件的结构差异）。
                            for _lane[lane_index] in root.automation-lane-target-keys : Rectangle {
                                visible: root.automation-visible
                                    && root.automation-lane-track-indexes[lane_index] == idx;
                                x: 0px;
                                y: root.automation-lane-band-ys[lane_index] - root.track-ys[idx];
                                width: parent.width;
                                height: root.automation-lane-band-heights[lane_index];
                                background: transparent;
                                clip: true;
                                accessible-role: image;
                                // 与 `elements.rs` 注册表 / `automation::lane_element_id` 逐字同形。
                                accessible-id: "track-" + root.automation-lane-track-indexes[lane_index] + "-automation-" + root.automation-lane-target-keys[lane_index] + "-lane";
                                // 标签带单位与**当前值**（跟随播放头，见 `automation_labels_follow_playhead`）。
                                accessible-label: root.automation-lane-labels[lane_index];

                                Path {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    // 顶点是绝对像素（投影的 `path_commands`）⇒ 与剪辑同格用
                                    // `viewbox-x` 滑窗口（移元素 x 会把右半曲线裁在 bounds 外）。
                                    viewbox-x: root.scroll-x / 1px;
                                    viewbox-y: 0;
                                    viewbox-width: parent.width / 1px;
                                    viewbox-height: parent.height / 1px;
                                    fit: ImageFit.fill;
                                    commands: root.automation-path-commands[lane_index];
                                    stroke: root.automation-lane-read-enabled[lane_index] ? Tokens.gold-bright : Tokens.ink-2;
                                    stroke-width: 1.5px;
                                    fill: transparent;
                                }

                                // 轴标签（单位 + 量程；自适应时带「自适应」）
                                UiMonoText {
                                    x: Tokens.space-3;
                                    y: 0px;
                                    width: 160px;
                                    height: parent.height;
                                    text: root.automation-lane-axis-labels[lane_index];
                                    color: Tokens.ink-2;
                                    font-size: Tokens.font-size-xs;
                                    overflow: elide;
                                }

                                // 角标（读关 / 录制臂）；空串时不画。
                                UiText {
                                    visible: root.automation-lane-badges[lane_index] != "";
                                    x: 168px;
                                    y: 0px;
                                    width: parent.width - 168px;
                                    height: parent.height;
                                    text: root.automation-lane-badges[lane_index];
                                    color: root.automation-lane-read-enabled[lane_index] ? Tokens.gold-deep : Tokens.ink-2;
                                    font-size: Tokens.font-size-xs;
                                    overflow: elide;
                                }
                            }

                        }

                        // Splitter Divider between Timeline Lane and Right Track Header
                        if Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-right.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-right := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Right Track Header (if right mode)
                        if Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            // ⭐ T-FIX-232：稳定的自动化元素 ID（`UI-TEST-001` 语义寻址；死文件同款，
                            // 与左头同一份 ID —— 左右分支互斥，只有一份实例进树）。
                            // 无障碍默认动作 = 选中这条轨；增 / 减 = 下移 / 上移一格（落点
                            // `host::wire_track_reorder` 的 `track-reorder-step`，直接提交）。
                            accessible-role: list-item;
                            accessible-id: "track-" + idx + "-header";
                            accessible-label: @tr("轨道 {}", trk.name);
                            accessible-item-index: idx;
                            accessible-item-count: root.tracks.length;
                            accessible-item-selectable: true;
                            accessible-item-selected: trk.id == root.selected-track-id;
                            accessible-action-default => { root.track-select(idx); }
                            accessible-action-increment => { root.track-reorder-step(idx, 1); }
                            accessible-action-decrement => { root.track-reorder-step(idx, -1); }
                            // `[UI-A11Y-003]` §7.3：展开动作 = 徽章 `[v]` 的点击落点（选中这条轨并切换
                            // 乐器本地菜单）。徽章 `TouchArea` 自己没有角色，而 `accessible-action-*`
                            // 只能挂在有角色的元素上 ⇒ 落点挂在包头元素块里（T-FIX-335；静音 / 独奏 /
                            // 录音准备三处各有自己的 `button` 角色块，见下）。
                            accessible-action-expand => {
                                root.select-track(trk.id);
                                root.local-menu-track-id = trk.id;
                                root.active-local-menu = root.active-local-menu == "instrument" ? "" : "instrument";
                            }
                            // 选中头底与边框同左头 (裁决甲质感三元: 拟物支
                            // main 形态, 扁平支十一版定值 #293645 / 边框
                            // Theme.border-subtle, 七版 #16232b 与纯白边框
                            // 同废; 解法与左头逐字一致)。
                            background: Tokens.texture-physical ? (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.10) : Tokens.track-head-brush) : (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.12) : Tokens.bg-panel);
                            border-color: Tokens.texture-physical ? (trk.id == root.selected-track-id ? Theme.accent.with-alpha(0.80) : Theme.border-subtle) : Theme.border-subtle;

                            Rectangle {
                                x: parent.width - 4px;
                                y: 0;
                                width: trk.id == root.selected-track-id ? 5px : 3.5px;
                                height: parent.height;
                                background: trk.color;
                            }

                            // ⭐ T-FIX-232：轨道头手势（从死文件 `workspace/arrangement_view.slint`
                            // 搬进活视图；手势分区与死文件逐字一致）。名称区按下 ⇒ 重排（报行空间 y）；
                            // 底边 6px 按下 ⇒ 高度。按下即选中（一次点击 = 选中这条轨，⛔ 不提交工程）。
                            // ⚠ 按下时的选中会走 `apply_view` 重注模型、重建包头项 ⇒ 按下那一刻的指针
                            // 抓取随之失效，`move` / `up` 落到新建的 TouchArea（见下面两条路由注释）。
                            // 按钮是后置子元素，命中测试先拿到点击，拖拽面只接管剩下的区域。
                            // 零视觉：`TouchArea` 不画任何东西 ⇒ 默认帧一位不变。
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right
                                        && event.kind == PointerEventKind.down {
                                        root.open-track-context-menu(
                                            trk.id,
                                            idx,
                                            trk.armed,
                                            (Theme.track-headers-on-right ? root.width - root.headers-width : 0px) + self.mouse-x,
                                            arr_lanes_container.y + root.track-ys[idx] + arr_tracks_flickable.content-y + self.mouse-y,
                                        );
                                    } else if event.kind == PointerEventKind.down {
                                        root.track-select(idx);
                                        if self.mouse-y < self.height - 6px {
                                            root.track-reorder-grab(idx, root.track-ys[idx] + self.mouse-y);
                                        } else {
                                            root.track-height-grab(idx, self.mouse-y);
                                        }
                                    } else if event.kind == PointerEventKind.move {
                                        if root.track-reorder-active {
                                            // 重排进行中按**已抓取下标**路由（见死文件注释：按下时的选中会
                                            // 重建包头项，`move` 可能落在另一行的 TouchArea；行空间 y 仍由
                                            // 接收头的自身几何算，在哪一行收到都是同一个行空间点）。
                                            root.track-reorder-drag(root.track-reorder-index, root.track-ys[idx] + self.mouse-y);
                                        } else {
                                            // 悬浮的 `move` 不会误改行高：宿主以 `track-height-drag-active`
                                            // 为唯一读数，孤立的 move 直接 return（见 `host.rs` 注释）。
                                            root.track-height-drag(idx, self.mouse-y);
                                        }
                                    } else {
                                        // `up` 与 `cancel` 都是收尾（拖到窗口外松手也走这条路）。
                                        if root.track-reorder-active {
                                            root.track-reorder-release(root.track-reorder-index);
                                        } else {
                                            root.track-height-release(idx);
                                        }
                                    }
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 4px;
                                    if root.rename-track-index == idx : ImeAwareTextInput {
                                        horizontal-stretch: 1;
                                        text <=> root.rename-draft;
                                        single-line: true;
                                        font-family: Tokens.font-ui;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Tokens.skin-text-strong;
                                        vertical-alignment: center;
                                        accessible-role: text-input;
                                        accessible-id: "arrangement-track-rename-input";
                                        accessible-label: @tr("轨道重命名");
                                        accessible-value: root.rename-draft;
                                        accessible-read-only: false;
                                        init => { self.focus(); }
                                        accepted => { root.commit-track-rename(); }
                                        key-pressed(event) => {
                                            if event.text == Key.Escape {
                                                root.cancel-track-rename();
                                                accept
                                            } else {
                                                reject
                                            }
                                        }
                                    }
                                    if root.rename-track-index != idx : Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: trk.id == root.selected-track-id ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        background: badge-right-touch.has-hover ? Tokens.line : Tokens.skin-scrim;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: badge-right-touch.has-hover ? Theme.accent : Tokens.skin-hairline;
                                        max-width: 140px;
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            // 同左侧轨道头：名字 elide、`[v]` 尾巴恒定可见。
                                            Text {
                                                text: trk.insert1 != "" ? trk.insert1 : trk.kind;
                                                horizontal-stretch: 1;
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-right-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                                font-weight: 400;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: " [v]";
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                color: badge-right-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                                                font-weight: 400;
                                                vertical-alignment: center;
                                            }
                                        }
                                        badge-right-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.select-track(trk.id);
                                                root.local-menu-track-id = trk.id;
                                                root.active-local-menu = root.active-local-menu == "instrument" ? "" : "instrument";
                                            }
                                            scroll-event(event) => {
                                                root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                            }
                                        }
                                        TooltipBubble {
                                            text: @tr("点击更换音色/效果 [当前: {}]", trk.insert1 != "" ? trk.insert1 : trk.kind);
                                            is-visible: badge-right-touch.has-hover;
                                            tip-offset-y: 22px;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 3px;
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.muted ? Tokens.skin-mute : (m-btn-r-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.muted ? Tokens.skin-mute : Tokens.skin-hairline;
                                            // `[UI-A11Y-003]` §7.3：按钮角色 + 动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
                                            // T-FIX-335：包头 Rectangle 挂了 `list-item` 角色后，这处点击落入其元素块，
                                            // 须有自己的角色块，否则 `every_clickable_…` 否决（死文件同款形态）。
                                            accessible-role: button;
                                            accessible-id: "track-" + idx + "-mute-button";
                                            accessible-label: @tr("轨道 {} 静音", trk.name);
                                            accessible-checkable: true;
                                            accessible-checked: trk.muted;
                                            accessible-action-default => { root.toggle-mute(trk.id); }
                                            Text {
                                                text: "M";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.muted ? Tokens.bg-lane2 : (m-btn-r-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            m-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-mute(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.muted ? @tr("取消静音 [M]") : @tr("静音轨道 [M]");
                                                is-visible: m-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.soloed ? Tokens.skin-mute : (s-btn-r-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.soloed ? Tokens.skin-mute : Tokens.skin-hairline;
                                            // `[UI-A11Y-003]` §7.3：按钮角色 + 动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
                                            // T-FIX-335：包头 Rectangle 挂了 `list-item` 角色后，这处点击落入其元素块，
                                            // 须有自己的角色块，否则 `every_clickable_…` 否决（死文件同款形态）。
                                            accessible-role: button;
                                            accessible-id: "track-" + idx + "-solo-button";
                                            accessible-label: @tr("轨道 {} 独奏", trk.name);
                                            accessible-checkable: true;
                                            accessible-checked: trk.soloed;
                                            accessible-action-default => { root.toggle-solo(trk.id); }
                                            Text {
                                                text: "S";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.soloed ? Tokens.bg-lane2 : (s-btn-r-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            s-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-solo(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.soloed ? @tr("取消独奏 [S]") : @tr("独奏轨道 [S]");
                                                is-visible: s-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                        Rectangle {
                                            width: 20px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: trk.armed ? Tokens.skin-arm : (r-btn-r-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel);
                                            border-width: 1px;
                                            border-color: trk.armed ? Tokens.skin-arm : Tokens.skin-hairline;
                                            // `[UI-A11Y-003]` §7.3：按钮角色 + 动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
                                            // T-FIX-335：包头 Rectangle 挂了 `list-item` 角色后，这处点击落入其元素块，
                                            // 须有自己的角色块，否则 `every_clickable_…` 否决（死文件同款形态）。
                                            accessible-role: button;
                                            accessible-id: "track-" + idx + "-arm-button";
                                            accessible-label: @tr("轨道 {} 录音准备", trk.name);
                                            accessible-checkable: true;
                                            accessible-checked: trk.armed;
                                            accessible-action-default => { root.toggle-arm(trk.id); }
                                            Text {
                                                text: "R";
                                                font-family: Tokens.font-mono;
                                                font-size: 10px;
                                                font-weight: 400;
                                                color: trk.armed ? Tokens.skin-text-strong : (r-btn-r-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            r-btn-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.toggle-arm(trk.id); }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: trk.armed ? @tr("取消录音准备 [R]") : @tr("录音准备 (Arm) [R]");
                                                is-visible: r-btn-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        Rectangle {
                                            width: 38px;
                                            height: 20px;
                                            background: pan-r-touch.has-hover ? Tokens.skin-chip : Tokens.skin-inset;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: Tokens.skin-hairline;
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "P";
                                                    font-family: Tokens.font-mono;
                                                    font-size: 8.5px;
                                                    font-weight: 400;
                                                    color: Tokens.skin-text-dim;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: trk.pan;
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9px;
                                                    font-weight: 400;
                                                    color: Tokens.skin-text-body;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            pan-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ew-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-pan-grab(trk.id - 1, self.mouse-x);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-pan-drag(trk.id - 1, self.mouse-x);
                                                    } else {
                                                        root.mixer-pan-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-pan-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("声像: {} (左右拖拽调节，双击归中)", trk.pan);
                                                is-visible: pan-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 44px;
                                            height: 20px;
                                            background: vol-r-touch.has-hover ? Tokens.skin-chip : transparent;
                                            border-radius: 3px;
                                            border-width: vol-r-touch.has-hover ? 1px : 0px;
                                            border-color: Tokens.skin-hairline;
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.track-volumes.length > idx ? (root.track-volumes[idx] + "dB") : ("" + (Math.round(trk.volume_db * 10.0) / 10.0) + "dB");
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9.5px;
                                                    color: Tokens.skin-text-body;
                                                    font-weight: 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            vol-r-touch := TouchArea {
                                                mouse-cursor: MouseCursor.ns-resize;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down {
                                                        root.mixer-fader-grab(trk.id - 1, self.mouse-y);
                                                    } else if event.kind == PointerEventKind.move {
                                                        root.mixer-fader-drag(trk.id - 1, self.mouse-y);
                                                    } else {
                                                        root.mixer-fader-release(trk.id - 1);
                                                    }
                                                }
                                                double-clicked => {
                                                    root.mixer-fader-reset(trk.id - 1);
                                                }
                                                scroll-event(event) => {
                                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                                }
                                            }
                                            TooltipBubble {
                                                text: @tr("推子增益: {} dB (上下拖拽调节，双击归 0dB)", root.track-volumes.length > idx ? root.track-volumes[idx] : ("" + Math.round(trk.volume_db * 10.0) / 10.0));
                                                is-visible: vol-r-touch.has-hover;
                                                tip-offset-y: 24px;
                                            }
                                        }

                                        Rectangle {
                                            width: 6px;
                                            height: 20px;
                                            // 电平表井：条体与轨道头同色（bg-lane）时整格读成一块
                                            // 无字灰板 —— 凹陷用 bg-void（比头暗一档）、边界用
                                            // line（比 hairline 实），静默时也看得出这是一格表。
                                            background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-void;
                                            border-radius: 1.5px;
                                            border-width: 1px;
                                            border-color: Tokens.line;
                                            clip: true;

                                            Rectangle {
                                                x: 0;
                                                y: parent.height - (trk.muted ? 0px : (meter-val(idx) * parent.height));
                                                width: 6px;
                                                height: trk.muted ? 0px : (meter-val(idx) * parent.height);
                                                border-radius: 1px;
                                                background: meter-val(idx) > 0.8 ? Tokens.skin-arm : (meter-val(idx) > 0.6 ? Tokens.skin-mute : Tokens.skin-meter-low);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ⭐ T-FIX-232：轨道重排的插入指示线（死文件 `workspace/arrangement_view.slint` 同款）。
                //
                // 2px 金线，y = 宿主算好的插入行顶沿或表底（行空间坐标，与 `track-ys` 同帧），
                // 满宽（包头列 + 车道，仿 Logic 拖动时的蓝线）。只在重排拖动越过 4px 阈值后出现
                // （`preview-index >= 0`）；松手 / `Escape` 后宿主清零即消失。草稿期不碰工程。
                // 只在拖动时存在 ⇒ 默认帧一位不变。
                if root.track-reorder-preview-index >= 0 : Rectangle {
                    x: 0px;
                    y: root.track-reorder-preview-y * 1px;
                    width: parent.width;
                    height: 2px;
                    background: Tokens.gold;
                    accessible-role: image;
                    accessible-id: "track-reorder-insertion-line";
                    accessible-label: @tr("轨道插入位置");
                }

                // ⭐ T-FIX-209：剪辑跨轨拖动的落点指示线（与重排插入线同款）。
                //
                // 2px 金线，y = 宿主算好的目标行顶沿（行空间坐标，与 `track-ys` 同帧），
                // 满宽（包头列 + 车道）。只在拖动中指针命中了另一行时出现
                // （`preview-track-index >= 0`）；松手 / `Escape` 后宿主清零即消失。
                // 草稿期不碰工程。只在拖动时存在 ⇒ 默认帧一位不变。
                // ⚠ 线画在目标行顶沿：剪辑松手后落在**这条线之下**的那一行。
                if root.clip-drag-preview-track-index >= 0 : Rectangle {
                    x: 0px;
                    y: root.clip-drag-preview-track-y * 1px;
                    width: parent.width;
                    height: 2px;
                    background: Tokens.gold;
                    accessible-role: image;
                    accessible-id: "clip-drag-target-line";
                    accessible-label: @tr("剪辑落点轨道");
                }

                // Empty Track Lane Canvas / Add Track Drop Zone (Placed strictly below sheet-height + top offset inside Flickable)
                Rectangle {
                    y: root.sheet-height + 42px;
                    vertical-stretch: 0;
                    height: 38px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 0px;

                        // Left Header Box placeholder
                        if !Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 24px;
                                    background: add-track-btm-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel-alt;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Tokens.skin-hairline;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: @tr("+ 点击添加新轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Tokens.skin-text-body;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-btm-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("创建新音频或MIDI轨道");
                                        is-visible: add-track-btm-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }

                        // Splitter Divider between Left Placeholder and Bottom Grid Area
                        if !Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-btm-left.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-btm-left := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width + delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Center Grid Area
                        Rectangle {
                            horizontal-stretch: 1;

                            // 空态提示按**视口**居中：此前放在内容网格的同级
                            // HorizontalLayout 里，按 bar-count × bar-width 的内容宽度
                            // 居中，整句被推到右缘只剩半句（细节实测 §4.8）。
                            // 显式 width = parent.width（视口）+ word-wrap ⇒ 不再被裁断。
                            Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("在此区域拖拽音频、MIDI 文件或双击以新增轨道");
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 500;
                                color: Tokens.skin-text-dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            drop_zone_touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.add-track(); }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                            TooltipBubble {
                                text: @tr("双击或点击此区域添加新轨道");
                                is-visible: drop_zone_touch.has-hover;
                                tip-offset-y: 20px;
                            }
                        }

                        // Splitter Divider between Bottom Grid Area and Right Placeholder
                        if Theme.track-headers-on-right : Rectangle {
                            width: 5px;
                            background: transparent;
                            Rectangle {
                                x: 2px;
                                width: 1px;
                                height: parent.height;
                                background: split-header-btm-right.has-hover ? Theme.accent : Tokens.divider-row;
                            }
                            split-header-btm-right := TouchArea {
                                mouse-cursor: MouseCursor.col-resize;
                                moved => {
                                    let delta = self.mouse-x - self.pressed-x;
                                    root.headers-width = Math.min(320px, Math.max(180px, root.headers-width - delta));
                                }
                                double-clicked => {
                                    root.headers-width = 240px;
                                }
                                scroll-event(event) => {
                                    root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                }
                            }
                        }

                        // Right Header Box placeholder (if right mode)
                        if Theme.track-headers-on-right : Rectangle {
                            width: root.headers-width;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 24px;
                                    background: add-track-btm-r-touch.has-hover ? Tokens.skin-chip : Tokens.bg-panel-alt;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Tokens.skin-hairline;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: @tr("+ 点击添加新轨道");
                                            font-family: Tokens.font-ui;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Tokens.skin-text-body;
                                            vertical-alignment: center;
                                        }
                                    }
                                    add-track-btm-r-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.add-track(); }
                                        scroll-event(event) => {
                                            root.handle-arr-scroll(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt, true)
                                        }
                                    }
                                    TooltipBubble {
                                        text: @tr("创建新音频或MIDI轨道");
                                        is-visible: add-track-btm-r-touch.has-hover;
                                        tip-offset-y: 28px;
                                    }
                                }
                            }
                        }
                    }
                }

                // 框选矩形（line/blank-drag-selection）：只在草稿激活时画。
                // 颜色用现行令牌 `Tokens.selection`：框选属半透明保留例外
                // （Wang 口径），填充取低 alpha、边框取令牌实色；编辑面其余
                // 部分保持实色不变。纯 Rectangle 不接指针事件，不挡命中。
                Rectangle {
                    visible: root.marquee-active;
                    x: Math.min(root.marquee-x0, root.marquee-x1);
                    y: Math.min(root.marquee-y0, root.marquee-y1);
                    width: Math.abs(root.marquee-x1 - root.marquee-x0);
                    height: Math.abs(root.marquee-y1 - root.marquee-y0);
                    background: Tokens.selection.with-alpha(0.15);
                    border-width: 1px;
                    border-color: Tokens.selection;
                }
            }

            // ⭐ 轨道区纵向滚动指示（UI 补丁 v6 修正版）：`arr_tracks_flickable` 早就能滚，
            // 但界面上没有任何可见提示 —— 窄窗口实测下第 3 轨之后与末尾「＋ 点击添加新轨道」
            // 被滚出视野，创作者只能靠"盲滚"发现下面还有内容。
            //
            // ⚠ 三处实测结论（2026-11-19，全窗抓帧 + 亮色定位）：
            // ① 定位不能写 `parent.width`：`if 条件 : Rectangle { … }` 的包裹层不继承外层
            //    尺寸，里面的 parent 是条件块自身（宽 = 滑块 4px），x 会算成 -3px 被 clip，
            //    判据成立也一个像素都不画。改锚行区容器 id 后亮色条精确落在 x=1439..1444。
            // ② 显隐不能只靠「content-height > flickable.height」：这条判据在实机上恒假
            //    （flickable.height 绑 parent.height，与容器同源），滚动条因此始终不出现。
            //    改为**用滑块自身的占比自证**：内容装得下 ⇒ 滑块占满 ⇒ 自动隐藏。
            // ③ 比例与位移全部用容器高，不再引用 flickable.height。
            // 纯视觉条、无文案，不影响 9 个语种词表与拟物化分支。
            arr_scroll_bar := Rectangle {
                visible: arr_scroll_bar.thumb-h < arr_lanes_container.height - 3px;
                x: arr_lanes_container.width - 7px;
                y: 3px;
                width: 4px;
                height: arr_lanes_container.height - 6px;
                border-radius: 2px;
                background: #2b3140;

                // 滑块高 = 可视高 × (可视高 / 内容高)，下限 28px；上限压到轨槽高，
                // 内容装得下时正好等于轨槽高 ⇒ 上面 visible 判据自动为假。
                // ⚠ 必须挂在带 id 的外层：内层 Rectangle 的 self 指自己，写 self.thumb-h 编译不过。
                property <length> thumb-h: Math.min(
                    arr_lanes_container.height - 6px,
                    Math.max(
                        28px,
                        (arr_lanes_container.height * arr_lanes_container.height) / max(1px, arr_tracks_flickable.content-height)
                    )
                );

                Rectangle {
                    width: arr_scroll_bar.width;
                    height: arr_scroll_bar.thumb-h;
                    y: Math.min(
                        arr_scroll_bar.height - arr_scroll_bar.thumb-h,
                        Math.max(0px, (-arr_tracks_flickable.content-y) * (arr_lanes_container.height / max(1px, arr_tracks_flickable.content-height)))
                    );
                    border-radius: 2px;
                    background: #404c5f;
                }
            }
        }
    }

    // Animated Playhead Overlay (clipped strictly to Center Timeline region, spanning Ruler down through Track Lanes)
    Rectangle {
        x: root.timeline-origin-x;
        y: 0px;
        width: root.timeline-width;
        height: parent.height;
        clip: true;

        // 播放头颜色（六版，Wang 2026-11-17 15:09）：竖线与头部改
        // 纯白 Tokens.skin-text-strong——播放头是视觉中心，对最深车道行底 #181719
        // 实算 17.87:1，醒目度最高。只改编曲区这一处落点，⛔ 不动
        // Theme.accent 本体（全局唯一强调色，录音键 ● 与循环带等
        // 仍用它）；钢琴卷帘播放头不在本笔范围。
        Rectangle {
            x: root.playhead-px - root.scroll-x;
            y: 0px;
            width: 2px;
            height: parent.height;
            background: Tokens.skin-text-strong;

            // Diamond head at ruler top
            Rectangle {
                x: -4px;
                y: 0px;
                width: 10px;
                height: 10px;
                background: Tokens.skin-text-strong;
                border-radius: 2px;
            }
        }
    }

    // ─── Arrangement Local Menus Backdrop & Popovers ───────────
        if root.active-local-menu != "" : TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.active-local-menu = ""; }
        }

        if root.active-local-menu == "tracks" : Rectangle {
            x: Theme.track-headers-on-right ? parent.width - root.headers-width + 8px : 8px;
            y: 50px;
            width: 196px;
            height: Math.min(parent.height - 58px, arr_tracks_menu_col.preferred-height);
            background: Tokens.bg-panel;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.accent;
            drop-shadow-blur: 14px;
            drop-shadow-color: Tokens.skin-scrim;
            arr_tracks_menu_col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for opt in [
                    { id: "track-add-midi", label: @tr("+ 新建 MIDI 乐器轨") },
                    { id: "track-add-audio", label: @tr("+ 新建音频轨") },
                    { id: "track-add-bus", label: @tr("+ 新建辅助发送轨") },
                    { id: "new-midi-clip", label: @tr("+ 新建 4 小节 MIDI 片段") },
                    { id: "place-audio-clip", label: @tr("将最新导入音频摆放到音频轨") },
                    { id: "track-equal-heights", label: @tr("均分所有轨道高度") },
                    { id: "toggle-chord-lane", label: @tr("显示 / 隐藏和弦轨") },
                    { id: "track-toggle-headers-side", label: @tr("左 / 右侧切换轨道头") },
                ] : Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: trk-m-touch.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: opt.label;
                            font-family: Tokens.font-ui;
                            font-size: 10.5px;
                            color: trk-m-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                            vertical-alignment: center;
                        }
                    }
                    trk-m-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.active-local-menu = "";
                            root.execute-action(opt.id);
                        }
                    }
                }
            }
        }

        if root.active-local-menu == "instrument" : Rectangle {
            x: Theme.track-headers-on-right ? parent.width - root.headers-width - 10px : 10px;
            y: 54px;
            width: 228px;
            height: Math.min(parent.height - 62px, arr_inst_menu_col.preferred-height);
            background: Tokens.bg-panel;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.accent;
            drop-shadow-blur: 16px;
            drop-shadow-color: Tokens.skin-scrim;
            arr_inst_menu_col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Text {
                    text: @tr("更换轨道 #{} 音色 / 插入", root.local-menu-track-id);
                    font-family: Tokens.font-ui;
                    font-size: 10px;
                    font-weight: 600;
                    color: Theme.accent;
                    height: 20px;
                    vertical-alignment: center;
                }
                for preset in [
                    { id: "synth:hollow", label: @tr("合成器 • 柔和主音 (Hollow Lead)") },
                    { id: "synth:organ", label: @tr("合成器 • 风琴键音 (Warm Organ)") },
                    { id: "synth:vocal", label: @tr("合成器 • 人声铺底 (Choir Pad)") },
                    { id: "synth:metallic", label: @tr("合成器 • 金属 FM (FM Bell)") },
                    { id: "synth:glass", label: @tr("合成器 • 水晶拨弦 (Glass Pluck)") },
                    { id: "synth:bass", label: @tr("合成器 • 次低音 (Sub Bass)") },
                    { id: "sfz:default", label: @tr("采样库 • 加载 SFZ 音色...") },
                    { id: "fx:eq", label: @tr("效果槽 • 插入 参量均衡 EQ") },
                    { id: "fx:reverb", label: @tr("效果槽 • 插入 空间混响 Reverb") },
                    { id: "fx:compressor", label: @tr("效果槽 • 插入 动态压缩 Compressor") },
                ] : Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: inst-m-touch.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: preset.label;
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            color: inst-m-touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    inst-m-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.active-local-menu = "";
                            root.track-instrument-change(
                                root.local-menu-track-id > 0 ? root.local-menu-track-id : root.selected-track-id,
                                preset.id
                            );
                        }
                    }
                }
            }
        }

    // T-FIX-166：选中轨道头的右键上下文菜单。与卷帘右键菜单同范式 ——
    // `PopupWindow` + `close-on-click-outside`，点外关闭；默认不显示、不占命中、
    // 不进默认帧。条目只接**已存在**的操作（删轨 / 录音臂 / 建轨 / 效果槽）；
    // 「重命名」走既有 `track-rename` 回调进入轨道头内联编辑，不另开通道。
    track-context-popup := PopupWindow {
        x: root.track-context-menu-x;
        y: root.track-context-menu-y;
        width: 250px;
        height: 278px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Tokens.texture-physical ? Tokens.panel-brush : Tokens.bg-panel;
            border-width: 1px;
            border-color: Tokens.gold-deep;
            border-radius: Tokens.radius-sm;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;

                // 录音臂是**开/关**（文案随当前轨道状态切换，两条 msgid 都已在词表里）。
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-arm";
                    label: root.track-context-armed ? @tr("取消录音准备 [R]") : @tr("录音准备 (Arm) [R]");
                    activate => { root.activate-track-context-item("arm", ""); }
                }
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-rename";
                    label: @tr("重命名当前选中轨道");
                    activate => { root.activate-track-context-item("rename", ""); }
                }
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-delete";
                    label: @tr("删除当前选中轨道");
                    activate => { root.activate-track-context-item("action", "track-delete"); }
                }
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-add-midi";
                    label: @tr("+ 新建 MIDI 乐器轨");
                    activate => { root.activate-track-context-item("action", "track-add-midi"); }
                }
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-add-audio";
                    label: @tr("+ 新建音频轨");
                    activate => { root.activate-track-context-item("action", "track-add-audio"); }
                }
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-add-aux";
                    label: @tr("+ 新建辅助发送轨");
                    activate => { root.activate-track-context-item("action", "track-add-bus"); }
                }
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-instrument-eq";
                    label: @tr("效果槽 • 插入 参量均衡 EQ");
                    activate => { root.activate-track-context-item("instrument", "fx:eq"); }
                }
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-instrument-reverb";
                    label: @tr("效果槽 • 插入 空间混响 Reverb");
                    activate => { root.activate-track-context-item("instrument", "fx:reverb"); }
                }
                TrackContextMenuItem {
                    a11y-id: "arrangement-track-context-instrument-compressor";
                    label: @tr("效果槽 • 插入 动态压缩 Compressor");
                    activate => { root.activate-track-context-item("instrument", "fx:compressor"); }
                }
            }
        }
    }
}
