// 夜半 (Yeban) — 缺音源的救援面板
//
// 它回答的是"打开工程发现没声音"那一刻的三个问题：
//   1. 是哪条轨、缺的是哪一件？
//   2. 我能不能一键换一件**能响的相近音源**（同类乐器）？
//   3. 如果我就想要原音源，去哪儿下载？
//
// ## 设计纪律（见 `docs/UX-错误与提醒设计原则.md`）
// - 一屏说清，每一行**只放一轨**，行内最多 3 个候选 + 1 个"下载原音源"。
// - 候选优先**已经装好的**（本地能直接响），其次才是要下载的；按钮文字如实
//   区分「换成 X」（已装，点了就响）与「下载 X」（还没装，点了去下载）。
// - ⛔ 不显示工程内部路径原文（那是给开发看的），只显示文件名主干与轨道名。
//
// ## 数据契约（本文件不做任何实事）
// 全部数据由宿主以**平行数组**写入（与本仓其它面板同款形态）：
// `track-names` / `details` / `hints` / `can-download` +
// `s1-name`/`s1-path`/`s1-installed` … `s3-*`。空名 = 该格没有候选。

import { Tokens, UiText, UiTitleText } from "../tokens.slint";

// 一个候选音源按钮：已装 = "换成 X"（发 swap），没装 = "下载 X"（发 open-pack）。
component CandidateButton inherits Rectangle {
    in property <int> row-index: 0;
    // ⚠ 同一行里三枚候选语义相同但**不是同一个控件** ⇒ 语义 id 必须带行与槽下标，
    // 否则运行时控件树直接构造失败（`DuplicateId`，用户看不见，但无障碍树/树导出全废）。
    in property <int> slot: 1;
    in property <string> name: "";
    in property <string> pack-id: "";
    in property <string> path: "";
    in property <bool> installed: true;

    callback swap(int, string, string);
    callback open-pack(int, string, string);
    // 行取焦的进出事件（T-FIX-333）：`FocusScope` 在组件内部，`root` 指不到
    // 对话框 ⇒ 由宿主（对话框）在实例化处把槽位写进 `focused-row-slot`。
    callback cell-focus-gained(int);
    callback cell-focus-lost(int);

    // 三条激活路径（键盘 Return/Space、无障碍默认动作、鼠标点击）共用同一
    // 个函数 —— 是一条触发路径，不是三条（T-FIX-333）。
    function activate() {
        if (root.installed) {
            root.swap(root.row-index, root.path, root.name);
        } else {
            root.open-pack(root.row-index, root.pack-id, root.name);
        }
    }

    // 候选按钮的宽度跟着名字走。此前写死 150px，长音源名（`Yeban PolySynth Lead` 之类）
    // 被截成 `下载 Yeban PolySy…`，三个候选挤在一起时一眼分不出是哪一个 —— 而这正是
    // 用户要"挑一个能响的"的时刻。改成"最少 150px、名字长了自己变宽、最多 200px"，
    // 三枚并排仍能塞进 760px 的救援面板。
    min-width: 150px;
    preferred-width: max(150px, min(200px, label.preferred-width + 16px));
    height: 26px;
    background: Tokens.bg-void;
    border-radius: Tokens.radius-sm;
    border-width: 1px;
    border-color: installed ? Tokens.line : Tokens.gold-deep;

    accessible-role: button;
    // 契约判据按**字面段**比 ⇒ 前缀只留一段，`-{row}-{slot}` 放进属性。
    property <string> id-suffix: "-" + row-index + "-" + slot;
    accessible-id: "missing-sounds-candidate" + self.id-suffix;
    accessible-label: installed ? @tr("换成 {}", root.name) : @tr("下载 {}", root.name);
    accessible-action-default => { root.activate(); }

    // 行取焦（T-FIX-333，T-FIX-217 同款）：`Tab` 沿树序走进本钮，读数写进
    // 对话框的 `focused-row-slot`；Return/Space 与鼠标点击走同一条 `activate()`。
    candidate-focus := FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        focus-on-click: false;
        focus-gained(reason) => { root.cell-focus-gained(100 + root.row-index * 10 + root.slot); }
        focus-lost(reason) => { root.cell-focus-lost(100 + root.row-index * 10 + root.slot); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activate();
                accept
            } else {
                reject
            }
        }
    }

    label := UiText {
        x: 8px;
        y: 0;
        width: parent.width - 16px;
        height: parent.height;
        text: root.installed ? @tr("换成 {}", root.name) : @tr("下载 {}", root.name);
        color: root.installed ? Tokens.ink-1 : Tokens.gold-bright;
        font-size: Tokens.font-size-xs;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        width: parent.width;
        height: parent.height;
        clicked => { root.activate(); }
    }
}

export component MissingSoundsDialog inherits Rectangle {
    // ---- 行数据（宿主写，等长平行数组）----------------------------------
    in property <[string]> track-names;
    in property <[string]> details;
    in property <[string]> hints;
    in property <[bool]> can-download;
    in property <[string]> s1-name;
    in property <[string]> s1-path;
    in property <[string]> s1-id;
    in property <[bool]> s1-installed;
    in property <[string]> s2-name;
    in property <[string]> s2-path;
    in property <[string]> s2-id;
    in property <[bool]> s2-installed;
    in property <[string]> s3-name;
    in property <[string]> s3-path;
    in property <[string]> s3-id;
    in property <[bool]> s3-installed;
    // ---- 顶部摘要（宿主写：一句话说清有几件、能直接换几件）------------------
    in property <string> summary: "";

    callback close();
    callback swap-suggested(int, string, string);
    callback open-pack(int, string, string);
    callback download-original(int);

    // 行数由宿主写入（⛔ 不用 `track-names.length` 推：布局期数组可能还没到，面板高度会抖）
    in property <int> row-count: 0;
    property <length> panel-w: Math.min(760px, root.width - 32px);
    // 高度跟着行数走（2 行 ≈ 340px）：面板不留一大片空底，重量与内容对得上。
    // ⚠ 同时**不得高于窗口**：小屏 / 分屏里 `root.height` 只有 600px 时，原先只按行数
    // 算高度会让面板垂直溢出、底部「先不管」被窗口边裁掉（用户截图里"看不见出口"就是这一类）。
    // 上限 `root.height - 24px`，行列表自己在 `Flickable` 里滚 ⇒ 按钮永远够得着。
    property <length> panel-h: Math.min(Math.min(520px, root.height - 24px), Math.max(240px, 84px + row-count * 102px + 56px));


    background: Tokens.mask-black.with-alpha(0.66);
    clip: true;

    accessible-role: region;
    accessible-id: "missing-sounds-dialog";
    accessible-label: @tr("缺音源");

    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // 键盘（D-UI-19 / T-FIX-182 / T-FIX-217 / T-FIX-333）：Esc 关闭；
    // `Tab` / `Shift+Tab` 在槽位表里闭环 —— 但陷阱只在两端包办：正向到末格
    // （「先不管」，1）再进 ⇒ 回首格（✕，0）；反向到首格再退 ⇒ 去末格。
    // 其余一律 `reject`，交给原生 Tab 遍历（行按钮的 FocusScope 按树序排布，
    // 与槽位表同序 —— 动态行没法从循环外按下标取焦，只能让原生遍历带过去，
    // 见焦点一节）。`Ctrl/Alt/Meta+Tab` 一律放行（不劫持系统手势）。
    trap := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == "\u{9}" || event.text == "\u{19}") {
                if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                    reject
                } else if (event.text == "\u{19}" || event.modifiers.shift) {
                    if (root.focused-control == 0 || root.focused-control == -1) {
                        root.focus-control(1);
                        accept
                    } else {
                        reject
                    }
                } else {
                    if (root.focused-control == 1 || root.focused-control == -1) {
                        root.focus-first-control();
                        accept
                    } else {
                        reject
                    }
                }
            } else if (event.text == "\u{1b}") {
                root.close();
                accept
            } else {
                reject
            }
        }

        panel := Rectangle {
            x: (root.width - root.panel-w) / 2;
            y: (root.height - root.panel-h) / 2;
            width: root.panel-w;
            height: root.panel-h;
            background: Tokens.bg-panel;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.gold-deep;
            clip: true;

            accessible-role: region;
            accessible-id: "missing-sounds-panel";
            accessible-label: @tr("缺音源");

            UiTitleText {
                x: Tokens.space-6;
                y: Tokens.space-4;
                width: parent.width - 96px;
                height: 24px;
                text: @tr("这件音源没装好，要不要换个能响的？");
                color: Tokens.gold-bright;
                font-size: Tokens.font-size-xl;
            }

            UiText {
                x: Tokens.space-6;
                y: Tokens.space-4 + 30px;
                width: parent.width - 2 * Tokens.space-6;
                height: 34px;
                text: root.summary;
                color: Tokens.ink-2;
                font-size: Tokens.font-size-sm;
                wrap: word-wrap;
            }

            // 关闭
            Rectangle {
                x: parent.width - 36px;
                y: Tokens.space-4;
                width: 24px;
                height: 24px;
                background: Tokens.bg-void;
                border-radius: Tokens.radius-sm;
                accessible-role: button;
                accessible-id: "missing-sounds-close-button";
                accessible-label: @tr("先不管，关掉");
                accessible-action-default => { root.close(); }

                missing-sounds-close-focus := FocusScope {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.close();
                            accept
                        } else {
                            reject
                        }
                    }
                }

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: Tokens.ink-1;
                    font-size: Tokens.font-size-xl;
                    horizontal-alignment: center;
                }

                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.close(); }
                }
            }

            // 行列表（Flickable 绝对定位，与本仓其它列表同款；行高固定，重量均匀）
            row-scroll := Flickable {
                x: Tokens.space-4;
                y: 84px;
                width: parent.width - 2 * Tokens.space-4;
                height: Math.max(0px, parent.height - 84px - 52px);
                content-height: row-count * 102px + 4px;

                for row-title[i] in root.track-names : Rectangle {
                    x: 2px;
                    y: i * 102px + 2px;
                    width: parent.width - 4px;
                    height: 96px;
                    background: Tokens.bg-panel-alt;
                    border-radius: Tokens.radius-md;
                    border-width: 1px;
                    border-color: Tokens.line;

                        // 轨名 · 缺的那件
                        UiText {
                            x: Tokens.space-4;
                            y: 10px;
                            width: parent.width - 2 * Tokens.space-4;
                            height: 18px;
                            text: @tr("{} · 缺「{}」", root.track-names[i], root.details[i]);
                            color: Tokens.ink-0;
                            font-size: Tokens.font-size-md;
                            font-weight: 600;
                        }

                        UiText {
                            x: Tokens.space-4;
                            y: 31px;
                            width: parent.width - 2 * Tokens.space-4;
                            height: 18px;
                            text: root.hints[i];
                            color: Tokens.ink-2;
                            font-size: Tokens.font-size-xs;
                            overflow: elide;
                        }

                        // 候选三枚 + 下载原音源（同一行的控件语言）
                        HorizontalLayout {
                            x: Tokens.space-4;
                            y: 58px;
                            height: 26px;
                            spacing: 6px;

                            if root.s1-name[i] != "" : CandidateButton {
                                row-index: i;
                                slot: 1;
                                name: root.s1-name[i];
                                pack-id: root.s1-id[i];
                                path: root.s1-path[i];
                                installed: root.s1-installed[i];
                                // 换上 ⇒ 这一行随即从列表消失（宿主删行）：焦点若还在本行
                                // 任一格上，先挪到 ✕（静态锚点），不留死焦点（T-FIX-217 同款，
                                // 这里按**行**守 —— 鼠标点同行另一格时焦点也在本行）。
                                swap(r, p, n) => { if (root.focused-row-slot >= 100 + i * 10 && root.focused-row-slot < 100 + (i + 1) * 10) { root.focus-first-control(); } root.swap-suggested(r, p, n); }
                                open-pack(r, id, n) => { root.open-pack(r, id, n); }
                                cell-focus-gained(s) => { root.focused-row-slot = s; root.scroll-row-into-view(i); }
                                cell-focus-lost(s) => { if (root.focused-row-slot == s) { root.focused-row-slot = -1; } }
                            }

                            if root.s2-name[i] != "" : CandidateButton {
                                row-index: i;
                                slot: 2;
                                name: root.s2-name[i];
                                pack-id: root.s2-id[i];
                                path: root.s2-path[i];
                                installed: root.s2-installed[i];
                                swap(r, p, n) => { if (root.focused-row-slot >= 100 + i * 10 && root.focused-row-slot < 100 + (i + 1) * 10) { root.focus-first-control(); } root.swap-suggested(r, p, n); }
                                open-pack(r, id, n) => { root.open-pack(r, id, n); }
                                cell-focus-gained(s) => { root.focused-row-slot = s; root.scroll-row-into-view(i); }
                                cell-focus-lost(s) => { if (root.focused-row-slot == s) { root.focused-row-slot = -1; } }
                            }

                            if root.s3-name[i] != "" : CandidateButton {
                                row-index: i;
                                slot: 3;
                                name: root.s3-name[i];
                                pack-id: root.s3-id[i];
                                path: root.s3-path[i];
                                installed: root.s3-installed[i];
                                swap(r, p, n) => { if (root.focused-row-slot >= 100 + i * 10 && root.focused-row-slot < 100 + (i + 1) * 10) { root.focus-first-control(); } root.swap-suggested(r, p, n); }
                                open-pack(r, id, n) => { root.open-pack(r, id, n); }
                                cell-focus-gained(s) => { root.focused-row-slot = s; root.scroll-row-into-view(i); }
                                cell-focus-lost(s) => { if (root.focused-row-slot == s) { root.focused-row-slot = -1; } }
                            }

                            // 就想要原音源 ⇒ 去下载（在清单里才出现）
                            if root.can-download[i] : Rectangle {
                                width: 104px;
                                height: 26px;
                                background: Tokens.bg-void;
                                border-radius: Tokens.radius-sm;
                                border-width: 1px;
                                border-color: Tokens.gold-deep;
                                accessible-role: button;
                                property <string> row-suffix: "-" + i;
                                accessible-id: "missing-sounds-download-original" + self.row-suffix;
                                accessible-label: @tr("下载原音源");
                                accessible-action-default => { root.download-original(i); }

                                // 行取焦（T-FIX-333，T-FIX-217 同款）：槽位 `100+i*10+4`，
                                // 排在三枚候选之后；下载不删行 ⇒ 动作前不用挪焦点。
                                download-original-focus := FocusScope {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    focus-on-click: false;
                                    focus-gained(reason) => { root.focused-row-slot = 100 + i * 10 + 4; root.scroll-row-into-view(i); }
                                    focus-lost(reason) => { if (root.focused-row-slot == 100 + i * 10 + 4) { root.focused-row-slot = -1; } }
                                    key-pressed(event) => {
                                        if (event.text == Key.Return || event.text == Key.Space) {
                                            root.download-original(i);
                                            accept
                                        } else {
                                            reject
                                        }
                                    }
                                }

                                UiText {
                                    x: 4px;
                                    y: 0;
                                    width: parent.width - 8px;
                                    height: parent.height;
                                    text: @tr("下载原音源");
                                    color: Tokens.gold-bright;
                                    font-size: Tokens.font-size-xs;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => { root.download-original(i); }
                                }
                            }
                        }
                    }
            }

            // 底部：一句话 + 关掉
            UiText {
                x: Tokens.space-6;
                y: parent.height - 42px;
                width: parent.width - 176px;
                height: 30px;
                text: @tr("换上同类音源后这条轨立刻就能发声；原来的音源以后装回来还能再改。");
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                x: parent.width - 100px;
                y: parent.height - 38px;
                width: 76px;
                height: 26px;
                background: Tokens.bg-void;
                border-radius: Tokens.radius-sm;
                border-width: 1px;
                border-color: Tokens.line;
                accessible-role: button;
                accessible-id: "missing-sounds-later-button";
                accessible-label: @tr("先不管");
                accessible-action-default => { root.close(); }

                missing-sounds-later-focus := FocusScope {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.close();
                            accept
                        } else {
                            reject
                        }
                    }
                }

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: @tr("先不管");
                    color: Tokens.ink-1;
                    font-size: Tokens.font-size-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.close(); }
                }
            }
        }
    }

    // ---- 焦点读数与轮转（D-UI-19 / T-FIX-182 / T-FIX-217 / T-FIX-333）---------
    /// 行槽位：最近一次取焦的行内按钮写进来的槽位。`focus-gained` 写，
    /// `focus-lost` 只在值仍是自己时清掉 —— 先失后得 / 先得后失两种顺序都
    /// 安全；`-1` = 焦点不在任何行按钮上。
    in-out property <int> focused-row-slot: -1;
    /// 槽位表（与树序 = Tab 序一致；行按钮的槽位见各行 `focus-gained`）：
    /// `0` ✕ 关闭 / `1` 「先不管」/ `100+i*10+{1,2,3}` 行 i 的候选（槽 1–3）/
    /// `100+i*10+4` 行 i 的「下载原音源」/ `-1` 不在模态内。
    /// 静态锚点（0 / 1）由 `focus-control` 直达；行槽位只能由原生 Tab 遍历
    /// 到达 —— Slint 无法从 `for` 循环外按下标取焦重复元素（与 T-FIX-217
    /// 的音源管理同款约束；`focus-control` 调行槽位会被静默忽略，
    /// ⛔ 不是漏网）。本文件没有 `focus-next-control` / `focus-previous-control`：
    /// 它们唯一的调用方是陷阱，陷阱现在只在两端包办、中间交给原生遍历。
    /// （T-FIX-333 之前：行内按钮没有 `FocusScope`，`Tab` 只在 0/1 两格闭环；
    /// 那句旧注释（"给动态行加取焦是另一票"）随本单作废。）
    out property <int> focused-control:
        root.focused-row-slot >= 0 ? root.focused-row-slot
        : missing-sounds-close-focus.has-focus ? 0
        : missing-sounds-later-focus.has-focus ? 1
        : -1;

    /// 取焦跟随读数（T-FIX-404）：`row-scroll` 的 `content-y`，向下滚为负值。
    /// 判据读它断言焦点行已滚进可视区。
    out property <length> row-scroll-y: row-scroll.content-y;

    /// 取焦跟随（T-FIX-404）：行取焦时把该行滚进可视区。行高固定 102px，
    /// 行 i 在内容里的纵向区间是 `[i*102px+2px, i*102px+98px]`；只在行顶 /
    /// 行底越出可视区时才动（最小滚动），已可见的行不动。只从行取焦的四处
    /// `focus-gained` 调用；鼠标点击不取焦（`FocusScope` 的 `focus-on-click`
    /// 为 false，点按只走 `TouchArea` → `activate()`），⇒ 鼠标行为不变。
    /// 夹取与 `arrangement.slint` 的 `handle-arr-scroll` 同款口径。
    function scroll-row-into-view(row: int) {
        if (row * 102px + 2px < -row-scroll.content-y) {
            row-scroll.content-y = Math.max(
                Math.min(0px, row-scroll.height - row-scroll.content-height),
                Math.min(0px, -(row * 102px + 2px))
            );
        } else if (row * 102px + 98px > -row-scroll.content-y + row-scroll.height) {
            row-scroll.content-y = Math.max(
                Math.min(0px, row-scroll.height - row-scroll.content-height),
                Math.min(0px, -(row * 102px + 98px - row-scroll.height))
            );
        }
    }

    /// 打开时由宿主调用：焦点落 ✕ 关闭（首个可聚焦控件）。
    public function focus-first-control() {
        missing-sounds-close-focus.focus();
    }

    /// 静态锚点的**唯一**一张表：`0` ✕ / `1` 「先不管」。行槽位（100+）
    /// 不在这里 —— 它们只能由原生 Tab 遍历到达，调这里会被静默忽略
    /// （⛔ 不是漏网：见上面 `focused-control` 的注释）。
    public function focus-control(index: int) {
        if (index == 0) {
            missing-sounds-close-focus.focus();
        } else if (index == 1) {
            missing-sounds-later-focus.focus();
        }
    }
}





