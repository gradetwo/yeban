// 夜半 (Yeban) — 启动工程选择器
//
// 内容与思想学 Logic Pro「Choose a Project」（Wang 2026-11-17 令）：
// 不是直接打开工程时，先让用户选这次要开哪个。布局按夜半自己的
// 设计语言走现有令牌与对话框组件（与模板选择器同款的遮罩 + 面板 +
// 分组列表），⛔ 不照搬 Logic 外观。Logic 侧栏的 Live Loops 一类
// 夜半没有对应机制，按定案不设；其余五类全有：
//
//   0 新建工程（空工程 + Details）   1 最近   2 演示工程
//   3 工程模板（工厂目录）           4 我的模板（用户目录）
//
// ## 显示态全部来自宿主（界面不自己算）
//
// 行模型、Details 初值、调号名都由宿主（`host::wire_startup_chooser`）
// 从 `crate::startup_chooser` 的纯逻辑写入；本文件只做呈现与上抛：
// 分类切换、条目选中 / 双击打开、Details 步进、点按测速。打开语义
// （未命名副本 / 记最近 / 失败不关弹窗）全在宿主，本文件 ⛔ 不碰磁盘。
//
// 默认关着（`MainWindow.startup-chooser-open = false`）⇒ 默认帧与
// 金帧基准一位不变。

import { Tokens, UiText, UiTitleText, StartupChooserRow, ImeAwareTextInput } from "../tokens.slint";

export component StartupChooserDialog inherits Rectangle {
    // ---- 宿主写入的显示态 ------------------------------------------------
    in property <int> category: 0;
    in property <[StartupChooserRow]> rows: [];
    // 被行数上限截断、没有画出来的行数（宿主读数，0 = 全画出来了）。
    in property <int> hidden-rows: 0;
    in property <string> key-label: "—";

    // ---- 双向状态（界面与宿主共享） --------------------------------------
    in-out property <int> selected-entry: -1;
    in-out property <string> tempo-text: "120";
    in-out property <int> time-num: 4;
    in-out property <int> time-den-index: 2;
    in-out property <int> rate-index: 1;

    // ---- 纯界面状态（宿主可预置，如取证帧要展开 Details） ------------------
    in-out property <bool> details-open: false;

    // 唱片架手风琴（纯界面状态）：当前展开详情的演示卡序号与它
    // 长高的量（= 该行的 details-height，由卡片自己的「详情 /
    // 收起」钮在切换时写入，架子层据此重排本行架板与下方专辑）。
    // -1 / 0px = 全收起。同一时刻只许一张卡展开。
    in-out property <int> demo-expanded-index: -1;
    in-out property <length> demo-expanded-extra: 0px;
    // 演示分类视图：0 = 唱片架，1 = 堆叠。只影响演示分类，
    // 其他分类不读此状态。默认堆叠（Wang 2026-11-23 15:11
    // 终定：堆叠留用并作默认，唱片架切换保留）。
    in-out property <int> demo-view: 1;
    // 堆叠模式当前在最前（环位槽 0）的行号；-1 = 默认（最后一张
    // 在最前）。点选不直接改它，而是记目标进 demo-stack-target，
    // 由堆叠内的 Timer 沿环次序逐格步进到目标（循环移位）。
    in-out property <int> demo-stack-top: -1;
    // 堆叠模式的步进目标行号；-1 = 空转无目标（已到位）。
    in-out property <int> demo-stack-target: -1;

    callback category-selected(int);
    callback entry-activated(int);
    callback new-project();
    callback open-existing();
    callback cancel();
    callback tap-tempo();
    callback cycle-key(int);

    // 堆叠模式点选（循环移位）：收起详情、同步选中态，把被点
    // 行记为步进目标；顶层行号先物化（-1 时物化为默认的最后
    // 一行），再由堆叠内的 Timer 逐格把目标转到最前。被点行
    // 已在最前时目标直接清空、不动。
    function stack-bring-to-front(row-index: int, entry-index: int) {
        root.demo-expanded-extra = 0px;
        root.demo-expanded-index = -1;
        root.selected-entry = entry-index;
        if (root.demo-stack-top < 0) {
            root.demo-stack-top = root.rows.length - 1;
        }
        root.demo-stack-target = row-index == root.demo-stack-top ? -1 : row-index;
    }

    background: Tokens.mask-black.with-alpha(0.65);
    clip: true;

    accessible-role: region;
    accessible-id: "startup-chooser-dialog";
    accessible-label: @tr("选择工程");

    // 遮罩吞掉鼠标（与模板选择器同款）：点遮罩不关面板，关面板只有
    // 「取消」/ ✕ / `Esc`（取消 = 退出启动，语义在宿主）。
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // ---------------------------------------------------------------- 弹窗面板
    Rectangle {
        x: (root.width - 880px) / 2;
        y: (root.height - 600px) / 2;
        width: 880px;
        height: 600px;
        background: Tokens.panel-brush;
        border-radius: Tokens.radius-lg;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;

        accessible-role: region;
        accessible-id: "startup-chooser-panel";
        accessible-label: @tr("选择工程面板");

        UiTitleText {
            x: Tokens.space-6;
            y: Tokens.space-4;
            width: parent.width - 96px;
            height: 24px;
            text: @tr("选择工程");
            color: Tokens.ink-0;
            font-size: Tokens.font-size-xl;
        }

        UiText {
            x: Tokens.space-6;
            y: 34px;
            width: parent.width - 96px;
            height: 16px;
            text: @tr("选择要打开的工程，或新建一个。演示与模板以未命名副本打开，不回写原文件。");
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            overflow: elide;
        }

        // 关闭 = 取消启动（退出），与页脚「取消」同一跳。
        Rectangle {
            x: parent.width - 36px;
            y: Tokens.space-4;
            width: 24px;
            height: 24px;
            background: Tokens.bg-lane2;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "startup-chooser-close-button";
            accessible-label: @tr("取消启动");
            accessible-action-default => { root.cancel(); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "×";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xl;
                horizontal-alignment: center;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => { root.cancel(); }
            }
        }

        // ------------------------------------------------------------ 左侧分类导航
        // 五个分类按钮纵排；选中态 = 抬起面 + 金边（与全应用选中口径一致）。
        // 逐个显式写：`accessible-id` 必须是字面量（注册表双向覆盖判据
        // 只认字面量模板），⛔ 不用数据驱动循环生成。
        Rectangle {
            x: Tokens.space-6;
            y: 68px;
            width: 168px;
            height: 40px;
            background: root.category == 0 ? Tokens.accent.mix(Tokens.bg-shell, 0.16) : transparent;
            border-radius: Tokens.radius-md;
            border-width: root.category == 0 ? 1px : 0px;
            border-color: Tokens.line;
            accessible-role: button;
            accessible-id: "startup-nav-new";
            accessible-label: @tr("新建工程");
            accessible-action-default => { root.category-selected(0); }

            UiText {
                x: Tokens.space-5;
                y: 0;
                width: parent.width - 24px;
                height: parent.height;
                text: @tr("新建工程");
                color: root.category == 0 ? Tokens.ink-0 : Tokens.ink-1;
                font-size: Tokens.font-size-md;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => { root.category-selected(0); }
            }
        }

        Rectangle {
            x: Tokens.space-6;
            y: 68px + 44px;
            width: 168px;
            height: 40px;
            background: root.category == 1 ? Tokens.accent.mix(Tokens.bg-shell, 0.16) : transparent;
            border-radius: Tokens.radius-md;
            border-width: root.category == 1 ? 1px : 0px;
            border-color: Tokens.line;
            accessible-role: button;
            accessible-id: "startup-nav-recent";
            accessible-label: @tr("最近打开");
            accessible-action-default => { root.category-selected(1); }

            UiText {
                x: Tokens.space-5;
                y: 0;
                width: parent.width - 24px;
                height: parent.height;
                text: @tr("最近打开");
                color: root.category == 1 ? Tokens.ink-0 : Tokens.ink-1;
                font-size: Tokens.font-size-md;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => { root.category-selected(1); }
            }
        }

        Rectangle {
            x: Tokens.space-6;
            y: 68px + 88px;
            width: 168px;
            height: 40px;
            background: root.category == 2 ? Tokens.accent.mix(Tokens.bg-shell, 0.16) : transparent;
            border-radius: Tokens.radius-md;
            border-width: root.category == 2 ? 1px : 0px;
            border-color: Tokens.line;
            accessible-role: button;
            accessible-id: "startup-nav-demos";
            accessible-label: @tr("演示工程");
            accessible-action-default => { root.category-selected(2); }

            UiText {
                x: Tokens.space-5;
                y: 0;
                width: parent.width - 24px;
                height: parent.height;
                text: @tr("演示工程");
                color: root.category == 2 ? Tokens.ink-0 : Tokens.ink-1;
                font-size: Tokens.font-size-md;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => { root.category-selected(2); }
            }
        }

        Rectangle {
            x: Tokens.space-6;
            y: 68px + 132px;
            width: 168px;
            height: 40px;
            background: root.category == 3 ? Tokens.accent.mix(Tokens.bg-shell, 0.16) : transparent;
            border-radius: Tokens.radius-md;
            border-width: root.category == 3 ? 1px : 0px;
            border-color: Tokens.line;
            accessible-role: button;
            accessible-id: "startup-nav-factory";
            accessible-label: @tr("工程模板");
            accessible-action-default => { root.category-selected(3); }

            UiText {
                x: Tokens.space-5;
                y: 0;
                width: parent.width - 24px;
                height: parent.height;
                text: @tr("工程模板");
                color: root.category == 3 ? Tokens.ink-0 : Tokens.ink-1;
                font-size: Tokens.font-size-md;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => { root.category-selected(3); }
            }
        }

        Rectangle {
            x: Tokens.space-6;
            y: 68px + 176px;
            width: 168px;
            height: 40px;
            background: root.category == 4 ? Tokens.accent.mix(Tokens.bg-shell, 0.16) : transparent;
            border-radius: Tokens.radius-md;
            border-width: root.category == 4 ? 1px : 0px;
            border-color: Tokens.line;
            accessible-role: button;
            accessible-id: "startup-nav-user";
            accessible-label: @tr("我的模板");
            accessible-action-default => { root.category-selected(4); }

            UiText {
                x: Tokens.space-5;
                y: 0;
                width: parent.width - 24px;
                height: parent.height;
                text: @tr("我的模板");
                color: root.category == 4 ? Tokens.ink-0 : Tokens.ink-1;
                font-size: Tokens.font-size-md;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => { root.category-selected(4); }
            }
        }

        // ------------------------------------------------------------ 右侧内容区
        // ---- 新建工程：空工程入口 + Details ----
        if root.category == 0 : Rectangle {
            x: 200px;
            y: 68px;
            width: parent.width - 200px - 24px;
            height: parent.height - 68px - 64px;
            clip: true;

            // 空工程入口卡（双击 = 直接创建；单击只是视觉选中，本分类
            // 只有这一个入口，创建走页脚主按钮 / 双击 / 回车语义）。
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 64px;
                background: Tokens.bg-raised;
                border-radius: Tokens.radius-md;
                border-width: 1px;
                border-color: Tokens.line;
                accessible-role: list-item;
                accessible-id: "startup-empty-project";
                accessible-label: @tr("空工程");
                accessible-action-default => { root.new-project(); }

                UiText {
                    x: Tokens.space-6;
                    y: 10px;
                    width: parent.width - 32px;
                    height: 22px;
                    text: @tr("空工程");
                    color: Tokens.ink-0;
                    font-size: Tokens.font-size-lg;
                }

                UiText {
                    x: Tokens.space-6;
                    y: 36px;
                    width: parent.width - 32px;
                    height: 16px;
                    text: @tr("从空白工程开始（未命名，保存时再选落点）");
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-xs;
                    overflow: elide;
                }

                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    width: parent.width;
                    height: parent.height;
                    double-clicked => { root.new-project(); }
                }
            }

            // Details 展开开关
            Rectangle {
                x: 0;
                y: 76px;
                width: parent.width;
                height: 28px;
                accessible-role: button;
                accessible-id: "startup-details-toggle";
                accessible-label: @tr("详情");
                accessible-action-default => { root.details-open = !root.details-open; }

                UiText {
                    x: 0;
                    y: 0;
                    width: 60px;
                    height: parent.height;
                    text: @tr("详情");
                    color: Tokens.ink-1;
                    font-size: Tokens.font-size-md;
                    vertical-alignment: center;
                }

                // 折叠箭头**画出来**，不指望字体（与 `left_panel.slint` 同一门
                // 手艺）：下/右三角字形在本机 UI 字体里不存在、渲染成残缺像素
                // （2026-11-19 实测）。T-FIX-64 收尾：本处是走查 #字形残留之一。
                Rectangle {
                    x: 44px;
                    y: 0;
                    width: 16px;
                    height: parent.height;

                    Rectangle {
                        x: (parent.width - 7px) / 2;
                        y: (parent.height - 7px) / 2;
                        width: 7px;
                        height: 7px;

                        Path {
                            width: 7px;
                            height: 7px;
                            commands: root.details-open ? "M 0 1.5 L 7 1.5 L 3.5 5.5 Z" : "M 1.5 0 L 5.5 3.5 L 1.5 7 Z";
                            fill: Tokens.ink-2;
                        }
                    }
                }

                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.details-open = !root.details-open; }
                }
            }

            // Details 本体：四个真实字段（速度 / 调号 / 拍号 / 采样率）。
            // 字段集来自工程模型普查 —— 输入/输出设备不在工程模型里，
            // ⛔ 不在这里摆假字段。
            if root.details-open : Rectangle {
                x: 0;
                y: 108px;
                width: parent.width;
                height: 4 * 40px;
                clip: true;

                // —— 速度：文本输入 + 单位 + 点按测速 ——
                UiText {
                    x: 0;
                    y: 0;
                    width: 64px;
                    height: 32px;
                    text: @tr("速度");
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: 64px;
                    y: 2px;
                    width: 76px;
                    height: 28px;
                    background: Tokens.bg-lane2;
                    border-radius: Tokens.radius-sm;
                    border-width: 1px;
                    border-color: Tokens.line;

                    ImeAwareTextInput {
                        x: Tokens.space-3;
                        y: 0;
                        width: parent.width - 12px;
                        height: parent.height;
                        text <=> root.tempo-text;
                        single-line: true;
                        font-family: Tokens.font-ui;
                        color: Tokens.accent;
                        font-size: Tokens.font-size-md;
                        vertical-alignment: center;
                        accessible-role: text-input;
                        accessible-id: "startup-tempo-input";
                        accessible-label: @tr("速度");
                    }
                }

                UiText {
                    x: 146px;
                    y: 0;
                    width: 36px;
                    height: 32px;
                    text: "BPM";
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: 190px;
                    y: 2px;
                    width: 96px;
                    height: 28px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-sm;
                    accessible-role: button;
                    accessible-id: "startup-tap-tempo-button";
                    accessible-label: @tr("点按测速");
                    accessible-action-default => { root.tap-tempo(); }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: @tr("点按测速");
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.tap-tempo(); }
                    }
                }

                // —— 调号：步进（31 档闭集，标签由宿主按语言写） ——
                UiText {
                    x: 0;
                    y: 40px;
                    width: 64px;
                    height: 32px;
                    text: @tr("调号");
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: 64px;
                    y: 42px;
                    width: 28px;
                    height: 28px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-sm;
                    accessible-role: button;
                    accessible-id: "startup-key-prev-button";
                    accessible-label: @tr("调号");
                    accessible-action-default => { root.cycle-key(-1); }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: "‹";
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.cycle-key(-1); }
                    }
                }

                UiText {
                    x: 98px;
                    y: 40px;
                    width: 110px;
                    height: 32px;
                    text: root.key-label;
                    color: Tokens.accent;
                    font-size: Tokens.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    x: 214px;
                    y: 42px;
                    width: 28px;
                    height: 28px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-sm;
                    accessible-role: button;
                    accessible-id: "startup-key-next-button";
                    accessible-label: @tr("调号");
                    accessible-action-default => { root.cycle-key(1); }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: "›";
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.cycle-key(1); }
                    }
                }

                // —— 拍号：分子步进（1..32）/ 分母步进（{1,2,4,8,16,32}） ——
                UiText {
                    x: 0;
                    y: 80px;
                    width: 64px;
                    height: 32px;
                    text: @tr("拍号");
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: 64px;
                    y: 82px;
                    width: 28px;
                    height: 28px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-sm;
                    accessible-role: button;
                    accessible-id: "startup-time-num-prev-button";
                    accessible-label: @tr("拍号");
                    accessible-action-default => { root.time-num = max(1, root.time-num - 1); }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: "‹";
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.time-num = max(1, root.time-num - 1); }
                    }
                }

                UiText {
                    x: 98px;
                    y: 80px;
                    width: 28px;
                    height: 32px;
                    text: root.time-num;
                    color: Tokens.accent;
                    font-size: Tokens.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: 132px;
                    y: 82px;
                    width: 28px;
                    height: 28px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-sm;
                    accessible-role: button;
                    accessible-id: "startup-time-num-next-button";
                    accessible-label: @tr("拍号");
                    accessible-action-default => { root.time-num = min(32, root.time-num + 1); }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: "›";
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.time-num = min(32, root.time-num + 1); }
                    }
                }

                UiText {
                    x: 164px;
                    y: 80px;
                    width: 12px;
                    height: 32px;
                    text: "/";
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: 182px;
                    y: 82px;
                    width: 28px;
                    height: 28px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-sm;
                    accessible-role: button;
                    accessible-id: "startup-time-den-prev-button";
                    accessible-label: @tr("拍号");
                    accessible-action-default => { root.time-den-index = max(0, root.time-den-index - 1); }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: "‹";
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.time-den-index = max(0, root.time-den-index - 1); }
                    }
                }

                UiText {
                    x: 216px;
                    y: 80px;
                    width: 28px;
                    height: 32px;
                    text: ["1", "2", "4", "8", "16", "32"][root.time-den-index];
                    color: Tokens.accent;
                    font-size: Tokens.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: 250px;
                    y: 82px;
                    width: 28px;
                    height: 28px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-sm;
                    accessible-role: button;
                    accessible-id: "startup-time-den-next-button";
                    accessible-label: @tr("拍号");
                    accessible-action-default => { root.time-den-index = min(5, root.time-den-index + 1); }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: "›";
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.time-den-index = min(5, root.time-den-index + 1); }
                    }
                }

                // —— 采样率：五档芯片（模型枚举五档，标签是数值不翻译） ——
                UiText {
                    x: 0;
                    y: 120px;
                    width: 64px;
                    height: 32px;
                    text: @tr("采样率");
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-sm;
                    vertical-alignment: center;
                }

                for rate-label[rate-idx] in ["44.1 kHz", "48 kHz", "88.2 kHz", "96 kHz", "192 kHz"] : Rectangle {
                    x: 64px + rate-idx * 92px;
                    y: 122px;
                    width: 84px;
                    height: 28px;
                    background: root.rate-index == rate-idx ? Tokens.accent.mix(Tokens.bg-lane2, 0.16) : Tokens.bg-lane2;
                    border-radius: Tokens.radius-sm;
                    border-width: root.rate-index == rate-idx ? 1px : 0px;
                    border-color: Tokens.line;
                    accessible-role: button;
                    accessible-id: "startup-rate-chip-" + rate-idx;
                    accessible-label: @tr("采样率");
                    accessible-action-default => { root.rate-index = rate-idx; }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: rate-label;
                        color: root.rate-index == rate-idx ? Tokens.ink-0 : Tokens.ink-1;
                        font-size: Tokens.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.rate-index = rate-idx; }
                    }
                }
            }
        }

        // ---- 列表分类：最近 / 演示 / 工程模板 / 我的模板 ----
        if root.category != 0 : Rectangle {
            x: 200px;
            y: 68px;
            width: parent.width - 200px - 24px;
            height: parent.height - 68px - 64px;
            background: Tokens.bg-lane2;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Tokens.line;
            clip: true;

            accessible-role: list;
            accessible-id: "startup-chooser-list";
            accessible-label: @tr("启动选择器条目列表");

            if root.category != 2 : Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: max(self.height, root.rows.length * 36px);
                interactive: true;

                for row[row-index] in root.rows : Rectangle {
                    x: 0;
                    y: row-index * 36px;
                    width: parent.width;
                    height: 36px;
                    clip: true;

                    // 条目行（kind == 2）：可点；单击选中、双击打开。
                    // 无障碍默认动作与单击同一落点（选中）——打开走双击
                    // 或页脚「打开」主按钮（选中后可用），三条路不分叉。
                    if row.kind == 2 && row.enabled : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: root.selected-entry == row.entry-index ? Tokens.bg-raised
                            : row-touch.has-hover ? Tokens.bg-panel-alt : transparent;
                        accessible-role: list-item;
                        accessible-id: "startup-row-" + row-index;
                        accessible-label: row.label;
                        accessible-action-default => {
                            root.selected-entry = row.entry-index;
                        }

                        // 封面图（文件型 demo 实验）：装饰元素，不设
                        // accessible-id。圆角靠外层 Rectangle 的
                        // border-radius + clip 裁切（Image 本身不裁圆角）。
                        if row.has-cover : Rectangle {
                            x: 6px;
                            y: 6px;
                            width: 24px;
                            height: 24px;
                            border-radius: Tokens.radius-md;
                            clip: true;

                            Image {
                                width: 24px;
                                height: 24px;
                                source: row.cover;
                                image-fit: cover;
                            }
                        }

                        UiText {
                            x: row.has-cover ? 38px : Tokens.space-6;
                            y: 1px;
                            width: parent.width - (row.has-cover ? 54px : 32px);
                            height: 19px;
                            text: row.label;
                            color: Tokens.ink-1;
                            font-size: Tokens.font-size-sm;
                            overflow: elide;
                        }

                        UiText {
                            x: row.has-cover ? 38px : Tokens.space-6;
                            y: 20px;
                            width: parent.width - (row.has-cover ? 54px : 32px);
                            height: 14px;
                            text: row.detail;
                            color: Tokens.ink-2;
                            font-size: Tokens.font-size-xs;
                            overflow: elide;
                        }

                        row-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.selected-entry = row.entry-index; }
                            double-clicked => { root.entry-activated(row.entry-index); }
                        }
                    }

                    // 失效条目（kind == 2 && !enabled）：置灰、不可点
                    //（最近清单里文件已不存在的工程；副文字已由宿主
                    // 写明「文件已不存在」）。
                    if row.kind == 2 && !row.enabled : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        accessible-role: list-item;
                        accessible-id: "startup-row-" + row-index;
                        accessible-label: row.label;

                        UiText {
                            x: Tokens.space-6;
                            y: 1px;
                            width: parent.width - 32px;
                            height: 19px;
                            text: row.label;
                            color: Tokens.ink-2;
                            font-size: Tokens.font-size-sm;
                            overflow: elide;
                        }

                        UiText {
                            x: Tokens.space-6;
                            y: 20px;
                            width: parent.width - 32px;
                            height: 14px;
                            text: row.detail;
                            color: Tokens.ink-2;
                            font-size: Tokens.font-size-xs;
                            overflow: elide;
                        }
                    }

                    // 分组标题行（kind 0 = 曲风、1 = 子曲风）：只读。
                    if row.kind != 2 : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        accessible-role: text;
                        accessible-id: "startup-row-" + row-index;
                        accessible-label: row.label;

                        UiText {
                            x: row.kind == 0 ? Tokens.space-4 : Tokens.space-6 + 24px;
                            y: 0;
                            width: parent.width - 72px;
                            height: parent.height;
                            text: row.label;
                            color: row.kind == 0 ? Tokens.ink-0 : Tokens.ink-1;
                            font-size: row.kind == 0 ? Tokens.font-size-sm : Tokens.font-size-xs;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            // ---- 演示分类：唱片架平铺（实验改版，Wang 2026-11-23 定）----
            // 每条 demo 是一张专辑卡：大封面在上（248×248），标题 /
            // 曲风 / 弱化 BPM 在封面下方；每行卡片下方横贯一条架
            // 板带，专辑之间分隔明显、一眼数得清。专辑页字段
            // （作者 / 曲风 / 发布日期 / 时长 / 小节数 / 轨道数 /
            // 简介 / 制作名单 / 版权声明 / 许可协议 / 作者网站）
            // 只从卡片右下角的「详情」入口在**原地折叠展开**：
            // 详情区长在同一张卡内部、既有文字块下方，是带标签
            // 的行列（标签弱化、值正常字号，有数据才出现该行）；
            // 卡片随展开行数长高、本行架板与下方专辑顺势下移；
            // ⛔ 不用盖住原卡的浮层（Wang 2026-11-23 亲验否决），
            // ⛔ 不上主面。手风琴口径：展开状态只存根上的
            // demo-expanded-index 一处，同一时刻只许一张卡展开。
            // 演示分类视图切换（分段小控件）：只在演示分类
            // 出现，只切换演示分类的呈现，默认堆叠。堆叠一侧
            // 只画图标、不显示「堆叠」二字（Wang 2026-11-23
            // 15:12 补定）；唱片架一侧文字保留。
            if root.category == 2 : Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 36px;

                Rectangle {
                    x: 12px;
                    y: 6px;
                    width: 132px;
                    height: 24px;
                    background: Tokens.bg-panel;
                    border-radius: Tokens.radius-sm;
                    border-width: 1px;
                    border-color: Tokens.line;

                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: 63px;
                        height: 20px;
                        background: root.demo-view == 0 ? Tokens.bg-raised : transparent;
                        border-radius: Tokens.radius-sm;
                        accessible-role: button;
                        accessible-label: @tr("唱片架");
                        accessible-id: "startup-demo-view-shelf";
                        accessible-action-default => {
                            root.demo-view = 0;
                        }

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: @tr("唱片架");
                            color: root.demo-view == 0 ? Tokens.ink-0 : Tokens.ink-2;
                            font-size: Tokens.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.demo-view = 0;
                            }
                        }
                    }

                    Rectangle {
                        x: 67px;
                        y: 2px;
                        width: 63px;
                        height: 20px;
                        background: root.demo-view == 1 ? Tokens.bg-raised : transparent;
                        border-radius: Tokens.radius-sm;
                        accessible-role: button;
                        // 图标-only 段（Wang 2026-11-23 15:12：
                        // 界面不显示「堆叠」二字）。accessible-label
                        // 是读屏器的控件名、不是界面显示文字，图标
                        // 按钮必须留名，故保留。
                        accessible-label: @tr("堆叠");
                        accessible-id: "startup-demo-view-stack";
                        accessible-action-default => {
                            root.demo-view = 1;
                        }
                        property <color> glyph-color: root.demo-view == 1 ? Tokens.ink-0 : Tokens.ink-2;

                        // 堆叠字形：三张错落叠放的卡片（后卡只描
                        // 边、中卡垫底色遮住后卡边线、前卡实填），
                        // 居中于与文字段等宽的 63px 段内。
                        Rectangle {
                            x: (parent.width - 20px) / 2;
                            y: 2px;
                            width: 20px;
                            height: 16px;

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 13px;
                                height: 11px;
                                border-width: 1px;
                                border-color: glyph-color;
                                border-radius: 2px;
                            }

                            Rectangle {
                                x: 3.5px;
                                y: 2.5px;
                                width: 13px;
                                height: 11px;
                                background: root.demo-view == 1 ? Tokens.bg-raised : Tokens.bg-panel;
                                border-width: 1px;
                                border-color: glyph-color;
                                border-radius: 2px;
                            }

                            Rectangle {
                                x: 7px;
                                y: 5px;
                                width: 13px;
                                height: 11px;
                                background: glyph-color;
                                border-width: 1px;
                                border-color: glyph-color;
                                border-radius: 2px;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.demo-view = 1;
                            }
                        }
                    }
                }
            }

            // 演示分类的行恒为条目行（kind == 2），无分组标题行。
            if root.category == 2 && root.demo-view == 0 : demo-shelf := Flickable {
                x: 0;
                y: 36px;
                width: parent.width;
                height: parent.height - 36px;
                property <int> cols: max(1, Math.floor((self.width - 20px) / 300px));
                property <int> grid-rows: max(1, Math.floor((root.rows.length + self.cols - 1) / self.cols));
                // 展开卡所在的行（展开状态存根上的
                // demo-expanded-index；无展开时为 -1，下移条件都
                // 另带 demo-expanded-index >= 0 守卫，不靠 -1 恒假）。
                property <int> expanded-row: root.demo-expanded-index < 0 ? -1 : Math.floor(root.demo-expanded-index / self.cols);
                content-width: self.width;
                content-height: max(self.height, self.grid-rows * 398px + 16px + (root.demo-expanded-index >= 0 ? root.demo-expanded-extra : 0px));
                interactive: true;

                // 架板带：每行一条，横贯整行，像唱片架的隔板；
                // 展开行及其下方的架板随展开量下移。
                for gr in demo-shelf.grid-rows : Rectangle {
                    x: 12px;
                    y: 380px + gr * 398px + (root.demo-expanded-index >= 0 && demo-shelf.expanded-row <= gr ? root.demo-expanded-extra : 0px);
                    width: parent.width - 24px;
                    height: 12px;
                    background: Tokens.bg-panel-alt;
                    border-radius: Tokens.radius-sm;
                }

                for row[row-index] in root.rows : card := Rectangle {
                    // 本卡是否展开（与根上 demo-expanded-index 对读）。
                    property <bool> expanded: root.demo-expanded-index == row-index;
                    x: 24px + Math.mod(row-index, demo-shelf.cols) * 300px;
                    y: 20px + Math.floor(row-index / demo-shelf.cols) * 398px + (root.demo-expanded-index >= 0 && demo-shelf.expanded-row < Math.floor(row-index / demo-shelf.cols) ? root.demo-expanded-extra : 0px);
                    width: 272px;
                    height: 350px + (self.expanded ? row.details-height : 0px);
                    background: root.selected-entry == row.entry-index ? Tokens.bg-raised
                        : card-touch.has-hover ? Tokens.bg-panel-alt : Tokens.bg-panel;
                    border-radius: Tokens.radius-lg;
                    border-width: root.selected-entry == row.entry-index ? 2px : 1px;
                    border-color: root.selected-entry == row.entry-index ? Tokens.accent : Tokens.line;
                    clip: true;
                    accessible-role: list-item;
                    accessible-id: "startup-row-" + row-index;
                    accessible-label: row.label;
                    accessible-action-default => { root.selected-entry = row.entry-index; }

                    // 整卡点击层声明在最前：其后声明的「详情 / 收起」
                    // 按钮的 TouchArea 叠在它上面、优先吃点击；
                    // 文字与封面不吃事件，点击落到这一层 = 选中，
                    // 双击 = 打开（与列表行同一套语义）。
                    card-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.selected-entry = row.entry-index; }
                        double-clicked => { root.entry-activated(row.entry-index); }
                    }

                    // 大封面（真实加载的同名图，方形 cover 裁切不变形）。
                    if row.has-cover : Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 248px;
                        height: 248px;
                        border-radius: Tokens.radius-md;
                        clip: true;

                        Image {
                            width: 248px;
                            height: 248px;
                            source: row.cover;
                            image-fit: cover;
                        }
                    }

                    // 无封面（内置 demo）：CD 盘面占位，不编造封面图。
                    if !row.has-cover : Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 248px;
                        height: 248px;
                        background: Tokens.bg-panel-alt;
                        border-radius: Tokens.radius-md;

                        Rectangle {
                            x: 49px;
                            y: 49px;
                            width: 150px;
                            height: 150px;
                            border-radius: 75px;
                            background: Tokens.bg-raised;
                            border-width: 1px;
                            border-color: Tokens.line-strong;
                        }

                        Rectangle {
                            x: 107px;
                            y: 107px;
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: Tokens.bg-panel-alt;
                            border-width: 1px;
                            border-color: Tokens.line-strong;
                        }
                    }

                    // 标题（最大）—— 封面下方，⛔ 不压图。
                    UiText {
                        x: 12px;
                        y: 270px;
                        width: 248px;
                        height: 26px;
                        text: row.label;
                        color: Tokens.ink-0;
                        font-size: Tokens.font-size-xl;
                        overflow: elide;
                    }

                    // 曲风 / 风格（一行，正常字号；无曲风时留空占位，
                    // 保卡片对齐）。
                    UiText {
                        x: 12px;
                        y: 300px;
                        width: 248px;
                        height: 20px;
                        text: row.genre;
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-md;
                        overflow: elide;
                    }

                    // BPM（小字弱化，最多这一项技术信息）。
                    UiText {
                        x: 12px;
                        y: 324px;
                        width: 120px;
                        height: 18px;
                        text: row.bpm-label;
                        color: Tokens.ink-2;
                        font-size: Tokens.font-size-sm;
                        overflow: elide;
                    }

                    // 「详情 / 收起」小入口：点击在原地展开 / 收起
                    // 下方详情区（卡片按该行 details-height 长高 /
                    // 复原）；展开状态写根上的 demo-expanded-*，
                    // 展开另一张卡时当前张自动收起（手风琴）。
                    Rectangle {
                        x: 208px;
                        y: 318px;
                        width: 52px;
                        height: 24px;
                        background: Tokens.bg-panel-alt;
                        border-radius: Tokens.radius-sm;
                        accessible-role: button;
                        accessible-id: "startup-row-details-" + row-index;
                        accessible-label: card.expanded ? @tr("收起") : @tr("详情");
                        accessible-action-default => {
                            // ⚠ 顺序要紧：先写 extra 再写 index。
                            // index 一变 card.expanded 绑定立刻翻转，
                            // 第二行读到的就是新值、会把 extra 写反。
                            root.demo-expanded-extra = card.expanded ? 0px : row.details-height;
                            root.demo-expanded-index = card.expanded ? -1 : row-index;
                        }

                        UiText {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: card.expanded ? @tr("收起") : @tr("详情");
                            color: Tokens.ink-1;
                            font-size: Tokens.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            width: parent.width;
                            height: parent.height;
                            clicked => {
                                // 顺序同 accessible-action-default：
                                // 先 extra 后 index，防 expanded 翻转读反。
                                root.demo-expanded-extra = card.expanded ? 0px : row.details-height;
                                root.demo-expanded-index = card.expanded ? -1 : row-index;
                            }
                        }
                    }

                    // 详情展开区（原地折叠展开）：长在同一张卡内部、
                    // 既有文字块（标题 / 曲风 / BPM 行）下方，卡片
                    // 高度已由 expanded 绑定按 details-height 长高；
                    // 封面与文字块全程可见、不被覆盖。内容是带标签
                    // 的专辑页行列：标签弱化、值正常字号；行高与
                    // 间距常数与宿主 detail_rows_height_px 对账
                    // （分界线 1 + 间距 4 + 行 18/行 + 底部 10）。
                    if card.expanded : Rectangle {
                        x: 12px;
                        y: 350px;
                        width: 248px;
                        height: row.details-height;
                        accessible-role: text;
                        accessible-id: "startup-row-details-panel-" + row-index;
                        accessible-label: row.details;

                        VerticalLayout {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            spacing: 4px;

                            // 与上方文字块之间的一条分界线，标明展开
                            // 区是这张卡自己的下半截，不是另一张卡。
                            Rectangle {
                                height: 1px;
                                background: Tokens.line;
                            }

                            for dr in row.detail-rows : HorizontalLayout {
                                spacing: 8px;

                                UiText {
                                    width: 72px;
                                    text: dr.label;
                                    color: Tokens.ink-2;
                                    font-size: Tokens.font-size-sm;
                                    overflow: elide;
                                }

                                UiText {
                                    horizontal-stretch: 1;
                                    text: dr.value;
                                    color: Tokens.ink-0;
                                    font-size: Tokens.font-size-md;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // 堆叠模式（第二版，Wang 2026-11-23 反馈后重做）：全部
            // 封面沿一条椭圆环轨松散地散开成一摞，与唱片架并存、
            // 由上方分段控件切换，只影响演示分类。第一版是等距
            // 对角错层加 -6..+6 度小倾斜，Wang 评「太规整」；本
            // 版照 Wang 给的参考图：封面大、重叠深、每张角度明显
            // 且互不相同，绕一个中心不对齐、不等距地散开，不规
            // 整才有美感。
            //
            // 环位（槽位 slot = (行号 - 顶层行号) 模行数，纯序号
            // 函数，不随机、同输入同输出、可测试）：槽 0 = 最
            // 前，落在环心正下方略偏右、角度回正（-2 度）、完整
            // 显示且最大（256）；其余槽沿椭圆上半弧按序展开，
            // 极角 theta 自 -spread-l 至 +spread-r 按槽序等分
            // （左右不对称：3 张以内 76 / 62 度，张数更多时
            // 118 / 104 度），半径带 slot 派生的确定性抖动
            // （±9%），每槽尺寸也各不相同（243..258），重叠明
            // 显深于第一版。旋转角随 theta 走（0.13 倍）再加
            // slot 抖动，钳在 -12..+12 度。坐标最后钳进舞台：
            // 行数变化只改 spread 与等分，整摞不溢出；无封面
            // 占位块同样入环。
            //
            // ⚠ 倾斜的可见性边界（实测，2026-11-23）：Slint 的
            // 软件渲染器不实现 rotate（i-slint-renderer-software
            // 1.18 lib.rs 的 fn rotate 是空实现、注 TODO
            // #6068），Transform 元素的 bounding_rect 也不含旋
            // 转——所以无头截图与控件树包围盒里**看不到倾斜**，
            // 只有位置与尺寸差异可见；生产端 GPU 渲染器
            // （femtovg / skia）的 rotate 是真实现的，倾斜在真
            // 机上生效。判据因此只钉位置 / 尺寸 / 步进，倾斜角
            // 的正确性由公式与真机目视担保，⛔ 不许拿无头截图
            // 声称「倾斜已验」。
            //
            // 切换 = 循环移位（转盘式）：点任意露出的封面不直
            // 接换位，而是把目标记进 demo-stack-target，下方
            // Timer 每 210ms 让顶层沿环次序前进一格，每格全部
            // 封面同时 animate 到相邻槽位（x / y /
            // transform-rotation 各 200ms），直到被点封面转到
            // 最前。选中态在点击时即写 selected-entry（与架子
            // 同一口径），信息块只跟顶层走、逐格换人；双击 =
            // 打开，语义不变。切回架子再切回来，top / target
            // 都留在根上，步进会自己走完，状态 sane。
            //
            // 注：Slint 的 Math.sin / Math.cos 入参是 angle 型
            // （写 theta * 1deg；内建实现再转弧度求值，
            // i-slint-compiler 1.18 generator/rust.rs 实证），
            // 别传裸 float、也别按弧度传。
            if root.category == 2 && root.demo-view == 1 : demo-stack := Flickable {
                x: 0;
                y: 36px;
                width: parent.width;
                height: parent.height - 36px;
                property <int> count: root.rows.length;
                property <length> cx: self.width / 2;
                property <length> ring-rx: min(150px, max(0px, (self.width - 320px) / 2));
                property <length> ring-ry: 56px;
                property <length> ring-cy: 182px;
                property <float> ring-spread-l: self.count <= 3 ? 76.0 : 118.0;
                property <float> ring-spread-r: self.count <= 3 ? 62.0 : 104.0;
                property <length> stage-h: 368px;
                property <int> top: self.count == 0 ? -1 : (root.demo-stack-top >= 0 ? min(root.demo-stack-top, self.count - 1) : self.count - 1);
                content-width: self.width;
                content-height: max(self.height, self.stage-h + 104px + (root.demo-expanded-index == self.top ? root.demo-expanded-extra : 0px));
                interactive: true;

                // 转盘步进：目标行未到最前就每 210ms 前进一格，
                // 到位即清目标停转。target 越界（行数变少）时
                // running 恒假，不会空转。
                Timer {
                    interval: 210ms;
                    running: root.demo-stack-target >= 0 && root.demo-stack-target < demo-stack.count && demo-stack.count > 1 && root.demo-stack-target != demo-stack.top;
                    triggered => {
                        root.demo-stack-top = Math.mod(demo-stack.top + 1, demo-stack.count);
                        if (root.demo-stack-top == root.demo-stack-target) {
                            root.demo-stack-target = -1;
                        }
                    }
                }

                for row[row-index] in root.rows : Rectangle {
                    property <int> slot: demo-stack.count > 0 ? Math.mod(row-index - demo-stack.top + demo-stack.count, demo-stack.count) : 0;
                    property <float> frac: demo-stack.count > 2 ? (self.slot - 1) * 1.0 / (demo-stack.count - 2) : 0.5;
                    property <float> theta: self.slot == 0 ? 0.0 : -demo-stack.ring-spread-l + self.frac * (demo-stack.ring-spread-l + demo-stack.ring-spread-r);
                    property <float> rf: 1.0 + (Math.mod(self.slot * 37, 5) - 2) * 0.045;
                    property <length> size: self.slot == 0 ? 256px : 248px + (Math.mod(self.slot * 41, 5) - 2) * 5px;
                    property <length> dx: self.slot == 0 ? 8px : demo-stack.ring-rx * self.rf * Math.sin(self.theta * 1deg);
                    property <length> dy: self.slot == 0 ? 30px : -demo-stack.ring-ry * self.rf * Math.cos(self.theta * 1deg);
                    property <float> rot-deg: self.slot == 0 ? -2.0 : max(-12.0, min(12.0, self.theta * 0.13 + (Math.mod(self.slot * 31, 7) - 3) * 1.2));
                    x: max(8px, min(demo-stack.width - self.size - 8px, demo-stack.cx + self.dx - self.size / 2));
                    y: max(6px, min(demo-stack.stage-h - self.size - 6px, demo-stack.ring-cy + self.dy - self.size / 2));
                    width: self.size;
                    height: self.size;
                    z: self.slot == 0 ? 100 : 40 - self.slot;
                    transform-rotation: self.rot-deg * 1deg;
                    animate x { duration: 200ms; easing: ease-in-out; }
                    animate y { duration: 200ms; easing: ease-in-out; }
                    animate transform-rotation { duration: 200ms; easing: ease-in-out; }
                    accessible-role: list-item;
                    accessible-label: row.label;
                    accessible-id: "startup-row-" + row-index;
                    accessible-action-default => {
                        root.stack-bring-to-front(row-index, row.entry-index);
                    }

                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: Tokens.bg-panel;
                        border-radius: Tokens.radius-md;
                        border-width: 1px;
                        border-color: Tokens.line;
                        clip: true;

                        if row.has-cover : Image {
                            width: parent.width;
                            height: parent.height;
                            source: row.cover;
                            image-fit: cover;
                        }

                        // 无封面（内置 demo）：CD 盘面占位块同样入摞。
                        if !row.has-cover : Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: Tokens.bg-panel-alt;

                            Rectangle {
                                x: (parent.width - 150px) / 2;
                                y: (parent.height - 150px) / 2;
                                width: 150px;
                                height: 150px;
                                border-radius: 75px;
                                background: Tokens.bg-raised;
                                border-width: 1px;
                                border-color: Tokens.line-strong;
                            }

                            Rectangle {
                                x: (parent.width - 34px) / 2;
                                y: (parent.height - 34px) / 2;
                                width: 34px;
                                height: 34px;
                                border-radius: 17px;
                                background: Tokens.bg-panel-alt;
                                border-width: 1px;
                                border-color: Tokens.line-strong;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.stack-bring-to-front(row-index, row.entry-index);
                        }
                        double-clicked => {
                            root.entry-activated(row.entry-index);
                        }
                    }
                }

                // 选中（顶层）专辑的信息块：repeater 体即信息块
                // 本体，非顶层 visible:false（不渲染、不进无障碍
                // 树）；位于堆叠区下方，不压图。内容与架子卡
                // 文字块同构：标题 / 曲风 / BPM 小字 / 详情入口。
                // （先前用「高 0 锚点 + if 内嵌」时信息块落点比
                // 声明 y 高 44px、压住顶层封面底边，故改直挂。）
                for row[row-index] in root.rows : info := Rectangle {
                    property <bool> expanded: root.demo-expanded-index == row-index;
                    x: max(0px, demo-stack.cx - 136px);
                    y: demo-stack.stage-h + 8px;
                    width: 272px;
                    height: 88px + (self.expanded ? row.details-height : 0px);
                    visible: row-index == demo-stack.top;
                    accessible-role: text;
                    accessible-label: row.label;
                    accessible-id: "startup-stack-info-" + row-index;

                        UiText {
                            x: 12px;
                            y: 2px;
                            width: 248px;
                            height: 26px;
                            text: row.label;
                            color: Tokens.ink-0;
                            font-size: Tokens.font-size-xl;
                            overflow: elide;
                        }

                        UiText {
                            x: 12px;
                            y: 32px;
                            width: 248px;
                            height: 20px;
                            text: row.genre;
                            color: Tokens.ink-1;
                            font-size: Tokens.font-size-md;
                            overflow: elide;
                        }

                        UiText {
                            x: 12px;
                            y: 58px;
                            width: 120px;
                            height: 18px;
                            text: row.bpm-label;
                            color: Tokens.ink-2;
                            font-size: Tokens.font-size-sm;
                            overflow: elide;
                        }

                        Rectangle {
                            x: 208px;
                            y: 52px;
                            width: 52px;
                            height: 24px;
                            background: Tokens.bg-panel-alt;
                            border-radius: Tokens.radius-sm;
                            accessible-role: button;
                            accessible-id: "startup-row-details-" + row-index;
                            accessible-label: info.expanded ? @tr("收起") : @tr("详情");
                            accessible-action-default => {
                                // 顺序同架子卡：先 extra 后 index。
                                root.demo-expanded-extra = info.expanded ? 0px : row.details-height;
                                root.demo-expanded-index = info.expanded ? -1 : row-index;
                            }

                            UiText {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                text: info.expanded ? @tr("收起") : @tr("详情");
                                color: Tokens.ink-1;
                                font-size: Tokens.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.demo-expanded-extra = info.expanded ? 0px : row.details-height;
                                    root.demo-expanded-index = info.expanded ? -1 : row-index;
                                }
                            }
                        }

                        // 详情展开区：信息块下方原地展开，字段行
                        // 与架子卡完全一致（宿主 details-height
                        // 同一估算）。
                        if info.expanded : Rectangle {
                            x: 12px;
                            y: 88px;
                            width: 248px;
                            height: row.details-height;
                            accessible-role: text;
                            accessible-id: "startup-row-details-panel-" + row-index;
                            accessible-label: row.details;

                            VerticalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                spacing: 4px;

                                Rectangle {
                                    height: 1px;
                                    background: Tokens.line;
                                }

                                for dr in row.detail-rows : HorizontalLayout {
                                    spacing: 8px;

                                    UiText {
                                        width: 72px;
                                        text: dr.label;
                                        color: Tokens.ink-2;
                                        font-size: Tokens.font-size-sm;
                                        overflow: elide;
                                    }

                                    UiText {
                                        horizontal-stretch: 1;
                                        text: dr.value;
                                        color: Tokens.ink-0;
                                        font-size: Tokens.font-size-md;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
            }

            // 空态（分类专属文案；演示分类恒有两条、不会落到这里）
            if root.rows.length == 0 : Rectangle {
                x: Tokens.space-6;
                y: 120px;
                width: parent.width - 48px;
                height: 40px;
                clip: true;

                accessible-role: text;
                accessible-id: "startup-chooser-empty-state";
                accessible-label: root.category == 1 ? @tr("还没有最近打开的工程。") : @tr("此目录中还没有模板。");

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: root.category == 1 ? @tr("还没有最近打开的工程。") : @tr("此目录中还没有模板。");
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-sm;
                    overflow: elide;
                }
            }

            // 截断的如实报数
            if root.hidden-rows > 0 : Rectangle {
                x: Tokens.space-6;
                y: parent.height - 24px;
                width: parent.width - 48px;
                height: 16px;
                clip: true;

                accessible-role: text;
                accessible-id: "startup-chooser-truncation-note";
                accessible-label: @tr("还有更多行未画出");

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: @tr("还有 {} 行未画出（列表一次最多画 64 行）", root.hidden-rows);
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-xs;
                    overflow: elide;
                }
            }
        }

        // ------------------------------------------------------------ 页脚
        Rectangle {
            x: Tokens.space-6;
            y: parent.height - 52px;
            width: 168px;
            height: 36px;
            background: Tokens.bg-raised;
            border-radius: Tokens.radius-md;
            accessible-role: button;
            accessible-id: "startup-open-existing-button";
            accessible-label: @tr("打开已有工程…");
            accessible-action-default => { root.open-existing(); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: @tr("打开已有工程…");
                color: Tokens.ink-1;
                font-size: Tokens.font-size-md;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => { root.open-existing(); }
            }
        }

        Rectangle {
            x: parent.width - 24px - 96px - 12px - 132px;
            y: parent.height - 52px;
            width: 96px;
            height: 36px;
            background: Tokens.bg-raised;
            border-radius: Tokens.radius-md;
            accessible-role: button;
            accessible-id: "startup-cancel-button";
            accessible-label: @tr("取消");
            accessible-action-default => { root.cancel(); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: @tr("取消");
                color: Tokens.ink-1;
                font-size: Tokens.font-size-md;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => { root.cancel(); }
            }
        }

        // 主操作：新建分类 = 创建新工程；列表分类 = 打开选中条目
        //（未选中时置灰不可点）。
        Rectangle {
            x: parent.width - 24px - 132px;
            y: parent.height - 52px;
            width: 132px;
            height: 36px;
            // 主操作用实心 accent（与主界面 transport 的"主按钮"同一套），
            // 取消保持中性面 —— 一眼能分出"确认"和"退出"。
            background: Tokens.accent;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Tokens.accent;
            // 不可点时压到 45%：CTA 是实心 accent，必须留一个"灰掉"的明确信号。
            opacity: root.category == 0 || root.selected-entry >= 0 ? 1.0 : 0.45;
            accessible-role: button;
            accessible-id: "startup-confirm-button";
            accessible-label: root.category == 0 ? @tr("创建新工程") : @tr("打开");
            accessible-action-default => {
                if (root.category == 0) { root.new-project(); }
                else if (root.selected-entry >= 0) { root.entry-activated(root.selected-entry); }
            }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.category == 0 ? @tr("创建新工程") : @tr("打开");
                color: Tokens.ink-0;
                font-size: Tokens.font-size-md;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => {
                    if (root.category == 0) { root.new-project(); }
                    else if (root.selected-entry >= 0) { root.entry-activated(root.selected-entry); }
                }
            }
        }
    }
}
