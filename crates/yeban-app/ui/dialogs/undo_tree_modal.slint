// 夜半 (Yeban) — 全屏可视化 DAG 编曲时光机弹窗 (Undo Tree Modal)
//
// 规范来源 (Normative):
//   - 规范 §10: 编曲时光机 (Arrangement Time Machine) —— 全屏可视化 DAG 版本图谱
//   - [UI-A11Y-001] §7.1: `Cmd/Ctrl + Shift + H` 呼出
//   - [UI-A11Y-003] §7.3: 模态对话框要实现**焦点闭环 (Focus Trap)**, 关闭时焦点复位到
//     触发控件 —— 本骨架**没有**实现焦点闭环 (见 notes 的 pending: 需要 `FocusScope` +
//     宿主侧焦点保存/恢复, 依赖 Slint 焦点 API 的进一步核验)
//   - [UI-TEST-001] §12.2: 语义 Element ID (`undo-tree-node-{i}` / `undo-tree-undo-button`)
//   - ADR-0001 **D45**: 弹窗里的动作**真的执行撤销** —— 走 `crate::undo_session`
//     （与 MCP 的 `yeban_undo` 是**同一份实现**），不再是一个只会打 stderr 的回调。
//
// ## 显示态全部来自**模型读数**（不是界面自己算的）
//
// `can-undo` / `undo-depth` / `undone-depth` / `commit-count` / `branch-name` 由宿主
// `host::apply_undo` 从 `undo_session::UndoDisplay`（`CommitGraph` + `UndoCursor` 的读数）
// 写入。界面**不推断**"能不能撤销"，也不知道撤销栈有多深 —— 它只显示。
//
// ## 仍然是骨架的部分（如实登记，不假装）
//
// 6 个节点的 **DAG 图形**仍是硬编码示意（真实的版本树画法要等匿名分支的可视化；
// 见 notes 的未实现项）。真正接线的是：
//   * "撤销一步"按钮 → `undo-step` → 宿主 → `UndoCursor` 真的前移（判据断言工程真的回退）；
//   * 顶部状态行 → 模型读数（可撤销 N 步 / 活跃分支）。

import { Tokens, UiText, UiMonoText } from "../tokens.slint";

export component UndoTreeModal inherits Rectangle {
    in property <int> node-count: 6;
    in property <[string]> node-labels: ["c0 初始", "c1 鼓组", "c2 贝斯", "c3 铺底", "c4 主音", "c5 AI 提案"];

    // ---- 模型读数（宿主注入；界面不自己算）------------------------------------
    in property <bool> can-undo: false;
    in property <int> undo-depth: 0;
    in property <int> undone-depth: 0;
    in property <int> commit-count: 0;
    in property <string> branch-name: "main";

    callback close();
    // D45: 这个回调**真的**执行撤销（宿主 → `UndoPort::perform(UiAction::Undo)`）。
    callback undo-step();

    // 遮罩层色 —— [UI-MCP-002] 里被"置黑"的正是这个颜色, 两者同源。
    background: Tokens.mask-black.with-alpha(0.65);
    clip: true;

    accessible-role: region;
    accessible-id: "undo-tree-modal";
    accessible-label: "编曲版本时光机图谱";

    // ---------------------------------------------------------------- 弹窗面板
    Rectangle {
        x: (root.width - 720px) / 2;
        y: (root.height - 360px) / 2;
        width: 720px;
        height: 360px;
        background: Tokens.bg-panel;
        border-radius: Tokens.radius-lg;
        border-width: 1px;
        border-color: Tokens.gold-deep;
        clip: true;

        accessible-role: region;
        accessible-id: "undo-tree-panel";
        accessible-label: "版本图谱面板";

        UiText {
            x: Tokens.space-6;
            y: Tokens.space-4;
            width: parent.width - 96px;
            height: 24px;
            text: "编曲时光机 · 版本 DAG";
            color: Tokens.gold-bright;
            font-size: Tokens.font-size-xl;
        }

        // 状态行: **模型读数**（活跃分支 / 可撤销步数 / 已撤销步数）。
        UiMonoText {
            x: Tokens.space-6;
            y: 34px;
            width: parent.width - 96px;
            height: 16px;
            text: "分支 " + root.branch-name + " · 可撤销 " + root.undo-depth + " 步 · 已撤销 "
                + root.undone-depth + " 步 · 提交 " + root.commit-count + " 条";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }

        // 关闭 (§7.3 要求的焦点复位未实现 —— 见文件头)
        Rectangle {
            x: parent.width - 36px;
            y: Tokens.space-4;
            width: 24px;
            height: 24px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "undo-tree-close-button";
            accessible-label: "关闭时光机";

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "×";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xl;
                horizontal-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.close(); }
            }
        }

        // ------------------------------------------------------------ DAG 节点
        for node_index in 6 : Rectangle {
            x: Tokens.space-6 + 108px * node_index;
            y: 100px + 44px * node_index.mod(2);
            width: 100px;
            height: 40px;
            background: node_index == 0 ? Tokens.bg-raised : Tokens.bg-panel-alt;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: node_index == 0 ? Tokens.gold : Tokens.line-strong;
            clip: true;
            accessible-role: list-item;
            accessible-id: "undo-tree-node-" + node_index;
            accessible-label: root.node-labels[node_index];
            accessible-item-index: node_index;
            accessible-item-count: 6;
            accessible-item-selectable: true;
            accessible-item-selected: node_index == 0;

            UiText {
                x: Tokens.space-2;
                y: 0;
                width: parent.width - 4px;
                height: parent.height;
                text: root.node_labels[node_index];
                color: node_index == 0 ? Tokens.gold-bright : Tokens.ink-1;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // 节点之间的边 (DAG 的 E 只用直线段示意; 真实分叉/合并要等 Ops Log 图谱)
        for edge_index in 5 : Rectangle {
            x: Tokens.space-6 + 100px + 108px * edge_index;
            y: 118px + 44px * edge_index.mod(2);
            width: 8px;
            height: 2px;
            background: Tokens.line-strong;
        }

        // ------------------------------------------------------- 撤销一步（D45）
        // 与 `Cmd+Z` **同一个落点**（`UndoPort::perform(UiAction::Undo)`）：
        // 界面动作 → 会话 → `CommitGraph::undo_with`。没有历史可撤时按钮置灰，
        // 但**仍然**会把动作记进动作日志（判据因此能断言"拒绝也留痕"）。
        Rectangle {
            x: Tokens.space-6;
            y: parent.height - 76px;
            width: 180px;
            height: 32px;
            background: root.can-undo ? Tokens.bg-raised : Tokens.bg-void;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: root.can-undo ? Tokens.gold : Tokens.line-strong;
            accessible-role: button;
            accessible-id: "undo-tree-undo-button";
            accessible-label: "撤销一步 (Cmd+Z)";

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.can-undo ? "撤销一步 (" + root.undo-depth + " 步可撤)" : "无历史可撤";
                color: root.can-undo ? Tokens.gold-bright : Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.undo-step(); }
            }
        }

        UiMonoText {
            x: Tokens.space-6;
            y: parent.height - 32px;
            width: parent.width - 32px;
            height: 20px;
            text: "撤销一步与 Cmd+Z 同源 · 节点点击回滚未实现 · Esc 关闭";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }
    }
}
