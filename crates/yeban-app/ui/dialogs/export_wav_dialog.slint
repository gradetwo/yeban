// 夜半 (Yeban) — WAV 导出设置对话框
//
// 规范来源 (Normative):
//   - 模块入口「导出 WAV」的**选项面**（`ui/module_actions.slint` 的
//     `module-export-wav-button`）。它此前直接按宿主解析好的路径导出，界面没有任何
//     位深 / 采样率 / 时长控件（`src/host.rs` 的 `ModulePaths` 与
//     `export_wav::WavExportOptions::resolve` 的注释把这一半登记为待做）。
//   - `[UI-TEST-001]` §12.2: 每个可寻址控件都有稳定语义 ID。
//
// ## 诚实性边界
//
// 本文件**不解析**任何数值：四个输入框的文本原样交给宿主
// （`host::wire_module_actions_with_capture`），由它按
// `export_wav::WavExportOptions::resolve` 的**唯一**口径解析；解析失败时回执
// `error=invalid-options`，**不落盘半成品文件**。
// 第五格 `export-wav-limiter-switch` 是布尔量，⛔ 不经那条解析路径：宿主在 `resolve()`
// **之后**直接赋 `wav_options.limiter`（与 CLI `cli.rs` 的 `wav_options.limiter =
// options.wav_limiter` 同款）。⛔ 没有给 `resolve()` 加形参 —— 它是 GUI 与 CLI **共用**
// 的唯一口径处，加形参会把"两边缺省逐字节相同"这条不变量拆成两份（判据
// `tests/gui_export_clipping.rs` 的对照臂就钉在它上面）。
// 默认值逐字等于 CLI 不给 `--wav-*` 时的口径：
//   - 采样率 `auto`      ⇒ 跟随工程（`project.sample_rate()`）
//   - 位深   `24`        ⇒ 24-bit 整数（TPDF 抖动）
//   - 时长   `8`         ⇒ `export_wav::DEFAULT_WAV_SECONDS`
// 空串与 `auto` 同义（= 不覆盖）。界面上**看不到**工程当前的采样率 —— 那需要一条
// 真实的投影读数，本切片没有造它，因此用 `auto` 而不是编一个假数字。
//
// ## 几何
//
// 弹窗默认**关着**（`MainWindow.export-wav-open = false`），因此默认帧与
// `tests/golden/linux/` 的 5 张基准一位不变。打开后是整帧遮罩（与
// `dialogs/undo_tree_modal.slint` 同款）。
//
// ## 键盘（D-UI-19：`[UI-A11Y-003]` §7.3 第 1 条 —— 模态对话框内焦点闭环）
//
// 遮罩盖住整帧，但在此之前它**不接键盘**：焦点始终停在画布那层 `key-handler`，
// 于是"弹窗开着"与"键盘归 DAW"同时成立 —— 用户在填导出路径，按 `Space` 后面的走带
// 就开始播放，按 `1` 画布换了工具，而四个输入框**一个都进不去**（只能鼠标点）。
// 现在 `export-trap` 是这四个框的**祖先** `FocusScope`：
//
// | 键 | 落点 |
// | :--- | :--- |
// | 可打印字符 | `TextInput` 自己吃掉（编辑文本）⇒ ⛔ 不下发快捷键层 |
// | `Tab` / `Shift+Tab`（`\u{9}` / `\u{19}` Backtab） | trap 做**四格闭环轮转**并 `accept` ⇒ 焦点逃不出模态 |
// | `Esc` | 调**既有的** `close` 回调（与 ✕ 按钮、`accessible-action-default` 同一条实现） |
// | 其它裸键 | `reject` ⇒ 冒泡到本组件之外、无人消费 ⇒ 快捷键层⛔ 收不到（焦点不在那里） |
//
// ⚠ 已知边界（如实登记，⛔ 不假装覆盖）：
// * 打开时焦点落**第一格**（`host` 调 `focus-export-wav-dialog`），关闭时宿主调
//   既有的 `focus-shortcut-layer` **复位** —— 规范那句"复位至**触发控件**"今天做不到：
//   触发方 `module-export-wav-button` 不是可聚焦控件（`FocusScope` 都没有），
//   复位到"那一个"要先给它建焦点身份，那是另一票。
// * 「导出」/「关闭」/限制器开关三格**仍是鼠标与无障碍动作**：它们是无 `FocusScope`
//   的 `Rectangle` + `TouchArea`，要接键盘得先给每格加可聚焦容器（并实测它不与
//   `TouchArea` 抢命中测试）⇒ D-UI-20，本票不顺手猜。
// * `Cmd/Ctrl` 组合（保存、撤销、`D-UI-18` 的搜索聚焦）在弹窗打开期间**同样到不了宿主**
//   —— 模态持有键盘是本票的目的，不是副作用。

import { Tokens, UiText, UiTitleText } from "../tokens.slint";

export component ExportWavDialog inherits Rectangle {
    // ---- 四格可编辑文本（唯一写者 = 宿主打开时播种；此后用户输入）------------
    in-out property <string> path: "";
    in-out property <string> sample-rate: "auto";
    in-out property <string> bit-depth: "24";
    in-out property <string> seconds: "8";
    // ⭐ `D-EX-1`：母线限制器开关。第五格，但**不是**文本框 —— 它是布尔量，
    // 用 `switch` 而不是"再开一个能填错的输入框"。默认 `false` 逐字等于 CLI 不给
    // `--limiter`（`WavExportOptions::default()`）。
    //
    // ⚠ 它是**每次调用**的导出修饰量（任务单 `#302` 的硬边界：⛔ 不进
    // `project.schema.json`）⇒ 本控件**不**产生 `Op`、**不**进撤销栈、⛔ 不改工程。
    in-out property <bool> limiter: false;

    callback run();
    callback close();

    background: Tokens.mask-black.with-alpha(0.65);
    clip: true;

    accessible-role: region;
    accessible-id: "export-wav-dialog";
    accessible-label: "WAV 导出设置";

    // ------------------------------------------------- 键盘（D-UI-19）：焦点陷阱
    // `FocusScope` 只有在**孩子的键被拒绝、往上冒泡**时才收到事件 ⇒ 它必须包住那四格
    // （⛔ 不能像时光机那样当兄弟覆盖层放：那接不到 `TextInput` 拒绝的 `Tab`）。
    export-trap := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        // 点遮罩⛔ 不动焦点：焦点的入口只有两个 —— 宿主打开时那一次，与 `Tab` 轮转。
        focus-on-click: false;
        // ⛔ 不参与**全局**轮转：Slint 内建的 `Tab` 遍历按"可见"筛，而此刻左栏搜索框与
        // BPM 框同样可见 ⇒ 焦点会跳出模态。模态必须自己闭环（`[UI-A11Y-003]` §7.3 第 1 条）。
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            // Slint 的字符串转义只认 `\u{...}`（`\t` 会编译失败）；`Tab` = `\u{9}`，
            // `Shift+Tab` 在部分平台以 Backtab `\u{19}` 到达（见 `i-slint-core` 的
            // `window.rs`：内建那段两种都认）。
            if (event.text == "\u{9}" || event.text == "\u{19}") {
                if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                    // `Ctrl+Tab` / `Alt+Tab` ⛔ 不当作轮转 —— 与内建同口径（那段也要求
                    // "无其它修饰键"）。落在这里 ⇒ 快捷键层也收不到（模态持有键盘）。
                    reject
                } else if (event.text == "\u{19}" || event.modifiers.shift) {
                    root.focus-previous-field();
                    accept
                } else {
                    root.focus-next-field();
                    accept
                }
            } else if (event.text == "\u{1b}") {
                // `Esc` 调**既有的** `close` 回调：与 ✕ 按钮、`accessible-action-default`
                // 同一实现（宿主 `on_close_export_wav`）⇒ ⛔ 不是第二份"关闭弹窗"的逻辑。
                root.close();
                accept
            } else {
                // 其余一律 `reject`：往上冒出本组件无人接，而快捷键层⛔ 不是祖先
                // ⇒ 模态开着时 DAW 收不到键 —— 这正是本票要证的"捕获"。
                reject
            }
        }

        Rectangle {
            x: (root.width - 560px) / 2;
            y: (root.height - 320px) / 2;
            width: 560px;
            height: 320px;
            background: Tokens.bg-panel;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.gold-deep;
            clip: true;

            accessible-role: region;
            accessible-id: "export-wav-panel";
            accessible-label: "WAV 导出设置面板";

            UiTitleText {
                x: Tokens.space-6;
                y: Tokens.space-4;
                width: parent.width - 96px;
                height: 24px;
                text: "导出 WAV · 选项";
                color: Tokens.gold-bright;
                font-size: Tokens.font-size-xl;
            }

            // 关闭
            Rectangle {
                x: parent.width - 36px;
                y: Tokens.space-4;
                width: 24px;
                height: 24px;
                background: Tokens.bg-void;
                border-radius: Tokens.radius-sm;
                accessible-role: button;
                accessible-id: "export-wav-close-button";
                accessible-label: "关闭导出设置";
                accessible-action-default => { root.close(); }

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: Tokens.ink-1;
                    font-size: Tokens.font-size-xl;
                    horizontal-alignment: center;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.close(); }
                }
            }

            // ------------------------------------------------------------ 输出路径
            UiText {
                x: Tokens.space-6;
                y: 52px;
                width: parent.width - 48px;
                height: 16px;
                text: "输出路径（空 = 宿主缺省）";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
            }

            export-wav-path-input := TextInput {
                x: Tokens.space-6;
                y: 72px;
                width: parent.width - 48px;
                height: 24px;
                // [PATCH export-wav-dialog-binding] 两向绑定：`text:` 是**单向**赋值，
                // 用户一敲键，TextInput 自己的 text 就与 root.path 脱钩，root 永远停在
                // 宿主播种的初值 ⇒ 导出恒用初值（8 秒 / 跟随工程的采样率）。
                text <=> root.path;
                single-line: true;
                font-family: Tokens.font-mono;
                color: Tokens.gold;
                font-size: Tokens.font-size-xs;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-id: "export-wav-path-input";
                accessible-label: "WAV 输出路径";
                accessible-value: root.path;
                accessible-read-only: false;
            }

            // ------------------------------------------------------------ 采样率
            UiText {
                x: Tokens.space-6;
                y: 108px;
                width: 200px;
                height: 16px;
                text: "采样率 Hz（auto = 跟随工程）";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
            }

            export-wav-sample-rate-input := TextInput {
                x: Tokens.space-6;
                y: 128px;
                width: 200px;
                height: 24px;
                // [PATCH export-wav-dialog-binding] 两向绑定：`text:` 是**单向**赋值，
                // 用户一敲键，TextInput 自己的 text 就与 root.sample-rate 脱钩，root 永远停在
                // 宿主播种的初值 ⇒ 导出恒用初值（8 秒 / 跟随工程的采样率）。
                text <=> root.sample-rate;
                single-line: true;
                font-family: Tokens.font-mono;
                color: Tokens.gold;
                font-size: Tokens.font-size-xs;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-id: "export-wav-sample-rate-input";
                accessible-label: "采样率（auto 或 Hz）";
                accessible-value: root.sample-rate;
                accessible-read-only: false;
            }

            // ------------------------------------------------------------ 位深
            UiText {
                x: Tokens.space-6 + 216px;
                y: 108px;
                width: parent.width - 48px - 216px;
                height: 16px;
                text: "位深（16 / 24 / 32f）";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
            }

            export-wav-bit-depth-input := TextInput {
                x: Tokens.space-6 + 216px;
                y: 128px;
                width: parent.width - 48px - 216px;
                height: 24px;
                // [PATCH export-wav-dialog-binding] 两向绑定：`text:` 是**单向**赋值，
                // 用户一敲键，TextInput 自己的 text 就与 root.bit-depth 脱钩，root 永远停在
                // 宿主播种的初值 ⇒ 导出恒用初值（8 秒 / 跟随工程的采样率）。
                text <=> root.bit-depth;
                single-line: true;
                font-family: Tokens.font-mono;
                color: Tokens.gold;
                font-size: Tokens.font-size-xs;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-id: "export-wav-bit-depth-input";
                accessible-label: "位深（16 / 24 / 32f）";
                accessible-value: root.bit-depth;
                accessible-read-only: false;
            }

            // ------------------------------------------------------------ 时长
            UiText {
                x: Tokens.space-6;
                y: 164px;
                // ⭐ `D-EX-1`：原来这格标题**通栏**（`parent.width - 48px`），因为这一行右边
                // 什么都没有。第五格（母线限制器）落在同一行的右半 ⇒ 标题收窄到与它自己的
                // 输入框同宽（200px，与上面「采样率」那格的标题同款），⛔ 两个标题的矩形
                // 不许重叠 —— 面板高度一位不改（弹窗默认关着 ⇒ 默认帧与 5 张金帧不动）。
                width: 200px;
                height: 16px;
                text: "时长 秒（空 = 缺省 8 秒）";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
            }

            export-wav-seconds-input := TextInput {
                x: Tokens.space-6;
                y: 184px;
                width: 200px;
                height: 24px;
                // [PATCH export-wav-dialog-binding] 两向绑定：`text:` 是**单向**赋值，
                // 用户一敲键，TextInput 自己的 text 就与 root.seconds 脱钩，root 永远停在
                // 宿主播种的初值 ⇒ 导出恒用初值（8 秒 / 跟随工程的采样率）。
                text <=> root.seconds;
                single-line: true;
                font-family: Tokens.font-mono;
                color: Tokens.gold;
                font-size: Tokens.font-size-xs;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-id: "export-wav-seconds-input";
                accessible-label: "导出时长（秒）";
                accessible-value: root.seconds;
                accessible-read-only: false;
            }

            // ------------------------------------------------------------ 母线限制器
            // ⭐ `D-EX-1`：限制器**本来就存在**（`WavExportOptions.limiter`；CLI `--limiter`
            // 与 MCP `yeban_render` 的 `limiter` 都能开，`render_core` 真的消费它），
            // 缺的只是 GUI 这条路到不了它 —— 本控件就是补那条路。
            // 落点选在「时长」那一格的**右侧空位**（x 与位深格同列）⇒ 面板高度一位不改：
            // 弹窗默认关着，整帧不变，`tests/golden/linux/` 的 5 张基准不受影响。
            UiText {
                x: Tokens.space-6 + 216px;
                y: 164px;
                width: parent.width - 48px - 216px;
                height: 16px;
                text: "母线限制器（仅本次导出）";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
            }

            export-wav-limiter-switch := Rectangle {
                x: Tokens.space-6 + 216px;
                y: 184px;
                width: 200px;
                height: 24px;
                background: root.limiter ? Tokens.gold-deep : Tokens.bg-void;
                border-radius: Tokens.radius-sm;
                border-width: 1px;
                border-color: root.limiter ? Tokens.gold : Tokens.line-strong;

                accessible-role: switch;
                accessible-id: "export-wav-limiter-switch";
                accessible-label: "母线限制器（仅本次导出）";
                accessible-checkable: true;
                accessible-checked: root.limiter;
                // `[UI-A11Y-003]` §7.3：无障碍动作与下面 `TouchArea.clicked` **逐字同一落点**。
                accessible-action-default => { root.limiter = !root.limiter; }

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: root.limiter ? "限制器：开" : "限制器：关";
                    color: root.limiter ? Tokens.gold-bright : Tokens.ink-1;
                    font-size: Tokens.font-size-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.limiter = !root.limiter; }
                }
            }

            // ------------------------------------------------------------ 说明行
            Rectangle {
                x: Tokens.space-6;
                y: 220px;
                width: parent.width - 48px;
                height: 16px;
                clip: true;

                accessible-role: text;
                accessible-id: "export-wav-options-note";
                accessible-label: "无效的采样率 / 位深 / 时长会让导出如实失败，不写半成品文件。";

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: "无效的采样率 / 位深 / 时长会让导出如实失败，不写半成品文件。";
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-xs;
                    overflow: elide;
                }
            }

            // ------------------------------------------------------------ 执行
            Rectangle {
                x: Tokens.space-6;
                y: parent.height - 56px;
                width: 160px;
                height: 32px;
                background: Tokens.bg-raised;
                border-radius: Tokens.radius-md;
                border-width: 1px;
                border-color: Tokens.gold;
                accessible-role: button;
                accessible-id: "export-wav-run-button";
                accessible-label: "按这些选项导出 WAV";
                accessible-action-default => { root.run(); }

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: "导出";
                    color: Tokens.gold-bright;
                    font-size: Tokens.font-size-xs;
                    horizontal-alignment: center;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.run(); }
                }
            }
        }
    }

    // ---- 焦点读数（D-UI-19）-------------------------------------------------
    /// 哪一格正持有键盘：`0` 路径 / `1` 采样率 / `2` 位深 / `3` 时长 / `-1` 不在任何格内。
    /// ⚠ 这是从 Slint **自己的**焦点状态**推导**出来的（四个 `has-focus` 就是天然事实源），
    /// ⛔ 不是第三份"我以为焦点在哪"的写态 —— 与 `app.slint` 的 `shortcut-layer-focused`
    /// （`FocusScope.has-focus` 的镜像）同口径。唯一读者 = 宿主与无头判据。
    out property <int> focused-field:
        export-wav-path-input.has-focus ? 0
        : export-wav-sample-rate-input.has-focus ? 1
        : export-wav-bit-depth-input.has-focus ? 2
        : export-wav-seconds-input.has-focus ? 3
        : -1;

    /// 打开时由宿主调用：焦点进**第一格**。停在遮罩上等于"看得见但打不了字"。
    public function focus-first-field() {
        export-wav-path-input.focus();
    }

    /// `Tab`：路径 → 采样率 → 位深 → 时长 → 回第一格。两端都闭合（焦点逃不出去）。
    /// `-1`（从外部进来 / 焦点被清）⇒ 落回第一格 ⇒ ⛔ 不存在"按 Tab 跳到左栏"这一态。
    public function focus-next-field() {
        if (root.focused-field == 0) {
            export-wav-sample-rate-input.focus();
        } else if (root.focused-field == 1) {
            export-wav-bit-depth-input.focus();
        } else if (root.focused-field == 2) {
            export-wav-seconds-input.focus();
        } else {
            export-wav-path-input.focus();
        }
    }

    /// `Shift+Tab`：反向；第一格再退 ⇒ 末格（`-1` 同样退到末格）。
    public function focus-previous-field() {
        if (root.focused-field == 1) {
            export-wav-path-input.focus();
        } else if (root.focused-field == 2) {
            export-wav-sample-rate-input.focus();
        } else if (root.focused-field == 3) {
            export-wav-bit-depth-input.focus();
        } else {
            export-wav-seconds-input.focus();
        }
    }

}
