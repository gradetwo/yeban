// 夜半 (Yeban) — 音源管理对话框
//
// 规范来源：Wang 2026-11-17 令（学 Logic Pro Sound Library 管理器的
// 思想：已安装与可下载分开管、下载校验后才装；布局按夜半自己的设计）。
// 主菜单「设置 → 音源管理...」打开（命令 `open-sound-library`，宿主接线
// `host::wire_sound_library_dialog`）。与人性化对话框同结构：弹窗默认
// **关着**（`MainWindow.sound-library-open = false`），因此默认帧与
// golden 基准一位不变；打开后是整帧遮罩（与导出对话框同款）。
//
// ## 数据契约（⛔ 本文件不做任何实事）
//
// - 列表数据全部由宿主以**平行数组**写入（与 Musical PR 抽屉同款形态）：
//   已安装 = ids / names / locations / sizes / deletable 五条等长数组；
//   可下载 = ids / names / versions / sizes / descriptions / installed
//   六条等长数组。名字、位置、大小都是**数据**（用户内容与宿主读数），
//   不是界面文案，⛔ 不走 `@tr`；本文件的静态标签才走 `@tr`。
// - 目录三态由 `catalog-state` 表达：`0` 拉取中 / `1` 已拿到（包数组
//   可以为空 —— 空是真实状态，显示「暂无可下载音源」）/ `2` 拿不到
//   （离线或目录不可用，只显示已安装部分 + 明确提示 + 重试钮）。
// - 下载、删除、校验、解包全在宿主与 `crate::sound_library` 里做；
//   本文件只发回调（`download-pack(id)` / `delete-library(id)` /
//   `refresh-catalog()` / `close()`）并显示宿主写回的进度与状态行。
//
// ## 删除确认（两步，⛔ 不用系统确认框）
//
// 点「删除」只把该行切到确认态（`confirm-delete-id` 记下行 id，行尾
// 展开「确认删除 / 取消」），再点「确认删除」才发 `delete-library`；
// 点「取消」或关窗（`if` 块重建）即复位。内置库那一行没有删除钮，
// 只显示「内置」标记（宿主与逻辑层还会再挡一次，双保险）。

import { Tokens, UiText, UiTitleText, ImeAwareTextInput } from "../tokens.slint";

export component SoundLibraryDialog inherits Rectangle {
    // ---- 已安装（宿主写，平行数组）--------------------------------------
    in property <[string]> installed-ids;
    in property <[string]> installed-names;
    in property <[string]> installed-locations;
    in property <[string]> installed-sizes;
    in property <[bool]> installed-deletable;
    // ---- SFZ Doctor 待检（宿主写：非官方库且未表态的那几行，与 installed-* 平行）----
    in property <[bool]> installed-doctor-needed;
    // ---- 可下载（宿主写，平行数组 + 三态）--------------------------------
    in property <int> catalog-state: 0;
    in property <[string]> pack-ids;
    in property <[string]> pack-names;
    in property <[string]> pack-versions;
    in property <[string]> pack-sizes;
    in property <[string]> pack-descriptions;
    in property <[bool]> pack-installed;
    // ---- 下载进度（宿主写：正在下的包 id + 百分比，-1 = 没在下）-----------
    in property <string> downloading-id: "";
    in property <int> download-progress: -1;
    // ---- 状态行（宿主写：最近一次操作的真实结果）--------------------------
    in property <string> status: "";
    in property <bool> status-is-error: false;
    // ---- 失败后可重试的那一件（宿主写：下载失败时填包 id，成功/开始新下载清空）----
    // 用户口径："也不知道下载成功与否" —— 失败必须能**一键重来**，不能只留一行红字。
    in property <string> retry-pack-id: "";
    // ---- 「用到当前轨」的目标（宿主写：混音台当前那条轨的名字；空 = 没有目标）----
    in property <string> target-track-name: "";
    // ---- 删除确认态（本文件自有：正在确认删除的行 id，空 = 无）-------------
    in-out property <string> confirm-delete-id: "";
    // ---- SFZ Doctor 确认态（本文件自有：正在确认体检的行 id，空 = 无）----
    in-out property <string> doctor-confirm-id: "";
    // ---- 搜索原文（本文件自有；过滤由宿主按这份原文重播平行数组）-------------
    in-out property <string> search-text: "";

    callback close();
    callback refresh-catalog();
    callback download-pack(string);
    callback delete-library(string);
    /// 对这一件非官方音源跑 SFZ Doctor 体检 + 自动修复（宿主在后台线程跑）。
    callback doctor-check(string);
    /// 拒绝这一件的体检（宿主落 declined 记录，之后不再提示）。
    callback doctor-decline(string);
    callback filter-changed(string);
    callback download-all();
    /// 把这一件**装好的**音源用到混音台当前那条轨上（一次点击）。
    callback use-pack(string);

    /// 列表可用宽度（面板宽减去左右留白）。
    property <length> list-w: Math.min(820px, root.width - 32px) - 48px;
    /// 只在这一行同时满足"有错误"和"知道是哪一件"时才出「再试一次」。
    property <bool> retry-shown: root.status-is-error && root.retry-pack-id != "";

    background: Tokens.mask-black.with-alpha(0.65);
    clip: true;

    accessible-role: region;
    accessible-id: "sound-library-dialog";
    accessible-label: @tr("音源管理");

    // 遮罩吞掉鼠标（与人性化对话框同款）：点遮罩不关面板，关面板只有
    // ✕ 与 Esc。刻意没有任何回调，唯一职责是把这一击吃掉。
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // 键盘（D-UI-19 / T-FIX-182 / T-FIX-217）：Esc 关闭（模态持有 Esc）；
    // `Tab` / `Shift+Tab` 在槽位表里闭环 —— 但陷阱只在两端包办：正向到末格
    // （✕，700）再进 ⇒ 回首格（搜索框，0）；反向到首格再退 ⇒ 去末格。其余
    // 一律 `reject`，交给原生 Tab 遍历（行按钮的 FocusScope 按树序排布，
    // 与槽位表同序 —— 动态行没法从循环外按下标取焦，只能让原生遍历带过去，
    // 见焦点一节）。`Ctrl/Alt/Meta+Tab` 一律放行（不劫持系统手势）。
    // 读数 `-1`（焦点在对话框内却不在任何已登记控件上 —— 正常流程不会出现，
    // 是兜底）也由陷阱接住：正向 ⇒ 回搜索框，反向 ⇒ 去 ✕。注意：已销毁的行
    // 按钮上的 Tab 到不了陷阱（焦点死了，冒泡链就断了），所以真正的防死焦点
    // 靠各按钮动作里先挪焦点，见焦点一节。
    sound-library-trap := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == "\u{9}" || event.text == "\u{19}") {
                if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                    reject
                } else if (event.text == "\u{19}" || event.modifiers.shift) {
                    if (root.focused-control == 0 || root.focused-control == -1) {
                        root.focus-control(700);
                        accept
                    } else {
                        reject
                    }
                } else {
                    if (root.focused-control == 700 || root.focused-control == -1) {
                        root.focus-first-control();
                        accept
                    } else {
                        reject
                    }
                }
            } else if (event.text == "\u{1b}") {
                root.close();
                accept
            } else {
                reject
            }
        }

        panel := Rectangle {
            x: (root.width - Math.min(820px, root.width - 32px)) / 2;
            // 面板能吃多高就吃多高（上限 720px）：两张列表（内置 28 件 / 可下载
            // 几十件）在 600px 固定高时各自只剩 3 行，"列表有更多"这件事被藏住了。
            // 只留 24px 上下呼吸边，最小窗口 700 高 ⇒ 面板 676。
            y: (root.height - Math.min(720px, root.height - 24px)) / 2;
            width: Math.min(820px, root.width - 32px);
            height: Math.min(720px, root.height - 24px);
            background: Tokens.bg-panel;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.gold-deep;
            clip: true;

            accessible-role: region;
            accessible-id: "sound-library-panel";
            accessible-label: @tr("音源管理");

            UiTitleText {
                x: Tokens.space-6;
                y: Tokens.space-4;
                width: parent.width - 96px;
                height: 24px;
                text: @tr("音源管理");
                color: Tokens.gold-bright;
                font-size: Tokens.font-size-xl;
            }

            // 「用到当前轨」指向哪条轨（空 = 混音台没有可用的目标轨）
            UiText {
                x: 180px;
                y: Tokens.space-4 + 4px;
                width: parent.width - 180px - 48px;
                height: 20px;
                text: root.target-track-name == ""
                    ? @tr("混音台还没有可用的轨")
                    : @tr("用到当前轨") + " ⇒ " + root.target-track-name;
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: right;
                overflow: elide;
            }

            // -------------------------------------------------------- 已安装
            UiText {
                x: Tokens.space-6;
                y: 52px;
                width: 200px;
                height: 18px;
                text: @tr("已安装");
                color: Tokens.ink-1;
                font-size: Tokens.font-size-md;
            }

            // 条目计数（列表高 = 4.6 行，内置就有 28 件）——没有这句，用户会以为
            // "装好的只有这三四个"，而不知道下面还能滚。数字直接取自同一份模型。
            UiText {
                x: Tokens.space-6 + 76px;
                y: 52px;
                width: root.list-w - 76px;
                height: 18px;
                text: @tr("共 {} 件 · 列表可上下滚动", root.installed-names.length);
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: right;
                overflow: elide;
            }

            // 搜索框（按名字 / 分类 / 许可做子串匹配；空串 = 全部显示）
            // 树位在已安装列表之前：Tab 序首格必须是搜索框（槽位 0），视觉
            // 位置不变（y: 300px 仍在「可下载」区，与「全部下载」并排）。
            Rectangle {
                x: Tokens.space-6 + 84px;
                y: 300px;
                width: Math.max(140px, root.list-w - 84px - 320px);
                height: 28px;
                background: Tokens.bg-void;
                border-radius: Tokens.radius-sm;
                border-width: 1px;
                border-color: Tokens.line;

                sound-library-search-input := ImeAwareTextInput {
                    x: 10px;
                    y: 0;
                    width: parent.width - 20px;
                    height: parent.height;
                    text <=> root.search-text;
                    single-line: true;
                    color: Tokens.ink-1;
                    font-size: Tokens.font-size-xs;
                    vertical-alignment: center;
                    accessible-role: text-input;
                    accessible-id: "sound-library-search-input";
                    accessible-label: @tr("搜索音源（名字 / 分类 / 许可）");
                    accessible-value: root.search-text;
                    accessible-read-only: false;
                    edited => { root.filter-changed(self.text); }
                }

                // 占位提示（只在空串时出现，不挡输入）
                if root.search-text == "" : UiText {
                    x: 10px;
                    y: 0;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: @tr("搜索音源…");
                    color: Tokens.ink-2;
                    font-size: Tokens.font-size-xs;
                    vertical-alignment: center;
                }
            }

            installed-flick := Flickable {
                x: Tokens.space-6;
                y: 78px;
                width: root.list-w;
                height: 200px;
                content-height: root.installed-names.length * 40px;

                for installed-name[i] in root.installed-names : Rectangle {
                    x: 0;
                    y: i * 40px;
                    width: root.list-w;
                    height: 38px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-md;

                    UiText {
                        x: 12px;
                        y: 0;
                        width: 190px;
                        height: parent.height;
                        text: installed-name;
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-sm;
                        overflow: elide;
                    }

                    UiText {
                        x: 210px;
                        y: 0;
                        width: root.list-w - 480px;
                        height: parent.height;
                        text: root.installed-locations[i];
                        color: Tokens.ink-2;
                        font-size: Tokens.font-size-xs;
                        overflow: elide;
                    }

                    UiText {
                        x: root.list-w - 262px;
                        y: 0;
                        width: 72px;
                        height: parent.height;
                        text: root.installed-sizes[i];
                        color: Tokens.ink-2;
                        font-size: Tokens.font-size-xs;
                        horizontal-alignment: right;
                        overflow: elide;
                    }

                    // 内置标记（不可删的那一条）
                    if !root.installed-deletable[i] : UiText {
                        x: root.list-w - 104px;
                        y: 0;
                        width: 92px;
                        height: parent.height;
                        text: @tr("内置");
                        color: Tokens.ink-2;
                        font-size: Tokens.font-size-xs;
                        horizontal-alignment: center;
                    }

                    // 删除钮（可删且不在确认态时）
                    if root.installed-deletable[i] && root.confirm-delete-id != root.installed-ids[i] : Rectangle {
                        x: root.list-w - 104px;
                        y: 8px;
                        width: 92px;
                        height: 28px;
                        background: Tokens.bg-void;
                        border-radius: Tokens.radius-sm;
                        border-width: row-delete-focus.has-focus ? 2px : 1px;
                        border-color: row-delete-focus.has-focus ? Tokens.gold : Tokens.gold-deep;
                        accessible-role: button;
                        property <string> row-suffix: "-" + i;
                                accessible-id: "sound-library-delete-button" + self.row-suffix;
                        accessible-label: @tr("删除音源库");
                        accessible-action-default => { if (root.focused-row-slot == 100 + i * 10 + 0) { root.focus-first-control(); } root.confirm-delete-id = root.installed-ids[i]; }

                        row-delete-focus := FocusScope {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            focus-on-click: false;
                            focus-gained(reason) => { root.focused-row-slot = 100 + i * 10 + 0; }
                            focus-lost(reason) => { if (root.focused-row-slot == 100 + i * 10 + 0) { root.focused-row-slot = -1; } }
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    // 本钮随武装马上销毁：先把焦点挪到搜索框，再武装。
                                    // （同行新出现的确认钮没法直接点名：Slint 不允许跨
                                    // `if` 分支访问 id；焦点留在将死元素上会死掉。）
                                    root.focus-first-control();
                                    root.confirm-delete-id = root.installed-ids[i];
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        UiText {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: @tr("删除");
                            color: Tokens.ink-1;
                            font-size: Tokens.font-size-xs;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            width: parent.width;
                            height: parent.height;
                            clicked => { if (root.focused-row-slot == 100 + i * 10 + 0) { root.focus-first-control(); } root.confirm-delete-id = root.installed-ids[i]; }
                        }
                    }

                    // 确认态：行尾展开确认 / 取消（覆盖在行上，不发回调直到确认）
                    if root.installed-deletable[i] && root.confirm-delete-id == root.installed-ids[i] : Rectangle {
                        x: root.list-w - 216px;
                        y: 0;
                        width: 216px;
                        height: parent.height;
                        background: Tokens.bg-panel;

                        Rectangle {
                            x: 0;
                            y: 8px;
                            width: 104px;
                            height: 28px;
                            background: Tokens.bg-void;
                            border-radius: Tokens.radius-sm;
                            border-width: row-delete-confirm-focus.has-focus ? 2px : 1px;
                            border-color: row-delete-confirm-focus.has-focus ? Tokens.gold : Tokens.record-red;
                            accessible-role: button;
                            accessible-id: "sound-library-delete-confirm-button";
                            accessible-label: @tr("确认删除");
                            accessible-action-default => { if (root.focused-row-slot == 100 + i * 10 + 1) { root.focus-first-control(); } root.delete-library(root.installed-ids[i]); root.confirm-delete-id = ""; }

                            row-delete-confirm-focus := FocusScope {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                focus-on-click: false;
                                focus-gained(reason) => { root.focused-row-slot = 100 + i * 10 + 1; }
                                focus-lost(reason) => { if (root.focused-row-slot == 100 + i * 10 + 1) { root.focused-row-slot = -1; } }
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == Key.Space) {
                                        // 本钮随确认马上销毁：先把焦点挪到搜索框，再删。
                                        root.focus-first-control();
                                        root.delete-library(root.installed-ids[i]);
                                        root.confirm-delete-id = "";
                                        accept
                                    } else {
                                        reject
                                    }
                                }
                            }

                            UiText {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("确认删除");
                                color: Tokens.record-red;
                                font-size: Tokens.font-size-xs;
                                horizontal-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                width: parent.width;
                                height: parent.height;
                                clicked => { if (root.focused-row-slot == 100 + i * 10 + 1) { root.focus-first-control(); } root.delete-library(root.installed-ids[i]); root.confirm-delete-id = ""; }
                            }
                        }

                        Rectangle {
                            x: 112px;
                            y: 8px;
                            width: 92px;
                            height: 28px;
                            background: Tokens.bg-void;
                            border-radius: Tokens.radius-sm;
                            border-width: row-delete-cancel-focus.has-focus ? 2px : 1px;
                            border-color: row-delete-cancel-focus.has-focus ? Tokens.gold : Tokens.gold-deep;
                            accessible-role: button;
                            accessible-id: "sound-library-delete-cancel-button";
                            accessible-label: @tr("取消");
                            accessible-action-default => { if (root.focused-row-slot == 100 + i * 10 + 2) { root.focus-first-control(); } root.confirm-delete-id = ""; }

                            row-delete-cancel-focus := FocusScope {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                focus-on-click: false;
                                focus-gained(reason) => { root.focused-row-slot = 100 + i * 10 + 2; }
                                focus-lost(reason) => { if (root.focused-row-slot == 100 + i * 10 + 2) { root.focused-row-slot = -1; } }
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == Key.Space) {
                                        // 本钮随取消马上销毁：先把焦点挪到搜索框，再取消。
                                        root.focus-first-control();
                                        root.confirm-delete-id = "";
                                        accept
                                    } else {
                                        reject
                                    }
                                }
                            }

                            UiText {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("取消");
                                color: Tokens.ink-1;
                                font-size: Tokens.font-size-xs;
                                horizontal-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                width: parent.width;
                                height: parent.height;
                                clicked => { if (root.focused-row-slot == 100 + i * 10 + 2) { root.focus-first-control(); } root.confirm-delete-id = ""; }
                            }
                        }
                    }

                    // SFZ Doctor 钮（非官方未检、且不在任何确认态时；与删除钮同款两步式）
                    if root.installed-doctor-needed[i] && root.doctor-confirm-id != root.installed-ids[i] && root.confirm-delete-id != root.installed-ids[i] : Rectangle {
                        x: root.list-w - 186px;
                        y: 8px;
                        width: 74px;
                        height: 28px;
                        background: Tokens.bg-void;
                        border-radius: Tokens.radius-sm;
                        border-width: row-doctor-focus.has-focus ? 2px : 1px;
                        border-color: row-doctor-focus.has-focus ? Tokens.gold : Tokens.gold-deep;
                        accessible-role: button;
                        accessible-id: "sound-library-doctor-button";
                        accessible-label: @tr("SFZ 体检");
                        accessible-action-default => { if (root.focused-row-slot == 100 + i * 10 + 3) { root.focus-first-control(); } root.doctor-confirm-id = root.installed-ids[i]; }

                        row-doctor-focus := FocusScope {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            focus-on-click: false;
                            focus-gained(reason) => { root.focused-row-slot = 100 + i * 10 + 3; }
                            focus-lost(reason) => { if (root.focused-row-slot == 100 + i * 10 + 3) { root.focused-row-slot = -1; } }
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    // 本钮随武装马上销毁：先把焦点挪到搜索框，再武装。
                                    root.focus-first-control();
                                    root.doctor-confirm-id = root.installed-ids[i];
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        UiText {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: @tr("体检");
                            color: Tokens.ink-1;
                            font-size: Tokens.font-size-xs;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            width: parent.width;
                            height: parent.height;
                            clicked => { if (root.focused-row-slot == 100 + i * 10 + 3) { root.focus-first-control(); } root.doctor-confirm-id = root.installed-ids[i]; }
                        }
                    }

                    // SFZ Doctor 确认态：行尾展开说明 + 开始检查 / 不用了（覆盖在行上，不发回调直到表态）
                    if root.installed-doctor-needed[i] && root.doctor-confirm-id == root.installed-ids[i] : Rectangle {
                        x: root.list-w - 472px;
                        y: 0;
                        width: 472px;
                        height: parent.height;
                        background: Tokens.bg-panel;

                        UiText {
                            x: 8px;
                            y: 0;
                            width: 224px;
                            height: parent.height;
                            text: @tr("非官方音源：用 SFZ Doctor 检查并自动修复？");
                            color: Tokens.ink-2;
                            font-size: Tokens.font-size-xs;
                            overflow: elide;
                        }

                        Rectangle {
                            x: 240px;
                            y: 8px;
                            width: 104px;
                            height: 28px;
                            background: Tokens.bg-void;
                            border-radius: Tokens.radius-sm;
                            border-width: row-doctor-confirm-focus.has-focus ? 2px : 1px;
                            border-color: row-doctor-confirm-focus.has-focus ? Tokens.gold : Tokens.gold-deep;
                            accessible-role: button;
                            accessible-id: "sound-library-doctor-confirm-button";
                            accessible-label: @tr("开始检查");
                            accessible-action-default => { if (root.focused-row-slot == 100 + i * 10 + 4) { root.focus-first-control(); } root.doctor-check(root.installed-ids[i]); root.doctor-confirm-id = ""; }

                            row-doctor-confirm-focus := FocusScope {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                focus-on-click: false;
                                focus-gained(reason) => { root.focused-row-slot = 100 + i * 10 + 4; }
                                focus-lost(reason) => { if (root.focused-row-slot == 100 + i * 10 + 4) { root.focused-row-slot = -1; } }
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == Key.Space) {
                                        // 本钮随开始检查马上销毁：先把焦点挪到搜索框。
                                        root.focus-first-control();
                                        root.doctor-check(root.installed-ids[i]);
                                        root.doctor-confirm-id = "";
                                        accept
                                    } else {
                                        reject
                                    }
                                }
                            }

                            UiText {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("开始检查");
                                color: Tokens.ink-1;
                                font-size: Tokens.font-size-xs;
                                horizontal-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                width: parent.width;
                                height: parent.height;
                                clicked => { if (root.focused-row-slot == 100 + i * 10 + 4) { root.focus-first-control(); } root.doctor-check(root.installed-ids[i]); root.doctor-confirm-id = ""; }
                            }
                        }

                        Rectangle {
                            x: 352px;
                            y: 8px;
                            width: 92px;
                            height: 28px;
                            background: Tokens.bg-void;
                            border-radius: Tokens.radius-sm;
                            border-width: row-doctor-decline-focus.has-focus ? 2px : 1px;
                            border-color: row-doctor-decline-focus.has-focus ? Tokens.gold : Tokens.gold-deep;
                            accessible-role: button;
                            accessible-id: "sound-library-doctor-decline-button";
                            accessible-label: @tr("不用了");
                            accessible-action-default => { if (root.focused-row-slot == 100 + i * 10 + 5) { root.focus-first-control(); } root.doctor-decline(root.installed-ids[i]); root.doctor-confirm-id = ""; }

                            row-doctor-decline-focus := FocusScope {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                focus-on-click: false;
                                focus-gained(reason) => { root.focused-row-slot = 100 + i * 10 + 5; }
                                focus-lost(reason) => { if (root.focused-row-slot == 100 + i * 10 + 5) { root.focused-row-slot = -1; } }
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == Key.Space) {
                                        // 本钮随表态马上销毁：先把焦点挪到搜索框。
                                        root.focus-first-control();
                                        root.doctor-decline(root.installed-ids[i]);
                                        root.doctor-confirm-id = "";
                                        accept
                                    } else {
                                        reject
                                    }
                                }
                            }

                            UiText {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                text: @tr("不用了");
                                color: Tokens.ink-1;
                                font-size: Tokens.font-size-xs;
                                horizontal-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                width: parent.width;
                                height: parent.height;
                                clicked => { if (root.focused-row-slot == 100 + i * 10 + 5) { root.focus-first-control(); } root.doctor-decline(root.installed-ids[i]); root.doctor-confirm-id = ""; }
                            }
                        }
                    }
                }
            }

            // 分界线
            Rectangle {
                x: Tokens.space-6;
                y: 294px;
                width: root.list-w;
                height: 1px;
                background: Tokens.gold-deep.with-alpha(0.5);
            }

            // -------------------------------------------------------- 可下载
            UiText {
                x: Tokens.space-6;
                y: 306px;
                width: 80px;
                height: 18px;
                text: @tr("可下载");
                color: Tokens.ink-1;
                font-size: Tokens.font-size-md;
            }

            // 一键下载全部（清单里还没装的，按顺序逐个下）
            if root.catalog-state == 1 : Rectangle {
                x: Tokens.space-6 + root.list-w - 300px;
                y: 300px;
                width: 96px;
                height: 28px;
                background: Tokens.bg-raised;
                border-radius: Tokens.radius-sm;
                border-width: download-all-focus.has-focus ? 2px : 1px;
                border-color: Tokens.gold;
                accessible-role: button;
                accessible-id: "sound-library-download-all-button";
                accessible-label: @tr("下载全部内置音源");
                accessible-action-default => { root.download-all(); }

                download-all-focus := FocusScope {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    focus-gained(reason) => { root.focused-row-slot = 300; }
                    focus-lost(reason) => { if (root.focused-row-slot == 300) { root.focused-row-slot = -1; } }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.download-all();
                            accept
                        } else {
                            reject
                        }
                    }
                }

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: @tr("全部下载");
                    color: Tokens.gold-bright;
                    font-size: Tokens.font-size-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.download-all(); }
                }
            }

            // 拉不到时的重试钮（目录区右上角）
            if root.catalog-state == 2 : Rectangle {
                x: Tokens.space-6 + root.list-w - 92px;
                y: 300px;
                width: 92px;
                height: 28px;
                background: Tokens.bg-raised;
                border-radius: Tokens.radius-sm;
                border-width: catalog-retry-focus.has-focus ? 2px : 1px;
                border-color: Tokens.gold;
                accessible-role: button;
                accessible-id: "sound-library-retry-button";
                accessible-label: @tr("重试");
                accessible-action-default => { root.refresh-catalog(); }

                catalog-retry-focus := FocusScope {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    focus-gained(reason) => { root.focused-row-slot = 301; }
                    focus-lost(reason) => { if (root.focused-row-slot == 301) { root.focused-row-slot = -1; } }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.refresh-catalog();
                            accept
                        } else {
                            reject
                        }
                    }
                }

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: @tr("重试");
                    color: Tokens.gold-bright;
                    font-size: Tokens.font-size-xs;
                    horizontal-alignment: center;
                }

                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.refresh-catalog(); }
                }
            }

            // 三态文案（居中显示在包列表区）
            if root.catalog-state == 0 : UiText {
                x: Tokens.space-6;
                y: 384px;
                width: root.list-w;
                height: 20px;
                text: @tr("正在获取目录...");
                color: Tokens.ink-2;
                font-size: Tokens.font-size-sm;
                horizontal-alignment: center;
            }

            if root.catalog-state == 2 : UiText {
                x: Tokens.space-6;
                y: 384px;
                width: root.list-w;
                height: 20px;
                // ⚠ 不要用一句笼统的"检查网络"：原因就在 `status` 里（哪一步、哪条路径）。
                // 用户按这句"检查网络"去排查，往往根本不是网络问题。
                text: root.status == "" ? @tr("无法获取下载目录，请检查网络后重试") : root.status;
                color: Tokens.warn-amber;
                font-size: Tokens.font-size-sm;
                horizontal-alignment: center;
            }

            if root.catalog-state == 1 && root.pack-names.length == 0 : UiText {
                x: Tokens.space-6;
                y: 384px;
                width: root.list-w;
                height: 20px;
                text: @tr("暂无可下载音源");
                color: Tokens.ink-2;
                font-size: Tokens.font-size-sm;
                horizontal-alignment: center;
            }

            pack-flick := Flickable {
                x: Tokens.space-6;
                y: 336px;
                width: root.list-w;
                height: panel.height - 336px - 52px;
                content-height: root.pack-names.length * 54px;

                for pack-name[i] in root.pack-names : Rectangle {
                    x: 0;
                    y: i * 54px;
                    width: root.list-w;
                    height: 52px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-md;

                    UiText {
                        x: 12px;
                        y: 0;
                        width: 180px;
                        height: parent.height;
                        text: pack-name;
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-sm;
                        overflow: elide;
                    }

                    UiText {
                        x: 200px;
                        y: 0;
                        width: 56px;
                        height: parent.height;
                        text: root.pack-versions[i];
                        color: Tokens.ink-2;
                        font-size: Tokens.font-size-xs;
                        overflow: elide;
                    }

                    UiText {
                        x: 264px;
                        y: 0;
                        width: root.list-w - 264px - 200px;
                        height: parent.height;
                        text: root.pack-descriptions[i];
                        color: Tokens.ink-2;
                        font-size: Tokens.font-size-xs;
                        overflow: elide;
                    }

                    UiText {
                        x: root.list-w - 262px;
                        y: 0;
                        width: 72px;
                        height: parent.height;
                        text: root.pack-sizes[i];
                        color: Tokens.ink-2;
                        font-size: Tokens.font-size-xs;
                        horizontal-alignment: right;
                        overflow: elide;
                    }

                    // 已装上的包：给一个「用到当前轨」——装好了却不知道怎么用，等于没装
                    if root.pack-installed[i] : Rectangle {
                        x: root.list-w - 104px;
                        y: 12px;
                        width: 92px;
                        height: 28px;
                        background: Tokens.bg-void;
                        border-radius: Tokens.radius-sm;
                        border-width: row-use-focus.has-focus ? 2px : 1px;
                        border-color: row-use-focus.has-focus ? Tokens.gold : Tokens.gold-deep;
                        accessible-role: button;
                        property <string> row-suffix: "-" + i;
                        accessible-id: "sound-library-use-button" + self.row-suffix;
                        accessible-label: @tr("用这件音源到当前轨");
                        accessible-action-default => { root.use-pack(root.pack-ids[i]); }

                        row-use-focus := FocusScope {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            focus-on-click: false;
                            focus-gained(reason) => { root.focused-row-slot = 400 + i * 10 + 0; }
                            focus-lost(reason) => { if (root.focused-row-slot == 400 + i * 10 + 0) { root.focused-row-slot = -1; } }
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    root.use-pack(root.pack-ids[i]);
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        UiText {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: @tr("用到当前轨");
                            color: Tokens.ink-1;
                            font-size: Tokens.font-size-xs;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.use-pack(root.pack-ids[i]); }
                        }
                    }

                    // 正在下的包：进度条 + 读数（替换下载钮的位置）
                    if !root.pack-installed[i] && root.downloading-id == root.pack-ids[i] : Rectangle {
                        x: root.list-w - 104px;
                        y: 0;
                        width: 92px;
                        height: parent.height;
                        background: transparent;

                        Rectangle {
                            x: 0;
                            y: 12px;
                            width: 92px;
                            height: 6px;
                            background: Tokens.bg-void;
                            border-radius: 3px;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: 92px * Math.max(0, Math.min(100, root.download-progress)) / 100;
                                height: parent.height;
                                background: Tokens.gold;
                                border-radius: 3px;
                            }
                        }

                        UiText {
                            x: 0;
                            y: 24px;
                            width: 92px;
                            height: 16px;
                            text: root.download-progress >= 0
                                ? @tr("下载中") + " " + root.download-progress + "%"
                                : @tr("下载中");
                            color: Tokens.ink-2;
                            font-size: Tokens.font-size-xs;
                            horizontal-alignment: center;
                        }
                    }

                    // 下载钮
                    if !root.pack-installed[i] && root.downloading-id != root.pack-ids[i] : Rectangle {
                        x: root.list-w - 104px;
                        y: 12px;
                        width: 92px;
                        height: 28px;
                        background: Tokens.bg-raised;
                        border-radius: Tokens.radius-sm;
                        border-width: row-download-focus.has-focus ? 2px : 1px;
                        border-color: Tokens.gold;
                        accessible-role: button;
                        property <string> row-suffix: "-" + i;
                                accessible-id: "sound-library-download-button" + self.row-suffix;
                        accessible-label: @tr("下载音源包");
                        accessible-action-default => { root.download-pack(root.pack-ids[i]); }

                        row-download-focus := FocusScope {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            focus-on-click: false;
                            focus-gained(reason) => { root.focused-row-slot = 400 + i * 10 + 1; }
                            focus-lost(reason) => { if (root.focused-row-slot == 400 + i * 10 + 1) { root.focused-row-slot = -1; } }
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == Key.Space) {
                                    root.download-pack(root.pack-ids[i]);
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }

                        UiText {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: @tr("下载");
                            color: Tokens.gold-bright;
                            font-size: Tokens.font-size-xs;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            width: parent.width;
                            height: parent.height;
                            clicked => { root.download-pack(root.pack-ids[i]); }
                        }
                    }
                }
            }

            // -------------------------------------------------------- 状态行
            Rectangle {
                x: Tokens.space-6;
                y: panel.height - 40px;
                width: root.list-w;
                height: 20px;
                clip: true;

                accessible-role: text;
                accessible-id: "sound-library-status-line";
                accessible-label: @tr("音源管理状态");

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width - (root.retry-shown ? 100px : 0px);
                    height: parent.height;
                    text: root.status;
                    color: root.status-is-error ? Tokens.record-red : Tokens.ink-2;
                    font-size: Tokens.font-size-xs;
                    overflow: elide;
                }

                // 「再试一次」：失败时同一行右侧，点一下重走**同一条**下载路（不是新逻辑）。
                if root.retry-shown : Rectangle {
                    x: parent.width - 96px;
                    y: -4px;
                    width: 96px;
                    height: 28px;
                    background: Tokens.bg-raised;
                    border-radius: Tokens.radius-sm;
                    border-width: status-retry-focus.has-focus ? 2px : 1px;
                    border-color: status-retry-focus.has-focus ? Tokens.gold : Tokens.line;

                    accessible-role: button;
                    accessible-id: "sound-library-download-retry-button";
                    accessible-label: @tr("再试一次");
                    accessible-action-default => { root.download-pack(root.retry-pack-id); }

                    status-retry-focus := FocusScope {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        focus-on-click: false;
                        focus-gained(reason) => { root.focused-row-slot = 600; }
                        focus-lost(reason) => { if (root.focused-row-slot == 600) { root.focused-row-slot = -1; } }
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                root.download-pack(root.retry-pack-id);
                                accept
                            } else {
                                reject
                            }
                        }
                    }

                    UiText {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: @tr("再试一次");
                        color: Tokens.ink-1;
                        font-size: Tokens.font-size-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => { root.download-pack(root.retry-pack-id); }
                    }
                }
            }

            // 关闭（Tab 序末格：槽位 700 —— 放在面板子树的末尾，见焦点一节。
            // 视觉位置不变：x/y 仍是面板右上角。取焦时 2px 金边是可见指示。）
            Rectangle {
                x: parent.width - 36px;
                y: Tokens.space-4;
                width: 24px;
                height: 24px;
                background: Tokens.bg-void;
                border-radius: Tokens.radius-sm;
                border-width: sound-library-close-focus.has-focus ? 2px : 0px;
                border-color: Tokens.gold;
                accessible-role: button;
                accessible-id: "sound-library-close-button";
                accessible-label: @tr("关闭音源管理");
                accessible-action-default => { root.close(); }

                sound-library-close-focus := FocusScope {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.close();
                            accept
                        } else {
                            reject
                        }
                    }
                }

                UiText {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: Tokens.ink-1;
                    font-size: Tokens.font-size-xl;
                    horizontal-alignment: center;
                }

                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    width: parent.width;
                    height: parent.height;
                    clicked => { root.close(); }
                }
            }
        }
    }

    // ---- 焦点读数与轮转（D-UI-19 / T-FIX-182 / T-FIX-217）-------------------
    /// 行槽位：最近一次取焦的行按钮写进来的槽位。`focus-gained` 写，
    /// `focus-lost` 只在值仍是自己时清掉 —— 先失后得 / 先得后失两种顺序都
    /// 安全；`-1` = 焦点不在任何行按钮上。
    in-out property <int> focused-row-slot: -1;
    // 注意：行按钮销毁时不发 `focus-lost` —— 武装 / 取消 / 确认翻转状态会重建
    // 该行按钮，焦点不能留在将死元素上（槽位会 stale，下一次 Tab 会从死焦点
    // 出发乱走）。解法不在这里：每个会销毁本钮的动作在翻转前先把焦点挪到搜索
    // 框（静态锚点），见各按钮的 `key-pressed` / `clicked`。
    /// 槽位表（与树序 = Tab 序一致；行按钮的槽位见各行 `focus-gained`）：
    /// `0` 搜索框 / `100+i*10+{0..5}` 已安装行（删除 / 确认删除 / 取消 /
    /// 体检 / 开始检查 / 不用了）/ `300` 全部下载 / `301` 重试目录 /
    /// `400+i*10+{0,1}` 可下载行（用到当前轨 / 下载）/ `600` 再试一次 /
    /// `700` ✕ 关闭 / `-1` 不在模态内。
    /// 静态锚点（0 / 700）由 `focus-control` 直达；行槽位只能由原生 Tab
    /// 遍历到达 —— Slint 无法从 `for` 循环外按下标取焦重复元素（本文件没有
    /// `focus-next-control` / `focus-previous-control`：它们唯一的调用方是
    /// 陷阱，陷阱现在只在两端包办、中间交给原生遍历）。
    out property <int> focused-control:
        root.focused-row-slot >= 0 ? root.focused-row-slot
        : sound-library-search-input.has-focus ? 0
        : sound-library-close-focus.has-focus ? 700
        : -1;

    /// 打开时由宿主调用：焦点落搜索框（首个可聚焦控件）。
    public function focus-first-control() {
        sound-library-search-input.focus();
    }

    /// 静态锚点的**唯一**一张表：`0` 搜索框 / `700` ✕。行槽位（100–600）
    /// 不在这里 —— 它们只能由原生 Tab 遍历到达，调这里会被静默忽略
    /// （⛔ 不是漏网：见上面 `focused-control` 的注释）。
    public function focus-control(index: int) {
        if (index == 0) {
            sound-library-search-input.focus();
        } else if (index == 700) {
            sound-library-close-focus.focus();
        }
    }

    /// 关窗时由 `MainWindow` 的 `close` 回调调用：`visible:` 门控下组件不重建，
    /// 确认态不会自己复位（`if` 门控时代是重建带来的）⇒ 这里显式清掉。
    public function reset-confirm-state() {
        root.confirm-delete-id = "";
        root.doctor-confirm-id = "";
    }
}
