// 夜半 (Yeban) — AI 编曲提案审核抽屉 (Musical PR Drawer)
//
// 规范来源 (Normative):
//   - 规范 §9.1: AI 建议层交互 (45% 半透明 + 虚线霓虹紫描边 + 置信度徽章)
//   - 规范 §10: 编曲时光机与 AI 提案审查 (Musical PR)
//   - [UI-A11Y-004] / 规范 §10.2: 视觉 Diff **严禁只靠红绿色相**, 必须叠加几何/纹理冗余编码 ——
//     新增=实心+`+` 徽章; 删除=斜线纹理+贯穿删除线; 微调=虚线描边+方向箭头。
//     本文件用**矩形图元**而不是特殊 border-style 来表达这些纹理 (Slint 1.18 的
//     `border-style` 只有 solid, 虚线要用图元拼)。
//   - [UI-TEST-001] §12.2: 语义 Element ID
//
// 静态骨架, **不含演示数据**: 数据面全部由宿主注入（`src/host.rs` 的
// `apply_proposal_drawer`, 来源 `crates/yeban-app/src/proposals.rs`）。
// `Shift+Enter` 采纳 / `Esc` 放弃的键盘路径住在 src/input.rs, 这里只提供可点等价物 ——
// 而那两条键盘路径今天**如实不消费**（`src/host.rs` 的 `action_has_implementation`
// 返回 `false`; `src/cli.rs` 的表里是 `implemented: false`）⇒ 这两个按钮由
// `resolve-available` 把关, 今天恒 `false`, 因此**画不出来**（⛔ 不是画一个按下去
// 只关抽屉的假控件）; 取而代之上屏的是 `resolve-reason` 那句逐字原因。
//
// ⚠ 本文件曾经把三条中文假提案与三个假置信度百分比写成**属性默认值**, 于是界面显示
// "AI 提了 3 条提案, 每条带一个百分比置信度"。那些数字是编造的, 用户分不出真假。这已删除:
// 数据面默认**全空**, 空的时候画一句由宿主给的空态文案（见下面的 `musical-pr-empty-state`）;
// 提案行里那一格也曾写 `"轨道 i · 小节 i+1"`（按**下标**算出来的假读数）, 现在画真实的
// **op 条数**。判据（多路径探针: 源码文本 + 属性默认值 + 运行时树）:
// `src/elements.rs` 的 `musical_pr_drawer_declares_no_demo_proposals` /
// `the_proposal_drawer_is_written_by_the_host_along_one_path`, 与 `tests/live_ui_mcp.rs` 的
// `the_musical_pr_drawer_shows_an_honest_empty_state`。

import { Tokens, UiText, UiMonoText, UiTitleText } from "../tokens.slint";

export component MusicalPrDrawer inherits Rectangle {
    // ---------------------------------------------------------------- 提案数据面
    // 默认**全空**: `0` 条提案 + 三个空数组 + 两句空话。这里刻意**不**放演示数据,
    // 也刻意**不**在这里写字面量文案 —— 空态与"为什么不接线"那两句话的唯一出处是
    // `src/proposals.rs` 的 `NO_SOURCE_REASON` / `NO_OPEN_PROPOSAL_REASON` /
    // `RESOLVE_NOT_WIRED_REASON`（在这里再抄一份就会漂移, 且用户读到的就不再是宿主
    // 断言过的那句）。
    // ⚠ 三个数组必须**等长**: 下面的循环按下标同时读 `kinds` / `titles` /
    // `op-counts`。等长由 `drawer_values` 的唯一构造点保证（判据
    // `drawer_values_keeps_the_three_arrays_the_same_length`）。
    in property <int> proposal-count: 0;
    in property <[string]> proposal-titles: [];
    in property <[string]> proposal-kinds: [];
    in property <[int]> proposal-op-counts: [];
    /// 没有提案时上屏的那句话（宿主按 `has_source` 选①/②）。
    in property <string> empty-reason: "";
    /// 「采纳 / 放弃」此刻**能不能**用（今天恒 `false`：界面侧没有合并提案的写入口）。
    in property <bool> resolve-available: false;
    /// 不能用时逐字上屏的原因。
    in property <string> resolve-reason: "";

    callback accept();
    callback reject();
    callback close();

    background: Tokens.bg-panel;
    border-width: 1px;
    border-color: Tokens.ai-suggestion;
    clip: true;

    accessible-role: region;
    accessible-id: "musical-pr-drawer";
    accessible-label: "AI 编曲提案审核抽屉";
    // 提案条数进 `accessible-value` ⇒ 它是**机器可读**的读数（`ui/tree` / `ui/node` 的
    // `value` 字段, `crates/yeban-ui-test-port/src/inspect.rs:186`）。
    // 零提案时它是 `"0"`。判据 `the_musical_pr_drawer_shows_an_honest_empty_state`
    // 读的就是它 —— "界面说 0 条"因此不是一句注释, 而是一条断言。
    accessible-value: "" + root.proposal-count;

    // ---------------------------------------------------------------- 抽屉头
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 36px;
        background: Tokens.bg-panel-alt;

        UiTitleText {
            x: Tokens.space-4;
            y: 0;
            width: parent.width - 76px;
            height: parent.height;
            text: "AI 编曲提案 (" + root.proposal-count + ")";
            color: Tokens.selection;
            font-size: Tokens.font-size-lg;
        }

        Rectangle {
            x: parent.width - 28px;
            y: 8px;
            width: 20px;
            height: 20px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "musical-pr-close-button";
            accessible-label: "关闭提案抽屉";
            // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
            accessible-action-default => { root.close(); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "×";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-lg;
                horizontal-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.close(); }
            }
        }
    }

    // ---------------------------------------------------------------- 差异语义图例
    // [UI-A11Y-004] 色相 + 几何双编码, 每一条都在图例里显式展示。
    Rectangle {
        x: Tokens.space-4;
        y: 44px;
        width: parent.width - 8px;
        height: 68px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;

        accessible-role: text;
        accessible-id: "musical-pr-diff-legend";
        accessible-label: "视觉差异图例: 新增 / 删除 / 微调";

        // 新增: 实心亮绿 + 右上角 `+`
        Rectangle {
            x: Tokens.space-4;
            y: Tokens.space-4;
            width: 56px;
            height: 16px;
            background: Tokens.diff-added;
            border-radius: Tokens.radius-sm;
        }
        UiText {
            x: 64px;
            y: Tokens.space-4;
            width: 80px;
            height: 16px;
            text: "+ 新增";
            color: Tokens.diff-added;
            font-size: Tokens.font-size-xs;
        }

        // 删除: 粉红底 + 45° 斜线纹理 + 贯穿删除线
        Rectangle {
            x: Tokens.space-4;
            y: 28px;
            width: 56px;
            height: 16px;
            background: Tokens.diff-removed;
            border-radius: Tokens.radius-sm;
        }
        for hatch_index in 5 : Rectangle {
            x: Tokens.space-4 + 11px * hatch_index;
            y: 28px;
            width: 1px;
            height: 16px;
            background: Tokens.bg-void;
        }
        Rectangle {
            x: Tokens.space-4;
            y: 35px;
            width: 56px;
            height: 1px;
            background: Tokens.bg-void;
        }
        UiText {
            x: 64px;
            y: 28px;
            width: 80px;
            height: 16px;
            text: "删除";
            color: Tokens.diff-removed;
            font-size: Tokens.font-size-xs;
        }

        // 微调: 琥珀黄 + 虚线描边 + 方向箭头
        Rectangle {
            x: 152px;
            y: Tokens.space-4;
            width: 56px;
            height: 16px;
            background: Tokens.bg-void;
            border-width: 1px;
            border-color: Tokens.diff-tweaked;
            border-radius: Tokens.radius-sm;
        }
        for dash_index in 5 : Rectangle {
            x: 156px + 11px * dash_index;
            y: Tokens.space-4;
            width: 5px;
            height: 1px;
            background: Tokens.diff-tweaked;
        }
        UiText {
            x: 216px;
            y: Tokens.space-4;
            width: 96px;
            height: 16px;
            text: "↑ 微调";
            color: Tokens.diff-tweaked;
            font-size: Tokens.font-size-xs;
        }

        UiMonoText {
            x: 152px;
            // ⭐ 任务单 `#189`：原来是 `y: 28px` —— 与上一行「↑ 微调」（`y: 16..32`，
            // 横跨 `x: 216..312`）的包围盒竖向重叠 4px。图例行高 16、两条横排各占一行：
            // 28px 是"第三行"的起点，与第二行的 16px 行高撞上。挪到 40px（40 + 16 = 56 ≤
            // 图例高 68），与 `16..32` / `28..44` 两行都不再相交。
            y: 40px;
            width: parent.width - 160px;
            height: 16px;
            text: "遮罩 #000000 (无头截图动态区域)";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }
    }

    // ---------------------------------------------------------------- 空态
    // 没有提案 ⇒ 界面**说真话**。这一句是**用户可见**的: 源码里的自陈用户看不见,
    // 所以诚实必须落在图元上。句子本身**不在这里写**（见上面数据面的注释：唯一出处是
    // `src/proposals.rs`, 宿主按"有没有来源"选那两句之一）。
    // 先例（本仓既有的同款做法）: `ui/console/device_rack.slint` 的
    // `device-plugin-host-placeholder-card` —— 一张卡片, 可见文本与 `accessible-label`
    // 都写"未实现", 颜色用次级墨色 `Tokens.ink-2`。
    // 本块借了: 可见文本 + `accessible-label` 双份陈述, 次级墨色, 卡片几何。
    // 本块弃了: 把它做成 `list-item`（它不是列表条目, 去掉更准; 故用 `text`）。
    if root.proposal-count == 0 : Rectangle {
        x: Tokens.space-4;
        y: 124px;
        width: parent.width - 8px;
        height: 48px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;

        accessible-role: text;
        accessible-id: "musical-pr-empty-state";
        accessible-label: root.empty-reason;

        UiText {
            x: Tokens.space-4;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: root.empty-reason;
            color: Tokens.ink-2;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }
    }

    // ---------------------------------------------------------------- 提案列表
    // 规模由**数据**决定（不是固定的 `for … in 3`）: 数组为空 ⇒ 这一族一个节点都不在树里。
    for proposal_kind[proposal_index] in root.proposal-kinds : Rectangle {
        x: Tokens.space-4;
        y: 124px + 56px * proposal_index;
        width: parent.width - 8px;
        height: 48px;
        background: proposal_index.mod(2) == 0 ? Tokens.bg-panel-alt : Tokens.bg-panel;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;
        accessible-role: list-item;
        accessible-id: "musical-pr-proposal-" + proposal_index + "-item";
        accessible-label: proposal_kind + ": " + root.proposal_titles[proposal_index];
        accessible-item-index: proposal_index;
        accessible-item-count: root.proposal-count;
        accessible-item-selectable: true;
        accessible-item-selected: false;

        // 这一格原来是**置信度徽章** (§9.1)。`confidence` 在 `yeban-mcp` /
        // `yeban-model` / `yeban-theory` 的源码里实测 0 处命中 ⇒ 任何百分比都只能是
        // 编造的, 因此换成领域里真实存在的那个数：本提案携带的 **op 条数**。
        Rectangle {
            x: 6px;
            y: 6px;
            width: 36px;
            height: 16px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.ai-suggestion;

            accessible-role: text;
            accessible-id: "musical-pr-proposal-" + proposal_index + "-ops";
            accessible-label: "本提案携带 " + root.proposal_op_counts[proposal_index] + " 条 op";

            UiMonoText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "" + root.proposal_op_counts[proposal_index];
                color: Tokens.ai-suggestion;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }
        }

        UiText {
            x: 48px;
            y: 4px;
            width: parent.width - 56px;
            height: 18px;
            text: proposal_kind + " · " + root.proposal_titles[proposal_index];
            color: Tokens.ink-0;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }

        // ⚠ 这一行原来写 `"轨道 " + proposal_index + " · 小节 " + (proposal_index + 1)`
        // —— 两个数都是从提案**下标**算出来的, 领域里没有这两个读数（提案承载的是 op
        // 批次, 不是单条轨道上的单条剪辑）。整行删除; op 条数已在上面的徽章里。
    }

    // ---------------------------------------------------------------- 采纳 / 放弃
    // ⚠ 两个按钮的**可点等价物**由 `resolve-available` 把关, 今天恒 `false`。
    // 理由不是"忘了接"：领域侧的 `yeban_merge_proposal` / `yeban_reject_proposal` 要
    // `proposalId`, 而宿主的 `HostAction` 只有 `Undo` / `Redo` / `Commit` 三臂 ⇒ 界面
    // 侧没有合并提案的写入口。上一轮已裁定 `Shift+Enter → 采纳 AI 建议` 不许假装实现
    // （`src/cli.rs` 的 `implemented: false` + `src/host.rs` 的
    // `action_has_implementation` 如实返回 `false`）⇒ 这里同款：不画假控件。
    if root.resolve-available : Rectangle {
        x: Tokens.space-4;
        y: parent.height - 40px;
        width: (parent.width - 16px) / 2;
        height: 28px;
        background: Tokens.bg-raised;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.diff-added;
        accessible-role: button;
        accessible-id: "musical-pr-accept-button";
        accessible-label: "采纳提案 (Shift+Enter)";
        // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
        accessible-action-default => { root.accept(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "采纳 (Shift+Enter)";
            color: Tokens.diff-added;
            font-size: Tokens.font-size-sm;
            horizontal-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.accept(); }
        }
    }

    if root.resolve-available : Rectangle {
        x: Tokens.space-4 + (parent.width - 16px) / 2 + Tokens.space-2;
        y: parent.height - 40px;
        width: (parent.width - 16px) / 2;
        height: 28px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.diff-removed;
        accessible-role: button;
        accessible-id: "musical-pr-reject-button";
        accessible-label: "放弃提案 (Esc)";
        // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
        accessible-action-default => { root.reject(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "放弃 (Esc)";
            color: Tokens.diff-removed;
            font-size: Tokens.font-size-sm;
            horizontal-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.reject(); }
        }
    }

    // ------------------------------------------------ 有提案、但**没有写入口**的那句话
    // 上面两个按钮不画时，底部不能留白：留白会被读成"这里本来没有控件"。这一格把
    // **为什么**没有控件说出来（`resolve-reason` 逐字, 出处 `src/proposals.rs` 的
    // `RESOLVE_NOT_WIRED_REASON`）。先例同 `musical-pr-empty-state`。
    if root.proposal-count > 0 && !root.resolve-available : Rectangle {
        x: Tokens.space-4;
        y: parent.height - 76px;
        width: parent.width - 8px;
        height: 64px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;

        accessible-role: text;
        accessible-id: "musical-pr-resolve-unavailable";
        accessible-label: root.resolve-reason;

        UiText {
            x: Tokens.space-4;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: root.resolve-reason;
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}
