import { Theme, TrackData, PianoStepRow, PianoRollNote, Tokens, TooltipBubble } from "tokens.slint";
import { PianoRoll } from "console/piano_roll.slint";

export component UnifiedLowerDock inherits Rectangle {
    in-out property <string> active-tab: "devices"; // "devices" | "mixer" | "pianoroll" | "stacked"
    in-out property <color> selected-track-color: #387691;
    in-out property <string> focus-track-name: "01. Lead Neuro Bass";
    in-out property <[TrackData]> tracks;
    in-out property <int> selected-track-id: 1;

    // Wavetable device params
    in-out property <int> wt-pos-val: 64;
    in-out property <int> wt-cutoff-hz: 4800;
    in-out property <int> wt-reso-val: 35;

    // EQ device params
    in-out property <string> eq-low-db: "+2.4dB";
    in-out property <string> eq-mid-db: "-1.8dB";
    in-out property <string> eq-air-db: "+3.5dB";

    // Compressor device params
    in-out property <float> comp-gr-fraction: 0.34;
    in-out property <string> comp-gr-text: "-4.2 dB";

    // Traditional Piano Roll State & Notes
    in-out property <int> roll-tool: 1; // 1: Select, 2: Pencil, 3: Split, 4: Erase
    in-out property <string> roll-snap: "1/16";
    in-out property <bool> show-velocity: true;
    in-out property <int> selected-note-id: 1;
    in-out property <bool> scale-folded: true;
    in-out property <length> playhead-px: 168px;
    in-out property <[PianoRollNote]> notes: [
        { id: 1, pitch_row: 0,  pitch_name: "C5",  start_step: 0,  step_span: 2, velocity: 108, selected: true },
        { id: 2, pitch_row: 5,  pitch_name: "G4",  start_step: 2,  step_span: 2, velocity: 92,  selected: false },
        { id: 3, pitch_row: 9,  pitch_name: "Eb4", start_step: 4,  step_span: 3, velocity: 100, selected: false },
        { id: 4, pitch_row: 12, pitch_name: "C4",  start_step: 7,  step_span: 1, velocity: 85,  selected: false },
        { id: 5, pitch_row: 0,  pitch_name: "C5",  start_step: 8,  step_span: 2, velocity: 112, selected: false },
        { id: 6, pitch_row: 2,  pitch_name: "Bb4", start_step: 10, step_span: 2, velocity: 96,  selected: false },
        { id: 7, pitch_row: 5,  pitch_name: "G4",  start_step: 12, step_span: 2, velocity: 104, selected: false },
        { id: 8, pitch_row: 9,  pitch_name: "Eb4", start_step: 14, step_span: 2, velocity: 90,  selected: false }
    ];

    in-out property <[PianoStepRow]> piano-rows: [
        { pitch_name: "C4 (Root)", is_root: true,  step0: true,  step1: false, step2: false, step3: true,  step4: false, step5: true,  step6: false, step7: false, step8: true,  step9: false, step10: false, step11: true,  step12: false, step13: true,  step14: false, step15: false },
        { pitch_name: "Bb3 (m7)",  is_root: false, step0: false, step1: true,  step2: false, step3: false, step4: true,  step5: false, step6: false, step7: true,  step8: false, step9: true,  step10: false, step11: false, step12: true,  step13: false, step14: false, step15: true  },
        { pitch_name: "Ab3 (b6)",  is_root: false, step0: false, step1: false, step2: true,  step3: false, step4: false, step5: false, step6: true,  step7: false, step8: false, step9: false, step10: true,  step11: false, step12: false, step13: false, step14: true,  step15: false },
        { pitch_name: "G3 (5th)",  is_root: false, step0: true,  step1: false, step2: false, step3: false, step4: true,  step5: false, step6: false, step7: false, step8: true,  step9: false, step10: false, step11: false, step12: true,  step13: false, step14: false, step15: false },
        { pitch_name: "Eb3 (m3)",  is_root: false, step0: false, step1: false, step2: true,  step3: false, step4: false, step5: true,  step6: false, step7: false, step8: false, step9: false, step10: true,  step11: false, step12: false, step13: true,  step14: false, step15: false },
        { pitch_name: "C3 (Sub)",  is_root: true,  step0: true,  step1: false, step2: false, step3: false, step4: false, step5: false, step6: false, step7: false, step8: true,  step9: false, step10: false, step11: false, step12: false, step13: false, step14: false, step15: false }
    ];

    callback select-tab(string);
    callback select-track(int);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback track-volume-change(int, float);
    callback set-wt-pos(int);
    callback set-wt-cutoff(int);
    callback toggle-piano-step(int, int);
    callback toggle-scale-fold(bool);
    callback piano-key-clicked(string, int);
    callback select-note(int);
    callback canvas-create-note(int, int);
    callback canvas-clicked(int, int);
    callback split-note(int);
    callback delete-note(int);
    callback velocity-changed(int, int);
    callback console-maximize-toggle();
    // 真实 PianoRoll 的回调（与 host::wire_roll_edit 注册的旧回调同名，只做透传）。
    callback scroll-requested(length);
    callback clicked(length, length);
    callback double-clicked(length, length);
    callback tool-selected(int);
    callback note-drag-grab(length, length) -> bool;
    callback note-drag-move(length, length);
    callback note-drag-release(length, length);
    callback note-drag-cancel();
    callback humanize-requested();
    callback quantize-requested();

    // ⭐ 真实钢琴卷帘的数据面：全部由 host::apply_view 注入（同一份投影），
    // 界面⛔ 不再持有演示音符数组、⛔ 不再用 16×64 的假网格。
    in-out property <[string]> note-ulids;
    in-out property <[float]> note-velocities;
    in-out property <[length]> note-positions;
    in-out property <[length]> note-widths;
    in-out property <[length]> note-ys;
    in-out property <[bool]> note-selected;
    in-out property <int> playhead-ticks: 0;
    in-out property <int> ticks-per-pixel: 30;
    in-out property <float> scroll-x: 0.0;
    in-out property <string> playhead-timecode: "";
    in-out property <int> active-tool: 1;
    in-out property <string> roll-edit-status: "";
    in-out property <string> note-drag-ulid: "";
    in-out property <float> note-drag-preview-dx: 0.0;
    in-out property <float> note-drag-preview-dy: 0.0;
    in-out property <float> note-drag-preview-velocity: 0.0;

    in-out property <bool> console-maximized: false;
    property <bool> is-maximized: root.console-maximized;
    in-out property <length> dock-height: 320px;
    min-height: root.console-maximized ? 0px : root.dock-height;
    max-height: root.console-maximized ? 100000px : root.dock-height;
    vertical-stretch: root.console-maximized ? 1 : 0;
    background: Theme.bg-panel;
    border-color: Theme.border-subtle;
    accessible-role: region;
    accessible-id: "console-tab-rail";
    accessible-label: "底部控制台";

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // DOCK TAB BAR
        Rectangle {
            height: 34px;
            background: #080a10;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        background: root.active-tab == "stacked" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "设备堆叠";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "stacked" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        tab_stk_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tab("stacked"); }
                        }
                        TooltipBubble { text: "效果器与调音台双层堆叠视图 [Alt+S]"; is-visible: tab_stk_touch.has-hover; tip-offset-y: 28px; }
                    }

                    Rectangle {
                        background: root.active-tab == "devices" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "设备机架";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "devices" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        tab_dev_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tab("devices"); }
                        }
                        TooltipBubble { text: "效果器与虚拟乐器机架 [D]"; is-visible: tab_dev_touch.has-hover; tip-offset-y: 28px; }
                    }

                    Rectangle {
                        background: root.active-tab == "mixer" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "混音控制台";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "mixer" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        tab_mix_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tab("mixer"); }
                        }
                        TooltipBubble { text: "多轨混音控制台 [X]"; is-visible: tab_mix_touch.has-hover; tip-offset-y: 28px; }
                    }

                    Rectangle {
                        background: root.active-tab == "pianoroll" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "钢琴卷帘";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "pianoroll" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        tab_pr_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tab("pianoroll"); }
                        }
                        TooltipBubble { text: "MPE 钢琴卷帘编辑器 [P]"; is-visible: tab_pr_touch.has-hover; tip-offset-y: 28px; }
                    }
                }

                // Focus track badge & Maximize toggle
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Rectangle {
                        background: root.selected-track-color.with-alpha(0.15);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.selected-track-color.with-alpha(0.40);
                        height: 24px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.selected-track-color; }
                            Text {
                                text: "聚焦: " + root.focus-track-name;
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                font-weight: 700;
                                color: root.selected-track-color;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Console Maximize / Restore Button
                    Rectangle {
                        accessible-id: "console-maximize-button";
                        accessible-role: button;
                        accessible-label: "最大化 / 还原底部控制台";
                        accessible-checked: root.console-maximized;
                        accessible-action-default => { root.console-maximize-toggle(); }
                        width: 26px;
                        height: 24px;
                        background: max_btn_touch.has-hover ? #22293a : (root.console-maximized ? Theme.accent.with-alpha(0.25) : #121622);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.console-maximized ? Theme.accent : #ffffff18;

                        if !root.console-maximized : Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            stroke: max_btn_touch.has-hover ? #ffffff : #94a3b8;
                            stroke-width: 1.5px;
                            commands: "M 1 4 L 1 1 L 4 1 M 8 1 L 11 1 L 11 4 M 11 8 L 11 11 L 8 11 M 4 11 L 1 11 L 1 8";
                        }
                        if root.console-maximized : Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            stroke: Theme.accent;
                            stroke-width: 1.5px;
                            commands: "M 4 1 L 4 4 L 1 4 M 8 1 L 8 4 L 11 4 M 11 8 L 8 8 L 8 11 M 4 11 L 4 8 L 1 8";
                        }

                        max_btn_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.console-maximize-toggle(); }
                        }
                        TooltipBubble {
                            text: root.console-maximized ? "退出最大化 / 还原 [Cmd/Ctrl+Alt+M / F3]" : "最大化全屏此视图 (卷帘/混音台) [Cmd/Ctrl+Alt+M / F3]";
                            is-visible: max_btn_touch.has-hover;
                            tip-offset-x: -80px;
                            tip-offset-y: 26px;
                        }
                    }
                }
            }
        }

        // DOCK BODY CONTENT (Panes)
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            vertical-stretch: 1;

            // PANE: INLINE DSP DEVICES (Visible in stacked or devices mode)
            if root.active-tab == "stacked" || root.active-tab == "devices" : HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Device 1: Wavetable MPE Synth (Fixed studio module width: 250px)
                Rectangle {
                    width: 250px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                                Text {
                                    text: "Wavetable MPE";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "OSC 1+2";
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                letter-spacing: 0.8px;
                                color: Theme.accent;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // 3D Morph Wave SVG (stretches to fill device width)
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;
                            clip: true;

                            Path {
                                commands: "M 0 55 Q 40 20, 80 50 T 160 30 T 240 45 T 320 28 T 400 48 T 480 32 T 560 46 T 640 38";
                                stroke: Theme.accent.with-alpha(0.35);
                                stroke-width: 1.5px;
                            }
                            Path {
                                commands: "M 0 35 Q 40 8, 80 35 T 160 15 T 240 30 T 320 18 T 400 35 T 480 20 T 560 32 T 640 25";
                                stroke: Theme.accent;
                                stroke-width: 2.0px;
                            }
                            Path {
                                commands: "M 0 60 Q 50 30, 100 55 T 200 38 T 300 52 T 400 36 T 500 50 T 600 42";
                                stroke: #347864.with-alpha(0.35);
                                stroke-width: 1.5px;
                            }

                            HorizontalLayout {
                                x: 8px;
                                y: 56px;
                                width: parent.width - 16px;
                                alignment: space-between;
                                Text {
                                    text: "POS: " + root.wt-pos-val + "%";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    font-weight: 700;
                                    color: Theme.accent;
                                }
                                Text {
                                    text: "UNISON: 4 Voices";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Quick Knobs / Sliders
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "WT Pos";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-pos-val + "%";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        horizontal-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.wt-pos-val = root.wt-pos-val == 64 ? 85 : 64;
                                        root.set-wt-pos(root.wt-pos-val);
                                    }
                                }
                            }

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "Cutoff";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-cutoff-hz + "Hz";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: #347864;
                                        horizontal-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.wt-cutoff-hz = root.wt-cutoff-hz == 4800 ? 8200 : 4800;
                                        root.set-wt-cutoff(root.wt-cutoff-hz);
                                    }
                                }
                            }

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "Reso";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-reso-val + "%";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: #9a6a38;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Device 2: Pro-QLinear 8-band Dynamic EQ (Fixed studio module width: 280px)
                Rectangle {
                    width: 280px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #347864; }
                                Text {
                                    text: "Pro-QLinear 8 (动态 EQ)";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "" + root.wt-cutoff-hz + " Hz";
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                color: #347864;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // EQ Curve + Spectrum Display
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;
                            clip: true;

                            // 0dB Center Axis & Frequency Reference Lines
                            Rectangle {
                                x: 0;
                                y: 36px;
                                width: parent.width;
                                height: 1px;
                                background: #ffffff0a;
                            }

                            // Spectrum Bars (Natural acoustic curve)
                            HorizontalLayout {
                                x: 4px;
                                y: 12px;
                                width: parent.width - 8px;
                                height: 52px;
                                spacing: 2px;
                                alignment: center;

                                for h in [14px, 20px, 32px, 44px, 38px, 46px, 34px, 28px, 36px, 42px, 30px, 24px, 18px, 26px, 20px, 14px, 16px, 22px, 34px, 42px, 35px, 26px, 18px, 12px] : Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 3px;
                                    max-width: 8px;
                                    height: h;
                                    background: #34786422;
                                    border-radius: 1px;
                                }
                            }

                            // Dynamic Filter Curve Path (Smooth Bezier curve across spectrum)
                            Path {
                                commands: "M 0 52 Q 60 46, 120 22 T 240 32 T 360 20 T 480 38 T 600 52";
                                stroke: #347864;
                                stroke-width: 2.0px;
                            }

                            // 4 Parametric EQ Filter Nodes
                            Rectangle {
                                x: 60px;
                                y: 44px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: Theme.accent;
                            }
                            Rectangle {
                                x: 120px;
                                y: 20px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #347864;
                            }
                            Rectangle {
                                x: 240px;
                                y: 30px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #9a6a38;
                            }
                            Rectangle {
                                x: 360px;
                                y: 18px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #705e88;
                            }
                        }

                        // Low / Mid / Air readouts
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "LOW: " + root.eq-low-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "MID: " + root.eq-mid-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #347864;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "AIR: " + root.eq-air-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #9a6a38;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Device 3: VCA Glue Compressor (Fixed studio module width: 240px)
                Rectangle {
                    width: 240px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #9a6a38; }
                                Text {
                                    text: "VCA Glue Comp";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "GR " + root.comp-gr-text;
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                color: #9a6a38;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // GR Meter Box
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;

                            VerticalLayout {
                                padding: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    Text {
                                        text: "GAIN REDUCTION";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        letter-spacing: 0.8px;
                                        color: #64748b;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: root.comp-gr-text;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 800;
                                        color: #9a6a38;
                                        horizontal-alignment: right;
                                    }
                                }

                                Rectangle {
                                    height: 8px;
                                    background: #06080d;
                                    border-radius: 4px;
                                    Rectangle {
                                        x: 0;
                                        width: root.comp-gr-fraction * parent.width;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: #9a6a38;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Atk: 10ms";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                    Text {
                                        text: "Rel: Auto";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                    Text {
                                        text: "Ratio: 4:1";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Thresh: -16dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #cbd5e1;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Makeup: +4.5dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #cbd5e1;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // PANE: MIXCONSOLE (Visible in stacked or mixer mode - fixed channel strip dimensions)
            if root.active-tab == "stacked" || root.active-tab == "mixer" : Rectangle {
                horizontal-stretch: root.active-tab == "stacked" ? 2 : 1;
                min-width: root.active-tab == "stacked" ? 400px : 560px;
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    alignment: start;
                    padding: 6px;
                    spacing: 6px;

                    // Channel Fader Strips (Fixed studio width: 82px)
                    for trk in root.tracks : Rectangle {
                        width: 82px;
                        vertical-stretch: 1;
                        background: #080a10;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: trk.id == root.selected-track-id ? Theme.accent : #191f2c;
                        clip: true;

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: start;

                            // 1. Color / Name Badge
                            Rectangle {
                                height: 18px;
                                background: trk.color.with-alpha(0.18);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: trk.color.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: #e2e8f0;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // 2. Input Gain / Phase (Revealed when maximized)
                            if root.console-maximized : Rectangle {
                                height: 16px;
                                background: #0c0f17;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    spacing: 2px;
                                    alignment: space-between;

                                    Text {
                                        text: "IN: 0.0dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        color: #94a3b8;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        width: 14px;
                                        height: 12px;
                                        border-radius: 1.5px;
                                        background: #141923;
                                        Text {
                                            text: "Ø";
                                            font-family: Tokens.font-mono;
                                            font-size: 7.5px;
                                            font-weight: 800;
                                            color: #cbd5e1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 3. Insert Slots
                            Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: trk.insert1 != "" ? trk.insert1 : "1: None";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.console-maximized : Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: trk.insert2 != "" ? trk.insert2 : "2: —";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.console-maximized : Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: trk.insert3 != "" ? trk.insert3 : "3: —";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.console-maximized : Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "4: Dyn Comp";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #64748b;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // 4. EQ Curve Preview (Revealed when maximized)
                            if root.console-maximized : Rectangle {
                                height: 30px;
                                background: #07090e;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #191f2c;
                                clip: true;

                                Path {
                                    width: parent.width;
                                    height: parent.height;
                                    stroke: trk.color;
                                    stroke-width: 1.2px;
                                    commands: "M 0 18 Q 20 8, 38 16 T 55 12 T 72 20";
                                }

                                Text {
                                    x: 3px;
                                    y: 2px;
                                    text: "EQ";
                                    font-family: Tokens.font-mono;
                                    font-size: 6.5px;
                                    font-weight: 700;
                                    color: #475569;
                                }
                            }

                            // 5. Aux Sends A / B (Revealed when maximized)
                            if root.console-maximized : Rectangle {
                                height: 26px;
                                background: #0c0f17;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;

                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 1px;

                                    HorizontalLayout {
                                        padding-left: 2px;
                                        padding-right: 2px;
                                        alignment: space-between;
                                        Text { text: "SND A"; font-family: Tokens.font-mono; font-size: 6.5px; color: #64748b; }
                                        Text { text: "-12.0dB"; font-family: Tokens.font-mono; font-size: 6.5px; color: Theme.accent; }
                                    }

                                    HorizontalLayout {
                                        padding-left: 2px;
                                        padding-right: 2px;
                                        alignment: space-between;
                                        Text { text: "SND B"; font-family: Tokens.font-mono; font-size: 6.5px; color: #64748b; }
                                        Text { text: "-8.5dB"; font-family: Tokens.font-mono; font-size: 6.5px; color: #a78bfa; }
                                    }
                                }
                            }

                            // 6. M / S / Pan
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: space-between;
                                height: 16px;
                                HorizontalLayout {
                                    spacing: 2px;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: trk.muted ? #9a6a38 : #12151e;
                                        border-width: 1px;
                                        border-color: trk.muted ? #825828 : #ffffff10;
                                        Text {
                                            text: "M";
                                            font-family: Tokens.font-mono;
                                            font-size: 7px;
                                            font-weight: 800;
                                            color: trk.muted ? #020617 : #94a3b8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        m_touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.toggle-track-mute(trk.id); }
                                        }
                                        TooltipBubble { text: "静音此音轨"; is-visible: m_touch.has-hover; tip-offset-y: -22px; }
                                    }
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: trk.soloed ? Theme.accent : #12151e;
                                        border-width: 1px;
                                        border-color: trk.soloed ? Theme.accent : #ffffff10;
                                        Text {
                                            text: "S";
                                            font-family: Tokens.font-mono;
                                            font-size: 7px;
                                            font-weight: 800;
                                            color: trk.soloed ? #020617 : #94a3b8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        s_touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.toggle-track-solo(trk.id); }
                                        }
                                        TooltipBubble { text: "独奏此音轨"; is-visible: s_touch.has-hover; tip-offset-y: -22px; }
                                    }
                                }
                                Text {
                                    text: trk.pan;
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            // 7. Fader + Meter Unit (Fixed 88px height, studio standard)
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                height: 88px;

                                // Vertical Fader Rail
                                Rectangle {
                                    width: 24px;
                                    height: 88px;
                                    background: #06080d;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;

                                    // Center fader track groove
                                    Rectangle {
                                        x: 10px;
                                        y: 4px;
                                        width: 4px;
                                        height: parent.height - 8px;
                                        background: #000000;
                                        border-radius: 1px;
                                    }

                                    // dB scale ticks on sides
                                    for tick_y in [14px, 28px, 42px, 56px, 70px] : Rectangle {
                                        x: 3px;
                                        y: tick_y;
                                        width: 18px;
                                        height: 1px;
                                        background: #ffffff10;
                                    }

                                    // Tactile fader cap
                                    Rectangle {
                                        x: 1px;
                                        y: Math.max(2px, Math.min(parent.height - 18px, 4px + (parent.height - 24px) * (1.0 - Math.max(0.0, Math.min(1.0, (trk.volume_db + 60.0) / 66.0)))));
                                        width: 22px;
                                        height: 15px;
                                        background: #94a3b8;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: #cbd5e1;

                                        Rectangle {
                                            x: 0;
                                            y: 6.5px;
                                            width: parent.width;
                                            height: 2px;
                                            background: trk.color;
                                        }
                                    }

                                    trk_fader_touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.select-track(trk.id);
                                            root.track-volume-change(trk.id, trk.volume_db == -2.5 ? 0.0 : -2.5);
                                        }
                                    }
                                    TooltipBubble { text: "推子: " + trk.volume_db + " dB (点击切换 0dB)"; is-visible: trk_fader_touch.has-hover; tip-offset-x: -20px; tip-offset-y: -22px; }
                                }

                                // Level Meter Bar
                                Rectangle {
                                    width: 6px;
                                    height: 88px;
                                    background: #06080d;
                                    border-radius: 1px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    clip: true;

                                    Rectangle {
                                        x: 0;
                                        y: parent.height - (trk.meter_peak * parent.height);
                                        width: 6px;
                                        height: trk.meter_peak * parent.height;
                                        background: trk.meter_peak > 0.8 ? Theme.status-warn : Theme.status-ok;
                                        border-radius: 1px;
                                    }
                                }
                            }

                            // 8. Compact Centered Volume dB Readout (Standard DAW convention)
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 50px;
                                    height: 17px;
                                    background: #080c14;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "" + trk.volume_db + " dB";
                                            font-family: Tokens.font-mono;
                                            font-size: 8.5px;
                                            font-weight: 700;
                                            color: trk.color;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 9. Output Bus Routing (Revealed when maximized)
                            if root.console-maximized : Rectangle {
                                height: 16px;
                                background: #0c0f17;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    alignment: center;
                                    Text {
                                        text: trk.bus != "" ? ("→ " + trk.bus) : "→ Master Bus";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        color: #64748b;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        TouchArea { clicked => { root.select-track(trk.id); } }
                    }

                    // Optional Group Bus Strip in Mixer mode (Fixed width: 88px)
                    if root.active-tab == "mixer" : Rectangle {
                        width: 88px;
                        vertical-stretch: 1;
                        background: #080a10;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.track-bus.with-alpha(0.40);
                        clip: true;

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: start;

                            // Header
                            Rectangle {
                                height: 18px;
                                background: Theme.track-bus.with-alpha(0.20);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.track-bus.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "BUS SUM";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 800;
                                        color: Theme.track-bus;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Input Trim (when maximized)
                            if root.console-maximized : Rectangle {
                                height: 16px;
                                background: #0c0f17;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    alignment: center;
                                    Text {
                                        text: "TRIM: 0.0dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        color: #94a3b8;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Inserts
                            Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "Tape Saturator";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.console-maximized : Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "Bus Compressor";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.console-maximized : Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "Linear Phase EQ";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #64748b;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Aux Sends (when maximized)
                            if root.console-maximized : Rectangle {
                                height: 16px;
                                background: #0c0f17;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    alignment: space-between;
                                    Text { text: "SND A"; font-family: Tokens.font-mono; font-size: 6.5px; color: #64748b; }
                                    Text { text: "-14.0dB"; font-family: Tokens.font-mono; font-size: 6.5px; color: Theme.track-bus; }
                                }
                            }

                            // Pan / Title
                            HorizontalLayout {
                                alignment: center;
                                height: 16px;
                                Text {
                                    text: "BUS 1+2";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Bus Fader + Meter Unit (Fixed 88px)
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                height: 88px;

                                Rectangle {
                                    width: 24px;
                                    height: 88px;
                                    background: #06080d;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;

                                    Rectangle {
                                        x: 10px;
                                        y: 4px;
                                        width: 4px;
                                        height: parent.height - 8px;
                                        background: #000000;
                                        border-radius: 1px;
                                    }

                                    for tick_y in [14px, 28px, 42px, 56px, 70px] : Rectangle {
                                        x: 3px;
                                        y: tick_y;
                                        width: 18px;
                                        height: 1px;
                                        background: #ffffff10;
                                    }

                                    Rectangle {
                                        x: 1px;
                                        y: 30px;
                                        width: 22px;
                                        height: 15px;
                                        background: #94a3b8;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: #cbd5e1;

                                        Rectangle {
                                            x: 0;
                                            y: 6.5px;
                                            width: parent.width;
                                            height: 2px;
                                            background: Theme.track-bus;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 6px;
                                    height: 88px;
                                    background: #06080d;
                                    border-radius: 1px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    clip: true;

                                    Rectangle {
                                        x: 0;
                                        y: parent.height - 48px;
                                        width: 6px;
                                        height: 48px;
                                        background: Theme.status-ok;
                                        border-radius: 1px;
                                    }
                                }
                            }

                            // Compact Centered Bus Volume dB Readout
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 50px;
                                    height: 17px;
                                    background: #080c14;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "-1.0 dB";
                                            font-family: Tokens.font-mono;
                                            font-size: 8.5px;
                                            font-weight: 700;
                                            color: Theme.track-bus;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Output Bus Routing (when maximized)
                            if root.console-maximized : Rectangle {
                                height: 16px;
                                background: #0c0f17;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    alignment: center;
                                    Text {
                                        text: "→ Master Bus";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        color: #64748b;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Dedicated Master 2-Bus Channel Strip on Mixer Right (Fixed width: 92px)
                    Rectangle {
                        width: 92px;
                        vertical-stretch: 1;
                        background: #05070c;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.35);
                        clip: true;

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: start;

                            // Master Badge
                            Rectangle {
                                height: 18px;
                                background: Theme.accent.with-alpha(0.20);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.accent.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "MASTER 2-BUS";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Master Limiter
                            Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "TruePeak Limit";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.console-maximized : Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "Multiband Max";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.console-maximized : Rectangle {
                                height: 15px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "Analytic Scope";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #64748b;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Master Pan & Mono
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: space-between;
                                height: 16px;
                                Rectangle {
                                    width: 32px;
                                    height: 16px;
                                    border-radius: 2px;
                                    background: #10141d;
                                    Text {
                                        text: "MONO";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 700;
                                        color: #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "0 dBTP";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    color: #347864;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Master Vertical Fader + Stereo Meter Unit (Fixed 88px)
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                height: 88px;

                                Rectangle {
                                    width: 24px;
                                    height: 88px;
                                    background: #040509;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;

                                    Rectangle {
                                        x: 10px;
                                        y: 4px;
                                        width: 4px;
                                        height: parent.height - 8px;
                                        background: #000000;
                                        border-radius: 1px;
                                    }

                                    for tick_y in [14px, 28px, 42px, 56px, 70px] : Rectangle {
                                        x: 3px;
                                        y: tick_y;
                                        width: 18px;
                                        height: 1px;
                                        background: #ffffff10;
                                    }

                                    Rectangle {
                                        x: 1px;
                                        y: 26px;
                                        width: 22px;
                                        height: 15px;
                                        background: #cbd5e1;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: #ffffff;

                                        Rectangle {
                                            x: 0;
                                            y: 6.5px;
                                            width: parent.width;
                                            height: 2px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                // Stereo Master Meter Bar
                                Rectangle {
                                    width: 10px;
                                    height: 88px;
                                    background: #040509;
                                    border-radius: 1px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    clip: true;

                                    HorizontalLayout {
                                        spacing: 1px;
                                        Rectangle {
                                            width: 4px;
                                            height: 88px;
                                            Rectangle {
                                                x: 0;
                                                y: parent.height - 56px;
                                                width: 4px;
                                                height: 56px;
                                                background: Theme.status-ok;
                                            }
                                        }
                                        Rectangle {
                                            width: 4px;
                                            height: 88px;
                                            Rectangle {
                                                x: 0;
                                                y: parent.height - 52px;
                                                width: 4px;
                                                height: 52px;
                                                background: Theme.status-ok;
                                            }
                                        }
                                    }
                                }
                            }

                            // Compact Centered Master Volume dB Readout
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 50px;
                                    height: 17px;
                                    background: #080c14;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "-0.3 dB";
                                            font-family: Tokens.font-mono;
                                            font-size: 8.5px;
                                            font-weight: 800;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Monitor Out (when maximized)
                            if root.console-maximized : Rectangle {
                                height: 16px;
                                background: #0c0f17;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    alignment: center;
                                    Text {
                                        text: "48k / 24-bit";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        color: #64748b;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Empty / Add Channel Strip Slot in Mixer mode (Fixed width: 72px)
                    if root.active-tab == "mixer" : Rectangle {
                        width: 72px;
                        background: #06080d;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #ffffff08;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "+";
                                font-family: Tokens.font-mono;
                                font-size: 16px;
                                color: #475569;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "添加混音轨";
                                font-family: Tokens.font-ui;
                                font-size: 8px;
                                color: #475569;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // PANE: TRADITIONAL PIANO ROLL (Visible when pianoroll tab active)
            // PANE: 真实钢琴卷帘（与旧控制台同一条投影与同一条编辑链路）
            if root.active-tab == "pianoroll" : PianoRoll {
                vertical-stretch: 1;
                note-ulids: root.note-ulids;
                velocities: root.note-velocities;
                note-positions: root.note-positions;
                note-widths: root.note-widths;
                note-ys: root.note-ys;
                note-selected: root.note-selected;
                playhead-ticks: root.playhead-ticks;
                ticks-per-pixel: root.ticks-per-pixel;
                scroll-x: root.scroll-x;
                playhead-timecode: root.playhead-timecode;
                active-tool: root.active-tool;
                edit-status: root.roll-edit-status;
                note-drag-ulid: root.note-drag-ulid;
                note-drag-preview-dx: root.note-drag-preview-dx;
                note-drag-preview-dy: root.note-drag-preview-dy;
                note-drag-preview-velocity: root.note-drag-preview-velocity;
                show-velocity-lane: root.show-velocity;

                scroll-requested(d) => { root.scroll-requested(d); }
                clicked(x, y) => { root.clicked(x, y); }
                double-clicked(x, y) => { root.double-clicked(x, y); }
                tool-selected(tool) => { root.tool-selected(tool); }
                note-drag-grab(x, y) => { return root.note-drag-grab(x, y); }
                note-drag-move(x, y) => { root.note-drag-move(x, y); }
                note-drag-release(x, y) => { root.note-drag-release(x, y); }
                note-drag-cancel() => { root.note-drag-cancel(); }
                humanize-requested => { root.humanize-requested(); }
                quantize-requested => { root.quantize-requested(); }
            }
        }
    }
}
