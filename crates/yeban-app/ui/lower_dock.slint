import { Theme, TrackData, PianoStepRow, Tokens } from "tokens.slint";

export component UnifiedLowerDock inherits Rectangle {
    in-out property <string> active-tab: "stacked"; // "stacked" | "devices" | "mixer" | "pianoroll"
    in-out property <color> selected-track-color: #387691;
    in-out property <string> focus-track-name: "01. Lead Neuro Bass";
    in-out property <[TrackData]> tracks;
    in-out property <int> selected-track-id: 1;

    // Wavetable device params
    in-out property <int> wt-pos-val: 64;
    in-out property <int> wt-cutoff-hz: 4800;
    in-out property <int> wt-reso-val: 35;

    // EQ device params
    in-out property <string> eq-low-db: "+2.4dB";
    in-out property <string> eq-mid-db: "-1.8dB";
    in-out property <string> eq-air-db: "+3.5dB";

    // Compressor device params
    in-out property <float> comp-gr-fraction: 0.34;
    in-out property <string> comp-gr-text: "-4.2 dB";

    // Piano Roll
    in-out property <bool> scale-folded: true;
    in-out property <[PianoStepRow]> piano-rows: [
        { pitch_name: "C4 (Root)", is_root: true,  step0: true,  step1: false, step2: false, step3: true,  step4: false, step5: true,  step6: false, step7: false, step8: true,  step9: false, step10: false, step11: true,  step12: false, step13: true,  step14: false, step15: false },
        { pitch_name: "Bb3 (m7)",  is_root: false, step0: false, step1: true,  step2: false, step3: false, step4: true,  step5: false, step6: false, step7: true,  step8: false, step9: true,  step10: false, step11: false, step12: true,  step13: false, step14: false, step15: true  },
        { pitch_name: "Ab3 (b6)",  is_root: false, step0: false, step1: false, step2: true,  step3: false, step4: false, step5: false, step6: true,  step7: false, step8: false, step9: false, step10: true,  step11: false, step12: false, step13: false, step14: true,  step15: false },
        { pitch_name: "G3 (5th)",  is_root: false, step0: true,  step1: false, step2: false, step3: false, step4: true,  step5: false, step6: false, step7: false, step8: true,  step9: false, step10: false, step11: false, step12: true,  step13: false, step14: false, step15: false },
        { pitch_name: "Eb3 (m3)",  is_root: false, step0: false, step1: false, step2: true,  step3: false, step4: false, step5: true,  step6: false, step7: false, step8: false, step9: false, step10: true,  step11: false, step12: false, step13: true,  step14: false, step15: false },
        { pitch_name: "C3 (Sub)",  is_root: true,  step0: true,  step1: false, step2: false, step3: false, step4: false, step5: false, step6: false, step7: false, step8: true,  step9: false, step10: false, step11: false, step12: false, step13: false, step14: false, step15: false }
    ];

    callback select-tab(string);
    callback select-track(int);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback track-volume-change(int, float);
    callback set-wt-pos(int);
    callback set-wt-cutoff(int);
    callback toggle-piano-step(int, int);
    callback toggle-scale-fold(bool);

    function toggle-step(r-idx: int, s-idx: int) {
        if (s-idx == 0) { root.piano-rows[r-idx].step0 = !root.piano-rows[r-idx].step0; }
        else if (s-idx == 1) { root.piano-rows[r-idx].step1 = !root.piano-rows[r-idx].step1; }
        else if (s-idx == 2) { root.piano-rows[r-idx].step2 = !root.piano-rows[r-idx].step2; }
        else if (s-idx == 3) { root.piano-rows[r-idx].step3 = !root.piano-rows[r-idx].step3; }
        else if (s-idx == 4) { root.piano-rows[r-idx].step4 = !root.piano-rows[r-idx].step4; }
        else if (s-idx == 5) { root.piano-rows[r-idx].step5 = !root.piano-rows[r-idx].step5; }
        else if (s-idx == 6) { root.piano-rows[r-idx].step6 = !root.piano-rows[r-idx].step6; }
        else if (s-idx == 7) { root.piano-rows[r-idx].step7 = !root.piano-rows[r-idx].step7; }
        else if (s-idx == 8) { root.piano-rows[r-idx].step8 = !root.piano-rows[r-idx].step8; }
        else if (s-idx == 9) { root.piano-rows[r-idx].step9 = !root.piano-rows[r-idx].step9; }
        else if (s-idx == 10) { root.piano-rows[r-idx].step10 = !root.piano-rows[r-idx].step10; }
        else if (s-idx == 11) { root.piano-rows[r-idx].step11 = !root.piano-rows[r-idx].step11; }
        else if (s-idx == 12) { root.piano-rows[r-idx].step12 = !root.piano-rows[r-idx].step12; }
        else if (s-idx == 13) { root.piano-rows[r-idx].step13 = !root.piano-rows[r-idx].step13; }
        else if (s-idx == 14) { root.piano-rows[r-idx].step14 = !root.piano-rows[r-idx].step14; }
        else if (s-idx == 15) { root.piano-rows[r-idx].step15 = !root.piano-rows[r-idx].step15; }
        root.toggle-piano-step(r-idx, s-idx);
    }

    height: 256px;
    background: Theme.bg-panel;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // DOCK TAB BAR
        Rectangle {
            height: 34px;
            background: #080a10;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        background: root.active-tab == "stacked" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "🎛️ 旗舰堆叠";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "stacked" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-tab("stacked"); } }
                    }

                    Rectangle {
                        background: root.active-tab == "devices" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "⚡ 内联设备机架";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "devices" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-tab("devices"); } }
                    }

                    Rectangle {
                        background: root.active-tab == "mixer" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "🎚️ 混音控制台";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "mixer" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-tab("mixer"); } }
                    }

                    Rectangle {
                        background: root.active-tab == "pianoroll" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "🎹 钢琴卷帘 (MPE)";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "pianoroll" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-tab("pianoroll"); } }
                    }
                }

                // Focus track badge
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        background: root.selected-track-color.with-alpha(0.15);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.selected-track-color.with-alpha(0.40);
                        height: 24px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.selected-track-color; }
                            Text {
                                text: "聚焦: " + root.focus-track-name;
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                font-weight: 700;
                                color: root.selected-track-color;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // DOCK BODY CONTENT (Panes)
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            vertical-stretch: 1;

            // PANE: INLINE DSP DEVICES (Visible in stacked or devices mode)
            if root.active-tab == "stacked" || root.active-tab == "devices" : HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: root.active-tab == "stacked" ? 3 : 1;

                // Device 1: Wavetable MPE Synth (Flex width across available space)
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 190px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                                Text {
                                    text: "Wavetable MPE";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "OSC 1+2";
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                letter-spacing: 0.8px;
                                color: Theme.accent;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // 3D Morph Wave SVG (stretches to fill device width)
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;
                            clip: true;

                            Path {
                                commands: "M 0 55 Q 40 20, 80 50 T 160 30 T 240 45 T 320 28 T 400 48 T 480 32 T 560 46 T 640 38";
                                stroke: Theme.accent.with-alpha(0.35);
                                stroke-width: 1.5px;
                            }
                            Path {
                                commands: "M 0 35 Q 40 8, 80 35 T 160 15 T 240 30 T 320 18 T 400 35 T 480 20 T 560 32 T 640 25";
                                stroke: Theme.accent;
                                stroke-width: 2.0px;
                            }
                            Path {
                                commands: "M 0 60 Q 50 30, 100 55 T 200 38 T 300 52 T 400 36 T 500 50 T 600 42";
                                stroke: #347864.with-alpha(0.35);
                                stroke-width: 1.5px;
                            }

                            HorizontalLayout {
                                x: 8px;
                                y: 56px;
                                width: parent.width - 16px;
                                alignment: space-between;
                                Text {
                                    text: "POS: " + root.wt-pos-val + "%";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    font-weight: 700;
                                    color: Theme.accent;
                                }
                                Text {
                                    text: "UNISON: 4 Voices";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Quick Knobs / Sliders
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "WT Pos";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-pos-val + "%";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        horizontal-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.wt-pos-val = root.wt-pos-val == 64 ? 85 : 64;
                                        root.set-wt-pos(root.wt-pos-val);
                                    }
                                }
                            }

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "Cutoff";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-cutoff-hz + "Hz";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: #347864;
                                        horizontal-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.wt-cutoff-hz = root.wt-cutoff-hz == 4800 ? 8200 : 4800;
                                        root.set-wt-cutoff(root.wt-cutoff-hz);
                                    }
                                }
                            }

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "Reso";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-reso-val + "%";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: #9a6a38;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Device 2: Pro-QLinear 8-band Dynamic EQ (Flex width)
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 200px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #347864; }
                                Text {
                                    text: "Pro-QLinear 8 (动态 EQ)";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "" + root.wt-cutoff-hz + " Hz";
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                color: #347864;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // EQ Curve + Spectrum Display
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;
                            clip: true;

                            // 0dB Center Axis & Frequency Reference Lines
                            Rectangle {
                                x: 0;
                                y: 36px;
                                width: parent.width;
                                height: 1px;
                                background: #ffffff0a;
                            }

                            // Spectrum Bars (Natural acoustic curve)
                            HorizontalLayout {
                                x: 4px;
                                y: 12px;
                                width: parent.width - 8px;
                                height: 52px;
                                spacing: 2px;
                                alignment: center;

                                for h in [14px, 20px, 32px, 44px, 38px, 46px, 34px, 28px, 36px, 42px, 30px, 24px, 18px, 26px, 20px, 14px, 16px, 22px, 34px, 42px, 35px, 26px, 18px, 12px] : Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 3px;
                                    max-width: 8px;
                                    height: h;
                                    background: #34786422;
                                    border-radius: 1px;
                                }
                            }

                            // Dynamic Filter Curve Path (Smooth Bezier curve across spectrum)
                            Path {
                                commands: "M 0 52 Q 60 46, 120 22 T 240 32 T 360 20 T 480 38 T 600 52";
                                stroke: #347864;
                                stroke-width: 2.0px;
                            }

                            // 4 Parametric EQ Filter Nodes
                            Rectangle {
                                x: 60px;
                                y: 44px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: Theme.accent;
                            }
                            Rectangle {
                                x: 120px;
                                y: 20px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #347864;
                            }
                            Rectangle {
                                x: 240px;
                                y: 30px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #9a6a38;
                            }
                            Rectangle {
                                x: 360px;
                                y: 18px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #705e88;
                            }
                        }

                        // Low / Mid / Air readouts
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "LOW: " + root.eq-low-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "MID: " + root.eq-mid-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #347864;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "AIR: " + root.eq-air-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #9a6a38;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Device 3: VCA Glue Compressor (Flex width)
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 190px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #9a6a38; }
                                Text {
                                    text: "VCA Glue Comp";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "GR " + root.comp-gr-text;
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                color: #9a6a38;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // GR Meter Box
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;

                            VerticalLayout {
                                padding: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    Text {
                                        text: "GAIN REDUCTION";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        letter-spacing: 0.8px;
                                        color: #64748b;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: root.comp-gr-text;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 800;
                                        color: #9a6a38;
                                        horizontal-alignment: right;
                                    }
                                }

                                Rectangle {
                                    height: 8px;
                                    background: #06080d;
                                    border-radius: 4px;
                                    Rectangle {
                                        x: 0;
                                        width: root.comp-gr-fraction * parent.width;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: #9a6a38;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Atk: 10ms";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                    Text {
                                        text: "Rel: Auto";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                    Text {
                                        text: "Ratio: 4:1";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Thresh: -16dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #cbd5e1;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Makeup: +4.5dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #cbd5e1;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // PANE: MIXCONSOLE (Visible in stacked or mixer mode - reflows to fill available space)
            if root.active-tab == "stacked" || root.active-tab == "mixer" : Rectangle {
                horizontal-stretch: root.active-tab == "stacked" ? 2 : 1;
                min-width: root.active-tab == "stacked" ? 400px : 600px;
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding: 6px;
                    spacing: 6px;

                    // Channel Fader Strips (Dynamic reflow based on mode)
                    for trk in root.tracks : Rectangle {
                        horizontal-stretch: 1;
                        min-width: 74px;
                        max-width: root.active-tab == "stacked" ? 150px : 240px;
                        background: #080a10;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: trk.id == root.selected-track-id ? Theme.accent : #191f2c;

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: space-between;

                            // Color label
                            Rectangle {
                                height: 18px;
                                background: trk.color.with-alpha(0.18);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: trk.color.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: #e2e8f0;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Inserts
                            Rectangle {
                                height: 16px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: trk.insert1;
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // M / S / Pan
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 2px;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: trk.muted ? #9a6a38 : #12151e;
                                        border-width: 1px;
                                        border-color: trk.muted ? #825828 : #ffffff10;
                                        Text {
                                            text: "M";
                                            font-family: Tokens.font-mono;
                                            font-size: 7px;
                                            font-weight: 800;
                                            color: trk.muted ? #020617 : #94a3b8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.toggle-track-mute(trk.id); } }
                                    }
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: trk.soloed ? Theme.accent : #12151e;
                                        border-width: 1px;
                                        border-color: trk.soloed ? Theme.accent : #ffffff10;
                                        Text {
                                            text: "S";
                                            font-family: Tokens.font-mono;
                                            font-size: 7px;
                                            font-weight: 800;
                                            color: trk.soloed ? #020617 : #94a3b8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { root.toggle-track-solo(trk.id); } }
                                    }
                                }
                                Text {
                                    text: trk.pan;
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            // Vertical Fader
                            Rectangle {
                                height: 76px;
                                background: #06080d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #191f2c;

                                // Fader track line
                                Rectangle {
                                    x: parent.width / 2 - 1px;
                                    y: 0;
                                    width: 2px;
                                    height: parent.height;
                                    background: #000000;
                                }

                                // Fader cap
                                Rectangle {
                                    x: 2px;
                                    y: 32px;
                                    width: parent.width - 4px;
                                    height: 14px;
                                    background: #94a3b8;
                                    border-radius: 2px;

                                    Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: parent.width;
                                        height: 2px;
                                        background: trk.color;
                                    }
                                }

                                TouchArea {
                                    clicked => {
                                        root.select-track(trk.id);
                                        root.track-volume-change(trk.id, trk.volume_db == -2.5 ? 0.0 : -2.5);
                                    }
                                }
                            }

                            Text {
                                text: "" + trk.volume_db + " dB";
                                font-family: Tokens.font-mono;
                                font-size: 9px;
                                font-weight: 700;
                                color: trk.color;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-track(trk.id); } }
                    }

                    // Optional Group Bus Strip in Mixer mode (shows Synth/Drum bus summing)
                    if root.active-tab == "mixer" : Rectangle {
                        width: 92px;
                        background: #080a10;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.track-bus.with-alpha(0.40);

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: space-between;

                            Rectangle {
                                height: 18px;
                                background: Theme.track-bus.with-alpha(0.20);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.track-bus.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "BUS SUM";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 800;
                                        color: Theme.track-bus;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                height: 16px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "Tape Saturator";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "BUS 1+2";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 76px;
                                background: #06080d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #191f2c;

                                Rectangle {
                                    x: parent.width / 2 - 1px;
                                    y: 0;
                                    width: 2px;
                                    height: parent.height;
                                    background: #000000;
                                }

                                Rectangle {
                                    x: 2px;
                                    y: 28px;
                                    width: parent.width - 4px;
                                    height: 14px;
                                    background: #94a3b8;
                                    border-radius: 2px;
                                    Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: parent.width;
                                        height: 2px;
                                        background: Theme.track-bus;
                                    }
                                }
                            }

                            Text {
                                text: "-1.0 dB";
                                font-family: Tokens.font-mono;
                                font-size: 9px;
                                font-weight: 700;
                                color: Theme.track-bus;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Dedicated Master 2-Bus Channel Strip on Mixer Right
                    Rectangle {
                        width: 90px;
                        background: #05070c;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.35);

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: space-between;

                            // Master Badge
                            Rectangle {
                                height: 18px;
                                background: Theme.accent.with-alpha(0.20);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.accent.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "MASTER 2-BUS";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Master Limiter
                            Rectangle {
                                height: 16px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "⚡ TruePeak Limit";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Master Pan & Mono
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: space-between;
                                Rectangle {
                                    width: 32px;
                                    height: 16px;
                                    border-radius: 2px;
                                    background: #10141d;
                                    Text {
                                        text: "MONO";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 700;
                                        color: #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "0 dBTP";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    color: #347864;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Master Vertical Fader
                            Rectangle {
                                height: 76px;
                                background: #040509;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #191f2c;

                                Rectangle {
                                    x: parent.width / 2 - 1px;
                                    y: 0;
                                    width: 2px;
                                    height: parent.height;
                                    background: #000000;
                                }

                                Rectangle {
                                    x: 2px;
                                    y: 24px;
                                    width: parent.width - 4px;
                                    height: 14px;
                                    background: #cbd5e1;
                                    border-radius: 2px;

                                    Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: parent.width;
                                        height: 2px;
                                        background: Theme.accent;
                                    }
                                }
                            }

                            Text {
                                text: "-0.3 dB";
                                font-family: Tokens.font-mono;
                                font-size: 9px;
                                font-weight: 800;
                                color: Theme.accent;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Empty / Add Channel Strip Slot in full Mixer mode to catch remaining width
                    if root.active-tab == "mixer" : Rectangle {
                        horizontal-stretch: 1;
                        min-width: 60px;
                        max-width: 140px;
                        background: #06080d;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #ffffff08;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "+";
                                font-family: Tokens.font-mono;
                                font-size: 16px;
                                color: #475569;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "添加混音轨";
                                font-family: Tokens.font-ui;
                                font-size: 8px;
                                color: #475569;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // PANE: MPE PIANO ROLL (Visible when pianoroll tab active)
            if root.active-tab == "pianoroll" : HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;

                // Left Piano Keys & Scale lock
                Rectangle {
                    width: 155px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        Text {
                            text: "🎹 音阶折叠与 MPE";
                            font-family: Tokens.font-ui;
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.accent;
                        }

                        Rectangle {
                            height: 24px;
                            background: root.scale-folded ? Theme.accent.with-alpha(0.18) : #10141d;
                            border-radius: 3px;
                            border-width: root.scale-folded ? 1px : 0;
                            border-color: Theme.accent;

                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 4px;
                                Text {
                                    text: root.scale-folded ? "✓" : "○";
                                    font-family: Tokens.font-mono;
                                    font-size: 9px;
                                    font-weight: 800;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "仅显示调内音符";
                                    font-family: Tokens.font-ui;
                                    font-size: 9px;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    root.scale-folded = !root.scale-folded;
                                    root.toggle-scale-fold(root.scale-folded);
                                }
                            }
                        }

                        // Piano key rows
                        VerticalLayout {
                            spacing: 3px;
                            vertical-stretch: 1;

                            for row in root.piano-rows : Rectangle {
                                vertical-stretch: 1;
                                min-height: 22px;
                                max-height: 32px;
                                background: row.is_root ? #121622 : #0a0d14;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: row.is_root ? root.selected-track-color.with-alpha(0.3) : #ffffff06;

                                Text {
                                    x: 8px;
                                    text: row.pitch_name;
                                    font-family: Tokens.font-mono;
                                    font-size: 9px;
                                    font-weight: row.is_root ? 800 : 500;
                                    color: row.is_root ? root.selected-track-color : #cbd5e1;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Left velocity label block
                        Rectangle {
                            height: 36px;
                            background: #080a10;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: space-between;
                                Text {
                                    text: "VELOCITY 力度";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    color: #64748b;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "MPE";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: root.selected-track-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 16-Step Grid & Velocity Dynamic Lane
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;

                    // 16-Step Note Grid
                    Rectangle {
                        vertical-stretch: 1;
                        background: #06080d;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 3px;

                            for row[r-idx] in root.piano-rows : HorizontalLayout {
                                vertical-stretch: 1;
                                min-height: 22px;
                                max-height: 32px;
                                spacing: 3px;

                                Rectangle { background: row.step0 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 0); } } }
                                Rectangle { background: row.step1 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 1); } } }
                                Rectangle { background: row.step2 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 2); } } }
                                Rectangle { background: row.step3 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 3); } } }
                                Rectangle { background: row.step4 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 4); } } }
                                Rectangle { background: row.step5 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 5); } } }
                                Rectangle { background: row.step6 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 6); } } }
                                Rectangle { background: row.step7 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 7); } } }
                                Rectangle { background: row.step8 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 8); } } }
                                Rectangle { background: row.step9 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 9); } } }
                                Rectangle { background: row.step10 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 10); } } }
                                Rectangle { background: row.step11 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 11); } } }
                                Rectangle { background: row.step12 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 12); } } }
                                Rectangle { background: row.step13 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 13); } } }
                                Rectangle { background: row.step14 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 14); } } }
                                Rectangle { background: row.step15 ? root.selected-track-color : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 15); } } }
                            }
                        }
                    }

                    // Velocity Dynamic Lane (力度动态包络)
                    Rectangle {
                        height: 36px;
                        background: #06080d;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 3px;

                            // 16 Velocity Stalks with dynamic expression values (40 - 115)
                            for h in [22px, 14px, 18px, 13px, 24px, 16px, 19px, 14px, 25px, 15px, 19px, 12px, 23px, 16px, 20px, 15px] : Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                // Baseline guide
                                Rectangle {
                                    x: 0;
                                    y: parent.height - 1px;
                                    width: parent.width;
                                    height: 1px;
                                    background: #ffffff08;
                                }

                                // Velocity vertical stalk
                                Rectangle {
                                    x: (parent.width - 2px) / 2;
                                    y: parent.height - h;
                                    width: 2px;
                                    height: h;
                                    background: root.selected-track-color.with-alpha(0.65);
                                    border-radius: 1px;
                                }

                                // Velocity top lollipop cap
                                Rectangle {
                                    x: (parent.width - 6px) / 2;
                                    y: parent.height - h - 1px;
                                    width: 6px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: root.selected-track-color;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
