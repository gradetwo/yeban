import { Theme, TrackData, PianoStepRow, PianoRollNote, Tokens, TooltipBubble } from "tokens.slint";

export component UnifiedLowerDock inherits Rectangle {
    in-out property <string> active-tab: "devices"; // "devices" | "mixer" | "pianoroll" | "stacked"
    in-out property <color> selected-track-color: #387691;
    in-out property <string> focus-track-name: "01. Lead Neuro Bass";
    in-out property <[TrackData]> tracks;
    in-out property <int> selected-track-id: 1;

    // Wavetable device params
    in-out property <int> wt-pos-val: 64;
    in-out property <int> wt-cutoff-hz: 4800;
    in-out property <int> wt-reso-val: 35;

    // EQ device params
    in-out property <string> eq-low-db: "+2.4dB";
    in-out property <string> eq-mid-db: "-1.8dB";
    in-out property <string> eq-air-db: "+3.5dB";

    // Compressor device params
    in-out property <float> comp-gr-fraction: 0.34;
    in-out property <string> comp-gr-text: "-4.2 dB";

    // Traditional Piano Roll State & Notes
    in-out property <int> roll-tool: 1; // 1: Select, 2: Pencil, 3: Split, 4: Erase
    in-out property <string> roll-snap: "1/16";
    in-out property <bool> show-velocity: true;
    in-out property <int> selected-note-id: 1;
    in-out property <bool> scale-folded: true;
    in-out property <length> playhead-px: 168px;
    in-out property <[PianoRollNote]> notes: [
        { id: 1, pitch_row: 0,  pitch_name: "C5",  start_step: 0,  step_span: 2, velocity: 108, selected: true },
        { id: 2, pitch_row: 5,  pitch_name: "G4",  start_step: 2,  step_span: 2, velocity: 92,  selected: false },
        { id: 3, pitch_row: 9,  pitch_name: "Eb4", start_step: 4,  step_span: 3, velocity: 100, selected: false },
        { id: 4, pitch_row: 12, pitch_name: "C4",  start_step: 7,  step_span: 1, velocity: 85,  selected: false },
        { id: 5, pitch_row: 0,  pitch_name: "C5",  start_step: 8,  step_span: 2, velocity: 112, selected: false },
        { id: 6, pitch_row: 2,  pitch_name: "Bb4", start_step: 10, step_span: 2, velocity: 96,  selected: false },
        { id: 7, pitch_row: 5,  pitch_name: "G4",  start_step: 12, step_span: 2, velocity: 104, selected: false },
        { id: 8, pitch_row: 9,  pitch_name: "Eb4", start_step: 14, step_span: 2, velocity: 90,  selected: false }
    ];

    in-out property <[PianoStepRow]> piano-rows: [
        { pitch_name: "C4 (Root)", is_root: true,  step0: true,  step1: false, step2: false, step3: true,  step4: false, step5: true,  step6: false, step7: false, step8: true,  step9: false, step10: false, step11: true,  step12: false, step13: true,  step14: false, step15: false },
        { pitch_name: "Bb3 (m7)",  is_root: false, step0: false, step1: true,  step2: false, step3: false, step4: true,  step5: false, step6: false, step7: true,  step8: false, step9: true,  step10: false, step11: false, step12: true,  step13: false, step14: false, step15: true  },
        { pitch_name: "Ab3 (b6)",  is_root: false, step0: false, step1: false, step2: true,  step3: false, step4: false, step5: false, step6: true,  step7: false, step8: false, step9: false, step10: true,  step11: false, step12: false, step13: false, step14: true,  step15: false },
        { pitch_name: "G3 (5th)",  is_root: false, step0: true,  step1: false, step2: false, step3: false, step4: true,  step5: false, step6: false, step7: false, step8: true,  step9: false, step10: false, step11: false, step12: true,  step13: false, step14: false, step15: false },
        { pitch_name: "Eb3 (m3)",  is_root: false, step0: false, step1: false, step2: true,  step3: false, step4: false, step5: true,  step6: false, step7: false, step8: false, step9: false, step10: true,  step11: false, step12: false, step13: true,  step14: false, step15: false },
        { pitch_name: "C3 (Sub)",  is_root: true,  step0: true,  step1: false, step2: false, step3: false, step4: false, step5: false, step6: false, step7: false, step8: true,  step9: false, step10: false, step11: false, step12: false, step13: false, step14: false, step15: false }
    ];

    callback select-tab(string);
    callback select-track(int);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback track-volume-change(int, float);
    callback set-wt-pos(int);
    callback set-wt-cutoff(int);
    callback toggle-piano-step(int, int);
    callback toggle-scale-fold(bool);
    callback piano-key-clicked(string, int);
    callback select-note(int);
    callback canvas-create-note(int, int);
    callback canvas-clicked(int, int);
    callback split-note(int);
    callback delete-note(int);
    callback velocity-changed(int, int);
    callback console-maximize-toggle();

    in-out property <bool> console-maximized: false;
    in-out property <length> dock-height: 320px;
    min-height: root.console-maximized ? 0px : root.dock-height;
    max-height: root.console-maximized ? 100000px : root.dock-height;
    vertical-stretch: root.console-maximized ? 1 : 0;
    background: Theme.bg-panel;
    border-color: Theme.border-subtle;
    accessible-role: region;
    accessible-id: "console-tab-rail";
    accessible-label: "底部控制台";

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // DOCK TAB BAR
        Rectangle {
            height: 34px;
            background: #080a10;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        background: root.active-tab == "stacked" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "设备堆叠";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "stacked" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        tab_stk_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tab("stacked"); }
                        }
                        TooltipBubble { text: "效果器与调音台双层堆叠视图 [Alt+S]"; is-visible: tab_stk_touch.has-hover; tip-offset-y: 28px; }
                    }

                    Rectangle {
                        background: root.active-tab == "devices" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "设备机架";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "devices" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        tab_dev_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tab("devices"); }
                        }
                        TooltipBubble { text: "效果器与虚拟乐器机架 [D]"; is-visible: tab_dev_touch.has-hover; tip-offset-y: 28px; }
                    }

                    Rectangle {
                        background: root.active-tab == "mixer" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "混音控制台";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "mixer" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        tab_mix_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tab("mixer"); }
                        }
                        TooltipBubble { text: "多轨混音控制台 [X]"; is-visible: tab_mix_touch.has-hover; tip-offset-y: 28px; }
                    }

                    Rectangle {
                        background: root.active-tab == "pianoroll" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "钢琴卷帘";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active-tab == "pianoroll" ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        tab_pr_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tab("pianoroll"); }
                        }
                        TooltipBubble { text: "MPE 钢琴卷帘编辑器 [P]"; is-visible: tab_pr_touch.has-hover; tip-offset-y: 28px; }
                    }
                }

                // Focus track badge & Maximize toggle
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Rectangle {
                        background: root.selected-track-color.with-alpha(0.15);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.selected-track-color.with-alpha(0.40);
                        height: 24px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.selected-track-color; }
                            Text {
                                text: "聚焦: " + root.focus-track-name;
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                font-weight: 700;
                                color: root.selected-track-color;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Console Maximize / Restore Button
                    Rectangle {
                        accessible-id: "console-maximize-button";
                        accessible-role: button;
                        accessible-label: "最大化 / 还原底部控制台";
                        accessible-checked: root.console-maximized;
                        accessible-action-default => { root.console-maximize-toggle(); }
                        width: 26px;
                        height: 24px;
                        background: max_btn_touch.has-hover ? #22293a : (root.console-maximized ? Theme.accent.with-alpha(0.25) : #121622);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.console-maximized ? Theme.accent : #ffffff18;

                        if !root.console-maximized : Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            stroke: max_btn_touch.has-hover ? #ffffff : #94a3b8;
                            stroke-width: 1.5px;
                            commands: "M 1 4 L 1 1 L 4 1 M 8 1 L 11 1 L 11 4 M 11 8 L 11 11 L 8 11 M 4 11 L 1 11 L 1 8";
                        }
                        if root.console-maximized : Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            stroke: Theme.accent;
                            stroke-width: 1.5px;
                            commands: "M 4 1 L 4 4 L 1 4 M 8 1 L 8 4 L 11 4 M 11 8 L 8 8 L 8 11 M 4 11 L 4 8 L 1 8";
                        }

                        max_btn_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.console-maximize-toggle(); }
                        }
                        TooltipBubble {
                            text: root.console-maximized ? "退出最大化 / 还原 [Cmd/Ctrl+Alt+M / F3]" : "最大化全屏此视图 (卷帘/混音台) [Cmd/Ctrl+Alt+M / F3]";
                            is-visible: max_btn_touch.has-hover;
                            tip-offset-x: -80px;
                            tip-offset-y: 26px;
                        }
                    }
                }
            }
        }

        // DOCK BODY CONTENT (Panes)
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            vertical-stretch: 1;

            // PANE: INLINE DSP DEVICES (Visible in stacked or devices mode)
            if root.active-tab == "stacked" || root.active-tab == "devices" : HorizontalLayout {
                spacing: 8px;
                alignment: start;

                // Device 1: Wavetable MPE Synth (Fixed studio module width: 250px)
                Rectangle {
                    width: 250px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                                Text {
                                    text: "Wavetable MPE";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "OSC 1+2";
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                letter-spacing: 0.8px;
                                color: Theme.accent;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // 3D Morph Wave SVG (stretches to fill device width)
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;
                            clip: true;

                            Path {
                                commands: "M 0 55 Q 40 20, 80 50 T 160 30 T 240 45 T 320 28 T 400 48 T 480 32 T 560 46 T 640 38";
                                stroke: Theme.accent.with-alpha(0.35);
                                stroke-width: 1.5px;
                            }
                            Path {
                                commands: "M 0 35 Q 40 8, 80 35 T 160 15 T 240 30 T 320 18 T 400 35 T 480 20 T 560 32 T 640 25";
                                stroke: Theme.accent;
                                stroke-width: 2.0px;
                            }
                            Path {
                                commands: "M 0 60 Q 50 30, 100 55 T 200 38 T 300 52 T 400 36 T 500 50 T 600 42";
                                stroke: #347864.with-alpha(0.35);
                                stroke-width: 1.5px;
                            }

                            HorizontalLayout {
                                x: 8px;
                                y: 56px;
                                width: parent.width - 16px;
                                alignment: space-between;
                                Text {
                                    text: "POS: " + root.wt-pos-val + "%";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    font-weight: 700;
                                    color: Theme.accent;
                                }
                                Text {
                                    text: "UNISON: 4 Voices";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Quick Knobs / Sliders
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "WT Pos";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-pos-val + "%";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        horizontal-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.wt-pos-val = root.wt-pos-val == 64 ? 85 : 64;
                                        root.set-wt-pos(root.wt-pos-val);
                                    }
                                }
                            }

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "Cutoff";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-cutoff-hz + "Hz";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: #347864;
                                        horizontal-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.wt-cutoff-hz = root.wt-cutoff-hz == 4800 ? 8200 : 4800;
                                        root.set-wt-cutoff(root.wt-cutoff-hz);
                                    }
                                }
                            }

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: "Reso";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.wt-reso-val + "%";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: #9a6a38;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Device 2: Pro-QLinear 8-band Dynamic EQ (Fixed studio module width: 280px)
                Rectangle {
                    width: 280px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #347864; }
                                Text {
                                    text: "Pro-QLinear 8 (动态 EQ)";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "" + root.wt-cutoff-hz + " Hz";
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                color: #347864;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // EQ Curve + Spectrum Display
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;
                            clip: true;

                            // 0dB Center Axis & Frequency Reference Lines
                            Rectangle {
                                x: 0;
                                y: 36px;
                                width: parent.width;
                                height: 1px;
                                background: #ffffff0a;
                            }

                            // Spectrum Bars (Natural acoustic curve)
                            HorizontalLayout {
                                x: 4px;
                                y: 12px;
                                width: parent.width - 8px;
                                height: 52px;
                                spacing: 2px;
                                alignment: center;

                                for h in [14px, 20px, 32px, 44px, 38px, 46px, 34px, 28px, 36px, 42px, 30px, 24px, 18px, 26px, 20px, 14px, 16px, 22px, 34px, 42px, 35px, 26px, 18px, 12px] : Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 3px;
                                    max-width: 8px;
                                    height: h;
                                    background: #34786422;
                                    border-radius: 1px;
                                }
                            }

                            // Dynamic Filter Curve Path (Smooth Bezier curve across spectrum)
                            Path {
                                commands: "M 0 52 Q 60 46, 120 22 T 240 32 T 360 20 T 480 38 T 600 52";
                                stroke: #347864;
                                stroke-width: 2.0px;
                            }

                            // 4 Parametric EQ Filter Nodes
                            Rectangle {
                                x: 60px;
                                y: 44px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: Theme.accent;
                            }
                            Rectangle {
                                x: 120px;
                                y: 20px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #347864;
                            }
                            Rectangle {
                                x: 240px;
                                y: 30px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #9a6a38;
                            }
                            Rectangle {
                                x: 360px;
                                y: 18px;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: #f8fafc;
                                border-width: 1.5px;
                                border-color: #705e88;
                            }
                        }

                        // Low / Mid / Air readouts
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "LOW: " + root.eq-low-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "MID: " + root.eq-mid-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #347864;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "AIR: " + root.eq-air-db;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: #9a6a38;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Device 3: VCA Glue Compressor (Fixed studio module width: 240px)
                Rectangle {
                    width: 240px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 5px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #9a6a38; }
                                Text {
                                    text: "VCA Glue Comp";
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "GR " + root.comp-gr-text;
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                color: #9a6a38;
                                font-weight: 700;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // GR Meter Box
                        Rectangle {
                            height: 72px;
                            background: #06080d;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #191f2c;

                            VerticalLayout {
                                padding: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    Text {
                                        text: "GAIN REDUCTION";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        letter-spacing: 0.8px;
                                        color: #64748b;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: root.comp-gr-text;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 800;
                                        color: #9a6a38;
                                        horizontal-alignment: right;
                                    }
                                }

                                Rectangle {
                                    height: 8px;
                                    background: #06080d;
                                    border-radius: 4px;
                                    Rectangle {
                                        x: 0;
                                        width: root.comp-gr-fraction * parent.width;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: #9a6a38;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Atk: 10ms";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                    Text {
                                        text: "Rel: Auto";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                    Text {
                                        text: "Ratio: 4:1";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Thresh: -16dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #cbd5e1;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                background: #080a10;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff0a;
                                horizontal-stretch: 1;
                                height: 26px;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Makeup: +4.5dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #cbd5e1;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // PANE: MIXCONSOLE (Visible in stacked or mixer mode - fixed channel strip dimensions)
            if root.active-tab == "stacked" || root.active-tab == "mixer" : Rectangle {
                horizontal-stretch: root.active-tab == "stacked" ? 2 : 1;
                min-width: root.active-tab == "stacked" ? 400px : 560px;
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    alignment: start;
                    padding: 6px;
                    spacing: 6px;

                    // Channel Fader Strips (Fixed studio width: 82px)
                    for trk in root.tracks : Rectangle {
                        width: 82px;
                        vertical-stretch: 1;
                        background: #080a10;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: trk.id == root.selected-track-id ? Theme.accent : #191f2c;

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: space-between;

                            // Color label
                            Rectangle {
                                height: 18px;
                                background: trk.color.with-alpha(0.18);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: trk.color.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: trk.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: #e2e8f0;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Inserts
                            Rectangle {
                                height: 16px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: trk.insert1;
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // M / S / Pan
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 2px;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: trk.muted ? #9a6a38 : #12151e;
                                        border-width: 1px;
                                        border-color: trk.muted ? #825828 : #ffffff10;
                                        Text {
                                            text: "M";
                                            font-family: Tokens.font-mono;
                                            font-size: 7px;
                                            font-weight: 800;
                                            color: trk.muted ? #020617 : #94a3b8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        m_touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.toggle-track-mute(trk.id); }
                                        }
                                        TooltipBubble { text: "静音此音轨"; is-visible: m_touch.has-hover; tip-offset-y: -22px; }
                                    }
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 2px;
                                        background: trk.soloed ? Theme.accent : #12151e;
                                        border-width: 1px;
                                        border-color: trk.soloed ? Theme.accent : #ffffff10;
                                        Text {
                                            text: "S";
                                            font-family: Tokens.font-mono;
                                            font-size: 7px;
                                            font-weight: 800;
                                            color: trk.soloed ? #020617 : #94a3b8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        s_touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.toggle-track-solo(trk.id); }
                                        }
                                        TooltipBubble { text: "独奏此音轨"; is-visible: s_touch.has-hover; tip-offset-y: -22px; }
                                    }
                                }
                                Text {
                                    text: trk.pan;
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            // Fader + Meter Unit (Compact centered DAW layout)
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                vertical-stretch: 1;
                                min-height: 80px;

                                // Vertical Fader Rail
                                Rectangle {
                                    width: 24px;
                                    vertical-stretch: 1;
                                    min-height: 80px;
                                    background: #06080d;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;

                                    // Center fader track groove
                                    Rectangle {
                                        x: 10px;
                                        y: 4px;
                                        width: 4px;
                                        height: parent.height - 8px;
                                        background: #000000;
                                        border-radius: 1px;
                                    }

                                    // dB scale ticks on sides
                                    for tick_y in [14px, 26px, 38px, 50px, 62px] : Rectangle {
                                        x: 3px;
                                        y: tick_y;
                                        width: 18px;
                                        height: 1px;
                                        background: #ffffff10;
                                    }

                                    // Tactile fader cap
                                    Rectangle {
                                        x: 1px;
                                        y: Math.max(2px, Math.min(parent.height - 18px, 4px + (parent.height - 24px) * (1.0 - Math.max(0.0, Math.min(1.0, (trk.volume_db + 60.0) / 66.0)))));
                                        width: 22px;
                                        height: 15px;
                                        background: #94a3b8;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: #cbd5e1;

                                        Rectangle {
                                            x: 0;
                                            y: 6.5px;
                                            width: parent.width;
                                            height: 2px;
                                            background: trk.color;
                                        }
                                    }

                                    trk_fader_touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.select-track(trk.id);
                                            root.track-volume-change(trk.id, trk.volume_db == -2.5 ? 0.0 : -2.5);
                                        }
                                    }
                                    TooltipBubble { text: "推子: " + trk.volume_db + " dB (点击切换 0dB)"; is-visible: trk_fader_touch.has-hover; tip-offset-x: -20px; tip-offset-y: -22px; }
                                }

                                // Level Meter Bar
                                Rectangle {
                                    width: 6px;
                                    vertical-stretch: 1;
                                    min-height: 80px;
                                    background: #06080d;
                                    border-radius: 1px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    clip: true;

                                    Rectangle {
                                        x: 0;
                                        y: parent.height - (trk.meter_peak * parent.height);
                                        width: 6px;
                                        height: trk.meter_peak * parent.height;
                                        background: trk.meter_peak > 0.8 ? Theme.status-warn : Theme.status-ok;
                                        border-radius: 1px;
                                    }
                                }
                            }

                            // Compact Centered Volume dB Readout (Standard DAW convention)
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 50px;
                                    height: 17px;
                                    background: #080c14;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "" + trk.volume_db + " dB";
                                            font-family: Tokens.font-mono;
                                            font-size: 8.5px;
                                            font-weight: 700;
                                            color: trk.color;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        TouchArea { clicked => { root.select-track(trk.id); } }
                    }

                    // Optional Group Bus Strip in Mixer mode (Fixed width: 88px)
                    if root.active-tab == "mixer" : Rectangle {
                        width: 88px;
                        background: #080a10;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.track-bus.with-alpha(0.40);

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: space-between;

                            Rectangle {
                                height: 18px;
                                background: Theme.track-bus.with-alpha(0.20);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.track-bus.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "BUS SUM";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 800;
                                        color: Theme.track-bus;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                height: 16px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "Tape Saturator";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "BUS 1+2";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    color: #64748b;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Bus Fader + Meter Unit
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                vertical-stretch: 1;
                                min-height: 80px;

                                Rectangle {
                                    width: 24px;
                                    vertical-stretch: 1;
                                    min-height: 80px;
                                    background: #06080d;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;

                                    Rectangle {
                                        x: 10px;
                                        y: 4px;
                                        width: 4px;
                                        height: parent.height - 8px;
                                        background: #000000;
                                        border-radius: 1px;
                                    }

                                    for tick_y in [14px, 26px, 38px, 50px, 62px] : Rectangle {
                                        x: 3px;
                                        y: tick_y;
                                        width: 18px;
                                        height: 1px;
                                        background: #ffffff10;
                                    }

                                    Rectangle {
                                        x: 1px;
                                        y: 30px;
                                        width: 22px;
                                        height: 15px;
                                        background: #94a3b8;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: #cbd5e1;

                                        Rectangle {
                                            x: 0;
                                            y: 6.5px;
                                            width: parent.width;
                                            height: 2px;
                                            background: Theme.track-bus;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 6px;
                                    vertical-stretch: 1;
                                    min-height: 80px;
                                    background: #06080d;
                                    border-radius: 1px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    clip: true;

                                    Rectangle {
                                        x: 0;
                                        y: parent.height - 48px;
                                        width: 6px;
                                        height: 48px;
                                        background: Theme.status-ok;
                                        border-radius: 1px;
                                    }
                                }
                            }

                            // Compact Centered Bus Volume dB Readout
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 50px;
                                    height: 17px;
                                    background: #080c14;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "-1.0 dB";
                                            font-family: Tokens.font-mono;
                                            font-size: 8.5px;
                                            font-weight: 700;
                                            color: Theme.track-bus;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Dedicated Master 2-Bus Channel Strip on Mixer Right (Fixed width: 92px)
                    Rectangle {
                        width: 92px;
                        background: #05070c;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.35);

                        VerticalLayout {
                            padding: 5px;
                            spacing: 4px;
                            alignment: space-between;

                            // Master Badge
                            Rectangle {
                                height: 18px;
                                background: Theme.accent.with-alpha(0.20);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.accent.with-alpha(0.60);
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "MASTER 2-BUS";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Master Limiter
                            Rectangle {
                                height: 16px;
                                background: #10141d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #ffffff08;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "TruePeak Limit";
                                        font-family: Tokens.font-ui;
                                        font-size: 7px;
                                        color: #cbd5e1;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Master Pan & Mono
                            HorizontalLayout {
                                spacing: 3px;
                                alignment: space-between;
                                Rectangle {
                                    width: 32px;
                                    height: 16px;
                                    border-radius: 2px;
                                    background: #10141d;
                                    Text {
                                        text: "MONO";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 700;
                                        color: #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "0 dBTP";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    color: #347864;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Master Vertical Fader + Stereo Meter Unit
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                height: 80px;

                                Rectangle {
                                    width: 24px;
                                    height: 80px;
                                    background: #040509;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;

                                    Rectangle {
                                        x: 10px;
                                        y: 4px;
                                        width: 4px;
                                        height: parent.height - 8px;
                                        background: #000000;
                                        border-radius: 1px;
                                    }

                                    for tick_y in [14px, 26px, 38px, 50px, 62px] : Rectangle {
                                        x: 3px;
                                        y: tick_y;
                                        width: 18px;
                                        height: 1px;
                                        background: #ffffff10;
                                    }

                                    Rectangle {
                                        x: 1px;
                                        y: 26px;
                                        width: 22px;
                                        height: 15px;
                                        background: #cbd5e1;
                                        border-radius: 2px;
                                        border-width: 1px;
                                        border-color: #ffffff;

                                        Rectangle {
                                            x: 0;
                                            y: 6.5px;
                                            width: parent.width;
                                            height: 2px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                // Stereo Master Meter Bar
                                Rectangle {
                                    width: 10px;
                                    height: 80px;
                                    background: #040509;
                                    border-radius: 1px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    clip: true;

                                    HorizontalLayout {
                                        spacing: 1px;
                                        Rectangle {
                                            width: 4px;
                                            height: 80px;
                                            Rectangle {
                                                x: 0;
                                                y: parent.height - 56px;
                                                width: 4px;
                                                height: 56px;
                                                background: Theme.status-ok;
                                            }
                                        }
                                        Rectangle {
                                            width: 4px;
                                            height: 80px;
                                            Rectangle {
                                                x: 0;
                                                y: parent.height - 52px;
                                                width: 4px;
                                                height: 52px;
                                                background: Theme.status-ok;
                                            }
                                        }
                                    }
                                }
                            }

                            // Compact Centered Master Volume dB Readout
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 50px;
                                    height: 17px;
                                    background: #080c14;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #191f2c;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "-0.3 dB";
                                            font-family: Tokens.font-mono;
                                            font-size: 8.5px;
                                            font-weight: 800;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Empty / Add Channel Strip Slot in Mixer mode (Fixed width: 72px)
                    if root.active-tab == "mixer" : Rectangle {
                        width: 72px;
                        background: #06080d;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #ffffff08;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: "+";
                                font-family: Tokens.font-mono;
                                font-size: 16px;
                                color: #475569;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "添加混音轨";
                                font-family: Tokens.font-ui;
                                font-size: 8px;
                                color: #475569;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // PANE: TRADITIONAL PIANO ROLL (Visible when pianoroll tab active)
            if root.active-tab == "pianoroll" : VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;

                // 1. Piano Roll Toolbar: Scale info, Tools, Snap, Quantize, Velocity lane toggle
                Rectangle {
                    height: 26px;
                    background: #10141e;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: space-between;

                        // Left: Scale info & Roll tool buttons
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: start;

                            // Scale info badge
                            Rectangle {
                                background: #141926;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: "C 自然小调 · 960 PPQ";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Tool buttons: 1 Select, 2 Draw, 3 Split, 4 Erase
                            Rectangle {
                                background: #0c1018;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #ffffff10;
                                height: 20px;

                                HorizontalLayout {
                                    padding: 1px;
                                    spacing: 2px;

                                    Rectangle {
                                        background: root.roll-tool == 1 ? Theme.accent : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            Text {
                                                text: "选区";
                                                font-family: Tokens.font-ui;
                                                font-size: 8px;
                                                font-weight: 700;
                                                color: root.roll-tool == 1 ? #020617 : #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                        pr_sel_touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.roll-tool = 1; }
                                        }
                                        TooltipBubble { text: "选区工具: 选择与移动音符 [1]"; is-visible: pr_sel_touch.has-hover; tip-offset-y: 22px; }
                                    }

                                    Rectangle {
                                        background: root.roll-tool == 2 ? Theme.accent : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            Text {
                                                text: "画笔";
                                                font-family: Tokens.font-ui;
                                                font-size: 8px;
                                                font-weight: 700;
                                                color: root.roll-tool == 2 ? #020617 : #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                        pr_draw_touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.roll-tool = 2; }
                                        }
                                        TooltipBubble { text: "画笔工具: 点击网格绘制音符 [2]"; is-visible: pr_draw_touch.has-hover; tip-offset-y: 22px; }
                                    }

                                    Rectangle {
                                        background: root.roll-tool == 3 ? Theme.accent : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            Text {
                                                text: "切分";
                                                font-family: Tokens.font-ui;
                                                font-size: 8px;
                                                font-weight: 700;
                                                color: root.roll-tool == 3 ? #020617 : #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                        pr_split_touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.roll-tool = 3; }
                                        }
                                        TooltipBubble { text: "切分工具: 点击分割音符 [3]"; is-visible: pr_split_touch.has-hover; tip-offset-y: 22px; }
                                    }

                                    Rectangle {
                                        background: root.roll-tool == 4 ? Theme.status-alert : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            Text {
                                                text: "橡皮";
                                                font-family: Tokens.font-ui;
                                                font-size: 8px;
                                                font-weight: 700;
                                                color: root.roll-tool == 4 ? #ffffff : #94a3b8;
                                                vertical-alignment: center;
                                            }
                                        }
                                        pr_del_touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.roll-tool = 4; }
                                        }
                                        TooltipBubble { text: "橡皮工具: 点击删除音符 [4]"; is-visible: pr_del_touch.has-hover; tip-offset-y: 22px; }
                                    }
                                }
                            }

                            // Scale fold toggle
                            Rectangle {
                                background: root.scale-folded ? Theme.accent.with-alpha(0.18) : #141926;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: root.scale-folded ? Theme.accent : Theme.border-subtle;
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 3px;
                                    Text {
                                        text: root.scale-folded ? "●" : "○";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "折叠调外音";
                                        font-family: Tokens.font-ui;
                                        font-size: 8px;
                                        color: #f8fafc;
                                        vertical-alignment: center;
                                    }
                                }
                                pr_fold_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.scale-folded = !root.scale-folded;
                                        root.toggle-scale-fold(root.scale-folded);
                                    }
                                }
                                TooltipBubble { text: "折叠调外音: 仅显示当前调式内的音高"; is-visible: pr_fold_touch.has-hover; tip-offset-y: 22px; }
                            }
                        }

                        // Right: Snap & Velocity toggle
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: end;

                            // Snap selector
                            Rectangle {
                                background: #141926;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 3px;
                                    Text {
                                        text: "吸附:";
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        color: #64748b;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.roll-snap;
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                                pr_snap_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        if (root.roll-snap == "1/16") { root.roll-snap = "1/8"; }
                                        else if (root.roll-snap == "1/8") { root.roll-snap = "1/4"; }
                                        else if (root.roll-snap == "1/4") { root.roll-snap = "1/32"; }
                                        else { root.roll-snap = "1/16"; }
                                    }
                                }
                                TooltipBubble { text: "网格吸附量化 (1/16, 1/8, 1/4, 1/32)"; is-visible: pr_snap_touch.has-hover; tip-offset-x: -30px; tip-offset-y: 22px; }
                            }

                            // Velocity toggle
                            Rectangle {
                                background: root.show-velocity ? Theme.accent.with-alpha(0.18) : #141926;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: root.show-velocity ? Theme.accent : Theme.border-subtle;
                                height: 20px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: root.show-velocity ? "力度泳道: 开" : "力度泳道: 关";
                                        font-family: Tokens.font-ui;
                                        font-size: 8px;
                                        color: root.show-velocity ? Theme.accent : #94a3b8;
                                        vertical-alignment: center;
                                    }
                                }
                                pr_vel_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.show-velocity = !root.show-velocity; }
                                }
                                TooltipBubble { text: "切换显示底部力度/MPE 表情泳道"; is-visible: pr_vel_touch.has-hover; tip-offset-x: -40px; tip-offset-y: 22px; }
                            }
                        }
                    }
                }

                // 2. Main Piano Roll Work Area: Left Keyboard + Right Canvas (Ruler, Note Lanes, Notes)
                HorizontalLayout {
                    spacing: 4px;
                    vertical-stretch: 1;

                    // Left Vertical Piano Keyboard (Modern DAW tactile acoustic keyboard)
                    Rectangle {
                        width: 96px;
                        vertical-stretch: 1;
                        background: #131722;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        clip: true;

                        VerticalLayout {
                            padding: 0px;
                            spacing: 0px;

                            // Header spacer matching ruler
                            Rectangle {
                                height: 18px;
                                background: #161a26;
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: #262d3d;
                                }
                                Text {
                                    text: "KEY / PITCH";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    letter-spacing: 0.5px;
                                    color: #64748b;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // 16 Piano Keys: C5 down to A3
                            Rectangle {
                                vertical-stretch: 1;
                                min-height: 192px;

                                // Modern Studio Keyboard Accent Margin
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: Theme.accent;
                                }

                                // Keys Stack (from x: 3px to parent.width)
                                VerticalLayout {
                                    x: 3px;
                                    y: 0;
                                    width: parent.width - 3px;
                                    height: parent.height;
                                    padding: 0px;
                                    spacing: 0px;

                                    for key_info[k_idx] in [
                                        { name: "C5", is_black: false, is_c: true },
                                        { name: "B4", is_black: false, is_c: false },
                                        { name: "Bb4", is_black: true, is_c: false },
                                        { name: "A4", is_black: false, is_c: false },
                                        { name: "Ab4", is_black: true, is_c: false },
                                        { name: "G4", is_black: false, is_c: false },
                                        { name: "F#4", is_black: true, is_c: false },
                                        { name: "F4", is_black: false, is_c: false },
                                        { name: "E4", is_black: false, is_c: false },
                                        { name: "Eb4", is_black: true, is_c: false },
                                        { name: "D4", is_black: false, is_c: false },
                                        { name: "Db4", is_black: true, is_c: false },
                                        { name: "C4", is_black: false, is_c: true },
                                        { name: "B3", is_black: false, is_c: false },
                                        { name: "Bb3", is_black: true, is_c: false },
                                        { name: "A3", is_black: false, is_c: false }
                                    ] : Rectangle {
                                        vertical-stretch: 1;
                                        min-height: 12px;

                                        // If White Key: Studio ivory-slate finish, dark slit divider, top sheen highlight, right bevel
                                        if !key_info.is_black : Rectangle {
                                            width: parent.width;
                                            height: parent.height;
                                            background: key_info.is_c ? #f1f5f9 : #d8dee9;

                                            // Bottom key slit divider
                                            Rectangle {
                                                y: parent.height - 1px;
                                                height: 1px;
                                                background: #334155;
                                            }

                                            // Top sheen highlight line
                                            Rectangle {
                                                x: 0;
                                                y: 0;
                                                width: parent.width;
                                                height: 1px;
                                                background: #ffffff;
                                            }

                                            // Right edge bevel
                                            Rectangle {
                                                x: parent.width - 3px;
                                                y: 0;
                                                width: 3px;
                                                height: parent.height;
                                                background: #cbd5e1;
                                            }

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                alignment: space-between;

                                                Text {
                                                    text: key_info.name;
                                                    font-family: Tokens.font-mono;
                                                    font-size: key_info.is_c ? 8px : 7px;
                                                    font-weight: key_info.is_c ? 800 : 600;
                                                    color: key_info.is_c ? #0284c7 : #1e293b;
                                                    vertical-alignment: center;
                                                }

                                                if key_info.is_c : Rectangle {
                                                    width: 18px;
                                                    height: 9px;
                                                    border-radius: 2px;
                                                    background: Theme.accent.with-alpha(0.20);
                                                    border-width: 0.6px;
                                                    border-color: Theme.accent.with-alpha(0.55);
                                                    Text {
                                                        text: key_info.name;
                                                        font-family: Tokens.font-mono;
                                                        font-size: 7px;
                                                        font-weight: 800;
                                                        color: Theme.accent;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => {
                                                    root.piano-key-clicked(key_info.name, k_idx);
                                                }
                                            }
                                        }

                                        // If Black Key: Modern tactile dark slate body, top catch light, right bevel edge, bottom drop shadow
                                        if key_info.is_black : Rectangle {
                                            width: parent.width;
                                            height: parent.height;

                                            Rectangle {
                                                x: 0;
                                                y: 0;
                                                width: parent.width;
                                                height: parent.height;
                                                background: #141722;
                                                border-radius: 1px;

                                                // Top highlight catch-light line
                                                Rectangle {
                                                    x: 0;
                                                    y: 0;
                                                    width: parent.width;
                                                    height: 1px;
                                                    background: #2d3748;
                                                }

                                                // Bottom drop shadow
                                                Rectangle {
                                                    x: 0;
                                                    y: parent.height - 1px;
                                                    width: parent.width;
                                                    height: 1px;
                                                    background: #080b12;
                                                }

                                                // Right bevel edge
                                                Rectangle {
                                                    x: parent.width - 3px;
                                                    y: 0;
                                                    width: 3px;
                                                    height: parent.height;
                                                    background: #1e2535;
                                                }

                                                HorizontalLayout {
                                                    padding-left: 5px;
                                                    padding-right: 5px;
                                                    alignment: space-between;

                                                    Text {
                                                        text: key_info.name;
                                                        font-family: Tokens.font-mono;
                                                        font-size: 7px;
                                                        font-weight: 700;
                                                        color: #cbd5e1;
                                                        vertical-alignment: center;
                                                    }

                                                    Rectangle {
                                                        width: 2px;
                                                        height: 6px;
                                                        border-radius: 1px;
                                                        background: #ffffff25;
                                                    }
                                                }

                                                TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => {
                                                        root.piano-key-clicked(key_info.name, k_idx);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right Piano Roll Grid & Traditional Note Canvas (Harmonious studio slate tones + crisp dividers + clear notes)
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;
                        vertical-stretch: 1;

                        // Measure / Beat Ruler (Height: 18px, 64 steps across 4 measures)
                        Rectangle {
                            height: 18px;
                            background: #121622;
                            border-radius: Theme.radius;
                            border-bottom-left-radius: 0;
                            border-bottom-right-radius: 0;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            clip: true;

                            HorizontalLayout {
                                padding-left: 0px;
                                padding-right: 0px;
                                spacing: 0px;

                                for beat_idx in 64 : Rectangle {
                                    width: 42px;
                                    background: (Math.mod(beat_idx, 16) == 0) ? #1a202c : transparent;
                                    Rectangle {
                                        x: parent.width - 1px;
                                        width: (Math.mod(beat_idx, 16) == 15) ? 2px : ((Math.mod(beat_idx, 4) == 3) ? 1.5px : 1px);
                                        height: parent.height;
                                        background: (Math.mod(beat_idx, 16) == 15) ? #ffffff44 : ((Math.mod(beat_idx, 4) == 3) ? #ffffff20 : #ffffff0e);
                                    }

                                    Text {
                                        x: 3px;
                                        text: (Math.mod(beat_idx, 4) == 0) ? ("" + (Math.floor(beat_idx / 4) + 1) + ".1") : ("." + (Math.mod(beat_idx, 4) + 1));
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: (Math.mod(beat_idx, 4) == 0) ? 800 : 400;
                                        color: (Math.mod(beat_idx, 4) == 0) ? Theme.accent : #64748b;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Note Grid Canvas (Horizontal pitch lanes + Vertical step lines + Note Bars)
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 192px;
                            background: #141822;
                            border-radius: Theme.radius;
                            border-top-left-radius: 0;
                            border-top-right-radius: 0;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            clip: true;

                            // 16 Horizontal Pitch Lanes (High visual contrast: soft slate lanes, octave guide, crisp dividers)
                            VerticalLayout {
                                width: parent.width;
                                height: parent.height;
                                padding: 0px;
                                spacing: 0px;

                                for lane_idx in 16 : Rectangle {
                                    vertical-stretch: 1;
                                    min-height: 12px;
                                    // Studio harmonious contrast: C roots (#252d3d), white keys (#1f2432), black keys (#171b25)
                                    background: (lane_idx == 0 || lane_idx == 12) ? #252d3d : ((lane_idx == 2 || lane_idx == 4 || lane_idx == 6 || lane_idx == 9 || lane_idx == 11 || lane_idx == 14) ? #171b25 : #1f2432);

                                    // Crisp Horizontal Divider between every pitch row
                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        background: (lane_idx == 0 || lane_idx == 12) ? #38bdf860 : #232a3a;
                                    }
                                }
                            }

                            // 64 Vertical Step Grid Dividers (Delicate neutral alpha grid)
                            HorizontalLayout {
                                padding: 0px;
                                spacing: 0px;

                                for s_idx in 64 : Rectangle {
                                    width: 42px;
                                    Rectangle {
                                        x: parent.width - 1px;
                                        width: (Math.mod(s_idx, 16) == 15) ? 2px : ((Math.mod(s_idx, 4) == 3) ? 1.5px : 1px);
                                        height: parent.height;
                                        background: (Math.mod(s_idx, 16) == 15) ? #ffffff44 : ((Math.mod(s_idx, 4) == 3) ? #ffffff20 : #ffffff0e);
                                    }
                                }
                            }

                            // Click on empty grid to draw/insert note
                            TouchArea {
                                clicked => {
                                    let row_h = Math.max(12px, self.height / 16);
                                    let clicked-step = Math.min(63, Math.max(0, Math.floor(self.mouse-x / 42px)));
                                    let clicked-row = Math.min(15, Math.max(0, Math.floor(self.mouse-y / row_h)));
                                    if (root.roll-tool == 2) {
                                        root.canvas-create-note(clicked-row, clicked-step);
                                    } else {
                                        root.canvas-clicked(clicked-row, clicked-step);
                                    }
                                }
                            }

                            // Traditional DAW Note Bars (Proportional height based on row)
                            for note[n_idx] in root.notes : Rectangle {
                                property <length> row_h: Math.max(12px, parent.height / 16);
                                x: note.start_step * 42px + 1px;
                                y: note.pitch_row * self.row_h + 1px;
                                width: Math.max(12px, note.step_span * 42px - 2px);
                                height: Math.max(10px, self.row_h - 2px);
                                border-radius: 2px;
                                background: note.selected ? #38bdf8 : root.selected-track-color;
                                border-width: note.selected ? 1.5px : 1px;
                                border-color: note.selected ? #ffffff : #ffffff60;

                                // Note top highlight line
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: 1px;
                                    background: #ffffff88;
                                }

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    alignment: space-between;

                                    Text {
                                        text: note.pitch_name;
                                        font-family: Tokens.font-mono;
                                        font-size: 7.5px;
                                        font-weight: 800;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    // Right resize handle bar
                                    Rectangle {
                                        width: 2.5px;
                                        height: 6px;
                                        background: #ffffff88;
                                        border-radius: 1px;
                                    }
                                }

                                note_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        if (root.roll-tool == 4) {
                                            root.delete-note(note.id);
                                        } else if (root.roll-tool == 3) {
                                            root.split-note(note.id);
                                        } else {
                                            root.selected-note-id = note.id;
                                            root.select-note(note.id);
                                        }
                                    }
                                }
                            }

                            // Playhead Scrub Line
                            Rectangle {
                                x: Math.max(0px, root.playhead-px);
                                y: 0;
                                width: 1.5px;
                                height: parent.height;
                                background: Theme.accent;

                                // Top playhead cursor flag
                                Rectangle {
                                    x: -3px;
                                    y: 0;
                                    width: 7px;
                                    height: 5px;
                                    background: Theme.accent;
                                    border-bottom-left-radius: 1px;
                                    border-bottom-right-radius: 1px;
                                }
                            }
                        }
                    }
                }

                // 3. Bottom Velocity Lane (Aligned with 42px steps)
                if root.show-velocity : Rectangle {
                    height: 34px;
                    background: #06080d;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;

                        // Left velocity label (width: 96px aligned with keyboard)
                        Rectangle {
                            width: 96px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "VELOCITY 力度";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    color: #64748b;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "MPE";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    color: root.selected-track-color;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Stalks container aligned with 42px steps
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;

                            // Velocity stalks for active notes
                            for note in root.notes : Rectangle {
                                x: note.start_step * 42px + 20px;
                                y: parent.height - (note.velocity * 24px / 127) - 3px;
                                width: 2px;
                                height: (note.velocity * 24px / 127) + 2px;
                                background: note.selected ? #ffffff : root.selected-track-color.with-alpha(0.7);

                                // Lollipop handle cap
                                Rectangle {
                                    x: -2px;
                                    y: 0px;
                                    width: 6px;
                                    height: 3px;
                                    border-radius: 1.5px;
                                    background: note.selected ? #ffffff : root.selected-track-color;
                                }

                                TouchArea {
                                    clicked => {
                                        root.selected-note-id = note.id;
                                        root.select-note(note.id);
                                        let next-vel = note.velocity >= 115 ? 70 : (note.velocity + 15);
                                        root.velocity-changed(note.id, next-vel);
                                    }
                                }
                            }

                            // 64 step baseline
                            Rectangle {
                                x: 0;
                                y: parent.height - 2px;
                                width: parent.width;
                                height: 1px;
                                background: #ffffff0a;
                            }
                        }
                    }
                }
            }
        }
    }
}
