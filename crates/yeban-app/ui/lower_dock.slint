import { Theme, TrackData, PianoStepRow } from "tokens.slint";

export component UnifiedLowerDock inherits Rectangle {
    in-out property <string> active-tab: "stacked"; // "stacked" | "devices" | "mixer" | "pianoroll"
    in-out property <string> focus-track-name: "01. Lead Neuro Bass";
    in-out property <[TrackData]> tracks;
    in-out property <int> selected-track-id: 1;

    // Wavetable device params
    in-out property <int> wt-pos-val: 64;
    in-out property <int> wt-cutoff-hz: 4800;
    in-out property <int> wt-reso-val: 35;

    // EQ device params
    in-out property <string> eq-low-db: "+2.4dB";
    in-out property <string> eq-mid-db: "-1.8dB";
    in-out property <string> eq-air-db: "+3.5dB";

    // Compressor device params
    in-out property <float> comp-gr-fraction: 0.34;
    in-out property <string> comp-gr-text: "-4.2 dB";

    // Piano Roll
    in-out property <bool> scale-folded: true;
    in-out property <[PianoStepRow]> piano-rows: [
        { pitch_name: "C4 (Root)", is_root: true,  step0: true,  step1: false, step2: false, step3: true,  step4: false, step5: true,  step6: false, step7: false, step8: true,  step9: false, step10: false, step11: true,  step12: false, step13: true,  step14: false, step15: false },
        { pitch_name: "Bb3 (m7)",  is_root: false, step0: false, step1: true,  step2: false, step3: false, step4: true,  step5: false, step6: false, step7: true,  step8: false, step9: true,  step10: false, step11: false, step12: true,  step13: false, step14: false, step15: true  },
        { pitch_name: "Ab3 (b6)",  is_root: false, step0: false, step1: false, step2: true,  step3: false, step4: false, step5: false, step6: true,  step7: false, step8: false, step9: false, step10: true,  step11: false, step12: false, step13: false, step14: true,  step15: false },
        { pitch_name: "G3 (5th)",  is_root: false, step0: true,  step1: false, step2: false, step3: false, step4: true,  step5: false, step6: false, step7: false, step8: true,  step9: false, step10: false, step11: false, step12: true,  step13: false, step14: false, step15: false },
        { pitch_name: "Eb3 (m3)",  is_root: false, step0: false, step1: false, step2: true,  step3: false, step4: false, step5: true,  step6: false, step7: false, step8: false, step9: false, step10: true,  step11: false, step12: false, step13: true,  step14: false, step15: false },
        { pitch_name: "C3 (Sub)",  is_root: true,  step0: true,  step1: false, step2: false, step3: false, step4: false, step5: false, step6: false, step7: false, step8: true,  step9: false, step10: false, step11: false, step12: false, step13: false, step14: false, step15: false }
    ];

    callback select-tab(string);
    callback select-track(int);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback track-volume-change(int, float);
    callback set-wt-pos(int);
    callback set-wt-cutoff(int);
    callback toggle-piano-step(int, int);
    callback toggle-scale-fold(bool);

    function toggle-step(r-idx: int, s-idx: int) {
        if (s-idx == 0) { root.piano-rows[r-idx].step0 = !root.piano-rows[r-idx].step0; }
        else if (s-idx == 1) { root.piano-rows[r-idx].step1 = !root.piano-rows[r-idx].step1; }
        else if (s-idx == 2) { root.piano-rows[r-idx].step2 = !root.piano-rows[r-idx].step2; }
        else if (s-idx == 3) { root.piano-rows[r-idx].step3 = !root.piano-rows[r-idx].step3; }
        else if (s-idx == 4) { root.piano-rows[r-idx].step4 = !root.piano-rows[r-idx].step4; }
        else if (s-idx == 5) { root.piano-rows[r-idx].step5 = !root.piano-rows[r-idx].step5; }
        else if (s-idx == 6) { root.piano-rows[r-idx].step6 = !root.piano-rows[r-idx].step6; }
        else if (s-idx == 7) { root.piano-rows[r-idx].step7 = !root.piano-rows[r-idx].step7; }
        else if (s-idx == 8) { root.piano-rows[r-idx].step8 = !root.piano-rows[r-idx].step8; }
        else if (s-idx == 9) { root.piano-rows[r-idx].step9 = !root.piano-rows[r-idx].step9; }
        else if (s-idx == 10) { root.piano-rows[r-idx].step10 = !root.piano-rows[r-idx].step10; }
        else if (s-idx == 11) { root.piano-rows[r-idx].step11 = !root.piano-rows[r-idx].step11; }
        else if (s-idx == 12) { root.piano-rows[r-idx].step12 = !root.piano-rows[r-idx].step12; }
        else if (s-idx == 13) { root.piano-rows[r-idx].step13 = !root.piano-rows[r-idx].step13; }
        else if (s-idx == 14) { root.piano-rows[r-idx].step14 = !root.piano-rows[r-idx].step14; }
        else if (s-idx == 15) { root.piano-rows[r-idx].step15 = !root.piano-rows[r-idx].step15; }
        root.toggle-piano-step(r-idx, s-idx);
    }

    height: 256px;
    background: Theme.bg-panel;
    // border line
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // DOCK TAB BAR
        Rectangle {
            height: 32px;
            background: #00000040;
            // border line
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 6px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        background: root.active-tab == "stacked" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        Text {
                            text: "🎛️ 堆叠视图 (Aether)";
                            font-size: 10px;
                            font-weight: 700;
                            color: root.active-tab == "stacked" ? #020617 : #94a3b8;
                            }
                        TouchArea { clicked => { root.select-tab("stacked"); } }
                    }

                    Rectangle {
                        background: root.active-tab == "devices" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        Text {
                            text: "⚡ 内联设备链 (Ableton)";
                            font-size: 10px;
                            font-weight: 700;
                            color: root.active-tab == "devices" ? #020617 : #94a3b8;
                            }
                        TouchArea { clicked => { root.select-tab("devices"); } }
                    }

                    Rectangle {
                        background: root.active-tab == "mixer" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        Text {
                            text: "🎚️ 混音台 (MixConsole)";
                            font-size: 10px;
                            font-weight: 700;
                            color: root.active-tab == "mixer" ? #020617 : #94a3b8;
                            }
                        TouchArea { clicked => { root.select-tab("mixer"); } }
                    }

                    Rectangle {
                        background: root.active-tab == "pianoroll" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        Text {
                            text: "🎹 MPE 钢琴卷帘";
                            font-size: 10px;
                            font-weight: 700;
                            color: root.active-tab == "pianoroll" ? #020617 : #94a3b8;
                            }
                        TouchArea { clicked => { root.select-tab("pianoroll"); } }
                    }
                }

                // Focus track badge
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        background: Theme.accent.with-alpha(0.15);
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.4);
                        Text {
                            text: "Focus: " + root.focus-track-name;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.accent;
                            }
                    }
                }
            }
        }

        // DOCK BODY CONTENT (Panes)
        HorizontalLayout {
            padding: 6px;
            spacing: 6px;
            vertical-stretch: 1;

            // PANE: INLINE DSP DEVICES (Visible in stacked or devices mode)
            if root.active-tab == "stacked" || root.active-tab == "devices" : HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                // Device 1: Wavetable MPE Synth
                Rectangle {
                    width: 230px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        alignment: space-between;

                        HorizontalLayout {
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #06b6d4; }
                            Text { text: "Wavetable MPE Synth"; font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                            Text { text: "OSC 1+2"; font-size: 8px; color: #38bdf8; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                        }

                        // 3D Morph Wave SVG
                        Rectangle {
                            height: 72px;
                            background: #06090f;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #1e293b;
                            clip: true;

                            Path {
                                commands: "M 0 55 Q 25 20, 50 50 T 100 30 T 160 45";
                                stroke: #06b6d440;
                                stroke-width: 1.5px;
                            }
                            Path {
                                commands: "M 0 35 Q 25 8, 50 35 T 100 15 T 160 30";
                                stroke: #06b6d4;
                                stroke-width: 2.2px;
                            }
                            Path {
                                commands: "M 0 60 Q 35 30, 70 55 T 120 38 T 160 52";
                                stroke: #10b98140;
                                stroke-width: 1.5px;
                            }

                            HorizontalLayout {
                                x: 6px;
                                y: 56px;
                                width: parent.width - 12px;
                                alignment: space-between;
                                Text { text: "POS: " + root.wt-pos-val + "%"; font-size: 8px; font-weight: 700; color: #38bdf8; }
                                Text { text: "UNISON: 4 Voices"; font-size: 8px; color: #64748b; }
                            }
                        }

                        // Quick Knobs / Sliders
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: #00000030;
                                border-radius: 3px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 3px;
                                    Text { text: "WT Pos"; font-size: 8px; color: #94a3b8; horizontal-alignment: center; }
                                    Text { text: "" + root.wt-pos-val + "%"; font-size: 9px; font-weight: 700; color: #38bdf8; horizontal-alignment: center; }
                                }
                                TouchArea {
                                    clicked => {
                                        root.wt-pos-val = root.wt-pos-val == 64 ? 85 : 64;
                                        root.set-wt-pos(root.wt-pos-val);
                                    }
                                }
                            }

                            Rectangle {
                                background: #00000030;
                                border-radius: 3px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 3px;
                                    Text { text: "Cutoff"; font-size: 8px; color: #94a3b8; horizontal-alignment: center; }
                                    Text { text: "" + root.wt-cutoff-hz + "Hz"; font-size: 9px; font-weight: 700; color: #10b981; horizontal-alignment: center; }
                                }
                                TouchArea {
                                    clicked => {
                                        root.wt-cutoff-hz = root.wt-cutoff-hz == 4800 ? 8200 : 4800;
                                        root.set-wt-cutoff(root.wt-cutoff-hz);
                                    }
                                }
                            }

                            Rectangle {
                                background: #00000030;
                                border-radius: 3px;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 3px;
                                    Text { text: "Reso"; font-size: 8px; color: #94a3b8; horizontal-alignment: center; }
                                    Text { text: "" + root.wt-reso-val + "%"; font-size: 9px; font-weight: 700; color: #f59e0b; horizontal-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Device 2: Pro-QLinear 8-band Dynamic EQ
                Rectangle {
                    width: 250px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        alignment: space-between;

                        HorizontalLayout {
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #10b981; }
                            Text { text: "Pro-QLinear 8 (内联频谱)"; font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                            Text { text: "" + root.wt-cutoff-hz + " Hz"; font-size: 8px; color: #10b981; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                        }

                        // EQ Curve + Spectrum Display
                        Rectangle {
                            height: 72px;
                            background: #06090f;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #1e293b;
                            clip: true;

                                HorizontalLayout {
                                    x: 4px;
                                    y: 8px;
                                    width: parent.width - 8px;
                                    height: 56px;
                                    spacing: 2px;
                                    alignment: end;

                                    for h in [12px, 18px, 28px, 42px, 35px, 48px, 32px, 25px, 38px, 44px, 30px, 22px, 16px, 24px, 18px, 10px] : Rectangle {
                                        width: 8px;
                                        height: h;
                                        background: #10b98135;
                                        border-radius: 1px;
                                    }
                                }

                            // Dynamic Filter Curve Path
                            Path {
                                commands: "M 0 52 Q 40 46, 75 22 T 145 32 T 220 54";
                                stroke: #10b981;
                                stroke-width: 2.2px;
                            }
                        }

                        // Low / Mid / Air readouts
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                background: #00000030;
                                border-radius: 3px;
                                horizontal-stretch: 1;
                                Text { text: "LOW: " + root.eq-low-db; font-size: 8px; font-weight: 700; color: #38bdf8; horizontal-alignment: center; }
                            }
                            Rectangle {
                                background: #00000030;
                                border-radius: 3px;
                                horizontal-stretch: 1;
                                Text { text: "MID: " + root.eq-mid-db; font-size: 8px; font-weight: 700; color: #10b981; horizontal-alignment: center; }
                            }
                            Rectangle {
                                background: #00000030;
                                border-radius: 3px;
                                horizontal-stretch: 1;
                                Text { text: "AIR: " + root.eq-air-db; font-size: 8px; font-weight: 700; color: #f59e0b; horizontal-alignment: center; }
                            }
                        }
                    }
                }

                // Device 3: VCA Glue Compressor
                Rectangle {
                    width: 200px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        alignment: space-between;

                        HorizontalLayout {
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #f59e0b; }
                            Text { text: "VCA Glue Compressor"; font-size: 10px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                            Text { text: root.comp-gr-text; font-size: 8px; color: #f59e0b; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
                        }

                        // GR Meter Box
                        Rectangle {
                            height: 72px;
                            background: #06090f;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #1e293b;

                            VerticalLayout {
                                padding: 6px;
                                alignment: space-between;

                                HorizontalLayout {
                                    Text { text: "Gain Reduction"; font-size: 8px; color: #94a3b8; }
                                    Text { text: root.comp-gr-text; font-size: 9px; font-weight: 800; color: #f59e0b; horizontal-alignment: right; }
                                }

                                Rectangle {
                                    height: 8px;
                                    background: #1e293b;
                                    border-radius: 4px;
                                    Rectangle {
                                        x: 0;
                                        width: root.comp-gr-fraction * parent.width;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: #f59e0b;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Atk: 10ms"; font-size: 8px; color: #64748b; }
                                    Text { text: "Rel: Auto"; font-size: 8px; color: #64748b; }
                                    Text { text: "Ratio: 4:1"; font-size: 8px; color: #64748b; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #00000030;
                                border-radius: 3px;
                                horizontal-stretch: 1;
                                Text { text: "Thresh: -16dB"; font-size: 8px; color: #cbd5e1; horizontal-alignment: center; }
                            }
                            Rectangle {
                                background: #00000030;
                                border-radius: 3px;
                                horizontal-stretch: 1;
                                Text { text: "Makeup: +4.5dB"; font-size: 8px; color: #cbd5e1; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }

            // PANE: MIXCONSOLE (Visible in stacked or mixer mode)
            if root.active-tab == "stacked" || root.active-tab == "mixer" : Rectangle {
                width: root.active-tab == "stacked" ? 440px : 700px;
                horizontal-stretch: root.active-tab == "stacked" ? 0 : 1;
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding: 6px;
                    spacing: 6px;

                    for trk in root.tracks : Rectangle {
                        width: 80px;
                        background: #090c13;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: trk.id == root.selected-track-id ? Theme.accent : #1e293b;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 3px;
                            alignment: space-between;

                            // Color label
                            Rectangle {
                                height: 16px;
                                background: trk.color;
                                border-radius: 2px;
                                Text { text: trk.name; font-size: 8px; font-weight: 800; color: #020617; horizontal-alignment: center; overflow: elide; }
                            }

                            // Inserts
                            Rectangle {
                                height: 14px;
                                background: #1e293b;
                                border-radius: 2px;
                                Text { text: trk.insert1; font-size: 7px; color: #cbd5e1; horizontal-alignment: center; overflow: elide; }
                            }

                            // M / S / Pan
                            HorizontalLayout {
                                spacing: 2px;
                                Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 2px;
                                    background: trk.muted ? #f59e0b : #1e293b;
                                    Text { text: "M"; font-size: 7px; font-weight: 800; color: trk.muted ? #020617 : #94a3b8; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.toggle-track-mute(trk.id); } }
                                }
                                Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 2px;
                                    background: trk.soloed ? #06b6d4 : #1e293b;
                                    Text { text: "S"; font-size: 7px; font-weight: 800; color: trk.soloed ? #020617 : #94a3b8; horizontal-alignment: center; }
                                    TouchArea { clicked => { root.toggle-track-solo(trk.id); } }
                                }
                                Text { text: trk.pan; font-size: 8px; color: #64748b; horizontal-alignment: right; vertical-alignment: center; }
                            }

                            // Vertical Fader
                            Rectangle {
                                height: 80px;
                                background: #06090e;
                                border-radius: 2px;

                                Rectangle {
                                    x: 2px;
                                    y: 35px;
                                    width: parent.width - 4px;
                                    height: 14px;
                                    background: #94a3b8;
                                    border-radius: 2px;
                                }

                                TouchArea {
                                    clicked => {
                                        root.select-track(trk.id);
                                        root.track-volume-change(trk.id, trk.volume_db == -2.5 ? 0.0 : -2.5);
                                    }
                                }
                            }

                            Text {
                                text: "" + trk.volume_db + " dB";
                                font-size: 9px;
                                font-weight: 700;
                                color: trk.color;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-track(trk.id); } }
                    }
                }
            }

            // PANE: MPE PIANO ROLL (Visible when pianoroll tab active)
            if root.active-tab == "pianoroll" : HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                // Left Piano Keys & Scale lock
                Rectangle {
                    width: 150px;
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        Text { text: "🎹 音阶折叠与 MPE"; font-size: 10px; font-weight: 800; color: Theme.accent; }

                        Rectangle {
                            height: 22px;
                            background: root.scale-folded ? Theme.accent.with-alpha(0.2) : #1e293b;
                            border-radius: 3px;
                            border-width: root.scale-folded ? 1px : 0;
                            border-color: Theme.accent;

                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 4px;
                                Text { text: root.scale-folded ? "✓" : "○"; font-size: 9px; font-weight: 800; color: Theme.accent; }
                                Text { text: "仅显示调内音符"; font-size: 9px; color: #f8fafc; vertical-alignment: center; }
                            }
                            TouchArea {
                                clicked => {
                                    root.scale-folded = !root.scale-folded;
                                    root.toggle-scale-fold(root.scale-folded);
                                }
                            }
                        }

                        // Piano key rows
                        VerticalLayout {
                            spacing: 3px;
                            vertical-stretch: 1;

                            for row in root.piano-rows : Rectangle {
                                height: 22px;
                                background: row.is_root ? #1e293b : #0f172a;
                                border-radius: 2px;

                                Text {
                                    x: 6px;
                                    text: row.pitch_name;
                                    font-size: 9px;
                                    font-weight: row.is_root ? 800 : 500;
                                    color: row.is_root ? Theme.accent : #cbd5e1;
                                    }
                            }
                        }
                    }
                }

                // 16-Step Grid
                Rectangle {
                    horizontal-stretch: 1;
                    background: #080a0f;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;

                        for row[r-idx] in root.piano-rows : HorizontalLayout {
                            height: 22px;
                            spacing: 3px;

                            Rectangle { background: row.step0 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 0); } } }
                            Rectangle { background: row.step1 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 1); } } }
                            Rectangle { background: row.step2 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 2); } } }
                            Rectangle { background: row.step3 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 3); } } }
                            Rectangle { background: row.step4 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 4); } } }
                            Rectangle { background: row.step5 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 5); } } }
                            Rectangle { background: row.step6 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 6); } } }
                            Rectangle { background: row.step7 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 7); } } }
                            Rectangle { background: row.step8 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 8); } } }
                            Rectangle { background: row.step9 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 9); } } }
                            Rectangle { background: row.step10 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 10); } } }
                            Rectangle { background: row.step11 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 11); } } }
                            Rectangle { background: row.step12 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 12); } } }
                            Rectangle { background: row.step13 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 13); } } }
                            Rectangle { background: row.step14 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 14); } } }
                            Rectangle { background: row.step15 ? Theme.accent : #ffffff08; border-radius: 2px; TouchArea { clicked => { root.toggle-step(r-idx, 15); } } }
                        }
                    }
                }
            }
        }
    }
}
