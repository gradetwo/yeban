// 夜半 (Yeban) — 多轨调音台与 VU 电平表 (底部控制台 Tab 2)
//
// 规范来源 (Normative):
//   - 规范 §5.2: 调音台通道条 (Pro Channel Strip & Metering)
//   - [UI-TEST-001] §12.2: `track-{track_index}-fader` 是**推子**的语义 ID 约定
//   - [UI-MCP-002] §12.5: VU 电平表是每帧跳变的高频刷新区域, 无头截图比对前必须被遮罩
//     (注册表里 `track-{i}-meter` / `mixer-master-meter` 的 `dynamic_region = true`)
//   - [ARCH-UI-002]: **"UI 线程绝不直接读取音频实时上下文。实时线程以 60Hz 速度向无锁
//     Meter SPSC 压入真峰值与 RMS 电平，UI 线程定时器批量出队更新 Slint Properties。"**
//   - [MODEL-AST-002]: 通道条的轨道名 / 音量 / 声相 / 静音 / 独奏 / 色标来自
//     `YebanProjectV1` 的投影（`src/bridge.rs`），**不是** .slint 里的字面量
//
// ## 这一版改了什么（本工作线的核心）
//
// 上一版这里是 `for track_index in 6` + 内联的 `levels` / `db-labels` 演示数组：
// 通道条数被**刻死**在 6，音量与"电平"是同一个数，推子位置与电平柱高无法区分。
// 现在：
//
//   1. **规模由工程决定**：`for track_name[track_index] in root.track-names` —— 演示工程 6 条、
//      `filled_project()` 3 条，界面不需要改一行；
//   2. **推子 ≠ 电平**：推子位置来自工程的 `TrackV3::volume_db`
//      (`track-volume-fractions`)，电平柱高来自引擎发布的 `MeterFrame`
//      (`track-meter-levels`)。两件事在界面上与控件树里都是分开的两个属性；
//   3. **电平的 dBFS 进控件树**：`track-{i}-meter` 的 `accessible-label` 携带
//      `"峰值 <x> RMS <y> dBFS"`，`accessible-value` 携带峰值文本 ——
//      否则"UI 真的消费了电平"无法机械验证（`[UI-TEST-001]` 只允许语义 ID 寻址，
//      而 `ui/property` 的清单里没有 `accessible-value`）。
//      **注（`b37f6ad` 起）**：上述括注**已过期** —— `ui/property` 的清单现在有
//      `value`（= `accessible-value` 原文）与 `checked`，dBFS 也能经 `ui/property` 读。
//      本段是《这一版改了什么》的历史记录，按原样保留，只在末尾加这条注。
//
// 数据流方向: 只读。界面只做"取数组下标 + 画像素"，dBFS 换算 / 声相文本 / 推子归一化
// 全在投影层与 `src/meters.rs`（零 Slint 依赖，本机可 `rustc --test` 真跑）。

import { Tokens, UiText, UiMonoText, UiMediumText } from "../tokens.slint";

export component MixerConsole inherits Rectangle {
    // ---- 由 src/host.rs 注入的**投影**数据 (默认空 = 没有内联演示数据) ----
    in property <[string]> track-names: [];
    in property <[string]> track-volumes: [];
    in property <[float]> track-volume-fractions: [];
    in property <[string]> track-pans: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];
    in property <[color]> track-colors: [];
    in property <[string]> track-color-labels: [];

    // ---- 混音**写入面**的三条手势 + 两个开关（`ADR-0005`：工程内容必须走 `Op` + `UndoPort`）----
    //
    // 形状照抄 `ui/workspace/arrangement_view.slint` 的 `track-height-grab/drag/release`：
    // `.slint` **只报**"哪一个下标 + 本地坐标"，位移换算、视图态写入与 `Op` 提交全在宿主
    // （`host::wire_mixer_edit`）。于是：
    //   - **一次拖动 = 一次 `commit_ops`**：`drag` 只改视图态（数值文本与推子位置立即更新），
    //     只有 `release` 才提交。逐像素提交会把一步撤销碎成几百步；
    //   - **数值始终可见**：拖动期的预览写在 `track-volumes` / `track-volume-fractions` /
    //     `track-pans` 上，读的就是下面那两个 `UiMonoText` 与推子帽的 `y`。
    //
    // `length` 就是 Slint 的 `f32`（与 `track-height-*` 同款：宿主只做减法）。
    callback mixer-fader-grab(int, length);
    callback mixer-fader-drag(int, length);
    callback mixer-fader-release(int);
    callback mixer-pan-grab(int, length);
    callback mixer-pan-drag(int, length);
    callback mixer-pan-release(int);
    callback mixer-mute-toggle(int);
    callback mixer-solo-toggle(int);

    // ---- 主控通道条的**写入面**（本切片新增）----
    //
    // ⭐ 为什么主控是**另一组回调**、而不是把主控编成一个下标送进上面那八个：
    // 主总线**不在** `track-names` / `track-ids`（投影刻意排除它，它单独走
    // `ViewState::master`）⇒ 上面那八个回调的 `int` 参数里**没有任何**一个合法值
    // 能指到主控。要么发明一个哨兵下标（`u32::MAX` / `-1`），要么给主控自己的通道。
    // 本仓库选后者：`.slint` 只报"哪一类面板 + 本地坐标"，**不做身份→下标的算术**
    // （与 `host::apply_row_geometry` 把行几何的唯一来源放在宿主是同一条纪律）。
    // 主控的身份由宿主在按下那一刻从权威工程取（`master_bus_track_id`）。
    //
    // 形状与上面三条手势逐条相同 ⇒ 一次拖动 = 一次 `commit_ops`，`Escape` 走**同一个**
    // `mixer-cancel-gesture`（两类目标共用一条取消路径）。
    callback mixer-master-fader-grab(length);
    callback mixer-master-fader-drag(length);
    callback mixer-master-fader-release();
    callback mixer-master-pan-grab(length);
    callback mixer-master-pan-drag(length);
    callback mixer-master-pan-release();

    // ---- 由 src/host.rs 注入的**电平**数据 (60Hz 抽帧的结果) ----
    // `track-meter-peaks` / `track-meter-rmss` 是 `{:.1}` dBFS 文本（**已按 -120 下限钳位**，
    // 且 NaN/±∞ 已在 `src/meters.rs` 落成下限）。`track-meter-levels` 是 0.0–1.0 的柱高。
    // 三者的长度恒等于 `root.track-names.length` —— 换工程时 `host::apply_view` 会先重置成
    // "等长的静音"，因此这里按下标取永远不会越界。
    in property <[string]> track-meter-peaks: [];
    in property <[string]> track-meter-rmss: [];
    in property <[float]> track-meter-levels: [];

    // ---- 主控通道条 (同样由投影 + 电平驱动) ----
    in property <string> master-name: "Master";
    in property <string> master-volume-display: "";
    in property <float> master-volume-fraction: 0.0;
    in property <string> master-pan: "C";
    in property <bool> master-mute: false;
    in property <bool> master-solo: false;
    in property <color> master-color: #2c3a63;
    in property <string> master-color-label: "";
    in property <string> master-meter-peak: "-120.0";
    in property <string> master-meter-rms: "-120.0";
    in property <float> master-meter-level: 0.0;

    background: Tokens.bg-void;
    clip: true;

    accessible-role: region;
    accessible-id: "mixer-console";
    accessible-label: "多轨调音台总控";

    // ---------------------------------------------------------------- 通道条
    // 通道条数 == 工程的非主总线轨道数。`for name[i] in <model>` 必须带声明标识符
    // （Slint 1.18.1 不接受只有索引的 `for [i] in <model>`，见
    // docs/ledger/app-binding-notes.md §6.1）。
    for track_name[track_index] in root.track-names : Rectangle {
        x: Tokens.space-4 + 104px * track_index;
        y: Tokens.space-4;
        width: 96px;
        height: parent.height - 16px;
        background: track_index.mod(2) == 0 ? Tokens.bg-panel : Tokens.bg-shell;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;
        accessible-role: groupbox;
        accessible-id: "track-" + track_index + "-channel-strip";
        accessible-label: "通道条 " + track_name;

        UiMediumText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: 18px;
            text: track_name;
            color: Tokens.ink-0;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }

        // 声相读出 —— **始终可见**的数值（`PAN C` / `PAN L50`，由投影的 `pan_display` 给出，
        // 界面不做任何算术）。本轮起它同时是**声相拖动面**的语义落点：
        // `accessible-value` 让 `pan` 第一次能从控件树读回来（在此之前它只活在标签文本里）。
        UiMonoText {
            x: Tokens.space-3;
            y: 20px;
            width: 28px;
            height: 14px;
            text: "PAN " + root.track-pans[track_index];
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            overflow: elide;
            accessible-role: slider;
            accessible-id: "track-" + track_index + "-pan";
            accessible-label: "轨道 " + track_name + " 声相";
            accessible-orientation: horizontal;
            accessible-value-minimum: -100;
            accessible-value-maximum: 100;
            accessible-value-step: 1;
            accessible-value: root.track-pans[track_index];
        }

        // 轨道色标 —— 与 arrangement 的 `track-{i}-color-swatch` 同源（同一个投影字段），
        // 但**语义 ID 必须不同**：两个视图可能同时可见，重复 ID 会让运行时控件树构建失败。
        Rectangle {
            x: 44px;
            y: 20px;
            width: 10px;
            height: 14px;
            background: root.track-colors[track_index];
            border-radius: Tokens.radius-sm;
            accessible-role: image;
            accessible-id: "track-" + track_index + "-mixer-color-swatch";
            accessible-label: "轨道色标 " + root.track-color-labels[track_index];
        }

        // 静音 —— `accessible-checked` 来自工程的 `TrackV3::mute`
        Rectangle {
            x: Tokens.space-3;
            y: 38px;
            width: 20px;
            height: 16px;
            background: root.track-mutes[track_index] ? Tokens.record-red : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-mixer-mute-button";
            accessible-label: "轨道 " + track_name + " 静音";
            accessible-checkable: true;
            accessible-checked: root.track-mutes[track_index];

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "M";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            // 点击 ⇒ `Op::SetTrackMute`（一次点击 = 一次可撤销的编辑）。
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-mute-toggle(track_index);
                }
            }
        }

        // 独奏 —— `accessible-checked` 来自工程的 `TrackV3::solo`
        Rectangle {
            x: 30px;
            y: 38px;
            width: 20px;
            height: 16px;
            background: root.track-solos[track_index] ? Tokens.gold-deep : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-mixer-solo-button";
            accessible-label: "轨道 " + track_name + " 独奏";
            accessible-checkable: true;
            accessible-checked: root.track-solos[track_index];

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "S";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            // 点击 ⇒ `Op::SetTrackSolo`。与静音按钮**成对相邻**（静音 x=4、独奏 x=30）。
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-solo-toggle(track_index);
                }
            }
        }

        // VU 电平表 (高频刷新 → 遮罩) [UI-MCP-002] [ARCH-UI-002]
        // 柱高来自引擎发布的电平（`track-meter-levels`），文本来自同一帧的 dBFS。
        Rectangle {
            x: Tokens.space-3;
            y: 60px;
            width: 12px;
            height: 104px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: progress-indicator;
            accessible-id: "track-" + track_index + "-meter";
            accessible-label: "轨道 " + track_name + " 电平表 峰值 " + root.track-meter-peaks[track_index] + " RMS " + root.track-meter-rmss[track_index] + " dBFS";
            accessible-value-minimum: -120;
            accessible-value-maximum: 0;
            accessible-value-step: 0.1;
            accessible-value: root.track-meter-peaks[track_index] + " dBFS";

            Rectangle {
                x: 1px;
                y: parent.height - 2px - 100px * root.track-meter-levels[track_index];
                width: parent.width - 2px;
                height: 100px * root.track-meter-levels[track_index];
                background: Tokens.ok-green;
                border-radius: Tokens.radius-sm;
            }
        }

        // 推子导轨
        Rectangle {
            x: 38px;
            y: 60px;
            width: 6px;
            height: 104px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
        }

        // 推子帽 —— [UI-TEST-001] `track-{track_index}-fader`
        // 位置来自工程的 `volume_db`（`track-volume-fractions`），**不是**电平。
        Rectangle {
            x: 30px;
            y: 60px + 88px * (1.0 - root.track-volume-fractions[track_index]);
            width: 22px;
            height: 16px;
            background: Tokens.bg-raised;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.gold-deep;
            accessible-role: slider;
            accessible-id: "track-" + track_index + "-fader";
            accessible-label: "轨道 " + track_name + " 推子";
            accessible-orientation: vertical;
            accessible-value-minimum: -60;
            accessible-value-maximum: 6;
            accessible-value-step: 0.1;
            accessible-value: root.track-volumes[track_index] + " dB";
        }

        UiMonoText {
            x: Tokens.space-3;
            y: 176px;
            width: parent.width - 8px;
            height: 14px;
            text: root.track-volumes[track_index] + " dB";
            color: Tokens.gold;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
        }

        // ---------------------------------------------------------------- 输入面
        //
        // 两个 `TouchArea` 的位置都**不随数值动**（推子帽的 `y`、声相文本都会动）：
        // 手势读的是 `self.mouse-y` / `self.mouse-x`，若控件自己也动，坐标就自己喂自己。
        // 因此它们是**静态矩形**，只做命中与坐标上报，**不画任何像素**（默认外观不变）。
        //
        // 声明顺序 = 命中顺序（Slint 自后往前做命中测试）：两个都排在它们所覆盖的
        // 视觉元素**之后**，所以按在推子帽 / 声相文本上也能抓到。
        //
        // 范围：推子面 x 22–70 / y 54–170 盖住导轨（x 38–44）与推子帽（x 30–52，
        // y ∈ [60, 164]）；声相面 x 4–40 / y 18–36 盖住 `PAN …` 文本（x 4–32）。
        // 两者都**不**碰静音 / 独奏（y 38–54）、电平表（x 4–16）与别的通道条。
        TouchArea {
            x: 22px;
            y: 54px;
            width: 48px;
            height: 116px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-fader-grab(track_index, self.mouse-y);
                } else if event.kind == PointerEventKind.move {
                    root.mixer-fader-drag(track_index, self.mouse-y);
                } else {
                    // `up` 与 `cancel` 都是收尾：指针拖到窗口外松手也走这条
                    // （与 `track-height-release` 同款）。
                    root.mixer-fader-release(track_index);
                }
            }
        }

        TouchArea {
            x: Tokens.space-3;
            y: 18px;
            width: 36px;
            height: 18px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-pan-grab(track_index, self.mouse-x);
                } else if event.kind == PointerEventKind.move {
                    root.mixer-pan-drag(track_index, self.mouse-x);
                } else {
                    root.mixer-pan-release(track_index);
                }
            }
        }
    }

    // ---------------------------------------------------------------- 主控通道条
    Rectangle {
        x: root.width - 112px;
        y: Tokens.space-4;
        width: 104px;
        height: parent.height - 16px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.gold-deep;
        clip: true;
        accessible-role: groupbox;
        accessible-id: "mixer-master-strip";
        accessible-label: "主控通道条";

        UiMediumText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: 18px;
            text: root.master-name;
            color: Tokens.gold;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }

        UiMonoText {
            x: Tokens.space-3;
            y: 20px;
            width: 30px;
            height: 14px;
            text: "PAN " + root.master-pan;
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            overflow: elide;
            // 主控声相**拖动面**的语义落点（与 `track-{i}-pan` 同一个角色）：
            // `accessible-value` 让主控声相第一次能从控件树读回来（`ui/property` 的
            // `value`），否则"主控声相拖得动但读不回"只能靠窗口属性证明。
            accessible-role: slider;
            accessible-id: "mixer-master-pan";
            accessible-label: "主控声相";
            accessible-orientation: horizontal;
            accessible-value-minimum: -100;
            accessible-value-maximum: 100;
            accessible-value-step: 1;
            accessible-value: root.master-pan;
        }

        Rectangle {
            x: 48px;
            y: 20px;
            width: 10px;
            height: 14px;
            background: root.master-color;
            border-radius: Tokens.radius-sm;
            accessible-role: image;
            accessible-id: "mixer-master-color-swatch";
            accessible-label: "主控色标 " + root.master-color-label;
        }

        Rectangle {
            x: Tokens.space-3;
            y: 38px;
            width: 20px;
            height: 16px;
            background: root.master-mute ? Tokens.record-red : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "mixer-master-mute-button";
            accessible-label: "主控静音";
            accessible-checkable: true;
            accessible-checked: root.master-mute;

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "M";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            x: 30px;
            y: 38px;
            width: 20px;
            height: 16px;
            background: root.master-solo ? Tokens.gold-deep : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "mixer-master-solo-button";
            accessible-label: "主控独奏";
            accessible-checkable: true;
            accessible-checked: root.master-solo;

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "S";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }
        }

        Rectangle {
            x: Tokens.space-3;
            y: 60px;
            width: 14px;
            height: 104px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: progress-indicator;
            accessible-id: "mixer-master-meter";
            accessible-label: "主控电平表 峰值 " + root.master-meter-peak + " RMS " + root.master-meter-rms + " dBFS";
            accessible-value-minimum: -120;
            accessible-value-maximum: 0;
            accessible-value-step: 0.1;
            accessible-value: root.master-meter-peak + " dBFS";

            Rectangle {
                x: 1px;
                y: parent.height - 2px - 100px * root.master-meter-level;
                width: parent.width - 2px;
                height: 100px * root.master-meter-level;
                background: Tokens.warn-amber;
                border-radius: Tokens.radius-sm;
            }
        }

        Rectangle {
            x: 40px;
            y: 60px;
            width: 6px;
            height: 104px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
        }

        Rectangle {
            x: 32px;
            y: 60px + 88px * (1.0 - root.master-volume-fraction);
            width: 22px;
            height: 16px;
            background: Tokens.bg-raised;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.gold;
            accessible-role: slider;
            accessible-id: "mixer-master-fader";
            accessible-label: "主控推子";
            accessible-orientation: vertical;
            accessible-value-minimum: -60;
            accessible-value-maximum: 6;
            accessible-value-step: 0.1;
            accessible-value: root.master-volume-display + " dB";
        }

        UiMonoText {
            x: Tokens.space-3;
            y: 176px;
            width: parent.width - 8px;
            height: 14px;
            text: root.master-volume-display + " dB";
            color: Tokens.gold-bright;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
        }

        // ---------------------------------------------------------------- 主控输入面
        //
        // 与通道条的两个 `TouchArea` **逐条同形**（同样的手法、同样的理由）：
        // 它们是**静态矩形**，只做命中与坐标上报、**不画任何像素**（默认外观因此逐字节
        // 不变）；声明顺序排在它们覆盖的视觉元素**之后**，所以按在推子帽 / 声相文本上
        // 也能抓到（Slint 自后往前做命中测试）。
        //
        // 范围：推子面 x 24–72 / y 54–170 盖住导轨（x 40–46）与推子帽（x 32–54，
        // y ∈ [60, 164]）；声相面 x 4–40 / y 18–36 盖住 `PAN …` 文本（x 4–34）。
        // 两者都**不**碰静音 / 独奏（y 38–54）、电平表（x 4–18）与色标（x 48–58）。
        TouchArea {
            x: 24px;
            y: 54px;
            width: 48px;
            height: 116px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-master-fader-grab(self.mouse-y);
                } else if event.kind == PointerEventKind.move {
                    root.mixer-master-fader-drag(self.mouse-y);
                } else {
                    // `up` 与 `cancel` 都是收尾（与通道条同款）。
                    root.mixer-master-fader-release();
                }
            }
        }

        TouchArea {
            x: Tokens.space-3;
            y: 18px;
            width: 36px;
            height: 18px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-master-pan-grab(self.mouse-x);
                } else if event.kind == PointerEventKind.move {
                    root.mixer-master-pan-drag(self.mouse-x);
                } else {
                    root.mixer-master-pan-release();
                }
            }
        }
    }
}
