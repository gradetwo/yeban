// 夜半 (Yeban) — 多轨调音台与 VU 电平表 (底部控制台 Tab 2)
//
// 规范来源 (Normative):
//   - 规范 §5.2: 调音台通道条 (Pro Channel Strip & Metering)
//   - [UI-TEST-001] §12.2: `track-{track_index}-fader` 是**推子**的语义 ID 约定
//   - [UI-MCP-002] §12.5: VU 电平表是每帧跳变的高频刷新区域, 无头截图比对前必须被遮罩
//     (注册表里 `track-{i}-meter` / `mixer-master-meter` 的 `dynamic_region = true`)
//   - [ARCH-UI-002]: **"UI 线程绝不直接读取音频实时上下文。实时线程以 60Hz 速度向无锁
//     Meter SPSC 压入真峰值与 RMS 电平，UI 线程定时器批量出队更新 Slint Properties。"**
//   - [MODEL-AST-002]: 通道条的轨道名 / 音量 / 声相 / 静音 / 独奏 / 色标来自
//     `YebanProjectV1` 的投影（`src/bridge.rs`），**不是** .slint 里的字面量
//
// ## 这一版改了什么（本工作线的核心）
//
// 上一版这里是 `for track_index in 6` + 内联的 `levels` / `db-labels` 演示数组：
// 通道条数被**刻死**在 6，音量与"电平"是同一个数，推子位置与电平柱高无法区分。
// 现在：
//
//   1. **规模由工程决定**：`for track_name[track_index] in root.track-names` —— 演示工程 6 条、
//      `filled_project()` 3 条，界面不需要改一行；
//   2. **推子 ≠ 电平**：推子位置来自工程的 `TrackV3::volume_db`
//      (`track-volume-fractions`)，电平柱高来自引擎发布的 `MeterFrame`
//      (`track-meter-levels`)。两件事在界面上与控件树里都是分开的两个属性；
//   3. **电平的 dBFS 进控件树**：`track-{i}-meter` 的 `accessible-label` 携带
//      `"峰值 <x> RMS <y> dBFS"`，`accessible-value` 携带峰值文本 ——
//      否则"UI 真的消费了电平"无法机械验证（`[UI-TEST-001]` 只允许语义 ID 寻址，
//      而 `ui/property` 的清单里没有 `accessible-value`）。
//      **注（`b37f6ad` 起）**：上述括注**已过期** —— `ui/property` 的清单现在有
//      `value`（= `accessible-value` 原文）与 `checked`，dBFS 也能经 `ui/property` 读。
//      本段是《这一版改了什么》的历史记录，按原样保留，只在末尾加这条注。
//
// 数据流方向: 只读。界面只做"取数组下标 + 画像素"，dBFS 换算 / 声相文本 / 推子归一化
// 全在投影层与 `src/meters.rs`（零 Slint 依赖，本机可 `rustc --test` 真跑）。

import { Tokens, UiText, UiMonoText, UiMediumText } from "../tokens.slint";
import { AssetPoolPanel } from "asset_pool_panel.slint";

export component MixerConsole inherits Rectangle {
    // ---- 由 src/host.rs 注入的**投影**数据 (默认空 = 没有内联演示数据) ----
    in property <[string]> track-names: [];
    in property <[string]> track-volumes: [];
    in property <[float]> track-volume-fractions: [];
    in property <[string]> track-pans: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];
    // ⭐ **SFZ 采样器路径**（任务单 `#82`）：`TrackV3::sampler` 的路径原文，`None` ⇒ `""`。
    // 这是"用户怎么设它"那一环的**只读注入面**；写方向是下面两条 `mixer-sampler-*` 回调
    // （落到 `Op::SetTrackSampler`，与 `mixer-mute-toggle` 同一条提交路径）。
    in property <[string]> track-sampler-paths: [];
    in property <[color]> track-colors: [];
    in property <[string]> track-color-labels: [];

    // ---- ⭐ 素材池（任务单 `#133`）---------------------------------------------
    // 三个平行数组由 `src/host.rs` 的 `apply_view` 单向注入，唯一事实源是
    // `ViewState::asset_pool`（`clip_pool` 的投影）。长度 = `clip_pool` 条目数。
    // 本组件只把它们**透传**给 `AssetPoolPanel`，不做任何筛选或补算。
    in property <[string]> asset-pool-names: [];
    in property <[string]> asset-pool-kinds: [];
    in property <[string]> asset-pool-details: [];

    // ---- 混音**写入面**的三条手势 + 两个开关（`ADR-0005`：工程内容必须走 `Op` + `UndoPort`）----
    //
    // 形状照抄 `ui/workspace/arrangement_view.slint` 的 `track-height-grab/drag/release`：
    // `.slint` **只报**"哪一个下标 + 本地坐标"，位移换算、视图态写入与 `Op` 提交全在宿主
    // （`host::wire_mixer_edit`）。于是：
    //   - **一次拖动 = 一次 `commit_ops`**：`drag` 只改视图态（数值文本与推子位置立即更新），
    //     只有 `release` 才提交。逐像素提交会把一步撤销碎成几百步；
    //   - **数值始终可见**：拖动期的预览写在 `track-volumes` / `track-volume-fractions` /
    //     `track-pans` 上，读的就是下面那两个 `UiMonoText` 与推子帽的 `y`。
    //
    // `length` 就是 Slint 的 `f32`（与 `track-height-*` 同款：宿主只做减法）。
    callback mixer-fader-grab(int, length);
    callback mixer-fader-drag(int, length);
    callback mixer-fader-release(int);
    callback mixer-pan-grab(int, length);
    callback mixer-pan-drag(int, length);
    callback mixer-pan-release(int);
    callback mixer-mute-toggle(int);
    callback mixer-solo-toggle(int);
    // ⭐ 主控通道条的静音 / 独奏（与上面两个同一条纪律，只是目标**不是下标**）。
    //
    // 主总线不在 `track-ids` 模型里（它是 `master_bus_track_id` 那一条），所以这里
    // **不报下标**：宿主按投影里的主总线身份（`bridge::master_device_track`）提交
    // `Op::SetTrackMute` / `Op::SetTrackSolo` —— 与轨道开关**同一对** `Op`、同一条撤销栈。
    callback mixer-master-mute-toggle();
    callback mixer-master-solo-toggle();
    // ⭐ SFZ 采样器绑定的**写入面**（任务单 `#82`）：
    //   `mixer-sampler-set(index, path)` —— 把这条轨的 `TrackV3::sampler` 设成 `Some(path)`；
    //   `mixer-sampler-clear(index)`     —— 设回 `None`（**解绑**；`None` 是一等状态）。
    // `.slint` 只报"哪一个下标 + 输入框里的文本"，`Op` 构造 / 陈旧载荷比对 / `commit_ops`
    // 全在宿主（`host::wire_mixer_sampler`）—— 与静音 / 独奏逐条同形。
    callback mixer-sampler-set(int, string);
    callback mixer-sampler-clear(int);
    // ⭐ **③ 选 SFZ 路径 —— 原生对话框那一条入口**（任务单 `#86` 乙）。
    //
    // 它与上面两条**不是**同一种动作：SET / CLR 提交**工程内容**（走 `Op::SetTrackSampler`
    // ＋ `UndoPort`），而本回调只请求"**帮我把一段路径填进输入框**"—— 它⛔ 不提交任何
    // 东西，落点是宿主 `host::wire_mixer_sampler_browse`（问一次原生对话框，把选中的
    // 路径写进 `track-sampler-paths[index]`）。用户随后照旧按 SET 提交。
    //
    // 为什么**不**一步到位（选完直接提交）：那会让"浏览"变成一个**隐式提交**——
    // 用户点了"浏览"却发现工程已经被改了。保持"浏览只填框、SET 才提交"这条既有语义，
    // 文本框与 CLI 两条路也**一位没变**（本单的硬要求）。
    callback mixer-sampler-browse(int);

    // ⭐ **导出 MIDI**（任务单 `#90` 甲）—— 把当前工程写成 `SMF 1`（`.mid`）。
    //
    // 为什么这条入口长在**混音台（控制台 Tab 1）**里，而不是右栏那排「模块入口」里：
    // 右栏（`ai-rail`）在**默认帧**（Arrangement / Tab 0 卷帘）里是**可见的静态像素**
    // —— 在那里多一个按钮会让 5 张 Linux 基准**确定性过期**，而本机是 macOS、
    // `tests/golden/<platform>` 只有 `linux` ⇒ 本机**无法**按 `[UI-MCP-003]` 重录。
    // `MixerConsole` 只在 `active-tab == 1` 时可见（`console_tabs.slint` 的
    // `visible: root.active-tab == 1`），默认帧里它**一个像素都不画** ⇒ 默认帧逐位不变。
    // 这与任务单 `#86` 乙的「浏览…」按钮（同样落在 Tab 1）是同一条纪律。
    //
    // ⛔ 本回调**不**写盘、**不**猜路径、**不**判断成功与否：落点是宿主
    // `host::wire_module_actions` 的 `export-midi` 分支（复用**已经存在**的
    // `crate::export_midi::export_project_to_file`，与 CLI 的 `--export-midi` 是**同一个**
    // 函数），回执走**既有**的 `module-status` 投影通道（与 `export-wav` 逐字同款）。
    callback export-midi();

    // ⭐ **打开工程**（任务单 `#93`）—— **运行期换工程**在界面上的**可见入口**。
    //
    // 本单补的是哪一格：`#86` 乙 已经把原生对话框接到**已有的**运行期打开入口上
    // （`LiveUi::open_project` / `open_project_via_picker`，落点 `ui/open_project`），
    // 但产品 `run_gui` 里**没有任何可点的入口** —— `--open` 只在启动时读一次。
    // 本回调就是那个入口的**事件源**。
    //
    // 为什么它长在**混音台（控制台 Tab 1）**里：与上面那条「导出 MIDI」**逐字同一条纪律**
    // （`#90` 甲的先例）。`MixerConsole` 只在 `active-tab == 1` 时可见
    // （`console_tabs.slint` 的 `visible: root.active-tab == 1`）⇒ 默认帧（Tab 0 卷帘）里
    // 它**一个像素都不画** ⇒ `[UI-MCP-003]` 的 5 张 Linux 基准逐位不变
    // （而本机是 macOS、`tests/golden/<platform>` 只有 `linux` ⇒ 本机**无法**重录）。
    //
    // ⛔ 本回调**不**读盘、**不**弹窗、**不**判断成功与否、**不**猜路径：落点是宿主
    // `host::wire_open_project`（问一次**可注入**的 `FilePicker` → 走**已经存在**的
    // `crate::open::open_project_file` 读盘 → 把端口里的会话整体换成新的一份
    // （`UndoPort::open_project_session`，「打开一个工程 = **新会话**」）→ 重投影）。
    // 回执走**既有**的 `module-status` 投影通道（与 `export-midi` / `export-wav` 逐字同一条）。
    callback open-project();

    // ⭐ **新建工程**（任务单 `#129`）—— **从零开始**在界面上的可见入口。
    //
    // 本单补的是哪一格：上面那个 `#93` 的「打开工程」要磁盘上**已经**有一个 `.yeban`；
    // 用户从零开始时唯一的出路是 CLI `--project-sample empty --save-as <path>`（`#128`
    // 实测 1136 B／0 音轨 ＋ 1 主总线）。本回调就是 GUI 里"新建"那个按钮的**事件源**。
    //
    // 座位：与「打开工程」**同一个面板**、它**正下方**（`y: 56px`，同一宽度/高度）——
    // ⛔ 「打开工程」的 `x` / `y` / 宽 / 高**一位不动**（`#93` 的判据与几何不受影响），
    // 面板只向下多出第二格（本面板住在 Tab 1，默认帧里一个像素都不画 ⇒ 5 张 Linux 基准
    // 逐位不变）。
    //
    // ⛔ 本回调**不**写盘、**不**弹窗、**不**判断成功与否、**不**猜路径：唯一落点是宿主
    // `host::wire_new_project`（问一次**可注入**的 `FilePicker::choose_save` ⇒
    // `host::create_new_project_file` 落一个 1136 B／0 音轨 ＋ 1 主总线容器 ⇒ 走**打开工程那条**
    // 换工程路径 `OpenProjectRuntime::open_runtime`）。回执同样走 `module-status`。
    callback new-project();

    // ---- 主控通道条的**写入面**（本切片新增）----
    //
    // ⭐ 为什么主控是**另一组回调**、而不是把主控编成一个下标送进上面那八个：
    // 主总线**不在** `track-names` / `track-ids`（投影刻意排除它，它单独走
    // `ViewState::master`）⇒ 上面那八个回调的 `int` 参数里**没有任何**一个合法值
    // 能指到主控。要么发明一个哨兵下标（`u32::MAX` / `-1`），要么给主控自己的通道。
    // 本仓库选后者：`.slint` 只报"哪一类面板 + 本地坐标"，**不做身份→下标的算术**
    // （与 `host::apply_row_geometry` 把行几何的唯一来源放在宿主是同一条纪律）。
    // 主控的身份由宿主在按下那一刻从权威工程取（`master_bus_track_id`）。
    //
    // 形状与上面三条手势逐条相同 ⇒ 一次拖动 = 一次 `commit_ops`，`Escape` 走**同一个**
    // `mixer-cancel-gesture`（两类目标共用一条取消路径）。
    callback mixer-master-fader-grab(length);
    callback mixer-master-fader-drag(length);
    callback mixer-master-fader-release();
    callback mixer-master-pan-grab(length);
    callback mixer-master-pan-drag(length);
    callback mixer-master-pan-release();

    // ---- 由 src/host.rs 注入的**电平**数据 (60Hz 抽帧的结果) ----
    // `track-meter-peaks` / `track-meter-rmss` 是 `{:.1}` dBFS 文本（**已按 -120 下限钳位**，
    // 且 NaN/±∞ 已在 `src/meters.rs` 落成下限）。`track-meter-levels` 是 0.0–1.0 的柱高。
    // 三者的长度恒等于 `root.track-names.length` —— 换工程时 `host::apply_view` 会先重置成
    // "等长的静音"，因此这里按下标取永远不会越界。
    in property <[string]> track-meter-peaks: [];
    in property <[string]> track-meter-rmss: [];
    in property <[float]> track-meter-levels: [];

    // ---- 主控通道条 (同样由投影 + 电平驱动) ----
    in property <string> master-name: "Master";
    in property <string> master-volume-display: "";
    in property <float> master-volume-fraction: 0.0;
    in property <string> master-pan: "C";
    in property <bool> master-mute: false;
    in property <bool> master-solo: false;
    in property <color> master-color: #2c3a63;
    in property <string> master-color-label: "";
    in property <string> master-meter-peak: "-120.0";
    in property <string> master-meter-rms: "-120.0";
    in property <float> master-meter-level: 0.0;

    // ⭐ 任务单 `#186`：**窄档判定**（本文件唯一一处几何断点）。
    //
    // 判据（全部是 `root.width` 的像素算术，`Tokens.space-3 = 6px / space-4 = 8px`）：
    //   宽档（当前生产布局）三块面板**并排**：通道条 `0..(8 + 104n)`，导出面板从
    //   `8 + 104n` 起宽 216 ⇒ `..(8 + 104n + 216)`，工程面板再让一个 `space-3` 从
    //   `8 + 104n + 222` 起宽 216 ⇒ 右沿 `8 + 104n + 438`。主控通道条钉在
    //   `root.width - 112`。两者不相交的条件是 `root.width - 112 ≥ 8 + 104n + 438`
    //   ⇒ 演示工程 `n = 6` 时 `root.width ≥ 1182`。
    //   窄档（`< 1182px`）改为**竖排**：三块面板都从 `8 + 104n` 起（与导出面板同列），
    //   工程面板 `y = 8 + 76 + 6`、素材池 `y = 90 + 104 + 6 = 200`，右沿全部
    //   `8 + 104n + 216` ⇒ 演示工程在 1024 档右沿 848 < 主控左沿 912，**不相交**。
    //
    // ⛔ 这里不隐藏任何控件：窄档只是换座位（`#186` 的判据要求所有控件仍在树里）。
    property <bool> narrow: root.width < 1182px;

    background: Tokens.bg-void;
    clip: true;

    accessible-role: region;
    accessible-id: "mixer-console";
    accessible-label: "多轨调音台总控";

    // ⭐ **工程导出 · 导出 MIDI**（任务单 `#90` 甲）—— 只在控制台 Tab 1（混音台）里可见。
    //
    // 位置：跟在**最后一条通道条之后**（`104px * root.track-names.length`，与 `for` 循环的
    // `104px * track_index` 共用同一组几何常量）⇒ 从不与通道条重叠，也不需要把任何既有
    // 控件挪一位。它声明在通道条循环**之前** ⇒ 极端轨道数下通道条盖住它（数据优先）。
    //
    // ⛔ 本块**不**写盘、**不**判断成功与否：它只发 `export-midi` 回调，回执由宿主
    // （`host::wire_module_actions` 的 `export-midi` 分支）写进**既有**的
    // `MainWindow.module-status` —— 与 `module-export-wav-button` 逐字同一条通道。
    Rectangle {
        x: Tokens.space-4 + 104px * root.track-names.length;
        y: Tokens.space-4;
        width: 216px;
        height: 76px;
        background: Tokens.bg-panel;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;

        UiMediumText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: 18px;
            text: "工程导出";
            color: Tokens.ink-0;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }

        // 唯一点击源与 `accessible-action-default` 是**同一段**落点（`[UI-A11Y-003]` §7.3）。
        Rectangle {
            x: Tokens.space-3;
            y: 24px;
            width: parent.width - 12px;
            height: 28px;
            background: midi_export_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
            border-radius: Tokens.radius-md;
            accessible-role: button;
            accessible-id: "module-export-midi-button";
            accessible-label: "导出 MIDI（把当前工程写成 SMF 1 文件）";
            accessible-action-default => { root.export-midi(); }

            UiText {
                x: Tokens.space-3;
                y: 0;
                width: parent.width - 12px;
                height: parent.height;
                text: "导出 MIDI";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xs;
            }

            midi_export_area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.export-midi(); }
            }
        }
    }

    // ⭐ **工程打开**（任务单 `#93`）—— 运行期「打开工程」的可见入口，**只在 Tab 1 里可见**。
    //
    // 位置：紧挨着上面 `#90` 的「工程导出」面板**右侧**（同一个 `y`，即 `Tokens.space-4`；
    // `x` 在它之后 + 它自己的宽度 `216px` + 一个 `space-3` 间隙）。⭐ 选这个座位是因为它
    // **不改任何既有控件的几何**：`#90` 那条面板的 `x` / `y` / 高宽与它的按钮位置
    // （`y: 24px` / `height: 28px`）**一位不动**，而通道条永远在 `104px * track_index`
    // 那一列里（都在这两个面板的左边）⇒ 三者互不重叠。
    // （`216px` 是与左侧那块面板**并排对齐**的座位常量；它⛔ 不参与任何算术，
    //  只是"下一格从上一格右边缘再让一个间隙开始"。）
    //
    // ⛔ 本块**不**写盘、**不**判断成功与否：它只发 `open-project` 回调；问对话框、读盘、
    // 换会话与重投影全在宿主 `host::wire_open_project`（唯一实现），回执走**既有**的
    // `MainWindow.module-status` —— 与 `module-export-midi-button` 逐字同一条通道。
    //
    // ⭐ 任务单 `#129` 在同一面板里向下加了一格「新建工程」（`y: 56px`）：
    // 「打开工程」按钮的 `x` / `y` / 宽 / 高**一位不动**，本面板只从 76px 变成 104px
    // （下面没有任何控件，`for` 通道条都在本面板**左侧**的 `104px * track_index` 列里）。
    // ⭐ 任务单 `#186`：宽档座位一位未动；窄档（`root.narrow`）时这块面板移到
    // 「导出 MIDI」面板**正下方**、与它同列（`x = 8 + 104n`，`y = 8 + 76 + space-3`），
    // 让整列右沿停在主控通道条左侧（见文件上方 `narrow` 的算术）。
    Rectangle {
        x: root.narrow
            ? Tokens.space-4 + 104px * root.track-names.length
            : Tokens.space-4 + 104px * root.track-names.length + 216px + Tokens.space-3;
        y: root.narrow ? Tokens.space-4 + 76px + Tokens.space-3 : Tokens.space-4;
        width: 216px;
        height: 104px;
        background: Tokens.bg-panel;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;

        UiMediumText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: 18px;
            text: "工程";
            color: Tokens.ink-0;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }

        // 唯一点击源与 `accessible-action-default` 是**同一段**落点（`[UI-A11Y-003]` §7.3）。
        Rectangle {
            x: Tokens.space-3;
            y: 24px;
            width: parent.width - 12px;
            height: 28px;
            background: open_project_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
            border-radius: Tokens.radius-md;
            accessible-role: button;
            accessible-id: "module-open-project-button";
            accessible-label: "打开工程（用文件对话框挑一个 .yeban 容器并就地换掉当前工程）";
            accessible-action-default => { root.open-project(); }

            UiText {
                x: Tokens.space-3;
                y: 0;
                width: parent.width - 12px;
                height: parent.height;
                text: "打开工程";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xs;
            }

            open_project_area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.open-project(); }
            }
        }

        // ⭐ **新建工程**（任务单 `#129`）—— 与上面那格**逐条同形**（同宽 / 同高 /
        // 同样的 role / 同一个 `module-status` 回执通道），只是座位在它正下方
        // （`y: 56px` = 24px 上格 + 28px 高 + 4px 间隙）。
        // ⛔ 本块同样**不**写盘、**不**判断成功与否：唯一落点是宿主 `host::wire_new_project`。
        Rectangle {
            x: Tokens.space-3;
            y: 56px;
            width: parent.width - 12px;
            height: 28px;
            background: new_project_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
            border-radius: Tokens.radius-md;
            accessible-role: button;
            accessible-id: "module-new-project-button";
            accessible-label: "新建工程（用文件对话框给新工程选一个落点，写出 0 音轨 ＋ 1 主总线的空白容器并就地换过去）";
            accessible-action-default => { root.new-project(); }

            UiText {
                x: Tokens.space-3;
                y: 0;
                width: parent.width - 12px;
                height: parent.height;
                text: "新建工程";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xs;
            }

            new_project_area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.new-project(); }
            }
        }
    }

    // ⭐ **素材池**（任务单 `#133`）—— `clip_pool` 在界面上的**可见**投影。
    //
    // 为什么长在混音台（控制台 Tab 1）里：与 `#90` 的「导出 MIDI」/ `#93` 的「打开工程」/
    // `#129` 的「新建工程」**逐字同一条纪律** —— `MixerConsole` 只在 `active-tab == 1`
    // 时可见，默认帧（Tab 0 卷帘 = 5 张 Linux 基准覆盖的那一帧）里**一个像素都不画**
    // ⇒ 基准逐位不变（本机是 macOS、`tests/golden/<platform>` 只有 `linux`，无法重录）。
    //
    // 座位：紧贴「工程」面板**正下方**（同一个 `x` / 同一个宽度），`y = 120px`
    // （= 上面那块 104px 面板 + `space-4` 起点 + `space-3` 间隙）。通道条永远在
    // 本面板左侧的 `104px * track_index` 列里 ⇒ 互不重叠，且既有控件的几何一位不动。
    //
    // ⛔ 本组件不读盘、不造数据：三个数组**全部**来自投影（见 `src/bridge.rs` 的
    // `AssetPoolRowView`），空池显示「尚无素材」。
    // ⭐ 任务单 `#186`：宽档仍是「工程」面板正下方（`y = 8 + 104 + space-3 = 118px`）；
    // 窄档（`root.narrow`）时它排在**竖排后的「工程」面板**正下方（`y = 200px`），
    // 高度随之收成 `root.height - 200`（下沿贴到调音台底，仍被 `clip: true` 裁住），
    // 使整列的右沿/下沿都不越出主控通道条与调音台裁剪区，且两行素材（`y = 44/76`、高 30）
    // 都在面板内。
    AssetPoolPanel {
        x: root.narrow
            ? Tokens.space-4 + 104px * root.track-names.length
            : Tokens.space-4 + 104px * root.track-names.length + 216px + Tokens.space-3;
        y: root.narrow
            ? Tokens.space-4 + 76px + Tokens.space-3 + 104px + Tokens.space-3
            : Tokens.space-4 + 104px + Tokens.space-3;
        width: 216px;
        height: root.narrow ? root.height - 200px : root.height - 128px;
        asset-pool-names: root.asset-pool-names;
        asset-pool-kinds: root.asset-pool-kinds;
        asset-pool-details: root.asset-pool-details;
    }

    // ---------------------------------------------------------------- 通道条
    // 通道条数 == 工程的非主总线轨道数。`for name[i] in <model>` 必须带声明标识符
    // （Slint 1.18.1 不接受只有索引的 `for [i] in <model>`，见
    // docs/ledger/app-binding-notes.md §6.1）。
    for track_name[track_index] in root.track-names : Rectangle {
        x: Tokens.space-4 + 104px * track_index;
        y: Tokens.space-4;
        width: 96px;
        height: parent.height - 16px;
        background: track_index.mod(2) == 0 ? Tokens.bg-panel : Tokens.bg-shell;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;
        accessible-role: groupbox;
        accessible-id: "track-" + track_index + "-channel-strip";
        accessible-label: "通道条 " + track_name;

        UiMediumText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: 18px;
            text: track_name;
            color: Tokens.ink-0;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }

        // 声相读出 —— **始终可见**的数值（`PAN C` / `PAN L50`，由投影的 `pan_display` 给出，
        // 界面不做任何算术）。本轮起它同时是**声相拖动面**的语义落点：
        // `accessible-value` 让 `pan` 第一次能从控件树读回来（在此之前它只活在标签文本里）。
        UiMonoText {
            x: Tokens.space-3;
            y: 20px;
            width: 28px;
            height: 14px;
            text: "PAN " + root.track-pans[track_index];
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            overflow: elide;
            accessible-role: slider;
            accessible-id: "track-" + track_index + "-pan";
            accessible-label: "轨道 " + track_name + " 声相";
            accessible-orientation: horizontal;
            accessible-value-minimum: -100;
            accessible-value-maximum: 100;
            accessible-value-step: 1;
            accessible-value: root.track-pans[track_index];
        }

        // 轨道色标 —— 与 arrangement 的 `track-{i}-color-swatch` 同源（同一个投影字段），
        // 但**语义 ID 必须不同**：两个视图可能同时可见，重复 ID 会让运行时控件树构建失败。
        Rectangle {
            x: 44px;
            y: 20px;
            width: 10px;
            height: 14px;
            background: root.track-colors[track_index];
            border-radius: Tokens.radius-sm;
            accessible-role: image;
            accessible-id: "track-" + track_index + "-mixer-color-swatch";
            accessible-label: "轨道色标 " + root.track-color-labels[track_index];
        }

        // 静音 —— `accessible-checked` 来自工程的 `TrackV3::mute`
        Rectangle {
            x: Tokens.space-3;
            y: 38px;
            width: 20px;
            height: 16px;
            background: root.track-mutes[track_index] ? Tokens.record-red : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-mixer-mute-button";
            accessible-label: "轨道 " + track_name + " 静音";
            accessible-checkable: true;
            accessible-checked: root.track-mutes[track_index];
            // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
            accessible-action-default => { root.mixer-mute-toggle(track_index); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "M";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            // 点击 ⇒ `Op::SetTrackMute`（一次点击 = 一次可撤销的编辑）。
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-mute-toggle(track_index);
                }
            }
        }

        // 独奏 —— `accessible-checked` 来自工程的 `TrackV3::solo`
        Rectangle {
            x: 30px;
            y: 38px;
            width: 20px;
            height: 16px;
            background: root.track-solos[track_index] ? Tokens.gold-deep : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-mixer-solo-button";
            accessible-label: "轨道 " + track_name + " 独奏";
            accessible-checkable: true;
            accessible-checked: root.track-solos[track_index];
            // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
            accessible-action-default => { root.mixer-solo-toggle(track_index); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "S";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            // 点击 ⇒ `Op::SetTrackSolo`。与静音按钮**成对相邻**（静音 x=4、独奏 x=30）。
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-solo-toggle(track_index);
                }
            }
        }

        // VU 电平表 (高频刷新 → 遮罩) [UI-MCP-002] [ARCH-UI-002]
        // 柱高来自引擎发布的电平（`track-meter-levels`），文本来自同一帧的 dBFS。
        Rectangle {
            x: Tokens.space-3;
            y: 60px;
            width: 12px;
            height: 104px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: progress-indicator;
            accessible-id: "track-" + track_index + "-meter";
            accessible-label: "轨道 " + track_name + " 电平表 峰值 " + root.track-meter-peaks[track_index] + " RMS " + root.track-meter-rmss[track_index] + " dBFS";
            accessible-value-minimum: -120;
            accessible-value-maximum: 0;
            accessible-value-step: 0.1;
            accessible-value: root.track-meter-peaks[track_index] + " dBFS";

            Rectangle {
                x: 1px;
                y: parent.height - 2px - 100px * root.track-meter-levels[track_index];
                width: parent.width - 2px;
                height: 100px * root.track-meter-levels[track_index];
                background: Tokens.ok-green;
                border-radius: Tokens.radius-sm;
            }
        }

        // 推子导轨
        Rectangle {
            x: 38px;
            y: 60px;
            width: 6px;
            height: 104px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
        }

        // 推子帽 —— [UI-TEST-001] `track-{track_index}-fader`
        // 位置来自工程的 `volume_db`（`track-volume-fractions`），**不是**电平。
        Rectangle {
            x: 30px;
            y: 60px + 88px * (1.0 - root.track-volume-fractions[track_index]);
            width: 22px;
            height: 16px;
            background: Tokens.bg-raised;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.gold-deep;
            accessible-role: slider;
            accessible-id: "track-" + track_index + "-fader";
            accessible-label: "轨道 " + track_name + " 推子";
            accessible-orientation: vertical;
            accessible-value-minimum: -60;
            accessible-value-maximum: 6;
            accessible-value-step: 0.1;
            accessible-value: root.track-volumes[track_index] + " dB";
        }

        UiMonoText {
            x: Tokens.space-3;
            y: 176px;
            width: parent.width - 8px;
            height: 14px;
            text: root.track-volumes[track_index] + " dB";
            color: Tokens.gold;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
        }

        // ------------------------------------------------ SFZ 采样器绑定（任务单 `#82`）
        //
        // ⭐ 这是"用户怎么设 SFZ"那一环：一条**文本**路径输入 ＋ SET / CLR。
        //
        // ⚠ 为什么是文本而不是文件选择器：本仓**没有**文件对话框（原生选择器要引新依赖
        // ⇒ 必须先报批，见本单的边界登记）⇒ 最小可用的一条是"用户能敲/粘贴路径"。
        //
        // 语义节点的形状：
        //   * 输入框自己是 `text-input` 角色 —— Slint 对 `TextInput` 自动挂
        //     `accessible-role: text-input` ＋ `accessible-value: text` ＋
        //     `accessible-action-set-value`（上游 `i-slint-compiler-1.18.1` 的
        //     `passes/lower_accessibility.rs:71-115`），因此屏读器与控制面既能**读**当前
        //     绑定，也能**写**一段文本（`ui/property {name:"value"}` /
        //     `ElementHandle::set_accessible_value`）；
        //   * SET 的 `accessible-action-default` 与它的 `TouchArea.clicked` 是**逐字同一段**
        //     ⇒ "屏读器按 SET"与"鼠标点 SET"不可能分叉（`[UI-A11Y-003]` §7.3 的同款纪律）；
        //     回车走 `TextInput.accepted`，落点是**同一个** `mixer-sampler-set` 回调。
        //
        // 写方向 ⛔ 不在这里提交任何东西：`.slint` 只报"哪一个下标 + 输入框文本"，
        // `Op::SetTrackSampler` 的构造 / 陈旧载荷比对 / `commit_ops` 全在宿主
        // （`host::wire_mixer_sampler`）。CLR 落到 `None`（**解绑**是一等状态）。
        UiMonoText {
            x: Tokens.space-3;
            y: 194px;
            width: parent.width - 8px;
            height: 12px;
            text: "SFZ";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }

        sampler-path-field := TextInput {
            x: Tokens.space-3;
            y: 208px;
            // ⚠ `#86` 乙：右边让出 24px 给"浏览"按钮（⛔ 不动 SET / CLR 的几何）。
            width: parent.width - 32px;
            height: 16px;
            text: root.track-sampler-paths[track_index];
            single-line: true;
            font-family: Tokens.font-mono;
            color: Tokens.gold;
            font-size: Tokens.font-size-xs;
            vertical-alignment: center;
            accessible-id: "track-" + track_index + "-sampler-path";
            accessible-label: "轨道 " + track_name + " SFZ 采样器路径";
            // 回车 = SET。⛔ 不是第二份提交实现：与 SET 按钮发**同一条**回调。
            accepted => {
                root.mixer-sampler-set(track_index, self.text);
            }
        }

        // ⭐ **③ 浏览…**（任务单 `#86` 乙）：点它开一次**原生**文件对话框，
        // 选中的路径**填进上面那个输入框**（⛔ 不提交 —— 提交仍是 SET / 回车那一处）。
        //
        // 位置：贴在输入框右边缘（`parent.width - 24px`），因此⛔ 不移动 SET / CLR，
        // 也不改通道条宽度 ⇒ 调音台之外的布局一位未动。
        // ⚠ 调音台（控制台 Tab 1）**不在默认帧里**（默认是 Tab 0 = 卷帘）⇒ 本按钮
        //    ⛔ 不影响 `tests/golden/linux/**`（第 247 条：默认帧逐位不变）。
        Rectangle {
            x: parent.width - 24px;
            y: 208px;
            width: 18px;
            height: 16px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.line-strong;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-sampler-browse";
            accessible-label: "轨道 " + track_name + " 浏览 SFZ 文件";
            // `[UI-A11Y-003]` §7.3：落点与下面的 `TouchArea.clicked` **逐字相同**。
            accessible-action-default => {
                root.mixer-sampler-browse(track_index);
            }

            UiMonoText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "…";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-sampler-browse(track_index);
                }
            }
        }

        Rectangle {
            x: Tokens.space-3;
            y: 228px;
            width: 40px;
            height: 16px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.line-strong;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-sampler-set";
            accessible-label: "轨道 " + track_name + " 提交 SFZ 路径";
            accessible-action-default => {
                root.mixer-sampler-set(track_index, sampler-path-field.text);
            }

            UiMonoText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "SET";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-sampler-set(track_index, sampler-path-field.text);
                }
            }
        }

        Rectangle {
            x: 48px;
            y: 228px;
            width: 40px;
            height: 16px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.line-strong;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-sampler-clear";
            accessible-label: "轨道 " + track_name + " 解绑 SFZ 采样器";
            accessible-action-default => {
                root.mixer-sampler-clear(track_index);
            }

            UiMonoText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "CLR";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-sampler-clear(track_index);
                }
            }
        }

        // ---------------------------------------------------------------- 输入面
        //
        // 两个 `TouchArea` 的位置都**不随数值动**（推子帽的 `y`、声相文本都会动）：
        // 手势读的是 `self.mouse-y` / `self.mouse-x`，若控件自己也动，坐标就自己喂自己。
        // 因此它们是**静态矩形**，只做命中与坐标上报，**不画任何像素**（默认外观不变）。
        //
        // 声明顺序 = 命中顺序（Slint 自后往前做命中测试）：两个都排在它们所覆盖的
        // 视觉元素**之后**，所以按在推子帽 / 声相文本上也能抓到。
        //
        // 范围：推子面 x 22–70 / y 54–170 盖住导轨（x 38–44）与推子帽（x 30–52，
        // y ∈ [60, 164]）；声相面 x 4–40 / y 18–36 盖住 `PAN …` 文本（x 4–32）。
        // 两者都**不**碰静音 / 独奏（y 38–54）、电平表（x 4–16）与别的通道条。
        TouchArea {
            x: 22px;
            y: 54px;
            width: 48px;
            height: 116px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-fader-grab(track_index, self.mouse-y);
                } else if event.kind == PointerEventKind.move {
                    root.mixer-fader-drag(track_index, self.mouse-y);
                } else {
                    // `up` 与 `cancel` 都是收尾：指针拖到窗口外松手也走这条
                    // （与 `track-height-release` 同款）。
                    root.mixer-fader-release(track_index);
                }
            }
        }

        TouchArea {
            x: Tokens.space-3;
            y: 18px;
            width: 36px;
            height: 18px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-pan-grab(track_index, self.mouse-x);
                } else if event.kind == PointerEventKind.move {
                    root.mixer-pan-drag(track_index, self.mouse-x);
                } else {
                    root.mixer-pan-release(track_index);
                }
            }
        }
    }

    // ---------------------------------------------------------------- 主控通道条
    Rectangle {
        x: root.width - 112px;
        y: Tokens.space-4;
        width: 104px;
        height: parent.height - 16px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.gold-deep;
        clip: true;
        accessible-role: groupbox;
        accessible-id: "mixer-master-strip";
        accessible-label: "主控通道条";

        UiMediumText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: 18px;
            text: root.master-name;
            color: Tokens.gold;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }

        UiMonoText {
            x: Tokens.space-3;
            y: 20px;
            width: 30px;
            height: 14px;
            text: "PAN " + root.master-pan;
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            overflow: elide;
            // 主控声相**拖动面**的语义落点（与 `track-{i}-pan` 同一个角色）：
            // `accessible-value` 让主控声相第一次能从控件树读回来（`ui/property` 的
            // `value`），否则"主控声相拖得动但读不回"只能靠窗口属性证明。
            accessible-role: slider;
            accessible-id: "mixer-master-pan";
            accessible-label: "主控声相";
            accessible-orientation: horizontal;
            accessible-value-minimum: -100;
            accessible-value-maximum: 100;
            accessible-value-step: 1;
            accessible-value: root.master-pan;
        }

        Rectangle {
            x: 48px;
            y: 20px;
            width: 10px;
            height: 14px;
            background: root.master-color;
            border-radius: Tokens.radius-sm;
            accessible-role: image;
            accessible-id: "mixer-master-color-swatch";
            accessible-label: "主控色标 " + root.master-color-label;
        }

        Rectangle {
            x: Tokens.space-3;
            y: 38px;
            width: 20px;
            height: 16px;
            background: root.master-mute ? Tokens.record-red : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "mixer-master-mute-button";
            accessible-label: "主控静音";
            accessible-checkable: true;
            accessible-checked: root.master-mute;
            // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
            accessible-action-default => { root.mixer-master-mute-toggle(); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "M";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            // 点击 ⇒ `Op::SetTrackMute`（目标 = 主总线那条轨；一次点击 = 一次可撤销的编辑）。
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-master-mute-toggle();
                }
            }
        }

        Rectangle {
            x: 30px;
            y: 38px;
            width: 20px;
            height: 16px;
            background: root.master-solo ? Tokens.gold-deep : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "mixer-master-solo-button";
            accessible-label: "主控独奏";
            accessible-checkable: true;
            accessible-checked: root.master-solo;
            // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
            accessible-action-default => { root.mixer-master-solo-toggle(); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "S";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            // 点击 ⇒ `Op::SetTrackSolo`。与主控静音按钮**成对相邻**（静音 x=4、独奏 x=30）。
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.mixer-master-solo-toggle();
                }
            }
        }

        Rectangle {
            x: Tokens.space-3;
            y: 60px;
            width: 14px;
            height: 104px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: progress-indicator;
            accessible-id: "mixer-master-meter";
            accessible-label: "主控电平表 峰值 " + root.master-meter-peak + " RMS " + root.master-meter-rms + " dBFS";
            accessible-value-minimum: -120;
            accessible-value-maximum: 0;
            accessible-value-step: 0.1;
            accessible-value: root.master-meter-peak + " dBFS";

            Rectangle {
                x: 1px;
                y: parent.height - 2px - 100px * root.master-meter-level;
                width: parent.width - 2px;
                height: 100px * root.master-meter-level;
                background: Tokens.warn-amber;
                border-radius: Tokens.radius-sm;
            }
        }

        Rectangle {
            x: 40px;
            y: 60px;
            width: 6px;
            height: 104px;
            background: Tokens.bg-void;
            border-radius: Tokens.radius-sm;
        }

        Rectangle {
            x: 32px;
            y: 60px + 88px * (1.0 - root.master-volume-fraction);
            width: 22px;
            height: 16px;
            background: Tokens.bg-raised;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.gold;
            accessible-role: slider;
            accessible-id: "mixer-master-fader";
            accessible-label: "主控推子";
            accessible-orientation: vertical;
            accessible-value-minimum: -60;
            accessible-value-maximum: 6;
            accessible-value-step: 0.1;
            accessible-value: root.master-volume-display + " dB";
        }

        UiMonoText {
            x: Tokens.space-3;
            y: 176px;
            width: parent.width - 8px;
            height: 14px;
            text: root.master-volume-display + " dB";
            color: Tokens.gold-bright;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
        }

        // ---------------------------------------------------------------- 主控输入面
        //
        // 与通道条的两个 `TouchArea` **逐条同形**（同样的手法、同样的理由）：
        // 它们是**静态矩形**，只做命中与坐标上报、**不画任何像素**（默认外观因此逐字节
        // 不变）；声明顺序排在它们覆盖的视觉元素**之后**，所以按在推子帽 / 声相文本上
        // 也能抓到（Slint 自后往前做命中测试）。
        //
        // 范围：推子面 x 24–72 / y 54–170 盖住导轨（x 40–46）与推子帽（x 32–54，
        // y ∈ [60, 164]）；声相面 x 4–40 / y 18–36 盖住 `PAN …` 文本（x 4–34）。
        // 两者都**不**碰静音 / 独奏（y 38–54）、电平表（x 4–18）与色标（x 48–58）。
        TouchArea {
            x: 24px;
            y: 54px;
            width: 48px;
            height: 116px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-master-fader-grab(self.mouse-y);
                } else if event.kind == PointerEventKind.move {
                    root.mixer-master-fader-drag(self.mouse-y);
                } else {
                    // `up` 与 `cancel` 都是收尾（与通道条同款）。
                    root.mixer-master-fader-release();
                }
            }
        }

        TouchArea {
            x: Tokens.space-3;
            y: 18px;
            width: 36px;
            height: 18px;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.mixer-master-pan-grab(self.mouse-x);
                } else if event.kind == PointerEventKind.move {
                    root.mixer-master-pan-drag(self.mouse-x);
                } else {
                    root.mixer-master-pan-release();
                }
            }
        }
    }
}
