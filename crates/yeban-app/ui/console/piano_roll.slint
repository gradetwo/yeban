// 夜半 (Yeban) — 虚拟化 MIDI 钢琴卷帘 (底部控制台 Tab 1)
//
// 规范来源 (Normative):
//   - 规范 §3.1: Slint 硬件加速视口裁剪 + 空间索引 —— **裁剪已实现**（投影的六条数组按视口切片并注入本文件；
//     判据 `cargo test -p yeban-app --lib clipping`）；**R-Tree 有意未采用**，改用按 x 排序的二分索引（零新依赖）
//   - 规范 §3.2: 坐标系双向转换与 960 PPQ 吸附对齐 —— **已实现**（`snap_tick`/`snapped_tick_at` 等在 `src/bridge.rs`）
//   - 规范 §3.3: 视听反馈引擎与多工具交互矩阵 (1 选择 / 2 铅笔 / 3 剪刀 / 4 力度 / 5 橡皮擦)
//   - 规范 §3.5: 全键盘音符微调
//   - [UI-TEST-001] §12.2: `note-{ulid}-rect` 语义 ID
//   - [UI-MCP-002] §12.5: 走带光标与力度条属高频刷新区域
//
// 本文件是**静态骨架 + 由投影注入的数据**。**视口裁剪、吸附与工具状态机均已实现**（第 607/608 轮更正此处：
// 旧文写"仍未实现"已与代码不符）；R-Tree 有意未采用（见上）。
// 音符的坐标映射（`[UI-NOTE-002]`）**已落地在投影层**：x / y / 宽来自 `src/bridge.rs`
// 的整数 tick / 音高换算，本文件只消费注入数组（见 `note-positions` 的注释）。

import { Tokens, UiText, UiMonoText } from "../tokens.slint";

export component PianoRoll inherits Rectangle {
    // 由 src/host.rs 单向注入 —— `{ulid}` 段来自**工程里的 `MidiNote::id`**
    // （不再是界面内联的演示常量）。
    //
    // 简化（如实登记，见 docs/ledger/app-binding-notes.md 未实现项）：这里注入的是
    // **片段池里的全部 MIDI 音符**，而不是"当前编辑片段"的音符 —— 后者的作用域属于
    // 会话运行态（`MODEL-ISO-001`），还没有对应的状态容器。
    in property <[string]> note-ulids: [];
    // 音符位置 —— **全部**由 `src/bridge.rs` 从 `MidiNote::start_tick` / `pitch` 整数推导，
    // 这里只做"取数组下标"，不做任何位置算术（`[UI-NOTE-002]` 的投影侧落地）：
    //   `note-positions[i]` = `tick_to_px(start_tick)`（整数除法，逻辑像素）
    //   `note-ys[i]`        = `PITCH_LANE_HEIGHT_PX × pitch_lane(pitch) + NOTE_INSET_Y_PX`
    //   `note-widths[i]`    = 结束 tick 的像素 − 起始 tick 的像素（有 1px 地板）
    // 上一版这里是 `x: Tokens.space-5 + 76px * note_index` / `y: 14px * note_index + 6px`
    // —— 音符的**索引**而不是工程的 tick。那条布局已被判据
    // `bridge::slint_text_contracts_for_colors_and_pitch_lanes` 明文禁止。
    in property <[length]> note-positions: [];
    // `[UI-NOTE-003]` 与注入的六个数组**同一索引集**的第七个: 选中标志（宿主用 `Selection::flags_for` 生成）。
    in property <[bool]> note-selected: [];
    // `[ROAD-M3-002]` 滚动手势：本组件**只报告增量**, 偏移由宿主拥有并重新注入
    // （见账本第 199 轮：Flickable 会与宿主拥有的偏移双重计算, 故不用）。
    callback scroll-requested(length);
    // `[UI-NOTE-003]` 左键单击：只**报告坐标**, 命中与选区由 Rust 侧决定（账本第 495/496 轮）。
    callback clicked(length, length);
    // `[UI-NOTE-003]` §3.3 工具矩阵的**点击**入口：工具行号（1..5，与 `Tool::digit` 同一口径）。
    // 界面只上报"点了哪一行"; `active-tool` 的写入与动作日志由宿主唯一落点
    // (`host::wire_tool_select` → `host::apply_action` 的 `Action::SelectTool` 臂) 完成。
    callback tool-selected(int);
    // `[UI-NOTE-003]` 左键**拖拽**的手势通道（工具矩阵"左键拖拽"列；本切片接的是选择工具的
    // 移动臂 `Tool::drag() == ToolDrag::MoveNote`）。界面只**报告指针位置**（绘制帧）；
    // 工具门、命中、草稿与"抬起恰好一个原子 `Op::MoveNote`"全在宿主
    // （`host::wire_roll_edit` → `install_roll_note_drag`）。
    // 返回 `true` = 宿主**接管**这次手势 ⇒ 本组件不再把它当滚动 / 单击（⛔ 不双重处理）。
    callback note-drag-grab(length, length) -> bool;
    // 接管后的每次指针移动（绘制帧坐标）⇒ 宿主**只**更新草稿，⛔ 不写工程、⛔ 不进撤销栈。
    callback note-drag-move(length, length);
    // 松手（绘制帧坐标）⇒ 宿主**至多提交一个**原子 `Op`。
    callback note-drag-release(length, length);
    // 指针离开窗口 / 控件被禁用（上游导出成 `PointerEventKind.cancel`）⇒ **丢弃**草稿。
    callback note-drag-cancel();
    // 被拖音符的身份（空 = 没有手势）与拖动期的**草稿预览位移**（逻辑像素，由宿主算好注入）。
    // 只有身份相等的那个音符矩形跟着偏移 —— 界面不做位置算术（`[UI-NOTE-002]`）。
    in property <string> note-drag-ulid: "";
    in property <float> note-drag-preview-dx: 0.0;
    in property <float> note-drag-preview-dy: 0.0;
    // `[UI-NOTE-003]` 力度臂的**草稿预览**（0.0–1.0 的归一化力度，宿主算好注入）：
    // 只有身份等于 `note-drag-ulid` 的那一根力度柱按它画高（拖动期 ⛔ 不写工程）。
    // 没有手势时 `note-drag-ulid` 是空串 ⇒ 这一项**不被任何柱读到**（未拖动时逐像素不变）。
    in property <float> note-drag-preview-velocity: 0.0;
    // `[UI-NOTE-003]` 力度车道在**本组件局部坐标系**里的顶沿（逻辑像素）。
    //
    // 宿主必须知道它才能把指针的 y 反解成"车道内 y"（= 绝对力度）。这个读数由**界面**
    // 上报（`velocity-lane.y`），⛔ 宿主不在自己那边手写 `height - 44` —— 那会变成第二份
    // 布局算术（帧原点那一族，见 `tests/tool_matrix_wiring.rs` 的禁用常量表）。
    out property <length> velocity-lane-top: velocity-lane.y;
    in property <[length]> note-ys: [];
    in property <[length]> note-widths: [];
    in property <[string]> tool-names: ["select", "pencil", "knife", "velocity", "eraser"];
    in property <[string]> tool-labels: ["选择", "铅笔", "剪刀", "力度", "橡皮"];
    in property <int> active-tool: 1;
    // `[UI-NOTE-003]` **工具行号口径的唯一转换点**（台账 R372）: `active-tool` 是 `1`..`5`
    // （`Tool::digit()` 与数字键 `1`..`5` 同一口径），而工具矩阵那圈 `for` 的下标是 `0`..`4`。
    // 底色 / `accessible-checked` / 字色三条绑定**只许读这一个属性** —— 直接拿 `active-tool`
    // 去比下标，启动默认（`1`）会勾中「2 铅笔」、按 `5` 还会一格都不勾（判据
    // `tests/live_ui_mcp.rs` 的 `the_tool_matrix_checked_state_tracks_the_active_tool_for_every_digit`）。
    property <int> active-tool-index: root.active-tool - 1;

    in property <bool> show-velocity-lane: true;
    // 十二平均律一个八度里的白键位置 (C C# D D# E F F# G G# A A# B)。
    // 用「查表 + 取模」而不是 5 个 `||` 串起来的黑键判断: Slint 的 `&&` / `||`
    // 在优先级表里是 **non-associative**, 串联不安全 (见 reference/language/operators)。
    in property <[bool]> white-key-pattern: [
        true, false, true, false, true, true, false, true, false, true, false, true
    ];
    // 力度是 0.0–1.0 的归一化值（= `MidiNote::velocity` ÷ 127，由投影层算好）；
    // 0–127 的量化与 960 PPQ 的对齐归模型层。
    in property <[float]> velocities: [];

    background: Tokens.bg-void;
    clip: true;

    accessible-role: region;
    accessible-id: "piano-roll";
    accessible-label: "虚拟化钢琴卷帘";

    // ---------------------------------------------------------------- 工具矩阵 (§3.3)
    // 与 src/input.rs 的 1..5 数字键是同一份状态: 只读 `active-tool` 的**唯一**写者住在宿主
    // (`host::apply_action` 的 `Action::SelectTool` 臂) —— 键盘与这里的点击**共用**那一个臂
    // (判据 `tests/tool_matrix_wiring.rs` 的第三条路径)。
    //
    // 本节点是 `Rectangle` + 一个**就地**的子 `TouchArea`（2026-10-08 修台账 R16）: 原先它只有
    // `Rectangle` + `UiText` —— **没有**输入面、**没有**回调 ⇒ 用户点它没有任何反应
    // (而 `accessible-role: button` 已经声称它是按钮)。几何 (x/y/width/height) 与外观逐像素不变。
    //
    // 为什么输入面是**子**节点而不是把节点自己改成 `TouchArea`: 实测 `slint-build` 1.18.1
    // 拒绝 `TouchArea` 上的 `background` / `border-radius`（`Unknown property … in TouchArea`）
    // —— 外观只能住在 `Rectangle` 上，因此两者叠起来（与 `console/mixer_console.slint` 的
    // 静音 / 独奏按钮逐字同款：矩形在外、`TouchArea` 在内）。
    for tool_index in 5 : Rectangle {
        x: Tokens.space-4 + 52px * tool_index;
        y: Tokens.space-2;
        width: 48px;
        height: 20px;
        background: root.active-tool-index == tool_index ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-sm;
        // 最前: 本组件末尾那条覆盖全高的滚动手势 `TouchArea` 也是 `root` 的兄弟,
        // 且声明在更后面。这条 `z` 让工具行**确定**先被本节点接住
        // (否则 Slint 的 `FrontToBack` 命中测试会把整块卷帘交给收发滚动手势的那一个)。
        z: 1;
        accessible-role: button;
        accessible-id: "piano-roll-tool-" + root.tool-names[tool_index] + "-button";
        accessible-label: root.tool-labels[tool_index] + "工具";
        accessible-item-index: tool_index;
        accessible-item-count: 5;
        accessible-checkable: true;
        accessible-checked: root.active-tool-index == tool_index;
        // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同
        // （同一个 `Tool::from_digit` 数字口径）。
        accessible-action-default => { root.tool-selected(tool_index + 1); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "" + (tool_index + 1) + " " + root.tool-labels[tool_index];
            // 选中/激活 = 负责人的 愁眠 (`selection`); 播放头/读数才是 月华 (`gold-bright`)。
            color: root.active-tool-index == tool_index ? Tokens.selection : Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
            overflow: elide;
        }

        // 一次点击 = 一次工具选择。界面只上报**数字口径**（矩阵行号 = `Tool::digit`），
        // 与 src/input.rs 的 1..5 数字键、与 `active-tool` 属主是同一份。
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.tool-selected(tool_index + 1);
            }
        }
    }

    UiMonoText {
        x: 272px;
        y: Tokens.space-2;
        width: 220px;
        height: 20px;
        text: "吸附 1/16 · PPQ 960 · 显示 C2 – C7";
        color: Tokens.ink-2;
        font-size: Tokens.font-size-xs;
        accessible-role: text;
        accessible-id: "piano-roll-status";
        accessible-label: "卷帘吸附与音域状态";
    }

    // ---------------------------------------------------------------- 琴键列
    Rectangle {
        x: 0;
        y: 28px;
        width: 56px;
        height: parent.height - 28px;
        background: Tokens.bg-panel;
        accessible-role: list;
        accessible-id: "piano-roll-keys";
        accessible-label: "钢琴键列";

        for key_index in 16 : Rectangle {
            x: 0;
            y: 14px * key_index;
            width: parent.width;
            height: 13px;
            background: root.white-key-pattern[key_index.mod(12)] ? Tokens.piano-key : Tokens.bg-void;
            border-width: 1px;
            border-color: Tokens.line;
        }
    }

    // ---------------------------------------------------------------- 卷帘网格
    Rectangle {
        x: 56px;
        y: 28px;
        width: parent.width - 56px;
        height: parent.height - 28px;
        background: Tokens.bg-shell;
        clip: true;

        accessible-role: region;
        accessible-id: "piano-roll-grid";
        accessible-label: "音符网格画布";

        // 横向音高车道
        for lane_index in 16 : Rectangle {
            x: 0;
            y: 14px * lane_index;
            width: parent.width;
            height: 13px;
            background: root.white-key-pattern[lane_index.mod(12)] ? Tokens.bg-shell : Tokens.line;
        }

        // 纵向小节线 (960 PPQ 下的 1/16 网格等模型线落地)
        for grid_index in 16 : Rectangle {
            x: 60px * grid_index;
            y: 0;
            width: 1px;
            height: parent.height;
            background: grid_index.mod(4) == 0 ? Tokens.line-strong : Tokens.line;
        }

        // ------------------------------------------------------------ 音符图元
        // [UI-TEST-001] `note-{ulid}-rect`
        for note_ulid[note_index] in root.note-ulids : Rectangle {
            // 拖动期的**草稿预览**：只有被拖的那一个身份跟着宿主算好的位移走。
            // ⛔ 界面不做位置算术 —— `note-drag-preview-*` 是宿主用既有的
            // `tick_to_px` / `PITCH_LANE_HEIGHT_PX` 算好的逻辑像素；没有手势时两项恒为 0
            // ⇒ 未拖动时与旧基准**逐像素相同**（避免无谓的基准重生成）。
            x: Tokens.space-5 + root.note-positions[note_index]
                + (note_ulid == root.note-drag-ulid ? root.note-drag-preview-dx * 1px : 0px);
            y: root.note-ys[note_index]
                + (note_ulid == root.note-drag-ulid ? root.note-drag-preview-dy * 1px : 0px);
            width: root.note-widths[note_index];
            height: 12px;
            background: Tokens.gold;
            border-radius: Tokens.radius-sm;
            // 选中态：加边框而**不改填充**（第 504 轮实测：当时**没有任何**"选中色"令牌可用, 用真实的 `gold-bright`） ⇒ 未选中时与旧基准一致（避免无谓的基准重生成）。
            // (2026-10-06: 现在确实有了一支 `accent`, 但它的角色是"整份界面只准出现一次"的强调色, 已经给了 AI 提案徽章; 这里**故意**不用它。)
            // (2026-10-07: 负责人把「选区」给了 愁眠 ⇒ 换用新的 `selection`；它的 brand 分支
            //  = #f7e6b0 = `gold-bright`, 所以**品牌分支**（`--theme brand`, 2026-10-07 之前的
            //  默认主题）的边框字节一位未变。)
            border-width: root.note-selected[note_index] ? 2px : 0px;
            border-color: root.note-selected[note_index] ? Tokens.selection : transparent;
            accessible-role: list-item;
            accessible-id: "note-" + note_ulid + "-rect";
            accessible-label: "音符 " + note_ulid;
            accessible-item-index: note_index;
            accessible-item-count: root.note-ulids.length;
            accessible-item-selectable: true;
            // 实测教训（第 504 轮）：这里此前硬编码 `note_index == 0`, 即**谎报第一个音符永远被选中**。
            accessible-item-selected: root.note-selected[note_index];
        }

        // AI 建议层预览 (§9.1): 45% 半透明 + 虚线霓虹紫描边 + 置信度徽章。
        // 骨架里只画一个静态示意块, 采纳/放弃由 Esc / Shift+Enter 驱动 (src/input.rs)。
        Rectangle {
            x: Tokens.space-5 + 76px * 6;
            y: 14px * 2 + 6px;
            width: 66px;
            height: 12px;
            background: Tokens.ai-suggestion.with-alpha(0.45);
            border-width: 1px;
            border-color: Tokens.ai-suggestion;
            border-radius: Tokens.radius-sm;
            accessible-role: list-item;
            accessible-id: "note-suggestion-overlay-rect";
            accessible-label: "AI 建议音符 (待采纳)";
            accessible-item-selectable: true;
            accessible-item-selected: false;
        }
    }

    // ---------------------------------------------------------------- 力度泳道 (§3.3 力度工具)
    // `[UI-NOTE-003]` 力度臂需要"车道顶沿在本组件局部坐标系里的位置"（指针 y 的零点）。
    // 由本元素**上报**（`velocity-lane-top`），而不是让宿主再算一次 `height - 44px`。
    velocity-lane := Rectangle {
        x: 0;
        y: parent.height - 44px;
        width: parent.width;
        height: 44px;
        background: Tokens.bg-panel;
        visible: root.show-velocity-lane;
        accessible-role: region;
        accessible-id: "piano-roll-velocity-lane";
        accessible-label: "力度泳道";

        // `for <标识符>[i] in <model>` 必须带声明标识符；本切片把它从 `_` 换成 `note_ulid`，
        // 因为力度臂的草稿预览要按**身份**选中被拖的那一根柱（见 arrangement_view.slint 的注释）。
        for note_ulid[velocity_index] in root.note-ulids : Rectangle {
            // 被拖的那一根柱按**草稿**画，其余按投影注入的 `velocities[i]`。
            // 没有手势时 `note-drag-ulid` 是空串 ⇒ 恒取投影值 ⇒ 未拖动时与旧基准逐像素相同。
            // 写成一个局部属性而不是把三元式抄两遍：`y` 与 `height` 必须来自**同一个**读数，
            // 抄两遍就可能让柱顶与柱高各说各话。
            property <float> velocity_reading:
                note_ulid == root.note-drag-ulid
                    ? root.note-drag-preview-velocity
                    : root.velocities[velocity_index];
            x: 56px + Tokens.space-5 + root.note-positions[velocity_index] + 30px;
            y: parent.height - 4px - 28px * velocity_reading;
            width: 6px;
            height: 28px * velocity_reading;
            background: Tokens.gold-deep;
            border-radius: Tokens.radius-sm;
            accessible-role: slider;
            accessible-id: "velocity-" + velocity_index + "-bar";
            accessible-label: "力度条 " + velocity_index;
            accessible-value-minimum: 0;
            accessible-value-maximum: 127;
            accessible-value-step: 1;
            accessible-value: "100";
        }
    }

    // ---------------------------------------------------------------- 走带光标 [UI-MCP-002]
    Rectangle {
        x: 56px + 60px * 3;
        y: 28px;
        width: 1px;
        height: parent.height - 28px;
        background: Tokens.gold-bright;
        accessible-role: slider;
        accessible-id: "piano-roll-playhead";
        accessible-label: "卷帘走带光标";
        accessible-value-minimum: 0;
        accessible-value-maximum: 9999;
        accessible-value-step: 1;
        accessible-value: "3";
    }

    // 覆盖泳道的输入面：按住并水平拖动 ⇒ 报告水平增量（向右拖 ⇒ 内容左移 ⇒ 偏移增加）。
    property <length> drag-last-x: 0px;
    property <bool> dragging: false;
    // `[UI-NOTE-003]` 手势分类的四个**界面本地**读数（都不进模型）：
    //   `drag-origin-*` = 按下时的指针位置（绘制帧）；
    //   `drag-moved`    = 位移是否越过了规范的 **4px** 阈值（越过 = 拖拽，没越过 = 单击）；
    //   `note-dragging` = 宿主已**接管**这一拖（选择工具 + 按在音符上）。
    property <length> drag-origin-x: 0px;
    property <length> drag-origin-y: 0px;
    property <bool> drag-moved: false;
    property <bool> note-dragging: false;
    TouchArea {
        // `[UI-TEST-001]` §12.2 稳定语义元素寻址：拖动滚动手势面必须有 `accessible-id`
        // （与 `ui/` 下其它关键节点同一族），否则无头注入只能靠像素坐标 —— 那正是被禁的做法。
        accessible-role: region;
        accessible-id: "piano-roll-scroll-area";
        accessible-label: "卷帘拖动手势面";
        // 本版本 `PointerEvent` **没有** `delta-x`（编译期报 "Cannot access the field 'delta-x'"），
        // 本版本的 `PointerEvent` 也**没有** `position`，位置只能取 `TouchArea` 自己的 `mouse-x`。用 `last - now` 表示"向右拖 ⇒ 内容左移 ⇒ 偏移增加"。
        //
        // ⚠ 这里有一条**判定顺序**上的契约（本切片新增）：`up` **只在位移未越 4px 阈值时**
        // 才 fired 一次 `clicked`。在此之前 `up` 无条件 fired `clicked` ⇒ 用铅笔（或橡皮擦）
        // 在空白处滚动一下，松手处就会**插进一个音符** —— 滚动手势被当成了单击。
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-origin-x = self.mouse-x;
                root.drag-origin-y = self.mouse-y;
                root.drag-moved = false;
                root.drag-last-x = self.mouse-x;
                // 先问宿主"这一按是不是**移动音符**"（选择工具 + 命中音符）。
                // 接管 ⇒ ⛔ 不滚动（两条手势通道互斥，⛔ 不双重处理）。
                root.note-dragging = root.note-drag-grab(self.mouse-x, self.mouse-y);
                root.dragging = !root.note-dragging;
            } else if event.kind == PointerEventKind.up {
                root.dragging = false;
                if root.note-dragging {
                    root.note-dragging = false;
                    if root.drag-moved {
                        // 越了 4px ⇒ 这一抬是**拖拽**的收尾（提交恰好一个原子 Op）。
                        root.note-drag-release(self.mouse-x, self.mouse-y);
                    } else {
                        // 没越阈值 ⇒ 这一抬是一次**单击**（选择工具点音符 = 选中它）。
                        root.clicked(self.mouse-x, self.mouse-y);
                    }
                } else if !root.drag-moved {
                    // 空白处：只有**没越阈值**的抬起才算一次单击（选中 / 清除选区）。
                    root.clicked(self.mouse-x, self.mouse-y);
                }
                root.drag-moved = false;
            } else if event.kind == PointerEventKind.move {
                // 阈值判定用**两个方向各自比较**而不是 `abs(...)`：Slint 的 `length`
                // 绝对值函数在这里没有必要，比较是纯量运算、无歧义。
                if !root.drag-moved
                    && ((self.mouse-x - root.drag-origin-x) > 4px
                        || (root.drag-origin-x - self.mouse-x) > 4px
                        || (self.mouse-y - root.drag-origin-y) > 4px
                        || (root.drag-origin-y - self.mouse-y) > 4px) {
                    root.drag-moved = true;
                }
                if root.note-dragging {
                    // 拖拽臂：越阈值之后才更新草稿（小抖动不改草稿）。
                    if root.drag-moved {
                        root.note-drag-move(self.mouse-x, self.mouse-y);
                    }
                } else if root.dragging {
                    root.scroll-requested(root.drag-last-x - self.mouse-x);
                    root.drag-last-x = self.mouse-x;
                }
            } else {
                // `cancel`（指针离开窗口 / 控件被禁用）：与 `up` 一样是收尾，
                // 但这一拖**不算数** ⇒ 丢弃草稿、⛔ 不提交。
                root.dragging = false;
                root.drag-moved = false;
                if root.note-dragging {
                    root.note-dragging = false;
                    root.note-drag-cancel();
                }
            }
        }
    }
}
