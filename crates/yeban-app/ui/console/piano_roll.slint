// 夜半 (Yeban) — 虚拟化 MIDI 钢琴卷帘 (底部控制台 Tab 1)
//
// 规范来源 (Normative):
//   - 规范 §3.1: Slint 硬件加速视口裁剪 + 空间索引 —— **裁剪已实现**（投影的六条数组按视口切片并注入本文件；
//     判据 `cargo test -p yeban-app --lib clipping`）；**R-Tree 有意未采用**，改用按 x 排序的二分索引（零新依赖）
//   - 规范 §3.2: 坐标系双向转换与 960 PPQ 吸附对齐 —— **已实现**（`snap_tick`/`snapped_tick_at` 等在 `src/bridge.rs`）
//   - 规范 §3.3: 视听反馈引擎与多工具交互矩阵 (1 选择 / 2 铅笔 / 3 剪刀 / 4 力度 / 5 橡皮擦)
//   - 规范 §3.5: 全键盘音符微调
//   - [UI-TEST-001] §12.2: `note-{ulid}-rect` 语义 ID
//   - [UI-MCP-002] §12.5: 走带光标与力度条属高频刷新区域
//
// 本文件是**静态骨架 + 由投影注入的数据**。**视口裁剪、吸附与工具状态机均已实现**（第 607/608 轮更正此处：
// 旧文写"仍未实现"已与代码不符）；R-Tree 有意未采用（见上）。
// 音符的坐标映射（`[UI-NOTE-002]`）**已落地在投影层**：x / y / 宽来自 `src/bridge.rs`
// 的整数 tick / 音高换算，本文件只消费注入数组（见 `note-positions` 的注释）。

import { Theme, Tokens, UiText, UiMonoText } from "../tokens.slint";

export component PianoRoll inherits Rectangle {
    // 由 src/host.rs 单向注入 —— `{ulid}` 段来自**工程里的 `MidiNote::id`**
    // （不再是界面内联的演示常量）。
    //
    // 简化（如实登记，见 docs/ledger/app-binding-notes.md 未实现项）：这里注入的是
    // **片段池里的全部 MIDI 音符**，而不是"当前编辑片段"的音符 —— 后者的作用域属于
    // 会话运行态（`MODEL-ISO-001`），还没有对应的状态容器。
    in property <[string]> note-ulids: [];
    // 音符位置 —— **全部**由 `src/bridge.rs` 从 `MidiNote::start_tick` / `pitch` 整数推导，
    // 这里只做"取数组下标"，不做任何位置算术（`[UI-NOTE-002]` 的投影侧落地）：
    //   `note-positions[i]` = `tick_to_px(start_tick)`（整数除法，逻辑像素）
    //   `note-ys[i]`        = `PITCH_LANE_HEIGHT_PX × pitch_lane(pitch) + NOTE_INSET_Y_PX`
    //   `note-widths[i]`    = 结束 tick 的像素 − 起始 tick 的像素（有 1px 地板）
    // 上一版这里是 `x: Tokens.space-5 + 76px * note_index` / `y: 14px * note_index + 6px`
    // —— 音符的**索引**而不是工程的 tick。那条布局已被判据
    // `bridge::slint_text_contracts_for_colors_and_pitch_lanes` 明文禁止。
    in property <[length]> note-positions: [];
    // `[UI-NOTE-003]` 与注入的六个数组**同一索引集**的第七个: 选中标志（宿主用 `Selection::flags_for` 生成）。
    in property <[bool]> note-selected: [];
    // ---- 走带光标（[UI-NOTE-001]）----
    // 位置来自引擎读数：唯一写者 = `host::apply_transport`（窗口属性 `playhead-ticks`）。
    // 界面只做 `tick ÷ ticks_per_pixel − scroll`（与音符位置同一条整数除法 + 同一个滚动读数）。
    in property <int> playhead-ticks: 0;
    in property <int> ticks-per-pixel: 30;
    in property <float> scroll-x: 0.0;
    // 无障碍值 = 走带时间码（窗口 `timecode`）—— 读屏器读到真实位置，⛔ 不是写死的 `"3"`。
    in property <string> playhead-timecode: "";
    // `[ROAD-M3-002]` 滚动手势：本组件**只报告增量**, 偏移由宿主拥有并重新注入
    // （见账本第 199 轮：Flickable 会与宿主拥有的偏移双重计算, 故不用）。
    callback scroll-requested(length);
    /// `[UI-NOTE-001 / UI-NOTE-002]` 双指触控板/鼠标滚轮二维滚动（`delta-x, delta-y, shift, alt`）：
    /// 横向平移时间轴、纵向滑动音高视口（0..127 全音域）、`Alt/Option` 横向缩放。
    callback roll-wheel(length, length, bool, bool);
    // `[UI-NOTE-003]` 左键单击：只**报告坐标**, 命中与选区由 Rust 侧决定（账本第 495/496 轮）。
    callback clicked(length, length);
    // `[UI-NOTE-003]` §3.3 工具矩阵 aux 列的**双击**入口（力度工具 = "双击恢复默认力度 100"）。
    // 与 `clicked` **同一绘制帧、同一个命中面**：界面只报告坐标；工具门 / 命中测试 /
    // "恰好一个原子 `Op::ModifyNoteVelocity`"全在宿主派发器里（⛔ 界面不判断工具）。
    callback double-clicked(length, length);
    // `[UI-NOTE-003]` §3.3 工具矩阵的**点击**入口：工具行号（1..5，与 `Tool::digit` 同一口径）。
    // 界面只上报"点了哪一行"; `active-tool` 的写入与动作日志由宿主唯一落点
    // (`host::wire_tool_select` → `host::apply_action` 的 `Action::SelectTool` 臂) 完成。
    callback tool-selected(int);
    // `[UI-NOTE-003]` 左键**拖拽**的手势通道（工具矩阵"左键拖拽"列；本切片接的是选择工具的
    // 移动臂 `Tool::drag() == ToolDrag::MoveNote`）。界面只**报告指针位置**（绘制帧）；
    // 工具门、命中、草稿与"抬起恰好一个原子 `Op::MoveNote`"全在宿主
    // （`host::wire_roll_edit` → `install_roll_note_drag`）。
    // 返回 `true` = 宿主**接管**这次手势 ⇒ 本组件不再把它当滚动 / 单击（⛔ 不双重处理）。
    callback note-drag-grab(length, length) -> bool;
    // 接管后的每次指针移动（绘制帧坐标）⇒ 宿主**只**更新草稿，⛔ 不写工程、⛔ 不进撤销栈。
    callback note-drag-move(length, length);
    // 松手（绘制帧坐标）⇒ 宿主**至多提交一个**原子 `Op`。
    callback note-drag-release(length, length);
    // 指针离开窗口 / 控件被禁用（上游导出成 `PointerEventKind.cancel`）⇒ **丢弃**草稿。
    callback note-drag-cancel();
    // ⭐ 右键上下文菜单（人性化 / 量化）的**上抛**入口：菜单项点中后调这里，
    // 宿主打开 `dialogs/humanize_dialog.slint` 的对应区段。界面只上报"点了哪一项"；
    // 播种、解析、提交全在宿主（`host::wire_humanize_dialog`）。
    // 菜单本身默认**不显示**（`PopupWindow`，只在右键按下时 `show()`），因此默认帧
    // 与 `tests/golden/linux/` 的 5 张基准一位不变。
    callback humanize-requested();
    callback quantize-requested();
    // Real piano-key hold/glissando/release audition + octave shift callbacks
    callback piano-key-pressed(int);
    callback piano-key-released(int);
    callback pitch-range-shift(int);
    in property <int> base-midi-pitch: 60;
    in property <string> pitch-range-label: "C4 – Eb5";
    // 被拖音符的身份（空 = 没有手势）与拖动期的**草稿预览位移**（逻辑像素，由宿主算好注入）。
    // 只有身份相等的那个音符矩形跟着偏移 —— 界面不做位置算术（`[UI-NOTE-002]`）。
    in property <string> note-drag-ulid: "";
    in property <float> note-drag-preview-dx: 0.0;
    in property <float> note-drag-preview-dy: 0.0;
    // `[UI-NOTE-003]` 力度臂的**草稿预览**（0.0–1.0 的归一化力度，宿主算好注入）：
    // 只有身份等于 `note-drag-ulid` 的那一根力度柱按它画高（拖动期 ⛔ 不写工程）。
    // 没有手势时 `note-drag-ulid` 是空串 ⇒ 这一项**不被任何柱读到**（未拖动时逐像素不变）。
    in property <float> note-drag-preview-velocity: 0.0;
    // `[UI-NOTE-003]` 力度车道在**本组件局部坐标系**里的顶沿（逻辑像素）。
    //
    // 宿主必须知道它才能把指针的 y 反解成"车道内 y"（= 绝对力度）。这个读数由**界面**
    // 上报（`velocity-lane.y`），⛔ 宿主不在自己那边手写 `height - 44` —— 那会变成第二份
    // 布局算术（帧原点那一族，见 `tests/tool_matrix_wiring.rs` 的禁用常量表）。
    out property <length> velocity-lane-top: velocity-lane.y;
    in property <[length]> note-ys: [];
    in property <[length]> note-widths: [];
    in property <[string]> tool-names: ["select", "pencil", "knife", "velocity", "eraser"];
    in property <[string]> tool-labels: [@tr("选择"), @tr("铅笔"), @tr("剪刀"), @tr("力度"), @tr("橡皮")];
    in property <int> active-tool: 1;
    // `[UI-NOTE-003]` **工具行号口径的唯一转换点**（台账 R372）: `active-tool` 是 `1`..`5`
    // （`Tool::digit()` 与数字键 `1`..`5` 同一口径），而工具矩阵那圈 `for` 的下标是 `0`..`4`。
    // 底色 / `accessible-checked` / 字色三条绑定**只许读这一个属性** —— 直接拿 `active-tool`
    // 去比下标，启动默认（`1`）会勾中「2 铅笔」、按 `5` 还会一格都不勾（判据
    // `tests/live_ui_mcp.rs` 的 `the_tool_matrix_checked_state_tracks_the_active_tool_for_every_digit`）。
    property <int> active-tool-index: root.active-tool - 1;
    // ⭐ 任务单 `#166`：宿主写进来的**最近一次卷帘编辑拒绝文本**（空串 = 没有拒绝）。
    // 唯一写者 = `host::install_roll_click` 的第二段（每次点击先清空、拒绝时写逐字原因）。
    // 空串时这一行仍是既有的静态读数 ⇒ 没有拒绝时与改前**逐像素相同**（⛔ 不新造一块 UI）。
    in property <string> edit-status: "";
    // "有没有可显示的拒绝文本"的**单一**读数（空串判定只写在这一行 ⇒ 无障碍标签那行
    // 不出现空字面量，`no_accessible_name_may_be_the_empty_literal` 仍绿）。
    property <bool> edit-status-shown: root.edit-status != "";

    in property <bool> show-velocity-lane: true;
    // 十二平均律一个八度里的白键位置 (C C# D D# E F F# G G# A A# B)。
    // 用「查表 + 取模」而不是 5 个 `||` 串起来的黑键判断: Slint 的 `&&` / `||`
    // 在优先级表里是 **non-associative**, 串联不安全 (见 reference/language/operators)。
    in property <[bool]> white-key-pattern: [
        true, false, true, false, true, true, false, true, false, true, false, true
    ];
    // 16 行音高映射 (row 0 = MIDI 75 Eb5 .. row 15 = MIDI 60 C4, 与 bridge::pitch_for_lane 同口径)
    in property <[bool]> lane-is-white: [
        false, true, false, true, true, false, true, false, true, false, true, true, false, true, false, true
    ];
    in property <[string]> lane-key-labels: [
        "D#5", "D5", "C#5", "C5", "B4", "A#4", "A4", "G#4", "G4", "F#4", "F4", "E4", "D#4", "D4", "C#4", "C4"
    ];
    in-out property <int> audition-active-row: -1;
    // 力度是 0.0–1.0 的归一化值（= `MidiNote::velocity` ÷ 127，由投影层算好）；
    // 0–127 的量化与 960 PPQ 的对齐归模型层。
    in property <[float]> velocities: [];

    // 编辑面回平 (负责人 2026-11-17 拟物重点口径): 卷帘根底/网格/车道/
    // 力度泳道两套主题同为平色 (二期加的 §10/§12 刷已撤), 质感只留给
    // 工具按钮、键盘本体与右键菜单 (下方三元)。
    // ── 可见音高窗口（2026-11-18 负责人口径）────────────────────────
    // ① 行数随面板高度铺满：下坞拖高/最大化时，下方不再出现"没有格线
    //    也没有琴键"的空白块（原实现固定 16 行 × 14px = 224px）。
    // ② 下界锁在 MIDI 24（C0）：C0 以下不铺车道，避免一片空。
    //    上界仍是投影的 `base-midi-pitch + 15`（row 0 最高音），音符
    //    位置由 `note-ys` 注入、不随本窗口变化 ⇒ 前 16 行逐像素不变。
    // ③ 最少 8 行：面板被拖到极矮时也保留可读的最小窗口。
    property <int> visible-rows: Math.max(8, Math.floor((self.height - 28px) / 14px));
    property <int> roll-rows: Math.min(self.visible-rows, Math.max(8, root.base-midi-pitch - 8));
    function row-pitch(row: int) -> int { return root.base-midi-pitch + 15 - row; }
    function row-is-white(row: int) -> bool { return root.white-key-pattern[root.row-pitch(row).mod(12)]; }

    background: Tokens.bg-void;
    clip: true;

    accessible-role: region;
    accessible-id: "piano-roll";
    accessible-label: @tr("虚拟化钢琴卷帘");

    // ---------------------------------------------------------------- 工具矩阵 (§3.3)
    // 与 src/input.rs 的 1..5 数字键是同一份状态: 只读 `active-tool` 的**唯一**写者住在宿主
    // (`host::apply_action` 的 `Action::SelectTool` 臂) —— 键盘与这里的点击**共用**那一个臂
    // (判据 `tests/tool_matrix_wiring.rs` 的第三条路径)。
    //
    // 本节点是 `Rectangle` + 一个**就地**的子 `TouchArea`（2026-10-08 修台账 R16）: 原先它只有
    // `Rectangle` + `UiText` —— **没有**输入面、**没有**回调 ⇒ 用户点它没有任何反应
    // (而 `accessible-role: button` 已经声称它是按钮)。几何 (x/y/width/height) 与外观逐像素不变。
    //
    // 为什么输入面是**子**节点而不是把节点自己改成 `TouchArea`: 实测 `slint-build` 1.18.1
    // 拒绝 `TouchArea` 上的 `background` / `border-radius`（`Unknown property … in TouchArea`）
    // —— 外观只能住在 `Rectangle` 上，因此两者叠起来（与 `console/mixer_console.slint` 的
    // 静音 / 独奏按钮逐字同款：矩形在外、`TouchArea` 在内）。
    for tool_index in 5 : Rectangle {
        x: Tokens.space-4 + 52px * tool_index;
        y: Tokens.space-2;
        width: 48px;
        height: 20px;
        // 二期质感: 工具钮走 §10 凸起/面板刷。扁平支 (2026-11-19 口径): 未选中**不留背板**
        // —— 图标/文字直接落在工具条上, 选中才是唯一带底的那一格。
        background: root.active-tool-index == tool_index ? (Tokens.texture-physical ? Tokens.raised-brush : Tokens.selection.mix(Tokens.bg-shell, 0.16)) : (Tokens.texture-physical ? Tokens.panel-alt-brush : transparent);
        border-radius: Tokens.radius-sm;
        border-width: (root.active-tool-index == tool_index && !Tokens.texture-physical) ? 1px : 0px;
        border-color: Tokens.selection.with-alpha(0.85);
        // 最前: 本组件末尾那条覆盖全高的滚动手势 `TouchArea` 也是 `root` 的兄弟,
        // 且声明在更后面。这条 `z` 让工具行**确定**先被本节点接住
        // (否则 Slint 的 `FrontToBack` 命中测试会把整块卷帘交给收发滚动手势的那一个)。
        z: 1;
        accessible-role: button;
        accessible-id: "piano-roll-tool-" + root.tool-names[tool_index] + "-button";
        accessible-label: @tr("{}工具", root.tool-labels[tool_index]);
        accessible-item-index: tool_index;
        accessible-item-count: 5;
        accessible-checkable: true;
        accessible-checked: root.active-tool-index == tool_index;
        // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同
        // （同一个 `Tool::from_digit` 数字口径）。
        accessible-action-default => { root.tool-selected(tool_index + 1); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "" + (tool_index + 1) + " " + root.tool-labels[tool_index];
            // 选中/激活 = 负责人的 愁眠 (`selection`); 播放头/读数才是 月华 (`gold-bright`)。
            color: root.active-tool-index == tool_index ? Tokens.selection : Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
            overflow: elide;
        }

        // 一次点击 = 一次工具选择。界面只上报**数字口径**（矩阵行号 = `Tool::digit`），
        // 与 src/input.rs 的 1..5 数字键、与 `active-tool` 属主是同一份。
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.tool-selected(tool_index + 1);
            }
            scroll-event(event) => {
                root.roll-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
                accept
            }
        }
    }

    UiMonoText {
        x: 272px;
        y: Tokens.space-2;
        // 运行期拒绝原因（`#166`）比静态读数长 ⇒ 这一行横向占满剩余宽度（左侧 x / 顶沿 y
        // 与高度一位未改，而**没有拒绝时**文字仍是同一串、左对齐 ⇒ 像素不变）。
        width: max(0px, parent.width - 272px - 230px);
        height: 20px;
        text: root.edit-status-shown ? root.edit-status : @tr("吸附 1/16 · PPQ 960 · {}", root.pitch-range-label);
        color: Tokens.ink-2;
        font-size: Tokens.font-size-xs;
        overflow: elide;
        accessible-role: text;
        accessible-id: "piano-roll-status";
        accessible-label: @tr("卷帘吸附与音域状态");
        accessible-value: root.edit-status-shown ? root.edit-status : @tr("吸附 1/16 · PPQ 960 · {}", root.pitch-range-label);
    }

    // 右侧本地视图菜单（八度移位 / 量化 / 人性化）
    HorizontalLayout {
        x: parent.width - 222px;
        y: Tokens.space-2;
        width: 214px;
        height: 20px;
        spacing: 4px;
        z: 1;

        Rectangle {
            width: 30px;
            height: 20px;
            background: oct-down-touch.has-hover ? (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-raised) : (Tokens.texture-physical ? Tokens.panel-alt-brush : Tokens.bg-panel-alt);
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.line;
            UiText {
                width: parent.width;
                height: parent.height;
                text: @tr("八-");
                color: root.base-midi-pitch <= 24 ? Tokens.ink-2 : Tokens.ink-1;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            oct-down-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.pitch-range-shift(-12); }
                scroll-event(event) => {
                    root.roll-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
                    accept
                }
            }
        }
        Rectangle {
            width: 30px;
            height: 20px;
            background: oct-up-touch.has-hover ? (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-raised) : (Tokens.texture-physical ? Tokens.panel-alt-brush : Tokens.bg-panel-alt);
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.line;
            UiText {
                width: parent.width;
                height: parent.height;
                text: @tr("八+");
                color: root.base-midi-pitch >= 96 ? Tokens.ink-2 : Tokens.ink-1;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            oct-up-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.pitch-range-shift(12); }
                scroll-event(event) => {
                    root.roll-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
                    accept
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 20px;
            background: quant-btn-touch.has-hover ? (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-raised) : (Tokens.texture-physical ? Tokens.panel-alt-brush : Tokens.bg-panel-alt);
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.line;
            UiText {
                width: parent.width;
                height: parent.height;
                text: @tr("量化 Q");
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            quant-btn-touch := TouchArea {
                clicked => { root.quantize-requested(); }
                scroll-event(event) => {
                    root.roll-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
                    accept
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 20px;
            background: hum-btn-touch.has-hover ? (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-raised) : (Tokens.texture-physical ? Tokens.panel-alt-brush : Tokens.bg-panel-alt);
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.line;
            UiText {
                width: parent.width;
                height: parent.height;
                text: @tr("人性化 H");
                color: Tokens.ink-1;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            hum-btn-touch := TouchArea {
                clicked => { root.humanize-requested(); }
                scroll-event(event) => {
                    root.roll-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
                    accept
                }
            }
        }
    }

    // ---------------------------------------------------------------- 琴键列 (真实黑白键: 白键连成平面, 黑键短一段插在上面)
    // 2026-11-18 负责人口径：键列不再是"每行一块方砖"，改成真实钢琴的观感 ——
    // 白键是一整片连续的浅色平面（只在 E|F、B|C 这种两个白键直接相邻处画
    // 分隔线），黑键是从左缘伸出、比白键短一段的窄键帽，压在平面之上。
    Rectangle {
        x: 0;
        y: 28px;
        width: 56px;
        height: parent.height - 28px;
        // 白键平面（physical 走 §12 键刷的纵向明暗，flat 仍旧平色）
        background: Tokens.roll-key-white-brush;
        clip: true;
        accessible-role: list;
        accessible-id: "piano-roll-keys";
        accessible-label: @tr("钢琴键列");

        // 白键之间的分隔：只有当本行与下一行都是白键时才是"两颗白键贴着"
        for key_index in root.roll-rows : Rectangle {
            visible: root.row-is-white(key_index);
            x: 0px;
            y: 14px * key_index + 13px;
            width: parent.width;
            height: 1px;
            background: Tokens.roll-key-split;
        }

        // 短黑键：宽度只有白键的 6 成，纵向留缝 ⇒ 看得出是"夹在白键中间"
        for key_index in root.roll-rows : Rectangle {
            visible: !root.row-is-white(key_index);
            x: 0px;
            y: 14px * key_index + 1px;
            width: 30px;
            height: 9px;
            border-radius: 3px;
            background: root.audition-active-row == key_index ? Tokens.selection : (Tokens.texture-physical ? Tokens.roll-key-cap-brush : Tokens.roll-key-black-brush);
            border-width: 1px;
            border-color: root.audition-active-row == key_index ? Tokens.selection : Tokens.roll-key-edge;

            // 键帽受光面（只拟物，扁平不描高光）
            if Tokens.texture-physical : Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 3px;
                height: 2px;
                background: Tokens.bevel-light;
            }
        }

        // 试听/敲击时整行提亮（白键行同样显示）
        for key_index in root.roll-rows : Rectangle {
            visible: root.audition-active-row == key_index && root.row-is-white(key_index);
            x: 0px;
            y: 14px * key_index;
            width: parent.width;
            height: 14px;
            background: Tokens.selection.with-alpha(0.55);
        }

        // C 音（八度锚点）标示点
        for key_index in root.roll-rows : Rectangle {
            visible: root.row-pitch(key_index).mod(12) == 0;
            x: 6px;
            y: 14px * key_index + 6px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Theme.track-synth;
        }

        // 音名：投影给的前 16 行照旧显示，展开出来的行只画键面（不造假标签）
        for key_index in root.roll-rows : UiMonoText {
            // 信息降噪（2026-11-18）：整列只标 C 音锚点，其余音名靠键面形状识别。
            visible: key_index < root.lane-key-labels.length && root.row-pitch(key_index).mod(12) == 0;
            x: 36px;
            y: 14px * key_index;
            width: parent.width - 38px;
            height: 14px;
            text: key_index < root.lane-key-labels.length ? root.lane-key-labels[key_index] : "";
            color: Tokens.roll-key-ink;
            font-size: 9px;
            font-weight: 400;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    // ---------------------------------------------------------------- 卷帘网格 (高对比黑白键背景 + 清晰格线)
    Rectangle {
        x: 56px;
        y: 28px;
        width: parent.width - 56px;
        height: parent.height - 28px;
        // 网格底 (2026-11-17 口径): flat 回平 Tokens.bg-lane 平色;
        // physical 按 Bitwig 截图采样提亮到 #20272e (Wang 定:
        // 拟物版卷帘背景太深), 下方车道三档与分隔线同幅上移。
        background: Tokens.texture-physical ? Tokens.bg-lane : Tokens.bg-lane;
        clip: true;

        accessible-role: region;
        accessible-id: "piano-roll-grid";
        accessible-label: @tr("音符网格画布");

        // 横向音高车道：行数 = root.roll-rows（随面板铺满、下界锁 C0），
        // 前 16 行的色档与旧版逐像素一致（根音行 / 白键行 / 黑键行）。
        for lane_index in root.roll-rows : Rectangle {
            x: 0;
            y: 14px * lane_index;
            width: parent.width;
            height: 14px;
            // C 行不再整行铺一条亮线（一整条 14px 的 #414751 会在整屏横着切出
            // 一道"灰带"，抢音符的视线）；根部只把底边线加重一档，行本身走车道色。
            background: (!root.row-is-white(lane_index)) ? Tokens.roll-lane-black : Tokens.roll-lane-white;

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                // 八度根音把底边线加重到"小节线"那一档（与编曲区 skin-grid-bar 同强度）；
                // 其余行只留一条和车道几乎同色的细线，避免 14px 行高里铺出密集横条。
                background: (root.row-pitch(lane_index).mod(12) == 0) ? Tokens.skin-grid-bar : Tokens.bg-lane2;
            }
        }
        // 纵向网格：**拍线 + 小节线**两级，随 scroll-x 无缝横向平铺。
        // 间距必须是"真实时间线"：PPQ=960、4/4 ⇒ 1 拍 = 240 tick；默认 30 tick/px
        // ⇒ **1 拍 = 8px、1 小节 = 32px**（此前固定 48px，等于 3 拍一条线，
        // 与 MIDI 刻度完全对不上，手画的音符一个都不落线）。
        // 条数按可视宽度铺满（1920px / 8px = 240 条）——旧版只有 24 条，
        // 平铺公式越界后右半边整片没有网格。
        for grid_index in 240 : Rectangle {
            x: Tokens.space-5 + 8px * (grid_index + 240 * Math.max(0, Math.floor((root.scroll-x - 8 * grid_index + 1919) / 1920))) - root.scroll-x * 1px;
            y: 0;
            width: 1px;
            height: parent.height;
            // 分档：**小节线**一档（skin-grid-beat，能看见但不抢戏）、**拍线**退到
            // 车道底色那一档（bg-lane2，只作为背景纹理存在）。
            // 实测教训：8px 拍线若和 bar 线同强度，整屏就是一道竖栅栏，比原来的
            // "48px 一根错位线"更累眼 —— 网格是背景，永远不许比音符亮。
            background: grid_index.mod(4) == 0 ? Tokens.skin-grid-beat : Tokens.bg-lane2;
        }

        // ------------------------------------------------------------ 音符图元
        // [UI-TEST-001] `note-{ulid}-rect`
        for note_ulid[note_index] in root.note-ulids : Rectangle {
            // 拖动期的**草稿预览**：只有被拖的那一个身份跟着宿主算好的位移走。
            // ⛔ 界面不做位置算术 —— `note-drag-preview-*` 是宿主用既有的
            // `tick_to_px` / `PITCH_LANE_HEIGHT_PX` 算好的逻辑像素；没有手势时两项恒为 0
            // ⇒ 未拖动时与旧基准**逐像素相同**（避免无谓的基准重生成）。
            x: Tokens.space-5 + root.note-positions[note_index]
                + (note_ulid == root.note-drag-ulid ? root.note-drag-preview-dx * 1px : 0px);
            y: root.note-ys[note_index]
                + (note_ulid == root.note-drag-ulid ? root.note-drag-preview-dy * 1px : 0px);
            width: root.note-widths[note_index];
            // 块高必须留在本行之内：`NOTE_INSET_Y_PX(2) + 10 <= 14`。原先是 12px
            // 配 6px 内缩（6+12=18），每个块都跨过行底线 4px —— 就是"方块压在水平线上"。
            height: 10px;
            // 力度 → 底色（对齐 Logic：音符块按力度上色）。三档走同一支色相的
            // 明度阶梯，不铺彩虹：低力度压暗、高力度提亮，整屏仍只有一个视觉重心。
            background: root.velocities[note_index] < 0.35 ? Tokens.note-vel-low
                : (root.velocities[note_index] < 0.7 ? Tokens.note-vel-mid : Tokens.note-vel-high);
            border-radius: Tokens.radius-sm;

            // 块内那条横线：**相对长度 = 力度**（Logic 的标志性读法，"力度 67"就是这根线的长度）。
            // 底色 + 内线两路冗余编码，色弱的人也能读出力度高低。
            Rectangle {
                x: 2px;
                y: 4px;
                width: Math.max(2px, (parent.width - 4px) * root.velocities[note_index]);
                height: 2px;
                background: Tokens.note-vel-mark;
                border-radius: 1px;
            }
            // 选中态：加边框而**不改填充**（第 504 轮实测：当时**没有任何**"选中色"令牌可用, 用真实的 `gold-bright`） ⇒ 未选中时与旧基准一致（避免无谓的基准重生成）。
            // (2026-10-06: 现在确实有了一支 `accent`, 但它的角色是"整份界面只准出现一次"的强调色, 已经给了 AI 提案徽章; 这里**故意**不用它。)
            // (2026-10-07: 负责人把「选区」给了 愁眠 ⇒ 换用新的 `selection`；它的 brand 分支
            //  = Tokens.skin-mute = `gold-bright`, 所以**品牌分支**（`--theme brand`, 2026-10-07 之前的
            //  默认主题）的边框字节一位未变。)
            border-width: root.note-selected[note_index] ? 2px : 0px;
            border-color: root.note-selected[note_index] ? Tokens.selection : transparent;
            accessible-role: list-item;
            accessible-id: "note-" + note_ulid + "-rect";
            accessible-label: @tr("音符 {}", note_ulid);
            accessible-item-index: note_index;
            accessible-item-count: root.note-ulids.length;
            accessible-item-selectable: true;
            // 实测教训（第 504 轮）：这里此前硬编码 `note_index == 0`, 即**谎报第一个音符永远被选中**。
            accessible-item-selected: root.note-selected[note_index];
        }

        // AI 建议层 (§9.1)：⛔ 今天**不画**。
        //
        // 曾有一个静态示意块（`note-suggestion-overlay-rect`，标签 "AI 建议音符 (待采纳)"）——
        // 它没有任何提案数据源：界面侧**没有**"当前待采纳的提案身份"这一表示（提案抽屉的
        // 四个数据面属性默认全空、没有宿主写者；逐条证据见 `src/host.rs` 的
        // `action_has_implementation` 文档里 `AcceptAiSuggestion` 那一段），所以那块
        // "待采纳音符"只是一个永远在场的假建议。与 `musical_pr_drawer_declares_no_demo_proposals`
        // 同一条纪律：能力不存在就不画。真落地时要先有提案来源（领域 `Domain.proposals`
        // → 投影 → 注入），再按 §9.1 的 45% 半透明 + 虚线描边重画这一层。
    }

    // ---------------------------------------------------------------- 力度泳道 (§3.3 力度工具)
    // `[UI-NOTE-003]` 力度臂需要"车道顶沿在本组件局部坐标系里的位置"（指针 y 的零点）。
    // 由本元素**上报**（`velocity-lane-top`），而不是让宿主再算一次 `height - 44px`。
    velocity-lane := Rectangle {
        x: 0;
        y: parent.height - 44px;
        width: parent.width;
        height: 44px;
        // 力度泳道回平 (2026-11-17 口径): 两套主题同为 bg-panel 平色。
        background: Tokens.bg-panel;
        visible: root.show-velocity-lane;
        accessible-role: region;
        accessible-id: "piano-roll-velocity-lane";
        accessible-label: @tr("力度泳道");

        // `for <标识符>[i] in <model>` 必须带声明标识符；本切片把它从 `_` 换成 `note_ulid`，
        // 因为力度臂的草稿预览要按**身份**选中被拖的那一根柱（见 arrangement_view.slint 的注释）。
        for note_ulid[velocity_index] in root.note-ulids : Rectangle {
            // 被拖的那一根柱按**草稿**画，其余按投影注入的 `velocities[i]`。
            // 没有手势时 `note-drag-ulid` 是空串 ⇒ 恒取投影值 ⇒ 未拖动时与旧基准逐像素相同。
            // 写成一个局部属性而不是把三元式抄两遍：`y` 与 `height` 必须来自**同一个**读数，
            // 抄两遍就可能让柱顶与柱高各说各话。
            property <float> velocity_reading:
                note_ulid == root.note-drag-ulid
                    ? root.note-drag-preview-velocity
                    : root.velocities[velocity_index];
            x: 56px + Tokens.space-5 + root.note-positions[velocity_index] + 30px;
            y: parent.height - 4px - 28px * velocity_reading;
            width: 6px;
            height: 28px * velocity_reading;
            background: Tokens.gold-deep;
            border-radius: Tokens.radius-sm;
            accessible-role: slider;
            accessible-id: "velocity-" + velocity_index + "-bar";
            accessible-label: @tr("力度条 {}", velocity_index);
            accessible-value-minimum: 0;
            accessible-value-maximum: 127;
            accessible-value-step: 1;
            // 屏读器读到的必须是**这一根柱**的力度（0–127），与柱高同源：
            // `velocity_reading` 已是 0..=127 ÷ 127 的投影值 ⇒ 乘回 127 取整。⛔ 不再写死
            // 字面量 `"100"`（那会让每一根柱都自称 100，与画面互相矛盾）。
            accessible-value: "" + Math.round(velocity_reading * 127);
        }
    }

    // ---------------------------------------------------------------- 走带光标 [UI-MCP-002]
    // x = 56px（卷帘时间轴左沿）+ Tokens.space-5（音符 / 网格同款 12px 起点内缩）
    // + tick ÷ ticks_per_pixel − 滚动偏移：保证 tick 0 与第 1 小节线、start_tick=0 音符
    // 左沿逐像素对齐；同时外层按 [56px, parent.width) `clip: true` 裁剪，横向滚动时绝不向左
    // 越界盖住琴键列。`playhead-ticks` 唯一写者 = `host::apply_transport`。
    Rectangle {
        x: 56px;
        y: 28px;
        width: parent.width - 56px;
        height: parent.height - 28px;
        clip: true;

        Rectangle {
            x: Tokens.space-5 + (root.playhead-ticks / max(1, root.ticks-per-pixel)) * 1px
                - (root.scroll-x * 1px);
            y: 0px;
            width: 1px;
            height: parent.height;
            // 播放头颜色（七版，Wang 2026-11-17 15:49）：与编曲区播放头
            // 统一改纯白 Tokens.skin-text-strong——播放头是视觉中心，对卷帘最深行底
            // Tokens.bg-panel-alt（黑键行）实算 17.23:1（编曲区同量级 17.87:1）。
            // 只改本落点，⛔ 不动 Tokens.gold-bright 本体（时间码/读数
            // 仍用它）。本线无标尺带内段与顶部标记，只有这一根竖线。
            background: Tokens.skin-text-strong;
            accessible-role: slider;
            accessible-id: "piano-roll-playhead";
            accessible-label: @tr("卷帘走带光标");
            accessible-value: root.playhead-timecode;
        }
    }

    // 覆盖泳道的输入面：按住并水平拖动 ⇒ 报告水平增量（向右拖 ⇒ 内容左移 ⇒ 偏移增加）。
    property <length> drag-last-x: 0px;
    property <bool> dragging: false;
    // `[UI-NOTE-003]` 手势分类的四个**界面本地**读数（都不进模型）：
    //   `drag-origin-*` = 按下时的指针位置（绘制帧）；
    //   `drag-moved`    = 位移是否越过了规范的 **4px** 阈值（越过 = 拖拽，没越过 = 单击）；
    //   `note-dragging` = 宿主已**接管**这一拖（选择工具 + 按在音符上）。
    property <length> drag-origin-x: 0px;
    property <length> drag-origin-y: 0px;
    property <bool> drag-moved: false;
    property <bool> note-dragging: false;
    // ⭐ 右键菜单的弹出位置（卷帘局部坐标，右键按下那一刻写；菜单宽 150px、高 64px，
    // 贴边时向内收 —— 菜单不得被窗口边缘裁掉）。
    property <length> context-menu-x: 0px;
    property <length> context-menu-y: 0px;
    TouchArea {
        // `[UI-TEST-001]` §12.2 稳定语义元素寻址：拖动滚动手势面必须有 `accessible-id`
        // （与 `ui/` 下其它关键节点同一族），否则无头注入只能靠像素坐标 —— 那正是被禁的做法。
        accessible-role: region;
        accessible-id: "piano-roll-scroll-area";
        accessible-label: @tr("卷帘拖动手势面");
        scroll-event(event) => {
            root.roll-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
            accept
        }
        // 本版本 `PointerEvent` **没有** `delta-x`（编译期报 "Cannot access the field 'delta-x'"），
        // 本版本的 `PointerEvent` 也**没有** `position`，位置只能取 `TouchArea` 自己的 `mouse-x`。用 `last - now` 表示"向右拖 ⇒ 内容左移 ⇒ 偏移增加"。
        //
        // ⚠ 这里有一条**判定顺序**上的契约（本切片新增）：`up` **只在位移未越 4px 阈值时**
        // 才 fired 一次 `clicked`。在此之前 `up` 无条件 fired `clicked` ⇒ 用铅笔（或橡皮擦）
        // 在空白处滚动一下，松手处就会**插进一个音符** —— 滚动手势被当成了单击。
        pointer-event(event) => {
            if event.button == PointerEventButton.right {
                // ⭐ 右键：只开上下文菜单。`down` 记位置并 `show()`；`move` / `up` /
                // `cancel` 一律不滚动、不拖音符、不单击 —— 右键抬起要是落进下面
                // 的 `up` 支，会把一次右键误认成左键单击（铅笔会在松手处插音符）。
                if event.kind == PointerEventKind.down {
                    root.context-menu-x = self.mouse-x > root.width - 150px ? root.width - 150px : self.mouse-x;
                    root.context-menu-y = self.mouse-y > root.height - 64px ? root.height - 64px : self.mouse-y;
                    context-menu-popup.show();
                }
            } else if event.kind == PointerEventKind.down {
                if self.mouse-x < 56px && self.mouse-y >= 28px {
                    root.audition-active-row = Math.min(15, Math.max(0, Math.floor((self.mouse-y - 28px) / 14px)));
                    root.dragging = false;
                    root.note-dragging = false;
                    root.drag-moved = false;
                    root.piano-key-pressed(root.audition-active-row);
                } else {
                    root.drag-origin-x = self.mouse-x;
                    root.drag-origin-y = self.mouse-y;
                    root.drag-moved = false;
                    root.drag-last-x = self.mouse-x;
                    // 先问宿主"这一按是不是**移动音符**"（选择工具 + 命中音符）。
                    // 接管 ⇒ ⛔ 不滚动（两条手势通道互斥，⛔ 不双重处理）。
                    root.note-dragging = root.note-drag-grab(self.mouse-x, self.mouse-y);
                    root.dragging = !root.note-dragging;
                }
            } else if event.kind == PointerEventKind.up {
                if root.audition-active-row >= 0 {
                    let prev = root.audition-active-row;
                    root.audition-active-row = -1;
                    root.piano-key-released(prev);
                } else {
                    root.dragging = false;
                    if root.note-dragging {
                        root.note-dragging = false;
                        if root.drag-moved {
                            // 越了 4px ⇒ 这一抬是**拖拽**的收尾（提交恰好一个原子 Op）。
                            root.note-drag-release(self.mouse-x, self.mouse-y);
                        } else {
                            // 没越阈值 ⇒ 这一抬是一次**单击**（选择工具点音符 = 选中它）。
                            root.clicked(self.mouse-x, self.mouse-y);
                        }
                    } else if !root.drag-moved {
                        // 空白处：只有**没越阈值**的抬起才算一次单击（选中 / 清除选区）。
                        root.clicked(self.mouse-x, self.mouse-y);
                    }
                    root.drag-moved = false;
                }
            } else if event.kind == PointerEventKind.move {
                if root.audition-active-row >= 0 {
                    // 琴键列滑动滑奏（glissando）：越过新琴键行时先释放前音再触发新音
                    if self.mouse-y >= 28px {
                        let hovered = Math.min(15, Math.max(0, Math.floor((self.mouse-y - 28px) / 14px)));
                        if hovered != root.audition-active-row {
                            let prev = root.audition-active-row;
                            root.piano-key-released(prev);
                            root.audition-active-row = hovered;
                            root.piano-key-pressed(root.audition-active-row);
                        }
                    }
                } else {
                    // 阈值判定用**两个方向各自比较**而不是 `abs(...)`：Slint 的 `length`
                    // 绝对值函数在这里没有必要，比较是纯量运算、无歧义。
                    if !root.drag-moved
                        && ((self.mouse-x - root.drag-origin-x) > 4px
                            || (root.drag-origin-x - self.mouse-x) > 4px
                            || (self.mouse-y - root.drag-origin-y) > 4px
                            || (root.drag-origin-y - self.mouse-y) > 4px) {
                        root.drag-moved = true;
                    }
                    if root.note-dragging {
                        // 拖拽臂：越阈值之后才更新草稿（小抖动不改草稿）。
                        if root.drag-moved {
                            root.note-drag-move(self.mouse-x, self.mouse-y);
                        }
                    } else if root.dragging {
                        root.scroll-requested(root.drag-last-x - self.mouse-x);
                        root.drag-last-x = self.mouse-x;
                    }
                }
            } else {
                // `cancel`（指针离开窗口 / 控件被禁用）：与 `up` 一样是收尾，
                // 但这一拖**不算数** ⇒ 丢弃草稿、⛔ 不提交。
                if root.audition-active-row >= 0 {
                    let prev = root.audition-active-row;
                    root.audition-active-row = -1;
                    root.piano-key-released(prev);
                }
                root.dragging = false;
                root.drag-moved = false;
                if root.note-dragging {
                    root.note-dragging = false;
                    root.note-drag-cancel();
                }
            }
        }
        // `[UI-NOTE-003]` 力度工具的**双击**：Slint 在**第二次**抬起时触发它
        // （`i-slint-core-1.18.1/items/input_items.rs`：`click_count % 2 == 1`；`check_repeat`
        // 只在**两次按下**间隔 < `click_interval` 且位移 < 10 逻辑像素时递增 `click_count`），
        // 且它在 `clicked` **之后**触发。落点与上面 `pointer-event` 里的
        // `root.clicked(...)` 逐字同一帧（同一个 `self.mouse-x/y`）—— 界面只报坐标，
        // 工具门 / 命中 / 提交全在宿主派发器里。
        double-clicked => {
            root.double-clicked(self.mouse-x, self.mouse-y);
        }
    }

    // ⭐ 右键上下文菜单（`PopupWindow`，Slint 1.18 原生弹出层，与 std `ComboBox`
    // 的下拉同款）：默认不显示、不占命中、不进默认帧；`show()` 时落在
    // `context-menu-x/y`（卷帘局部坐标）；点项外任意处自动关（`close-on-click-outside`）。
    // 菜单项在弹出层**内**调外部回调（`root.humanize-requested()`）是允许的方向
    // （禁的是反向：外部访问弹出层内的元素）；点中后显式 `close()` 再上抛。
    context-menu-popup := PopupWindow {
        x: root.context-menu-x;
        y: root.context-menu-y;
        width: 150px;
        height: 64px;
        close-policy: close-on-click-outside;

        Rectangle {
            // 二期质感: 右键菜单走 §10 面板刷 (flat 走色值支, 同根底注)。
            background: Tokens.texture-physical ? Tokens.panel-brush : Tokens.bg-panel;
            border-width: 1px;
            border-color: Tokens.gold-deep;
            border-radius: Tokens.radius-sm;
            clip: true;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 32px;
                accessible-role: button;
                accessible-id: "piano-roll-context-menu-humanize";
                accessible-label: @tr("人性化…");
                accessible-action-default => {
                    root.humanize-requested();
                    context-menu-popup.close();
                }

                UiText {
                    x: 8px;
                    y: 0;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: @tr("人性化…");
                    color: Tokens.ink-1;
                    font-size: Tokens.font-size-xs;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        root.humanize-requested();
                        context-menu-popup.close();
                    }
                }
            }

            Rectangle {
                x: 0;
                y: 32px;
                width: parent.width;
                height: 32px;
                accessible-role: button;
                accessible-id: "piano-roll-context-menu-quantize";
                accessible-label: @tr("量化…");
                accessible-action-default => {
                    root.quantize-requested();
                    context-menu-popup.close();
                }

                UiText {
                    x: 8px;
                    y: 0;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: @tr("量化…");
                    color: Tokens.ink-1;
                    font-size: Tokens.font-size-xs;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        root.quantize-requested();
                        context-menu-popup.close();
                    }
                }
            }
        }
    }
}
