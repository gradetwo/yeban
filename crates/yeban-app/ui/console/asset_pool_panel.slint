// 夜半 (Yeban) — 素材池面板（任务单 `#133`：让 `clip_pool` 在界面里可见）
//
// 规范来源 (Normative):
//   - [UI-TEST-001] §12.2: 关键节点必须有稳定的 `accessible-id`；本面板的语义 ID 由
//     `src/elements.rs` 的注册表与运行时控件树两侧对账。
//   - [UI-MCP-003]: 5 张 Linux 基准只覆盖**默认帧**（控制台 Tab 0 = 钢琴卷帘）。
//     本面板住在 `MixerConsole`（Tab 1）里 ⇒ 默认帧**一个像素都不画**，基准不需要重录。
//
// 数据流方向（与 `mixer_console.slint` 的 `track-*` 数组同一条纪律）:
//   三个 `in` 数组由 `src/host.rs` 的 `apply_view` 单向注入，**唯一**事实源是
//   `src/bridge.rs` 的 `ViewState::asset_pool`（`clip_pool` 的投影）。本文件不读盘、
//   ⛔ 不造字节数、⛔ 不判断空态以外的任何业务条件。
//
// 为什么是三个平行数组而不是一个富对象数组: 与本仓既有投影面（`track-*` / `clip-*` /
//   `note-*`）同形 —— 每个显示字段一个数组，**同一索引集**，`.slint` 只按下标取。

import { Tokens, UiMediumText, UiText } from "../tokens.slint";

export component AssetPoolPanel inherits Rectangle {
    // 每一行的显示名 / 类型 / 可用字段（投影给出，同索引集）。
    in property <[string]> asset-pool-names: [];
    in property <[string]> asset-pool-kinds: [];
    in property <[string]> asset-pool-details: [];

    // ⭐ **导入音频**（本线补的那一格）：运行期把一份 WAV 作为片段导入当前工程。
    //
    // `.slint` 只报"用户按了导入"：路径来自宿主的 `FilePicker`（⛔ 界面不读盘、
    // ⛔ 不猜路径、⛔ 不判断成功与否）。落点 = `host::wire_import_audio`：
    // 问一次对话框 ⇒ `crate::import_audio::import_audio_file`（经 `UndoPort`，
    // 来源 `OpOrigin::Import`，可撤销）＋ 资产字节登记进会话池 ⇒ 重投影
    // ⇒ 回执走**既有**的 `module-status` 通道。
    //
    // 座位：标题行右侧、条目数同一行（面板宽 216，条目数让出 64px）—— 不新增一行，
    // 因此空池/行循环的既有几何一位不动。面板住在控制台 Tab 1 ⇒ 默认帧不画它。
    callback import-audio();

    background: Tokens.bg-panel;
    border-radius: Tokens.radius-md;
    border-width: 1px;
    border-color: Tokens.line;
    clip: true;

    accessible-role: region;
    accessible-id: "asset-pool-panel";
    accessible-label: "素材池";

    // ---------------------------------------------------------------- 标题
    UiMediumText {
        x: Tokens.space-3;
        y: Tokens.space-2;
        width: parent.width - 12px;
        height: 18px;
        text: "素材池";
        color: Tokens.ink-0;
        font-size: Tokens.font-size-sm;
        overflow: elide;
    }

    // ---------------------------------------------------------------- 条目数
    // 读数是**投影的行数**（`asset-pool-names.length`），不是界面自己数的。
    Rectangle {
        x: Tokens.space-3;
        y: 22px;
        width: parent.width - 12px - 64px;
        height: 16px;
        accessible-role: text;
        accessible-id: "asset-pool-count";
        accessible-label: "素材 " + root.asset-pool-names.length + " 条";

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "素材 " + root.asset-pool-names.length + " 条";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }
    }

    // ---------------------------------------------------------------- 导入音频
    // 只报"按了"（见上面的 `import-audio` 声明）；几何与条目数同一行、互不相交
    // （`tests/pane_no_overlap.rs` 的素材池段会逐对断言）。
    Rectangle {
        x: parent.width - 12px - 56px;
        y: 20px;
        width: 56px;
        height: 20px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-sm;
        accessible-role: button;
        accessible-id: "asset-pool-import-button";
        accessible-label: "导入音频（用文件对话框挑一个 WAV 并作为片段导入）";
        accessible-action-default => { root.import-audio(); }

        UiText {
            x: 4px;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: "导入音频";
            color: Tokens.ink-1;
            font-size: Tokens.font-size-xs;
            overflow: elide;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.import-audio(); }
        }
    }

    // ---------------------------------------------------------------- 空态
    // 0 条素材 = 合法的工程状态（`#132` 之后新建工程就是这一档）⇒ 明确文案，
    // ⛔ 不留一片空白。它与下面的行循环由**同一份**长度互斥。
    Rectangle {
        x: Tokens.space-3;
        y: 44px;
        width: parent.width - 12px;
        height: 18px;
        visible: root.asset-pool-names.length == 0;
        accessible-role: text;
        accessible-id: "asset-pool-empty";
        accessible-label: "尚无素材";

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "尚无素材";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }
    }

    // ---------------------------------------------------------------- 每条一行
    // 行数**由投影决定**（`for … in root.asset-pool-names`），⛔ 不是写死的条数。
    // 名字一行、类型 + 可用字段一行（面板窄，两行比省略号更容易读到字节数）。
    for asset_name[row_index] in root.asset-pool-names : Rectangle {
        x: Tokens.space-3;
        y: 44px + 32px * row_index;
        width: parent.width - 12px;
        height: 30px;
        accessible-role: list-item;
        accessible-id: "asset-pool-row-" + row_index + "-row";
        accessible-label: asset_name + " · " + root.asset-pool-kinds[row_index] + " · " + root.asset-pool-details[row_index];

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: 16px;
            text: asset_name;
            color: Tokens.ink-0;
            font-size: Tokens.font-size-xs;
            overflow: elide;
        }

        UiText {
            x: 0;
            y: 15px;
            width: parent.width;
            height: 15px;
            text: root.asset-pool-kinds[row_index] + " · " + root.asset-pool-details[row_index];
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            overflow: elide;
        }
    }
}
