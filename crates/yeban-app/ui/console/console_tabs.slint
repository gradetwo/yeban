// 夜半 (Yeban) — 底部控制台 Tab 导轨 (底部控制台占弹性区 35–45%)
//
// 规范来源 (Normative):
//   - [UI-GRID-001] UI/UX 规范 §1.1: BOTTOM CONSOLE (动态伸缩, 占比 35% - 45%) ——
//     [Tab 1: 虚拟化钢琴卷帘] [Tab 2: 调音台总控] [Tab 3: 设备效果链]
//   - [UI-TEST-001] §12.2: **控制台标签**的语义 ID 约定是 `tab-{tab_name}-button`。
//     这个族由元素注册表判据强制覆盖 (src/elements.rs 的
//     `console_tab_buttons_cover_every_declared_tab`), 所以新增标签必须同时改
//     `root.tab-names`, 否则测试变红。
//
// 数据流方向: `active-tab` 是 in (只读); 点击只发回调, 由 MainWindow 决定新值。

import { Tokens, UiText } from "../tokens.slint";
import { PianoRoll } from "piano_roll.slint";
import { MixerConsole } from "mixer_console.slint";
import { DeviceRack } from "device_rack.slint";

export component ConsoleTabs inherits Rectangle {
    in property <int> active-tab: 0;
    // tab_name 就是语义 ID 里的 {tab_name}, 只允许小写与连字符
    in property <[string]> tab-names: ["piano-roll", "mixer", "devices"];
    in property <[string]> tab-labels: ["钢琴卷帘", "调音台", "设备效果链"];
    // 卷帘的音符身份 / 力度 / 位置 —— 由 MainWindow 从投影透传（本组件不解释它们）。
    // `note-positions` / `note-ys` / `note-widths` 都是投影算好的逻辑像素：
    // x 由 `start_tick` 整数除 `ticks_per_pixel` 得出，y 由 `pitch` 的车道索引给出。
    in property <[string]> note-ulids: [];
    in property <[float]> note-velocities: [];
    in property <[length]> note-positions: [];
    // ---- 走带光标（[UI-NOTE-001]）：只透传，位置事实源 = 宿主（`host::apply_transport`）----
    in property <int> playhead-ticks: 0;
    in property <int> ticks-per-pixel: 30;
    in property <float> scroll-x: 0.0;
    in property <string> playhead-timecode: "";
    // 与注入数组同一索引集的选中标志（只**透传**）。
    in property <[bool]> note-selected: [];
    // `[UI-NOTE-003]` 当前工具（与卷帘同一份状态；宿主需要读它来知道该执行哪个工具的语义）。
    in-out property <int> active-tool: 1;
    // ⭐ 任务单 `#166`：卷帘的拒绝文本（**只透传**；唯一写者 = `host::install_roll_click`）。
    in property <string> roll-edit-status: "";
    // 透传卷帘的滚动手势。
    callback scroll-requested(length);
    callback clicked(length, length);
    // `[UI-NOTE-003]` §3.3 aux 列的**双击**透传（力度工具 = 恢复默认力度 100）。
    // 与 `clicked` 逐字同款：本组件只透传坐标，工具门 / 命中 / 提交全在宿主派发器里。
    callback double-clicked(length, length);
    // `[UI-NOTE-003]` 工具矩阵的点击透传（工具行号 1..5）。本组件不解释它，也不改
    // `active-tool`（那是 MainWindow 的宿主侧唯一落点）。
    callback tool-selected(int);
    // `[UI-NOTE-003]` 卷帘左键**拖拽**（移动臂）的四条手势回调 + 三个草稿读数：本组件**只透传**
    // （工具门 / 命中 / 草稿算术 / 提交全在 `host::install_roll_note_drag`）。
    callback note-drag-grab(length, length) -> bool;
    callback note-drag-move(length, length);
    callback note-drag-release(length, length);
    callback note-drag-cancel();
    in property <string> note-drag-ulid: "";
    in property <float> note-drag-preview-dx: 0.0;
    in property <float> note-drag-preview-dy: 0.0;
    // `[UI-NOTE-003]` 力度臂的草稿预览 + 车道顶沿上报：本组件**只透传**（同 `note-drag-*`）。
    in property <float> note-drag-preview-velocity: 0.0;
    out property <length> velocity-lane-top: piano-roll.velocity-lane-top;
    in property <[length]> note-ys: [];
    in property <[length]> note-widths: [];
    // 调音台通道条（Tab 2）的**透传**属性 —— 本组件不解释它们：
    // 投影字段（名字/音量/声相/静音/独奏/色标）与引擎电平（dBFS 文本 + 柱高）
    // 都由 `src/host.rs` 单向注入，`MixerConsole` 只按下标取。
    in property <[string]> track-names: [];
    in property <[string]> track-volumes: [];
    in property <[float]> track-volume-fractions: [];
    in property <[string]> track-pans: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];
    // ⭐ SFZ 采样器路径（`TrackV3::sampler` 的路径原文；`None` ⇒ `""`）——
    // 与上面两格同一条透传纪律：本组件不解释它。
    in property <[string]> track-sampler-paths: [];
    in property <[color]> track-colors: [];
    in property <[string]> track-color-labels: [];
    // ⭐ 素材池（任务单 `#133`）：`clip_pool` 投影的三个平行数组 —— 本组件只透传给
    // `MixerConsole`（Tab 1 的 `AssetPoolPanel`），⛔ 不解释、不筛选、不计数。
    in property <[string]> asset-pool-names: [];
    in property <[string]> asset-pool-kinds: [];
    in property <[string]> asset-pool-details: [];
    // ⭐ 设备效果链（任务单 `#157`）：`TrackV3::devices` 的逐条投影 ＋ 那一格 `eq_low_gain`。
    // 与上面三格同一条透传纪律 —— 本组件不解释、不筛选、⛔ 不持有第二份列表。
    in property <string> device-track-label: "";
    in property <[string]> device-names: [];
    // ⭐ 设备增删（任务单 `#163`）：每台的**设备身份**（删除按钮的寻址单位）。
    in property <[string]> device-ids: [];
    in property <[bool]> device-bypassed: [];
    in property <[string]> device-recognised: [];
    in property <[string]> device-unrecognised: [];
    in property <bool> device-eq-available: false;
    in property <float> device-eq-gain-db: 0.0;
    in property <float> device-eq-min-db: 0.0;
    in property <float> device-eq-max-db: 0.0;
    // ⭐ 任务单 `#182`：EQ 手势的**设备身份**（⛔ 不是下标）—— 只透传。
    in property <string> device-eq-device-id: "";
    // ⭐ 设备增删 ＋ 建空片段（任务单 `#163`）：两个按钮共用"装设备"的可用性，
    // 建片段有自己的一格。四格都是**投影标量**，本组件只透传。
    in property <bool> device-insert-available: false;
    in property <string> device-insert-reason: "";
    in property <bool> clip-create-available: false;
    in property <string> clip-create-reason: "";
    // ⭐ 主总线设备链（任务单 `#180`）：四个平行数组 ＋ 三个标量。同样只透传投影 ——
    // 本组件不解释、⛔ 不持有第二份主总线设备列表、⛔ 不自己算"能不能装"。
    in property <string> master-device-label: "";
    in property <[string]> master-device-names: [];
    in property <[string]> master-device-ids: [];
    in property <[string]> master-device-recognised: [];
    in property <[string]> master-device-unrecognised: [];
    in property <bool> master-device-insert-available: false;
    in property <string> master-device-insert-reason: "";
    // ⭐ 主总线设备的旁通 ＋ EQ（任务单 `#181`）：逐台旁通位 ＋ 那一格 EQ 的五个标量。
    // 同样只透传投影 —— 本组件不解释、⛔ 不持有第二份设备列表 / 值域。
    in property <[bool]> master-device-bypassed: [];
    in property <bool> master-device-eq-available: false;
    in property <float> master-device-eq-gain-db: 0.0;
    in property <float> master-device-eq-min-db: 0.0;
    in property <float> master-device-eq-max-db: 0.0;
    in property <string> master-device-eq-reason: "";
    // ⭐ 任务单 `#182`：主总线 EQ 手势的**设备身份**（⛔ 不是下标）—— 只透传。
    in property <string> master-device-eq-device-id: "";
    // ⭐ 一键装乐器（任务单 `#164`）：当前乐器 ＋ 按钮名清单 ＋ 可用性 / 逐字原因。
    // 同样只透传投影 —— 本组件不解释、⛔ 不持有第二份路径表。
    in property <string> instrument-label: "未装乐器";
    in property <[string]> instrument-names: [];
    in property <bool> instrument-install-available: false;
    in property <string> instrument-install-reason: "";
    /// ⭐ 任务单 `#211`：点击之后的运行期回执（非投影，宿主写；初始空串）。
    in property <string> instrument-install-status: "";
    // ⭐ 采样库（任务单 `#196`）：投影的四个标量 ＋ 运行期下载状态，原样透传。
    in property <bool> sample-library-installed: false;
    in property <string> sample-library-notice: "";
    in property <bool> sample-library-download-visible: false;
    in property <string> sample-library-root: "";
    in property <string> sample-library-status: "";
    // ⭐ 发送条（任务单 `#159`）：展示轨的 `SendToAux` 边逐条投影 ＋ "新建发送"的可用性。
    // 与上面四格同一条透传纪律 —— 本组件不解释、不筛选、⛔ 不持有第二份列表 / 值域。
    in property <[string]> send-edge-ids: [];
    in property <[string]> send-destination-names: [];
    in property <[string]> send-gain-labels: [];
    in property <[float]> send-gain-dbs: [];
    in property <float> send-gain-min-db: 0.0;
    in property <float> send-gain-max-db: 0.0;
    in property <bool> send-create-available: false;
    in property <string> send-create-reason: "";
    // ⭐ 宏面板：展示轨的宏逐条投影，只透传给 `DeviceRack`（画「宏 (N)」按钮的条数）。
    // 面板本体住在 `MainWindow`（`dialogs/macro_panel.slint`），本组件没有抽屉。
    in property <[string]> macro-names: [];
    in property <[float]> macro-values: [];
    in property <[string]> macro-value-labels: [];
    // ⭐ 轨 / 路由（任务单 `#160`）：轨数读数 ＋ 建轨 / 删展示轨的可用性与逐字原因。
    // 与上面发送那几格同一条透传纪律 —— 本组件不解释、⛔ 不自己算"能不能建/删"。
    in property <string> routing-count-label: "";
    in property <bool> routing-create-available: false;
    in property <string> routing-master-label: "";
    in property <bool> routing-delete-available: false;
    in property <string> routing-delete-reason: "";
    in property <[string]> track-meter-peaks: [];
    in property <[string]> track-meter-rmss: [];
    in property <[float]> track-meter-levels: [];
    in property <string> master-name: "Master";
    in property <string> master-volume-display: "";
    in property <float> master-volume-fraction: 0.0;
    in property <string> master-pan: "C";
    in property <bool> master-mute: false;
    in property <bool> master-solo: false;
    in property <color> master-color: #2c3a63;
    in property <string> master-color-label: "";
    in property <string> master-meter-peak: "-120.0";
    in property <string> master-meter-rms: "-120.0";
    in property <float> master-meter-level: 0.0;
    // ⭐ 控制台最大化（`Cmd/Ctrl+Alt+M` / 右上角 ⤢）：只读绑定，唯一写者 = 宿主
    // （`MainWindow.console-maximized`）—— 本组件用它给按钮报 `accessible-checked`。
    in property <bool> console-maximized: false;

    callback select-piano-roll();
    callback select-mixer();
    callback select-devices();
    // 混音台（Tab 2）的**写入面**透传 —— 本组件不解释它们，只把 `MixerConsole` 的
    // 手势 / 点击原样转给 `MainWindow`（宿主侧唯一实现是 `host::wire_mixer_edit`）。
    callback mixer-fader-grab(int, length);
    callback mixer-fader-drag(int, length);
    callback mixer-fader-release(int);
    callback mixer-pan-grab(int, length);
    callback mixer-pan-drag(int, length);
    callback mixer-pan-release(int);
    // ⭐ **双击复位**（推子 → `0 dB`、声相 → 中央）：与上面六条手势同族、同一条纪律 ——
    // 本组件只上抛，⛔ 换算、⛔ 提交（落点 `host::wire_mixer_edit` 的 `on_*_reset`）。
    callback mixer-fader-reset(int);
    callback mixer-pan-reset(int);
    callback mixer-mute-toggle(int);
    callback mixer-solo-toggle(int);
    // ⭐ 主控通道条的静音 / 独奏：与上面两个同款只上抛（宿主 `host::wire_mixer_edit`
    // 按主总线身份提交，⛔ 界面不解析、不提交、不改任何工程值）。
    callback mixer-master-mute-toggle();
    callback mixer-master-solo-toggle();
    // ⭐ SFZ 采样器绑定的写入面（任务单 `#82`）：SET（设成 `Some(path)`）/ CLR（解绑 `None`）。
    // 与上面八个同款 —— 本组件只上抛，不解释、不改任何值，也没有第二份提交实现。
    callback mixer-sampler-set(int, string);
    callback mixer-sampler-clear(int);
    // ⭐ **③ 浏览…**（任务单 `#86` 乙）：与上面两条**不同** —— 它⛔ 不提交工程内容，
    // 只请求宿主"问一次原生对话框、把选中的路径填进输入框"。同样只上抛。
    callback mixer-sampler-browse(int);
    // ⭐ **设备效果链的写入面**（任务单 `#157`）：控制台 **Tab 3** 的两个手势，本组件
    // 只把 `DeviceRack` 的回调**原样上抛**给 `MainWindow`（宿主侧唯一实现是
    // `host::wire_device_rack`）—— ⛔ 不解释、⛔ 不提交、⛔ 不改任何工程值。
    // ⭐ `#182`：旁通 / EQ 按下携带**设备身份**，⛔ 不是下标。
    callback device-bypass-toggle(string);
    callback device-eq-grab(string, float);
    callback device-eq-drag(float);
    callback device-eq-release();
    // ⭐ **设备增删 ＋ 建空片段**（任务单 `#163`）：同样只上抛 —— 唯一实现是
    // `host::wire_device_rack`（装 / 删）与 `host::wire_clip_create`（建片段）。
    callback device-insert-eq();
    callback device-insert-reverb();
    callback device-remove(string);
    callback clip-create();
    // ⭐ **主总线设备增删**（任务单 `#180`）：同样只上抛 —— 唯一实现是
    // `host::wire_device_rack`（与展示轨那两个手势**同一份**实现体，目标轨不同）。
    callback master-device-insert-eq();
    callback master-device-insert-reverb();
    callback master-device-remove(string);
    // ⭐ **主总线设备的旁通 ＋ EQ**（任务单 `#181` / `#182`）：同样只上抛 —— 唯一实现是
    // `host::wire_device_rack`（与展示轨那两条手势**同一份**实现体，`DeviceTarget` 不同）。
    callback master-device-bypass-toggle(string);
    callback master-device-eq-grab(string, float);
    callback master-device-eq-drag(float);
    callback master-device-eq-release();
    // ⭐ 一键装乐器（任务单 `#164`）：只上报内置清单下标，路径 / Op / 提交在宿主。
    callback instrument-install(int);
    // ⭐ 下载采样库（任务单 `#196`）：只上抛，落点 `host::wire_device_rack`。
    callback sample-library-download();
    callback sample-library-download-drain-requested();
    // ⭐ **发送条的写入面**（任务单 `#159`）：控制台 **Tab 3** 的两个手势，本组件只把
    // `DeviceRack` 的回调**原样上抛**给 `MainWindow`（宿主侧唯一实现是
    // `host::wire_send_strip`）—— ⛔ 不解释、⛔ 不提交、⛔ 不改任何工程值。
    callback send-gain-grab(string, float);
    callback send-gain-drag(string, float);
    callback send-gain-release(string);
    callback send-create();
    // ⭐ **轨 / 路由的写入面**（任务单 `#160`）：控制台 **Tab 3** 的同一面板里，
    // 三个建轨按钮 ＋ 删除展示轨 ＋ 每条发送的删除按钮。本组件只把 `DeviceRack` 的
    // 回调**原样上抛**给 `MainWindow`（宿主侧唯一实现是 `host::wire_track_strip` /
    // `host::wire_send_strip`）—— ⛔ 不解释、⛔ 不提交、⛔ 不改任何工程值。
    callback send-remove(string);
    callback track-create-midi();
    callback track-create-audio();
    callback track-create-aux();
    callback track-delete();
    // ⭐ 打开宏面板（右侧抽屉住在 `MainWindow`）：只上抛，不解释、不持有开关状态。
    callback open-macro-panel();
    // ⭐ **导出 MIDI**（任务单 `#90` 甲）：混音台（Tab 1）里的**控制台级**动作。
    // 与上面那一族同款 —— 本组件只上抛，⛔ 不写盘、⛔ 不判断成功与否。
    callback export-midi();
    // ⭐ **打开工程**（任务单 `#93`）：混音台（Tab 1）里的**控制台级**动作 ——
    // **运行期换工程**的可见入口（本单补的那一格）。与上面那一族同款：本组件只上抛，
    // ⛔ 不读盘、⛔ 不弹窗、⛔ 不判断成功与否；唯一落点是宿主 `host::wire_open_project`。
    callback open-project();
    // ⭐ **新建工程**（任务单 `#129`）：混音台（Tab 1）里「打开工程」**正下方**的那一格。
    // 同样只上抛：⛔ 不写盘、⛔ 不弹窗、⛔ 不判断成功与否；唯一落点 = 宿主
    // `host::wire_new_project`（保存对话框 ⇒ 落一个 0 轨容器 ⇒ 打开那条换工程路径）。
    callback new-project();
    // ⭐ **导入音频**：混音台（Tab 1）素材池面板里的可见入口。本组件只上抛
    // （宿主 `host::wire_import_audio` 是唯一落点）—— ⛔ 不读盘、⛔ 不弹窗、
    // ⛔ 不判断成功与否。
    callback import-audio();
    // ⭐ **最大化 / 还原底部控制台**（`Cmd/Ctrl+Alt+M` 的可点等价物）。
    // 与 `Action::ToggleConsoleMaximize` 落到**同一个**视图态属性
    // （`MainWindow.console-maximized`，唯一写者是宿主）⇒ 按键与点击不可能分叉。
    // 本组件只上抛：⛔ 不自己翻转状态、⛔ 不动布局（布局绑定读的是那个属性）。
    callback console-maximize-toggle();
    // 主控通道条的**写入面**透传（与上面那一族同款：本组件只上抛，不解释、不改任何值）。
    // 这一族**不带下标** —— 主总线不在 `track-names` 里，它的身份由宿主从权威工程取。
    callback mixer-master-fader-grab(length);
    callback mixer-master-fader-drag(length);
    callback mixer-master-fader-release();
    callback mixer-master-pan-grab(length);
    callback mixer-master-pan-drag(length);
    callback mixer-master-pan-release();
    // ⭐ 主控的**双击复位**（推子 → `0 dB`、声相 → 中央）：同样只上抛。
    callback mixer-master-fader-reset();
    callback mixer-master-pan-reset();

    min-height: 32px;
    background: Tokens.bg-panel;
    border-width: 1px;
    border-color: Tokens.line;
    clip: true;

    accessible-role: tab-list;
    accessible-id: "console-tab-rail";
    accessible-label: "底部控制台标签导轨";

    // ---------------------------------------------------------------- Tab 导轨
    for tab_index in 3 : Rectangle {
        x: Tokens.space-4 + 112px * tab_index;
        y: Tokens.space-2;
        width: 104px;
        height: 20px;
        background: root.active-tab == tab_index ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: tab;
        accessible-id: "tab-" + root.tab-names[tab_index] + "-button";
        accessible-label: root.tab-labels[tab_index];
        accessible-item-index: tab_index;
        accessible-item-count: 3;
        accessible-item-selectable: true;
        accessible-item-selected: root.active-tab == tab_index;
        // `[UI-A11Y-003]` §7.3：无障碍动作。落点与下面 `TouchArea` 的 `clicked`
        // **逐字同一段**（同一条 `if / else if / else`）—— 因此"屏读器选中这一页"
        // 与"鼠标点这一页"不可能分叉。
        accessible-action-default => {
            if tab_index == 0 {
                root.select-piano-roll();
            } else if tab_index == 1 {
                root.select-mixer();
            } else {
                root.select-devices();
            }
        }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.tab-labels[tab_index];
            color: root.active-tab == tab_index ? Tokens.selection : Tokens.ink-2;
            font-size: Tokens.font-size-sm;
            // 负责人 mock 的 `.etab{letter-spacing:2px}` 是 12.5px 下的取值; 这里 11px
            // 是同一档字号 scale 的下一级, 按比例取 `tracking-wide` (1px) —— 中文标签
            // 加 2px 字距在 11px 下会散架。
            letter-spacing: Tokens.tracking-wide;
            horizontal-alignment: center;
            overflow: elide;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                if tab_index == 0 {
                    root.select-piano-roll();
                } else if tab_index == 1 {
                    root.select-mixer();
                } else {
                    root.select-devices();
                }
            }
        }
    }

    // 最大化 / 还原底部控制台 [UI-A11Y-001] Cmd/Ctrl + Alt + M 的可点等价物
    Rectangle {
        x: root.width - 28px;
        y: Tokens.space-2;
        width: 20px;
        height: 20px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-sm;
        accessible-role: button;
        accessible-id: "console-maximize-button";
        accessible-label: "最大化 / 还原底部控制台";
        // 切换按钮：读数来自宿主的视图态（⛔ 不是本组件自己记的开关）。
        accessible-checked: root.console-maximized;
        // `[UI-A11Y-003]` §7.3：无障碍动作与下面 `TouchArea` 的 `clicked` **逐字同一落点**
        // （都是 `root.console-maximize-toggle()`）⇒ 屏读器激活与鼠标点击不可能分叉。
        accessible-action-default => { root.console-maximize-toggle(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "⤢";
            color: Tokens.ink-1;
            font-size: Tokens.font-size-sm;
            horizontal-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.console-maximize-toggle(); }
        }
    }

    // ---------------------------------------------------------------- Tab 内容
    // 三个页面同尺寸叠放, 靠 visible 切换 (父级不是布局, 所以隐藏不影响排版)。
    piano-roll := PianoRoll {
        x: 0;
        y: 28px;
        width: parent.width;
        height: root.height - 28px;
        visible: root.active-tab == 0;
        note-ulids: root.note-ulids;
        velocities: root.note-velocities;
        note-positions: root.note-positions;
        note-selected: root.note-selected;
        playhead-ticks: root.playhead-ticks;
        ticks-per-pixel: root.ticks-per-pixel;
        scroll-x: root.scroll-x;
        playhead-timecode: root.playhead-timecode;
        active-tool: root.active-tool;
        edit-status: root.roll-edit-status;
        scroll-requested(d) => { root.scroll-requested(d); }
        clicked(x, y) => { root.clicked(x, y); }
        double-clicked(x, y) => { root.double-clicked(x, y); }
        tool-selected(tool) => { root.tool-selected(tool); }
        note-drag-grab(x, y) => { root.note-drag-grab(x, y); }
        note-drag-move(x, y) => { root.note-drag-move(x, y); }
        note-drag-release(x, y) => { root.note-drag-release(x, y); }
        note-drag-cancel() => { root.note-drag-cancel(); }
        note-drag-ulid: root.note-drag-ulid;
        note-drag-preview-dx: root.note-drag-preview-dx;
        note-drag-preview-dy: root.note-drag-preview-dy;
        note-drag-preview-velocity: root.note-drag-preview-velocity;
        note-ys: root.note-ys;
        note-widths: root.note-widths;
    }

    MixerConsole {
        x: 0;
        y: 28px;
        width: parent.width;
        height: root.height - 28px;
        visible: root.active-tab == 1;
        track-names: root.track-names;
        track-volumes: root.track-volumes;
        track-volume-fractions: root.track-volume-fractions;
        track-pans: root.track-pans;
        track-mutes: root.track-mutes;
        track-solos: root.track-solos;
        track-sampler-paths: root.track-sampler-paths;
        track-colors: root.track-colors;
        track-color-labels: root.track-color-labels;
        // ⭐ 素材池（`#133`）：同样只透传（`AssetPoolPanel` 住在 `MixerConsole` 里）。
        asset-pool-names: root.asset-pool-names;
        asset-pool-kinds: root.asset-pool-kinds;
        asset-pool-details: root.asset-pool-details;
        track-meter-peaks: root.track-meter-peaks;
        track-meter-rmss: root.track-meter-rmss;
        track-meter-levels: root.track-meter-levels;
        master-name: root.master-name;
        master-volume-display: root.master-volume-display;
        master-volume-fraction: root.master-volume-fraction;
        master-pan: root.master-pan;
        master-mute: root.master-mute;
        master-solo: root.master-solo;
        master-color: root.master-color;
        master-color-label: root.master-color-label;
        master-meter-peak: root.master-meter-peak;
        master-meter-rms: root.master-meter-rms;
        master-meter-level: root.master-meter-level;
        // 写入面：三个手势 + 两个开关，全部原样上抛（`MainWindow` 是唯一落点）。
        mixer-fader-grab(index, y) => {
            root.mixer-fader-grab(index, y);
        }
        mixer-fader-drag(index, y) => {
            root.mixer-fader-drag(index, y);
        }
        mixer-fader-release(index) => {
            root.mixer-fader-release(index);
        }
        mixer-pan-grab(index, x) => {
            root.mixer-pan-grab(index, x);
        }
        mixer-pan-drag(index, x) => {
            root.mixer-pan-drag(index, x);
        }
        mixer-pan-release(index) => {
            root.mixer-pan-release(index);
        }
        // **双击复位**：同样只上抛（宿主 `host::wire_mixer_edit` 的 `on_*_reset` 是唯一落点）。
        mixer-fader-reset(index) => {
            root.mixer-fader-reset(index);
        }
        mixer-pan-reset(index) => {
            root.mixer-pan-reset(index);
        }
        mixer-mute-toggle(index) => {
            root.mixer-mute-toggle(index);
        }
        mixer-solo-toggle(index) => {
            root.mixer-solo-toggle(index);
        }
        mixer-master-mute-toggle() => {
            root.mixer-master-mute-toggle();
        }
        mixer-master-solo-toggle() => {
            root.mixer-master-solo-toggle();
        }
        // SFZ 采样器绑定（任务单 `#82`）：同样只上抛（宿主 `host::wire_mixer_sampler` 是唯一落点）。
        mixer-sampler-set(index, path) => {
            root.mixer-sampler-set(index, path);
        }
        mixer-sampler-clear(index) => {
            root.mixer-sampler-clear(index);
        }
        // ⭐ **③ 浏览…**（任务单 `#86` 乙）：同样只上抛（宿主 `host::wire_mixer_sampler_browse`
        // 是唯一落点）—— ⛔ 它不提交任何工程内容，只填输入框。
        mixer-sampler-browse(index) => {
            root.mixer-sampler-browse(index);
        }
        // ⭐ **导出 MIDI**（任务单 `#90` 甲）：同样只上抛（宿主 `host::wire_module_actions`
        // 的 `export-midi` 分支是唯一落点）—— ⛔ 本组件不写盘、不判断成功与否。
        export-midi => {
            root.export-midi();
        }
        // ⭐ **打开工程**（任务单 `#93`）：同样只上抛（宿主 `host::wire_open_project`
        // 是唯一落点）—— ⛔ 本组件不读盘、不弹窗、不判断成功与否。
        open-project => {
            root.open-project();
        }
        // ⭐ **新建工程**（任务单 `#129`）：同样只上抛（宿主 `host::wire_new_project`
        // 是唯一落点）—— ⛔ 本组件不写盘、不弹窗、不判断成功与否。
        new-project => {
            root.new-project();
        }
        // ⭐ **导入音频**：同样只上抛（宿主 `host::wire_import_audio` 是唯一落点）。
        import-audio => {
            root.import-audio();
        }
        // 主控写入面：同样只上抛，**不带下标**（宿主在按下那一刻从权威工程取主总线身份）。
        mixer-master-fader-grab(y) => {
            root.mixer-master-fader-grab(y);
        }
        mixer-master-fader-drag(y) => {
            root.mixer-master-fader-drag(y);
        }
        mixer-master-fader-release() => {
            root.mixer-master-fader-release();
        }
        mixer-master-pan-grab(x) => {
            root.mixer-master-pan-grab(x);
        }
        mixer-master-pan-drag(x) => {
            root.mixer-master-pan-drag(x);
        }
        mixer-master-pan-release() => {
            root.mixer-master-pan-release();
        }
        // 主控的**双击复位**：同样只上抛、**不带下标**（身份由宿主从权威工程取）。
        mixer-master-fader-reset() => {
            root.mixer-master-fader-reset();
        }
        mixer-master-pan-reset() => {
            root.mixer-master-pan-reset();
        }
    }

    DeviceRack {
        x: 0;
        y: 28px;
        width: parent.width;
        height: root.height - 28px;
        visible: root.active-tab == 2;
        // ⭐ 设备链（任务单 `#157`）：只透传投影，本组件不解释。
        track-label: root.device-track-label;
        device-names: root.device-names;
        device-ids: root.device-ids;
        device-bypassed: root.device-bypassed;
        device-recognised: root.device-recognised;
        device-unrecognised: root.device-unrecognised;
        eq-available: root.device-eq-available;
        eq-gain-db: root.device-eq-gain-db;
        eq-min-db: root.device-eq-min-db;
        eq-max-db: root.device-eq-max-db;
        // ⭐ 任务单 `#182`：EQ 手势的**设备身份**（⛔ 不是下标）。
        eq-device-id: root.device-eq-device-id;
        // ⭐ 设备增删 ＋ 建空片段（任务单 `#163`）：只透传投影。
        device-insert-available: root.device-insert-available;
        device-insert-reason: root.device-insert-reason;
        clip-create-available: root.clip-create-available;
        clip-create-reason: root.clip-create-reason;
        // ⭐ 主总线设备链（任务单 `#180`）：只透传投影，本组件不解释。
        master-device-label: root.master-device-label;
        master-device-names: root.master-device-names;
        master-device-ids: root.master-device-ids;
        master-device-recognised: root.master-device-recognised;
        master-device-unrecognised: root.master-device-unrecognised;
        master-device-insert-available: root.master-device-insert-available;
        master-device-insert-reason: root.master-device-insert-reason;
        // ⭐ 主总线设备的旁通 ＋ EQ（任务单 `#181`）：只透传投影，本组件不解释。
        master-device-bypassed: root.master-device-bypassed;
        master-device-eq-available: root.master-device-eq-available;
        master-device-eq-gain-db: root.master-device-eq-gain-db;
        master-device-eq-min-db: root.master-device-eq-min-db;
        master-device-eq-max-db: root.master-device-eq-max-db;
        master-device-eq-reason: root.master-device-eq-reason;
        // ⭐ 任务单 `#182`：主总线 EQ 手势的**设备身份**（⛔ 不是下标）。
        master-device-eq-device-id: root.master-device-eq-device-id;
        // ⭐ 一键装乐器（任务单 `#164`）：只透传投影，本组件不解释。
        instrument-label: root.instrument-label;
        instrument-names: root.instrument-names;
        instrument-install-available: root.instrument-install-available;
        instrument-install-reason: root.instrument-install-reason;
        instrument-install-status: root.instrument-install-status;
        // ⭐ 采样库（任务单 `#196`）：只透传，本组件不解释。
        sample-library-installed: root.sample-library-installed;
        sample-library-notice: root.sample-library-notice;
        sample-library-download-visible: root.sample-library-download-visible;
        sample-library-root: root.sample-library-root;
        sample-library-status: root.sample-library-status;
        // ⭐ 发送条（任务单 `#159`）：同样只透传投影，本组件不解释。
        send-edge-ids: root.send-edge-ids;
        send-destination-names: root.send-destination-names;
        send-gain-labels: root.send-gain-labels;
        send-gain-dbs: root.send-gain-dbs;
        send-gain-min-db: root.send-gain-min-db;
        send-gain-max-db: root.send-gain-max-db;
        send-create-available: root.send-create-available;
        send-create-reason: root.send-create-reason;
        // ⭐ 轨 / 路由（任务单 `#160`）：同样只透传投影，本组件不解释。
        routing-count-label: root.routing-count-label;
        routing-create-available: root.routing-create-available;
        routing-master-label: root.routing-master-label;
        routing-delete-available: root.routing-delete-available;
        routing-delete-reason: root.routing-delete-reason;
        // ⭐ 宏面板：只透传投影（按钮条数以它为准）。
        macro-names: root.macro-names;
        macro-values: root.macro-values;
        macro-value-labels: root.macro-value-labels;
        // 写入面：两个手势原样上抛（唯一落点 `host::wire_device_rack`）。
        device-bypass-toggle(device-id) => {
            root.device-bypass-toggle(device-id);
        }
        device-eq-grab(device-id, fraction) => {
            root.device-eq-grab(device-id, fraction);
        }
        device-eq-drag(fraction) => {
            root.device-eq-drag(fraction);
        }
        device-eq-release() => {
            root.device-eq-release();
        }
        // ⭐ 设备增删 ＋ 建空片段（任务单 `#163`）：原样上抛。
        device-insert-eq() => {
            root.device-insert-eq();
        }
        device-insert-reverb() => {
            root.device-insert-reverb();
        }
        device-remove(device-id) => {
            root.device-remove(device-id);
        }
        clip-create() => {
            root.clip-create();
        }
        // ⭐ 主总线设备增删（任务单 `#180`）：原样上抛。
        master-device-insert-eq() => {
            root.master-device-insert-eq();
        }
        master-device-insert-reverb() => {
            root.master-device-insert-reverb();
        }
        master-device-remove(device-id) => {
            root.master-device-remove(device-id);
        }
        // ⭐ 主总线设备的旁通 ＋ EQ（任务单 `#181` / `#182`）：原样上抛（参数是设备身份）。
        master-device-bypass-toggle(device-id) => {
            root.master-device-bypass-toggle(device-id);
        }
        master-device-eq-grab(device-id, fraction) => {
            root.master-device-eq-grab(device-id, fraction);
        }
        master-device-eq-drag(fraction) => {
            root.master-device-eq-drag(fraction);
        }
        master-device-eq-release() => {
            root.master-device-eq-release();
        }
        // ⭐ 一键装乐器（任务单 `#164`）：只上报下标，原样上抛。
        instrument-install(index) => {
            root.instrument-install(index);
        }
        sample-library-download() => {
            root.sample-library-download();
        }
        sample-library-download-drain-requested() => {
            root.sample-library-download-drain-requested();
        }
        // ⭐ 发送条（任务单 `#159`）的写入面：三个滑块携带**路由边身份**（不是行下标）。
        send-gain-grab(edge-id, fraction) => {
            root.send-gain-grab(edge-id, fraction);
        }
        send-gain-drag(edge-id, fraction) => {
            root.send-gain-drag(edge-id, fraction);
        }
        send-gain-release(edge-id) => {
            root.send-gain-release(edge-id);
        }
        send-create() => {
            root.send-create();
        }
        // ⭐ 轨 / 路由（任务单 `#160`）：删除发送 ＋ 三个建轨按钮 ＋ 删除展示轨。
        send-remove(edge-id) => {
            root.send-remove(edge-id);
        }
        track-create-midi() => {
            root.track-create-midi();
        }
        track-create-audio() => {
            root.track-create-audio();
        }
        track-create-aux() => {
            root.track-create-aux();
        }
        track-delete() => {
            root.track-delete();
        }
        // ⭐ 宏入口：只上抛。
        open-macro-panel() => {
            root.open-macro-panel();
        }
    }
}
