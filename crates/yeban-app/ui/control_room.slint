import { Theme, Tokens } from "tokens.slint";

export component ControlRoomMeters inherits Rectangle {
    in-out property <string> lufs-integrated: "-9.4 LUFS";
    in-out property <string> lufs-short: "-8.8 LUFS";
    in-out property <string> lufs-peak: "-0.3 dBTP";
    in-out property <string> active-monitor: "main"; // "main" | "alt"
    in-out property <bool> is-dim: false;
    in-out property <bool> is-mono: false;
    in-out property <bool> is-side: false;
    in-out property <float> master-meter-l: 0.68;
    in-out property <float> master-meter-r: 0.64;

    callback switch-monitor(string);
    callback toggle-dim();
    callback toggle-mono();
    callback toggle-side();

    width: 192px;
    background: Theme.bg-panel;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: space-between;

        // Top Header
        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "🎚️ 监听室 (Control Room)";
                    font-family: Tokens.font-ui;
                    font-size: 11px;
                    font-weight: 700;
                    color: #f8fafc;
                    vertical-alignment: center;
                }
                Rectangle {
                    background: #10b98118;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: #10b98135;
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: "EBU R128";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            font-weight: 700;
                            color: #34d399;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Loudness Telemetry Card
            Rectangle {
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "INTEGRATED:";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.6px;
                            color: #64748b;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.lufs-integrated;
                            font-family: Tokens.font-mono;
                            font-size: 11px;
                            font-weight: 800;
                            color: #34d399;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "SHORT-TERM:";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.6px;
                            color: #64748b;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.lufs-short;
                            font-family: Tokens.font-mono;
                            font-size: 11px;
                            font-weight: 800;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "TRUE PEAK:";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.6px;
                            color: #64748b;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.lufs-peak;
                            font-family: Tokens.font-mono;
                            font-size: 11px;
                            font-weight: 800;
                            color: #fbbf24;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Speaker Matrix Switcher
            VerticalLayout {
                spacing: 5px;

                Text {
                    text: "MONITOR MATRIX";
                    font-family: Tokens.font-mono;
                    font-size: 8px;
                    letter-spacing: 0.8px;
                    font-weight: 700;
                    color: #64748b;
                }

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        height: 24px;
                        background: root.active-monitor == "main" ? Theme.accent.with-alpha(0.2) : #141720;
                        border-radius: Theme.radius;
                        border-width: root.active-monitor == "main" ? 1px : 0;
                        border-color: Theme.accent;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: "A: 近场主箱";
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                font-weight: 700;
                                color: root.active-monitor == "main" ? Theme.accent : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.active-monitor = "main";
                                root.switch-monitor("main");
                            }
                        }
                    }

                    Rectangle {
                        height: 24px;
                        background: root.active-monitor == "alt" ? Theme.accent.with-alpha(0.2) : #141720;
                        border-radius: Theme.radius;
                        border-width: root.active-monitor == "alt" ? 1px : 0;
                        border-color: Theme.accent;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: "B: 单声道参考";
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                font-weight: 700;
                                color: root.active-monitor == "alt" ? Theme.accent : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.active-monitor = "alt";
                                root.switch-monitor("alt");
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        height: 22px;
                        background: root.is-dim ? #f59e0b35 : #141720;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.is-dim ? #f59e0b : #ffffff12;
                        Text {
                            text: "DIM";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            font-weight: 800;
                            color: root.is-dim ? #f59e0b : #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.is-dim = !root.is-dim;
                                root.toggle-dim();
                            }
                        }
                    }

                    Rectangle {
                        height: 22px;
                        background: root.is-mono ? #38bdf835 : #141720;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.is-mono ? #38bdf8 : #ffffff12;
                        Text {
                            text: "MONO";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            font-weight: 800;
                            color: root.is-mono ? #38bdf8 : #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.is-mono = !root.is-mono;
                                root.toggle-mono();
                            }
                        }
                    }

                    Rectangle {
                        height: 22px;
                        background: root.is-side ? #ef444435 : #141720;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.is-side ? #ef4444 : #ffffff12;
                        Text {
                            text: "SIDE";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            font-weight: 800;
                            color: root.is-side ? #ef4444 : #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.is-side = !root.is-side;
                                root.toggle-side();
                            }
                        }
                    }
                }
            }
        }

        // Stereo Master Twin Bar Meters (Precision vertical LED bars)
        Rectangle {
            background: #06080e;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: #1a202c;
            vertical-stretch: 1;

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                alignment: center;

                // dB scale markings
                VerticalLayout {
                    alignment: space-between;
                    for mark in ["0", "-6", "-12", "-24", "-48"] : Text {
                        text: mark;
                        font-family: Tokens.font-mono;
                        font-size: 8px;
                        color: #64748b;
                        font-weight: 700;
                    }
                }

                // Left Meter Bar
                Rectangle {
                    width: 14px;
                    background: #0a0d14;
                    border-radius: 2px;
                    border-width: 1px;
                    border-color: #ffffff0a;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: parent.height - (root.master-meter-l * parent.height);
                        width: 14px;
                        height: root.master-meter-l * parent.height;
                        background: root.master-meter-l > 0.85 ? #f59e0b : #10b981;
                        border-radius: 2px;
                    }
                }

                // Right Meter Bar
                Rectangle {
                    width: 14px;
                    background: #0a0d14;
                    border-radius: 2px;
                    border-width: 1px;
                    border-color: #ffffff0a;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: parent.height - (root.master-meter-r * parent.height);
                        width: 14px;
                        height: root.master-meter-r * parent.height;
                        background: root.master-meter-r > 0.85 ? #f59e0b : #10b981;
                        border-radius: 2px;
                    }
                }
            }
        }

        // Master Output Footer
        Rectangle {
            height: 24px;
            background: #090c14;
            border-radius: 3px;
            border-width: 1px;
            border-color: #ffffff0a;
            Text {
                text: "MASTER OUT · 32-BIT FLOAT";
                font-family: Tokens.font-mono;
                font-size: 8px;
                letter-spacing: 0.8px;
                font-weight: 700;
                color: #64748b;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
