        { track_id: 2, label: "Outro Percussion Stems", start_px: 1260px, width_px: 420px, is_audio: true, gain_label: "Gain: -0.5dB", color: Theme.track-drum, base_color: Theme.track-drum, text_color: Tokens.skin-text-strong, guide_color: Theme.track-drum, marker_color: Theme.track-drum },
        { track_id: 3, label: "Cm9 -> AbMaj7 Granular Cloud", start_px: 0px, width_px: 480px, is_audio: false, gain_label: "0dB", color: Theme.track-pad, base_color: Theme.track-pad, text_color: Tokens.skin-text-strong, guide_color: Theme.track-pad, marker_color: Theme.track-pad },
        { track_id: 3, label: "Shimmer Pad High", start_px: 495px, width_px: 350px, is_audio: false, gain_label: "0dB", color: Theme.track-pad, base_color: Theme.track-pad, text_color: Tokens.skin-text-strong, guide_color: Theme.track-pad, marker_color: Theme.track-pad },
        { track_id: 3, label: "Ambient Drone Mid", start_px: 860px, width_px: 360px, is_audio: false, gain_label: "0dB", color: Theme.track-pad, base_color: Theme.track-pad, text_color: Tokens.skin-text-strong, guide_color: Theme.track-pad, marker_color: Theme.track-pad },
        { track_id: 3, label: "Granular Shimmer Outro", start_px: 1240px, width_px: 450px, is_audio: false, gain_label: "0dB", color: Theme.track-pad, base_color: Theme.track-pad, text_color: Tokens.skin-text-strong, guide_color: Theme.track-pad, marker_color: Theme.track-pad },
        { track_id: 4, label: "Lead Vox Take 3 (Swipe Comp)", start_px: 160px, width_px: 235px, is_audio: true, gain_label: "Gain: 0dB", color: Theme.track-vocal, base_color: Theme.track-vocal, text_color: Tokens.skin-text-strong, guide_color: Theme.track-vocal, marker_color: Theme.track-vocal },
        { track_id: 4, label: "Chorus Harmonies", start_px: 405px, width_px: 280px, is_audio: true, gain_label: "Gain: 0dB", color: Theme.track-vocal, base_color: Theme.track-vocal, text_color: Tokens.skin-text-strong, guide_color: Theme.track-vocal, marker_color: Theme.track-vocal },
        { track_id: 4, label: "Lead Vox Hook 2", start_px: 700px, width_px: 240px, is_audio: true, gain_label: "Gain: 0dB", color: Theme.track-vocal, base_color: Theme.track-vocal, text_color: Tokens.skin-text-strong, guide_color: Theme.track-vocal, marker_color: Theme.track-vocal },
        { track_id: 4, label: "Double Vox Layer", start_px: 955px, width_px: 290px, is_audio: true, gain_label: "Gain: -1dB", color: Theme.track-vocal, base_color: Theme.track-vocal, text_color: Tokens.skin-text-strong, guide_color: Theme.track-vocal, marker_color: Theme.track-vocal },
        { track_id: 4, label: "Vocal Adlibs Reverb Tail", start_px: 1260px, width_px: 380px, is_audio: true, gain_label: "Gain: -1.5dB", color: Theme.track-vocal, base_color: Theme.track-vocal, text_color: Tokens.skin-text-strong, guide_color: Theme.track-vocal, marker_color: Theme.track-vocal },
        { track_id: 5, label: "Polymetric Arp 5/16", start_px: 80px, width_px: 320px, is_audio: false, gain_label: "0dB", color: Theme.track-seq, base_color: Theme.track-seq, text_color: Tokens.skin-text-strong, guide_color: Theme.track-seq, marker_color: Theme.track-seq },
        { track_id: 5, label: "Synth Arp Riff 2", start_px: 415px, width_px: 270px, is_audio: false, gain_label: "0dB", color: Theme.track-seq, base_color: Theme.track-seq, text_color: Tokens.skin-text-strong, guide_color: Theme.track-seq, marker_color: Theme.track-seq },
        { track_id: 5, label: "Modulated Arp Bridge", start_px: 700px, width_px: 360px, is_audio: false, gain_label: "0dB", color: Theme.track-seq, base_color: Theme.track-seq, text_color: Tokens.skin-text-strong, guide_color: Theme.track-seq, marker_color: Theme.track-seq },
        { track_id: 5, label: "Filtered Outro Arp", start_px: 1080px, width_px: 480px, is_audio: false, gain_label: "0dB", color: Theme.track-seq, base_color: Theme.track-seq, text_color: Tokens.skin-text-strong, guide_color: Theme.track-seq, marker_color: Theme.track-seq }
    ];

    in-out property <int> selected-track-index: 3;
    property <int> safe-selected-idx: root.tracks.length > 0 ? Math.max(0, Math.min(root.tracks.length - 1, root.selected-track-index - 1)) : 0;
    in-out property <string> left-panel-tab: "inspector";

    // 检查器「片段级（Region）」读数：由 host 在选中片段时投影（只读，不参与编辑）。
    // 空串 + has-region=false = 如实"没有选中片段"，⛔ 不留上一条的陈旧名字。
    in-out property <bool> has-region: false;
    in-out property <string> region-title: "";
    in-out property <string> region-detail: "";
    in-out property <int> region-count: 1;

    // Dynamic Sizing with Min/Max Bounds (拖拽调整区域尺寸)
    in-out property <length> left-panel-width: 256px;   // [min: 200px, max: 380px]
    in-out property <length> clip-matrix-width: 240px;  // [min: 180px, max: 360px]
    in-out property <length> control-room-width: 200px; // [min: 160px, max: 300px]
    in-out property <length> lower-dock-height: 320px;  // [min: 180px, max: 480px]
    in-out property <length> track-headers-width: 240px;// [min: 180px, max: 320px]
    // 窗口**逻辑高**：由宿主 (`host::install_window_height_signal`) 单向写入，窗口
    // 尺寸变化时刷新。⛔ 需要"按窗口高封顶"的地方一律读这个属性，不许回读
    // `root.height` —— 回读会与布局互喂，Slint 会报成串 binding loop。
    in-out property <length> window-h: 700px;
    // ⚠ A12（2026-11-19）试过"混音台/设备堆叠 Tab 下把留给编曲区的 420 放软到 340"：
    //   下坞确实从 200 长到 260，但**编曲区被压到只剩一条轨道**，而且通道条仍然贴底被裁
    //   （实机帧 f1-mixer：推子尾部与 dB 读数照旧看不见）。原因不是下坞不够高，而是通道条
    //   外层把整叠行**底对齐**渲染、内容自然高 > 可见高，往下长出来的那 60px 全落在空白处。
    //   ⇒ 抢编曲区的空间买不到通道条，已回退成固定 420。
    // 真正的解法在 `lower_dock.slint` 的 `strip-compact`：矮窗下让出「音色插入」+「dB 读数牌」
    // 两行（≈40px），把高度还给 88px 推子单元。
    in-out property <bool> show-floating-toast: false;
    // ⭐ 审计 P1-4：提示条分级。`true` = 这条是**错误**（不自动消失）；`false` = 信息类
    // （4 秒后自己收走，见下面的 `toast-timer`）。
    in-out property <bool> toast-is-error: false;

    // Zone Visibility State (Default: clean arrangement workspace with side/dock panels folded)
    in-out property <bool> show-left-inspector: true;
    in-out property <bool> show-clip-matrix: Theme.persona == PersonaMode.AbletonLive;
    in-out property <bool> show-lower-dock: true;
    in-out property <bool> show-control-room: Theme.persona == PersonaMode.CubasePro;

    // Transport & Playback State
    in-out property <string> active-tool-name: "pointer";
    in-out property <bool> is-playing: false;
    in-out property <bool> is-recording: false;
    in-out property <bool> is-looping: false;
    in-out property <string> timecode-text: "001.01.000";
    in-out property <int> bpm-val: 124;
    in-out property <string> scale-text: "C Minor (自然小调)";
    in-out property <int> buffer-samples: 128;
    in-out property <int> dsp-cpu-percent: 14;
    in-out property <length> playhead-px: (root.playhead-ticks / max(1, root.roll-ticks-per-pixel)) * 1px;

    // Telemetry Meters
    in-out property <string> lufs-integrated: "-9.4 LUFS";
    in-out property <string> lufs-short: "-8.8 LUFS";
    in-out property <string> lufs-peak: "-0.3 dBTP";
    in-out property <float> master-meter-l: 0.68;
    in-out property <float> master-meter-r: 0.64;

    // Overlays & Fullscreen State
    in-out property <bool> show-chord-track: false;
    in-out property <bool> show-cmd-palette: false;
    in-out property <bool> show-hotspots: false;
    in-out property <string> toast-message: "";
    in-out property <bool> console-maximized: false;
    // 界面语言当前态（九语 i18n）：语言代码（"zh-CN" 等九语规范名）与
    // 自称名（"中文" / "English" / ...）。宿主持有的状态
    // （host::apply_language 唯一写入口），此处只是给主菜单
    // 「设置 → 语言」的当前态勾选读的镜像，.slint 侧不自己翻它。
    in-out property <string> language-code: "zh-CN";
    in-out property <string> language-name: "中文";
    // 调试输出开关的当前态镜像（T-FIX-70）：主菜单「设置 → 调试输出」
    // 的勾选读它；唯一写入口是 host::apply_debug_output，.slint 侧
    // 不自己翻它（与 language-code 同款）。开关本体住在宿主的
    // debug_out 汇点，菜单回调 toggle-debug-output 由宿主接管。
    in-out property <bool> debug-output: false;
    in-out property <bool> song-overview-fullscreen: false;
    property <bool> dock-tab-sync-guard: false;
    in-out property <bool> control-room-dim: false;
    in-out property <bool> control-room-mono: false;
    in-out property <bool> control-room-side: false;

    public function apply-dock-tab(t: string) {
        Theme.active-dock-tab = t;
        root.dock-tab-sync-guard = true;
        root.dock-tab-selected(t);
        if (t == "pianoroll") { root.console-tab = 0; }
        else if (t == "mixer") { root.console-tab = 1; }
        else if (t == "devices") { root.console-tab = 2; }
        else if (t == "stacked") { root.console-tab = 3; }
        root.dock-tab-sync-guard = false;
    }

    changed console-tab => {
        if (!root.dock-tab-sync-guard) {
            if (root.console-tab == 0) { Theme.active-dock-tab = "pianoroll"; }
            else if (root.console-tab == 1) { Theme.active-dock-tab = "mixer"; }
            else if (root.console-tab == 2) { Theme.active-dock-tab = "devices"; }
            else if (root.console-tab == 3) { Theme.active-dock-tab = "stacked"; }
        }
    }

    // Callbacks to Rust Host
    callback track-pan-changed(int, float);
    callback track-instrument-change(int, string);
    callback control-room-toggle-dim();
    callback control-room-toggle-mono();
    callback control-room-toggle-side();
    callback hot-swap-buffer-size(int);
    callback trigger-shortcut(string, KeyEvent);
    callback transport-toggle-play();
    callback transport-toggle-rec();
    callback transport-toggle-loop();
    callback transport-rewind();
    callback transport-set-bpm(int);
    callback transport-set-scale(string);
    callback edit-tool-selected(string);
    callback track-selected(int);
    callback track-toggle-mute(int);
    callback track-toggle-solo(int);
    callback track-toggle-arm(int);
    callback track-volume-changed(int, float);
    callback track-add-requested();
    callback clip-trigger(int, int);
    callback scene-trigger(int);
    callback chord-audition(string);
    callback browser-item-load(string);
    callback dock-tab-selected(string);
    callback zone-toggle(string);
    callback command-execute(string);
    callback normalize-track-heights();
    callback monitor-switch(string);
    callback device-param-changed(string, string, float);
    callback piano-step-toggle(int, int);
    callback piano-note-select(int);
    callback piano-note-create(int, int);
    callback piano-note-split(int);
    callback piano-note-delete(int);
    callback piano-note-velocity(int, int);
    callback piano-key-audition(string, int);
    callback run-acoustic-diagnosis();
    callback console-maximize-toggle();
    callback toggle-play();
    callback toggle-record();
    // 界面语言选择（九语 i18n）：由主菜单「设置 → 语言」触发，入参为
    // 语言规范名（"fr-FR" 等），宿主接管（host::apply_language 是唯一
    // 写入口，.slint 侧不自己改语言状态；显式选择同时写回设置文件，
    // 见 host::apply_language_and_save）。走带栏语言 chip 已按负责人
    // 2026-11-17 口径撤销，菜单是唯一运行期入口。
    callback select-language(string);
    // 调试输出开关（T-FIX-70）：由主菜单「设置 → 调试输出」触发，宿主
    // 接管（翻转 debug_out 汇点 + 经 apply_debug_output 回写勾选镜像 +
    // 写回设置文件，见 host 的接线）。与语言/质感同口径：切换入口只进
    // 系统主菜单，不放走带栏 chip。
    callback toggle-debug-output();
    // 恢复默认布局（line/ui-window-state）：由主菜单「设置 → 恢复默认
    // 布局」触发，宿主接管（host::reset_window_layout 是唯一落点：应用
    // .slint 初值并清掉已存布局；.slint 侧不自己改布局状态，与
    // select-language 同款）。
    callback reset-window-layout();
    // 界面质感选择（扁平 / 实体）：由主菜单「设置 → 质感」触发，入参为
    // 质感规范名（"flat" / "physical"），宿主接管（host::apply_texture
    // 是 Tokens.texture 的唯一写入口，与 CLI --texture 同一写点）。
    // 与语言不同：质感不写设置文件——现行口径就是会话内切换，初始值
    // 由启动路径按 --texture 注入（负责人 2026-11-17 口径：切换入口
    // 统一进主菜单，走带栏质感开关已撤销）。
    callback select-texture(string);
    callback revert-to-last-commit();
    callback open-cmd-palette();
    callback open-musical-pr();
    callback export-diagnostics();
    callback accept-ai-proposal();
    callback reject-ai-proposal();
    callback select-ai-proposal(string);

