    property <string> receipt-line: root.module-status-text != "" ? root.module-status-text
        : (root.module-clipping-warning != "" ? root.module-clipping-warning
        : (root.module-import-losses != "" ? root.module-import-losses : root.module-midi-in-status));
    property <bool> receipt-is-error: root.module-status-text != "" ? !root.module-status-succeeded
        : (root.module-clipping-warning != "" || root.module-import-losses != "");
