// 夜半 (Yeban) — 主窗口容器: 全局网格 (48 / 240 / 280 / 4 / 24) + 多标签导轨
//
// 规范来源 (Normative):
//   - [UI-GRID-001] UI/UX 规范 §1.1 网格布局拓扑:
//       顶栏 48px | 左资源栏 240px | 主工作区 (弹性) | 右 AI 协作栏 280px
//       4px splitter | 底部控制台 | 24px 状态栏
//   - [UI-GRID-002] §1.2 响应式断点:
//       ≥1920 全展开; 1366–1919 左栏收成 36px 图标导轨 + 右栏变抽屉;
//       splitter 拖拽硬限 220–600px
//   - [UI-GRID-003] §1.3 / [ARCH-UI-001] 保留模式与局部脏矩形 —— 由 Slint 后端负责,
//     UI 侧不写任何全屏重绘逻辑
//   - [UI-GRID-004] §1.4 120 FPS + VSync; 主渲染线程与实时音频线程物理隔离 [ARCH-TOP-002]:
//     UI 动画与绘制负载绝不穿透阻塞音频渲染回调
//   - [ARCH-UI-003] §1.3 无头模式运行配置 —— 见 src/main.rs 对 `SLINT_BACKEND=headless`
//     这个"规范与 Slint 1.18.1 实测不一致"之处的记录
//   - [UI-TEST-003] §12.1 无头启动 —— 无头路径不构造本组件, 见 src/main.rs
//   - [UI-MCP-002] §12.5 高频刷新区域 (时间码 / 电平 / 走带光标) 由
//     src/elements.rs 的 `is_dynamic_region()` 登记, 供截图比对时遮罩
//   - ADR-0001 D2: UI 文件清单以 UI/UX §8 的 11 个 `.slint` 为准, 另加 status_bar.slint
//     与 tokens.slint (主题层, 规范缺口)
//
// 中段:底部控制台的弹性比 = 3:2, 即各占弹性区的 60% / 40%, 落在规范的
// 55–65% / 35–45% 区间正中 (弹性区 = 窗口高 - 48 - 4 - 24)。
//
// 布局策略: 外层用 VerticalLayout / HorizontalLayout 表达规范的网格 (这是 UI-GRID-001 的
// 明文要求); 组件**内部**一律绝对定位 —— DAW 的坐标是可断言的几何事实, 用布局反而会
// 让 `absolute-position` 随字体度量漂移, 破坏截图回归与元素包围盒断言。
//
// 数据流方向: MainWindow 是唯一写者。子组件只读 + 发回调。

// `import` 把名字带进**本文件**的作用域; `export { … } from …` 是**纯再导出**
// (实测: 它**不**把名字带进本文件 —— 只写后者会让本文件里 44 处 `Tokens.*` 全部报
// `Cannot access id 'Tokens'`)。因此两行都要, 且它们不冲突: 再导出不引入本地名字。
//
// 为什么必须让 Rust 侧看见 `Tokens` / `ThemeState`:
// `src/host.rs` 的 `apply_theme` 要写 `ThemeState.theme`, 而
// `tests/theme_selection.rs` 要**回读** `Tokens.*` 的真实取值 —— 那是"生效的调色板
// 真的跟着主题变了"的判据 (断言 token 值, 不碰像素)。
import { Tokens, UiText, UiTitleText } from "tokens.slint";
export { Tokens, ThemeState } from "tokens.slint";
import { Transport } from "transport.slint";
import { StatusBar } from "status_bar.slint";
import { Sidebar } from "sidebar.slint";
import { SessionView } from "workspace/session_view.slint";
import { ArrangementView } from "workspace/arrangement_view.slint";
import { ConsoleTabs } from "console/console_tabs.slint";
import { MusicalPrDrawer } from "dialogs/musical_pr_drawer.slint";
import { UndoTreeModal } from "dialogs/undo_tree_modal.slint";

// 右侧 AI 协作栏 (280px) 的内容。被实例化两次 (常驻列 / compact 抽屉),
// 两者的 visible 条件互斥, 因此无障碍树里同一时刻只有一个 `ai-rail`。
component AiRail inherits Rectangle {
    callback open-musical-pr();
    callback run-acoustic-diagnosis();
    callback export-diagnostics();

    background: Tokens.bg-panel;
    border-width: 1px;
    border-color: Tokens.line;
    clip: true;

    accessible-role: complementary;
    accessible-id: "ai-rail";
    accessible-label: "AI 协作栏: 意图生成与声学诊断";

    UiTitleText {
        x: Tokens.space-4;
        y: Tokens.space-3;
        width: parent.width - 8px;
        height: 20px;
        text: "AI 协作";
        color: Tokens.gold;
        font-size: Tokens.font-size-lg;
    }

    Rectangle {
        x: Tokens.space-4;
        y: 32px;
        width: parent.width - 8px;
        height: 64px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.ai-suggestion;
        clip: true;
        accessible-role: button;
        accessible-id: "ai-rail-intent-button";
        accessible-label: "用自然语言描述编曲意图";

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: "意图生成:\n描述你想要的段落…";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }
    }

    Rectangle {
        x: Tokens.space-4;
        y: 104px;
        width: parent.width - 8px;
        height: 64px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line-strong;
        clip: true;
        accessible-role: button;
        accessible-id: "ai-rail-diagnose-button";
        accessible-label: "声学诊断";
        accessible-checkable: true;
        accessible-checked: false;

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: "声学诊断:\n掩蔽 / 相位 / 动态范围";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.run-acoustic-diagnosis(); }
        }
    }

    Rectangle {
        x: Tokens.space-4;
        y: 148px;
        width: parent.width - 8px;
        height: 28px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "diagnostics-export-action";
        accessible-label: "导出诊断包";

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: "导出诊断包 (D56)";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.export-diagnostics(); }
        }
    }

    Rectangle {
        x: Tokens.space-4;
        y: 176px;
        width: parent.width - 8px;
        height: 28px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "ai-rail-musical-pr-button";
        accessible-label: "打开 AI 编曲提案审核抽屉";

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "审查提案 (Musical PR)";
            color: Tokens.selection;
            font-size: Tokens.font-size-sm;
            horizontal-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.open-musical-pr(); }
        }
    }
}

export component MainWindow inherits Window {
    // [UI-GRID-002] 1366–1919 断点。宿主 Rust 按 §1.2 的规则写入 (见 main.rs 的
    // `DemoScene::compact()`); 真实屏幕尺寸探测 + 缩放比换算待接线, 见 notes 的 pending。
    in property <bool> compact: false;

    in-out property <bool> playing: false;
    in-out property <bool> arrangement-view: true;
    in-out property <int> console-tab: 0;
    in-out property <bool> console-expanded: true;
    in-out property <bool> sidebar-collapsed: false;
    in-out property <bool> ai-drawer-open: false;
    in-out property <bool> musical-pr-open: false;
    in-out property <bool> undo-tree-open: false;
    // ---- 撤销能力的显示态（**模型读数**，唯一写者 = src/host.rs 的 apply_undo）------
    // 能不能撤销、还能撤几步、已撤几步、提交多少条 —— 全部由 `undo_session::UndoDisplay`
    // 从 `CommitGraph` + `UndoCursor` 读出（ADR-0001 D45）。界面不自己推断。
    in-out property <bool> undo-can-undo: false;
    in-out property <bool> undo-can-redo: false;
    in-out property <int> undo-depth: 0;
    in-out property <int> undo-undone: 0;
    in-out property <int> undo-commit-count: 0;

    in-out property <string> timecode: "001.01.000";
    in-out property <string> bpm-display: "120.00";
    in-out property <string> branch-name: "main";

    // ---------------------------------------------------------------------
    // 时间码的**格式化网格**（`[MODEL-AST-001]`）
    // ---------------------------------------------------------------------
    // 唯一写者 = `src/host.rs` 的 `apply_view`（D28 的唯一注入点），值来自投影
    // `ViewState::timecode_grid()`；唯一读 = `src/host.rs` 的 `apply_transport`，
    // 它把这两个整数交给唯一的换算实现 `bridge::timecode_for_ticks`。
    //
    // 为什么参数要过一遍界面属性：走带位置是**引擎**读数（每帧在变），而拍号属于
    // **工程**投影（换工程 / 撤销才变）。把网格钉在窗口上 ⇒ "换工程之后同一个 tick
    // 的读数跟着变"不需要任何额外的共享可变状态，也不会读到过期的拍号。
    // 0 = 模型层拒绝这个拍号 ⇒ `timecode_for_ticks` 如实退回 tick 文本。
    in-out property <int> timecode-ticks-beat: 0;
    in-out property <int> timecode-ticks-bar: 0;

    // 键盘/菜单入口: src/input.rs 判定后由宿主调用对应的 invoke_*。
    callback toggle-play();
    // 走带的"停止"（停住 + 回到起点）。它与 `toggle-play` 一样由 Rust 侧接线，
    // 界面**不自己翻转**任何走带状态 —— 见 `src/host.rs` 的 `wire_transport`。
    callback stop();
    callback toggle-view();
    callback toggle-sidebar();
    callback toggle-ai-drawer();
    callback toggle-undo-tree();
    // D45: 时光机里的"撤销一步"（与 `Cmd+Z` 汇到同一个 `UndoPort::perform`）。
    callback undo-step();
    // `ROAD-M4-008` 选项 (a)：**保存工程**。事件源是 `ui/transport.slint` 的"保存"按钮
    // （`accessible-id: "transport-save-button"`）；宿主 `host::wire_save` 把它落到
    // `save_action::dispatch_save`（有控制面会话 ⇒ 走那个会话；没有 ⇒ 本地原子写），
    // 并把它说的**原话**写回 `save-status`（下面的 `in-out property`）。
    // 界面**不**自己写盘、也不自己做"保存成功了吗"的判断。
    callback save-project();
    // 最近一次保存的结果文本（`""` = 本次会话还没按过保存）。
    // 它是**宿主写的**（`host::apply_save_outcome` 是唯一写者），由状态栏读出来；
    // 成功与失败都在这里 —— 失败被吞掉正是本仓库最忌讳的失败模式。
    in-out property <string> save-status: "";
    // 最近一次保存是否成功（`.slint` 用它选颜色；读数是宿主的，不是界面算的）。
    in-out property <bool> save-succeeded: false;
    callback open-musical-pr();
    callback accept-ai-proposal();
    callback reject-ai-proposal();
    callback run-acoustic-diagnosis();
    callback export-diagnostics();
    // `[UI-A11Y-002]` §7.2：BPM 敲入控件里真 `TextInput` 的合成态 / 焦点事件
    // （见 ui/transport.slint 的 `bpm-input`）。宿主 `host::wire_input` 把它翻成
    // `InputContext::begin_composition` / `end_composition` / `set_focus`。
    callback ime-composition-changed(bool);
    callback ime-focus-changed(bool);

    // =====================================================================
    // `N2` 裁决 (1)：GUI 路径的键盘事件源（**逻辑键**）
    // =====================================================================
    // Slint 的 `KeyEvent` 只有 `text` + `modifiers`，**没有物理码**
    // （`i-slint-common-1.18.1/builtin_structs.rs` 的 `KeyEvent { text, modifiers, repeat }`），
    // 而 `src/input.rs` 的扫描码表需要物理键身份 ⇒ GUI **只能**绑逻辑键。
    // 因此这个 `FocusScope` 是**唯一**的键盘事件源：它把 `event.text` 与四个修饰位
    // 原样交给宿主（`host::wire_keys` → `input::resolve_logical`，与无头端口的物理码路径
    // **共用同一张**快捷键策略表）。
    //
    // 参数顺序（Rust 侧 `on_key_action` 必须逐位对齐）：
    //   text, shift, control, alt, meta
    //
    // 返回值 = `.slint` 的 `EventResult`：
    //   `true`  ⇒ `accept`：这一键被 DAW 消费（不再冒泡，Slint 也不做 `Tab` 焦点轮转）；
    //   `false` ⇒ `reject`：交给焦点系统 / 文本控件（例如文本框里的 `Tab` 与单键、未绑定的键）。
    callback key-action(string, bool, bool, bool, bool) -> bool;
    // 为什么用 `forward-focus`：`FocusScope` 只有在 `has-focus`（或包住获得焦点的元素）时才收键；
    // `forward-focus` 让窗口建立时焦点就落在这里，因此快捷键**不需要先点一下界面**才生效
    // （判据 16 的端口注入就是这个前提的机械证据）。
    // 焦点被 BPM 敲入框拿走时，单键快捷键按 §7.1/§7.2 归文本控件 —— 那是规范语义，不是缺口；
    // 回到这里要靠 Slint 的焦点轮转（`Tab`）或程序性 `focus()`，**没有**自动回焦的判据（见 N2 行）。
    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (root.key-action(event.text, event.modifiers.shift, event.modifiers.control,
                                event.modifiers.alt, event.modifiers.meta)) {
                accept
            } else {
                reject
            }
        }
    }

    // =====================================================================
    // 模型投影注入面（**唯一写者** = src/host.rs 的 apply_view）
    // =====================================================================
    // 这些数组的默认值一律是**空**：界面里不再内联演示数据（上一版的债见
    // docs/ledger/ui-shell-notes.md pending 4）。规模（轨道数 / 剪辑数 / 段落数）
    // 由工程决定，因此 `.slint` 里不存在 `for … in 6` 这种把演示规模刻进界面的写法。
    //
    // 为什么长度与数据分两个来源：数组长度本身就是规模（`root.tracks.length`），
    // 因此不需要额外的 `track-count` 标量属性 —— 少一个可能与数组不一致的状态。
    in property <string> window-title: "夜半 Yeban";
    in property <[string]> track-names: [];
    // 编排行几何（行顶沿 y / 行高，逻辑像素）—— 由投影的前缀和算一次（ADR-0004 S0），
    // 与 `track-names` 同索引集；`.slint` 不再做 `42px + 56px * i`。
    in property <[length]> track-ys: [];
    in property <[length]> track-heights: [];
    // =====================================================================
    // 轨道高度的**会话/视图态**（ADR-0004 S1 / Q4-A）：宿主拥有、重新注入，零 schema。
    // =====================================================================
    // 这三个是**输入**（不是投影输出）：宿主读它们造投影参数，而投影算出的每行高仍从
    // `track-ys` / `track-heights` 注入（唯一注入实现仍是 `host::apply_view`）。
    // - `track-height-percent`：全局高度缩放级（100 = 不缩放）；
    // - `track-height-override-ids` / `-pxs`：按轨道**身份**（26 字符 EntityId 文本）
    //   配对的每轨基准高（整数逻辑像素）。用身份而不是下标，插/删轨道才不会把高度
    //   错配到别的轨道上（`UI-TEST-001` 的语义寻址口径）。
    // 进程退出即失（不持久化，见 `bridge::TrackHeightLayout` 的文档）。
    in-out property <int> track-height-percent: 100;
    in-out property <[string]> track-height-override-ids: [];
    in-out property <[length]> track-height-override-pxs: [];
    // 轨道身份的 26 字符 `EntityId` 规范文本，与 `track-names` / `track-ys` **同索引集**。
    // 它是**投影输出**（`ViewState::track_ids`），存在的理由只有一个：每轨高度覆盖按
    // **身份**键控，而拖拽手势落在轨道头上时只能报告**下标** ⇒ 宿主需要"下标 → 身份"
    // 这一格。没有它，宿主只能拿一个会在换工程后过期的快照去猜身份。
    in property <[string]> track-ids: [];
    // =====================================================================
    // 轨道高度**拖拽手势的进行态**（ADR-0004 S1 的纵向入口）：宿主拥有、界面只报事件。
    // =====================================================================
    // 这四个是宿主的手势状态机（不是第二份高度权威 —— 高度仍只住在上面那三个属性里，
    // 写入口仍只有 `host::set_track_height_override` 一处）。它们住在窗口上的理由与
    // `roll-scroll-x` 相同：宿主在两个回调之间要记住"这一拖是从哪一行的哪一个高度开始的"，
    // 而 `Escape`（`Action::Cancel`）也必须能读到同一份状态去收尾。
    //
    // `track-height-drag-active` 是"手势是否还没结束"的唯一读数：松开 / 离开窗口 /
    // `Escape` 三条收尾路径都必须把它写回 `false`（判据钉住"不留粘住的拖拽态"）。
    in-out property <bool> track-height-drag-active: false;
    in-out property <string> track-height-drag-track: "";
    in-out property <int> track-height-drag-start-px: 0;
    in-out property <float> track-height-drag-start-y: 0.0;
    // `ADR-0004` S1 的纵向拖拽手势（三个回调都由 `ui/workspace/arrangement_view.slint`
    // 的轨道头 `TouchArea` 发出；宿主侧唯一实现是 `host::wire_track_height_drag`）。
    /// 按下：`(轨道下标, 指针在轨道头坐标系里的 y)`。
    callback track-height-grab(int, length);
    /// 拖动：同一个下标、同一个坐标系里的当前 y（位移由宿主算）。
    callback track-height-drag(int, length);
    /// 收尾：松开 / 指针离开窗口（`PointerEventKind.cancel`）/ 打断。
    callback track-height-release(int);
    // 混音台的**写入面**（`ADR-0005`：工程内容必须走 `Op` + `UndoPort`）。
    //
    // 形状与上面三个 `track-height-*` 同款：`.slint` 只报"哪一个下标 + 本地坐标"，
    // 位移换算、拖动期的视图态与松手时的**一次** `commit_ops` 全在宿主
    // （`host::wire_mixer_edit`）。五个成员 = 推子竖直拖 / 声相水平拖 / 两个开关。
    /// 推子按下（轨道下标, 推子面坐标系里的 y）。
    callback mixer-fader-grab(int, length);
    /// 推子拖动（同一个下标的当前 y；位移由宿主算）。
    callback mixer-fader-drag(int, length);
    /// 推子收尾（松手 / 指针离开窗口）。
    callback mixer-fader-release(int);
    /// 声相按下（轨道下标, 声相面坐标系里的 x）。
    callback mixer-pan-grab(int, length);
    /// 声相拖动。
    callback mixer-pan-drag(int, length);
    /// 声相收尾。
    callback mixer-pan-release(int);
    /// 静音按钮点击（一次点击 = 一次可撤销的编辑）。
    callback mixer-mute-toggle(int);
    /// 独奏按钮点击。
    callback mixer-solo-toggle(int);
    in property <[string]> track-volumes: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];
    in property <[string]> scene-names: [];
    in property <[string]> section-names: [];
    in property <[length]> section-positions: [];
    in property <[length]> section-widths: [];
    in property <[string]> clip-ulids: [];
    in property <[string]> clip-labels: [];
    in property <[length]> clip-positions: [];
    in property <[length]> clip-widths: [];
    // 剪辑的行几何（y / 高，逻辑像素）—— 由投影从所在行派生（ADR-0004 S0）。
    in property <[length]> clip-ys: [];
    in property <[length]> clip-heights: [];
    in property <[length]> bar-positions: [];
    // 钢琴卷帘的音符身份与力度（`MidiNote::id` / `MidiNote::velocity` ÷ 127）
    in property <[string]> note-ulids: [];
    in property <[float]> note-velocities: [];
    // 卷帘音符的位置（x / y / 宽，逻辑像素）—— 由 `start_tick` / `pitch` 整数派生，
    // 见 `src/bridge.rs` 的 `NoteView`（界面不做任何位置算术）。
    /// `[ROAD-M3-002]` 卷帘滚动手势（由宿主接管并重新注入）。
    callback scroll-requested(length);
    /// `[UI-NOTE-003]` 卷帘左键单击（坐标由界面报告, 语义由宿主决定）。
    callback clicked(length, length);
    /// `[ROAD-M3-002]` 卷帘当前水平偏移（逻辑像素）。
    /// 用 `<float>` 而非 `<length>`：宿主只需读写一个数，避免 `f32 -> Length` 转换与组件链转发。
    in-out property <float> roll-scroll-x: 0.0;
    /// `[UI-NOTE-001]` 步骤 ①：当前视口的 tick 上下界（由宿主按裁剪窗口算出）。
    /// 用 `<int>`：i32 在 960 PPQ 下可表示约 8.9 天音频, 且**精确**（`<float>` 在 2^24=1677 万 tick 以上会丢整数精度,
    /// 而本项目 10 万音符夹具已跨 2400 万 tick）。转换必须**饱和**, 不得回绕（见 `tick_to_i32_saturating` 的判据）。
    in-out property <int> roll-min-tick: 0;
    in-out property <int> roll-max-tick: 0;
    /// `[UI-NOTE-003]` 当前选中的音符数（供判据观测；真正的选中高亮走 `note-selected` 数组, 见账本第 223 轮）。
    in-out property <int> selected-note-count: 0;
    /// `[UI-NOTE-003]` 与可见数组**同一索引集**的选中标志（宿主注入；界面只取下标）。
    in-out property <[bool]> note-selected: [];
    /// `[UI-NOTE-003]` 当前卷帘工具（1..5）。镜像到窗口是为了让**宿主**能读到它：
    /// 没有这个镜像, 宿主无从知道该按哪个工具的语义处理点击（账本第 258 轮）。
    in-out property <int> active-tool: 1;
    /// `[UI-NOTE-003]` 当前选中的音符 ULID（**单一事实源**：`apply_view` 每次注入都由它重算标志）。
    in-out property <[string]> selected-ulids: [];
    /// `[UI-NOTE-001]` 步骤 ①（纵向）：可见音高上下界。
    /// 由**固定 16 条泳道**推出（见 `visible_pitch_range` 的判据）；纵向范围若将来变成动态,
    /// 泳道数必须来自 `.slint` 而不是宿主硬编码（账本第 202 轮）。
    in-out property <int> roll-min-pitch: 0;
    in-out property <int> roll-max-pitch: 0;
    in property <[length]> note-positions: [];
    in property <[length]> note-ys: [];
    in property <[length]> note-widths: [];
    // 轨道色标：`[color]` = 解析后的 RGB；`track-color-labels` = 同一个色的 `#RRGGBB` 文本
    // （进无障碍标签，让色标在控件树里可读）。
    in property <[color]> track-colors: [];
    in property <[string]> track-color-labels: [];

    // =====================================================================
    // 自动化泳道的注入面（`src/automation.rs` 的投影 → `ArrangementView`）
    // =====================================================================
    // 9 个平行数组：每条泳道一个成员。折线顶点与数值都是**投影算好的**逻辑像素 / 文本，
    // `.slint` 不做任何算术；`accessible-label` 携带单位与当前值，因此"AI/判据能读到
    // 自动化"有机械证据（不是"画了几条线"）。求值一律走模型的唯一入口，界面与投影层
    // 都没有第二份插值实现。
    in property <[string]> automation-lane-target-keys: [];
    in property <[int]> automation-lane-track-indexes: [];
    in property <[string]> automation-lane-labels: [];
    in property <[string]> automation-lane-axis-labels: [];
    in property <[length]> automation-lane-band-ys: [];
    in property <[length]> automation-lane-band-heights: [];
    in property <[bool]> automation-lane-read-enabled: [];
    in property <[string]> automation-lane-badges: [];
    in property <[string]> automation-path-commands: [];

    // =====================================================================
    // 混音台电平注入面（[ARCH-UI-002] 的"UI 线程定时器批量出队更新 Slint Properties"）
    // =====================================================================
    // 推子位置（0.0–1.0）由工程的 `TrackV3::volume_db` 派生 —— 与电平柱高是**两个量**：
    // 推子说"我把这条轨设到多大声"，电平说"它现在多大声"（`src/bridge.rs` 的
    // `volume_fraction` 与 `src/meters.rs` 的 `peak_fraction` 各有一份判据）。
    in property <[float]> track-volume-fractions: [];
    // 声相文本（`"C"` / `"L50"` / `"R30"`）—— 由投影的整数千分之一派生。
    in property <[string]> track-pans: [];
    // 电平：`{:.1}` dBFS 文本 + 0.0–1.0 柱高。长度**恒等于** `track-names.length`
    // （换工程时 `host::apply_view` 先重置成等长的静音，`apply_meters` 再填真实读数）。
    in property <[string]> track-meter-peaks: [];
    in property <[string]> track-meter-rmss: [];
    in property <[float]> track-meter-levels: [];
    // 主控通道条（投影 + 电平）
    in property <string> master-name: "Master";
    in property <string> master-volume-display: "";
    in property <float> master-volume-fraction: 0.0;
    in property <string> master-pan: "C";
    in property <bool> master-mute: false;
    in property <bool> master-solo: false;
    in property <color> master-color: #2c3a63;
    in property <string> master-color-label: "";
    in property <string> master-meter-peak: "-120.0";
    in property <string> master-meter-rms: "-120.0";
    in property <float> master-meter-level: 0.0;

    title: root.window-title;
    // 演示窗口落在 §1.2 的"全展开"档 (≥1920×1080): 左栏 240 + 主区 + 右栏 280,
    // 中段与底部控制台各占弹性区的 60% / 40% (规范要 55–65% / 35–45%)。
    // 与 `DemoScene::demo()` 的 viewport_width/height 保持一致 —— 不一致会让
    // `compact` 的取值和实际窗口宽度对不上。
    width: 1920px;
    height: 1080px;
    background: Tokens.bg-void;

    // =====================================================================
    // 外壳网格 [UI-GRID-001]
    // =====================================================================
    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        // ---------------------------------------------------------- 48px 顶栏
        Transport {
            playing: root.playing;
            timecode: root.timecode;
            bpm-display: root.bpm-display;
            branch-name: root.branch-name;
            arrangement-view: root.arrangement-view;
            ai-drawer-open: root.ai-drawer-open;

            // ⚠ 界面**不**自己翻转 `root.playing`：那个属性只有一个写者 ——
            // `src/host.rs` 的 `apply_transport`（读的是引擎的原子读数）。
            // 这一版删掉的 `root.playing = !root.playing;` 正是"控件存在 ≠ 回调接线"
            // 那类假象的来源（`docs/ledger/feature-alignment.md` 错位 7）。
            toggle-play => {
                root.toggle-play();
            }
            stop => {
                root.stop();
            }
            // `ROAD-M4-008`：保存按钮**原样**转给宿主 —— 界面不写盘、不改 `save-status`
            // （那个属性只有宿主一个写者，见 `host::apply_save_outcome`）。
            save-project => {
                root.save-project();
            }
            // ⚠ 界面**不**自己翻转 `root.arrangement-view` / `root.ai-drawer-open`：
            // 这两个属性与 `playing` 同款 —— 唯一写者是宿主（`host::wire_view_callbacks`，
            // 与键盘路径的 `host::apply_action` 写的是**同一个**属性）。
            // 转发块里再翻转一次就会有两个真相源（`docs/ledger/feature-alignment.md` 错位 7）。
            toggle-view => {
                root.toggle-view();
            }
            show-session => { root.arrangement-view = false; }
            show-arrangement => { root.arrangement-view = true; }
            toggle-ai-drawer => {
                root.toggle-ai-drawer();
            }
            // §7.2：合成态 / 焦点是**事件**，不是状态 —— 界面原样转给宿主，
            // 由宿主写进 `InputContext`（界面不存"我是不是在合成"）。
            ime-composition-changed(composing) => {
                root.ime-composition-changed(composing);
            }
            ime-focus-changed(focused) => {
                root.ime-focus-changed(focused);
            }
        }

        // ------------------------------------------- 中段 (弹性区的 60%)
        HorizontalLayout {
            vertical-stretch: Tokens.workspace-stretch;

            // 240px 左资源栏 (compact 时 36px 图标导轨)
            Sidebar {
                compact: root.compact || root.sidebar-collapsed;
                min-width: (root.compact || root.sidebar-collapsed) ? Tokens.left-rail-collapsed-width : Tokens.left-rail-width;
                max-width: (root.compact || root.sidebar-collapsed) ? Tokens.left-rail-collapsed-width : Tokens.left-rail-width;

                // 同 `toggle-view`：折叠态是**视图态**，唯一写者是 `host::wire_view_callbacks`
                // （键盘路径的 `Action::ToggleSidebar` 也写同一个属性）。
                toggle-collapse => {
                    root.toggle-sidebar();
                }
            }

            // 主工作区: 双视图同构投射, 同一时刻只显示一个 [规范 §2.1]
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                background: Tokens.bg-shell;

                SessionView {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: !root.arrangement-view;
                    tracks: root.track-names;
                    scenes: root.scene-names;
                }

                ArrangementView {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.arrangement-view;
                    tracks: root.track-names;
                    track-ys: root.track-ys;
                    track-heights: root.track-heights;
                    // `ADR-0004` S1 的纵向入口：轨道头 `TouchArea` 的事件原样转给宿主
                    // （界面不做位移 / 像素 / 夹紧中的任何一件）。
                    track-height-grab(track_index, pointer_y) => {
                        root.track-height-grab(track_index, pointer_y);
                    }
                    track-height-drag(track_index, pointer_y) => {
                        root.track-height-drag(track_index, pointer_y);
                    }
                    track-height-release(track_index) => {
                        root.track-height-release(track_index);
                    }
                    track-volumes: root.track-volumes;
                    track-mutes: root.track-mutes;
                    track-solos: root.track-solos;
                    sections: root.section-names;
                    section-positions: root.section-positions;
                    section-widths: root.section-widths;
                    clip-ulids: root.clip-ulids;
                    clip-labels: root.clip-labels;
                    clip-positions: root.clip-positions;
                    clip-widths: root.clip-widths;
                    clip-ys: root.clip-ys;
                    clip-heights: root.clip-heights;
                    bar-positions: root.bar-positions;
                    track-colors: root.track-colors;
                    track-color-labels: root.track-color-labels;
                    automation-lane-target-keys: root.automation-lane-target-keys;
                    automation-lane-track-indexes: root.automation-lane-track-indexes;
                    automation-lane-labels: root.automation-lane-labels;
                    automation-lane-axis-labels: root.automation-lane-axis-labels;
                    automation-lane-band-ys: root.automation-lane-band-ys;
                    automation-lane-band-heights: root.automation-lane-band-heights;
                    automation-lane-read-enabled: root.automation-lane-read-enabled;
                    automation-lane-badges: root.automation-lane-badges;
                    automation-path-commands: root.automation-path-commands;
                }
            }

            // 280px 右 AI 协作栏 (compact 时宽度归零, 改由下面的抽屉承担)
            AiRail {
                visible: !root.compact;
                min-width: root.compact ? 0px : Tokens.right-rail-width;
                max-width: root.compact ? 0px : Tokens.right-rail-width;

                // 打开抽屉是**视图态**，唯一写者是宿主（`host::wire_view_callbacks`）。
                open-musical-pr => { root.open-musical-pr(); }
                run-acoustic-diagnosis => { root.run-acoustic-diagnosis(); }
                export-diagnostics => { root.export-diagnostics(); }
            }
        }

        // ---------------------------------------------------------- 4px splitter
        // [UI-GRID-002] 拖拽范围硬限 220–600px; 真实的拖拽 + 双击居中
        // 需要指针捕获状态机 (规范 §6.1), 本骨架只登记几何与语义值。
        Rectangle {
            min-height: Tokens.splitter-height;
            max-height: Tokens.splitter-height;
            background: Tokens.line-strong;

            accessible-role: slider;
            accessible-id: "splitter-workspace-console";
            accessible-label: "主工作区与底部控制台的分割线 (220–600px)";
            accessible-orientation: horizontal;
            accessible-value-minimum: 220;
            accessible-value-maximum: 600;
            accessible-value-step: 1;
            accessible-value: "320";
        }

        // --------------------------------------- 底部控制台 (弹性区的 40%)
        ConsoleTabs {
            vertical-stretch: Tokens.console-stretch;
            active-tab: root.console-tab;
            note-ulids: root.note-ulids;
            note-velocities: root.note-velocities;
            note-positions: root.note-positions;
            note-selected: root.note-selected;
            active-tool: root.active-tool;
            scroll-requested(d) => { root.scroll-requested(d); }
            clicked(x, y) => { root.clicked(x, y); }
            note-ys: root.note-ys;
            note-widths: root.note-widths;
            // 调音台通道条（Tab 2）：投影 + 引擎电平，全部由 host.rs 单向注入。
            track-names: root.track-names;
            track-volumes: root.track-volumes;
            track-volume-fractions: root.track-volume-fractions;
            track-pans: root.track-pans;
            track-mutes: root.track-mutes;
            track-solos: root.track-solos;
            track-colors: root.track-colors;
            track-color-labels: root.track-color-labels;
            track-meter-peaks: root.track-meter-peaks;
            track-meter-rmss: root.track-meter-rmss;
            track-meter-levels: root.track-meter-levels;
            master-name: root.master-name;
            master-volume-display: root.master-volume-display;
            master-volume-fraction: root.master-volume-fraction;
            master-pan: root.master-pan;
            master-mute: root.master-mute;
            master-solo: root.master-solo;
            master-color: root.master-color;
            master-color-label: root.master-color-label;
            master-meter-peak: root.master-meter-peak;
            master-meter-rms: root.master-meter-rms;
            master-meter-level: root.master-meter-level;

            select-piano-roll => { root.console-tab = 0; }
            select-mixer => { root.console-tab = 1; }
            select-devices => { root.console-tab = 2; }

            // 混音台写入面：只上抛，不在 `.slint` 里改任何工程值
            // （`ADR-0005`：工程内容必须走 `Op` + `UndoPort`，落点是 `host::wire_mixer_edit`）。
            mixer-fader-grab(index, y) => {
                root.mixer-fader-grab(index, y);
            }
            mixer-fader-drag(index, y) => {
                root.mixer-fader-drag(index, y);
            }
            mixer-fader-release(index) => {
                root.mixer-fader-release(index);
            }
            mixer-pan-grab(index, x) => {
                root.mixer-pan-grab(index, x);
            }
            mixer-pan-drag(index, x) => {
                root.mixer-pan-drag(index, x);
            }
            mixer-pan-release(index) => {
                root.mixer-pan-release(index);
            }
            mixer-mute-toggle(index) => {
                root.mixer-mute-toggle(index);
            }
            mixer-solo-toggle(index) => {
                root.mixer-solo-toggle(index);
            }
        }

        // ---------------------------------------------------------- 24px 状态栏
        StatusBar {
            // `ROAD-M4-008`：最近一次保存的原话（宿主是唯一写者）。
            save-status: root.save-status;
            save-succeeded: root.save-succeeded;
        }
    }

    // =====================================================================
    // 覆盖层 (不是布局子元素, 因此可以绝对定位且不影响网格)
    // =====================================================================

    // compact 断点: 右栏变抽屉 (Cmd/Ctrl + 反斜杠 呼出)
    AiRail {
        x: root.width - Tokens.right-rail-width;
        y: 0;
        width: Tokens.right-rail-width;
        height: root.height;
        visible: root.compact && root.ai-drawer-open;

        open-musical-pr => { root.open-musical-pr(); }
        run-acoustic-diagnosis => { root.run-acoustic-diagnosis(); }
        export-diagnostics => { root.export-diagnostics(); }
    }

    // AI 编曲提案审核抽屉 (§10 Musical PR)
    MusicalPrDrawer {
        x: root.width - 360px;
        y: 0;
        width: 360px;
        height: root.height;
        visible: root.musical-pr-open;

        accept => {
            root.accept-ai-proposal();
            root.musical-pr-open = false;
        }
        reject => {
            root.reject-ai-proposal();
            root.musical-pr-open = false;
        }
        close => { root.musical-pr-open = false; }
    }

    // 全屏可视化 DAG 时光机 (Cmd/Ctrl + Shift + H)
    UndoTreeModal {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        visible: root.undo-tree-open;

        // 显示态 = 模型读数（宿主注入；界面只显示）。
        can-undo: root.undo-can-undo;
        undo-depth: root.undo-depth;
        undone-depth: root.undo-undone;
        commit-count: root.undo-commit-count;
        branch-name: root.branch-name;

        undo-step => { root.undo-step(); }
        close => { root.undo-tree-open = false; }
    }
}
