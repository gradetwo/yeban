// 夜半 (Yeban) — 主窗口容器: 全局网格 (48 / 240 / 280 / 4 / 24) + 多标签导轨
//
// 规范来源 (Normative):
//   - [UI-GRID-001] UI/UX 规范 §1.1 网格布局拓扑:
//       顶栏 48px | 左资源栏 240px | 主工作区 (弹性) | 右 AI 协作栏 280px
//       4px splitter | 底部控制台 | 24px 状态栏
//   - [UI-GRID-002] §1.2 响应式断点:
//       ≥1920 全展开; 1366–1919 左栏收成 36px 图标导轨 + 右栏变抽屉;
//       splitter 拖拽硬限 220–600px
//   - [UI-GRID-003] §1.3 / [ARCH-UI-001] 保留模式与局部脏矩形 —— 由 Slint 后端负责,
//     UI 侧不写任何全屏重绘逻辑
//   - [UI-GRID-004] §1.4 120 FPS + VSync; 主渲染线程与实时音频线程物理隔离 [ARCH-TOP-002]:
//     UI 动画与绘制负载绝不穿透阻塞音频渲染回调
//   - [ARCH-UI-003] §1.3 无头模式运行配置 —— 见 src/main.rs 对 `SLINT_BACKEND=headless`
//     这个"规范与 Slint 1.18.1 实测不一致"之处的记录
//   - [UI-TEST-003] §12.1 无头启动 —— 无头路径不构造本组件, 见 src/main.rs
//   - [UI-MCP-002] §12.5 高频刷新区域 (时间码 / 电平 / 走带光标) 由
//     src/elements.rs 的 `is_dynamic_region()` 登记, 供截图比对时遮罩
//   - ADR-0001 D2: UI 文件清单以 UI/UX §8 的 11 个 `.slint` 为准, 另加 status_bar.slint
//     与 tokens.slint (主题层, 规范缺口)
//
// 中段:底部控制台的弹性比 = 3:2, 即各占弹性区的 60% / 40%, 落在规范的
// 55–65% / 35–45% 区间正中 (弹性区 = 窗口高 - 48 - 4 - 24)。
//
// 布局策略: 外层用 VerticalLayout / HorizontalLayout 表达规范的网格 (这是 UI-GRID-001 的
// 明文要求); 组件**内部**一律绝对定位 —— DAW 的坐标是可断言的几何事实, 用布局反而会
// 让 `absolute-position` 随字体度量漂移, 破坏截图回归与元素包围盒断言。
//
// 数据流方向: MainWindow 是唯一写者。子组件只读 + 发回调。

// `import` 把名字带进**本文件**的作用域; `export { … } from …` 是**纯再导出**
// (实测: 它**不**把名字带进本文件 —— 只写后者会让本文件里 44 处 `Tokens.*` 全部报
// `Cannot access id 'Tokens'`)。因此两行都要, 且它们不冲突: 再导出不引入本地名字。
//
// 为什么必须让 Rust 侧看见 `Tokens` / `ThemeState`:
// `src/host.rs` 的 `apply_theme` 要写 `ThemeState.theme`, 而
// `tests/theme_selection.rs` 要**回读** `Tokens.*` 的真实取值 —— 那是"生效的调色板
// 真的跟着主题变了"的判据 (断言 token 值, 不碰像素)。
import { Tokens, UiText, UiTitleText } from "tokens.slint";
export { Tokens, ThemeState } from "tokens.slint";
import { Transport } from "transport.slint";
import { StatusBar } from "status_bar.slint";
import { Sidebar } from "sidebar.slint";
import { SessionView } from "workspace/session_view.slint";
import { ArrangementView } from "workspace/arrangement_view.slint";
import { ConsoleTabs } from "console/console_tabs.slint";
import { MusicalPrDrawer } from "dialogs/musical_pr_drawer.slint";
import { UndoTreeModal } from "dialogs/undo_tree_modal.slint";
// 五个**模块入口**（导出 WAV / 导入 MIDI / 装载 SFZ / 录音 / 硬件 MIDI 输入）。
// 它们住在右栏的下半区（`AiRail` 的 `ModuleActions` 实例），因此**不改**任何既有
// 几何：顶栏 48 / 中段 / 4px splitter / 底部控制台 / 24px 状态栏一位未动，
// 基准图上只有这一块新像素（见本票的 golden 影响登记）。
import { ModuleActions } from "module_actions.slint";

// 右侧 AI 协作栏 (280px) 的内容。被实例化两次 (常驻列 / compact 抽屉),
// 两者的 visible 条件互斥, 因此无障碍树里同一时刻只有一个 `ai-rail`。
component AiRail inherits Rectangle {
    callback open-musical-pr();
    callback run-acoustic-diagnosis();
    callback export-diagnostics();
    // ---- 模块入口（本票起五条）--------------------------------------------
    // 与上面三条同款：`AiRail` 只**转发**，动作的语义、目标路径与回执全在宿主
    // （`src/host.rs` 的 `wire_module_actions`）。界面不写盘、不猜路径、不存状态。
    callback export-wav();
    callback import-midi();
    callback load-sfz();
    callback record-wav();
    // ⭐ 第五条：**硬件** MIDI 输入（`crate::midi_in::capture`，与 CLI `--midi-in` 同一个函数）。
    // 它与 `import-midi` **不是**同一件事：那条读的是**文件**（SMF），这条读的是**物理端口**。
    callback midi-in();
    // 模块入口的**只读**注入面（唯一写者 = `host::wire_module_actions`）。
    // `status` 的默认值是空串 = "本次会话还没按过任何模块入口"，不是一个编造的读数。
    in property <string> module-status: "";
    in property <bool> module-status-succeeded: false;
    // MIDI 输入的**专属**结果行（同一串字节、同一个写者 ⇒ ⛔ 不是第二个真相源）。
    in property <string> module-midi-in-status: "";
    in property <bool> module-midi-in-status-succeeded: false;

    background: Tokens.bg-panel;
    border-width: 1px;
    border-color: Tokens.line;
    clip: true;

    accessible-role: complementary;
    accessible-id: "ai-rail";
    accessible-label: "AI 协作栏: 意图生成与声学诊断";

    UiTitleText {
        x: Tokens.space-4;
        y: Tokens.space-3;
        width: parent.width - 8px;
        height: 20px;
        text: "AI 协作";
        color: Tokens.gold;
        font-size: Tokens.font-size-lg;
    }

    Rectangle {
        x: Tokens.space-4;
        y: 32px;
        width: parent.width - 8px;
        height: 64px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.ai-suggestion;
        clip: true;
        accessible-role: button;
        accessible-id: "ai-rail-intent-button";
        accessible-label: "用自然语言描述编曲意图";

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: "意图生成:\n描述你想要的段落…";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }
    }

    Rectangle {
        x: Tokens.space-4;
        y: 104px;
        width: parent.width - 8px;
        height: 64px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line-strong;
        clip: true;
        accessible-role: button;
        accessible-id: "ai-rail-diagnose-button";
        accessible-label: "声学诊断";
        // `[UI-A11Y-003]` §7.3：无障碍**动作**。屏读器 / OS 辅助技术激活这个节点时走
        // 下面 `TouchArea` 的**同一个**回调（判据见 `elements.rs` 的
        // `every_clickable_control_binds_a_matching_accessibility_action`）。
        // 为什么必须有它：上游 `i-slint-backend-winit` 只按 `accessible-action-*`
        // 的绑定情况导出 accesskit 动作（`supported_accessibility_actions`），
        // 没有它这个节点读得到标签、却**按不动**。
        accessible-action-default => { root.run-acoustic-diagnosis(); }
        // **不得**声明 `accessible-checkable`（台账 R11c）：这是**瞬态动作**，不是切换，
        // 故"可勾选"是假话。实测（落这一行时，本文件删掉本注释块后的行号）：本处有真的
        // 点击源 `TouchArea`（现位于第 141 行）＋ `clicked => { root.run-acoustic-diagnosis(); }`（现位于第 144 行），
        // 而该回调的宿主实现 `crates/yeban-app/src/main.rs:645` 的
        // `ui.on_run_acoustic_diagnosis(..)` 只打一行 stderr —— **不置位任何状态**
        // （全仓 `run_acoustic_diagnosis` 的命中里没有一处是状态写者）。
        // `accessible-role: button` 与标签保留，它们是真话。
        // `accessible-checked: false` **一并删除**：全仓**没有**判据读它
        // （`.checked` 只有 `test_port_adapter.rs:2911` 与 `:2950` 两处，都在录音键上）。

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: "声学诊断:\n掩蔽 / 相位 / 动态范围";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.run-acoustic-diagnosis(); }
        }
    }

    // ⭐ 任务单 `#187`：`diagnostics-export-action` 与「审查提案」改成**同一行并排**。
    //
    // 修前（`21592ff` 起）：导出诊断包住 `y: 148px`、高 28 ⇒ `148..176`；
    // 而「声学诊断」卡住 `y: 104px`、高 64 ⇒ `104..168` ⇒ **两键相交 20px**
    // （1920 档实测 `(1648,152,272,64)` ⟂ `(1648,196,272,28)`；三档全中）。
    // 为什么不是"整体下移 28px"：`AiRail` 的竖向预算在 1440 档只剩 7px
    // （内容 440 < 栏高 475）、1024 档本来就已溢出（415）⇒ 再下移 28 会在 1440
    // 把最后一条回执行推出裁剪区，是拿一个缺陷换另一个。
    // 因此改为**不占新高度**的并排：两个键同住 `y: 172..200`（诊断卡下沿 168 ＋ 4px），
    // 下面 `ModuleActions` 的 `212px` 标题一位不动。
    Rectangle {
        x: Tokens.space-4;
        y: 172px;
        width: 108px;
        height: 28px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "diagnostics-export-action";
        accessible-label: "导出诊断包";
        // `[UI-A11Y-003]` §7.3：落点与下面 `TouchArea` 的 `clicked` 逐字相同。
        accessible-action-default => { root.export-diagnostics(); }

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: "导出诊断包 (D56)";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.export-diagnostics(); }
        }
    }

    Rectangle {
        x: Tokens.space-4 + 108px + Tokens.space-2;
        y: 172px;
        width: parent.width - 2 * Tokens.space-4 - 108px - Tokens.space-2;
        height: 28px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "ai-rail-musical-pr-button";
        accessible-label: "打开 AI 编曲提案审核抽屉";
        // `[UI-A11Y-003]` §7.3：落点与下面 `TouchArea` 的 `clicked` 逐字相同。
        accessible-action-default => { root.open-musical-pr(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "审查提案 (Musical PR)";
            color: Tokens.selection;
            font-size: Tokens.font-size-sm;
            horizontal-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.open-musical-pr(); }
        }
    }

    // ---------------------------------------------------------- 四个模块入口
    // 本票新增。它占据右栏 y=208..380 这一段**此前完全空白**的区域（`#187` 起
    // 上面四条控件止于 y=200）⇒ 不改任何既有控件的坐标，也不改任何容器的尺寸。
    // 四个回调与两条注入属性各自**原样**转给 `MainWindow`（与上面三条同款）。
    ModuleActions {
        x: 0;
        y: 0;
        width: parent.width;
        height: 240px;

        status: root.module-status;
        status-succeeded: root.module-status-succeeded;
        midi-in-status: root.module-midi-in-status;
        midi-in-status-succeeded: root.module-midi-in-status-succeeded;

        export-wav => { root.export-wav(); }
        import-midi => { root.import-midi(); }
        load-sfz => { root.load-sfz(); }
        record-wav => { root.record-wav(); }
        midi-in => { root.midi-in(); }
    }
}

// ⭐ **引擎错误横幅**（任务单 `#86` 甲）：把"最近一次快照发布失败"投到窗口里。
//
// ## 它补的是哪一格
//
// 引擎侧的发布失败**早就是结构化的**（`EngineHostError::Sfz` 等），`#82` 也**不再吞掉**
// 它（`live_surface::engine_tick` ⇒ `EngineTick::publish_error`）。但那一路只把原文落成
// **读数 ＋ `stderr`** —— **窗口里看不见**。后果是用户点了混音台的 SET 敲一条不存在的
// SFZ 路径，界面毫无反应，他以为"没生效"。本组件就是那句话的可见落点。
//
// ## 数据流（单向，界面不算任何东西）
//
// ```text
// EngineHost::publish_project(…)
//     └─ Err(EngineHostError) ──> host::apply_engine_error(ui, Failed(text))  ← 唯一写者
//         └─ MainWindow.engine-error ──> EngineErrorBanner.text
//             └─ visible: text != ""     ← 空串 = 不显示（成功 / 还没出过错）
// ```
//
// 界面**不**自己判断"这是不是错误"、**不**自己清屏、**不**存第二份状态 —— 与
// `status_bar.slint` 的 `save-status` / `module_actions.slint` 的 `module-status`
// 是**同一条**纪律（宿主是唯一写者，`.slint` 只显示）。
//
// ## 为什么它住在 `app.slint` 里而不是自己的一个 `.slint` 文件
//
// `ADR-0001` **D2** 把 `ui/` 的 `.slint` 清单**冻结**了，且由本 crate 的判据
// `elements::tests::slint_manifest_matches_adr_0001_d2` 机械看守（新建一个文件会让它当场红）。
// 增加一个 `.slint` 文件等于改一条**已生效**的 ADR 裁决 —— 那是人类负责人的事
// （`AGENTS.md` §5.7：⛔ 不擅自改写 Normative 文档），⛔ 不是本单能顺手做的。
// 因此本条**就地**定义：与 `AiRail` 同一种形态（`app.slint` 里的内联组件）。
//
// ## 为什么 `visible` 绑在**文本**上而不是另设一个 `bool`
//
// 两个属性会造出一个自相矛盾的中间态（"文字还在、bool 说没有"），而那种态没有任何
// 合法的产生路径，只会让判据分不清"没有错误"与"写者漏写了一半"。空串因此是**唯一**的
// "没有错误"表示（与 `save-status` 的 `""` 同款口径）。
//
// ## 默认帧为什么逐像素不变（第 247 条）
//
// 它在 `MainWindow` 里是**覆盖层**（不是 `VerticalLayout` 的子元素，见本文件末尾的
// "覆盖层"一节），且没有错误时 `visible = false` ⇒ 它一位像素都不画、也不参与任何布局
// 计算。上游的控件树遍历会**过滤掉** `visible: false` 的分支（既有判据
// `test_port_adapter` 的 `DEFAULT_VIEW_MUST_NOT_HAVE` 钉的就是这条语义）⇒ 无头控件树
// JSON 里它**根本不出现** —— 这正是"成功时不显示"的可判形态。
//
// ## `accessible-value` 是原文，不是"有错误吗"
//
// `[UI-TEST-001]` 的语义寻址要能回答"**错在哪**"，所以 `accessible-value` 直接挂错误
// 原文。压成一个 `bool` 就等于又把信息丢一次 —— 那正是 `#82` 修掉的错法。
component EngineErrorBanner inherits Rectangle {
    /// **最近一次**快照发布失败的原文（`EngineHostError` 的 `Display`）。
    ///
    /// 唯一写者 = `crates/yeban-app/src/host.rs` 的 `host::apply_engine_error`。
    /// 默认空串 = "本次会话还没有过引擎错误"，**不是**一个编造的读数。
    in property <string> text: "";

    // 空串 ⇒ 不显示（也不进入控件树、不影响布局）。
    visible: text != "";

    height: 28px;
    background: Tokens.bg-panel;
    border-width: 1px;
    border-color: Tokens.record-red;

    // 语义节点：ID 稳定、角色是 `banner`、label 与 `src/elements.rs` 的注册表**逐字相同**
    // （`test_port_adapter` 会断言运行时 label == 注册表 label）。
    accessible-role: banner;
    accessible-id: "engine-error-banner";
    accessible-label: "引擎错误横幅";
    // ⭐ 错误**原文**（`DoD §3.6` 的"内容可读"就落在这一格上）。
    accessible-value: root.text;

    UiText {
        x: Tokens.space-4;
        y: 0;
        width: parent.width - Tokens.space-4 * 2;
        height: parent.height;
        // 前缀是**界面**加的固定字面量（不是读数）；读数本身原样跟在后面。
        text: "引擎错误：" + root.text;
        color: Tokens.record-red;
        font-size: Tokens.font-size-xs;
    }
}

export component MainWindow inherits Window {
    // [UI-GRID-002] 断点: `width < 1920px` ⇒ 折叠 (1366–1919 左栏 36px、右栏变抽屉)。
    //
    // ⭐ `#191`：这里是**表达式绑定**, ⛔ 不是宿主在装配时写入一次的常量。`#183` 之后
    // `root.width` 是**后端给出的真实窗口宽**（根尺寸不再钉死 1920px）, 因此窗口被拉窄 /
    // 拉宽时 Slint 会自己重算这一条 —— 左栏 240↔36、右栏在场性都跟着走。
    //
    // 原 `host.rs:8451` 的 `ui.set_compact(scene.compact())` 已删除: 那个写法用的视口是
    // `DemoScene::viewport_width`（恒 1920, 见 `scene.rs:188`）, 且只在装配时算一次 ⇒
    // 窗口拉窄时左栏不会折叠。**装配点不再写这个属性**（生产路径唯一写者 = 本条绑定）。
    //
    // 仍声明为 `in-out` 而不是 `out`: 测试夹具可以在固定尺寸下显式渲染折叠态
    // （例如 `app-main-window-arrangement-compact-1920x1080.png`）。从 Rust 写一次会
    // 覆盖该实例的绑定（Slint 语义），因此它**只**是测试旁路, ⛔ 不是生产写者。
    in-out property <bool> compact: self.width < Tokens.breakpoint-full-hd * 1px;

    in-out property <bool> playing: false;
    /// ⭐ 录音键的显示态（`[ARCH-REC-001]`）：唯一写者 = `host::wire_transport`
    /// （起录 ⇒ true、停录 ⇒ false）。⛔ 不是工程数据（`MODEL-ISO-001` 的挥发性层）。
    in-out property <bool> recording: false;
    in-out property <bool> arrangement-view: true;
    in-out property <int> console-tab: 0;
    in-out property <bool> console-expanded: true;
    in-out property <bool> sidebar-collapsed: false;
    in-out property <bool> ai-drawer-open: false;
    in-out property <bool> musical-pr-open: false;
    in-out property <bool> undo-tree-open: false;
    // ---- 撤销能力的显示态（**模型读数**，唯一写者 = src/host.rs 的 apply_undo）------
    // 能不能撤销、还能撤几步、已撤几步、提交多少条 —— 全部由 `undo_session::UndoDisplay`
    // 从 `CommitGraph` + `UndoCursor` 读出（ADR-0001 D45）。界面不自己推断。
    in-out property <bool> undo-can-undo: false;
    in-out property <bool> undo-can-redo: false;
    in-out property <int> undo-depth: 0;
    in-out property <int> undo-undone: 0;
    in-out property <int> undo-commit-count: 0;
    // ---- 时光机画出的**真实提交链**（唯一写者 = src/host.rs 的 apply_undo）--------
    // 来源是**权威提交图谱**：`UndoPort::graph()` → `CommitGraph::ancestry(head)` →
    // 每个 `Commit::message`（最新在前）。界面不自带节点；默认全空 ⇒ 画空态。
    // `undo-node-hidden` = 链条上比画布画得下的更多的版本数（如实报数，不静默截断）。
    // ⚠ 这三个属性**曾经不存在**：那时 `UndoTreeModal` 自带 6 个编造的版本名默认值，
    // 而没有任何宿主写者 ⇒ 用户看到的是不存在的历史。判据见
    // `crates/yeban-app/tests/undo_tree_honesty.rs`。
    in-out property <int> undo-node-count: 0;
    in-out property <[string]> undo-node-labels: [];
    in-out property <int> undo-node-hidden: 0;

    in-out property <string> timecode: "001.01.000";
    in-out property <string> bpm-display: "120.00";
    in-out property <string> branch-name: "main";

    // ---------------------------------------------------------------------
    // 时间码的**格式化网格**（`[MODEL-AST-001]`）
    // ---------------------------------------------------------------------
    // 唯一写者 = `src/host.rs` 的 `apply_view`（D28 的唯一注入点），值来自投影
    // `ViewState::timecode_grid()`；唯一读 = `src/host.rs` 的 `apply_transport`，
    // 它把这两个整数交给唯一的换算实现 `bridge::timecode_for_ticks`。
    //
    // 为什么参数要过一遍界面属性：走带位置是**引擎**读数（每帧在变），而拍号属于
    // **工程**投影（换工程 / 撤销才变）。把网格钉在窗口上 ⇒ "换工程之后同一个 tick
    // 的读数跟着变"不需要任何额外的共享可变状态，也不会读到过期的拍号。
    // 0 = 模型层拒绝这个拍号 ⇒ `timecode_for_ticks` 如实退回 tick 文本。
    in-out property <int> timecode-ticks-beat: 0;
    in-out property <int> timecode-ticks-bar: 0;

    // 键盘/菜单入口: src/input.rs 判定后由宿主调用对应的 invoke_*。
    callback toggle-play();
    /// ⭐ 录音键（`[ARCH-REC-001]`）：按下 ⇒ 起录 / 停录。
    callback toggle-record();
    // 走带的"停止"（停住 + 回到起点）。它与 `toggle-play` 一样由 Rust 侧接线，
    // 界面**不自己翻转**任何走带状态 —— 见 `src/host.rs` 的 `wire_transport`。
    callback stop();
    callback toggle-view();
    callback toggle-sidebar();
    callback toggle-ai-drawer();
    callback toggle-undo-tree();
    // D45: 时光机里的"撤销一步"（与 `Cmd+Z` 汇到同一个 `UndoPort::perform`）。
    callback undo-step();
    // `ROAD-M4-008` 选项 (a)：**保存工程**。事件源是 `ui/transport.slint` 的"保存"按钮
    // （`accessible-id: "transport-save-button"`）；宿主 `host::wire_save` 把它落到
    // `save_action::dispatch_save`（有控制面会话 ⇒ 走那个会话；没有 ⇒ 本地原子写），
    // 并把它说的**原话**写回 `save-status`（下面的 `in-out property`）。
    // 界面**不**自己写盘、也不自己做"保存成功了吗"的判断。
    callback save-project();
    // 最近一次保存的结果文本（`""` = 本次会话还没按过保存）。
    // 它是**宿主写的**（`host::apply_save_outcome` 是唯一写者），由状态栏读出来；
    // 成功与失败都在这里 —— 失败被吞掉正是本仓库最忌讳的失败模式。
    in-out property <string> save-status: "";
    // 最近一次保存是否成功（`.slint` 用它选颜色；读数是宿主的，不是界面算的）。
    in-out property <bool> save-succeeded: false;
    // =====================================================================
    // 五个**模块入口**的宿主回执（导出 WAV / 导入 MIDI / 装载 SFZ / 录音 / 硬件 MIDI 输入）
    // =====================================================================
    // 唯一写者 = `src/host.rs` 的 `wire_module_actions`。它是**成功与失败都在**的
    // 一行结构化回执：形如
    //   `module:action=export-wav:outcome=ok:path=…:frames=…:source=…`
    //   `module:action=load-sfz:outcome=error:error=sfz-read:message="…"`
    // 为什么进界面属性而不是只打日志：与 `save-status` 同款 —— "动作失败了而用户
    // 以为成功"是本仓库最忌讳的失败模式。`module_actions.slint` 的
    // `module-last-status` 把它同时放进可见 `text` 与 `accessible-label`。
    // 默认空串 = "本次会话还没按过任何模块入口"，**不是**一个编造的读数。
    in-out property <string> module-status: "";
    in-out property <bool> module-status-succeeded: false;
    // ⭐ **硬件 MIDI 输入**的专属结果行（`ui/module_actions.slint` 的
    // `module-midi-in-status`）。⭐ 与上面那条**同一串字节、同一个写者**
    // （`host::wire_module_actions` 的 `midi-in` 分支只写一次、写两处）
    // ⇒ ⛔ 不是第二个真相源；分成两格只是为了让"最近一次动作"与"这次采集的读数"
    // 各自能被语义 ID 寻址（`[UI-TEST-001]`）。
    // 默认空串 = "还没按过这个入口"，**不是**一个编造的读数。
    in-out property <string> module-midi-in-status: "";
    in-out property <bool> module-midi-in-status-succeeded: false;
    // 六条入口回调（事件源 = `ui/module_actions.slint` 的五个 `TouchArea` ＋
    // `ui/console/mixer_console.slint` 的 `midi_export_area`）。
    // 宿主 `host::wire_module_actions` 把它们落到**已经存在的**六个模块实现上：
    //   导出 WAV    → `crate::export_wav::export_wav_with_sfz_file`
    //   导出 MIDI   → `crate::export_midi::export_project_to_file`（与 CLI `--export-midi` **同一个**函数；
    //                 入口住在控制台 Tab 1，见下面 `export-midi` 回调的注释）
    //   导入 MIDI   → `crate::import_midi::import_midi_file`（经 `UndoPort`，来源 `MidiInput`）
    //   装载 SFZ    → `crate::sfz_load::load_sfz_with_instrument`
    //   录音        → `crate::record_wav::record_test_tone`
    //   硬件 MIDI 入 → `crate::midi_in::capture_messages`（与 CLI `--midi-in` **同一个**函数）
    //                  ＋ `crate::midi_notes::write_notes`（= CLI 的 `--midi-in-write-notes`）
    // ⚠ `import-midi` 读的是**文件**（SMF）；`midi-in` 读的是**物理端口** ⇒ 两条不是一件事。
    // ⛔ 界面不写盘、不猜路径、不自己判断成功与否（那是第二个真相源）。
    callback export-wav();
    callback import-midi();
    callback load-sfz();
    callback record-wav();
    callback midi-in();
    // ⭐ **只给宿主用**：硬件 MIDI 采集完成 ⇒ 请 UI 线程排空（并在有端口时把音符写进谱面）。
    //
    // 为什么需要一个"空"的 callback（它**不**被 `.slint` 里的任何控件调用）：工作线程做完采集后
    // 要把结果交回 **UI 线程**，而 `slint::Weak::upgrade_in_event_loop` 的闭包**必须** `Send`
    // （上游 `i-slint-core` 的 `api.rs:1227-1230`）—— 落地端口是 `Rc<UndoPort>`（UI 线程独占，
    // ⛔ 不 `Send`）⇒ **不能**由工作线程的闭包直接搬运。⇒ 跨线程只传**这一句"请排空"**：
    // 工作线程调 `invoke_midi_in_drain_requested()`，本窗口上由 `host::wire_module_actions` 注册的
    // handler（它握着端口与状态）在 UI 线程上执行排空。
    // ⛔ 它不画任何像素（⛔ 不是控件、⛔ 不改几何）⇒ 金标截图不受影响。
    callback midi-in-drain-requested();
    // 状态栏「选区信息」那一格的**整串文本**（台账 R9）。
    //
    // 写者**只有一处**：`host::apply_view` 末尾的 `host::publish_status_bar`。
    // 数据源 = `ViewState::selection_tick_span` 解析本窗口的 `selected-ulids`
    // （有选区 ⇒ `选区 001.01.000 – 005.04.480`），格式化走唯一的
    // `bridge::timecode_for_ticks`；空选区 = 本属性默认值 `选区 无`。
    // `.slint` 侧**不做**任何 tick 算术，也不构造这一串文本。
    in-out property <string> status-selection: "选区 无";
    // 状态栏「音频配置」那一格的**整串文本**（台账 R9）。
    //
    // 写者同上（`host::publish_status_bar`）。数据源 = `ViewState::audio_config_display`，
    // 它在投影层由 `project.audio_config.sample_rate` / `.bit_depth` 唯一一次格式化。
    // 默认值 `"—"` = **还没有读数**；它**不是**任何一个具体的采样率 / 位深。
    // `"DSP …%"` 那个编造的性能读数已删除：没有真实数据源就不填那一格。
    in-out property <string> status-device: "—";
    // ⭐ 任务单 `#166`：卷帘**最近一次编辑拒绝**的逐字原因（空串 = 没有拒绝）。
    //
    // 写者**只有一处**：`host::install_roll_click` 的第二段（它是卷帘点击的唯一派发器）——
    // 每次点击先清空，铅笔拒绝时写入一句人话（"当前显示的轨上没有覆盖该位置的片段，未写入音符"）。
    // 它不是工程数据、不是"选中轨"状态：只是**最近一次拒绝**的显示文本（`MODEL-ISO-001` 的挥发性层）。
    // 读 = `ui/console/piano_roll.slint` 的 `piano-roll-status` 那一行。
    in-out property <string> roll-edit-status: "";
    // ⭐ **最近一次"引擎发布失败"的原文**（任务单 `#86` 甲）。
    //
    // 写者**只有一处**：`host::apply_engine_error`（生产 60Hz 心跳与无头执行面共用它）。
    // 数据源 = `EngineHost::publish_project` 的 `Err` ⇒ `EngineHostError` 的 `Display` 原文。
    // 默认空串 = **本次会话还没有过引擎错误**，不是一个编造的读数。
    //
    // ⛔ 界面**不**自己清屏：`host::apply_engine_error` 只在**真的发布成功**那一跳写空串
    // （标记没变的那一跳一位不动）—— 否则 60Hz 心跳会让横幅闪一下就走，等于没做。
    in-out property <string> engine-error: "";
    callback open-musical-pr();
    callback accept-ai-proposal();
    callback reject-ai-proposal();
    callback run-acoustic-diagnosis();
    callback export-diagnostics();
    // `[UI-A11Y-002]` §7.2：BPM 敲入控件里真 `TextInput` 的合成态 / 焦点事件
    // （见 ui/transport.slint 的 `bpm-input`）。宿主 `host::wire_input` 把它翻成
    // `InputContext::begin_composition` / `end_composition` / `set_focus`。
    callback ime-composition-changed(bool);
    callback ime-focus-changed(bool);

    // =====================================================================
    // `N2` 裁决 (1)：GUI 路径的键盘事件源（**逻辑键**）
    // =====================================================================
    // Slint 的 `KeyEvent` 只有 `text` + `modifiers`，**没有物理码**
    // （`i-slint-common-1.18.1/builtin_structs.rs` 的 `KeyEvent { text, modifiers, repeat }`），
    // 而 `src/input.rs` 的扫描码表需要物理键身份 ⇒ GUI **只能**绑逻辑键。
    // 因此这个 `FocusScope` 是**唯一**的键盘事件源：它把 `event.text` 与四个修饰位
    // 原样交给宿主（`host::wire_keys` → `input::resolve_logical`，与无头端口的物理码路径
    // **共用同一张**快捷键策略表）。
    //
    // 参数顺序（Rust 侧 `on_key_action` 必须逐位对齐）：
    //   text, shift, control, alt, meta
    //
    // 返回值 = `.slint` 的 `EventResult`：
    //   `true`  ⇒ `accept`：这一键被 DAW 消费（不再冒泡，Slint 也不做 `Tab` 焦点轮转）；
    //   `false` ⇒ `reject`：交给焦点系统 / 文本控件（例如文本框里的 `Tab` 与单键、未绑定的键）。
    callback key-action(string, bool, bool, bool, bool) -> bool;
    // 为什么用 `forward-focus`：`FocusScope` 只有在 `has-focus`（或包住获得焦点的元素）时才收键；
    // `forward-focus` 让窗口建立时焦点就落在这里，因此快捷键**不需要先点一下界面**才生效
    // （判据 16 的端口注入就是这个前提的机械证据）。
    // 焦点被 BPM 敲入框拿走时，单键快捷键按 §7.1/§7.2 归文本控件 —— 那是规范语义，不是缺口；
    // 回到这里要靠 Slint 的焦点轮转（`Tab`）或程序性 `focus()`，**没有**自动回焦的判据（见 N2 行）。
    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (root.key-action(event.text, event.modifiers.shift, event.modifiers.control,
                                event.modifiers.alt, event.modifiers.meta)) {
                accept
            } else {
                reject
            }
        }
    }

    // =====================================================================
    // 模型投影注入面（**唯一写者** = src/host.rs 的 apply_view）
    // =====================================================================
    // 这些数组的默认值一律是**空**：界面里不再内联演示数据（上一版的债见
    // docs/ledger/ui-shell-notes.md pending 4）。规模（轨道数 / 剪辑数 / 段落数）
    // 由工程决定，因此 `.slint` 里不存在 `for … in 6` 这种把演示规模刻进界面的写法。
    //
    // 为什么长度与数据分两个来源：数组长度本身就是规模（`root.tracks.length`），
    // 因此不需要额外的 `track-count` 标量属性 —— 少一个可能与数组不一致的状态。
    in property <string> window-title: "夜半 Yeban";
    in property <[string]> track-names: [];
    // 编排行几何（行顶沿 y / 行高，逻辑像素）—— 由投影的前缀和算一次（ADR-0004 S0），
    // 与 `track-names` 同索引集；`.slint` 不再做 `42px + 56px * i`。
    in property <[length]> track-ys: [];
    in property <[length]> track-heights: [];
    // =====================================================================
    // 轨道高度的**会话/视图态**（ADR-0004 S1 / Q4-A）：宿主拥有、重新注入，零 schema。
    // =====================================================================
    // 这三个是**输入**（不是投影输出）：宿主读它们造投影参数，而投影算出的每行高仍从
    // `track-ys` / `track-heights` 注入（唯一注入实现仍是 `host::apply_view`）。
    // - `track-height-percent`：全局高度缩放级（100 = 不缩放）；
    // - `track-height-override-ids` / `-pxs`：按轨道**身份**（26 字符 EntityId 文本）
    //   配对的每轨基准高（整数逻辑像素）。用身份而不是下标，插/删轨道才不会把高度
    //   错配到别的轨道上（`UI-TEST-001` 的语义寻址口径）。
    // 进程退出即失（不持久化，见 `bridge::TrackHeightLayout` 的文档）。
    in-out property <int> track-height-percent: 100;
    in-out property <[string]> track-height-override-ids: [];
    in-out property <[length]> track-height-override-pxs: [];
    // 轨道身份的 26 字符 `EntityId` 规范文本，与 `track-names` / `track-ys` **同索引集**。
    // 它是**投影输出**（`ViewState::track_ids`），存在的理由只有一个：每轨高度覆盖按
    // **身份**键控，而拖拽手势落在轨道头上时只能报告**下标** ⇒ 宿主需要"下标 → 身份"
    // 这一格。没有它，宿主只能拿一个会在换工程后过期的快照去猜身份。
    in property <[string]> track-ids: [];
    // ⭐ 任务单 `#192`：**选中轨**（编辑器视图态）—— 26 字符身份文本，空串 = 没有明确选中。
    //
    // 唯一写者 = `host::wire_track_select`（轨道头点击）；唯一读点 = `host::selected_track_id`
    // （投影 / 设备 / 发送 / 铅笔的主语解析）。⛔ 它不是工程数据：不进 `.yeban`、
    // 不进 `projectDigest`、不进撤销栈、不进 `ViewState` 的摘要 —— 与 `roll-scroll-x` /
    // `roll-ticks-per-pixel` / `selected-ulids` 同属"进程退出即失"的视图态。
    in-out property <string> selected-track-id: "";
    // =====================================================================
    // 轨道高度**拖拽手势的进行态**（ADR-0004 S1 的纵向入口）：宿主拥有、界面只报事件。
    // =====================================================================
    // 这四个是宿主的手势状态机（不是第二份高度权威 —— 高度仍只住在上面那三个属性里，
    // 写入口仍只有 `host::set_track_height_override` 一处）。它们住在窗口上的理由与
    // `roll-scroll-x` 相同：宿主在两个回调之间要记住"这一拖是从哪一行的哪一个高度开始的"，
    // 而 `Escape`（`Action::Cancel`）也必须能读到同一份状态去收尾。
    //
    // `track-height-drag-active` 是"手势是否还没结束"的唯一读数：松开 / 离开窗口 /
    // `Escape` 三条收尾路径都必须把它写回 `false`（判据钉住"不留粘住的拖拽态"）。
    in-out property <bool> track-height-drag-active: false;
    in-out property <string> track-height-drag-track: "";
    in-out property <int> track-height-drag-start-px: 0;
    in-out property <float> track-height-drag-start-y: 0.0;
    // `ADR-0004` S1 的纵向拖拽手势（三个回调都由 `ui/workspace/arrangement_view.slint`
    // 的轨道头 `TouchArea` 发出；宿主侧唯一实现是 `host::wire_track_height_drag`）。
    /// 按下：`(轨道下标, 指针在轨道头坐标系里的 y)`。
    callback track-height-grab(int, length);
    /// 拖动：同一个下标、同一个坐标系里的当前 y（位移由宿主算）。
    callback track-height-drag(int, length);
    /// 收尾：松开 / 指针离开窗口（`PointerEventKind.cancel`）/ 打断。
    callback track-height-release(int);
    // ⭐ 任务单 `#192`：轨道头点击 ⇒ **选中这条轨**（界面只报下标；身份查表与
    // `selected-track-id` 的写入全在 `host::wire_track_select`）。
    //
    // ⛔ 它不是一次编辑：宿主**不**调用 `UndoPort::commit_ops`，因此 `commit_count` /
    // `undoable` / `projectDigest` 全部 Δ0 —— 选中是视图态，不是工程内容。
    /// 点击轨道头：`(轨道下标)`。
    callback track-select(int);
    // 混音台的**写入面**（`ADR-0005`：工程内容必须走 `Op` + `UndoPort`）。
    //
    // 形状与上面三个 `track-height-*` 同款：`.slint` 只报"哪一个下标 + 本地坐标"，
    // 位移换算、拖动期的视图态与松手时的**一次** `commit_ops` 全在宿主
    // （`host::wire_mixer_edit`）。五个成员 = 推子竖直拖 / 声相水平拖 / 两个开关。
    /// 推子按下（轨道下标, 推子面坐标系里的 y）。
    callback mixer-fader-grab(int, length);
    /// 推子拖动（同一个下标的当前 y；位移由宿主算）。
    callback mixer-fader-drag(int, length);
    /// 推子收尾（松手 / 指针离开窗口）。
    callback mixer-fader-release(int);
    /// 声相按下（轨道下标, 声相面坐标系里的 x）。
    callback mixer-pan-grab(int, length);
    /// 声相拖动。
    callback mixer-pan-drag(int, length);
    /// 声相收尾。
    callback mixer-pan-release(int);
    /// 静音按钮点击（一次点击 = 一次可撤销的编辑）。
    callback mixer-mute-toggle(int);
    /// 独奏按钮点击。
    callback mixer-solo-toggle(int);
    // ⭐ **SFZ 采样器绑定**（任务单 `#82`）—— 模型 `TrackV3::sampler`（`#76`）的**用户入口**。
    //
    // 形状与上面两个开关逐条同款（`.slint` 只报"哪一个下标（+ 输入框文本）"，`Op` 的构造、
    // 陈旧载荷比对与 `commit_ops` 全在宿主 `host::wire_mixer_sampler`）⇒ 一次 SET / CLR
    // = **恰好一步**可撤销的编辑。
    //
    // ⚠ 路径是**文本输入**而不是文件对话框：本仓没有文件对话框（原生选择器要引新依赖 ⇒
    // 必须先报批）⇒ 本单交最小可用的一条，见交付报告的"删减了什么"。
    /// SET：把该轨的采样器绑定设成 `Some(path)`（空文本**不提交**，见宿主的口径）。
    callback mixer-sampler-set(int, string);
    /// CLR：把该轨的采样器绑定设回 `None`（**解绑**；`None` 是一等状态，⛔ 不是"丢失"）。
    callback mixer-sampler-clear(int);
    // ⭐ **③ 浏览…**（任务单 `#86` 乙）：开一次**原生**文件对话框，把选中的路径**填进**
    // `track-{i}-sampler-path` 那个文本框。
    //
    // ⚠ 它与上面两条**不是同一类**：SET / CLR 是**工程内容**的提交（走 `Op` ＋ `UndoPort`），
    // 而本回调⛔ 不提交任何东西 —— 唯一落点 `host::wire_mixer_sampler_browse` 只写
    // 界面属性 `track-sampler-paths[i]`。用户随后照旧按 SET 提交
    // ⇒ **文本框与 CLI 两条路一位没变**（本单的硬要求）。
    callback mixer-sampler-browse(int);
    // ⭐ **设备效果链的写入面**（任务单 `#157`）：控制台 **Tab 3** 里的两个手势。
    //
    // 形状与 `mixer-*` 一族逐条同款：`.slint` 只报"哪一格 / 滑块位置"，取反 / 值域映射 /
    // 陈旧基线比对与**一次** `commit_ops` 全在宿主 `host::wire_device_rack`。
    // 因此一次点击 / 一次拖动 = **恰好一步**可撤销的编辑，且界面不持有工程值。
    //
    // ⭐ 任务单 `#182`：两个手势都携带**设备身份**（`device-ids[i]` /
    // `device-eq-device-id`，`DeviceDefinition::id` 的 26 字符文本），⛔ 不是行下标
    // —— 下标会在"投影之后、点击之前"随增删漂移，身份不会。
    /// 点击某台的旁通开关（参数 = 设备身份，⛔ 不是行下标）。
    callback device-bypass-toggle(string);
    /// EQ 低架增益按下（参数 = 设备身份 + 滑块面内的归一化位置 0.0–1.0）。
    callback device-eq-grab(string, float);
    /// EQ 低架增益拖动（同一个归一化位置；dB 换算与预览在宿主）。
    callback device-eq-drag(float);
    /// EQ 低架增益收尾（松手 / 指针离开窗口）⇒ 值真的变了才提交一次。
    callback device-eq-release();
    // ⭐ **设备增删 ＋ 建空片段**（任务单 `#163`）：控制台 **Tab 3** 同一面板里的三个按钮。
    //
    // 形状与 `device-*` / `track-*` 一族逐条同款：`.slint` 只报"按了哪个按钮 / 哪台设备"，
    // 参数缺省值、身份分配、目标解析与**一次** `commit_ops` 全在宿主
    // （`host::wire_device_rack` / `host::wire_clip_create`）。
    /// 装一台内置 EQ（参数取共享契约的缺省值）。
    callback device-insert-eq();
    /// 装一台内置混响（同上）。
    callback device-insert-reverb();
    /// 删除某台设备（参数 = 设备身份，⛔ 不是行下标）。
    callback device-remove(string);
    /// 建一个空的 MIDI 片段并摆到展示轨的 tick 0。
    callback clip-create();
    // ⭐ **主总线设备增删**（任务单 `#180`）：控制台 **Tab 3** 面板的**第二段**。
    //
    // 形状与上面三个设备手势逐条同款 —— 唯一的差别是**目标轨**：宿主显式选
    // `master_bus_track_id`（⛔ 不是展示轨）。一次点击 = 恰好一次 `commit_ops`。
    /// 给主总线装一台内置 EQ（参数取共享契约的缺省值）。
    callback master-device-insert-eq();
    /// 给主总线装一台内置混响（同上）。
    callback master-device-insert-reverb();
    /// 删除主总线上的某台设备（参数 = 设备身份，⛔ 不是行下标）。
    callback master-device-remove(string);
    // ⭐ ⭐ **主总线设备的旁通 ＋ EQ 低架增益**（任务单 `#181`）：与上面 `#157` 的两条
    // 展示轨手势**逐条同款**（同一个 `DeviceEqWiring` / `bypass_device`），唯一差别是
    // 目标轨 = `master_bus_track_id`。⭐ `#182` 起两条手势都携带**设备身份**
    // （`master-device-ids[i]` / `master-device-eq-device-id`），⛔ 不是下标。
    /// 点击主总线某台的旁通开关（参数 = 设备身份，⛔ 不是主总线设备链下标）。
    callback master-device-bypass-toggle(string);
    /// 主总线 EQ 低架增益按下（参数 = 设备身份 + 滑块面内的归一化位置 0.0–1.0）。
    callback master-device-eq-grab(string, float);
    /// 主总线 EQ 低架增益拖动。
    callback master-device-eq-drag(float);
    /// 主总线 EQ 低架增益收尾（值真的变了才提交一次）。
    callback master-device-eq-release();
    // ⭐ **一键装乐器**（任务单 `#164`）：控制台 Tab 3 的 `DeviceRack` 里。
    // 与上面两条同款 —— 只上报内置清单下标，路径 / Op / 一次 `commit_ops` 全在宿主
    // （`host::wire_device_rack`）。
    /// 装第 `i` 份内置 SFZ 乐器（参数 = 内置清单下标）。
    callback instrument-install(int);
    // ⭐ **发送条的写入面**（任务单 `#159`）：控制台 **Tab 3** 设备机架面板里的"发送"区。
    //
    // 形状与 `device-*` 一族逐条同款：`.slint` 只报"哪一条边 / 滑块位置"，dB 换算 /
    // 陈旧基线比对与**一次** `commit_ops` 全在宿主 `host::wire_send_strip`。
    // 三个滑块回调都携带**路由边身份**（`RoutingEdge::id` 的 26 字符文本）——
    // ⛔ 不用行下标当第二份身份。
    /// 发送增益按下（参数 = 路由边身份 + 滑块面内的归一化位置 0.0–1.0）。
    callback send-gain-grab(string, float);
    /// 发送增益拖动（同一个边身份 + 归一化位置；dB 换算与预览在宿主）。
    callback send-gain-drag(string, float);
    /// 发送增益收尾（松手 / 指针离开窗口）⇒ 值真的变了才提交一次。
    callback send-gain-release(string);
    /// 新建发送（目的地 = 身份序第一条 `AuxReturn` 轨；新边身份由宿主分配）。
    callback send-create();
    // ⭐ **轨 / 路由的写入面**（任务单 `#160`）：控制台 **Tab 3** 与发送条**同一面板**。
    //
    // 形状与 `send-*` 一族逐条同款：`.slint` 只报"按了哪个按钮 / 哪条边"，身份分配、
    // 目标解析、防重复与**一次** `commit_ops` 全在宿主 `host::wire_track_strip` /
    // `host::wire_send_strip`。因此一次点击 = **恰好一步**可撤销的编辑。
    /// 删除某一条发送（参数 = 路由边身份，⛔ 不是行下标）。
    callback send-remove(string);
    /// 新建 MIDI 轨。
    callback track-create-midi();
    /// 新建音频轨。
    callback track-create-audio();
    /// 新建辅助返回轨（`AuxReturn`）。
    callback track-create-aux();
    /// 删除展示轨（主总线不是目标）。
    callback track-delete();
    // ⭐ **导出 MIDI**（任务单 `#90` 甲）：把**当前工程**写成标准 MIDI 文件（`SMF 1`）。
    //
    // 事件源 = `ui/console/mixer_console.slint` 的 `module-export-midi-button`
    // （控制台 **Tab 1 = 调音台**里那条入口；它因此在**默认帧**里一个像素都不画 ⇒ 5 张
    // Linux 基准逐位不变）。落点是宿主 `host::wire_module_actions` 的 `export-midi` 分支，
    // 复用**已经存在**的 `crate::export_midi::export_project_to_file`（与 CLI 的
    // `--export-midi` 是**同一个**函数，⛔ 不另写一套导出器），回执走**既有**的
    // `module-status` 投影通道（与 `export-wav` 逐字同款）。
    // ⛔ 界面不写盘、不猜路径、不自己判断成功与否（那是第二个真相源）。
    callback export-midi();
    // ⭐ **打开工程**（任务单 `#93`）：**运行期换工程**在界面上的可见入口。
    //
    // 事件源 = `ui/console/mixer_console.slint` 的 `module-open-project-button`
    // （控制台 **Tab 1 = 调音台**里那条入口；与 `#90` 甲那条「导出 MIDI」同一个面板行 ——
    // 它因此在**默认帧**里一个像素都不画 ⇒ 5 张 Linux 基准逐位不变）。
    //
    // 落点是宿主 `host::wire_open_project`：问一次**可注入**的 `FilePicker`
    // （`#86` 乙 的 `yeban_app::file_picker::FilePicker`）⇒ 走**已经存在**的
    // `crate::open::open_project_file` 读盘 ⇒ 把撤销端口里的会话整体换成新的一份
    // （`UndoPort::open_project_session`，「打开一个工程 = **新会话**」）⇒ 重投影。
    // ⛔ 界面不读盘、不猜路径、不自己判断成功与否（那是第二个真相源）；回执走**既有**的
    // `module-status` 投影通道（与 `export-midi` / `export-wav` 逐字同款）。
    callback open-project();
    // ⭐ **新建工程**（任务单 `#129`）：**从零开始**在界面上的可见入口。
    //
    // 事件源 = `ui/console/mixer_console.slint` 的 `module-new-project-button`
    // （控制台 **Tab 1 = 调音台**里「打开工程」**正下方**那一格 ⇒ 默认帧一个像素都不画）。
    //
    // 落点是宿主 `host::wire_new_project`：问一次**同一个** `FilePicker::choose_save`
    // ⇒ `host::create_new_project_file`（`samples::default_project()` ＋
    // `save::save_archive_file`，与 CLI `--save-as` **同一条**写入口，1136 B／0 音轨 ＋ 1 主总线）⇒
    // **打开工程那条**换工程路径（`OpenProjectRuntime::open_runtime`）。
    // ⛔ 界面不写盘、不猜路径、不判断成功与否；回执走**既有**的 `module-status` 通道。
    callback new-project();
    // 主控通道条的**写入面**：与上面那六个手势逐条同形，唯一区别是**不带下标**
    // （主总线不在 `track-names` / `track-ids` 里 ⇒ 上面那些 `int` 参数没有合法值能指到它）。
    // 主总线身份由宿主在按下那一刻从权威工程取（`master_bus_track_id`），
    // 因此 `.slint` 里**没有**任何身份→下标的算术。
    /// 主控推子按下（推子面坐标系里的 y）。
    callback mixer-master-fader-grab(length);
    /// 主控推子拖动（当前 y；位移由宿主算）。
    callback mixer-master-fader-drag(length);
    /// 主控推子收尾（松手 / 指针离开窗口）。
    callback mixer-master-fader-release();
    /// 主控声相按下（声相面坐标系里的 x）。
    callback mixer-master-pan-grab(length);
    /// 主控声相拖动。
    callback mixer-master-pan-drag(length);
    /// 主控声相收尾。
    callback mixer-master-pan-release();
    // 混音台手势（推子 / 声相）的**进行态**读数：宿主拥有、界面只报事件。
    //
    // 与上面的 `track-height-drag-active` 同一个角色：它是"混音手势是否还没结束"的**唯一**
    // 窗口读数。三条收尾路径（松开 / 指针离开窗口 / `Escape`）都必须把它写回 `false`，
    // 因此不存在"取消之后一次孤立的 move 继续改音量"这种粘住的手势态。
    in-out property <bool> mixer-drag-active: false;
    /// 取消进行中的混音手势（推子竖直拖 / 声相水平拖）。
    ///
    /// 宿主侧唯一实现是 `host::wire_mixer_edit` 里的 `on_mixer_cancel_gesture`，
    /// 它把值写回**起点**（视图态）并**不提交** —— 与 `cancel_track_height_drag` 同口径。
    /// 返回 `true` = 确实有手势在手、已经取消；`false` = 此刻没有混音手势
    /// ⇒ `Escape` 与混音台无关，照旧放行（没人接线时 Slint 返回 `bool` 的默认值 `false`）。
    callback mixer-cancel-gesture() -> bool;
    in property <[string]> track-volumes: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];
    // ⭐ SFZ 采样器路径（`TrackV3::sampler` 的路径原文；`None` ⇒ `""`）——
    // 注入面与 `track-mutes` / `track-solos` 同族（`host::apply_view` 是唯一写者；
    // `ui.set_track_sampler_paths` 在 `src/host.rs`）。
    in property <[string]> track-sampler-paths: [];
    in property <[string]> scene-names: [];
    in property <[string]> section-names: [];
    in property <[length]> section-positions: [];
    in property <[length]> section-widths: [];
    in property <[string]> clip-ulids: [];
    in property <[string]> clip-labels: [];
    in property <[length]> clip-positions: [];
    in property <[length]> clip-widths: [];
    // 剪辑的行几何（y / 高，逻辑像素）—— 由投影从所在行派生（ADR-0004 S0）。
    in property <[length]> clip-ys: [];
    in property <[length]> clip-heights: [];
    in property <[length]> bar-positions: [];
    // 钢琴卷帘的音符身份与力度（`MidiNote::id` / `MidiNote::velocity` ÷ 127）
    in property <[string]> note-ulids: [];
    in property <[float]> note-velocities: [];
    // ⭐ 素材池（任务单 `#133`）：`clip_pool` 的行投影（名字 / 类型 / 可用字段）。
    // 唯一写者是 `host::apply_view`，唯一事实源是 `ViewState::asset_pool`。
    // 面板住在控制台 Tab 1（`MixerConsole` 里的 `AssetPoolPanel`）⇒ 默认帧不画它。
    in property <[string]> asset-pool-names: [];
    in property <[string]> asset-pool-kinds: [];
    in property <[string]> asset-pool-details: [];
    // ⭐ 设备效果链（任务单 `#157`）：`TrackV3::devices` 的逐条投影 ＋ 那一格可编辑的
    // `eq_low_gain`。唯一写者是 `host::apply_view`，唯一事实源是 `ViewState::devices` /
    // `ViewState::eq_low_gain`（⛔ 界面上没有第二份列表，也⛔ 没有第二份值域表）。
    // 面板住在控制台 Tab 3（`DeviceRack`）⇒ 默认帧不画它。
    in property <string> device-track-label: "";
    in property <[string]> device-names: [];
    // ⭐ 设备增删（任务单 `#163`）：每台的设备身份（删除按钮的寻址单位）。
    in property <[string]> device-ids: [];
    in property <[bool]> device-bypassed: [];
    in property <[string]> device-recognised: [];
    in property <[string]> device-unrecognised: [];
    in property <bool> device-eq-available: false;
    in property <float> device-eq-gain-db: 0.0;
    in property <float> device-eq-min-db: 0.0;
    in property <float> device-eq-max-db: 0.0;
    // ⭐ 任务单 `#182`：EQ 滑块的**设备身份**（`DeviceDefinition::id`，`""` = 没有目标）。
    // 手势把它原样带回宿主（`device-eq-grab(device-id, fraction)`）—— ⛔ 不是行下标。
    in property <string> device-eq-device-id: "";
    // ⭐ 设备增删 ＋ 建空片段（任务单 `#163`）：四个投影标量。唯一写者是
    // `host::apply_view`，唯一事实源是 `ViewState` 的同名字段。
    in property <bool> device-insert-available: false;
    in property <string> device-insert-reason: "";
    in property <bool> clip-create-available: false;
    in property <string> clip-create-reason: "";
    // ⭐ 主总线设备链（任务单 `#180`）：四个平行数组（名字 / 身份 / 已识别 / 未识别）
    // ＋ 三个投影标量（标题 / 可用性 / 逐字原因）。唯一写者是 `host::apply_view`，
    // 唯一事实源是 `ViewState::master_devices` 与同名字段 —— ⛔ 界面上没有第二份
    // 主总线设备列表。与设备链同住控制台 Tab 3 ⇒ 默认帧不画它。
    in property <string> master-device-label: "";
    in property <[string]> master-device-names: [];
    in property <[string]> master-device-ids: [];
    in property <[string]> master-device-recognised: [];
    in property <[string]> master-device-unrecognised: [];
    in property <bool> master-device-insert-available: false;
    in property <string> master-device-insert-reason: "";
    // ⭐ 主总线设备的两个可编辑面（任务单 `#181`）：逐台旁通位数组 ＋ 那一格 EQ 的
    // 可用性 / 当前值 / 值域 / 逐字原因。唯一写者是 `host::apply_view`，唯一事实源是
    // `ViewState::master_devices` 与 `ViewState::master_eq_low_gain`；值域来自效果器契约。
    in property <[bool]> master-device-bypassed: [];
    in property <bool> master-device-eq-available: false;
    in property <float> master-device-eq-gain-db: 0.0;
    in property <float> master-device-eq-min-db: 0.0;
    in property <float> master-device-eq-max-db: 0.0;
    in property <string> master-device-eq-reason: "";
    // ⭐ 任务单 `#182`：主总线 EQ 滑块的**设备身份**（⛔ 不是行下标）。
    in property <string> master-device-eq-device-id: "";
    // ⭐ 一键装乐器（任务单 `#164`）：当前乐器读数 ＋ 按钮名清单 ＋ 可用性 / 逐字原因。
    // 唯一写者是 `host::apply_view`，唯一事实源是 `ViewState` 的同名字段。
    in property <string> instrument-label: "未装乐器";
    in property <[string]> instrument-names: [];
    in property <bool> instrument-install-available: false;
    in property <string> instrument-install-reason: "";
    // ⭐ 发送条（任务单 `#159`）：展示轨的 `SendToAux` 边逐条投影 ＋ "新建发送"的可用性。
    // 唯一写者是 `host::apply_view`，唯一事实源是 `ViewState::sends` /
    // `ViewState::send_create_available` / `ViewState::send_create_reason`
    // （⛔ 界面上没有第二份发送列表，也⛔ 没有第二份增益范围表 —— 值域来自模型）。
    // 与设备链同住控制台 Tab 3 ⇒ 默认帧不画它。
    in property <[string]> send-edge-ids: [];
    in property <[string]> send-destination-names: [];
    in property <[string]> send-gain-labels: [];
    in property <[float]> send-gain-dbs: [];
    in property <float> send-gain-min-db: 0.0;
    in property <float> send-gain-max-db: 0.0;
    in property <bool> send-create-available: false;
    in property <string> send-create-reason: "";
    // ⭐ 轨 / 路由（任务单 `#160`）：轨数读数 ＋ 建轨 / 删展示轨的可用性与逐字原因。
    // 唯一写者是 `host::apply_view`，唯一事实源是 `ViewState` 的同名字段。
    // 与发送条同住控制台 Tab 3 ⇒ 默认帧不画它。
    in property <string> routing-count-label: "";
    in property <bool> routing-create-available: false;
    in property <string> routing-master-label: "";
    in property <bool> routing-delete-available: false;
    in property <string> routing-delete-reason: "";
    // 卷帘音符的位置（x / y / 宽，逻辑像素）—— 由 `start_tick` / `pitch` 整数派生，
    // 见 `src/bridge.rs` 的 `NoteView`（界面不做任何位置算术）。
    /// `[ROAD-M3-002]` 卷帘滚动手势（由宿主接管并重新注入）。
    callback scroll-requested(length);
    /// `[UI-NOTE-003]` 卷帘左键单击（坐标由界面报告, 语义由宿主决定）。
    callback clicked(length, length);
    /// `[UI-NOTE-003]` §3.3 aux 列的**双击**（力度工具 = "双击恢复默认力度 100"）。
    /// 与 `clicked` 逐字同一帧、同一个宿主派发器（`host::install_roll_click`）——
    /// 界面只报告"第二拍落在哪"，工具门 / 命中 / 一个原子 `Op` 全在宿主。
    callback double-clicked(length, length);
    /// `[UI-NOTE-003]` §3.3 工具矩阵的点击（工具行号 1..5）。
    /// 唯一落点是 `host::wire_tool_select` → `host::apply_action` 的
    /// `Action::SelectTool` 臂 —— 与 `1`..`5` 数字键**同一条**链。
    callback tool-selected(int);
    /// `[UI-NOTE-003]` 卷帘左键**拖拽**的手势通道（工具矩阵"左键拖拽"列；本切片只接
    /// 选择工具的移动臂）。四条与 `track-height-*` / `mixer-*` 逐条同形：`.slint` 只报
    /// "指针在哪、按下了 / 移动了 / 抬起了 / 被取消了"，工具门、命中、草稿与"抬起恰好一个
    /// 原子 `Op`"全在宿主（`host::wire_roll_edit` → `install_roll_note_drag`）。
    /// `grab` 返回 `true` = 宿主**接管**这次手势 ⇒ 本组件不把它当滚动。
    callback note-drag-grab(length, length) -> bool;
    /// 接管后的拖动（绘制帧坐标）⇒ 宿主只更新**草稿**，⛔ 不写工程。
    callback note-drag-move(length, length);
    /// 松手（绘制帧坐标）⇒ 宿主至多提交**一个**原子 `Op`。
    callback note-drag-release(length, length);
    /// 指针离开窗口 / 控件被禁用（`PointerEventKind.cancel`）⇒ 丢弃草稿。
    callback note-drag-cancel();
    /// 被拖音符的身份（空 = 没有手势）与拖动期的草稿预览位移（逻辑像素，宿主算好注入）。
    /// 它们住在窗口上的理由与 `roll-scroll-x` 相同：宿主要在 `grab` / `move` / `release`
    /// 三条回调之间记住"这一拖从哪个音符、哪个指针位置开始"，而 `Escape`
    /// （`Action::Cancel` → `host::cancel_note_drag`）也必须能读到同一份状态去收尾。
    /// `note-drag-active` 是"手势是否还没结束"的唯一读数：松手 / 离开窗口 / `Escape`
    /// 三条收尾路径都必须把它写回 `false`（判据钉住"不留粘住的拖拽态"）。
    in-out property <bool> note-drag-active: false;
    in-out property <float> note-drag-origin-x: 0.0;
    in-out property <float> note-drag-origin-y: 0.0;
    in-out property <string> note-drag-ulid: "";
    in-out property <float> note-drag-preview-dx: 0.0;
    in-out property <float> note-drag-preview-dy: 0.0;
    /// `[UI-NOTE-003]` **力度臂**的两个读数（与移动臂共用同一条手势通道 `note-drag-*`）：
    /// `note-drag-preview-velocity` = 拖动期的草稿力度（0.0–1.0 归一化，宿主算好注入）；
    /// `velocity-drag-active` = "力度手势是否还没结束"的唯一读数（松手 / 离开窗口 / `Escape`
    /// 三条收尾路径都必须写回 `false`）。
    /// ⚠ 身份**不另开一个属性**：被拖的是哪一个音符只有 `note-drag-ulid` 一个读数
    /// （两个同义字符串属性 = 第二个真相源，而且界面只可能按其中一个画预览）。
    in-out property <float> note-drag-preview-velocity: 0.0;
    in-out property <bool> velocity-drag-active: false;
    /// `[UI-NOTE-003]` 力度车道顶沿在**卷帘局部坐标系**里的位置（逻辑像素）。
    /// 由 `.slint` 从车道元素**上报**（`ConsoleTabs` → `PianoRoll` 的 `velocity-lane.y`）；
    /// 宿主读它把指针 y 反解成"车道内 y"（= 绝对力度）—— ⛔ 宿主那边没有第二份 `height - 44`。
    out property <length> roll-velocity-lane-top: console-tabs.velocity-lane-top;
    /// `[ROAD-M3-002]` 卷帘当前水平偏移（逻辑像素）。
    /// 用 `<float>` 而非 `<length>`：宿主只需读写一个数，避免 `f32 -> Length` 转换与组件链转发。
    in-out property <float> roll-scroll-x: 0.0;
    /// 时间轴的**横向缩放**（每逻辑像素多少 tick；越大越缩小）。
    ///
    /// 它由宿主拥有（与 `track-height-percent` / `roll-scroll-x` 同款"宿主拥有、重新注入"）：
    /// 写入口只有 `host::set_roll_ticks_per_pixel` 一处，读点只有
    /// `host::roll_ticks_per_pixel`（唯一）。**进程退出即失**（零 schema、不进 `.yeban`、
    /// 不进撤销栈）—— 缩放是**视图态**，与 `ADR-0004` Q5 的裁决同口径。
    /// 默认值与 `bridge::DEFAULT_TICKS_PER_PIXEL` 同值；`<= 0` 或超出
    /// `bridge` 的 `MIN/MAX_TICKS_PER_PIXEL` 时宿主回退到默认值。
    in-out property <int> roll-ticks-per-pixel: 30;
    /// `[UI-NOTE-001]` 步骤 ①：当前视口的 tick 上下界（由宿主按裁剪窗口算出）。
    /// 用 `<int>`：i32 在 960 PPQ 下可表示约 8.9 天音频, 且**精确**（`<float>` 在 2^24=1677 万 tick 以上会丢整数精度,
    /// 而本项目 10 万音符夹具已跨 2400 万 tick）。转换必须**饱和**, 不得回绕（见 `tick_to_i32_saturating` 的判据）。
    in-out property <int> roll-min-tick: 0;
    in-out property <int> roll-max-tick: 0;
    /// `[UI-NOTE-003]` 当前选中的音符数（供判据观测；真正的选中高亮走 `note-selected` 数组, 见账本第 223 轮）。
    in-out property <int> selected-note-count: 0;
    /// `[UI-NOTE-003]` 与可见数组**同一索引集**的选中标志（宿主注入；界面只取下标）。
    in-out property <[bool]> note-selected: [];
    /// `[UI-NOTE-003]` 当前卷帘工具（1..5）。镜像到窗口是为了让**宿主**能读到它：
    /// 没有这个镜像, 宿主无从知道该按哪个工具的语义处理点击（账本第 258 轮）。
    in-out property <int> active-tool: 1;
    /// `[UI-NOTE-003]` 当前选中的音符 ULID（**单一事实源**：`apply_view` 每次注入都由它重算标志）。
    in-out property <[string]> selected-ulids: [];
    /// `[UI-NOTE-001]` 步骤 ①（纵向）：可见音高上下界。
    /// 由**固定 16 条泳道**推出（见 `visible_pitch_range` 的判据）；纵向范围若将来变成动态,
    /// 泳道数必须来自 `.slint` 而不是宿主硬编码（账本第 202 轮）。
    in-out property <int> roll-min-pitch: 0;
    in-out property <int> roll-max-pitch: 0;
    in property <[length]> note-positions: [];
    in property <[length]> note-ys: [];
    in property <[length]> note-widths: [];
    // 轨道色标：`[color]` = 解析后的 RGB；`track-color-labels` = 同一个色的 `#RRGGBB` 文本
    // （进无障碍标签，让色标在控件树里可读）。
    in property <[color]> track-colors: [];
    in property <[string]> track-color-labels: [];

    // =====================================================================
    // 自动化泳道的注入面（`src/automation.rs` 的投影 → `ArrangementView`）
    // =====================================================================
    // 9 个平行数组：每条泳道一个成员。折线顶点与数值都是**投影算好的**逻辑像素 / 文本，
    // `.slint` 不做任何算术；`accessible-label` 携带单位与当前值，因此"AI/判据能读到
    // 自动化"有机械证据（不是"画了几条线"）。求值一律走模型的唯一入口，界面与投影层
    // 都没有第二份插值实现。
    in property <[string]> automation-lane-target-keys: [];
    in property <[int]> automation-lane-track-indexes: [];
    in property <[string]> automation-lane-labels: [];
    in property <[string]> automation-lane-axis-labels: [];
    in property <[length]> automation-lane-band-ys: [];
    in property <[length]> automation-lane-band-heights: [];
    in property <[bool]> automation-lane-read-enabled: [];
    in property <[string]> automation-lane-badges: [];
    in property <[string]> automation-path-commands: [];

    // =====================================================================
    // 混音台电平注入面（[ARCH-UI-002] 的"UI 线程定时器批量出队更新 Slint Properties"）
    // =====================================================================
    // 推子位置（0.0–1.0）由工程的 `TrackV3::volume_db` 派生 —— 与电平柱高是**两个量**：
    // 推子说"我把这条轨设到多大声"，电平说"它现在多大声"（`src/bridge.rs` 的
    // `volume_fraction` 与 `src/meters.rs` 的 `peak_fraction` 各有一份判据）。
    in property <[float]> track-volume-fractions: [];
    // 声相文本（`"C"` / `"L50"` / `"R30"`）—— 由投影的整数千分之一派生。
    in property <[string]> track-pans: [];
    // 电平：`{:.1}` dBFS 文本 + 0.0–1.0 柱高。长度**恒等于** `track-names.length`
    // （换工程时 `host::apply_view` 先重置成等长的静音，`apply_meters` 再填真实读数）。
    in property <[string]> track-meter-peaks: [];
    in property <[string]> track-meter-rmss: [];
    in property <[float]> track-meter-levels: [];
    // 主控通道条（投影 + 电平）
    in property <string> master-name: "Master";
    in property <string> master-volume-display: "";
    in property <float> master-volume-fraction: 0.0;
    in property <string> master-pan: "C";
    in property <bool> master-mute: false;
    in property <bool> master-solo: false;
    in property <color> master-color: #2c3a63;
    in property <string> master-color-label: "";
    in property <string> master-meter-peak: "-120.0";
    in property <string> master-meter-rms: "-120.0";
    in property <float> master-meter-level: 0.0;

    title: root.window-title;
    // 演示窗口落在 §1.2 的"全展开"档 (≥1920×1080): 左栏 240 + 主区 + 右栏 280,
    // 中段与底部控制台各占弹性区的 60% / 40% (规范要 55–65% / 35–45%)。
    // 与 `DemoScene::demo()` 的 viewport_width/height 保持一致 —— 不一致会让
    // `compact` 的取值和实际窗口宽度对不上。
    // ⭐ `#183`：这里原来钉着 `width: 1920px; height: 1080px;`。钉死的根尺寸 = **窗口不可
    // 缩小**：窗口被拉到 1440×900 时，Slint 仍按 1920×1080 排版，再**裁掉**右下角 ⇒
    // 底部控制台的下沿（以及设备架两段的下半部分）落在窗口外。现在尺寸交给**后端**
    // （下面那个 `VerticalLayout` 的 `preferred-*` 只给**初值** 1920×1080），
    // `root.width` / `root.height` 从此是**真实窗口尺寸**。
    background: Tokens.bg-void;

    // =====================================================================
    // 外壳网格 [UI-GRID-001]
    // =====================================================================
    VerticalLayout {
        // ⭐ `#183`：初值仍是 1920×1080（= §1.2 的"全展开"档与 `DemoScene::demo()` 的
        // viewport），但它是**首选**尺寸而不是硬约束 —— 窗口被拉小时布局跟着缩。
        preferred-width: 1920px;
        preferred-height: 1080px;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        // ---------------------------------------------------------- 48px 顶栏
        Transport {
            // ⚠ 录音键是**子组件**上的控件 ⇒ `recording` 必须**双向绑**：宿主写的是
            // `root.recording`，而 `accessible-checked` 读的是子组件里那一份。
            // 单向（`recording: root.recording;`）会让宿主写的值**到不了**按钮 ⇒
            // 那正是"控件存在 ≠ 回调接线"的同族假象。
            recording <=> root.recording;
            playing: root.playing;
            timecode: root.timecode;
            bpm-display: root.bpm-display;
            branch-name: root.branch-name;
            arrangement-view: root.arrangement-view;
            ai-drawer-open: root.ai-drawer-open;

            // ⚠ 界面**不**自己翻转 `root.playing`：那个属性只有一个写者 ——
            // `src/host.rs` 的 `apply_transport`（读的是引擎的原子读数）。
            // 这一版删掉的 `root.playing = !root.playing;` 正是"控件存在 ≠ 回调接线"
            // 那类假象的来源（`docs/ledger/feature-alignment.md` 错位 7）。
            toggle-play => {
                root.toggle-play();
            }
            stop => {
                root.stop();
            }
            // ⭐ 录音键：原样转给宿主（⛔ 界面不写 `recording` —— 那是宿主的状态）。
            toggle-record => {
                root.toggle-record();
            }
            // `ROAD-M4-008`：保存按钮**原样**转给宿主 —— 界面不写盘、不改 `save-status`
            // （那个属性只有宿主一个写者，见 `host::apply_save_outcome`）。
            save-project => {
                root.save-project();
            }
            // ⚠ 界面**不**自己翻转 `root.arrangement-view` / `root.ai-drawer-open`：
            // 这两个属性与 `playing` 同款 —— 唯一写者是宿主（`host::wire_view_callbacks`，
            // 与键盘路径的 `host::apply_action` 写的是**同一个**属性）。
            // 转发块里再翻转一次就会有两个真相源（`docs/ledger/feature-alignment.md` 错位 7）。
            toggle-view => {
                root.toggle-view();
            }
            show-session => { root.arrangement-view = false; }
            show-arrangement => { root.arrangement-view = true; }
            toggle-ai-drawer => {
                root.toggle-ai-drawer();
            }
            // 顶栏那枚 AI 徽章：它原先 `accessible-role: button` 却**没有点击源**、
            // 也没有回调，还写着"待审查 (1)"这个没有任何数据源的读数（= 假控件 +
            // 假状态）。现在它有**一个真实动作**：打开同一个提案抽屉 —— 与右栏的
            // `ai-rail-musical-pr-button` 落到**同一个** `open-musical-pr` 回调
            // （唯一写者仍是 `host::wire_view_callbacks`），因此不产生第二个真相源。
            open-ai-proposals => {
                root.open-musical-pr();
            }
            // §7.2：合成态 / 焦点是**事件**，不是状态 —— 界面原样转给宿主，
            // 由宿主写进 `InputContext`（界面不存"我是不是在合成"）。
            ime-composition-changed(composing) => {
                root.ime-composition-changed(composing);
            }
            ime-focus-changed(focused) => {
                root.ime-focus-changed(focused);
            }
        }

        // ------------------------------------------- 中段 (弹性区的 60%)
        HorizontalLayout {
            vertical-stretch: Tokens.workspace-stretch;

            // 240px 左资源栏 (compact 时 36px 图标导轨)
            Sidebar {
                compact: root.compact || root.sidebar-collapsed;
                min-width: (root.compact || root.sidebar-collapsed) ? Tokens.left-rail-collapsed-width : Tokens.left-rail-width;
                max-width: (root.compact || root.sidebar-collapsed) ? Tokens.left-rail-collapsed-width : Tokens.left-rail-width;

                // 同 `toggle-view`：折叠态是**视图态**，唯一写者是 `host::wire_view_callbacks`
                // （键盘路径的 `Action::ToggleSidebar` 也写同一个属性）。
                toggle-collapse => {
                    root.toggle-sidebar();
                }
            }

            // 主工作区: 双视图同构投射, 同一时刻只显示一个 [规范 §2.1]
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                background: Tokens.bg-shell;

                SessionView {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: !root.arrangement-view;
                    tracks: root.track-names;
                    scenes: root.scene-names;
                }

                ArrangementView {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.arrangement-view;
                    tracks: root.track-names;
                    // ⭐ 任务单 `#192`：选中态按**身份**键控（无障碍 `accessible-item-selected`
                    // 读它）。两个属性都是从根转发的**同一份**注入（⛔ 界面不造第二份表）。
                    track-ids: root.track-ids;
                    selected-track-id: root.selected-track-id;
                    track-ys: root.track-ys;
                    track-heights: root.track-heights;
                    // ⭐ 任务单 `#192`：轨道头点击 ⇒ 选中（界面只报下标）。
                    track-select(track_index) => {
                        root.track-select(track_index);
                    }
                    // `ADR-0004` S1 的纵向入口：轨道头 `TouchArea` 的事件原样转给宿主
                    // （界面不做位移 / 像素 / 夹紧中的任何一件）。
                    track-height-grab(track_index, pointer_y) => {
                        root.track-height-grab(track_index, pointer_y);
                    }
                    track-height-drag(track_index, pointer_y) => {
                        root.track-height-drag(track_index, pointer_y);
                    }
                    track-height-release(track_index) => {
                        root.track-height-release(track_index);
                    }
                    // 静音 / 独奏开关：点击原样上抛给宿主，界面不改任何工程值。
                    // 落点是 MainWindow 上**已有**的两条回调 —— 它们的唯一实现
                    // （`host::wire_mixer_switch`）按下标查宿主注入的 `track-ids`，
                    // 与编排视图包头的 `track_index` 同一索引集。
                    track-mute-toggle(track_index) => {
                        root.mixer-mute-toggle(track_index);
                    }
                    track-solo-toggle(track_index) => {
                        root.mixer-solo-toggle(track_index);
                    }
                    track-volumes: root.track-volumes;
                    track-mutes: root.track-mutes;
                    track-solos: root.track-solos;
                    sections: root.section-names;
                    section-positions: root.section-positions;
                    section-widths: root.section-widths;
                    clip-ulids: root.clip-ulids;
                    clip-labels: root.clip-labels;
                    clip-positions: root.clip-positions;
                    clip-widths: root.clip-widths;
                    clip-ys: root.clip-ys;
                    clip-heights: root.clip-heights;
                    bar-positions: root.bar-positions;
                    track-colors: root.track-colors;
                    track-color-labels: root.track-color-labels;
                    automation-lane-target-keys: root.automation-lane-target-keys;
                    automation-lane-track-indexes: root.automation-lane-track-indexes;
                    automation-lane-labels: root.automation-lane-labels;
                    automation-lane-axis-labels: root.automation-lane-axis-labels;
                    automation-lane-band-ys: root.automation-lane-band-ys;
                    automation-lane-band-heights: root.automation-lane-band-heights;
                    automation-lane-read-enabled: root.automation-lane-read-enabled;
                    automation-lane-badges: root.automation-lane-badges;
                    automation-path-commands: root.automation-path-commands;
                }
            }

            // 280px 右 AI 协作栏 (compact 时宽度归零, 改由下面的抽屉承担)
            AiRail {
                visible: !root.compact;
                min-width: root.compact ? 0px : Tokens.right-rail-width;
                max-width: root.compact ? 0px : Tokens.right-rail-width;

                // 打开抽屉是**视图态**，唯一写者是宿主（`host::wire_view_callbacks`）。
                open-musical-pr => { root.open-musical-pr(); }
                run-acoustic-diagnosis => { root.run-acoustic-diagnosis(); }
                export-diagnostics => { root.export-diagnostics(); }
                // 四个模块入口：与上面三条同款 —— 原样上抛，界面不改任何状态。
                // 两条注入属性由宿主单向写入（唯一写者 = `host::wire_module_actions`）。
                module-status: root.module-status;
                module-status-succeeded: root.module-status-succeeded;
                module-midi-in-status: root.module-midi-in-status;
                module-midi-in-status-succeeded: root.module-midi-in-status-succeeded;
                export-wav => { root.export-wav(); }
                import-midi => { root.import-midi(); }
                load-sfz => { root.load-sfz(); }
                record-wav => { root.record-wav(); }
                midi-in => { root.midi-in(); }
            }
        }

        // ---------------------------------------------------------- 4px splitter
        // [UI-GRID-002] 拖拽范围硬限 220–600px; 真实的拖拽 + 双击居中
        // 需要指针捕获状态机 (规范 §6.1), 本骨架只登记几何与语义值。
        Rectangle {
            min-height: Tokens.splitter-height;
            max-height: Tokens.splitter-height;
            background: Tokens.line-strong;

            accessible-role: slider;
            accessible-id: "splitter-workspace-console";
            accessible-label: "主工作区与底部控制台的分割线 (220–600px)";
            accessible-orientation: horizontal;
            accessible-value-minimum: 220;
            accessible-value-maximum: 600;
            accessible-value-step: 1;
            accessible-value: "320";
        }

        // --------------------------------------- 底部控制台 (弹性区的 40%)
        console-tabs := ConsoleTabs {
            vertical-stretch: Tokens.console-stretch;
            active-tab: root.console-tab;
            note-ulids: root.note-ulids;
            note-velocities: root.note-velocities;
            note-positions: root.note-positions;
            note-selected: root.note-selected;
            active-tool: root.active-tool;
            roll-edit-status: root.roll-edit-status;
            scroll-requested(d) => { root.scroll-requested(d); }
            clicked(x, y) => { root.clicked(x, y); }
            double-clicked(x, y) => { root.double-clicked(x, y); }
            tool-selected(tool) => { root.tool-selected(tool); }
            note-drag-grab(x, y) => { root.note-drag-grab(x, y); }
            note-drag-move(x, y) => { root.note-drag-move(x, y); }
            note-drag-release(x, y) => { root.note-drag-release(x, y); }
            note-drag-cancel() => { root.note-drag-cancel(); }
            note-drag-ulid: root.note-drag-ulid;
            note-drag-preview-dx: root.note-drag-preview-dx;
            note-drag-preview-dy: root.note-drag-preview-dy;
            note-drag-preview-velocity: root.note-drag-preview-velocity;
            note-ys: root.note-ys;
            note-widths: root.note-widths;
            // ⭐ 素材池（`#133`）：透传到 `MixerConsole` 的 `AssetPoolPanel`（Tab 1）。
            asset-pool-names: root.asset-pool-names;
            asset-pool-kinds: root.asset-pool-kinds;
            asset-pool-details: root.asset-pool-details;
            // ⭐ 设备效果链（任务单 `#157`）：透传到 `DeviceRack`（Tab 3）—— 本窗口只做
            // 单向搬运，⛔ 不解释、⛔ 不持有第二份列表 / 值域。
            device-track-label: root.device-track-label;
            device-names: root.device-names;
            device-ids: root.device-ids;
            device-bypassed: root.device-bypassed;
            device-recognised: root.device-recognised;
            device-unrecognised: root.device-unrecognised;
            device-eq-available: root.device-eq-available;
            device-eq-gain-db: root.device-eq-gain-db;
            device-eq-min-db: root.device-eq-min-db;
            device-eq-max-db: root.device-eq-max-db;
            // ⭐ 任务单 `#182`：EQ 手势的**设备身份**（⛔ 不是下标）。
            device-eq-device-id: root.device-eq-device-id;
            // ⭐ 设备增删 ＋ 建空片段（任务单 `#163`）：四个投影标量，只做单向搬运。
            device-insert-available: root.device-insert-available;
            device-insert-reason: root.device-insert-reason;
            clip-create-available: root.clip-create-available;
            clip-create-reason: root.clip-create-reason;
            // ⭐ 主总线设备链（任务单 `#180`）：同样只做单向搬运。
            master-device-label: root.master-device-label;
            master-device-names: root.master-device-names;
            master-device-ids: root.master-device-ids;
            master-device-recognised: root.master-device-recognised;
            master-device-unrecognised: root.master-device-unrecognised;
            master-device-insert-available: root.master-device-insert-available;
            master-device-insert-reason: root.master-device-insert-reason;
            // ⭐ 主总线设备的旁通 ＋ EQ（任务单 `#181`）：同样只做单向搬运。
            master-device-bypassed: root.master-device-bypassed;
            master-device-eq-available: root.master-device-eq-available;
            master-device-eq-gain-db: root.master-device-eq-gain-db;
            master-device-eq-min-db: root.master-device-eq-min-db;
            master-device-eq-max-db: root.master-device-eq-max-db;
            master-device-eq-reason: root.master-device-eq-reason;
            // ⭐ 任务单 `#182`：主总线 EQ 手势的**设备身份**（⛔ 不是下标）。
            master-device-eq-device-id: root.master-device-eq-device-id;
            instrument-label: root.instrument-label;
            instrument-names: root.instrument-names;
            instrument-install-available: root.instrument-install-available;
            instrument-install-reason: root.instrument-install-reason;
            // ⭐ 发送条（任务单 `#159`）：同样只做单向搬运，⛔ 不解释、⛔ 不持有第二份
            // 发送列表 / 增益范围（值域来自模型，经 `host::apply_view` 注入）。
            send-edge-ids: root.send-edge-ids;
            send-destination-names: root.send-destination-names;
            send-gain-labels: root.send-gain-labels;
            send-gain-dbs: root.send-gain-dbs;
            send-gain-min-db: root.send-gain-min-db;
            send-gain-max-db: root.send-gain-max-db;
            send-create-available: root.send-create-available;
            send-create-reason: root.send-create-reason;
            // ⭐ 轨 / 路由（任务单 `#160`）：同样只做单向搬运，⛔ 不解释、⛔ 不自己算
            // "能不能建 / 删"（可用性与逐字原因都来自投影）。
            routing-count-label: root.routing-count-label;
            routing-create-available: root.routing-create-available;
            routing-master-label: root.routing-master-label;
            routing-delete-available: root.routing-delete-available;
            routing-delete-reason: root.routing-delete-reason;
            // 调音台通道条（Tab 2）：投影 + 引擎电平，全部由 host.rs 单向注入。
            track-names: root.track-names;
            track-volumes: root.track-volumes;
            track-volume-fractions: root.track-volume-fractions;
            track-pans: root.track-pans;
            track-mutes: root.track-mutes;
            track-solos: root.track-solos;
            track-sampler-paths: root.track-sampler-paths;
            track-colors: root.track-colors;
            track-color-labels: root.track-color-labels;
            track-meter-peaks: root.track-meter-peaks;
            track-meter-rmss: root.track-meter-rmss;
            track-meter-levels: root.track-meter-levels;
            master-name: root.master-name;
            master-volume-display: root.master-volume-display;
            master-volume-fraction: root.master-volume-fraction;
            master-pan: root.master-pan;
            master-mute: root.master-mute;
            master-solo: root.master-solo;
            master-color: root.master-color;
            master-color-label: root.master-color-label;
            master-meter-peak: root.master-meter-peak;
            master-meter-rms: root.master-meter-rms;
            master-meter-level: root.master-meter-level;

            select-piano-roll => { root.console-tab = 0; }
            select-mixer => { root.console-tab = 1; }
            select-devices => { root.console-tab = 2; }

            // ⭐ 设备效果链（Tab 3）的写入面：只上抛，唯一落点 `host::wire_device_rack`
            // （`ADR-0005`：工程内容必须走 `Op` + `UndoPort`，⛔ 界面不改任何工程值）。
            // ⭐ `#182`：旁通与 EQ 按下都上抛**设备身份**，⛔ 不是下标。
            device-bypass-toggle(device-id) => {
                root.device-bypass-toggle(device-id);
            }
            device-eq-grab(device-id, fraction) => {
                root.device-eq-grab(device-id, fraction);
            }
            device-eq-drag(fraction) => {
                root.device-eq-drag(fraction);
            }
            device-eq-release() => {
                root.device-eq-release();
            }
            // ⭐ 设备增删 ＋ 建空片段（Tab 3，任务单 `#163`）：只上抛 —— 唯一落点是
            // `host::wire_device_rack`（装 / 删）与 `host::wire_clip_create`（建片段）。
            device-insert-eq() => {
                root.device-insert-eq();
            }
            device-insert-reverb() => {
                root.device-insert-reverb();
            }
            device-remove(device-id) => {
                root.device-remove(device-id);
            }
            clip-create() => {
                root.clip-create();
            }
            // ⭐ 主总线设备增删（Tab 3，任务单 `#180`）：只上抛 —— 唯一落点仍是
            // `host::wire_device_rack`（与展示轨那两个手势同一份实现体，目标轨不同）。
            master-device-insert-eq() => {
                root.master-device-insert-eq();
            }
            master-device-insert-reverb() => {
                root.master-device-insert-reverb();
            }
            master-device-remove(device-id) => {
                root.master-device-remove(device-id);
            }
            // ⭐ 主总线设备的旁通 ＋ EQ（Tab 3，任务单 `#181` / `#182`）：只上抛 —— 唯一
            // 落点是 `host::wire_device_rack` 的 `bypass_device` / `DeviceEqWiring`（与展示轨
            // 那两条手势**同一份**实现体，`DeviceTarget` 不同）。参数是**设备身份**。
            master-device-bypass-toggle(device-id) => {
                root.master-device-bypass-toggle(device-id);
            }
            master-device-eq-grab(device-id, fraction) => {
                root.master-device-eq-grab(device-id, fraction);
            }
            master-device-eq-drag(fraction) => {
                root.master-device-eq-drag(fraction);
            }
            master-device-eq-release() => {
                root.master-device-eq-release();
            }
            instrument-install(index) => {
                root.instrument-install(index);
            }
            // ⭐ 发送条（Tab 3）的写入面：只上抛，唯一落点 `host::wire_send_strip`
            // （`ADR-0005`：工程内容必须走 `Op` + `UndoPort`，⛔ 界面不改任何工程值）。
            // 三个滑块回调携带**路由边身份**，⛔ 不是行下标。
            send-gain-grab(edge-id, fraction) => {
                root.send-gain-grab(edge-id, fraction);
            }
            send-gain-drag(edge-id, fraction) => {
                root.send-gain-drag(edge-id, fraction);
            }
            send-gain-release(edge-id) => {
                root.send-gain-release(edge-id);
            }
            send-create() => {
                root.send-create();
            }
            // ⭐ 轨 / 路由（Tab 3）的写入面：只上抛，唯一落点 `host::wire_track_strip`
            // 与 `host::wire_send_strip`（`ADR-0005`：工程内容必须走 `Op` + `UndoPort`，
            // ⛔ 界面不改任何工程值）。删除发送携带**路由边身份**，⛔ 不是行下标。
            send-remove(edge-id) => {
                root.send-remove(edge-id);
            }
            track-create-midi() => {
                root.track-create-midi();
            }
            track-create-audio() => {
                root.track-create-audio();
            }
            track-create-aux() => {
                root.track-create-aux();
            }
            track-delete() => {
                root.track-delete();
            }

            // 混音台写入面：只上抛，不在 `.slint` 里改任何工程值
            // （`ADR-0005`：工程内容必须走 `Op` + `UndoPort`，落点是 `host::wire_mixer_edit`）。
            mixer-fader-grab(index, y) => {
                root.mixer-fader-grab(index, y);
            }
            mixer-fader-drag(index, y) => {
                root.mixer-fader-drag(index, y);
            }
            mixer-fader-release(index) => {
                root.mixer-fader-release(index);
            }
            mixer-pan-grab(index, x) => {
                root.mixer-pan-grab(index, x);
            }
            mixer-pan-drag(index, x) => {
                root.mixer-pan-drag(index, x);
            }
            mixer-pan-release(index) => {
                root.mixer-pan-release(index);
            }
            mixer-mute-toggle(index) => {
                root.mixer-mute-toggle(index);
            }
            mixer-solo-toggle(index) => {
                root.mixer-solo-toggle(index);
            }
            // ⭐ SFZ 采样器绑定（任务单 `#82`）：同样只上抛，宿主是唯一落点。
            mixer-sampler-set(index, path) => {
                root.mixer-sampler-set(index, path);
            }
            mixer-sampler-clear(index) => {
                root.mixer-sampler-clear(index);
            }
            // ⭐ **③ 浏览…**（任务单 `#86` 乙）：只上抛。落点 `host::wire_mixer_sampler_browse`
            // 只把选中的路径**填进输入框**（⛔ 不提交工程内容 —— 提交仍是 SET / 回车）。
            mixer-sampler-browse(index) => {
                root.mixer-sampler-browse(index);
            }
            // ⭐ **导出 MIDI**（任务单 `#90` 甲）：只上抛。唯一落点 = `host::wire_module_actions`
            // 的 `export-midi` 分支（与 `export-wav` 同一条回执通道）。
            export-midi => {
                root.export-midi();
            }
            // ⭐ **打开工程**（任务单 `#93`）：只上抛。唯一落点 = `host::wire_open_project`
            // （与 `export-midi` 同一条 `module-status` 回执通道）。
            open-project => {
                root.open-project();
            }
            // ⭐ **新建工程**（任务单 `#129`）：只上抛。唯一落点 = `host::wire_new_project`
            // （与「打开工程」同一条 `module-status` 回执通道）。
            new-project => {
                root.new-project();
            }
            // 主控写入面：只上抛、不带下标（身份由 `host::wire_mixer_edit` 从权威工程取）。
            mixer-master-fader-grab(y) => {
                root.mixer-master-fader-grab(y);
            }
            mixer-master-fader-drag(y) => {
                root.mixer-master-fader-drag(y);
            }
            mixer-master-fader-release() => {
                root.mixer-master-fader-release();
            }
            mixer-master-pan-grab(x) => {
                root.mixer-master-pan-grab(x);
            }
            mixer-master-pan-drag(x) => {
                root.mixer-master-pan-drag(x);
            }
            mixer-master-pan-release() => {
                root.mixer-master-pan-release();
            }
        }

        // ---------------------------------------------------------- 24px 状态栏
        StatusBar {
            // `ROAD-M4-008`：最近一次保存的原话（宿主是唯一写者）。
            save-status: root.save-status;
            save-succeeded: root.save-succeeded;
            // 台账 R9：这两格都是**宿主注入的整串文本**（`host::publish_status_bar`）。
            // `chord` **没有**传：那一格没有能力、也没有宿主写者（见 status_bar.slint 的登记）。
            selection: root.status-selection;
            device: root.status-device;
        }
    }

    // =====================================================================
    // 覆盖层 (不是布局子元素, 因此可以绝对定位且不影响网格)
    // =====================================================================

    // ⭐ **引擎错误横幅**（任务单 `#86` 甲）—— 紧贴在 24px 状态栏**上方**的一条 28px 横条。
    //
    // 为什么是覆盖层而不是 `VerticalLayout` 里的一格（**这是第 247 条的关键**）：
    // 加进 `VerticalLayout` 会在没有错误时也**占掉 28px**（布局是静态的，`visible: false`
    // 的兄弟会不会被重新分配空间取决于 Slint 的布局实现）⇒ 默认帧会变 ⇒ 必须重录基准。
    // 覆盖层没有这个问题：`visible: false` 时它一位像素都不画、也不动任何人的几何。
    //
    // `text` 由 `root.engine-error` 单向注入（唯一写者 = `host::apply_engine_error`）；
    // 组件内部自己用 `text != ""` 决定 `visible` ⇒ 本处**不**再写一次 `visible`。
    EngineErrorBanner {
        x: 0;
        y: root.height - Tokens.status-bar-height - self.height;
        width: root.width;
        text: root.engine-error;
    }

    // compact 断点: 右栏变抽屉 (Cmd/Ctrl + 反斜杠 呼出)
    AiRail {
        x: root.width - Tokens.right-rail-width;
        y: 0;
        width: Tokens.right-rail-width;
        height: root.height;
        visible: root.compact && root.ai-drawer-open;

        open-musical-pr => { root.open-musical-pr(); }
        run-acoustic-diagnosis => { root.run-acoustic-diagnosis(); }
        export-diagnostics => { root.export-diagnostics(); }
    }

    // AI 编曲提案审核抽屉 (§10 Musical PR)
    MusicalPrDrawer {
        x: root.width - 360px;
        y: 0;
        width: 360px;
        height: root.height;
        visible: root.musical-pr-open;

        accept => {
            root.accept-ai-proposal();
            root.musical-pr-open = false;
        }
        reject => {
            root.reject-ai-proposal();
            root.musical-pr-open = false;
        }
        close => { root.musical-pr-open = false; }
    }

    // 全屏可视化 DAG 时光机 (Cmd/Ctrl + Shift + H)
    UndoTreeModal {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        visible: root.undo-tree-open;

        // 显示态 = 模型读数（宿主注入；界面只显示）。
        can-undo: root.undo-can-undo;
        undo-depth: root.undo-depth;
        undone-depth: root.undo-undone;
        commit-count: root.undo-commit-count;
        branch-name: root.branch-name;
        // 图谱节点 = **真实提交链**的投影（宿主从 `UndoPort::graph()` 读出）。
        node-count: root.undo-node-count;
        node-labels: root.undo-node-labels;
        node-hidden: root.undo-node-hidden;

        undo-step => { root.undo-step(); }
        close => { root.undo-tree-open = false; }
    }
}
