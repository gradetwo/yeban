    // 焦点入口（T-FIX-131）：每只模态 / 搜索框各有**一个**取焦函数，宿主打开时同步调用
    // （⛔ 不用 `.slint` 的 `changed` 处理器：它要等事件循环下一拍，而无头判据设置属性后
    // 并不跑循环 ⇒ 焦点会停在原地，与 `host.rs` 里导出弹窗那一处同一个理由）。
    // 各自落到对话框组件已有的取焦函数上（陷阱 `FocusScope` + 首格），⛔ 不在 `MainWindow`
    // 里再抄一份"焦点在哪"。
    public function focus-sidebar-search() { left-panel.focus-search(); }
    public function focus-undo-tree-trap() { undo-tree-dialog.focus-trap(); }
    public function focus-shortcut-layer() { key-handler.focus(); }
    public function focus-humanize-dialog() { humanize-dialog.focus-first-field(); }
    public function focus-drum-gen-dialog() { drum-gen-dialog.focus-first-field(); }
    public function focus-export-wav-dialog() { export-wav-dialog.focus-first-field(); }
    public function focus-audio-settings-dialog() { audio-settings-dialog.focus-first-control(); }

    // ⛔ 2026-11-23 (T-FIX-143)：下面这批属性在 `.slint` 侧**零读者**（声明行是唯一出现），
    //   宿主仍按 snake_case setter 写入 ⇒ 写进去不产生任何界面效果。保留仅为不打断宿主调用，
    //   **勿再接线**；确认宿主不再写入后应整条删除。清单：
    //   clip-drag-origin-x / note-drag-origin-x / note-drag-origin-y / startup-key-index /
    //   timecode-ticks-bar / timecode-ticks-beat / track-height-drag-start-px / track-height-drag-start-y /
    //   track-height-override-ids / track-height-override-pxs / track-reorder-start-y / track-reorder-track /
    //   velocity-drag-active。另：同批只声明零引用属性里 control-room-monitor / console-fixed /
    //   splitter-dragging / splitter-press-y 已在本单一并删除（逐条见交付回执）。
    // ---- 契约兼容面: 新 UI 视觉组件树保留, 数据/控制面与 main 对齐 ----
    // 由 main 版 MainWindow 顶层 property/callback 声明机械补全: 字面量初值原样保留,
    // 绑定表达式(依赖旧组件树)改用类型默认值。host.rs 接线层与判据的唯一契约面。
    in-out property <int> active-tool: 1;
    in-out property <bool> ai-drawer-open: false;
    in-out property <float> arrangement-content-px: 0.0;
    // 编曲时间线**可见宽**（逻辑像素，已扣包头与 5px 缝），由 `ArrangementViewport`
    // 算好后经回调写上（T-FIX-110 用它判「播放头是否越出可见区」）。
    // ⛔ 宿主不复制 `width - headers - 5` 这串几何（包头可拖、缝改一次两边就不同步）。
    in-out property <length> arrangement-timeline-px: 0px;
    in-out property <bool> arrangement-view: true;
    // ⭐ 音频设置面板（T-FIX-71）：宿主供数（设备枚举/实际协商/输入电平），
    // 选择经 `audio-*-picked` 回调上抛，宿主落盘并应用（见 dialogs/audio_settings_dialog.slint）。
    in-out property <string> audio-device-status: "";
    in-out property <int> audio-input-device-index: 0;
    in-out property <[string]> audio-input-device-labels: [];
    in-out property <float> audio-input-level: 0.0;
    in-out property <string> audio-input-level-text: "";
    in-out property <int> audio-output-device-index: 0;
    in-out property <[string]> audio-output-device-labels: [];
    // 焦点读数（T-FIX-131）：从 Slint 自己的 `has-focus` 推导，⛔ 不是第三份写态。
    // 弹窗关着 ⇒ 对应的实例不在树里 ⇒ 读数回到对话框自己的默认值（`-1` / `false`）。
    in-out property <int> audio-settings-focused-control: audio-settings-dialog.focused-control;
    in-out property <bool> audio-settings-open: false;
    in-out property <[string]> asset-pool-details: [];
    in-out property <[string]> asset-pool-kinds: [];
    in-out property <[string]> asset-pool-names: [];
