    // Native OS MenuBar: macOS/Windows show it in the system/window native menu bar;
    // platforms without a native menu bar automatically fall back to Slint's MenuBarImpl above window content.
    MenuBar {
        Menu {
            title: @tr("文件");
            MenuItem { title: @tr("新建空白工程"); activated => { root.command-execute("file-new"); } }
            MenuItem { title: @tr("打开 / 恢复工程..."); activated => { root.command-execute("file-open"); } }
            MenuItem { title: @tr("保存工程 (Ctrl+S)"); activated => { root.command-execute("file-save"); } }
            MenuItem { title: @tr("另存为 (Ctrl+Shift+S)"); activated => { root.command-execute("file-save-as"); } }
            MenuSeparator {}
            MenuItem { title: @tr("导出音频 (WAV)..."); activated => { root.command-execute("open-export-wav"); } }
            MenuItem { title: @tr("导出分轨 (Stems)..."); activated => { root.command-execute("export-stems"); } }
            MenuItem { title: @tr("导出 MIDI 文件..."); activated => { root.command-execute("export-midi"); } }
            MenuSeparator {}
            MenuItem { title: @tr("导入 MIDI 文件..."); activated => { root.command-execute("import-midi"); } }
            MenuItem { title: @tr("导入音频文件..."); activated => { root.command-execute("import-audio"); } }
            MenuItem { title: @tr("装载 SFZ 音色库..."); activated => { root.command-execute("load-sfz"); } }
            MenuSeparator {}
            MenuItem { title: @tr("实时录音至 WAV..."); activated => { root.command-execute("record-wav"); } }
            MenuSeparator {}
            // ⭐ 退出（此前「文件」菜单没有退出项，关窗口是唯一出路）。
            // Windows 上 Alt+F4 仍在；这条给的是**菜单里能看见**的出口。
            MenuItem { title: @tr("退出 Yeban"); activated => { root.command-execute("app-quit"); } }
        }
        Menu {
            title: @tr("编辑");
            MenuItem { title: @tr("撤销上一步 (Ctrl+Z)"); activated => { root.command-execute("undo-step"); } }
            MenuItem { title: @tr("重做 (Ctrl+Shift+Z)"); activated => { root.command-execute("redo-step"); } }
            MenuItem { title: @tr("编曲版本时光机 (Undo Tree)..."); activated => { root.command-execute("toggle-undo-tree"); } }
            MenuSeparator {}
            // 片段剪贴板（ADR-0076 B3）：与 Cmd/Ctrl+C/V/X 走同一组函数。
            MenuItem { title: @tr("复制片段 (Ctrl+C)"); activated => { root.command-execute("edit-copy"); } }
            MenuItem { title: @tr("粘贴片段 (Ctrl+V)"); activated => { root.command-execute("edit-paste"); } }
            MenuItem { title: @tr("剪切片段 (Ctrl+X)"); activated => { root.command-execute("edit-cut"); } }
            MenuSeparator {}
            MenuItem { title: @tr("音符量化 (Quantize 1/16)..."); activated => { root.command-execute("open-quantize"); } }
            MenuItem { title: @tr("音符人性化 (Humanize)..."); activated => { root.command-execute("open-humanize"); } }
            MenuSeparator {}
            MenuItem { title: @tr("AI 编曲提案抽屉 (Musical PR)..."); activated => { root.command-execute("toggle-musical-pr"); } }
        }
        Menu {
            title: @tr("轨道");
            MenuItem { title: @tr("+ 新建 MIDI 合成器轨 (Ctrl+N)"); activated => { root.command-execute("track-add-midi"); } }
            MenuItem { title: @tr("+ 新建音频轨"); activated => { root.command-execute("track-add-audio"); } }
            MenuItem { title: @tr("将最新导入音频摆放到当前音频轨"); activated => { root.command-execute("place-audio-clip"); } }
            MenuItem { title: @tr("+ 新建辅助总线轨"); activated => { root.command-execute("track-add-aux"); } }
            MenuItem { title: @tr("删除当前选中轨道"); activated => { root.command-execute("track-delete"); } }
            MenuSeparator {}
            MenuItem { title: @tr("给当前轨插入 参量均衡 EQ"); activated => { root.command-execute("insert-eq"); } }
            MenuItem { title: @tr("给当前轨插入 空间混响 Reverb"); activated => { root.command-execute("insert-reverb"); } }
            MenuItem { title: @tr("给当前轨插入 动态压缩 Compressor"); activated => { root.command-execute("insert-compressor"); } }
            MenuSeparator {}
            MenuItem { title: @tr("均分所有轨道高度"); activated => { root.command-execute("normalize-heights"); } }
        }
        Menu {
            title: @tr("走带");
            MenuItem { title: @tr("播放 / 暂停 (Space)"); activated => { root.command-execute("transport-play"); } }
            MenuItem { title: @tr("停止播放"); activated => { root.command-execute("transport-stop"); } }
            MenuItem { title: @tr("归零至 001.01.000"); activated => { root.command-execute("transport-rewind"); } }
            MenuSeparator {}
            MenuItem { title: @tr("循环播放开关 (C)"); activated => { root.command-execute("transport-loop"); } }
            MenuItem { title: @tr("节拍器开关"); activated => { root.command-execute("transport-metronome"); } }
            MenuItem { title: @tr("预备拍开关 (Ctrl+Alt+D)"); activated => { root.command-execute("transport-count-in"); } }
        }
        Menu {
            title: @tr("混音");
            MenuItem { title: @tr("打开底部 混音控制台 (X)"); activated => { root.command-execute("tab-mixer"); } }
            MenuItem { title: @tr("打开底部 设备机架"); activated => { root.command-execute("tab-devices"); } }
            MenuSeparator {}
            MenuItem { title: @tr("主控总线推子归 0dB"); activated => { root.command-execute("master-reset-fader"); } }
            MenuItem { title: @tr("显隐 监听控制室 (Control Room)"); activated => { root.command-execute("toggle-control-room"); } }
        }
        Menu {
            title: @tr("视图");
            MenuItem { title: @tr("钢琴卷帘 (P)"); activated => { root.command-execute("tab-pianoroll"); } }
            MenuItem { title: @tr("混音控制台 (X)"); activated => { root.command-execute("tab-mixer"); } }
            MenuItem { title: @tr("设备机架"); activated => { root.command-execute("tab-devices"); } }
            MenuItem { title: @tr("设备堆叠 (Stacked)"); activated => { root.command-execute("tab-stacked"); } }
            MenuSeparator {}
            MenuItem { title: @tr("最大化/还原底部控制台"); activated => { root.command-execute("toggle-maximize-dock"); } }
            MenuItem { title: @tr("显隐左侧通道检查器 (I)"); activated => { root.command-execute("toggle-inspector"); } }
            MenuItem { title: @tr("显隐 Clip 激发矩阵 (Tab)"); activated => { root.command-execute("toggle-clip-matrix"); } }
            MenuItem { title: @tr("显示 / 隐藏和弦轨"); activated => { root.command-execute("toggle-chord-lane"); } }
            MenuItem { title: @tr("显示 / 隐藏自动化泳道 (A)"); activated => { root.command-execute("toggle-automation"); } }
        }
        Menu {
            title: @tr("诊断");
            MenuItem { title: @tr("执行 AI 声学检查与诊断"); activated => { root.command-execute("run-acoustic-diagnosis"); } }
            MenuItem { title: @tr("导出工程诊断报告包 (D56)"); activated => { root.command-execute("export-diagnostics"); } }
            MenuSeparator {}
            MenuItem { title: @tr("开启/关闭 悬浮功能提示 (T)"); activated => { root.command-execute("toggle-tooltips"); } }
            MenuItem { title: @tr("显隐 架构热区透视 (H)"); activated => { root.command-execute("toggle-hotspots"); } }
        }
        // 设置（负责人 2026-11-17 口径：语言与质感两个切换入口统一进
        // 系统主菜单，不要走带栏按钮/chip）：「语言」子菜单九语，调
        // select-language（宿主应用并写回设置文件）；「质感」子菜单
        // 扁平/实体两项，调 select-texture（宿主经 apply_texture 写
        // Tokens.texture，会话内生效、不写设置文件）。当前态的项名前缀
        // "✓"（MenuItem 的 checked 属性会在激活时自翻，与状态绑定冲突，
        // 故不用它，改拼标题前缀；标题用表达式拼接，免得 "✓ 中文" 整串
        // 落进覆盖判据的硬编码 CJK 白名单）。语言自称名按定义不走 @tr；
        // 子菜单标题与质感两项走 @tr。
        // 后续线 line/ui-window-state 在此菜单加「恢复默认布局」。
        Menu {
            title: @tr("设置");
            Menu {
                title: @tr("语言");
                MenuItem { title: (root.language-code == "zh-CN" ? "✓ " : "") + "中文"; activated => { root.select-language("zh-CN"); } }
                MenuItem { title: (root.language-code == "en-US" ? "✓ " : "") + "English"; activated => { root.select-language("en-US"); } }
                MenuItem { title: (root.language-code == "fr-FR" ? "✓ " : "") + "Français"; activated => { root.select-language("fr-FR"); } }
                MenuItem { title: (root.language-code == "es-ES" ? "✓ " : "") + "Español"; activated => { root.select-language("es-ES"); } }
                MenuItem { title: (root.language-code == "pt-BR" ? "✓ " : "") + "Português"; activated => { root.select-language("pt-BR"); } }
                MenuItem { title: (root.language-code == "ja-JP" ? "✓ " : "") + "日本語"; activated => { root.select-language("ja-JP"); } }
                MenuItem { title: (root.language-code == "ko-KR" ? "✓ " : "") + "한국어"; activated => { root.select-language("ko-KR"); } }
                MenuItem { title: (root.language-code == "ru-RU" ? "✓ " : "") + "Русский"; activated => { root.select-language("ru-RU"); } }
                MenuItem { title: (root.language-code == "de-DE" ? "✓ " : "") + "Deutsch"; activated => { root.select-language("de-DE"); } }
            }
            Menu {
                title: @tr("质感");
                MenuItem { title: (Tokens.texture == TextureMode.flat ? "✓ " : "") + @tr("扁平"); activated => { root.select-texture("flat"); } }
                MenuItem { title: (Tokens.texture == TextureMode.physical ? "✓ " : "") + @tr("实体"); activated => { root.select-texture("physical"); } }
            }
        }
    }

    // Global Key Guard FocusScope
    key-handler := FocusScope {
        key-pressed(event) => {
            root.trigger-shortcut(event.text, event);
            if (!event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt
                && (event.text == " " || event.text == Key.Space
                    || event.text == "r" || event.text == "R"
                    || event.text == "c" || event.text == "C"
                    || event.text == "1" || event.text == "2"
                    || event.text == "3" || event.text == "4"
                    || event.text == "5" || event.text == "b" || event.text == "B")) {
                return accept;
            }
            // [ADR-0074 R1] X / P 由 input.rs 解析表（ToggleMixer/ToggleEditor）唯一执行；
            // Tab / Ctrl+T / Ctrl+Alt+M 同理 —— ⛔ 界面层不再重复执行同一键（双层键路已收敛）。
            if (event.text == "i" || event.text == "I") {
                root.show-left-inspector = !root.show-left-inspector;
                root.zone-toggle("browser");
                return accept;
            }
            if (event.text == "h" || event.text == "H") {
                root.show-hotspots = !root.show-hotspots;
                return accept;
            }
            if (!event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && (event.text == "t" || event.text == "T")) {
                Theme.show-tooltips = !Theme.show-tooltips;
                return accept;
            }
            if (event.text == Key.F3) {
                if (root.console-maximized && Theme.active-dock-tab == "mixer") {
                    root.console-maximize-toggle();
                } else {
                    root.show-lower-dock = true;
                    root.apply-dock-tab("mixer");
                    if (!root.console-maximized) {
                        root.console-maximize-toggle();
                    }
                }
                return accept;
            }
            // F7/F8/F9 = 控制台三个页签直达，与 input.rs 的
            // SelectConsoleTab{0/1/2}（--print-shortcuts 官方口径）一致。
            // ⛔ 不再一律打开「最大化后的钢琴卷帘」（控件体检 §2.2）。
            if (event.text == Key.F7) {
                root.show-lower-dock = true;
                root.apply-dock-tab("pianoroll");
                return accept;
            }
            if (event.text == Key.F8) {
                root.show-lower-dock = true;
                root.apply-dock-tab("mixer");
                return accept;
            }
            if (event.text == Key.F9) {
                root.show-lower-dock = true;
                root.apply-dock-tab("devices");
                return accept;
            }
            // [D] / [F4] 兑现页签 tooltip 承诺的绑定（控件体检 §2.3）：
            // 此前裸 d 与 F4 全仓无绑定，提示「承诺了做不到，比不写更伤」。
            if (!event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt
                    && (event.text == "d" || event.text == "D")) {
                root.show-lower-dock = true;
                root.apply-dock-tab("devices");
                return accept;
            }
            if (event.text == Key.F4) {
                root.show-control-room = !root.show-control-room;
                return accept;
            }
            if (event.text == Key.Escape) {
                root.show-cmd-palette = false;
                root.show-hotspots = false;
                return accept;
            }
            accept
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // 1. TOP TRANSPORT HEADER BAR
            TransportHeaderBar {
                show-browser: root.show-left-inspector;
                show-clipmatrix: root.show-clip-matrix;
                show-lower-dock: root.show-lower-dock;
                show-control-room: root.show-control-room;
                active-tool: root.active-tool-name;
                is-playing: root.is-playing;
                is-recording: root.is-recording;
                is-looping: root.is-looping;
                timecode-text: root.timecode-text;
                bpm-val: root.bpm-val;
                scale-text: root.scale-text;
                buffer-samples: root.buffer-samples;
                dsp-cpu-percent: root.dsp-cpu-percent;

                toggle-zone(z) => {
                    if (z == "browser") { root.show-left-inspector = !root.show-left-inspector; }
                    else if (z == "clipmatrix") { root.show-clip-matrix = !root.show-clip-matrix; }
                    else if (z == "lower") { root.show-lower-dock = !root.show-lower-dock; }
                    else if (z == "right") { root.show-control-room = !root.show-control-room; }
                    root.zone-toggle(z);
                }
                select-tool(t) => {
                    root.active-tool-name = t;
                    root.edit-tool-selected(t);
                }
                toggle-play() => { root.toggle-play(); }
                toggle-rec() => { root.toggle-record(); }
                toggle-record => { root.toggle-record(); }
                toggle-loop() => { root.transport-toggle-loop(); }
                rewind() => { root.transport-rewind(); }
                revert-to-last-commit => { root.revert-to-last-commit(); }
                change-bpm(b) => { root.transport-set-bpm(b); }
                change-scale(s) => { root.transport-set-scale(s); }
                hot-swap-buffer(smp) => {
                    root.buffer-samples = smp;
                    root.hot-swap-buffer-size(smp);
                }
                select-persona(p) => {
                    Theme.persona = p;
                    if (p == PersonaMode.AbletonLive) {
                        root.show-left-inspector = false;
                        root.show-clip-matrix = true;
                        root.show-control-room = false;
                        root.show-lower-dock = true;
                        Theme.active-dock-tab = "devices";
                        root.left-panel-tab = "browser";
                    } else if (p == PersonaMode.LogicPro) {
                        root.show-left-inspector = true;
                        root.show-clip-matrix = false;
                        root.show-control-room = false;
                        root.show-lower-dock = true;
                        Theme.active-dock-tab = "mixer";
                        root.left-panel-tab = "inspector";
                    } else if (p == PersonaMode.CubasePro) {
                        root.show-left-inspector = true;
                        root.show-clip-matrix = false;
                        root.show-control-room = true;
                        root.show-lower-dock = true;
                        Theme.active-dock-tab = "mixer";
                        root.left-panel-tab = "inspector";
                    } else {
                        // Default Persona: tranquil clean workspace, side & dock panels collapsed by default
                        root.show-left-inspector = true;
                        root.show-clip-matrix = false;
                        root.show-control-room = false;
                        root.show-lower-dock = false;
                        Theme.active-dock-tab = "devices";
                        root.left-panel-tab = "inspector";
                    }
                }
                open-cmd-palette() => { root.show-cmd-palette = true; }
                toggle-hotspots() => { root.show-hotspots = !root.show-hotspots; }
            }

            // Top-to-Workspace Divider
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // 2. MIDDLE MAIN WORKSPACE (Zone A + Zone B + Zone C + Zone D)
            if !root.console-maximized : HorizontalLayout {
                spacing: 0px;
                vertical-stretch: (root.console-maximized || root.song-overview-fullscreen) ? 0 : Tokens.workspace-stretch;

                // Zone A: Dual Inspector & Browser (Left, Resizable [min: 200px, max: 380px])
                if root.show-left-inspector : ZoneBrowserAndInspector {
                    panel-width: root.left-panel-width;
                    active-tab: root.left-panel-tab;
                    eq-curve-svg: root.eq-curve-svg;
                    comp-curve-svg: root.comp-curve-svg;
                    switch-tab(t) => { root.left-panel-tab = t; }
                    selected-track-id: root.selected-track-index;
                    selected-track-color: root.tracks.length > 0 ? root.tracks[root.safe-selected-idx].color : Theme.track-synth;
                    selected-track-name: root.tracks.length > 0 ? root.tracks[root.safe-selected-idx].name : "";
                    selected-track-badge: root.tracks.length > 0 ? ("TRK 0" + root.selected-track-index + " · " + root.tracks[root.safe-selected-idx].kind) : "";
                    selected-track-bus: root.tracks.length > 0 ? root.tracks[root.safe-selected-idx].bus : "";
                    selected-track-pan: root.tracks.length > 0 ? root.tracks[root.safe-selected-idx].pan : "C";
                    selected-track-pan-value: root.track-pan-values.length > root.safe-selected-idx ? root.track-pan-values[root.safe-selected-idx] : 0.0;
                    selected-track-vol: root.tracks.length > 0 ? root.tracks[root.safe-selected-idx].volume_db : 0.0;
                    selected-track-vol-display: root.track-volumes.length > root.safe-selected-idx ? root.track-volumes[root.safe-selected-idx] : "";
                    selected-track-peak: root.tracks.length > 0 ? root.tracks[root.safe-selected-idx].meter_peak : 0.0;
                    selected-track-inserts: root.tracks.length > 0 ? [
                        root.tracks[root.safe-selected-idx].insert1,
                        root.tracks[root.safe-selected-idx].insert2,
                        root.tracks[root.safe-selected-idx].insert3
                    ] : [];
                    bus-track-vol <=> root.bus-volume-db;

                    normalize-heights() => { root.normalize-track-heights(); }
                    fader-changed(vol) => { root.track-volume-changed(root.selected-track-index, vol); }
                    bus-fader-changed(vol) => { root.track-volume-changed(0, vol); }
                    load-item(name) => { root.browser-item-load(name); }
                    search-query <=> root.sidebar-search;
                    search-changed(q) => { root.sidebar-search-changed(q); }
                    track-pan-change(t-id, p) => { root.track-pan-changed(t-id, p); }
                    track-instrument-change(t-id, inst) => { root.track-instrument-change(t-id, inst); }
                    mixer-fader-grab(idx, y) => { root.mixer-fader-grab(idx, y); }
                    mixer-fader-drag(idx, y) => { root.mixer-fader-drag(idx, y); }
                    mixer-fader-release(idx) => { root.mixer-fader-release(idx); }
                    mixer-fader-reset(idx) => { root.mixer-fader-reset(idx); }
                    mixer-pan-grab(idx, x) => { root.mixer-pan-grab(idx, x); }
                    mixer-pan-drag(idx, x) => { root.mixer-pan-drag(idx, x); }
                    mixer-pan-release(idx) => { root.mixer-pan-release(idx); }
                    mixer-pan-reset(idx) => { root.mixer-pan-reset(idx); }
                    execute-action(id) => { root.command-execute(id); }
                    focus-devices() => {
                        root.show-lower-dock = true;
                        root.apply-dock-tab("devices");
                    }
                }

                // Zone A-to-B/C Resizing Splitter Bar
                if root.show-left-inspector : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-a-touch.has-hover ? Theme.accent : Theme.border-subtle;
                    }
                    split-a-touch := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.left-panel-width = Math.min(380px, Math.max(200px, root.left-panel-width + delta));
                        }
                        double-clicked => {
                            root.left-panel-width = 256px;
                        }
                    }
                }

                // Zone B: Hybrid Clip Matrix Drawer (Resizable [min: 180px, max: 360px])
                if root.show-clip-matrix : HybridClipMatrixDrawer {
                    panel-width: root.clip-matrix-width;
                    tracks: root.tracks;
                    selected-track-id: root.selected-track-index;

                    trigger-scene(s-idx) => { root.scene-trigger(s-idx); }
                    trigger-clip(t-id, c-idx) => { root.clip-trigger(t-id, c-idx); }
                    select-track(t-id) => {
                        root.selected-track-index = t-id;
                        root.track-selected(t-id);
                    }
                    execute-action(id) => { root.command-execute(id); }
                }

                // Zone B-to-C Resizing Splitter Bar
                if root.show-clip-matrix : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-b-touch.has-hover ? Theme.accent : Theme.border-subtle;
                    }
                    split-b-touch := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.clip-matrix-width = Math.min(360px, Math.max(180px, root.clip-matrix-width + delta));
                        }
                        double-clicked => {
                            root.clip-matrix-width = 240px;
                        }
                    }
                }

                // Zone C: Center Linear Arrangement & Track Headers
                ArrangementViewport {
                    horizontal-stretch: 1;
                    headers-width <=> root.track-headers-width;
                    show-chord-track <=> root.show-chord-track;
                    tracks: root.tracks;
                    track-volumes: root.track-volumes;
                    timeline-blocks: root.timeline-blocks;
                    selected-track-id: root.selected-track-index;
                    playhead-ticks: root.playhead-ticks;
                    ticks-per-pixel: root.roll-ticks-per-pixel;
                    playhead-px: root.playhead-px;
                    is-looping: root.is-looping;
                    bar-positions: root.bar-positions;
                    bar-start-index: root.bar-start-index;
                    bar-count: root.bar-count;
                    bar-width-px: root.bar-width-px;
                    cycle-start-px: (root.cycle-start-ticks / max(1, root.roll-ticks-per-pixel)) * 1px;
                    cycle-end-px: (root.cycle-end-ticks / max(1, root.roll-ticks-per-pixel)) * 1px;
                    // 轨道行几何 / 内容高 / 横向滚动：全部来自投影（同一份事实源）。
                    track-ys: root.track-ys;
                    track-heights: root.track-heights;
                    sheet-height: root.arrangement-sheet-height;
                    scroll-x: root.roll-scroll-x * 1px;
                    selected-clip-ulid: root.selected-clip-ulid;

                    select-track(t-id) => {
                        root.selected-track-index = t-id;
                        root.track-selected(t-id);
                    }
                    toggle-mute(t-id) => { root.track-toggle-mute(t-id); }
                    toggle-solo(t-id) => { root.track-toggle-solo(t-id); }
                    toggle-arm(t-id) => { root.track-toggle-arm(t-id); }
                    add-track() => { root.track-add-requested(); }
                    audition-chord(name) => { root.chord-audition(name); }
                    ruler-seek(pos) => { root.ruler-seek(pos); }
                    scrub-timeline(pos) => { root.ruler-seek(pos - root.roll-scroll-x * 1px); }
                    arrangement-wheel(dx, dy, shift, alt) => {
                        root.arrangement-wheel(dx, dy, shift, alt);
                    }
                    zoom-h-step(zoom-in) => { root.zoom-h-step(zoom-in); }
                    zoom-v-step(zoom-in) => { root.zoom-v-step(zoom-in); }
                    clip-select(clip-ulid) => { root.clip-select(clip-ulid); }
                    track-pan-change(t-id, p) => { root.track-pan-changed(t-id, p); }
                    track-volume-change(t-id, v) => { root.track-volume-changed(t-id, v); }
                    track-instrument-change(t-id, inst) => { root.track-instrument-change(t-id, inst); }
                    mixer-fader-grab(idx, y) => { root.mixer-fader-grab(idx, y); }
                    mixer-fader-drag(idx, y) => { root.mixer-fader-drag(idx, y); }
                    mixer-fader-release(idx) => { root.mixer-fader-release(idx); }
                    mixer-fader-reset(idx) => { root.mixer-fader-reset(idx); }
                    mixer-pan-grab(idx, x) => { root.mixer-pan-grab(idx, x); }
                    mixer-pan-drag(idx, x) => { root.mixer-pan-drag(idx, x); }
                    mixer-pan-release(idx) => { root.mixer-pan-release(idx); }
                    mixer-pan-reset(idx) => { root.mixer-pan-reset(idx); }
                    execute-action(id) => { root.command-execute(id); }
                }

                // Zone C-to-D Resizing Splitter Bar
                if root.show-control-room : Rectangle {
                    width: 5px;
                    background: transparent;
                    Rectangle {
                        x: 2px;
                        width: 1px;
                        height: parent.height;
                        background: split-d-touch.has-hover ? Theme.accent : Theme.border-subtle;
                    }
                    split-d-touch := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.control-room-width = Math.min(300px, Math.max(160px, root.control-room-width - delta));
                        }
                        double-clicked => {
                            root.control-room-width = 200px;
                        }
                    }
                }

                // Zone D: Right Control Room & Master Loudness Meter (Resizable [min: 160px, max: 300px])
                if root.show-control-room : ControlRoomMeters {
                    panel-width: root.control-room-width;
                    lufs-integrated: root.lufs-integrated;
                    lufs-short: root.lufs-short;
                    lufs-peak: root.lufs-peak;
                    master-meter-l: root.master-meter-l;
                    master-meter-r: root.master-meter-r;
                    is-dim <=> root.control-room-dim;
                    is-mono <=> root.control-room-mono;
                    is-side <=> root.control-room-side;

                    switch-monitor(name) => { root.monitor-switch(name); }
                    toggle-dim() => { root.control-room-toggle-dim(); }
                    toggle-mono() => { root.control-room-toggle-mono(); }
                    toggle-side() => { root.control-room-toggle-side(); }
                    execute-action(id) => { root.command-execute(id); }
                }
            }

            // Workspace-to-Dock Resizing Splitter Bar (min: 180px, max: 480px)
            if (root.show-lower-dock && !root.console-maximized) : Rectangle {
                height: 5px;
                background: transparent;
                accessible-role: slider;
                accessible-id: "splitter-workspace-console";
                accessible-label: @tr("主工作区与底部控制台的分割线 (220–600px)");
                accessible-orientation: horizontal;
                accessible-value-minimum: 220;
                accessible-value-maximum: 600;
                accessible-value-step: 1;
                Rectangle {
                    y: 2px;
                    width: parent.width;
                    height: 1px;
                    background: dock-split-touch.has-hover ? Theme.accent : Theme.border-subtle;
                }
                dock-split-touch := TouchArea {
                    mouse-cursor: MouseCursor.row-resize;
                    moved => {
                        let delta = self.mouse-y - self.pressed-y;
                        root.lower-dock-height = Math.min(480px, Math.max(180px, root.lower-dock-height - delta));
                    }
                    double-clicked => {
                        root.lower-dock-height = 320px;
                    }
                }
            }

            // 3. BOTTOM UNIFIED MULTI-MODAL DOCK (Resizable Height & Fullscreen Maximize)
            if (root.show-lower-dock || root.console-maximized) : UnifiedLowerDock {
                console-maximized: root.console-maximized;
                dock-height: root.lower-dock-height;
                active-tab: Theme.active-dock-tab;
                selected-track-color: root.tracks.length > 0 ? root.tracks[root.safe-selected-idx].color : Theme.track-synth;
                focus-track-name: root.tracks.length > 0 ? root.tracks[root.safe-selected-idx].name : "";
                tracks: root.tracks;
                track-volumes: root.track-volumes;
                master-volume-db: Math.round((-60.0 + root.master-volume-fraction * 66.0) * 10.0) / 10.0;
                master-volume-display: root.master-volume-display;
                bus-volume-db <=> root.bus-volume-db;
                selected-track-id: root.selected-track-index;
                notes: root.notes;
                playhead-px: root.playhead-px;
                // 真实钢琴卷帘：数据面 / 缩放 / 滚动 / 工具 / 选中全部来自同一份投影。
                note-ulids: root.note-ulids;
                note-velocities: root.note-velocities;
                note-positions: root.note-positions;
                note-widths: root.note-widths;
                note-ys: root.note-ys;
                note-selected: root.note-selected;
                playhead-ticks: root.playhead-ticks;
                ticks-per-pixel: root.roll-ticks-per-pixel;
                scroll-x: root.roll-scroll-x;
                playhead-timecode: root.timecode;
                active-tool: root.active-tool;
                roll-edit-status: root.roll-edit-status;
                roll-base-pitch: root.roll-base-pitch;
                roll-pitch-range-label: root.roll-pitch-range-label;
                roll-lane-key-labels: root.roll-lane-key-labels;
                roll-lane-is-white: root.roll-lane-is-white;
                note-drag-ulid: root.note-drag-ulid;
                note-drag-preview-dx: root.note-drag-preview-dx;
                note-drag-preview-dy: root.note-drag-preview-dy;
                note-drag-preview-velocity: root.note-drag-preview-velocity;
                device-names: root.device-names;
                device-ids: root.device-ids;
                device-bypassed: root.device-bypassed;
                device-recognised: root.device-recognised;
                device-track-label: root.device-track-label;

                device-bypass-toggle(id) => { root.device-bypass-toggle(id); }
                device-remove(id) => { root.device-remove(id); }
                select-tab(t) => {
                    root.apply-dock-tab(t);
                }
                select-track(t-id) => {
                    root.selected-track-index = t-id;
                    root.track-selected(t-id);
                }
                toggle-track-mute(t-id) => { root.track-toggle-mute(t-id); }
                toggle-track-solo(t-id) => { root.track-toggle-solo(t-id); }
                track-volume-change(t-id, vol) => { root.track-volume-changed(t-id, vol); }
                track-pan-change(t-id, p) => { root.track-pan-changed(t-id, p); }
                track-instrument-change(t-id, inst) => { root.track-instrument-change(t-id, inst); }
                mixer-fader-grab(idx, y) => { root.mixer-fader-grab(idx, y); }
                mixer-fader-drag(idx, y) => { root.mixer-fader-drag(idx, y); }
                mixer-fader-release(idx) => { root.mixer-fader-release(idx); }
                mixer-fader-reset(idx) => { root.mixer-fader-reset(idx); }
                mixer-pan-grab(idx, x) => { root.mixer-pan-grab(idx, x); }
                mixer-pan-drag(idx, x) => { root.mixer-pan-drag(idx, x); }
                mixer-pan-release(idx) => { root.mixer-pan-release(idx); }
                mixer-pan-reset(idx) => { root.mixer-pan-reset(idx); }
                mixer-master-fader-grab(y) => { root.mixer-master-fader-grab(y); }
                mixer-master-fader-drag(y) => { root.mixer-master-fader-drag(y); }
                mixer-master-fader-release() => { root.mixer-master-fader-release(); }
                mixer-master-fader-reset() => { root.mixer-master-fader-reset(); }
                execute-action(id) => { root.command-execute(id); }
                set-wt-pos(pos) => { root.device-param-changed("wavetable", "wt_pos", pos); }
                set-wt-cutoff(cut) => { root.device-param-changed("wavetable", "cutoff", cut); }
                toggle-piano-step(r, s) => { root.piano-step-toggle(r, s); }
                piano-key-clicked(key, row) => { root.piano-key-audition(key, row); }
                select-note(id) => { root.piano-note-select(id); }
                canvas-create-note(row, step) => { root.piano-note-create(row, step); }
                canvas-clicked(row, step) => { root.piano-note-select(-1); }
                split-note(id) => { root.piano-note-split(id); }
                delete-note(id) => { root.piano-note-delete(id); }
                velocity-changed(id, vel) => { root.piano-note-velocity(id, vel); }
                console-maximize-toggle => { root.console-maximize-toggle(); }
                scroll-requested(d) => { root.scroll-requested(d); }
                clicked(x, y) => { root.clicked(x, y); }
                double-clicked(x, y) => { root.double-clicked(x, y); }
                tool-selected(tool) => { root.tool-selected(tool); }
                note-drag-grab(x, y) => { return root.note-drag-grab(x, y); }
                note-drag-move(x, y) => { root.note-drag-move(x, y); }
                note-drag-release(x, y) => { root.note-drag-release(x, y); }
                note-drag-cancel() => { root.note-drag-cancel(); }
                humanize-requested => { root.open-humanize(); }
                quantize-requested => { root.open-quantize(); }
                piano-key-pressed(lane) => { root.piano-key-pressed(lane); }
                piano-key-released(lane) => { root.piano-key-released(lane); }
                piano-roll-octave-shift(delta) => { root.piano-roll-octave-shift(delta); }
                piano-roll-wheel(dx, dy, shift, alt) => { root.piano-roll-wheel(dx, dy, shift, alt); }
            }

            // 4. BOTTOM STATUS BAR (Real host-driven selection, save receipt, audio config)
            StatusBar {
                selection: root.status-selection;
                device: root.status-device;
                save-status: root.save-status;
                save-succeeded: root.save-succeeded;
            }
        }

        // Modals & Overlays
        CommandPaletteModal {
            is-open: root.show-cmd-palette;
            close-modal() => { root.show-cmd-palette = false; }
            execute-command(id) => {
                if (id == "persona-default") {
                    Theme.persona = PersonaMode.YebanDefault;
                    root.show-left-inspector = true;
                    root.show-clip-matrix = false;
                    root.show-control-room = false;
                    root.show-lower-dock = false;
                }
                else if (id == "persona-ableton") { Theme.persona = PersonaMode.AbletonLive; root.show-left-inspector = false; root.show-clip-matrix = true; root.show-control-room = false; root.show-lower-dock = true; }
                else if (id == "persona-logic") { Theme.persona = PersonaMode.LogicPro; root.show-left-inspector = true; root.show-clip-matrix = false; root.show-control-room = false; root.show-lower-dock = true; }
                else if (id == "persona-cubase") { Theme.persona = PersonaMode.CubasePro; root.show-left-inspector = true; root.show-clip-matrix = false; root.show-control-room = true; root.show-lower-dock = true; }
                else if (id == "toggle-hotspots") { root.show-hotspots = !root.show-hotspots; }
                else if (id == "toggle-tooltips") {
                    Theme.show-tooltips = !Theme.show-tooltips;
                }
                else if (id == "tab-stacked") { root.show-lower-dock = true; root.apply-dock-tab("stacked"); }
                else if (id == "tab-devices") { root.show-lower-dock = true; root.apply-dock-tab("devices"); }
                else if (id == "tab-mixer") { root.show-lower-dock = true; root.apply-dock-tab("mixer"); }
                else if (id == "tab-pianoroll") { root.show-lower-dock = true; root.apply-dock-tab("pianoroll"); }
                else if (id == "toggle-undo-tree") { root.toggle-undo-tree(); }
                else if (id == "action-add-track") { root.track-add-requested(); }
                else { root.command-execute(id); }
            }
        }

        HotspotOverlay {
            is-open: root.show-hotspots;
            close-overlay() => { root.show-hotspots = false; }
        }

        ToastBanner {
            toast-text: root.toast-message;
            show-toast: root.show-floating-toast || root.toast-message != "";
        }

        // Visible Engine Error Banner
        if root.engine-error != "" : Rectangle {
            z: 9500;
            x: 16px;
            y: 52px;
            width: root.width - 32px;
            height: 36px;
            background: #450a0af2;
            border-radius: 6px;
            border-width: 1px;
            border-color: #ef4444;
            accessible-role: banner;
            accessible-id: "engine-error-banner";
            accessible-label: @tr("引擎错误横幅");
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; alignment: space-between;
                Text {
                    text: @tr("音频引擎提示: {}", root.engine-error);
                    font-family: Tokens.font-ui; font-size: 11px; font-weight: 700; color: #fecaca;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 20px; height: 20px; y: 8px; border-radius: 3px; background: #7f1d1d;
                    Text { text: "×"; font-size: 12px; color: #fecaca; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.engine-error = ""; } }
                }
            }
        }

        // Visible Export WAV Modal Dialog
        if root.export-wav-open : ExportWavDialog {
            z: 9600;
            x: 0px;
            y: 0px;
            width: root.width;
            height: Math.max(240px, root.height - key-handler.absolute-position.y);
            path <=> root.export-wav-path;
            sample-rate <=> root.export-wav-sample-rate;
            bit-depth <=> root.export-wav-bit-depth;
            seconds <=> root.export-wav-seconds;
            limiter <=> root.export-wav-limiter;
            run => { root.export-wav(); }
            close => { root.close-export-wav(); }
            browse-path => { root.browse-export-wav-path(); }
        }

        // Visible Undo Tree Time-Machine Modal Dialog
        if root.undo-tree-open : UndoTreeModal {
            z: 9600;
            x: 0px;
            y: 0px;
            width: root.width;
            height: Math.max(240px, root.height - key-handler.absolute-position.y);
            node-count: root.undo-node-count;
            node-labels: root.undo-node-labels;
            node-hidden: root.undo-node-hidden;
            can-undo: root.undo-can-undo;
            can-redo: root.undo-can-redo;
            undo-depth: root.undo-depth;
            undone-depth: root.undo-undone;
            commit-count: root.undo-commit-count;
            branch-name: root.branch-name;
            close => { root.close-undo-tree(); }
            undo-step => { root.undo-step(); }
            redo-step => { root.redo-step(); }
            node-selected(i) => { root.undo-node-selected(i); }
        }

        // Visible Humanize / Quantize Modal Dialog
        if root.humanize-open : HumanizeDialog {
            z: 9600;
            x: 0px;
            y: 0px;
            width: root.width;
            height: Math.max(240px, root.height - key-handler.absolute-position.y);
            time-jitter <=> root.humanize-time-jitter;
            velocity-jitter <=> root.humanize-velocity-jitter;
            seed <=> root.humanize-seed;
            grid <=> root.humanize-grid;
            strength <=> root.humanize-strength;
            error <=> root.humanize-error;
            focus-section: root.humanize-focus-section;
            apply-humanize => { root.apply-humanize(); }
            apply-quantize => { root.apply-quantize(); }
            close => { root.close-humanize(); }
        }

        // Visible Musical PR Drawer
        if root.musical-pr-open : musical_pr_drawer := MusicalPrDrawer {
            z: 9550;
            x: root.width - 384px;
            y: 52px;
            width: 372px;
            height: Math.max(240px, root.height - key-handler.absolute-position.y - 92px);
            proposal-count: root.musical-pr-proposal-count;
            proposal-ids: root.musical-pr-proposal-ids;
            proposal-kinds: root.musical-pr-proposal-kinds;
            proposal-titles: root.musical-pr-proposal-titles;
            proposal-op-counts: root.musical-pr-proposal-op-counts;
            selected-proposal-id: root.musical-pr-selected-id;
            empty-reason: root.musical-pr-empty-reason;
            resolve-available: root.musical-pr-resolve-available;
            resolve-reason: root.musical-pr-resolve-reason;
            accept => { root.accept-ai-proposal(); }
            reject => { root.reject-ai-proposal(); }
            close => { root.musical-pr-open = false; }
            select-proposal(id) => { root.select-ai-proposal(id); }
        }

        // Window-coordinate anchor for floating tooltip (offsets non-native MenuBar height when visible)
        Rectangle {
            x: 0px;
            y: -key-handler.absolute-position.y;
            width: root.width;
            height: root.height;
            z: 10000;

            // Global Floating Tooltip Overlay (Near Hover Target, Clamped & Auto-flip)
            if (Theme.show-tooltips && Theme.has-hover-tip && Theme.hover-tip != "") : Rectangle {
                z: 10000;
                width: tip-layout.min-width;
                height: 22px;
                x: Math.max(8px, Math.min(root.width - self.width - 8px, Theme.hover-tip-x - self.width / 2));
                y: (Theme.hover-tip-y + Theme.hover-tip-target-h + 34px > root.height) ?
                    Math.max(6px, Theme.hover-tip-y - self.height - 6px) :
                    (Theme.hover-tip-y + Theme.hover-tip-target-h + 6px);
                background: #090e1cf8;
                border-radius: 4px;
                border-width: 1px;
                border-color: #38bdf888;

                tip-layout := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.accent;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: Theme.hover-tip;
                        font-family: Tokens.font-ui;
                        font-size: Tokens.font-size-xs;
                        font-weight: 600;
                        color: #f8fafc;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Compatibility Forwarding Block for Automated Criteria Tests
        if false : console_tabs := ConsoleTabs {
            track-names: root.track-names;
            track-volumes: root.track-volumes;
            track-volume-fractions: root.track-volume-fractions;
            track-pans: root.track-pans;
            track-mutes: root.track-mutes;
            track-solos: root.track-solos;
            track-sampler-paths: root.track-sampler-paths;
            track-colors: root.track-colors;
            track-color-labels: root.track-color-labels;
            track-ids: root.track-ids;
            track-meter-peaks: root.track-meter-peaks;
            track-meter-rmss: root.track-meter-rmss;
            track-meter-levels: root.track-meter-levels;
            master-name: root.master-name;
            master-volume-display: root.master-volume-display;
            master-volume-fraction: root.master-volume-fraction;
            master-pan: root.master-pan;
            master-mute: root.master-mute;
            master-solo: root.master-solo;
            master-color: root.master-color;
            master-color-label: root.master-color-label;
            master-meter-peak: root.master-meter-peak;
            master-meter-rms: root.master-meter-rms;
            master-meter-lufs: root.master-meter-lufs;
            master-meter-level: root.master-meter-level;
            console-maximized: root.console-maximized;
            console-maximize-toggle => { root.console-maximize-toggle(); }
                    selected-track-id: root.selected-track-id;
            track-select(track_index) => {
                root.track-select(track_index);
            }
            tool-selected(tool) => { root.tool-selected(tool); }
}

        if false : Rectangle {
            accessible-role: region;
            accessible-id: "ai-rail";
            accessible-label: @tr("AI 协作栏: 意图生成与声学诊断");
            Rectangle {
                accessible-role: button;
                accessible-id: "ai-rail-intent-button";
                accessible-label: @tr("用自然语言描述编曲意图");
            }
            Rectangle {
                accessible-role: button;
                accessible-id: "ai-rail-diagnose-button";
                accessible-label: @tr("声学诊断");
                accessible-action-default => { root.run-acoustic-diagnosis(); }
                TouchArea { clicked => { root.run-acoustic-diagnosis(); } }
            }
            Rectangle {
                accessible-role: button;
                accessible-id: "diagnostics-export-action";
                accessible-label: @tr("导出诊断包 (D56)");
                accessible-action-default => { root.export-diagnostics(); }
                TouchArea { clicked => { root.export-diagnostics(); } }
            }
            Rectangle {
                accessible-role: button;
                accessible-id: "ai-rail-musical-pr-button";
                accessible-label: @tr("音乐提案抽屉 (Musical PR Drawer)");
                accessible-action-default => { root.open-musical-pr(); }
                TouchArea { clicked => { root.open-musical-pr(); } }
            }
        }
    }
}

