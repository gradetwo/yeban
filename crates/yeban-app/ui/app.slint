    in-out property <[string]> automation-lane-target-keys: [];
    in-out property <[int]> automation-lane-track-indexes: [];
    in-out property <bool> automation-visible: true;
    in-out property <[length]> bar-positions: [];
    // [Q6] 标尺 / 网格的可见小节数与小节宽（由 host::apply_view 从同一份投影写入）。
    in-out property <int> bar-start-index: 0;
    in-out property <int> bar-count: 0;
    in-out property <length> bar-width-px: 0px;
    // 拍刻度 / 拍线的拍位来源：投影的拍号分子（与小节读数同批写入）。
    in-out property <int> beats-per-bar: 4;
