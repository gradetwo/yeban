// 夜半 (Yeban) — Arrangement View: 轨道包头 + 绝对时间轴
//
// 规范来源 (Normative):
//   - 规范 §2.1: 双视图是同构投射, 编辑都归约成原子 Op (本骨架尚未接 Op 日志)
//   - 规范 §4.2: 标尺与循环选区 (True Audio Loop Brace)
//   - 规范 §4.3: 章节卡片层 (Song Form & Section Track)
//   - [UI-TEST-001] §12.2: 语义 Element ID —— `clip-{ulid}-header` 与 `track-{i}-header`
//     就落在这个文件; `track-{i}-fader` 归 console/mixer_console.slint
//   - [UI-MCP-002] §12.5: 走带光标属高频刷新区域, 无头截图比对前必须动态遮罩
//   - [MODEL-AST-001]/[MODEL-AST-002]: 轨道数 / 剪辑数 / 段落数与全部 x 坐标**来自工程**,
//     由 `src/bridge.rs` 的投影算出、`src/host.rs` 单向注入
//
// ## 数据是注入的，不是内联的（本线变更）
//
// 上一版这里内联了 `clip-ulids` / `tracks` / `sections` 三份**演示数据默认值**，
// 并用 `for … in 6` / `for … in 3` / `for … in 4` 把**演示规模刻进界面**。
// 现在三者的默认值是**空数组**，循环写成 `for name[index] in root.<数组> :`，
// 规模由工程决定；x / width 由投影的整数 tick 换算给出（`tick / ticks_per_pixel`）。
// 代价：直接预览本文件（不注入）会看到空轨道 —— 这是"只有一个事实源"的必要代价。
//
// 仍未实现: 波形金字塔 / R-Tree 视口裁剪 / 拖拽吸附 / 循环选区拖拽。
// 那些是 [UI-NOTE-001..005] 的范围, 需要 `yeban-render` 与 Op 日志先落地。

import { Tokens, UiText, UiMonoText } from "../tokens.slint";

export component ArrangementView inherits Rectangle {
    // ---- 由 src/host.rs 注入的投影数据 (默认空 = 没有内联演示数据) ----
    in property <[string]> clip-ulids: [];
    // `"{轨道} · {片段}"` —— 由投影拼好, 界面不再自己拼字符串
    in property <[string]> clip-labels: [];
    // 时间轴相对 x / 宽度 (逻辑像素; 由整数 tick ÷ ticks_per_pixel 得出)
    in property <[length]> clip-positions: [];
    in property <[length]> clip-widths: [];
    // 剪辑所在车道 (= 非主总线轨道的序号)
    in property <[int]> clip-lanes: [];

    in property <[string]> tracks: [];
    in property <[string]> track-volumes: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];

    in property <[string]> sections: [];
    in property <[length]> section-positions: [];
    in property <[length]> section-widths: [];
    // 标尺小节线 x (逻辑像素)
    in property <[length]> bar-positions: [];

    background: Tokens.bg-void;
    clip: true;

    accessible-role: main;
    accessible-id: "workspace-arrangement-canvas";
    accessible-label: "Arrangement 线性编曲时间轴";

    // ---------------------------------------------------------------- 章节卡片层 (§4.3)
    for section_name[section_index] in root.sections : Rectangle {
        x: 168px + root.section-positions[section_index];
        y: 0;
        width: root.section-widths[section_index];
        height: 20px;
        background: section_index.mod(2) == 0 ? Tokens.bg-panel-alt : Tokens.bg-panel;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: list-item;
        accessible-id: "section-" + section_index + "-card";
        accessible-label: "章节 " + section_name;
        accessible-item-index: section_index;
        accessible-item-count: root.sections.length;

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: section_name;
            color: Tokens.gold;
            font-size: Tokens.font-size-xs;
            overflow: elide;
        }
    }

    // ---------------------------------------------------------------- 小节 / 拍标尺 (§4.2)
    Rectangle {
        x: 168px;
        y: 20px;
        width: parent.width - 168px;
        height: 22px;
        background: Tokens.bg-panel;
        accessible-role: text;
        accessible-id: "arrangement-ruler";
        accessible-label: "小节与拍标尺";

        // 小节线位置由投影给出（一小节 = 960 PPQ × 分子 × 4 ÷ 分母 tick）。
        for [bar_index] in root.bar-positions : Rectangle {
            x: root.bar-positions[bar_index];
            y: 0;
            width: 1px;
            height: parent.height;
            background: bar_index.mod(4) == 0 ? Tokens.line-strong : Tokens.line;
        }

        // 循环选区把手 (True Audio Loop Brace) —— 只画骨架, 拖拽未实现
        Rectangle {
            x: 120px * 2;
            y: 0;
            width: 120px * 4;
            height: parent.height;
            background: Tokens.bg-raised;
            border-width: 1px;
            border-color: Tokens.gold-deep;
            accessible-role: slider;
            accessible-id: "arrangement-loop-brace";
            accessible-label: "循环选区";
            accessible-value-minimum: 0;
            accessible-value-maximum: 9999;
            accessible-value-step: 1;
            accessible-value: "2 - 6";
        }
    }

    // ---------------------------------------------------------------- 轨道包头列
    for track_name[track_index] in root.tracks : Rectangle {
        x: 0;
        y: 42px + 56px * track_index;
        width: 168px;
        height: 54px;
        background: track_index.mod(2) == 0 ? Tokens.bg-panel : Tokens.bg-shell;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;
        accessible-role: list-item;
        accessible-id: "track-" + track_index + "-header";
        accessible-label: "轨道 " + track_name;
        accessible-item-index: track_index;
        accessible-item-count: root.tracks.length;
        accessible-item-selectable: true;
        accessible-item-selected: false;

        UiText {
            x: Tokens.space-4;
            y: Tokens.space-2;
            width: 96px;
            height: 18px;
            text: track_name;
            color: Tokens.ink-0;
            font-size: Tokens.font-size-md;
            overflow: elide;
        }

        // 静音 —— `accessible-checked` 来自工程的 `TrackV3::mute`
        Rectangle {
            x: Tokens.space-4;
            y: 26px;
            width: 22px;
            height: 18px;
            background: root.track-mutes[track_index] ? Tokens.record-red : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-mute-button";
            accessible-label: "轨道 " + track_name + " 静音";
            accessible-checkable: true;
            accessible-checked: root.track-mutes[track_index];

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "M";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
            }
        }

        // 独奏 —— `accessible-checked` 来自工程的 `TrackV3::solo`
        Rectangle {
            x: 34px;
            y: 26px;
            width: 22px;
            height: 18px;
            background: root.track-solos[track_index] ? Tokens.gold-deep : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-solo-button";
            accessible-label: "轨道 " + track_name + " 独奏";
            accessible-checkable: true;
            accessible-checked: root.track-solos[track_index];

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "S";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
            }
        }

        // 音量显示 = `TrackV3::volume_db` 的字符串形态（投影层格式化）
        UiMonoText {
            x: 120px;
            y: 26px;
            width: 40px;
            height: 18px;
            text: root.track-volumes[track_index];
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: right;
        }
    }

    // ---------------------------------------------------------------- 时间轴车道 + 剪辑
    // 每条非主总线轨道一条车道 —— 车道数 = 工程里的轨道数。
    for [lane_index] in root.tracks : Rectangle {
        x: 168px;
        y: 42px + 56px * lane_index;
        width: parent.width - 168px;
        height: 54px;
        background: lane_index.mod(2) == 0 ? Tokens.bg-shell : Tokens.bg-void;
        border-width: 1px;
        border-color: Tokens.line;
    }

    for clip_ulid[clip_index] in root.clip-ulids : Rectangle {
        x: 168px + root.clip-positions[clip_index];
        y: 42px + 56px * root.clip-lanes[clip_index] + 4px;
        width: root.clip-widths[clip_index];
        height: 46px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.gold-deep;
        clip: true;

        // 剪辑包头 —— [UI-TEST-001] `clip-{ulid}-header`，`{ulid}` = 工程的摆放身份
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 18px;
            background: Tokens.bg-raised;
            accessible-role: list-item;
            accessible-id: "clip-" + clip_ulid + "-header";
            accessible-label: "剪辑 " + root.clip-labels[clip_index];
            accessible-item-index: clip_index;
            accessible-item-count: root.clip-ulids.length;
            accessible-item-selectable: true;
            accessible-item-selected: false;

            UiMonoText {
                x: Tokens.space-3;
                y: 0;
                width: parent.width - 8px;
                height: parent.height;
                text: clip_ulid;
                color: Tokens.gold;
                font-size: Tokens.font-size-xs;
                overflow: elide;
            }
        }

        // 波形占位块 (真实波形金字塔等 yeban-render)
        Rectangle {
            x: Tokens.space-3;
            y: 24px;
            width: parent.width - 12px;
            height: 16px;
            background: Tokens.bg-raised;
            border-radius: Tokens.radius-sm;
        }
    }

    // ---------------------------------------------------------------- 走带光标 [UI-MCP-002]
    // 高频刷新区域: 无头截图比对前必须按这个 ID 的包围盒置黑。
    Rectangle {
        x: 168px + 120px * 3;
        y: 20px;
        width: 1px;
        height: parent.height - 20px;
        background: Tokens.gold-bright;
        accessible-role: slider;
        accessible-id: "arrangement-playhead";
        accessible-label: "走带光标";
        accessible-value-minimum: 0;
        accessible-value-maximum: 9999;
        accessible-value-step: 1;
        accessible-value: "3";
    }
}
