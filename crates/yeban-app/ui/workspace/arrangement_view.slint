// 夜半 (Yeban) — Arrangement View: 轨道包头 + 绝对时间轴
//
// 规范来源 (Normative):
//   - 规范 §2.1: 双视图是同构投射, 编辑都归约成原子 Op (本骨架尚未接 Op 日志)
//   - 规范 §4.3: 章节卡片层 (Song Form & Section Track)
//   - [UI-TEST-001] §12.2: 语义 Element ID —— `clip-{ulid}-header` 与 `track-{i}-header`
//     就落在这个文件; `track-{i}-fader` 归 console/mixer_console.slint
//   - [UI-MCP-002] §12.5: 走带光标属高频刷新区域, 无头截图比对前必须动态遮罩
//   - [MODEL-AST-001]/[MODEL-AST-002]: 轨道数 / 剪辑数 / 段落数与全部 x 坐标**来自工程**,
//     由 `src/bridge.rs` 的投影算出、`src/host.rs` 单向注入
//
// ## 数据是注入的，不是内联的（本线变更）
//
// 上一版这里内联了 `clip-ulids` / `tracks` / `sections` 三份**演示数据默认值**，
// 并用 `for … in 6` / `for … in 3` / `for … in 4` 把**演示规模刻进界面**。
// 现在三者的默认值是**空数组**，循环写成 `for name[index] in root.<数组> :`，
// 规模由工程决定；x / width 由投影的整数 tick 换算给出（`tick / ticks_per_pixel`）。
// 代价：直接预览本文件（不注入）会看到空轨道 —— 这是"只有一个事实源"的必要代价。
//
// 仍未实现: 波形金字塔 / R-Tree 视口裁剪 / 拖拽吸附 / 循环选区。
// 那些是 [UI-NOTE-001..005] 的范围, 需要 `yeban-render` 与 Op 日志先落地。
// 循环选区额外缺**模型载体**: `LoopConfig` 只住在 `ClipPlacement` 上, `TransportConfig`
// 没有走带循环字段、`Op` 也没有对应变体 ⇒ 本文件的标尺带里**不画**选区把手
// （参考性 UI/UX 文档 §4.2 的固定 2–6 小节骨架是假读数, 已删）。

import { Tokens, UiText, UiMonoText, UiMediumText, UiSerifText } from "../tokens.slint";

export component ArrangementView inherits Rectangle {
    // ---- 由 src/host.rs 注入的投影数据 (默认空 = 没有内联演示数据) ----
    in property <[string]> clip-ulids: [];
    // `"{轨道} · {片段}"` —— 由投影拼好, 界面不再自己拼字符串
    in property <[string]> clip-labels: [];
    // ⭐ 每条摆放的**静音态**（`ClipPlacement::muted`，与 `clip-ulids` 同序同长）。
    // 唯一写者是 `host::apply_view`；界面只读它画包头底色 —— 与 `track-mutes` 同一族口径：
    // **工程字段**，⛔ 不是界面自己记的第二份状态。默认全 `false` ⇒ 基准帧逐像素不变。
    in property <[bool]> clip-mutes: [];
    // 时间轴相对 x / 宽度 (逻辑像素; 由整数 tick ÷ ticks_per_pixel 得出)
    in property <[length]> clip-positions: [];
    in property <[length]> clip-widths: [];
    // 剪辑的纵向几何 (y / 高) —— 由投影从**所在行**的行几何派生 (ADR-0004 S0)。
    // 旧版这里是 `y: 42px + 56px * root.clip-lanes[clip_index] + 4px; height: 46px;`
    // ⇒ 界面自己做行算术; 现在界面只取数组下标, 行几何的**唯一**来源是投影。
    in property <[length]> clip-ys: [];
    in property <[length]> clip-heights: [];

    in property <[string]> tracks: [];
    // ⭐ [PATCH UI-TRACK-KINDS-01]（2026-11-08）：轨道类型（`"midi"` / `"audio"` /
    // `"aux-return"`），与 `tracks` / `track-ids` **同索引集**。唯一写者 =
    // `host::apply_view`（`ViewState::track_kinds()` 的投影读数），界面只读它挑
    // 类型色带 / 顶边 / 徽标 —— ⛔ 不自己记第二份、⛔ 不按下标猜类型。
    // 关闭 `docs/ledger/app-binding-notes.md` 的 `tracks[*].kind` →「待接图标位」登记。
    in property <[string]> track-kinds: [];
    // ⭐ 任务单 `#192`：与 `tracks` **同索引集**的轨道身份（26 字符 `EntityId` 文本）。
    // 只用于**无障碍选中态**（`accessible-item-selected` 绑"身份 == 选中身份"）——
    // 选中态按**身份**键控而不是下标：删轨 / 撤销之后下标会指向另一条轨，身份不会。
    // 它由 `app.slint` 从根属性转发（宿主 `apply_view` 本来就在注入 `track-ids`）⇒ ⛔ 没有第二份表。
    in property <[string]> track-ids: [];
    // 宿主拥有的选中轨身份（空串 = 没有明确选中 ⇒ 面板走兜底）。界面**只读**它，
    // 唯一写者是 `host::wire_track_select`（⛔ 界面不改选中态）。
    in property <string> selected-track-id: "";
    // ⭐ 剪辑选中态：与 `clip-ulids` 同一取值域的**身份**文本（空串 = 没有明确选中）。
    // 唯一写者是宿主（`host::wire_clip_select`）；界面只读它 —— 选中高亮与
    // `accessible-item-selected` 都是"身份 == 选中身份"这**一个**比较的两面。
    in property <string> selected-clip-ulid: "";
    // ⭐ 剪辑拖拽的**草稿读数**（宿主写、界面只读；与卷帘 `note-drag-*` 同款）：
    // `clip-drag-ulid` 是正在被拖的那条摆放身份（空串 = 没有手势），
    // `clip-drag-preview-dx` 是宿主算好的预览位移（逻辑像素）。
    // 没有手势 ⇒ 剪辑 x 取投影值 ⇒ 默认帧逐像素不变；松手提交后由重投影覆盖草稿。
    in property <string> clip-drag-ulid: "";
    in property <float> clip-drag-preview-dx: 0.0;
    // 手势的**界面本地**读数（都不进模型）：按下点 / 是否越过规范的 4px 阈值 /
    // 宿主是否接管了这一拖（命名与卷帘手势面同款：`drag-*` 是界面本地、
    // `clip-drag-*` 是宿主草稿）。同一时刻只有一条剪辑在手 ⇒ 全局一份即可。
    property <length> drag-origin-x: 0px;
    property <bool> drag-moved: false;
    property <bool> dragging: false;
    // ⭐ 2026-11-07（夜半 UI 轨道交互修复线）：空车道拖动的**界面本地**读数
    // （与卷帘 `piano_roll.slint` 的拖动滚动手势面同款：`drag-last-x` 是上一帧的 x，
    // 增量 = 上一帧 − 当前帧 ⇒ 向右拖内容左移、偏移增加）。
    property <length> lane-drag-origin-x: 0px;
    property <length> lane-drag-last-x: 0px;
    property <bool> lane-drag-moved: false;
    property <bool> lane-dragging: false;
    // 每条非主总线轨道的行几何 (投影的**前缀和**; ADR-0004 S0)。
    // 与 `tracks` **同索引集**: 包头用 `track_index`、时间轴车道用 `lane_index`。
    in property <[length]> track-ys: [];
    in property <[length]> track-heights: [];
    // ⭐ 行区**内容高度**（逻辑像素；宿主由行几何现算注入）。它只决定
    // `Flickable` 的 `content-height`：内容不高出可视区 ⇒ 偏移恒 0 ⇒ 默认帧逐像素不变。
    // ⛔ 界面不自己求和 —— 与 `track-ys` 一样是投影读数。
    in property <float> sheet-height: 0.0;
    // 行区上沿（章节卡片 20px + 标尺带 22px）。投影的行 y 以它为原点
    // （`automation::TRACK_LANE_TOP_PX`）；滚动容器内的局部 y 要减掉它。
    private property <length> rows-top: 42px;
    in property <[string]> track-volumes: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];
    in property <[bool]> track-arms: [];
    in property <bool> automation-visible: true;
    in property <bool> cycle-enabled: false;
    in property <int> cycle-start-ticks: 0;
    in property <int> cycle-end-ticks: 15360;
    // 轨道色标：`[color]` 由投影解析后的 RGB 构造（十六进制语法只在 `src/bridge.rs`，
    // 非法 / 缺失已在那边回退）；`track-color-labels` 是同一颜色的规范化 `#RRGGBB` 文本，
    // 只用于无障碍标签 —— 于是"界面画的颜色"与"控件树读到的色标"来自同一个值。
    in property <[color]> track-colors: [];
    in property <[string]> track-color-labels: [];

    in property <[string]> sections: [];
    // 段落色标（`SectionV3::color` 的消费形态）：颜色由投影解析 / 回退，
    // 规范化文本同时进色标的 `accessible-label` ⇒ 控件树里读得到工程色标。
    in property <[color]> section-colors: [];
    in property <[string]> section-color-labels: [];
    in property <[length]> section-positions: [];
    in property <[length]> section-widths: [];
    // 标尺小节线 x (逻辑像素)
    in property <[length]> bar-positions: [];

    // ---- 走带光标（[UI-NOTE-001]）----
    // 位置来自引擎读数：唯一写者 = `host::apply_transport`，它把
    // `TransportReading::position_ticks` 写成窗口属性并透传到这里。
    // 界面只做 `tick ÷ ticks_per_pixel`（与投影里音符 / 小节线同一条整数除法）。
    // 旧版写死 `x: 168px + 120px×3`（像素字面量）＋ 写死的无障碍值 —— 一个**假位置**。
    in property <int> playhead-ticks: 0;
    in property <int> ticks-per-pixel: 30;
    // 无障碍值 = 走带时间码（窗口 `timecode`，同一个引擎读数的另一面）——
    // 读屏器读到的是真实位置，而不是写死的 `"3"`。
    in property <string> playhead-timecode: "";

    // ---- 自动化泳道 (line/app-automation-ui) ----
    //
    // 9 个平行数组**全部**由 `src/automation.rs` 的投影派生 (`src/host.rs` 单向注入),
    // 界面只做"取数组下标", 不做任何算术 (位置与数值都已经是逻辑像素 / 文本)。
    //
    // 模型侧的接入口径 (docs/ledger/model-automation-notes.md §5):
    //   `lane.unit()`              -> `automation-lane-axis-labels` (轴标签带单位)
    //   `lane.effective_domain()`  -> 纵轴量程 (None 时按曲线最值自适应, 轴文本带「自适应」)
    //   `lane.points_in_tick_order()` -> `automation-path-commands` (相邻两点之间按左端点
    //                                   的 `curve` 采样 `ease`, 顶点值来自模型求值入口)
    //   `lane.read_enabled` / `write_mode` -> 描边颜色 + 角标 + 无障碍标签
    //
    // 元素 ID 的三段字面量是刻意的: `[UI-TEST-001]` §12.2 的约定族需要可被文本层对账的
    // 模板 (与 `elements.rs` 的注册表双向覆盖, 见
    // `elements::slint_accessible_ids_and_registry_cover_each_other`)。拼出来的字符串
    // 必须等于 `automation::lane_element_id`。
    in property <[string]> automation-lane-target-keys: [];
    in property <[int]> automation-lane-track-indexes: [];
    in property <[string]> automation-lane-labels: [];
    in property <[string]> automation-lane-axis-labels: [];
    in property <[length]> automation-lane-band-ys: [];
    in property <[length]> automation-lane-band-heights: [];
    in property <[bool]> automation-lane-read-enabled: [];
    in property <[string]> automation-lane-badges: [];
    in property <[string]> automation-path-commands: [];

    background: Tokens.bg-void;
    clip: true;

    accessible-role: main;
    accessible-id: "workspace-arrangement-canvas";
    accessible-label: "Arrangement 线性编曲时间轴";

    // ---------------------------------------------------------------- 轨道高度拖拽手势
    //
    // `ADR-0004` S1 的**纵向入口**（该切片落地时，入口被明确留给后续切片）。
    // 三条回调只**报告事件**，界面**不做任何算术**：
    //
    // - 行几何的唯一来源仍是投影注入的 `track-ys` / `track-heights`（S0）；
    // - 有效行高的夹紧仍只发生在投影（`bridge::effective_track_height_px`，Q2-B）；
    // - 视图态的**唯一** setter 是 `host::set_track_height_override`（不建第二条高度状态路径）。
    //
    // 宿主（`src/host.rs` 的 `wire_track_height_drag`）把指针的纵向位移换算成**基准像素**，
    // 经那个 setter 写进视图态并重投影 —— 界面只报"按下 / 拖动 / 收尾"三件事。
    /// 按下：`(轨道下标, 指针在轨道头坐标系里的 y)`。
    callback track-height-grab(int, length);
    /// 拖动：同一个下标、同一个坐标系里的当前 y（位移由宿主算）。
    callback track-height-drag(int, length);
    /// 收尾：松开 / 指针离开窗口（上游把离开导出成 `PointerEventKind.cancel`）/ 打断。
    callback track-height-release(int);

    // ---------------------------------------------------------------- ⭐ 选中轨（任务单 `#192`）
    //
    // 选中态是**编辑器视图态**（⛔ 不进工程 / ⛔ 不进摘要 / ⛔ 不进撤销栈）：
    //
    // - 事实源 = 窗口属性 `selected-track-id`（宿主拥有，唯一写点是 `host::wire_track_select`）；
    // - 界面**只报下标**（`track-select(track_index)`），"下标 → 身份"由宿主经 `track-ids` 查表；
    // - 界面**不画**新的高亮：默认帧（没有任何选中）逐像素不变。选中之后面板（设备架 /
    //   发送条 / 轨路由）显示的那条轨换掉，这是**已有像素**的内容变化，不是新控件；
    // - 无障碍上，包头本来是 `accessible-item-selectable: true`，这里把
    //   `accessible-item-selected` 绑到"身份 == 选中身份" ⇒ 屏读器能读出哪条被选中
    //   （无障碍属性不是像素）。
    /// 点击轨道头 ⇒ 选中这条轨（宿主写 `selected-track-id` 并重投影）。
    callback track-select(int);
    /// 点击剪辑包头 ⇒ 选中这个片段（界面只报**身份**，它与 `clip-ulids` 的循环变量同源；
    /// 校验 / 写入 / 去重全在 `host::wire_clip_select`）。
    callback clip-select(string);
    // ---------------------------------------------------------------- ⭐ 剪辑平移（拖拽）
    //
    // 与卷帘的 `note-drag-*` 同一条分工：界面只报**身份 + 本地 x**（逻辑像素），
    // 位移 → tick 的换算 / 吸附 / 夹紧 / 预览位移 / 松手时的**一次** `Op::MoveClipPlacement`
    // 全在宿主（`host::wire_clip_drag`）。⛔ 界面不做位置算术。
    /// 按下剪辑体：返回 `true` = 宿主**接管**这一拖（否则界面当普通单击处理）。
    callback clip-drag-grab(string, length) -> bool;
    /// 拖动中：只更新草稿（⛔ 不碰工程 / 撤销栈）。
    callback clip-drag-move(string, length);
    /// 松手：至多一次原子提交（位移没跨过吸附网格 ⇒ 一次都没有）。
    callback clip-drag-release(string, length);
    /// 收尾但不提交（指针取消 / 未越阈值就抬起）。
    callback clip-drag-cancel();

    // ---------------------------------------------------------------- 静音 / 独奏开关
    //
    // 与上面三条同族：界面只**报告事件**（哪条轨道的哪个开关被点了），取反与提交都在宿主。
    //
    // - 界面**不留**开关状态：勾选态的**唯一**来源仍是投影注入的 `track-mutes` /
    //   `track-solos`（本文件的 `background` 与 `accessible-checked` 都读它们）
    //   ⇒ 这里既不新增 `in-out property`，也不新增本地 `bool`，数据流方向不变；
    // - 身份→下标的算术不在界面：这两条回调只上报 `track_index`；
    // - 宿主侧的落点是 MainWindow 上**已有**的 `mixer-mute-toggle` / `mixer-solo-toggle`
    //   （`app.slint` 的声明，唯一实现是 `host::wire_mixer_switch`）。那个实现按下标经
    //   `host::track_id_at` 查宿主注入的 `track-ids`，而 `track-ids` 与 `track-names`
    //   同索引集（`bridge::ViewState::track_ids` / `track_names` 都遍历同一份 `tracks`）
    //   —— 所以编排视图包头用的这个下标就是它要的那个下标。
    /// 点击轨道头的静音开关：`(轨道下标)`。取反与 `Op::SetTrackMute` 由宿主提交。
    callback track-mute-toggle(int);
    /// 点击轨道头的独奏开关：`(轨道下标)`。取反与 `Op::SetTrackSolo` 由宿主提交。
    callback track-solo-toggle(int);
    /// 点击轨道头的录音就绪 (Arm) 开关：`(轨道下标)`。
    callback track-arm-toggle(int);
    /// 轨道重命名：`(轨道下标, 新名称)`。
    callback track-rename(int, string);
    /// 双击剪辑：直达钢琴卷帘（Logic Pro 对齐）。
    callback clip-double-click(string);

    // ---------------------------------------------------------------- 标尺定位（点击走带）
    //
    // 与 `track-height-grab` / `clip-drag-*` 同一条分工：**界面只报指针的本地 x（逻辑像素）**，
    // 像素 → tick 的换算、工程长度夹紧、`TransportCommand::SeekTicks` 与走带读数回写
    // 全在宿主（`host::wire_ruler_seek`）。⛔ 界面不做位置算术。
    //
    /// 点击小节 / 拍标尺：`x` = 指针在**标尺带坐标系**里的横坐标（标尺带左缘 = 工程 0 tick）。
    callback ruler-seek(length);
    /// 无障碍「上一 / 下一小节」：`steps` = 小节数（`+1` / `-1`）。
    /// 与 `ruler-seek` 同一个宿主入口（`host::wire_ruler_seek`）：界面只报**步数**，
    /// 当前位置、一小节多少 tick、夹紧全在宿主从投影 / 引擎现读。
    callback ruler-step(int);
    /// 无障碍「定位到第 N 小节」：`bar` = 用户输入的小节号文本（**1 起**）。
    /// 解析与夹紧同样全在宿主；解析失败 ⇒ 一条命令都不发（⛔ 不猜）。
    callback ruler-seek-bar(string);

    /// 点击章节卡片 ⇒ 走带定位到该段起点（与标尺同一条纪律：界面只报下标，
    /// 起点 tick 由宿主从投影的 `SectionView.start_tick` 现读）。
    callback section-seek(int);

    // ---------------------------------------------------------------- ⭐ 2026-11-07 夜半 UI 轨道交互修复线
    //
    // 横向偏移（`scroll-x`）与内容总长（`content-px`）由 `app.slint` 从根转发：
    // 偏移是宿主拥有的 `roll-scroll-x`（与卷帘共用）；总长是 `apply_view` 每次注入的
    // `arrangement-content-px`。剪辑 x / 标尺小节线 x / 章节卡片 x / 循环区 x /
    // 走带光标 x / 自动化折线 x **各减 `scroll-x`**（包头列固定，仿 Logic 的轨道列表列）；
    // 注入的仍是**绝对值**（`apply_view` 不减滚动），减法只在 `.slint` 这一处。
    in property <float> scroll-x: 0.0;
    in property <float> content-px: 0.0;
    // 缩放滑块 fraction（根 → 视图单向；拖动经 `zoom-*-slider` 回宿主）。
    in property <float> zoom-h-fraction: 0.495;
    in property <float> zoom-v-fraction: 0.231;
    // 重排手势态（根 → 视图单向；`preview-index` < 0 ⇒ 不画插入线）。
    in property <bool> track-reorder-active: false;
    in property <int> track-reorder-index: -1;
    in property <int> track-reorder-preview-index: -1;
    in property <float> track-reorder-preview-y: 0.0;
    /// 缩放按钮：`(放大?)` ⇒ `host::wire_zoom_controls`（与键盘同一条步进算法）。
    callback zoom-h-step(bool);
    callback zoom-v-step(bool);
    /// 缩放滑块：`(0.0..=1.0)` ⇒ 宿主换算后走 `set_*`（唯一写点）。
    callback zoom-h-slider(float);
    callback zoom-v-slider(float);
    /// 重排手势（`host::wire_track_reorder`）：按下 / 拖动（**行空间 y**）/ 收尾。
    callback track-reorder-grab(int, length);
    callback track-reorder-drag(int, length);
    callback track-reorder-release(int);
    /// 包头无障碍动作：`(轨道下标, 方向)`（-1 = 上移一格，+1 = 下移一格）⇒ 直接提交。
    callback track-reorder-step(int, int);
    /// 编曲滚轮（`host::wire_arrangement_wheel`）：`(横向增量, 纵向增量, Shift, Option)`。
    callback arrangement-wheel(length, length, bool, bool);
    /// 横向滚动条（`host::wire_arrangement_hscroll`）：绝对目标 px。
    callback arrangement-scroll-to(length);
    /// 空车道拖动 ⇒ 横向滚动（与卷帘 `scroll-requested` 同一条回调，宿主
    /// `install_roll_scroll`；只在空白车道区生效，不与剪辑拖拽抢事件）。
    callback scroll-requested(length);
    /// 点击自动化车道添加或编辑点 (G-A1): (车道下标, 点击处相对于车道区域的 x, 点击处相对于车道区域的 y)
    callback automation-lane-click(int, length, length);

    // ---------------------------------------------------------------- ⭐ 缩放工具栏（2026-11-07 ①：可见控件路）
    //
    // 位置：左上 168×42 的空角（章节带与标尺带的 x < 168 区域，今日空白；包头列从
    // `rows-top` = 42px 才开始）。两行：H 行（y 0–20，横向）与 V 行（y 20–42，纵向），
    // 每行 [− 按钮][滑块][+ 按钮]。按钮调既有步进（与键盘同一条算法）；滑块是自定义
    // 控件（轨道 + 滑块 TouchArea 拖动报 fraction，按下即定位）。
    //
    // 滑块映射（宿主 `host::zoom_*_fraction` 双向换算，纯函数有单测）：
    // H 用对数（fraction = ln(tpp)/ln(960)，tpp 1..960），V 用线性
    // （fraction = (percent−40)/260，percent 40..300）。滑块 fraction 由根属性
    // `zoom-*-fraction` 驱动（宿主在 `set_*` 唯一写点同步 ⇒ 按钮与滑块不可能分叉）。
    // 滑块 TouchArea 的 fraction = (mouse-x − 7px) / 114px：7px = (轨道 x 22 −
    // TouchArea x 20) + 半个滑块 5px（`mouse-x` 是 TouchArea 局部坐标，⛔ 不是绝对值）。
    //
    // ⚠ 默认帧会被改动（角落工具栏 + 底部滚动条）⇒ golden 须按仓库流程重录
    // （`YEBAN_WRITE_GOLDEN=1`，见完结回执）。
    // H 行：横向缩放
    Rectangle {
        x: 2px;
        y: 1px;
        width: 18px;
        height: 18px;
        // ⭐ [PATCH UI-FEEDBACK-01]：缩放 ± 键此前只有 `clicked`，悬浮 / 按下一位不动。
        // 板提亮 = 悬浮或按下；默认帧（两者皆假）逐字回落到原来的 `bg-panel`
        // ⇒ golden 零像素位移。不新增边框，避免改动几何。四个缩放键同款。
        background: zoom_h_out_touch.pressed || zoom_h_out_touch.has-hover ? Tokens.bg-raised : Tokens.bg-panel;
        border-radius: Tokens.radius-sm;
        accessible-role: button;
        accessible-id: "arrangement-zoom-h-out-button";
        accessible-label: "横向缩小";
        accessible-action-default => { root.zoom-h-step(false); }
        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "-";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }
        zoom_h_out_touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.zoom-h-step(false); }
        }
    }
    Rectangle {
        x: 22px;
        y: 8px;
        width: 124px;
        height: 4px;
        background: Tokens.line;
        border-radius: 2px;
    }
    Rectangle {
        x: 22px + root.zoom-h-fraction * 114px;
        y: 2px;
        width: 10px;
        height: 16px;
        background: Tokens.gold;
        border-radius: Tokens.radius-sm;
    }
    TouchArea {
        x: 20px;
        y: 0;
        width: 128px;
        height: 20px;
        accessible-role: slider;
        accessible-id: "arrangement-zoom-h-slider";
        accessible-label: "横向缩放";
        accessible-value: "" + Math.round(root.zoom-h-fraction * 100) + "%";
        accessible-action-increment => { root.zoom-h-step(true); }
        accessible-action-decrement => { root.zoom-h-step(false); }
        pointer-event(event) => {
            // ⭐ [PATCH UI-DRAG-01] hover ≠ 拖动。Slint 1.18.1 的
            // `TouchArea::input_event` 对 `MouseEvent::Moved` **无条件**派发
            // `PointerEventKind::Move`（`items/input_items.rs:179-185`），而 `moved` 回调
            // 只在 `grabbed`（按下）时触发（`186-188`）。旧写法 `down || move` 因此让
            // 未按下时的悬浮也改缩放 —— 即「没长按也能拖 / 悬浮过去就变了」。
            // `self.pressed` 是 `out property <bool>`，仅在本区域按下时为真
            // （`builtin_elements.rs:1311-1312`），且 grab 期间移出区域仍为真 ⇒ 不切断真拖动。
            if event.kind == PointerEventKind.down
                || (event.kind == PointerEventKind.move && self.pressed) {
                root.zoom-h-slider(max(0.0, min(1.0, (self.mouse-x - 7px) / 114px)));
            }
        }
    }
    Rectangle {
        x: 148px;
        y: 1px;
        width: 18px;
        height: 18px;
        // [PATCH UI-FEEDBACK-01]：与横向缩小键同款（悬浮 / 按下 ⇒ `bg-raised`，默认帧零位移）。
        background: zoom_h_in_touch.pressed || zoom_h_in_touch.has-hover ? Tokens.bg-raised : Tokens.bg-panel;
        border-radius: Tokens.radius-sm;
        accessible-role: button;
        accessible-id: "arrangement-zoom-h-in-button";
        accessible-label: "横向放大";
        accessible-action-default => { root.zoom-h-step(true); }
        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "+";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }
        zoom_h_in_touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.zoom-h-step(true); }
        }
    }
    // V 行：纵向缩放
    Rectangle {
        x: 2px;
        y: 21px;
        width: 18px;
        height: 18px;
        // [PATCH UI-FEEDBACK-01]：与横向缩小键同款（悬浮 / 按下 ⇒ `bg-raised`，默认帧零位移）。
        background: zoom_v_out_touch.pressed || zoom_v_out_touch.has-hover ? Tokens.bg-raised : Tokens.bg-panel;
        border-radius: Tokens.radius-sm;
        accessible-role: button;
        accessible-id: "arrangement-zoom-v-out-button";
        accessible-label: "纵向缩小";
        accessible-action-default => { root.zoom-v-step(false); }
        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "-";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }
        zoom_v_out_touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.zoom-v-step(false); }
        }
    }
    Rectangle {
        x: 22px;
        y: 28px;
        width: 124px;
        height: 4px;
        background: Tokens.line;
        border-radius: 2px;
    }
    Rectangle {
        x: 22px + root.zoom-v-fraction * 114px;
        y: 22px;
        width: 10px;
        height: 16px;
        background: Tokens.gold;
        border-radius: Tokens.radius-sm;
    }
    TouchArea {
        x: 20px;
        y: 20px;
        width: 128px;
        height: 20px;
        accessible-role: slider;
        accessible-id: "arrangement-zoom-v-slider";
        accessible-label: "纵向缩放";
        accessible-value: "" + Math.round(root.zoom-v-fraction * 100) + "%";
        accessible-action-increment => { root.zoom-v-step(true); }
        accessible-action-decrement => { root.zoom-v-step(false); }
        pointer-event(event) => {
            // ⭐ [PATCH UI-DRAG-01]：与横向缩放滑块同款 —— `move` 只在 `self.pressed`
            // 时跟进，未按下时的悬浮不再改行高（根因见上面横滑块的登记）。
            if event.kind == PointerEventKind.down
                || (event.kind == PointerEventKind.move && self.pressed) {
                root.zoom-v-slider(max(0.0, min(1.0, (self.mouse-x - 7px) / 114px)));
            }
        }
    }
    Rectangle {
        x: 148px;
        y: 21px;
        width: 18px;
        height: 18px;
        // [PATCH UI-FEEDBACK-01]：与横向缩小键同款（悬浮 / 按下 ⇒ `bg-raised`，默认帧零位移）。
        background: zoom_v_in_touch.pressed || zoom_v_in_touch.has-hover ? Tokens.bg-raised : Tokens.bg-panel;
        border-radius: Tokens.radius-sm;
        accessible-role: button;
        accessible-id: "arrangement-zoom-v-in-button";
        accessible-label: "纵向放大";
        accessible-action-default => { root.zoom-v-step(true); }
        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "+";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }
        zoom_v_in_touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.zoom-v-step(true); }
        }
    }

    // ---------------------------------------------------------------- 章节卡片层 (§4.3)
    for section_name[section_index] in root.sections : Rectangle {
        x: 168px + root.section-positions[section_index] - (root.scroll-x * 1px);
        y: 0;
        width: root.section-widths[section_index];
        height: 20px;
        background: section_index.mod(2) == 0 ? Tokens.bg-panel-alt : Tokens.bg-panel;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: list-item;
        accessible-id: "section-" + section_index + "-card";
        accessible-label: "章节 " + section_name;
        accessible-item-index: section_index;
        accessible-item-count: root.sections.length;
        // ⭐ `U-05`：章节卡片此前**只显示、不可点**。默认动作 = 走带定位到该段起点
        // （与下面 `TouchArea` 的 down 逐字同一个回调）—— 屏读器 / 自动化因此不需要
        // 点像素坐标就能跳段。⛔ 不新增 a11y 节点：动作是既有节点上的属性。
        accessible-action-default => { root.section-seek(section_index); }

        // 点击面：零视觉、零算术 —— 只把**下标**原样报给宿主。
        // 第一个子元素（最底层）：色标 / 文字只是绘制，不抢命中。
        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.section-seek(section_index);
                }
            }
        }

        // 段落色标 —— `SectionV3::color` 经投影解析后的颜色（非法 / 缺失已回退）。
        // 3px 竖条贴在卡片左缘；文字从 `space-3`（6px）开始 ⇒ 两者不重叠
        // （采样点因此不会被字形栅格污染，见 sidebar 条目判据的教训）。
        Rectangle {
            x: 0;
            y: 0;
            width: 3px;
            height: parent.height;
            background: root.section-colors[section_index];
            accessible-role: image;
            accessible-id: "section-" + section_index + "-color-swatch";
            accessible-label: "段落色标 " + root.section-color-labels[section_index];
        }

        UiSerifText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: section_name;
            color: Tokens.gold;
            font-size: Tokens.font-size-xs;
            overflow: elide;
        }
    }

    // ---------------------------------------------------------------- 小节 / 拍标尺 (§4.2)
    Rectangle {
        x: 168px;
        y: 20px;
        width: parent.width - 168px;
        height: 22px;
        background: Tokens.bg-panel;
        // ⭐ `U-07 R2`：标尺是一个**可调定位器**（scrubber），不是只读文本 ⇒ 角色从
        // `text` 升为 `slider`。三个无障碍动作给出"定位到第 N 小节"的**非指针**入口：
        // 增减 = 上 / 下一小节，SetValue = 输入小节号（1 起，宿主解析）。
        // `accessible-value` 报的是**当前走带位置**（与时间码同一个引擎读数）。
        accessible-role: slider;
        accessible-id: "arrangement-ruler";
        accessible-label: "小节与拍标尺";
        accessible-value: root.playhead-timecode;
        accessible-action-increment => { root.ruler-step(1); }
        accessible-action-decrement => { root.ruler-step(-1); }
        accessible-action-set-value(v) => { root.ruler-seek-bar(v); }

        // ⭐ 点击标尺 ⇒ 走带定位。与轨道头的拖拽面**同款纪律**：
        //
        // - **零视觉**：`TouchArea` 不画任何东西 ⇒ 默认帧一位不变（标尺线、条数、颜色都不动）；
        // - **零算术**：只把 `mouse-x` 原样报给宿主，像素 → tick 的换算与夹紧都在宿主侧；
        // - **零新 a11y 节点**：本面不带 `accessible-id`（与轨道头那条 `TouchArea` 逐字一致）
        //   ⇒ 元素树与 golden 截图的既有断言（`tests/a11y_screen_reader.rs`、
        //   `tests/pane_no_overlap.rs` 里的 `arrangement-ruler`）逐字不变；
        // - 它是标尺带的**第一个**子元素（最底层），排在它后面的 `for … : Rectangle` 只是
        //   1px 宽的小节线（无 `TouchArea`）⇒ 命中测试没有竞争者。
        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.ruler-seek(self.mouse-x);
                }
            }
            // ⭐ `U-07 R3`：按住拖动 ⇒ **连续**定位（`moved` 只在按下期间触发，
            // 与上面的 down 共用同一条 `ruler-seek`；换算 / 吸附 / 夹紧仍在宿主）。
            moved => {
                root.ruler-seek(self.mouse-x);
            }
            // ⭐ 2026-11-07（夜半 UI 轨道交互修复线）：滚轮分流 —— 带 Shift / Option
            // 时接宿主（横向滚动 / 纵向缩放 / 横向缩放），无修饰返回 `reject`
            // （标尺带不在 Flickable 内，无修饰的滚轮本来就什么都不做 ⇒ 行为不变）。
            scroll-event(event) => {
                if event.modifiers.shift || event.modifiers.alt {
                    root.arrangement-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
                    accept
                } else {
                    reject
                }
            }
        }

        // 小节线位置由投影给出（一小节 = 960 PPQ × 分子 × 4 ÷ 分母 tick）。
        // `for _[i] in <model>`：**必须**有声明标识符（`_` 即可）。Slint 1.18.1 不接受
        // 只有索引的 `for [i] in <model>`（上游 parser 的 doc 注释里有，真实语法没有）。
        // 实测解析错误见 docs/ledger/app-binding-notes.md（CI run 37228953370）。
        for _[bar_index] in root.bar-positions : Rectangle {
            x: root.bar-positions[bar_index] - (root.scroll-x * 1px);
            y: 0;
            width: 1px;
            height: parent.height;
            background: bar_index.mod(4) == 0 ? Tokens.line-strong : Tokens.line;
        }

        // Logic Pro 循环区指示带 (Cycle/Loop bar)
        if root.cycle-enabled : Rectangle {
            x: max(0px, (root.cycle-start-ticks / max(1, root.ticks-per-pixel)) * 1px - (root.scroll-x * 1px));
            y: 0px;
            width: max(4px, ((root.cycle-end-ticks - root.cycle-start-ticks) / max(1, root.ticks-per-pixel)) * 1px);
            height: 4px;
            background: Tokens.gold;
            border-radius: 2px;
        }
    }

    // ---------------------------------------------------------------- 行区滚动容器（纵向）
    //
    // 缺口：行区此前是**固定**的 —— 轨道多到超出可视高度后，第 N 行之后既点不到也
    // 看不到（真实工程 28 轨时只有前 ~8 行可达）。本容器只做**纵向**偏移：
    // `content-width: self.width` ⇒ 横向不动（横向仍归宿主 `scroll-x`，见卷帘的
    // 第 199 轮教训：⛔ 不让 Flickable 与宿主偏移双重计算）。
    //
    // ⚠ 必须写 `content-*` 而不能写 `viewport-*`（后者是前者的 `@deprecated` 别名）：
    //   上游 `flickable` 编译 pass 跑在 `remove_aliases` **之前**，它按名字判断
    //   `content-height` 上有没有显式绑定来决定是否自动生成内容高（自动值 = 容器自身高，
    //   `for` 循环子元素不参与，即上游 issue #407）。绑定写在别名上 ⇒ 该检查读不到 ⇒
    //   自动绑定照样装上，随后别名折叠时两个绑定合并、显式值可能被丢弃 ⇒ 内容高恒等于
    //   可视高 ⇒ `is_allowed_scroll_direction` 恒 false ⇒ **滚轮被忽略并转发给父级**。
    //   实测代价：run 41208446082 两条判据红（首行 y 一位不动）。
    //
    // - 滚轮由上游 `Flickable` 处理（`PointerScrolled` 的 `Cancelled` 相位是**直接
    //   set**、无动画 ⇒ 判据可立即读到新几何）；触摸拖动需要 `interactive`。
    // - `content-height` 取 `max(可视高, 注入的行区内容高)`：演示工程（6 轨）内容不高
    //   ⇒ 偏移恒 0、没有滚动条、默认帧逐像素不变。
    // - 容器**没有** `accessible-id` ⇒ 不进控件树（`inspect.rs`：不可寻址的节点不登记）。
    // - 子元素的 y 是**行区局部坐标**（投影的 y 减 `rows-top`）；⛔ 界面不重算行几何，
    //   只减这一个常量。
    Flickable {
        x: 0;
        y: root.rows-top;
        width: parent.width;
        height: parent.height - root.rows-top - 14px;
        content-width: self.width;
        content-height: max(self.height, root.sheet-height * 1px);
        interactive: true;

    // ---------------------------------------------------------------- 轨道包头列
    for track_name[track_index] in root.tracks : Rectangle {
        x: 0;
        // 行几何由投影的前缀和给出 (ADR-0004 S0); 滚动容器内只减去行区上沿。
        y: root.track-ys[track_index] - root.rows-top;
        width: 168px;
        height: root.track-heights[track_index];
        // 包头: 负责人给了**一级**「鸦青·暗」(bg-head); 我们的包头是隔行交替的, 交替本身
        // 是既有几何 (去掉它会改默认渲染字节) ⇒ 偶行用 panel、奇行用 head, 两个值都来自
        // 负责人的墨阶, 且 brand 分支分别等于原来的 bg-panel / bg-shell。
        background: track_index.mod(2) == 0 ? Tokens.bg-panel : Tokens.bg-head;
        border-width: 1px;
        border-color: Tokens.line;
        clip: true;
        accessible-role: list-item;
        accessible-id: "track-" + track_index + "-header";
        accessible-label: "轨道 " + track_name;
        accessible-item-index: track_index;
        accessible-item-count: root.tracks.length;
        accessible-item-selectable: true;
        // ⭐ 任务单 `#192`：无障碍选中态（**不是像素**）。选中态按**身份**键控 ⇒
        // 删轨 / 撤销之后不会因为下标重排而指到另一条轨。
        accessible-item-selected: root.selected-track-id == root.track-ids[track_index];
        // 无障碍默认动作 = 选中这条轨（与下面 `TouchArea` 的 down 逐字同一个回调）。
        // 屏读器 / 自动化因此**不需要**点像素坐标就能选中一条轨。
        accessible-action-default => { root.track-select(track_index); }
        // ⭐ 2026-11-07（夜半 UI 轨道交互修复线）：包头无障碍移轨动作 ——
        // 增 = 下移一格，减 = 上移一格（落点 `host::wire_track_reorder` 的
        // `track-reorder-step`，直接提交；无菜单系统 ⇒ 这是键盘之外的配套操作）。
        accessible-action-increment => { root.track-reorder-step(track_index, 1); }
        accessible-action-decrement => { root.track-reorder-step(track_index, -1); }

        // 轨道头拖拽面（`ADR-0004` S1 的纵向入口）。
        //
        // - **零视觉**：`TouchArea` 不画任何东西 ⇒ 默认帧一位不变（没有覆盖、乘子 100 时
        //   注入的行几何也一位不变）；
        // - **零算术**：它只把 `mouse-y` 原样报给宿主，位移与像素换算都在宿主侧；
        // - 它是包头矩形的**第一个**子元素（最底层）：静音 / 独奏两个 `TouchArea` 排在它
        //   之后，Slint 的命中测试自前往后 ⇒ 那两个按钮照旧先拿到点击，拖拽面只接管
        //   剩下的区域（这才是"轨道头可以按"与"按钮还能按"同时成立的原因）。
        //
        // ⭐ 2026-11-07（夜半 UI 轨道交互修复线）：手势分区（按 Logic：拖轨道号/名称区 =
        // 重排，拖包头底部边缘条 = 高度）。按下时按 `mouse-y` 定区 —— y < 高度−6px 为
        // 重排区（名称区），底边 6px 为高度区（现有行为保留、触发区收窄）。
        // ⚠ **行为变更**：此前整个包头都改行高；此后行中按下不再改行高，既有高度拖拽
        // 判据（`tests/d_ui_11_serve_header_gestures.rs` ⑤、`tests/live_ui_mcp.rs` 两处）
        // 已同步改成"底边 6px 内按下"。单击仍选中（down 照旧调 `track-select`）。
        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    // ⭐ 任务单 `#192`：按下即选中（一次点击 = 选中这条轨，⛔ 不提交工程）。
                    // 与拖行高 / 重排共用**同一个** TouchArea ⇒ 零新像素、零新命中区域；
                    // 静音 / 独奏两个 `TouchArea` 仍先拿到点击（见上面的排序说明）。
                    root.track-select(track_index);
                    if self.mouse-y < self.height - 6px {
                        // 名称区 ⇒ 重排：报**行空间 y**（行顶沿 + 头内 y），宿主算插入位置。
                        root.track-reorder-grab(track_index, root.track-ys[track_index] + self.mouse-y);
                    } else {
                        root.track-height-grab(track_index, self.mouse-y);
                    }
                } else if event.kind == PointerEventKind.move {
                    if root.track-reorder-active {
                        // ⭐ 2026-11-07：重排进行中按**已抓取下标**路由 —— 按下时的 `track-select`
                        // 改选中会走 `apply_view` 重注模型（每次新建 `VecModel`）、重建包头项，
                        // 按下那一刻的指针抓取随之失效（`i-slint-core` 的 `handle_mouse_grab` 遇
                        // 上已销毁项就把事件交回命中测试），移出原包头后事件会落到别行的
                        // TouchArea。下标取已抓取的那条；行空间 y 仍由接收头的自身几何算
                        // （`track-ys[接收下标] + 头内 y`，在哪一行收到都是同一个行空间点）。
                        root.track-reorder-drag(root.track-reorder-index, root.track-ys[track_index] + self.mouse-y);
                    } else {
                        // ⭐ [PATCH UI-DRAG-01] 复核结论（2026-11-08）：这里**不能**加
                        // `self.pressed`（或任何"本控件按下态"）守卫。两条硬理由：
                        // ① 包头 `down` 先调 `track-select` ⇒ 宿主 `apply_view` 重注模型、
                        //    重建包头项 ⇒ 按下那一刻的指针抓取随之失效，`move` 落到新建的
                        //    TouchArea（它从未收到 `down` ⇒ `self.pressed == false`）；
                        //    加守卫会把真实拖拽整条吞掉（`d_ui_11` ⑤ 回归实证：行高一位不动）。
                        //    行高与重排其实是**同一条跨控件路径**，不是"包头内手势"。
                        // ② 悬浮（未按下）的 `move` **不会**误改行高：宿主
                        //    `host::track_height_drag_target_px` 以 `track-height-drag-active`
                        //    为唯一读数，先查 `active`、再查"下标 == 起手那一行的身份"，
                        //    孤立的 move 直接 `return`（`host.rs` 注释："一个孤立的 move
                        //    永远改不动几何"）；只有 `grab` 置位、`release` 清零。
                        //    ⇒ 手势门槛在宿主侧已闭环，界面无需也不该有第二份守卫。
                        root.track-height-drag(track_index, self.mouse-y);
                    }
                } else {
                    // `up` 与 `cancel` 都是收尾。`cancel` 由上游在"指针离开窗口 /
                    // 控件被禁用"时导出（`i-slint-core` 的 `input_items.rs`：
                    // `MouseEvent::Exit` ⇒ `PointerEventKind::Cancel`）⇒ 拖到窗口外松手
                    // 也走这条路，不会留下粘住的拖拽态。
                    if root.track-reorder-active {
                        // ⭐ 2026-11-07：同上，松手点若已越出原包头，`track_index` 是命
                        // 中测试的那一行，不是拖的那条 ⇒ 按已抓取下标收尾，否则宿主因
                        // 下标不符丢弃提交、拖拽态粘住。
                        root.track-reorder-release(root.track-reorder-index);
                    } else {
                        root.track-height-release(track_index);
                    }
                }
            }
            // ⭐ 2026-11-07：滚轮分流 —— 带 Shift / Option 时接宿主，无修饰返回
            // `reject` ⇒ 冒泡给 Flickable 纵向滚动（与车道滚轮同一条口径）。
            scroll-event(event) => {
                if event.modifiers.shift || event.modifiers.alt {
                    root.arrangement-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
                    accept
                } else {
                    reject
                }
            }
        }

        // -------------------------------------------------------------- [PATCH UI-TRACK-KINDS-01]
        // Logic Pro 风格轨道头：按 `ViewState::track_kinds()` 的投影读数，给每类轨道一条
        // **类型色带**（左沿 3px 全高）＋ 一条**类型色顶边**（2px）＋ 一个**类型徽标**
        // （第二行按钮组与音量读数之间的 40px 空档）。
        //
        // ⛔ 三条纪律：
        // ① 三个节点全是**纯视觉**（Rectangle / UiText）：无 `accessible-id` ⇒ 不进 ui/tree
        //    控件树（pane_no_overlap / elements 注册表一位不动）；无 `TouchArea` /
        //    `clicked` / `callback` ⇒ 不改命中测试、不改活文档计数。它们排在包头拖拽
        //    `TouchArea` **之后**声明，因此"拖拽面是第一个子元素"的既有假设一位不动。
        // ② 不改包头 `accessible-label: "轨道 " + track_name`（live_ui_mcp 逐字断言），
        //    不把 `selected-track-id` 引入可见样式（track_selection 棘轮）。
        // ③ `visible` 用「下标 + 非空」双守卫：`track-kinds` 未注入或与 `tracks` 不等长
        //    时整组不画 ⇒ 不伪造"这条轨道是什么类型"的读数（与注入族同款诚实口径）。
        //
        // 色板（三支都是随主题的既有令牌、色相拉开；⛔ 不用全界面唯一强调色令牌）：
        //   midi       → `Tokens.gold`（渔火·暖金）
        //   audio      → `Tokens.gold-deep`（客船·冷蓝）
        //   aux-return → `Tokens.playing`（铜绿）
        //   其它 / 空  → `Tokens.line-strong`（雾线·中性；此时 `visible: false` ⇒ 不画）
        // 类型映射在每个节点内联重复（⛔ 不用局部 `property` 共享）：repeater 元素的
        // `parent.*` 自定义属性作用域在 Slint 1.18 下不稳，内联是最直白的唯一真相源写法。

        // ① 左沿类型色带 —— Logic Pro 轨道头最标志性的那条竖直色带，贯通整行高。
        Rectangle {
            x: 0;
            y: 0;
            width: 3px;
            height: parent.height;
            visible: root.track-kinds.length > track_index && root.track-kinds[track_index] != "";
            background: root.track-kinds[track_index] == "midi" ? Tokens.gold
                : (root.track-kinds[track_index] == "audio" ? Tokens.gold-deep
                : (root.track-kinds[track_index] == "aux-return" ? Tokens.playing
                : Tokens.line-strong));
        }

        // ② 类型色顶边 —— 给每行一个清晰的顶部分层（Logic Pro 的轨道分组线）。
        Rectangle {
            x: 3px;
            y: 0;
            width: parent.width - 3px;
            height: 2px;
            visible: root.track-kinds.length > track_index && root.track-kinds[track_index] != "";
            background: root.track-kinds[track_index] == "midi" ? Tokens.gold
                : (root.track-kinds[track_index] == "audio" ? Tokens.gold-deep
                : (root.track-kinds[track_index] == "aux-return" ? Tokens.playing
                : Tokens.line-strong));
        }

        // ③ 类型徽标 —— 深色字压在类型实色上，MIDI / AUD / AUX 一眼可分。
        Rectangle {
            x: 82px;
            y: 26px;
            width: 36px;
            height: 18px;
            visible: root.track-kinds.length > track_index && root.track-kinds[track_index] != "";
            border-radius: Tokens.radius-sm;
            background: root.track-kinds[track_index] == "midi" ? Tokens.gold
                : (root.track-kinds[track_index] == "audio" ? Tokens.gold-deep
                : (root.track-kinds[track_index] == "aux-return" ? Tokens.playing
                : Tokens.line-strong));

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.track-kinds[track_index] == "midi" ? "MIDI"
                    : (root.track-kinds[track_index] == "audio" ? "AUD"
                    : (root.track-kinds[track_index] == "aux-return" ? "AUX" : ""));
                color: Tokens.bg-void;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }
        }

        UiMediumText {
            x: Tokens.space-4;
            y: Tokens.space-2;
            width: 96px;
            height: 18px;
            text: track_name;
            color: Tokens.ink-0;
            font-size: Tokens.font-size-md;
            overflow: elide;
        }

        // 轨道色标 —— `TrackV3::color` 经投影解析后的颜色（非法 / 缺失已回退）。
        // 它同时是"色标可被自动化读到"的落点：`accessible-label` 携带规范化 `#RRGGBB`，
        // 因此无头控件树里 `track-{i}-color-swatch` 的标签 == 投影字段
        // （判据两侧各有一条：`elements::track_color_swatches_carry_the_projected_hex`
        // 与 Tier-1 的 `project_projection_reaches_the_control_tree_and_the_pixels`）。
        Rectangle {
            x: 124px;
            y: Tokens.space-2;
            width: 10px;
            height: 18px;
            background: root.track-colors[track_index];
            border-radius: Tokens.radius-sm;
            accessible-role: image;
            accessible-id: "track-" + track_index + "-color-swatch";
            accessible-label: "轨道色标 " + root.track-color-labels[track_index];
        }

        // 静音 —— `accessible-checked` 来自工程的 `TrackV3::mute`
        Rectangle {
            x: Tokens.space-4;
            y: 26px;
            width: 22px;
            height: 18px;
            background: root.track-mutes[track_index] ? Tokens.record-red : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-mute-button";
            accessible-label: "轨道 " + track_name + " 静音";
            accessible-checkable: true;
            accessible-checked: root.track-mutes[track_index];
            // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
            accessible-action-default => { root.track-mute-toggle(track_index); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "M";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                // 点击 ⇒ `Op::SetTrackMute`（一次点击 = 一次可撤销的编辑）。
                // 与混音台同款：`console/mixer_console.slint` 的静音 `TouchArea` 调的也是
                // 同一个宿主面（`MainWindow::mixer-mute-toggle`）。界面只报下标，不改值。
                clicked => {
                    root.track-mute-toggle(track_index);
                }
            }
        }

        // 独奏 —— `accessible-checked` 来自工程的 `TrackV3::solo`
        Rectangle {
            x: 34px;
            y: 26px;
            width: 22px;
            height: 18px;
            background: root.track-solos[track_index] ? Tokens.gold-deep : Tokens.bg-void;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-solo-button";
            accessible-label: "轨道 " + track_name + " 独奏";
            accessible-checkable: true;
            accessible-checked: root.track-solos[track_index];
            // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
            accessible-action-default => { root.track-solo-toggle(track_index); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "S";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                // 点击 ⇒ `Op::SetTrackSolo`。与静音开关**成对同款**，只换目标字段。
                clicked => {
                    root.track-solo-toggle(track_index);
                }
            }
        }

        // 录音就绪 (Arm) 开关 —— [UI-TEST-001]
        Rectangle {
            x: 58px;
            y: 26px;
            width: 22px;
            height: 18px;
            background: (track_index < root.track-arms.length && root.track-arms[track_index]) ? Tokens.record-red : transparent;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "track-" + track_index + "-arm-button";
            accessible-label: "轨道 " + track_name + " 录音准备";
            accessible-checkable: true;
            accessible-checked: track_index < root.track-arms.length && root.track-arms[track_index];
            accessible-action-default => { root.track-arm-toggle(track_index); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: (track_index < root.track-arms.length && root.track-arms[track_index]) ? "R" : "";
                color: Tokens.ink-0;
                font-size: Tokens.font-size-xs;
                horizontal-alignment: center;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.track-arm-toggle(track_index);
                }
            }
        }

        // 音量显示 = `TrackV3::volume_db` 的字符串形态（投影层格式化）
        UiMonoText {
            x: 120px;
            y: 26px;
            width: 40px;
            height: 18px;
            text: root.track-volumes[track_index];
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: right;
        }
    }

    // ---------------------------------------------------------------- 时间轴车道 + 剪辑
    // 每条非主总线轨道一条车道 —— 车道数 = 工程里的轨道数。
    // `for _[i] in <model>` 必须带声明标识符（`_` 即可）—— 见本文件标尺那处的注释。
    for _[lane_index] in root.tracks : Rectangle {
        x: 168px;
        // 与包头同一个数组、同一个下标 —— 两条循环必须落在同一行上。
        y: root.track-ys[lane_index] - root.rows-top;
        width: parent.width - 168px;
        height: root.track-heights[lane_index];
        // 车道: 负责人给了**两级**墨阶 —— 墨池 (bg-lane) / 墨池·深 (bg-lane2)。
        background: lane_index.mod(2) == 0 ? Tokens.bg-lane : Tokens.bg-lane2;
        border-width: 1px;
        border-color: Tokens.line;
    }

    // ⭐ 2026-11-07（夜半 UI 轨道交互修复线）：空车道拖动 ⇒ 横向滚动。
    //
    // 一块覆盖全部车道的 TouchArea（置于车道矩形循环之后、剪辑循环之前 ⇒ 剪辑仍在
    // 上层，命中测试先到剪辑；只在空白车道区生效，不与剪辑拖拽抢事件）。
    // 照抄卷帘 `piano_roll.slint` 的 `scroll-requested(drag-last-x - mouse-x)` 模式：
    // 按下记 `drag-last-x`，move 时报增量并更新，越过 4px 阈值才滚动（小抖动不滚）。
    // 高度 = 行区内容高（`sheet-height`）；纵向位移不处理（纵向归 Flickable）。
    TouchArea {
        x: 168px;
        y: 0;
        width: parent.width - 168px;
        height: root.sheet-height * 1px;
        accessible-role: region;
        accessible-id: "arrangement-lane-scroll-area";
        accessible-label: "编曲空车道拖动滚动面";
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.lane-drag-origin-x = self.mouse-x;
                root.lane-drag-last-x = self.mouse-x;
                root.lane-drag-moved = false;
                root.lane-dragging = true;
            } else if event.kind == PointerEventKind.up {
                root.lane-dragging = false;
                root.lane-drag-moved = false;
            } else if event.kind == PointerEventKind.move {
                if !root.lane-drag-moved
                    && ((self.mouse-x - root.lane-drag-origin-x) > 4px
                        || (root.lane-drag-origin-x - self.mouse-x) > 4px) {
                    root.lane-drag-moved = true;
                }
                if root.lane-dragging && root.lane-drag-moved {
                    root.scroll-requested(root.lane-drag-last-x - self.mouse-x);
                    root.lane-drag-last-x = self.mouse-x;
                }
            } else {
                // `cancel`：收尾但不提交（拖动滚动没有草稿要丢，只有状态要清）。
                root.lane-dragging = false;
                root.lane-drag-moved = false;
            }
        }
        // ⭐ 滚轮分流 —— 带 Shift / Option 时接宿主，无修饰返回 `reject` ⇒
        // 冒泡给 Flickable 纵向滚动（与包头滚轮同一条口径）。
        scroll-event(event) => {
            if event.modifiers.shift || event.modifiers.alt {
                root.arrangement-wheel(event.delta-x, event.delta-y, event.modifiers.shift, event.modifiers.alt);
                accept
            } else {
                reject
            }
        }
    }

    for clip_ulid[clip_index] in root.clip-ulids : Rectangle {
        // 拖动期只有**正在被拖**的那一条读草稿位移；其余（以及没有手势时）逐像素不变。
        // ⭐ 2026-11-07：减 `scroll-x`（注入的是绝对值，见文件头注释）。
        x: 168px + root.clip-positions[clip_index]
            + (clip_ulid == root.clip-drag-ulid ? root.clip-drag-preview-dx * 1px : 0px)
            - (root.scroll-x * 1px);
        // 剪辑的 y / 高由投影从所在行的行几何派生 (ADR-0004 S0)。
        y: root.clip-ys[clip_index] - root.rows-top;
        width: root.clip-widths[clip_index];
        height: root.clip-heights[clip_index];
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.gold-deep;
        clip: true;

        // 剪辑包头 —— [UI-TEST-001] `clip-{ulid}-header`，`{ulid}` = 工程的摆放身份
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 18px;
            // 静音态 = 包头底色从 `bg-raised`（绀灰 `#1e2733`）沉到 `bg-void`
            // （玄夜 `#0e1216`，每通道约低一半 ⇒ "这一条不出声"）。
            // 与上面轨静音按钮的 `record-red` **不同**：按钮是一枚小方片，整条 18px 包头
            // 若也刷红会把整行染成告警色；这里取"沉下去"的读法。名字里带上"（静音）"
            // 让读屏念得出来。未静音（默认全 false）⇒ 逐像素不变。
            background: root.clip-mutes[clip_index] ? Tokens.bg-void : Tokens.bg-raised;
            // 选中态 = 包头描边（与音符矩形同一支令牌 `selection`；⛔ 不改填充）。
            // 没有选中（默认）⇒ 0px 无描边 ⇒ 默认帧逐像素不变。
            border-width: root.selected-clip-ulid == clip_ulid ? 2px : 0px;
            border-color: root.selected-clip-ulid == clip_ulid ? Tokens.selection : transparent;
            accessible-role: list-item;
            accessible-id: "clip-" + clip_ulid + "-header";
            accessible-label: "剪辑 " + root.clip-labels[clip_index]
                + (root.clip-mutes[clip_index] ? "（静音）" : "");
            accessible-item-index: clip_index;
            accessible-item-count: root.clip-ulids.length;
            accessible-item-selectable: true;
            // 选中态按**身份**键控（与轨道头同款）：下标会在撤销 / 重排后指向别的剪辑。
            accessible-item-selected: root.selected-clip-ulid == clip_ulid;
            accessible-action-default => { root.clip-select(clip_ulid); }

            // 点击面：零视觉、零算术 —— 只把**身份**原样报给宿主。
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.clip-select(clip_ulid); }
                double-clicked => { root.clip-double-click(clip_ulid); }
            }

            UiMonoText {
                x: Tokens.space-3;
                y: 0;
                width: parent.width - 8px;
                height: parent.height;
                text: clip_ulid;
                color: Tokens.gold;
                font-size: Tokens.font-size-xs;
                overflow: elide;
            }
        }

        // 波形占位块 (真实波形金字塔等 yeban-render)
        Rectangle {
            x: Tokens.space-3;
            y: 24px;
            width: parent.width - 12px;
            height: 16px;
            background: Tokens.bg-raised;
            border-radius: Tokens.radius-sm;
        }
    }

    // 拖动面：**单独一轮循环**、位置恒等于投影的布局槽（⛔ 不读草稿位移）。
    //
    // 为什么不能放在上面那个会移动的剪辑块里：拖动面的 `mouse-x` 是**相对它自己**的
    // 局部坐标（本版本 `PointerEvent` 没有 `position` / `delta-x`）。若它跟着草稿位移走，
    // 预览每挪 1px 就把同一根手指的局部 x 反向改 1px ⇒ 位移读数自我抵消（橡皮筋效应）。
    // 因此"动的"只有画面，输入面的坐标系**不动**；指针按下后 Slint 会把后续事件继续
    // 送给这个抓取中的 `TouchArea`（即使指针已离开它的外框）。
    //
    // 只覆盖包头以下的剪辑体：包头归选中臂（`clip-{ulid}-header`），两者不抢同一块像素。
    for clip_ulid[clip_index] in root.clip-ulids : TouchArea {
        // ⭐ 2026-11-07：减 `scroll-x`（与剪辑矩形同一格；位移量是同一 TouchArea 内的
        // 局部坐标差，减法不影响 `clip_drag_target_tick` 的位移读数）。
        x: 168px + root.clip-positions[clip_index] - (root.scroll-x * 1px);
        y: root.clip-ys[clip_index] + 18px - root.rows-top;
        width: root.clip-widths[clip_index];
        height: root.clip-heights[clip_index] - 18px;
        accessible-role: region;
        accessible-id: "clip-" + clip_ulid + "-body";
        accessible-label: "剪辑拖动面 " + root.clip-labels[clip_index];

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-origin-x = self.mouse-x;
                root.drag-moved = false;
                // 先问宿主"这一按是不是**平移剪辑**"；接管 ⇒ 界面的拖动通道只报位置。
                root.dragging = root.clip-drag-grab(clip_ulid, self.mouse-x);
            } else if event.kind == PointerEventKind.up {
                if root.dragging {
                    root.dragging = false;
                    if root.drag-moved {
                        // 越了 4px ⇒ 拖拽收尾（宿主至多提交**一次**原子 Op）。
                        root.clip-drag-release(clip_ulid, self.mouse-x);
                    } else {
                        // 没越阈值 ⇒ 一次单击 ⇒ 与包头同一个选中落点（宿主丢弃空手势）。
                        root.clip-drag-cancel();
                        root.clip-select(clip_ulid);
                    }
                }
                root.drag-moved = false;
            } else if event.kind == PointerEventKind.move {
                // 阈值判定用两个方向各自比较（与卷帘手势面逐字同款）。
                if !root.drag-moved
                    && ((self.mouse-x - root.drag-origin-x) > 4px
                        || (root.drag-origin-x - self.mouse-x) > 4px) {
                    root.drag-moved = true;
                }
                if root.dragging && root.drag-moved {
                    root.clip-drag-move(clip_ulid, self.mouse-x);
                }
            } else {
                // `cancel`（指针离开窗口 / 控件被禁用）：收尾但**不提交**。
                root.dragging = false;
                root.drag-moved = false;
                root.clip-drag-cancel();
            }
        }

        double-clicked => {
            root.clip-double-click(clip_ulid);
        }
    }

    // ---------------------------------------------------------------- 自动化曲线 (自动化泳道)
    //
    // 一条泳道一个**可寻址元素** + 一条折线。为什么是覆盖在轨道车道上而不是单独一行:
    // 编排视图的车道行几何来自投影的行几何 (`track-ys` / `track-heights`, 前缀和,
    // ADR-0004 S0), 插入独立的自动化行会改动每一条剪辑 / 音符的 y —— 那是
    // [UI-NOTE-001] 视口裁剪的范围, 不在本线。
    // 因此本线用"覆盖模式": 一条轨道上有 N 条泳道时, 把该车道行**等分**成 N 条带
    // (带高 = (row.stride − 2×2) / N), `band-ys` / `band-heights` 由投影从**同一份**
    // 行几何算好注入 —— 界面侧零算术。
    //
    // 折线用 `Path` 的 SVG 命令 (`commands`)。三条与"坐标必须逐位等于投影的像素"有关的
    // 细节, 都是查上游源码后写死的:
    //   ① `viewbox-*` = 元素自身的尺寸 (`parent.width / 1px` 把 length 变成 float),
    //      `fit: ImageFit.fill` ⇒ 缩放恒为 1.0, 命令里的坐标就是逻辑像素;
    //      不写 viewbox 时上游会用"命令包围盒"去 scale-to-fit, 那会把纵轴量程变成
    //      "曲线自己撑满", 值域映射当场失效;
    //   ② `width/height` 必须非零: 上游软件后端的 `draw_path` 先做 `should_draw(几何)`,
    //      0 面积的元素**不画**;
    //   ③ 命令坐标不带单位 (语言参考: "operate within the imaginary coordinate system")。
    for _[lane_index] in root.automation-lane-target-keys : Rectangle {
        x: 168px;
        y: root.automation-lane-band-ys[lane_index] - root.rows-top;
        width: parent.width - 168px;
        height: root.automation-lane-band-heights[lane_index];
        background: transparent;
        clip: true;
        visible: root.automation-visible;

        accessible-role: image;
        // `track-{i}-automation-{目标键}-lane` —— 三段字面量 + 两个注入片段。
        accessible-id: "track-" + root.automation-lane-track-indexes[lane_index] + "-automation-" + root.automation-lane-target-keys[lane_index] + "-lane";
        // 标签携带**单位与当前值** (读关闭 / 无采样点 / 目标不存在各有分支):
        // "AI 能读到自动化"的机械证据就是这一行 —— 它与投影的 `label` 逐字相等。
        accessible-label: root.automation-lane-labels[lane_index];

        TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clicked => {
                root.automation-lane-click(lane_index, self.mouse-x, self.mouse-y);
            }
        }

        Path {
            // ⭐ 2026-11-07：折线顶点是绝对像素（`automation.rs` 的 `path_commands`），
            // 与剪辑同格减 `scroll-x`。做法是滑 `viewbox-x` 窗口（不是移元素 x：
            // 元素宽 = 视口宽，移元素会把右半曲线裁在元素 bounds 之外）。带与轴标签不动。
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            viewbox-x: root.scroll-x;
            viewbox-y: 0;
            viewbox-width: parent.width / 1px;
            viewbox-height: parent.height / 1px;
            fit: ImageFit.fill;
            commands: root.automation-path-commands[lane_index];
            // 读关闭的泳道用次级墨色描边 (可区分), 读开的用金色。
            stroke: root.automation-lane-read-enabled[lane_index] ? Tokens.gold-bright : Tokens.ink-2;
            stroke-width: 1.5px;
            fill: transparent;
        }

        // 轴标签 (单位 + 量程; 自适应时带「自适应」) —— 让"纵轴是怎么定的"在截图里可见。
        UiMonoText {
            x: Tokens.space-3;
            y: 0;
            width: 160px;
            height: parent.height;
            text: root.automation-lane-axis-labels[lane_index];
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            overflow: elide;
        }

        // 角标: 读关 / 录制臂 (写模式)。空串时不进运行时树 (上游语义, 见
        // src/test_port_adapter.rs 文件头对 `visible.rs` 的核验)。
        UiText {
            x: 168px;
            y: 0;
            width: parent.width - 168px;
            height: parent.height;
            text: root.automation-lane-badges[lane_index];
            color: root.automation-lane-read-enabled[lane_index] ? Tokens.gold-deep : Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            visible: root.automation-lane-badges[lane_index] != "";
        }
    }

    // ⭐ 2026-11-07（夜半 UI 轨道交互修复线）：轨道重排的插入指示线。
    //
    // 2px 金线，y = 宿主算好的插入行顶沿或表底（行空间坐标，减 `rows-top` 进内容坐标），
    // 满宽（包头列 + 车道，仿 Logic 拖动时的蓝线）。只在重排拖动越过 4px 阈值后出现
    // （`preview-index >= 0`）；松手 / `Escape` 后宿主清零即消失。草稿期不碰工程。
    if root.track-reorder-preview-index >= 0 : Rectangle {
        x: 0;
        y: root.track-reorder-preview-y * 1px - root.rows-top;
        width: parent.width;
        height: 2px;
        background: Tokens.gold;
        accessible-role: image;
        accessible-id: "track-reorder-insertion-line";
        accessible-label: "轨道插入位置";
    }

    }  // ← 行区滚动容器到此结束

    // ---------------------------------------------------------------- 走带光标 [UI-MCP-002]
    // 高频刷新区域: 无头截图比对前必须按这个 ID 的包围盒置黑。
    // x 跟随引擎读数（tick 0 ⇒ 168px，即时间轴左沿）；`max(1, …)` 只是除零护栏
    // （宿主写进来的缩放恒在 1..=960，见 `bridge::clamp_ticks_per_pixel`）。
    // ⭐ 2026-11-07：减 `scroll-x`（与剪辑同格；卷帘走带光标早已是同一口径）。
    Rectangle {
        x: 168px + (root.playhead-ticks / max(1, root.ticks-per-pixel)) * 1px - (root.scroll-x * 1px);
        y: 20px;
        width: 1px;
        height: parent.height - 20px;
        background: Tokens.gold-bright;
        accessible-role: slider;
        accessible-id: "arrangement-playhead";
        accessible-label: "走带光标";
        accessible-value: root.playhead-timecode;
    }

    // ---------------------------------------------------------------- ⭐ 横向滚动条（2026-11-07 ③：按钮路）
    //
    // 自定义 Slint 控件（轨道 + 可拖滑块 TouchArea），在编曲视图底部 14px：
    // Flickable 的高度已相应缩 14px（不遮挡车道）。滑块大小与位置反映内容总长与
    // 视口比（`content-px` 由 `apply_view` 每次注入 ⇒ 缩放一变滑块同步更新）；
    // 滑块拖动与轨道点击经 `arrangement-scroll-to` 报**绝对目标 px**，宿主夹紧 ≥ 0
    // 后重投影（`host::wire_arrangement_hscroll`）。
    //
    // 几何（逻辑像素）：轨道 x = 168px（与车道同宽，包头列下方不设滚动条）、
    // 宽 = 视口宽 − 168px；滑块宽 = max(20px, 视口/内容 × 轨道宽)，
    // 滑块 x = 轨道 x + fraction × (轨道宽 − 滑块宽)，fraction =
    // scroll-x / max(0, 内容 − 视口)。内容 ≤ 视口时滑块占满轨道（fraction 分母护栏 1.0）。
    Rectangle {
        x: 168px;
        y: parent.height - 14px;
        width: parent.width - 168px;
        height: 14px;
        background: Tokens.bg-panel;
        // 本地推导量（只读，不进模型）：视口宽（float px）/ 最大偏移 / 当前 fraction /
        // 滑块宽。内容 ≤ 视口时 `max-scroll` = 0 ⇒ 滑块占满轨道、fraction 恒 0。
        property <float> viewport-px: (parent.width - 168px) / 1px;
        property <float> max-scroll: max(0.0, root.content-px - self.viewport-px);
        property <float> scroll-fraction: root.scroll-x / max(1.0, self.max-scroll);
        property <length> thumb-width: min(parent.width, max(20px, parent.width * self.viewport-px / max(1.0, root.content-px)));
        accessible-role: slider;
        accessible-id: "arrangement-hscroll";
        accessible-label: "编曲横向滚动条";
        accessible-value: "" + Math.round(100 * self.scroll-fraction) + "%";
        accessible-action-increment => {
            root.arrangement-scroll-to((root.scroll-x + self.viewport-px) * 1px);
        }
        accessible-action-decrement => {
            root.arrangement-scroll-to((root.scroll-x - self.viewport-px) * 1px);
        }
        Rectangle {
            x: parent.scroll-fraction * (parent.width - parent.thumb-width);
            y: 2px;
            width: parent.thumb-width;
            height: 10px;
            background: Tokens.ink-2;
            border-radius: Tokens.radius-sm;
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                // ⭐ [PATCH UI-DRAG-01]：横滚条与两个缩放滑块同款，`move` 只在
                // `self.pressed` 时跟进 ⇒ 鼠标扫过滚动条不再把画布拖走。
                if event.kind == PointerEventKind.down
                    || (event.kind == PointerEventKind.move && self.pressed) {
                    // 滑块中心跟指针：fraction = (mouse-x − 半个滑块) / (轨道宽 − 滑块宽)。
                    // ⭐ 2026-11-07：fraction 夹到 [0,1] —— 点轨道末端时滑块中心只能到轨道
                    // 末端，不能越过；未夹时点 75% 处可算出 fraction 1.39，偏移 733px 越过
                    // max-scroll 528px、剪辑被推出窗口外（控件树按窗口裁剪，读不到剪辑）。
                    root.arrangement-scroll-to(min(1.0, max(0.0, (self.mouse-x - parent.thumb-width / 2) / max(1px, parent.width - parent.thumb-width))) * parent.max-scroll * 1px);
                }
            }
        }
    }
}
