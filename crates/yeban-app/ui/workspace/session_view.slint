// 夜半 (Yeban) — Session View: 垂直剪辑矩阵 + 场景一键激发
//
// 规范来源 (Normative):
//   - 规范 §2.3: 垂直轨道列 (Vertical Track Columns) + Scene Launch 列 + 量化触发
//   - 规范 §2.2: Back to Arrangement 按钮在 Session 模式下浮现, 点击让播放权平滑回归时间轴
//   - [UI-GRID-002] §1.2: 断点折叠时主工作区占最高展示优先级
//   - [UI-TEST-001] §12.2: 语义 Element ID。本文件用 `slot-…` / `scene-launch-…`,
//     `clip-{ulid}-header` 归 arrangement_view.slint (那里才是剪辑包头所在的层)
//   - [MODEL-AST-002]: 轨道名与场景名**来自工程**，由 `src/host.rs` 单向注入
//
// 仍未实现: `EngineSnapshot` 绑定、量化触发状态机、拖拽装载。触发/量化/Back-to-Arrangement
// 的引擎侧语义等 `yeban-engine` 落地。
//
// 本线的变更: `tracks` / `scenes` 的默认值改为**空数组**（不再内联演示数据），
// 循环规模由数组长度决定，Scene Launch 列的 x 也由 `root.tracks.length` 算出
// （上一版写死 `128px * 6`，轨道数一变就错位）。

import { Tokens, UiText } from "../tokens.slint";

export component SessionView inherits Rectangle {
    // 由 src/host.rs 注入: 轨道名 / 场景名 (默认空 = 没有内联演示数据)
    in property <[string]> scenes: [];
    in property <[string]> tracks: [];

    callback back-to-arrangement();

    background: Tokens.bg-void;
    clip: true;

    accessible-role: main;
    accessible-id: "workspace-session-canvas";
    accessible-label: "Session 触发矩阵";

    // ------------------------------------------------------------ 轨道包头行
    for track_name[track_index] in root.tracks : Rectangle {
        x: 8px + 128px * track_index;
        y: 0;
        width: 120px;
        height: 28px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: list-item;
        accessible-id: "session-track-" + track_index + "-header";
        accessible-label: track_name;
        accessible-item-index: track_index;
        accessible-item-count: root.tracks.length;

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: track_name;
            color: Tokens.ink-0;
            font-size: Tokens.font-size-sm;
            overflow: elide;
        }
    }

    // ------------------------------------------------------------ 剪辑插槽矩阵
    for [track_index] in root.tracks : Rectangle {
        x: 8px + 128px * track_index;
        y: 32px;
        width: 120px;
        height: 68px * root.scenes.length;
        background: Tokens.bg-shell;
        border-radius: Tokens.radius-sm;

        // 纵向轨道列: 每条轨道一个插槽行对应一个场景
        for scene_name[scene_index] in root.scenes : Rectangle {
            x: 0;
            y: 68px * scene_index;
            width: parent.width;
            height: 64px;
            background: (track_index + scene_index).mod(3) == 0 ? Tokens.bg-raised : Tokens.bg-panel;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Tokens.line;
            clip: true;
            accessible-role: list-item;
            accessible-id: "slot-" + track_index + "-" + scene_index + "-cell";
            accessible-label: root.tracks[track_index] + " · " + scene_name;
            accessible-item-index: scene_index;
            accessible-item-count: root.scenes.length;
            accessible-item-selectable: true;
            accessible-item-selected: (track_index + scene_index).mod(3) == 0;

            UiText {
                x: Tokens.space-3;
                y: Tokens.space-3;
                width: parent.width - 12px;
                height: 16px;
                text: scene_name;
                color: Tokens.gold;
                font-size: Tokens.font-size-xs;
                overflow: elide;
            }

            // 空插槽的提示位 (双击创建新 Clip 的手势随后续切片落地)
            UiText {
                x: Tokens.space-3;
                y: 26px;
                width: parent.width - 12px;
                height: 16px;
                text: (track_index + scene_index).mod(3) == 0 ? "已装载" : "空插槽";
                color: Tokens.ink-2;
                font-size: Tokens.font-size-xs;
                overflow: elide;
            }
        }
    }

    // ------------------------------------------------------------ Scene Launch 列
    Rectangle {
        x: 8px + 128px * root.tracks.length;
        y: 0;
        width: 104px;
        height: 28px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-sm;
        accessible-role: text;
        accessible-id: "scene-launch-column-header";
        accessible-label: "场景一键激发列";

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: "场景";
            color: Tokens.gold;
            font-size: Tokens.font-size-sm;
        }
    }

    for scene_name[scene_index] in root.scenes : Rectangle {
        x: 8px + 128px * root.tracks.length;
        y: 32px + 68px * scene_index;
        width: 104px;
        height: 64px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.gold-deep;
        clip: true;
        accessible-role: button;
        accessible-id: "scene-launch-" + scene_index + "-button";
        accessible-label: "激发场景 " + scene_name;
        accessible-item-index: scene_index;
        accessible-item-count: root.scenes.length;

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: scene_name;
            color: Tokens.gold-bright;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }

    // ------------------------------------------------------------ Back to Arrangement
    // 规范 §2.2: 仅在 Session 即兴触发后浮现。骨架里先常驻 (状态机等引擎)。
    Rectangle {
        x: 8px + 128px * root.tracks.length;
        y: 32px + 68px * root.scenes.length + 8px;
        width: 104px;
        height: 28px;
        background: back_area.pressed ? Tokens.bg-raised : Tokens.bg-void;
        border-radius: Tokens.radius-sm;
        border-width: 1px;
        border-color: Tokens.record-red;
        accessible-role: button;
        accessible-id: "session-back-to-arrangement-button";
        accessible-label: "返回编曲 (Back to Arrangement)";

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "→ 编曲";
            color: Tokens.record-red;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
        }

        back_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.back-to-arrangement(); }
        }
    }
}
