import { Theme, TrackData, Tokens } from "tokens.slint";

export component HybridClipMatrixDrawer inherits Rectangle {
    in-out property <[TrackData]> tracks;
    in-out property <int> selected-track-id: 1;

    callback trigger-scene(int);
    callback trigger-clip(int, int);
    callback select-track(int);

    width: 220px;
    background: Theme.bg-panel;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top Header Row with Scene Launchers
        Rectangle {
            height: 54px;
            background: #080a10;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 6px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 5px;
                alignment: center;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "⚡ Clip 激发矩阵";
                        font-family: Tokens.font-ui;
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.track-drum;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "SCENE 1-4";
                        font-family: Tokens.font-mono;
                        font-size: 8px;
                        letter-spacing: 0.8px;
                        color: #64748b;
                        font-weight: 700;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        height: 22px;
                        background: #10141d;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        Text {
                            text: "▶ S1";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.trigger-scene(0); } }
                    }

                    Rectangle {
                        height: 22px;
                        background: #10141d;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        Text {
                            text: "▶ S2";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.trigger-scene(1); } }
                    }

                    Rectangle {
                        height: 22px;
                        background: #10141d;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        Text {
                            text: "▶ S3";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.trigger-scene(2); } }
                    }

                    Rectangle {
                        height: 22px;
                        background: #10141d;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        Text {
                            text: "▶ S4";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.trigger-scene(3); } }
                    }
                }
            }
        }

        // Track Clip Rows (aligned 1:1 with tracks, flex row height)
        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            for trk in root.tracks : Rectangle {
                vertical-stretch: 1;
                min-height: 64px;
                max-height: 160px;
                background: trk.id == root.selected-track-id ? trk.color.with-alpha(0.06) : transparent;
                border-color: #ffffff0a;

                HorizontalLayout {
                    padding: 5px;
                    spacing: 4px;

                    // Clip 1
                    Rectangle {
                        background: trk.clip1 != "" ? trk.color.with-alpha(0.18) : #00000025;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: trk.clip1 != "" ? trk.color.with-alpha(0.5) : #ffffff08;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            alignment: center;
                            Text {
                                text: trk.clip1 != "" ? ("▶ " + trk.clip1) : "+";
                                font-family: trk.clip1 != "" ? Tokens.font-ui : Tokens.font-mono;
                                font-size: trk.clip1 != "" ? 9px : 10px;
                                font-weight: 600;
                                color: trk.clip1 != "" ? #f8fafc : #475569;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.select-track(trk.id);
                                root.trigger-clip(trk.id, 0);
                            }
                        }
                    }

                    // Clip 2
                    Rectangle {
                        background: trk.clip2 != "" ? trk.color.with-alpha(0.18) : #00000025;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: trk.clip2 != "" ? trk.color.with-alpha(0.5) : #ffffff08;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            alignment: center;
                            Text {
                                text: trk.clip2 != "" ? ("▶ " + trk.clip2) : "+";
                                font-family: trk.clip2 != "" ? Tokens.font-ui : Tokens.font-mono;
                                font-size: trk.clip2 != "" ? 9px : 10px;
                                font-weight: 600;
                                color: trk.clip2 != "" ? #f8fafc : #475569;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.select-track(trk.id);
                                root.trigger-clip(trk.id, 1);
                            }
                        }
                    }

                    // Clip 3
                    Rectangle {
                        background: trk.clip3 != "" ? trk.color.with-alpha(0.18) : #00000025;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: trk.clip3 != "" ? trk.color.with-alpha(0.5) : #ffffff08;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            alignment: center;
                            Text {
                                text: trk.clip3 != "" ? ("▶ " + trk.clip3) : "+";
                                font-family: trk.clip3 != "" ? Tokens.font-ui : Tokens.font-mono;
                                font-size: trk.clip3 != "" ? 9px : 10px;
                                font-weight: 600;
                                color: trk.clip3 != "" ? #f8fafc : #475569;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.select-track(trk.id);
                                root.trigger-clip(trk.id, 2);
                            }
                        }
                    }

                    // Clip 4
                    Rectangle {
                        background: trk.clip4 != "" ? trk.color.with-alpha(0.18) : #00000025;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: trk.clip4 != "" ? trk.color.with-alpha(0.5) : #ffffff08;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            alignment: center;
                            Text {
                                text: trk.clip4 != "" ? ("▶ " + trk.clip4) : "+";
                                font-family: trk.clip4 != "" ? Tokens.font-ui : Tokens.font-mono;
                                font-size: trk.clip4 != "" ? 9px : 10px;
                                font-weight: 600;
                                color: trk.clip4 != "" ? #f8fafc : #475569;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.select-track(trk.id);
                                root.trigger-clip(trk.id, 3);
                            }
                        }
                    }
                }
            }

            // Bottom empty placeholder row (matches arrangement empty lane 1:1)
            Rectangle {
                vertical-stretch: 0;
                height: 38px;
                background: transparent;
            }
        }
    }
}
