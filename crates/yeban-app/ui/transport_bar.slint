import { Theme, PersonaMode, TextureMode, Tokens, TooltipBubble } from "tokens.slint";

// =========================================================================
// UNIFIED VECTOR ICONS (1.2px - 1.5px Stroke, Geometric, Professional DAW Style)
// =========================================================================

// --- 1. Zone Visibility Toggles ---

component IconInspectorToggle inherits Rectangle {
    in property <bool> active: false;
    in property <color> active-color: Theme.accent;
    in property <color> inactive-color: #b6c2d2;

    width: 14px;
    height: 12px;

    // Window frame
    Rectangle {
        x: 0;
        y: 0;
        width: 14px;
        height: 12px;
        border-radius: 1px;
        border-width: 1.2px;
        border-color: root.active ? root.active-color : root.inactive-color;
        background: transparent;

        // Left inspector panel
        Rectangle {
            x: 1.2px;
            y: 1.2px;
            width: 3.5px;
            height: 9.6px;
            border-radius: 0.5px;
            background: root.active ? root.active-color : root.inactive-color.with-alpha(0.3);
        }

        // Inner divider
        Rectangle {
            x: 4.8px;
            y: 1.2px;
            width: 1px;
            height: 9.6px;
            background: root.active ? root.active-color : root.inactive-color.with-alpha(0.6);
        }

        // Arranger content ghost lines
        Rectangle {
            x: 6.5px;
            y: 3px;
            width: 5.5px;
            height: 1.5px;
            border-radius: 0.5px;
            background: root.inactive-color.with-alpha(0.35);
        }
        Rectangle {
            x: 6.5px;
            y: 6.5px;
            width: 4px;
            height: 1.5px;
            border-radius: 0.5px;
            background: root.inactive-color.with-alpha(0.35);
        }
    }
}

component IconClipMatrixToggle inherits Rectangle {
    in property <bool> active: false;
    in property <color> active-color: Theme.accent;
    in property <color> inactive-color: #b6c2d2;

    width: 14px;
    height: 12px;

    Rectangle {
        x: 0.5px;
        y: 0.5px;
        width: 5.5px;
        height: 4.5px;
        border-radius: 1px;
        border-width: root.active ? 0 : 1px;
        border-color: root.inactive-color;
        background: root.active ? root.active-color : root.inactive-color.with-alpha(0.25);
    }
    Rectangle {
        x: 8px;
        y: 0.5px;
        width: 5.5px;
        height: 4.5px;
        border-radius: 1px;
        border-width: root.active ? 0 : 1px;
        border-color: root.inactive-color;
        background: root.active ? root.active-color : root.inactive-color.with-alpha(0.25);
    }
    Rectangle {
        x: 0.5px;
        y: 7px;
        width: 5.5px;
        height: 4.5px;
        border-radius: 1px;
        border-width: root.active ? 0 : 1px;
        border-color: root.inactive-color;
        background: root.active ? root.active-color : root.inactive-color.with-alpha(0.25);
    }
    Rectangle {
        x: 8px;
        y: 7px;
        width: 5.5px;
        height: 4.5px;
        border-radius: 1px;
        border-width: root.active ? 0 : 1px;
        border-color: root.inactive-color;
        background: root.active ? root.active-color : root.inactive-color.with-alpha(0.25);
    }
}

component IconLowerDockToggle inherits Rectangle {
    in property <bool> active: false;
    in property <color> active-color: Theme.accent;
    in property <color> inactive-color: #b6c2d2;

    width: 14px;
    height: 12px;

    // Window frame
    Rectangle {
        x: 0;
        y: 0;
        width: 14px;
        height: 12px;
        border-radius: 1px;
        border-width: 1.2px;
        border-color: root.active ? root.active-color : root.inactive-color;
        background: transparent;

        // Arranger content ghost lines in upper section
        Rectangle {
            x: 2px;
            y: 2px;
            width: 6px;
            height: 1.5px;
            border-radius: 0.5px;
            background: root.inactive-color.with-alpha(0.35);
        }
        Rectangle {
            x: 2px;
            y: 4.5px;
            width: 9px;
            height: 1.5px;
            border-radius: 0.5px;
            background: root.inactive-color.with-alpha(0.35);
        }

        // Inner horizontal divider
        Rectangle {
            x: 1.2px;
            y: 7px;
            width: 11.6px;
            height: 1px;
            background: root.active ? root.active-color : root.inactive-color.with-alpha(0.6);
        }

        // Lower dock panel
        Rectangle {
            x: 1.2px;
            y: 8px;
            width: 11.6px;
            height: 2.8px;
            border-radius: 0.5px;
            background: root.active ? root.active-color : root.inactive-color.with-alpha(0.3);
        }
    }
}

component IconControlRoomToggle inherits Rectangle {
    in property <bool> active: false;
    in property <color> active-color: Theme.accent;
    in property <color> inactive-color: #b6c2d2;

    width: 14px;
    height: 12px;

    // Window frame
    Rectangle {
        x: 0;
        y: 0;
        width: 14px;
        height: 12px;
        border-radius: 1px;
        border-width: 1.2px;
        border-color: root.active ? root.active-color : root.inactive-color;
        background: transparent;

        // Arranger content ghost lines
        Rectangle {
            x: 2px;
            y: 3px;
            width: 5.5px;
            height: 1.5px;
            border-radius: 0.5px;
            background: root.inactive-color.with-alpha(0.35);
        }
        Rectangle {
            x: 2px;
            y: 6.5px;
            width: 4px;
            height: 1.5px;
            border-radius: 0.5px;
            background: root.inactive-color.with-alpha(0.35);
        }

        // Inner divider
        Rectangle {
            x: 8.2px;
            y: 1.2px;
            width: 1px;
            height: 9.6px;
