import { Theme, PersonaMode } from "tokens.slint";

export component TransportHeaderBar inherits Rectangle {
    in-out property <bool> show-browser: true;
    in-out property <bool> show-clipmatrix: true;
    in-out property <bool> show-lower-dock: true;
    in-out property <bool> show-control-room: true;

    in-out property <string> active-tool: "pointer"; // pointer, range, split, draw
    in-out property <bool> is-playing: false;
    in-out property <bool> is-recording: false;
    in-out property <bool> is-looping: true;
    in-out property <string> timecode-text: "003.02.01";
    in-out property <int> bpm-val: 124;
    in-out property <string> scale-text: "C Minor (自然小调)";
    in-out property <int> buffer-samples: 128;
    in-out property <int> dsp-cpu-percent: 14;

    callback toggle-zone(string);
    callback select-tool(string);
    callback toggle-play();
    callback toggle-rec();
    callback toggle-loop();
    callback rewind();
    callback change-bpm(int);
    callback change-scale(string);
    callback hot-swap-buffer(int);
    callback select-persona(PersonaMode);
    callback open-cmd-palette();
    callback toggle-hotspots();

    height: 48px;
    background: Theme.header-bg;
    // border line
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;

        // 1. OS Window Controls & Zone Toggles
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            // Traffic lights
            HorizontalLayout {
                spacing: 5px;
                alignment: center;
                Rectangle { width: 11px; height: 11px; border-radius: 5.5px; background: #f43f5e; }
                Rectangle { width: 11px; height: 11px; border-radius: 5.5px; background: #f59e0b; }
                Rectangle { width: 11px; height: 11px; border-radius: 5.5px; background: #10b981; }
            }

            // Zone visibility toggles
            Rectangle {
                background: #00000030;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff15;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    Rectangle {
                        background: root.show-browser ? Theme.accent.with-alpha(0.2) : transparent;
                        border-radius: Theme.radius;
                        border-width: root.show-browser ? 1px : 0;
                        border-color: Theme.accent;
                        Text {
                            text: "◧ 浏览/检查器 [I]";
                            font-size: 10px;
                            color: root.show-browser ? Theme.accent : #94a3b8;
                            font-weight: 600;
                            }
                        TouchArea { clicked => { root.toggle-zone("browser"); } }
                    }

                    Rectangle {
                        background: root.show-clipmatrix ? Theme.accent.with-alpha(0.2) : transparent;
                        border-radius: Theme.radius;
                        border-width: root.show-clipmatrix ? 1px : 0;
                        border-color: Theme.accent;
                        Text {
                            text: "⊞ Clip [Tab]";
                            font-size: 10px;
                            color: root.show-clipmatrix ? Theme.accent : #94a3b8;
                            font-weight: 600;
                            }
                        TouchArea { clicked => { root.toggle-zone("clipmatrix"); } }
                    }

                    Rectangle {
                        background: root.show-lower-dock ? Theme.accent.with-alpha(0.2) : transparent;
                        border-radius: Theme.radius;
                        border-width: root.show-lower-dock ? 1px : 0;
                        border-color: Theme.accent;
                        Text {
                            text: "⬓ 底部 [F3]";
                            font-size: 10px;
                            color: root.show-lower-dock ? Theme.accent : #94a3b8;
                            font-weight: 600;
                            }
                        TouchArea { clicked => { root.toggle-zone("lower"); } }
                    }

                    Rectangle {
                        background: root.show-control-room ? Theme.accent.with-alpha(0.2) : transparent;
                        border-radius: Theme.radius;
                        border-width: root.show-control-room ? 1px : 0;
                        border-color: Theme.accent;
                        Text {
                            text: "◨ 监听 [F4]";
                            font-size: 10px;
                            color: root.show-control-room ? Theme.accent : #94a3b8;
                            font-weight: 600;
                            }
                        TouchArea { clicked => { root.toggle-zone("right"); } }
                    }
                }
            }

            // Edit Tools
            Rectangle {
                background: #00000030;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff15;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    Rectangle {
                        background: root.active-tool == "pointer" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        Text {
                            text: "↖ 1";
                            font-size: 10px;
                            color: root.active-tool == "pointer" ? #020617 : #94a3b8;
                            font-weight: 700;
                            }
                        TouchArea { clicked => { root.select-tool("pointer"); } }
                    }

                    Rectangle {
                        background: root.active-tool == "range" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        Text {
                            text: "⌶ 2";
                            font-size: 10px;
                            color: root.active-tool == "range" ? #020617 : #94a3b8;
                            font-weight: 700;
                            }
                        TouchArea { clicked => { root.select-tool("range"); } }
                    }

                    Rectangle {
                        background: root.active-tool == "split" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        Text {
                            text: "✂ 3";
                            font-size: 10px;
                            color: root.active-tool == "split" ? #020617 : #94a3b8;
                            font-weight: 700;
                            }
                        TouchArea { clicked => { root.select-tool("split"); } }
                    }

                    Rectangle {
                        background: root.active-tool == "draw" ? Theme.accent : transparent;
                        border-radius: Theme.radius;
                        Text {
                            text: "✎ 4";
                            font-size: 10px;
                            color: root.active-tool == "draw" ? #020617 : #94a3b8;
                            font-weight: 700;
                            }
                        TouchArea { clicked => { root.select-tool("draw"); } }
                    }
                }
            }
        }

        // 2. Transport Center LCD HUD
        Rectangle {
            background: #06080e;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: #334155;
            horizontal-stretch: 1;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;

                // Rewind
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: #1e293b;
                    Text { text: "⏮"; font-size: 11px; color: #cbd5e1; horizontal-alignment: center; }
                    TouchArea { clicked => { root.rewind(); } }
                }

                // Play / Stop
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: root.is-playing ? #10b981 : #10b98125;
                    border-width: 1px;
                    border-color: #10b981;

                    Text {
                        text: root.is-playing ? "⏸ STOP" : "▶ PLAY";
                        font-size: 11px;
                        font-weight: 800;
                        color: root.is-playing ? #020617 : #10b981;
                        }
                    TouchArea { clicked => { root.toggle-play(); } }
                }

                // Rec
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: root.is-recording ? #f43f5e : #f43f5e20;
                    border-width: 1px;
                    border-color: #f43f5e;

                    Text {
                        text: "● REC";
                        font-size: 11px;
                        font-weight: 800;
                        color: root.is-recording ? #ffffff : #f43f5e;
                        }
                    TouchArea { clicked => { root.toggle-rec(); } }
                }

                // Loop
                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: root.is-looping ? Theme.accent.with-alpha(0.25) : #1e293b;
                    border-width: root.is-looping ? 1px : 0;
                    border-color: Theme.accent;

                    Text {
                        text: "🔁 LOOP";
                        font-size: 10px;
                        font-weight: 700;
                        color: root.is-looping ? Theme.accent : #94a3b8;
                        }
                    TouchArea { clicked => { root.toggle-loop(); } }
                }

                Rectangle { width: 1px; height: 16px; background: #334155; }

                // LCD Bar.Beat.Tick
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text { text: "BAR.BEAT.TICK"; font-size: 8px; color: #64748b; font-weight: 700; }
                    Text { text: root.timecode-text; font-size: 12px; color: #38bdf8; font-weight: 800; }
                }

                // BPM
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text { text: "BPM"; font-size: 8px; color: #64748b; font-weight: 700; }
                    Text { text: "" + root.bpm-val; font-size: 12px; color: #f59e0b; font-weight: 800; }
                }

                // Global Scale Key
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text { text: "SCALE / KEY"; font-size: 8px; color: #64748b; font-weight: 700; }
                    Text { text: root.scale-text; font-size: 11px; color: #10b981; font-weight: 700; }
                }
            }
        }

        // 3. Audio Engine & Persona Switcher
        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            // Zero reload buffer switcher
            Rectangle {
                background: #00000030;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff15;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    Text { text: "Buffer:"; font-size: 10px; color: #94a3b8; }
                    Text { text: "" + root.buffer-samples + " smp"; font-size: 10px; color: Theme.accent; font-weight: 700; vertical-alignment: center; }
                }
                TouchArea {
                    clicked => {
                        if (root.buffer-samples == 64) { root.hot-swap-buffer(128); }
                        else if (root.buffer-samples == 128) { root.hot-swap-buffer(512); }
                        else if (root.buffer-samples == 512) { root.hot-swap-buffer(2048); }
                        else { root.hot-swap-buffer(64); }
                    }
                }
            }

            // DSP CPU Gauge
            Rectangle {
                background: #00000040;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff15;
                width: 70px;

                VerticalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        Text { text: "DSP"; font-size: 8px; color: #94a3b8; font-weight: 700; }
                        Text { text: "" + root.dsp-cpu-percent + "%"; font-size: 9px; color: #10b981; font-weight: 800; horizontal-alignment: right; }
                    }
                    Rectangle {
                        height: 3px;
                        background: #1e293b;
                        border-radius: 1.5px;
                        Rectangle {
                            x: 0;
                            width: (root.dsp-cpu-percent * 60px) / 100;
                            height: 3px;
                            border-radius: 1.5px;
                            background: #10b981;
                        }
                    }
                }
            }

            // Persona Switcher Bar
            Rectangle {
                background: #00000040;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff15;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    Rectangle {
                        background: Theme.persona == PersonaMode.AetherDefault ? #06b6d4 : transparent;
                        border-radius: 3px;
                        Text {
                            text: "Aether";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.persona == PersonaMode.AetherDefault ? #020617 : #94a3b8;
                            }
                        TouchArea { clicked => { root.select-persona(PersonaMode.AetherDefault); } }
                    }

                    Rectangle {
                        background: Theme.persona == PersonaMode.AbletonLive ? #ff764d : transparent;
                        border-radius: 3px;
                        Text {
                            text: "Live";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.persona == PersonaMode.AbletonLive ? #020617 : #94a3b8;
                            }
                        TouchArea { clicked => { root.select-persona(PersonaMode.AbletonLive); } }
                    }

                    Rectangle {
                        background: Theme.persona == PersonaMode.LogicPro ? #3b82f6 : transparent;
                        border-radius: 3px;
                        Text {
                            text: "Logic";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.persona == PersonaMode.LogicPro ? #ffffff : #94a3b8;
                            }
                        TouchArea { clicked => { root.select-persona(PersonaMode.LogicPro); } }
                    }

                    Rectangle {
                        background: Theme.persona == PersonaMode.CubasePro ? #00c8ff : transparent;
                        border-radius: 3px;
                        Text {
                            text: "Cubase";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.persona == PersonaMode.CubasePro ? #020617 : #94a3b8;
                            }
                        TouchArea { clicked => { root.select-persona(PersonaMode.CubasePro); } }
                    }
                }
            }

            // Command palette button
            Rectangle {
                background: #1e293b;
                border-radius: Theme.radius;
                Text { text: "⌘K"; font-size: 10px; font-weight: 700; color: #38bdf8; }
                TouchArea { clicked => { root.open-cmd-palette(); } }
            }

            // Hotspot toggle
            Rectangle {
                background: #f59e0b25;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #f59e0b60;
                Text { text: "💡"; font-size: 11px; }
                TouchArea { clicked => { root.toggle-hotspots(); } }
            }
        }
    }
}
