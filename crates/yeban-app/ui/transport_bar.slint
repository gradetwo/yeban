    Rectangle {
        x: 1.5px;
        y: 1px;
        width: 1.8px;
        height: 10px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 1.5px;
        y: 1px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 1.5px;
        y: 9.5px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }

    // Center span
    Rectangle {
        x: 4.5px;
        y: 5.2px;
        width: 5px;
        height: 1.6px;
        border-radius: 0.5px;
        background: root.icon-color;
