    // Left Inspector strip
    Rectangle {
        x: 0.5px;
        y: 0.5px;
        width: 3.5px;
        height: 11px;
        border-radius: 1px;
        background: root.icon-color;
    }
    // Top Arranger block
    Rectangle {
        x: 5px;
        y: 0.5px;
        width: 8.5px;
        height: 4.8px;
        border-radius: 1px;
        background: root.icon-color;
    }
    // Bottom Mixer dock
    Rectangle {
        x: 5px;
        y: 6.7px;
        width: 8.5px;
        height: 4.8px;
        border-radius: 1px;
        background: root.icon-color;
    }
}

component IconPersonaPerformance inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: Tokens.skin-text-dim;

    width: 14px;
    height: 12px;

    // 6-pad performance matrix (Clip launcher pads)
    Rectangle { x: 0.5px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 5.2px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 9.9px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 0.5px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 5.2px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 9.9px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
}

component IconPersonaArranger inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: Tokens.skin-text-dim;

    width: 14px;
    height: 12px;

    // Track 1
    Rectangle { x: 0.5px; y: 1px; width: 6.5px; height: 2px; border-radius: 0.5px; background: root.icon-color; }
    Rectangle { x: 8px; y: 1px; width: 5.5px; height: 2px; border-radius: 0.5px; background: root.icon-color.with-alpha(0.65); }

    // Track 2
    Rectangle { x: 1.5px; y: 5px; width: 10px; height: 2px; border-radius: 0.5px; background: root.icon-color; }

    // Track 3
    Rectangle { x: 0.5px; y: 9px; width: 5px; height: 2px; border-radius: 0.5px; background: root.icon-color; }
    Rectangle { x: 6.5px; y: 9px; width: 7px; height: 2px; border-radius: 0.5px; background: root.icon-color.with-alpha(0.65); }

    // Playhead line
    Rectangle {
        x: 6px;
        y: 0;
        width: 1.2px;
        height: 12px;
        background: root.selected ? Tokens.skin-text-strong : Theme.accent;
    }
}

component IconPersonaMixer inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: Tokens.skin-text-dim;

    width: 14px;
    height: 12px;

    // Fader strip 1
    Rectangle { x: 1.8px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 0.5px; y: 3px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }

    // Fader strip 2
    Rectangle { x: 6.4px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 5.1px; y: 7px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }

    // Fader strip 3
    Rectangle { x: 11px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 9.7px; y: 4px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }
}

component IconEyeInsight inherits Rectangle {
    in property <bool> active: false;
    in property <color> active-color: Theme.status-warn;

    width: 14px;
    height: 12px;

    Path {
        x: 0;
        y: 0;
        width: 14px;
        height: 12px;
        commands: "M 1 6 Q 7 1, 13 6 Q 7 11, 1 6 Z";
        stroke: root.active-color;
        stroke-width: 1.2px;
        fill: root.active ? root.active-color.with-alpha(0.3) : transparent;
    }
    Rectangle {
        x: 5.5px;
        y: 4.5px;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: root.active-color;
    }
}

// --- 5. Transport Cluster Vector Icons ---

component IconTransportRewind inherits Rectangle {
    in property <color> icon-color: Tokens.skin-text-body;
    width: 13px;
    height: 10px;

    Path {
        x: 0px;
        y: 0px;
        width: 6px;
        height: 10px;
        commands: "M 6 0 L 0 5 L 6 10 Z";
        fill: root.icon-color;
    }
    Path {
        x: 6.5px;
        y: 0px;
        width: 6px;
        height: 10px;
        commands: "M 6 0 L 0 5 L 6 10 Z";
        fill: root.icon-color;
    }
}

component IconTransportStop inherits Rectangle {
    in property <color> icon-color: Tokens.skin-text-body;
    width: 9px;
    height: 9px;

    Rectangle {
        width: 9px;
        height: 9px;
        border-radius: 1.5px;
        background: root.icon-color;
    }
}

// 走带播放键的**字形**：未播放 = 实心三角（▶），播放中 = 双竖条（‖）。
// ⚠ T-FIX-109：此前这里只有三角，播放期间按钮不换形 —— 用户看不出正在播放，
// 也不知道点下去是暂停。字形只由 `playing`（= 引擎 `TransportReading::state`
// 的镜面，唯一写者是 `host::apply_transport`）决定，⛔ 不引入第二份状态。
component IconTransportPlay inherits Rectangle {
    in property <color> icon-color: Tokens.skin-meter-low;
    in property <bool> playing: false;
    width: 10px;
    height: 11px;

    Path {
        visible: !root.playing;
        x: 0px;
        y: 0px;
        width: 10px;
        height: 11px;
        commands: "M 0 0 L 10 5.5 L 0 11 Z";
        fill: root.icon-color;
    }

    // 暂停字形：两条 2.5px 竖条，留 1px 中缝，撑满 10×11 的同一画框
    // （位置按三角同高，⛔ 不做垂直居中微调之外的缩放，避免与停止键视觉重量不一致）。
    Rectangle {
        visible: root.playing;
        x: 1px;
        y: 1px;
        width: 2.5px;
        height: 9px;
        background: root.icon-color;
    }

    Rectangle {
        visible: root.playing;
        x: 6.5px;
        y: 1px;
        width: 2.5px;
        height: 9px;
        background: root.icon-color;
    }
}

component IconTransportRecord inherits Rectangle {
    in property <color> icon-color: Tokens.skin-arm;
    width: 9px;
    height: 9px;

    Rectangle {
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: root.icon-color;
    }
}

component IconTransportLoop inherits Rectangle {
    in property <color> icon-color: Tokens.skin-text-dim;
    width: 12px;
    height: 10px;

    Path {
        x: 0px;
        y: 0px;
        width: 12px;
        height: 10px;
        commands: "M 3 2 A 4 4 0 1 1 1.5 6 L 0 6 L 2.5 9 L 5 6 L 3.5 6 A 2.5 2.5 0 1 0 3.5 3 Z";
        fill: root.icon-color;
    }
}

export component TransportHeaderBar inherits Rectangle {
    in-out property <bool> show-browser: true;
    in-out property <bool> show-clipmatrix: true;
    in-out property <bool> show-lower-dock: true;
    in-out property <bool> show-control-room: true;

    in-out property <string> active-tool: "pointer"; // pointer, range, split, draw
    in-out property <bool> is-playing: false;
    in-out property <bool> is-recording: false;
    in-out property <bool> is-looping: true;
    in-out property <string> timecode-text: "003.02.01";
    in-out property <int> bpm-val: 124;
    in-out property <string> bpm-display: "124.00";
    in-out property <string> scale-text: "C Minor (自然小调)";
    in-out property <int> buffer-samples: 128;
    in-out property <int> dsp-cpu-percent: 14;

    // 窄窗分档（Wang 2026-11-17 裁决 F1/F2）：由 MainWindow 按窗口宽算好后传入
    // （app.slint 的 `transport-*`，绑 Window 自身宽度）。栏内只读这四个布尔
    // 决定在场性，⛔ 不在本组件里读任何宽度（布局内读宽会成 `layoutinfo-h` 环）。
    //   - `overflow`（F2）：KEY/SCALE、DSP、BUFFER 离场收进 ⋯ 弹出层；
    //     BAR/BEAT 与 TEMPO 常显（借鉴 Logic Pro 控制栏的溢出收纳）。
    //   - F1 收起优先级：`hide-brand`（品牌标）→ `hide-tips`（TIPS）→
    //     `hide-cmd`（命令面板入口），阈值依次降低、先列的先消失。
    in property <bool> overflow: false;
    in property <bool> hide-brand: false;
    in property <bool> hide-tips: false;
    in property <bool> hide-cmd: false;

    callback toggle-zone(string);
    callback select-tool(string);
    callback toggle-play();
    callback toggle-rec();
    callback toggle-record();
    callback toggle-loop();
    callback rewind();
    callback change-bpm(int);
    callback change-scale(string);
    callback hot-swap-buffer(int);
    callback select-persona(PersonaMode);
    callback open-cmd-palette();
    callback toggle-hotspots();
    callback revert-to-last-commit();

    height: 48px;
    // 二期质感: 栏体走 §10 面板刷 (flat = Theme.header-bg 本身)。
    background: Tokens.texture-physical ? Tokens.panel-brush : Theme.header-bg;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        // 1. Left Logic 12 Island: Brand & Zone Toggles & Edit Tools (Separated Groups)
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            // Group A: Brand Mark (Official Studio Logo Mark)
            Rectangle {
                // F1 第一优先收起：窄档离场（品牌名本体在主菜单/启动器仍在）。
                visible: !root.hide-brand;
                // 二期质感: 品牌块走 §10 外壳刷。扁平支**不再给背板** (2026-11-19 口径:
                // 扁平工具条上的图标按钮不许带一块常驻方块, 只剩图标本体; 拟物保留实体铭牌)。
                background: Tokens.texture-physical ? Tokens.shell-brush : transparent;
                border-radius: 4px;
                border-width: Tokens.texture-physical ? 1px : 0px;
                border-color: Tokens.line-strong;
                width: 36px;
                height: 28px;

                Image {
                    // 扁平支用抠掉底色的月亮 (`yeban-moon-keyed-64.png`，由 dark 版图标
                    // 逐像素 alpha key 得到)：品牌按钮不再带一块深蓝方块；拟物支保留实体铭牌图。
                    source: Tokens.texture-physical ? @image-url("../../../assets/brand/png/yeban-dark-64.png") : @image-url("../../../assets/brand/png/yeban-moon-keyed-64.png");
                    width: 24px;
                    height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                brand_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                TooltipBubble { text: "夜半"; is-visible: brand_touch.has-hover; }
            }

            // Group B: Zone Visibility Toggles (检查器 [I], Clip 矩阵 [Tab], 底栏 [P/X], 监听室 [F4])
            Rectangle {
                // 二期质感: 组板走 §10 外壳刷。扁平支 no plate (见品牌块同条注释)。
                background: Tokens.texture-physical ? Tokens.shell-brush : transparent;
                border-radius: Theme.radius;
                border-width: Tokens.texture-physical ? 1px : 0px;
                border-color: Tokens.line;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. 检查器 [I]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-browser ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: root.show-browser ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconInspectorToggle {
                            active: root.show-browser;
                            active-color: Theme.accent;
                            inactive-color: Tokens.skin-text-dim;
                        }
                        touch_insp := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("browser"); }
                        }
                        TooltipBubble { text: @tr("检查器与音色库 [I]"); is-visible: touch_insp.has-hover; }
                    }

                    // 2. Clip 矩阵 [Tab]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-clipmatrix ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: root.show-clipmatrix ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconClipMatrixToggle {
                            active: root.show-clipmatrix;
                            active-color: Theme.accent;
                            inactive-color: Tokens.skin-text-dim;
                        }
                        touch_clip := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("clipmatrix"); }
                        }
                        TooltipBubble { text: @tr("Clip 激发矩阵"); is-visible: touch_clip.has-hover; }
                    }

                    // 3. 底栏 [P/X]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-lower-dock ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: root.show-lower-dock ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconLowerDockToggle {
                            active: root.show-lower-dock;
                            active-color: Theme.accent;
                            inactive-color: Tokens.skin-text-dim;
                        }
                        touch_dock := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("lower"); }
                        }
                        TooltipBubble { text: @tr("统一底栏 (混音控制台/钢琴卷帘) [P / X]"); is-visible: touch_dock.has-hover; }
                    }

                    // 4. 监听室 [F4]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-control-room ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: root.show-control-room ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconControlRoomToggle {
                            active: root.show-control-room;
                            active-color: Theme.accent;
                            inactive-color: Tokens.skin-text-dim;
                        }
                        touch_room := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("right"); }
                        }
                        TooltipBubble { text: @tr("监听控制室与响度计 [F4]"); is-visible: touch_room.has-hover; }
                    }
                }
            }

            // Group C: Edit Tools (选区 [1], 范围 [2], 切分 [3], 画笔 [4])
            Rectangle {
                // 二期质感: 组板走 §10 外壳刷。扁平支 no plate (见品牌块同条注释)。
                background: Tokens.texture-physical ? Tokens.shell-brush : transparent;
                border-radius: Theme.radius;
                border-width: Tokens.texture-physical ? 1px : 0px;
                border-color: Tokens.line;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 选区 [1]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "pointer" ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "pointer" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolPointer {
                            selected: root.active-tool == "pointer";
                            icon-color: root.active-tool == "pointer" ? Theme.accent : Tokens.skin-text-dim;
                        }
                        touch_ptr := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("pointer"); }
                        }
                        TooltipBubble { text: @tr("指针选区工具: 选择与移动 [1]"); is-visible: touch_ptr.has-hover; }
                    }

                    // 范围 [2]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "range" ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "range" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolRange {
                            selected: root.active-tool == "range";
                            icon-color: root.active-tool == "range" ? Theme.accent : Tokens.skin-text-dim;
                        }
                        touch_rng := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("range"); }
                        }
                        TooltipBubble { text: @tr("力度 / 范围工具 [4]"); is-visible: touch_rng.has-hover; }
                    }

                    // 切分 [3]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "split" ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "split" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolSplit {
                            selected: root.active-tool == "split";
                            icon-color: root.active-tool == "split" ? Theme.accent : Tokens.skin-text-dim;
                        }
                        touch_splt := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("split"); }
                        }
                        TooltipBubble { text: @tr("剃刀切分工具 [3]"); is-visible: touch_splt.has-hover; }
                    }

                    // 画笔 [2 / B]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "draw" ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "draw" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolDraw {
                            selected: root.active-tool == "draw";
                            icon-color: root.active-tool == "draw" ? Theme.accent : Tokens.skin-text-dim;
                        }
                        touch_drw := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("draw"); }
                        }
                        TooltipBubble { text: @tr("画笔工具: 绘制音符与自动化 [2 / B]"); is-visible: touch_drw.has-hover; }
                    }
                }
            }
        }

        // 2. Center Logic 12 Island: Unified Transport & Precision Digital LCD (Separated by Spacing)
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            alignment: center;

            // Group D: Cohesive Logic 12 Transport Control Cluster (Unified height, styling, vector iconography, and balanced visual weight)
            Rectangle {
                // 二期质感: 走带簇底板走 §10 外壳刷。扁平支 no plate (见品牌块同条注释);
                // 簇内按钮状态色不动。
                background: Tokens.texture-physical ? Tokens.shell-brush : transparent;
                border-radius: 5px;
                border-width: Tokens.texture-physical ? 1px : 0px;
                border-color: Tokens.bg-lane2;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. Rewind / Return to Zero (⏮)
                    btn_rewind := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: btn_rewind_touch.has-hover ? Tokens.bg-lane2 : transparent;
                        border-width: btn_rewind_touch.has-hover ? 1px : 0;
                        border-color: Tokens.line-strong;
                        // T-FIX-177：与 stop/play/record 同款三件套；动作与
                        // `btn_rewind_touch.clicked` 逐字相同（同一 root.rewind()）。
                        accessible-role: button;
                        accessible-id: "transport-rewind-button";
                        accessible-label: @tr("返回工程起点 / 归零 [Return]");
                        accessible-action-default => { root.rewind(); }
                        IconTransportRewind {
                            icon-color: btn_rewind_touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body;
                        }
                        btn_rewind_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.rewind(); }
                        }
                        TooltipBubble { text: @tr("返回工程起点 / 归零 [Return]"); is-visible: btn_rewind_touch.has-hover; }
                    }

                    // 2. Stop Button (■)
                    btn_stop := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        // ⭐ T-FIX-122：`transport-stop-button` 落到活键；动作与
                        // `btn_stop_touch.clicked` 逐字相同（播放/录音中=停，否则=归零）。
                        accessible-role: button;
                        accessible-id: "transport-stop-button";
                        accessible-label: @tr("停止 (回到起始点)");
                        accessible-action-default => {
                            if root.is-playing { root.toggle-play(); }
                            else if root.is-recording { root.toggle-rec(); }
                            else { root.rewind(); }
                        }
                        // 权重分级（2026-11-19 实测）：停止的方符是 9×9 实心块，却用
                        // skin-text-strong（近白）常亮 —— 空转时它就是整条走带上最重
                        // 的一块，压过了绿三角的播放与红圆的录音（两级语义本来就该
                        // 更亮）。改法：**不播放时降到 body（中灰）**，边界提成 line
                        // 让格子还在；**播放/录音中才提亮到 strong**（此时停止才是
                        // 该按的那个键）。填充形状、尺寸、点击语义一位未动。
                        // 扁平档（2026-11-19）：空转时**不留背板**——只剩一枚中灰方符，
                        // 悬停才浮出一格 lane 底色。用户点名的"扁平按钮后面有个方块"
                        // 就是这格常亮填充：图标 12px、背板 32×24，远看像一块贴在走带上的
                        // 灰砖。拟物档保留软触凹陷面（有材质才谈得上"按下去"）。
                        background: (!root.is-playing && !root.is-recording)
                            ? (btn_stop_touch.has-hover ? Tokens.bg-lane2 : transparent)
                            : Tokens.bg-lane2;
                        border-width: (!root.is-playing && !root.is-recording)
                            ? (btn_stop_touch.has-hover ? 1px : 0px)
                            : (Tokens.texture-physical || btn_stop_touch.has-hover ? 1px : 0px);
                        border-color: (root.is-playing || root.is-recording) ? Tokens.line-strong : Tokens.line;
                        IconTransportStop {
                            icon-color: (root.is-playing || root.is-recording) ? Tokens.skin-text-strong : (btn_stop_touch.has-hover ? Tokens.skin-text-strong : Tokens.skin-text-body);
                        }
                        btn_stop_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                if root.is-playing { root.toggle-play(); }
                                else if root.is-recording { root.toggle-rec(); }
                                else { root.rewind(); }
                            }
                        }
                        TooltipBubble { text: @tr("停止播放并复位 [Space]"); is-visible: btn_stop_touch.has-hover; }
                    }

                    // 3. Play / Pause Button (▶ 未播放 / ‖ 播放中)
                    btn_play := Rectangle {
                        width: 36px;
                        height: 24px;
                        border-radius: 3px;
                        // ⭐ T-FIX-122：把死文件 `transport.slint` 里的 `transport-play-button`
                        // 落到**真的被实例化**的这颗键上（a11y 树新增一个按钮节点，
                        // ⛔ 不改任何可见帧、不改点击语义）。
                        accessible-role: button;
                        accessible-id: "transport-play-button";
                        accessible-label: @tr("播放 / 暂停 (Space)");
                        accessible-action-default => { root.toggle-play(); }
                        // 扁平档：未播放 = 透明（只有绿三角），悬停才浮出淡绿底；拟物档
                        // 保留常亮软触面。播放态两档都用同色实心底（状态必须一眼可见）。
                        background: root.is-playing
                            ? Tokens.skin-meter-low
                            : (Tokens.texture-physical
                                ? (btn_play_touch.has-hover ? Tokens.skin-meter-low.with-alpha(0.28) : Tokens.skin-meter-low.with-alpha(0.18))
                                : (btn_play_touch.has-hover ? Tokens.skin-meter-low.with-alpha(0.16) : transparent));
                        border-width: (root.is-playing || Tokens.texture-physical || btn_play_touch.has-hover) ? 1px : 0px;
                        border-color: root.is-playing
                            ? Tokens.skin-meter-low
                            : (Tokens.texture-physical || btn_play_touch.has-hover ? Tokens.skin-meter-low.with-alpha(0.45) : transparent);
                        IconTransportPlay {
                            playing: root.is-playing;
                            icon-color: root.is-playing ? Tokens.skin-inset : Tokens.skin-meter-low;
                        }
                        btn_play_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-play(); }
                        }
                        TooltipBubble { text: @tr("播放 / 暂停走带 [Space]"); is-visible: btn_play_touch.has-hover; }
                    }

                    // 4. Record Arm / Punch-in Button (●)
                    btn_rec := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        // ⭐ T-FIX-122：`transport-record-button` 落到活键（同一 `toggle-record` 落点）。
                        accessible-role: button;
                        accessible-id: "transport-record-button";
                        accessible-label: @tr("录音");
                        accessible-action-default => { root.toggle-record(); }
                        // 同播放键：扁平档空转透明，只有红圆；悬停浮出淡红底。
                        background: root.is-recording
                            ? Tokens.skin-arm
                            : (Tokens.texture-physical
                                ? (btn_rec_touch.has-hover ? Tokens.skin-arm.with-alpha(0.28) : Tokens.skin-arm.with-alpha(0.18))
                                : (btn_rec_touch.has-hover ? Tokens.skin-arm.with-alpha(0.16) : transparent));
                        border-width: (root.is-recording || Tokens.texture-physical || btn_rec_touch.has-hover) ? 1px : 0px;
                        border-color: root.is-recording
                            ? Tokens.skin-arm
                            : (Tokens.texture-physical || btn_rec_touch.has-hover ? Tokens.skin-arm.with-alpha(0.45) : transparent);
                        IconTransportRecord {
                            icon-color: root.is-recording ? Tokens.skin-text-strong : Tokens.skin-arm;
                        }
                        btn_rec_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.toggle-record();
                            }
                        }
                        TooltipBubble { text: @tr("录音准备 / 穿插录音 [R]"); is-visible: btn_rec_touch.has-hover; }
                    }

                    // 5. Loop / Cycle Toggle Button (↻)
                    btn_loop := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        // T-FIX-173：LOOP 是真实可点控件，补与同栏 stop/play/record
                        // 相同的无障碍三件套；label 带开关状态，屏读器不再只看到空节点。
                        accessible-role: button;
                        accessible-id: "transport-loop-button";
                        accessible-label: root.is-looping
                            ? @tr("循环播放开关：开 (C)")
                            : @tr("循环播放开关：关 (C)");
                        accessible-action-default => { root.toggle-loop(); }
                        background: root.is-looping ? Theme.accent.with-alpha(0.22) : (btn_loop_touch.has-hover ? Tokens.bg-lane2 : transparent);
                        border-width: root.is-looping ? 1px : (btn_loop_touch.has-hover ? 1px : 0);
                        border-color: root.is-looping ? Theme.accent.with-alpha(0.70) : Tokens.line-strong;
                        IconTransportLoop {
                            icon-color: root.is-looping ? Theme.accent : (btn_loop_touch.has-hover ? Tokens.skin-text-body : Tokens.skin-text-dim);
                        }
                        btn_loop_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-loop(); }
                        }
                        TooltipBubble { text: @tr("选区循环播放开关 [C]"); is-visible: btn_loop_touch.has-hover; }
                    }
                }
            }

            // Group E: Digital Precision LCD HUD Display Bezel (High-contrast WCAG AA)
            Rectangle {
                height: 28px;
                // 二期质感: LCD 框走 §10 玻璃刷 + 斜向反光 (flat = 现行字面 Tokens.skin-inset, 反光 alpha 为 0)。
                background: Tokens.texture-physical ? Tokens.glass-brush : Tokens.skin-inset;
                border-radius: 5px;
                border-width: 1px;
                border-color: Tokens.bg-lane2;

                // 反光带刻意内收: 本框原无 clip (框内 TooltipBubble 须溢出
                // 显示), 不为反光加 clip; 带脚避开 5px 圆角区即可。
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 200;
                    viewbox-height: 28;
                    fill: Tokens.glass-reflection;
                    stroke-width: 0px;
                    MoveTo { x: 36; y: 0; }
                    LineTo { x: 116; y: 0; }
                    LineTo { x: 88; y: 28; }
                    LineTo { x: 8; y: 28; }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    alignment: center;

                    // LCD Bar.Beat.Tick
                    Rectangle {
                        height: 24px;
                        // ⭐ T-FIX-122：`transport-timecode` 落到这块只读读数（⛔ 不是可点键：
                        // 它的 TouchArea 没有 `clicked`，屏读器应读成文本而不是按钮）。
                        accessible-role: text;
                        accessible-id: "transport-timecode";
                        accessible-label: @tr("主时间码");
                        accessible-value: root.timecode-text;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "BAR / BEAT";
                                font-family: Tokens.font-mono;
                                font-size: 8.5px;
                                letter-spacing: 0.4px;
                                color: Tokens.skin-text-dim;
                                font-weight: 400;
                            }
                            // 固定宽度 + 左对齐：`001.01.000` → `1000.01.000` 只多一位数，
                            // 但按 preferred-width 布局时整组 HUD 会左右抖一格（F3）。
                            Text {
                                text: root.timecode-text;
                                width: 96px;
                                horizontal-alignment: left;
                                font-family: Tokens.font-mono;
                                font-size: 12px;
                                color: Theme.accent;
                                font-weight: 400;
                            }
                        }
                        lcd_beat_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                        TooltipBubble { text: @tr("当前时间码: 小节.拍.分拍"); is-visible: lcd_beat_touch.has-hover; }
                    }

                    Rectangle { width: 1px; height: 16px; background: Tokens.line; }

                    // BPM
                    Rectangle {
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "TEMPO";
                                font-family: Tokens.font-mono;
                                font-size: 8.5px;
                                letter-spacing: 0.4px;
                                color: Tokens.skin-text-dim;
                                font-weight: 400;
                            }
                            // 同上：`99.00` / `128.00` / `140.00` 位数不同会让相邻列来回移动。
                            Text {
                                text: root.bpm-display;
                                accessible-role: text;
                                accessible-id: "transport-tempo-value";
                                accessible-label: root.bpm-display;
                                width: 54px;
                                horizontal-alignment: left;
                                font-family: Tokens.font-mono;
                                font-size: 12px;
                                color: Theme.track-drum;
                                font-weight: 400;
                            }
                        }
                        bpm_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                let next-bpm = root.bpm-val == 124 ? 128 : (root.bpm-val == 128 ? 140 : 124);
                                root.change-bpm(next-bpm);
                            }
                        }
                        TooltipBubble { text: @tr("工程主速度: 点击循环切换 (124/128/140 BPM)"); is-visible: bpm_touch.has-hover; }
                    }

                    // F2：分隔线随 KEY/SCALE 一起离场（读数在 ⋯ 弹出层里）。
                    Rectangle { visible: !root.overflow; width: 1px; height: 16px; background: Tokens.line; }

                    // Global Scale Key
                    Rectangle {
                        // F2：溢出档离场，读数与循环切换动作收进 ⋯ 弹出层（见右岛 Group F0）。
                        visible: !root.overflow;
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "KEY / SCALE";
                                font-family: Tokens.font-mono;
                                font-size: 8.5px;
                                letter-spacing: 0.4px;
                                color: Tokens.skin-text-dim;
                                font-weight: 400;
                            }
                            Text {
                                // 调式名是**规范值**（循环逻辑按中文原文比较/赋值，
                                // 见下方 scale_touch），只在显示点映射翻译；三个已知
                                // 取值之外（工程数据带来的其它调式）原样显示。
                                text: root.scale-text == "C Minor (自然小调)" ? @tr("C Minor (自然小调)") : root.scale-text == "D Dorian (多利亚)" ? @tr("D Dorian (多利亚)") : root.scale-text == "F Major (大调)" ? @tr("F Major (大调)") : root.scale-text;
                                font-family: Tokens.font-ui;
                                font-size: 10.5px;
                                color: Theme.status-ok;
                                font-weight: 600;
                            }
                        }
                        scale_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                let next-scale = root.scale-text == "C Minor (自然小调)" ? "D Dorian (多利亚)" : (root.scale-text == "D Dorian (多利亚)" ? "F Major (大调)" : "C Minor (自然小调)");
                                root.change-scale(next-scale);
                            }
                        }
                        TooltipBubble { text: @tr("全局工程调式: 点击循环切换"); is-visible: scale_touch.has-hover; }
                    }
                }
            }
        }

        // 3. Right Logic 12 Island: Audio Engine & Workspace Persona Switcher
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            // Group F0: ⋯ 溢出按钮（F2，Wang 2026-11-17 裁决；借鉴 Logic Pro
            // 控制栏：位置与速度恒显、次要读数收进可弹出的溢出区）。只在
            // `overflow` 档在场；点开弹出层读全 KEY/SCALE、BUFFER、DSP 三项
            // 完整读数 —— 层内三行与栏内原格**同源同落点**（同一批 root 属性、
            // 同一组回调），点行照旧循环切换并关层。无新文案：钮面是符号 `⋯`，
            // 层内标签复用栏内既有字面（"KEY / SCALE" / "BUFFER:" / "DSP" 与
            // 三条既有 @tr 说明），不新增任何词条。
            Rectangle {
                visible: root.overflow;
                width: 30px;
                height: 28px;
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 Tokens.bg-lane2)。
                background: Tokens.texture-physical ? Tokens.shell-brush : Tokens.bg-lane2;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Tokens.line;
                accessible-role: button;
                accessible-id: "transport-overflow-button";
                accessible-label: "⋯";
                // `[UI-A11Y-003]` §7.3：落点与 `touch_overflow` 的 `clicked` 逐字相同。
                accessible-action-default => { overflow-popup.show(); }

                Text {
                    text: "⋯";
                    font-family: Tokens.font-mono;
                    font-size: 13px;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                touch_overflow := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { overflow-popup.show(); }
                }

                // 弹出层（`PopupWindow`，与卷帘右键菜单同款）：默认不显示、
                // 不占命中、不进默认帧；点层外任意处自动关。x 右对齐钮右沿，
                // y 落在栏下 6px。层内行高 34px × 3 + 上下垫 8px = 118px。
                overflow-popup := PopupWindow {
                    x: parent.width - self.width;
                    y: parent.height + 6px;
                    width: 232px;
                    height: 118px;
                    close-policy: close-on-click-outside;

                    Rectangle {
                        background: Tokens.texture-physical ? Tokens.panel-brush : Tokens.bg-panel;
                        border-width: 1px;
                        border-color: Tokens.line-strong;
                        border-radius: Tokens.radius-sm;
                        clip: true;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 0px;

                            // KEY / SCALE 行（点行 = 与 LCD 原格同一循环切换）。
                            Rectangle {
                                height: 34px;
                                accessible-role: button;
                                accessible-id: "transport-overflow-scale-row";
                                accessible-label: @tr("全局工程调式: 点击循环切换");
                                accessible-action-default => {
                                    let next-scale = root.scale-text == "C Minor (自然小调)" ? "D Dorian (多利亚)" : (root.scale-text == "D Dorian (多利亚)" ? "F Major (大调)" : "C Minor (自然小调)");
                                    root.change-scale(next-scale);
                                    overflow-popup.close();
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "KEY / SCALE";
                                        font-family: Tokens.font-mono;
                                        font-size: 8.5px;
                                        letter-spacing: 0.4px;
                                        color: Tokens.skin-text-dim;
                                        font-weight: 400;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        // 与 LCD 原格逐字同一显示映射（规范值只在显示点映射翻译）。
                                        text: root.scale-text == "C Minor (自然小调)" ? @tr("C Minor (自然小调)") : root.scale-text == "D Dorian (多利亚)" ? @tr("D Dorian (多利亚)") : root.scale-text == "F Major (大调)" ? @tr("F Major (大调)") : root.scale-text;
                                        font-family: Tokens.font-ui;
                                        font-size: 10.5px;
                                        color: Theme.status-ok;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                scale_row_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        let next-scale = root.scale-text == "C Minor (自然小调)" ? "D Dorian (多利亚)" : (root.scale-text == "D Dorian (多利亚)" ? "F Major (大调)" : "C Minor (自然小调)");
                                        root.change-scale(next-scale);
                                        overflow-popup.close();
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Tokens.line; }

                            // BUFFER 行（点行 = 与原格同一热切换循环）。
                            Rectangle {
                                height: 34px;
                                accessible-role: button;
                                accessible-id: "transport-overflow-buffer-row";
                                accessible-label: @tr("音频缓冲区延迟: 点击热切换 (64/128/512/2048 smp)");
                                accessible-action-default => {
                                    if (root.buffer-samples == 64) { root.hot-swap-buffer(128); }
                                    else if (root.buffer-samples == 128) { root.hot-swap-buffer(512); }
                                    else if (root.buffer-samples == 512) { root.hot-swap-buffer(2048); }
                                    else { root.hot-swap-buffer(64); }
                                    overflow-popup.close();
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "BUFFER:";
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        letter-spacing: 0.3px;
                                        color: Tokens.skin-text-dim;
                                        font-weight: 400;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.buffer-samples + " smp";
                                        font-family: Tokens.font-mono;
                                        font-size: 10.5px;
                                        color: Theme.accent;
                                        font-weight: 400;
                                        vertical-alignment: center;
                                    }
                                }

                                buffer_row_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        if (root.buffer-samples == 64) { root.hot-swap-buffer(128); }
                                        else if (root.buffer-samples == 128) { root.hot-swap-buffer(512); }
                                        else if (root.buffer-samples == 512) { root.hot-swap-buffer(2048); }
                                        else { root.hot-swap-buffer(64); }
                                        overflow-popup.close();
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Tokens.line; }

                            // DSP 行（纯读数，与原格同口径：无点击动作）。
                            Rectangle {
                                height: 34px;
                                accessible-role: text;
                                accessible-id: "transport-overflow-dsp-row";
                                accessible-label: @tr("实时音频 DSP CPU 负荷率");
                                accessible-value: "" + root.dsp-cpu-percent + "%";

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "DSP";
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        letter-spacing: 0.3px;
                                        color: Tokens.skin-text-dim;
                                        font-weight: 400;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "" + root.dsp-cpu-percent + "%";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        color: Theme.status-ok;
                                        font-weight: 400;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 62px;
                                            height: 3px;
                                            border-radius: 1.5px;
                                            background: Tokens.bg-shell;
                                            Rectangle {
                                                x: 0;
                                                width: (root.dsp-cpu-percent * 62px) / 100;
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: Theme.status-ok;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Group F: Zero reload buffer switcher (High-contrast labels)
            // 显式宽度：此前靠内容撑开、挂在 alignment:end 右岛里会被挤到只露出
            // "BUFF"，1920 宽甚至整体不渲染（细节实测 §4.6 / 控件体检 §5）。
            Rectangle {
                // F2：溢出档离场，读数与热切换动作收进 ⋯ 弹出层（见 Group F0）。
                visible: !root.overflow;
                width: 128px;
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 Tokens.bg-lane2)。
                background: Tokens.texture-physical ? Tokens.shell-brush : Tokens.bg-lane2;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Tokens.line;
                height: 28px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "BUFFER:";
                        font-family: Tokens.font-mono;
                        font-size: 9px;
                        letter-spacing: 0.3px;
                        color: Tokens.skin-text-dim;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "" + root.buffer-samples + " smp";
                        font-family: Tokens.font-mono;
                        font-size: 10.5px;
                        color: Theme.accent;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                }
                buf_touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        if (root.buffer-samples == 64) { root.hot-swap-buffer(128); }
                        else if (root.buffer-samples == 128) { root.hot-swap-buffer(512); }
                        else if (root.buffer-samples == 512) { root.hot-swap-buffer(2048); }
                        else { root.hot-swap-buffer(64); }
                    }
                }
                TooltipBubble { text: @tr("音频缓冲区延迟: 点击热切换 (64/128/512/2048 smp)"); is-visible: buf_touch.has-hover; tip-offset-x: -30px; }
            }

            // Group G: DSP CPU Gauge (High-contrast)
            Rectangle {
                // F2：溢出档离场，读数收进 ⋯ 弹出层（见 Group F0）。
                visible: !root.overflow;
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 Tokens.bg-lane2)。
                background: Tokens.texture-physical ? Tokens.shell-brush : Tokens.bg-lane2;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Tokens.line;
                width: 78px;
                height: 28px;

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        Text {
                            text: "DSP";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            letter-spacing: 0.3px;
                            color: Tokens.skin-text-dim;
                            font-weight: 400;
                        }
                        Text {
                            text: "" + root.dsp-cpu-percent + "%";
                            font-family: Tokens.font-mono;
                            font-size: 10px;
                            color: Theme.status-ok;
                            font-weight: 400;
                            horizontal-alignment: right;
                        }
                    }
                    Rectangle {
                        height: 3px;
                        background: Tokens.bg-shell;
                        border-radius: 1.5px;
                        Rectangle {
                            x: 0;
                            width: (root.dsp-cpu-percent * 62px) / 100;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.status-ok;
                        }
                    }
                }
                dsp_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                TooltipBubble { text: @tr("实时音频 DSP CPU 负荷率"); is-visible: dsp_touch.has-hover; tip-offset-x: -20px; }
            }

            // Group H: Workspace Persona Switcher (默认 / 演出 / 编曲 / 混音)
            Rectangle {
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 Tokens.bg-lane2)。
                background: Tokens.texture-physical ? Tokens.shell-brush : Tokens.bg-lane2;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Tokens.line;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. 默认全景 (Default Production)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.YebanDefault ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.YebanDefault ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconPersonaDefault {
                            selected: Theme.persona == PersonaMode.YebanDefault;
                            icon-color: Theme.persona == PersonaMode.YebanDefault ? Theme.accent : Tokens.skin-text-dim;
                        }
                        touch_p_def := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.YebanDefault); }
                        }
                        TooltipBubble { text: @tr("默认工作区"); is-visible: touch_p_def.has-hover; tip-offset-x: -20px; }
                    }

                    // 2. 现场演出 (Clip Matrix Performance Flow)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.AbletonLive ? Tokens.bg-shell : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.AbletonLive ? 1px : 0;
                        border-color: Theme.track-drum.with-alpha(0.6);
                        IconPersonaPerformance {
                            selected: Theme.persona == PersonaMode.AbletonLive;
                            icon-color: Theme.persona == PersonaMode.AbletonLive ? Theme.track-drum : Tokens.skin-text-dim;
                        }
                        touch_p_live := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.AbletonLive); }
                        }
                        TooltipBubble { text: @tr("现场演出模式 (Clip 流)"); is-visible: touch_p_live.has-hover; tip-offset-x: -20px; }
                    }

                    // 3. 线性编曲 (Arrange Flow)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.LogicPro ? Tokens.selection.mix(Tokens.bg-shell, 0.16) : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.LogicPro ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconPersonaArranger {
                            selected: Theme.persona == PersonaMode.LogicPro;
                            icon-color: Theme.persona == PersonaMode.LogicPro ? Theme.accent : Tokens.skin-text-dim;
                        }
                        touch_p_log := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.LogicPro); }
                        }
                        TooltipBubble { text: @tr("线性编曲模式 (时间轴流)"); is-visible: touch_p_log.has-hover; tip-offset-x: -20px; }
                    }

                    // 4. 混音控制台 (Mix & Master)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.CubasePro ? Tokens.bg-shell : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.CubasePro ? 1px : 0;
                        border-color: Theme.track-vocal.with-alpha(0.6);
                        IconPersonaMixer {
                            selected: Theme.persona == PersonaMode.CubasePro;
                            icon-color: Theme.persona == PersonaMode.CubasePro ? Theme.track-vocal : Tokens.skin-text-dim;
                        }
                        touch_p_cu := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.CubasePro); }
                        }
                        TooltipBubble { text: @tr("混音母带模式 (混音控制台流)"); is-visible: touch_p_cu.has-hover; tip-offset-x: -20px; }
                    }
                }
            }

            // Group I: Command palette button
            Rectangle {
                // F1 第三优先收起：窄档离场（Ctrl+K 键路照旧可用）。
                visible: !root.hide-cmd;
                width: 52px;
                height: 28px;
                // 二期质感: 命令钮走 §10 凸起刷 (flat = 现行字面 Tokens.bg-panel)。
                background: Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;
                Text {
                    text: "";
                    font-family: Tokens.font-mono;
                    font-size: 9px;
                    font-weight: 400;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                touch_cmd := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-cmd-palette(); }
                }
                TooltipBubble { text: @tr("快捷命令面板"); is-visible: touch_cmd.has-hover; tip-offset-x: -30px; }
            }

            // Group J: Architecture insights toggle
            Rectangle {
                width: 28px;
                height: 28px;
                background: Theme.status-warn.with-alpha(0.18);
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.status-warn.with-alpha(0.35);
                IconEyeInsight {
                    active: false;
                    active-color: Theme.status-warn;
                }
                touch_spot := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.toggle-hotspots(); }
                }
                TooltipBubble { text: @tr("架构透视与热区诊断 [H]"); is-visible: touch_spot.has-hover; tip-offset-x: -40px; }
            }

            // Group K: Hover tooltips toggle switch (TIPS [T])
            Rectangle {
                // F1 第二优先收起：窄档离场（[T] 键路照旧可用）。
                visible: !root.hide-tips;
                width: 30px;
                height: 28px;
                background: Theme.show-tooltips ? Theme.accent.with-alpha(0.18) : Tokens.bg-panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.show-tooltips ? Theme.accent.with-alpha(0.5) : Theme.border-subtle;

                HorizontalLayout {
                    alignment: center;
                    spacing: 3px;

                    Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.show-tooltips ? Theme.accent : Tokens.ink-1;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "T";
                        font-family: Tokens.font-mono;
                        font-size: 10.5px;
                        font-weight: 400;
                        color: Theme.show-tooltips ? Theme.accent : Tokens.skin-text-dim;
                        vertical-alignment: center;
                    }
                }

                touch_tips := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        Theme.show-tooltips = !Theme.show-tooltips;
                    }
                }
                TooltipBubble { text: Theme.show-tooltips ? @tr("悬浮提示: 已开启 (点击关闭) [T]") : @tr("悬浮提示: 已关闭 (点击开启) [T]"); is-visible: touch_tips.has-hover; tip-offset-x: -40px; }
            }

            // Group L 已撤（负责人 2026-11-17 口径）：语言与质感两个切换
            // 入口统一进系统主菜单「设置」（语言 → MainWindow.select-language,
            // 质感 → MainWindow.select-texture，宿主接管），走带栏不再放
            // 切换钮/chip。原 Group L 语言菜单与质感开关两块 Rectangle
            // 就此删除，栏内其余元素回到无钮排布。
        }
    }
}

