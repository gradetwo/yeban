// --- 2. Edit Tools ---

component IconToolPointer inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #b6c2d2;

    width: 14px;
    height: 12px;

    Path {
        x: 1px;
        y: 0;
        width: 12px;
        height: 12px;
        commands: "M 2 0.5 L 2 11.5 L 5 8.5 L 8 11.5 L 9.5 10 L 6.5 7 L 10 7 Z";
        fill: root.icon-color;
    }
}

component IconToolRange inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #b6c2d2;

    width: 14px;
    height: 12px;

    // Left bracket
    Rectangle {
        x: 1.5px;
        y: 1px;
        width: 1.8px;
        height: 10px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 1.5px;
        y: 1px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 1.5px;
        y: 9.5px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }

    // Center span
    Rectangle {
        x: 4.5px;
        y: 5.2px;
        width: 5px;
        height: 1.6px;
        border-radius: 0.5px;
        background: root.icon-color;
    }

    // Right bracket
    Rectangle {
        x: 10.7px;
        y: 1px;
        width: 1.8px;
        height: 10px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 9px;
        y: 1px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 9px;
        y: 9.5px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
}

component IconToolSplit inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #b6c2d2;

    width: 14px;
    height: 12px;

    Path {
        x: 1px;
        y: 0;
        width: 12px;
        height: 12px;
        commands: "M 2 11 L 10 1 M 6 1 L 11 1 L 11 6 M 3 11 L 1 11 L 1 9";
        stroke: root.icon-color;
        stroke-width: 1.5px;
    }
}

component IconToolDraw inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #b6c2d2;

    width: 14px;
    height: 12px;

    Path {
        x: 1px;
        y: 0;
        width: 12px;
        height: 12px;
        commands: "M 1 11 L 1 8 L 8 1 L 11 4 L 4 11 Z";
        stroke: root.icon-color;
        stroke-width: 1.2px;
        fill: root.selected ? root.icon-color : root.icon-color.with-alpha(0.25);
    }
}

// --- 3. Workspace Persona Switchers ---

component IconPersonaDefault inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #b6c2d2;

    width: 14px;
    height: 12px;

    // Left Inspector strip
    Rectangle {
        x: 0.5px;
        y: 0.5px;
        width: 3.5px;
        height: 11px;
        border-radius: 1px;
        background: root.icon-color;
    }
    // Top Arranger block
    Rectangle {
        x: 5px;
        y: 0.5px;
        width: 8.5px;
        height: 4.8px;
        border-radius: 1px;
        background: root.icon-color;
    }
    // Bottom Mixer dock
    Rectangle {
        x: 5px;
        y: 6.7px;
        width: 8.5px;
        height: 4.8px;
        border-radius: 1px;
        background: root.icon-color;
    }
}

component IconPersonaPerformance inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #b6c2d2;

    width: 14px;
    height: 12px;

    // 6-pad performance matrix (Clip launcher pads)
    Rectangle { x: 0.5px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 5.2px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 9.9px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 0.5px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 5.2px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 9.9px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
}

component IconPersonaArranger inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #b6c2d2;

    width: 14px;
    height: 12px;

    // Track 1
    Rectangle { x: 0.5px; y: 1px; width: 6.5px; height: 2px; border-radius: 0.5px; background: root.icon-color; }
    Rectangle { x: 8px; y: 1px; width: 5.5px; height: 2px; border-radius: 0.5px; background: root.icon-color.with-alpha(0.65); }

    // Track 2
    Rectangle { x: 1.5px; y: 5px; width: 10px; height: 2px; border-radius: 0.5px; background: root.icon-color; }

    // Track 3
    Rectangle { x: 0.5px; y: 9px; width: 5px; height: 2px; border-radius: 0.5px; background: root.icon-color; }
    Rectangle { x: 6.5px; y: 9px; width: 7px; height: 2px; border-radius: 0.5px; background: root.icon-color.with-alpha(0.65); }

    // Playhead line
    Rectangle {
        x: 6px;
        y: 0;
        width: 1.2px;
        height: 12px;
        background: root.selected ? #ffffff : Theme.accent;
    }
}

component IconPersonaMixer inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #b6c2d2;

    width: 14px;
    height: 12px;

    // Fader strip 1
    Rectangle { x: 1.8px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 0.5px; y: 3px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }

    // Fader strip 2
    Rectangle { x: 6.4px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 5.1px; y: 7px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }

    // Fader strip 3
    Rectangle { x: 11px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 9.7px; y: 4px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }
}

component IconEyeInsight inherits Rectangle {
    in property <bool> active: false;
    in property <color> active-color: Theme.status-warn;

    width: 14px;
    height: 12px;

    Path {
        x: 0;
        y: 0;
        width: 14px;
        height: 12px;
        commands: "M 1 6 Q 7 1, 13 6 Q 7 11, 1 6 Z";
        stroke: root.active-color;
        stroke-width: 1.2px;
        fill: root.active ? root.active-color.with-alpha(0.3) : transparent;
    }
    Rectangle {
        x: 5.5px;
        y: 4.5px;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: root.active-color;
    }
}

// --- 5. Transport Cluster Vector Icons ---

component IconTransportRewind inherits Rectangle {
    in property <color> icon-color: #cbd5e1;
    width: 13px;
    height: 10px;

    Path {
        x: 0px;
        y: 0px;
        width: 6px;
        height: 10px;
        commands: "M 6 0 L 0 5 L 6 10 Z";
        fill: root.icon-color;
    }
    Path {
        x: 6.5px;
        y: 0px;
        width: 6px;
        height: 10px;
        commands: "M 6 0 L 0 5 L 6 10 Z";
        fill: root.icon-color;
    }
}

component IconTransportStop inherits Rectangle {
    in property <color> icon-color: #cbd5e1;
    width: 9px;
    height: 9px;

    Rectangle {
        width: 9px;
        height: 9px;
        border-radius: 1.5px;
        background: root.icon-color;
    }
}

component IconTransportPlay inherits Rectangle {
    in property <color> icon-color: #10b981;
    width: 10px;
    height: 11px;

    Path {
        x: 0px;
        y: 0px;
        width: 10px;
        height: 11px;
        commands: "M 0 0 L 10 5.5 L 0 11 Z";
        fill: root.icon-color;
    }
}

component IconTransportRecord inherits Rectangle {
    in property <color> icon-color: #ef4444;
    width: 9px;
    height: 9px;

    Rectangle {
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: root.icon-color;
    }
}

component IconTransportLoop inherits Rectangle {
    in property <color> icon-color: #b6c2d2;
    width: 12px;
    height: 10px;

    Path {
        x: 0px;
        y: 0px;
        width: 12px;
        height: 10px;
        commands: "M 3 2 A 4 4 0 1 1 1.5 6 L 0 6 L 2.5 9 L 5 6 L 3.5 6 A 2.5 2.5 0 1 0 3.5 3 Z";
        fill: root.icon-color;
    }
}

export component TransportHeaderBar inherits Rectangle {
    in-out property <bool> show-browser: true;
    in-out property <bool> show-clipmatrix: true;
    in-out property <bool> show-lower-dock: true;
    in-out property <bool> show-control-room: true;

    in-out property <string> active-tool: "pointer"; // pointer, range, split, draw
    in-out property <bool> is-playing: false;
    in-out property <bool> is-recording: false;
    in-out property <bool> is-looping: true;
    in-out property <string> timecode-text: "003.02.01";
    in-out property <int> bpm-val: 124;
    in-out property <string> scale-text: "C Minor (自然小调)";
    in-out property <int> buffer-samples: 128;
    in-out property <int> dsp-cpu-percent: 14;
    // 界面语言当前态（九语 i18n）：语言代码与自称名。宿主持有的状态在 MainWindow
    // 侧，这里只读它显示 Group L 菜单按钮的当前语言。
    in-out property <string> language-code: "zh-CN";
    in-out property <string> language-name: "中文";

    callback toggle-zone(string);
    callback select-tool(string);
    callback toggle-play();
    callback toggle-rec();
    callback toggle-record();
    callback toggle-loop();
    callback rewind();
    callback change-bpm(int);
    callback change-scale(string);
    callback hot-swap-buffer(int);
    callback select-persona(PersonaMode);
    callback open-cmd-palette();
    callback toggle-hotspots();
    callback select-language(string);
    callback revert-to-last-commit();

    height: 48px;
    // 二期质感: 栏体走 §10 面板刷 (flat = Theme.header-bg 本身)。
    background: Tokens.texture-physical ? Tokens.panel-brush : Theme.header-bg;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        // 1. Left Logic 12 Island: Brand & Zone Toggles & Edit Tools (Separated Groups)
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            // Group A: Brand Mark (Official Studio Logo Mark)
            Rectangle {
                // 二期质感: 品牌块走 §10 外壳刷 (flat = 现行字面 #10131a)。
                background: Tokens.texture-physical ? Tokens.shell-brush : #10131a;
                border-radius: 4px;
                border-width: 1px;
                border-color: #ffffff25;
                width: 36px;
                height: 28px;

                Image {
                    source: @image-url("../../../assets/brand/png/yeban-dark-64.png");
                    width: 24px;
                    height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                brand_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                TooltipBubble { text: "夜半"; is-visible: brand_touch.has-hover; }
            }

            // Group B: Zone Visibility Toggles (检查器 [I], Clip 矩阵 [Tab], 底栏 [P/X], 监听室 [F4])
            Rectangle {
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 #0a0d14)。
                background: Tokens.texture-physical ? Tokens.shell-brush : #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. 检查器 [I]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-browser ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.show-browser ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconInspectorToggle {
                            active: root.show-browser;
                            active-color: Theme.accent;
                            inactive-color: #b6c2d2;
                        }
                        touch_insp := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("browser"); }
                        }
                        TooltipBubble { text: @tr("检查器与音色库 [I]"); is-visible: touch_insp.has-hover; }
                    }

                    // 2. Clip 矩阵 [Tab]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-clipmatrix ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.show-clipmatrix ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconClipMatrixToggle {
                            active: root.show-clipmatrix;
                            active-color: Theme.accent;
                            inactive-color: #b6c2d2;
                        }
                        touch_clip := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("clipmatrix"); }
                        }
                        TooltipBubble { text: @tr("Clip 激发矩阵 [Tab]"); is-visible: touch_clip.has-hover; }
                    }

                    // 3. 底栏 [P/X]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-lower-dock ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.show-lower-dock ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconLowerDockToggle {
                            active: root.show-lower-dock;
                            active-color: Theme.accent;
                            inactive-color: #b6c2d2;
                        }
                        touch_dock := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("lower"); }
                        }
                        TooltipBubble { text: @tr("统一底栏 (混音控制台/钢琴卷帘) [P / X]"); is-visible: touch_dock.has-hover; }
                    }

                    // 4. 监听室 [F4]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-control-room ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.show-control-room ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconControlRoomToggle {
                            active: root.show-control-room;
                            active-color: Theme.accent;
                            inactive-color: #b6c2d2;
                        }
                        touch_room := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("right"); }
                        }
                        TooltipBubble { text: @tr("监听控制室与响度计 [F4]"); is-visible: touch_room.has-hover; }
                    }
                }
            }

            // Group C: Edit Tools (选区 [1], 范围 [2], 切分 [3], 画笔 [4])
            Rectangle {
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 #0a0d14)。
                background: Tokens.texture-physical ? Tokens.shell-brush : #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 选区 [1]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "pointer" ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "pointer" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolPointer {
                            selected: root.active-tool == "pointer";
                            icon-color: root.active-tool == "pointer" ? Theme.accent : #b6c2d2;
                        }
                        touch_ptr := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("pointer"); }
                        }
                        TooltipBubble { text: @tr("指针选区工具: 选择与移动 [1]"); is-visible: touch_ptr.has-hover; }
                    }

                    // 范围 [2]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "range" ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "range" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolRange {
                            selected: root.active-tool == "range";
                            icon-color: root.active-tool == "range" ? Theme.accent : #b6c2d2;
                        }
                        touch_rng := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("range"); }
                        }
                        TooltipBubble { text: @tr("力度 / 范围工具 [4]"); is-visible: touch_rng.has-hover; }
                    }

                    // 切分 [3]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "split" ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "split" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolSplit {
                            selected: root.active-tool == "split";
                            icon-color: root.active-tool == "split" ? Theme.accent : #b6c2d2;
                        }
                        touch_splt := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("split"); }
                        }
                        TooltipBubble { text: @tr("剃刀切分工具 [3]"); is-visible: touch_splt.has-hover; }
                    }

                    // 画笔 [2 / B]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "draw" ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "draw" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolDraw {
                            selected: root.active-tool == "draw";
                            icon-color: root.active-tool == "draw" ? Theme.accent : #b6c2d2;
                        }
                        touch_drw := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("draw"); }
                        }
                        TooltipBubble { text: @tr("画笔工具: 绘制音符与自动化 [2 / B]"); is-visible: touch_drw.has-hover; }
                    }
                }
            }
        }

        // 2. Center Logic 12 Island: Unified Transport & Precision Digital LCD (Separated by Spacing)
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            alignment: center;

            // Group D: Cohesive Logic 12 Transport Control Cluster (Unified height, styling, vector iconography, and balanced visual weight)
            Rectangle {
                // 二期质感: 走带簇底板走 §10 外壳刷 (flat = 现行字面 #090c12); 簇内按钮状态色不动。
                background: Tokens.texture-physical ? Tokens.shell-brush : #090c12;
                border-radius: 5px;
                border-width: 1px;
                border-color: #1c2333;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. Rewind / Return to Zero (⏮)
                    btn_rewind := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: btn_rewind_touch.has-hover ? #161e2e : transparent;
                        border-width: btn_rewind_touch.has-hover ? 1px : 0;
                        border-color: #334155;
                        IconTransportRewind {
                            icon-color: btn_rewind_touch.has-hover ? #f8fafc : #cbd5e1;
                        }
                        btn_rewind_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.rewind(); }
                        }
                        TooltipBubble { text: @tr("返回工程起点 / 归零 [Return]"); is-visible: btn_rewind_touch.has-hover; }
                    }

                    // 2. Stop Button (■)
                    btn_stop := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: (!root.is-playing && !root.is-recording) ? #161f30 : (btn_stop_touch.has-hover ? #141b29 : transparent);
                        border-width: (!root.is-playing && !root.is-recording) ? 1px : (btn_stop_touch.has-hover ? 1px : 0);
                        border-color: (!root.is-playing && !root.is-recording) ? #2e3d55 : #253347;
                        IconTransportStop {
                            icon-color: (!root.is-playing && !root.is-recording) ? #f8fafc : (btn_stop_touch.has-hover ? #cbd5e1 : #b6c2d2);
                        }
                        btn_stop_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                if root.is-playing { root.toggle-play(); }
                                else if root.is-recording { root.toggle-rec(); }
                                else { root.rewind(); }
                            }
                        }
                        TooltipBubble { text: @tr("停止播放并复位 [Space]"); is-visible: btn_stop_touch.has-hover; }
                    }

                    // 3. Play / Pause Button (▶)
                    btn_play := Rectangle {
                        width: 36px;
                        height: 24px;
                        border-radius: 3px;
                        background: root.is-playing ? #10b981 : (btn_play_touch.has-hover ? #10b981.with-alpha(0.28) : #10b981.with-alpha(0.18));
                        border-width: 1px;
                        border-color: root.is-playing ? #059669 : #10b981.with-alpha(0.45);
                        IconTransportPlay {
                            icon-color: root.is-playing ? #020617 : #10b981;
                        }
                        btn_play_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-play(); }
                        }
                        TooltipBubble { text: @tr("播放 / 暂停走带 [Space]"); is-visible: btn_play_touch.has-hover; }
                    }

                    // 4. Record Arm / Punch-in Button (●)
                    btn_rec := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: root.is-recording ? #ef4444 : (btn_rec_touch.has-hover ? #ef4444.with-alpha(0.28) : #ef4444.with-alpha(0.18));
                        border-width: 1px;
                        border-color: root.is-recording ? #dc2626 : #ef4444.with-alpha(0.45);
                        IconTransportRecord {
                            icon-color: root.is-recording ? #ffffff : #ef4444;
                        }
                        btn_rec_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.toggle-record();
                            }
                        }
                        TooltipBubble { text: @tr("录音准备 / 穿插录音 [R]"); is-visible: btn_rec_touch.has-hover; }
                    }

                    // 5. Loop / Cycle Toggle Button (↻)
                    btn_loop := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: root.is-looping ? Theme.accent.with-alpha(0.22) : (btn_loop_touch.has-hover ? #161e2e : transparent);
                        border-width: root.is-looping ? 1px : (btn_loop_touch.has-hover ? 1px : 0);
                        border-color: root.is-looping ? Theme.accent.with-alpha(0.70) : #334155;
                        IconTransportLoop {
                            icon-color: root.is-looping ? Theme.accent : (btn_loop_touch.has-hover ? #cbd5e1 : #b6c2d2);
                        }
                        btn_loop_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-loop(); }
                        }
                        TooltipBubble { text: @tr("选区循环播放开关 [C]"); is-visible: btn_loop_touch.has-hover; }
                    }
                }
            }

            // Group E: Digital Precision LCD HUD Display Bezel (High-contrast WCAG AA)
            Rectangle {
                height: 28px;
                // 二期质感: LCD 框走 §10 玻璃刷 + 斜向反光 (flat = 现行字面 #05070a, 反光 alpha 为 0)。
                background: Tokens.texture-physical ? Tokens.glass-brush : #05070a;
                border-radius: 5px;
                border-width: 1px;
                border-color: #1a202c;

                // 反光带刻意内收: 本框原无 clip (框内 TooltipBubble 须溢出
                // 显示), 不为反光加 clip; 带脚避开 5px 圆角区即可。
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 200;
                    viewbox-height: 28;
                    fill: Tokens.glass-reflection;
                    stroke-width: 0px;
                    MoveTo { x: 36; y: 0; }
                    LineTo { x: 116; y: 0; }
                    LineTo { x: 88; y: 28; }
                    LineTo { x: 8; y: 28; }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    alignment: center;

                    // LCD Bar.Beat.Tick
                    Rectangle {
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "BAR / BEAT";
                                font-family: Tokens.font-mono;
                                font-size: 8.5px;
                                letter-spacing: 0.4px;
                                color: #b6c2d2;
                                font-weight: 400;
                            }
                            Text {
                                text: root.timecode-text;
                                font-family: Tokens.font-mono;
                                font-size: 12px;
                                color: Theme.accent;
                                font-weight: 400;
                            }
                        }
                        lcd_beat_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                        TooltipBubble { text: @tr("当前时间码: 小节.拍.分拍"); is-visible: lcd_beat_touch.has-hover; }
                    }

                    Rectangle { width: 1px; height: 16px; background: #ffffff14; }

                    // BPM
                    Rectangle {
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "TEMPO";
                                font-family: Tokens.font-mono;
                                font-size: 8.5px;
                                letter-spacing: 0.4px;
                                color: #b6c2d2;
                                font-weight: 400;
                            }
                            Text {
                                text: "" + root.bpm-val + ".00";
                                font-family: Tokens.font-mono;
                                font-size: 12px;
                                color: Theme.track-drum;
                                font-weight: 400;
                            }
                        }
                        bpm_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                let next-bpm = root.bpm-val == 124 ? 128 : (root.bpm-val == 128 ? 140 : 124);
                                root.change-bpm(next-bpm);
                            }
                        }
                        TooltipBubble { text: @tr("工程主速度: 点击循环切换 (124/128/140 BPM)"); is-visible: bpm_touch.has-hover; }
                    }

                    Rectangle { width: 1px; height: 16px; background: #ffffff14; }

                    // Global Scale Key
                    Rectangle {
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "KEY / SCALE";
                                font-family: Tokens.font-mono;
                                font-size: 8.5px;
                                letter-spacing: 0.4px;
                                color: #b6c2d2;
                                font-weight: 400;
                            }
                            Text {
                                // 调式名是**规范值**（循环逻辑按中文原文比较/赋值，
                                // 见下方 scale_touch），只在显示点映射翻译；三个已知
                                // 取值之外（工程数据带来的其它调式）原样显示。
                                text: root.scale-text == "C Minor (自然小调)" ? @tr("C Minor (自然小调)") : root.scale-text == "D Dorian (多利亚)" ? @tr("D Dorian (多利亚)") : root.scale-text == "F Major (大调)" ? @tr("F Major (大调)") : root.scale-text;
                                font-family: Tokens.font-ui;
                                font-size: 10.5px;
                                color: Theme.status-ok;
                                font-weight: 600;
                            }
                        }
                        scale_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                let next-scale = root.scale-text == "C Minor (自然小调)" ? "D Dorian (多利亚)" : (root.scale-text == "D Dorian (多利亚)" ? "F Major (大调)" : "C Minor (自然小调)");
                                root.change-scale(next-scale);
                            }
                        }
                        TooltipBubble { text: @tr("全局工程调式: 点击循环切换"); is-visible: scale_touch.has-hover; }
                    }
                }
            }
        }

        // 3. Right Logic 12 Island: Audio Engine & Workspace Persona Switcher
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            // Group F: Zero reload buffer switcher (High-contrast labels)
            // 显式宽度：此前靠内容撑开、挂在 alignment:end 右岛里会被挤到只露出
            // "BUFF"，1920 宽甚至整体不渲染（细节实测 §4.6 / 控件体检 §5）。
            Rectangle {
                width: 128px;
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 #0a0d14)。
                background: Tokens.texture-physical ? Tokens.shell-brush : #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                height: 28px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "BUFFER:";
                        font-family: Tokens.font-mono;
                        font-size: 9px;
                        letter-spacing: 0.3px;
                        color: #b6c2d2;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "" + root.buffer-samples + " smp";
                        font-family: Tokens.font-mono;
                        font-size: 10.5px;
                        color: Theme.accent;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                }
                buf_touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        if (root.buffer-samples == 64) { root.hot-swap-buffer(128); }
                        else if (root.buffer-samples == 128) { root.hot-swap-buffer(512); }
                        else if (root.buffer-samples == 512) { root.hot-swap-buffer(2048); }
                        else { root.hot-swap-buffer(64); }
                    }
                }
                TooltipBubble { text: @tr("音频缓冲区延迟: 点击热切换 (64/128/512/2048 smp)"); is-visible: buf_touch.has-hover; tip-offset-x: -30px; }
            }

            // Group G: DSP CPU Gauge (High-contrast)
            Rectangle {
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 #0a0d14)。
                background: Tokens.texture-physical ? Tokens.shell-brush : #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                width: 78px;
                height: 28px;

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        Text {
                            text: "DSP";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            letter-spacing: 0.3px;
                            color: #b6c2d2;
                            font-weight: 400;
                        }
                        Text {
                            text: "" + root.dsp-cpu-percent + "%";
                            font-family: Tokens.font-mono;
                            font-size: 10px;
                            color: Theme.status-ok;
                            font-weight: 400;
                            horizontal-alignment: right;
                        }
                    }
                    Rectangle {
                        height: 3px;
                        background: #080a10;
                        border-radius: 1.5px;
                        Rectangle {
                            x: 0;
                            width: (root.dsp-cpu-percent * 62px) / 100;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.status-ok;
                        }
                    }
                }
                dsp_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                TooltipBubble { text: @tr("实时音频 DSP CPU 负荷率"); is-visible: dsp_touch.has-hover; tip-offset-x: -20px; }
            }

            // Group H: Workspace Persona Switcher (默认 / 演出 / 编曲 / 混音)
            Rectangle {
                // 二期质感: 组板走 §10 外壳刷 (flat = 现行字面 #0a0d14)。
                background: Tokens.texture-physical ? Tokens.shell-brush : #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. 默认全景 (Default Production)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.YebanDefault ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.YebanDefault ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconPersonaDefault {
                            selected: Theme.persona == PersonaMode.YebanDefault;
                            icon-color: Theme.persona == PersonaMode.YebanDefault ? Theme.accent : #b6c2d2;
                        }
                        touch_p_def := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.YebanDefault); }
                        }
                        TooltipBubble { text: @tr("默认工作区"); is-visible: touch_p_def.has-hover; tip-offset-x: -20px; }
                    }

                    // 2. 现场演出 (Clip Matrix Performance Flow)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.AbletonLive ? #2d2014 : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.AbletonLive ? 1px : 0;
                        border-color: Theme.track-drum.with-alpha(0.6);
                        IconPersonaPerformance {
                            selected: Theme.persona == PersonaMode.AbletonLive;
                            icon-color: Theme.persona == PersonaMode.AbletonLive ? Theme.track-drum : #b6c2d2;
                        }
                        touch_p_live := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.AbletonLive); }
                        }
                        TooltipBubble { text: @tr("现场演出模式 (Clip 流)"); is-visible: touch_p_live.has-hover; tip-offset-x: -20px; }
                    }

                    // 3. 线性编曲 (Arrange Flow)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.LogicPro ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.LogicPro ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconPersonaArranger {
                            selected: Theme.persona == PersonaMode.LogicPro;
                            icon-color: Theme.persona == PersonaMode.LogicPro ? Theme.accent : #b6c2d2;
                        }
                        touch_p_log := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.LogicPro); }
                        }
                        TooltipBubble { text: @tr("线性编曲模式 (时间轴流)"); is-visible: touch_p_log.has-hover; tip-offset-x: -20px; }
                    }

                    // 4. 混音控制台 (Mix & Master)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.CubasePro ? #162620 : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.CubasePro ? 1px : 0;
                        border-color: Theme.track-vocal.with-alpha(0.6);
                        IconPersonaMixer {
                            selected: Theme.persona == PersonaMode.CubasePro;
                            icon-color: Theme.persona == PersonaMode.CubasePro ? Theme.track-vocal : #b6c2d2;
                        }
                        touch_p_cu := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.CubasePro); }
                        }
                        TooltipBubble { text: @tr("混音母带模式 (混音控制台流)"); is-visible: touch_p_cu.has-hover; tip-offset-x: -20px; }
                    }
                }
            }

            // Group I: Command palette button
            Rectangle {
                width: 52px;
                height: 28px;
                // 二期质感: 命令钮走 §10 凸起刷 (flat = 现行字面 #10141d)。
                background: Tokens.texture-physical ? Tokens.raised-brush : #10141d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;
                Text {
                    text: "Ctrl+K";
                    font-family: Tokens.font-mono;
                    font-size: 9px;
                    font-weight: 400;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                touch_cmd := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-cmd-palette(); }
                }
                TooltipBubble { text: @tr("快捷命令面板 [Ctrl+K]"); is-visible: touch_cmd.has-hover; tip-offset-x: -30px; }
            }

            // Group J: Architecture insights toggle
            Rectangle {
                width: 28px;
                height: 28px;
                background: Theme.status-warn.with-alpha(0.18);
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.status-warn.with-alpha(0.35);
                IconEyeInsight {
                    active: false;
                    active-color: Theme.status-warn;
                }
                touch_spot := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.toggle-hotspots(); }
                }
                TooltipBubble { text: @tr("架构透视与热区诊断 [H]"); is-visible: touch_spot.has-hover; tip-offset-x: -40px; }
            }

            // Group K: Hover tooltips toggle switch (TIPS [T])
            Rectangle {
                width: 30px;
                height: 28px;
                background: Theme.show-tooltips ? Theme.accent.with-alpha(0.18) : #10141d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.show-tooltips ? Theme.accent.with-alpha(0.5) : Theme.border-subtle;

                HorizontalLayout {
                    alignment: center;
                    spacing: 3px;

                    Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.show-tooltips ? Theme.accent : #94a3b8;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "T";
                        font-family: Tokens.font-mono;
                        font-size: 10.5px;
                        font-weight: 400;
                        color: Theme.show-tooltips ? Theme.accent : #b6c2d2;
                        vertical-alignment: center;
                    }
                }

                touch_tips := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        Theme.show-tooltips = !Theme.show-tooltips;
                    }
                }
                TooltipBubble { text: Theme.show-tooltips ? @tr("悬浮提示: 已开启 (点击关闭) [T]") : @tr("悬浮提示: 已关闭 (点击开启) [T]"); is-visible: touch_tips.has-hover; tip-offset-x: -40px; }
            }

            // Group L: Language menu （九语 i18n）—— 按钮显示当前语言自称名
            // （root.language-name，宿主持有），点击弹出九语菜单（PopupWindow，
            // 先例见 ui/console/piano_roll.slint 的 context-menu-popup：
            // 菜单项在弹出层内调外层回调后关弹窗是允许方向；九项用 for 循环，
            // 先例见 arrangement.slint 的 arr_tracks_menu_col）。自称名按定义
            // 不走 @tr（判据白名单，见 tests/i18n_coverage.rs）。
            Rectangle {
                width: 64px;
                height: 28px;
                background: #10141d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                lang-menu-popup := PopupWindow {
                    // 菜单宽 150px，右缘与按钮右缘对齐（按钮宽 64px ⇒ 左移 86px），
                    // 落在按钮下方 4px 处。
                    x: -86px;
                    y: 32px;
                    width: 150px;
                    height: 296px;
                    close-policy: close-on-click-outside;

                    Rectangle {
                        background: #10141d;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        border-radius: Theme.radius;
                        clip: true;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 0px;
                            for lang in [
                                { code: "zh-CN", name: "中文" },
                                { code: "en-US", name: "English" },
                                { code: "fr-FR", name: "Français" },
                                { code: "es-ES", name: "Español" },
                                { code: "pt-BR", name: "Português" },
                                { code: "ja-JP", name: "日本語" },
                                { code: "ko-KR", name: "한국어" },
                                { code: "ru-RU", name: "Русский" },
                                { code: "de-DE", name: "Deutsch" },
                            ] : Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                background: lang-touch.has-hover ? Theme.accent.with-alpha(0.22) : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    Text {
                                        // 当前项打勾：opacity 占位（不用 visible，
                                        // 否则未勾选项的名字会左移一格）。
                                        text: "✓";
                                        opacity: root.language-code == lang.code ? 1 : 0;
                                        font-family: Tokens.font-ui;
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: lang.name;
                                        font-family: Tokens.font-ui;
                                        font-size: 10.5px;
                                        color: #cbd5e1;
                                        vertical-alignment: center;
                                    }
                                }
                                lang-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.select-language(lang.code);
                                        lang-menu-popup.close();
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: root.language-name;
                    font-family: Tokens.font-ui;
                    font-size: 9.5px;
                    font-weight: 600;
                    color: #b6c2d2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                touch_lang := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { lang-menu-popup.show(); }
                }
                TooltipBubble { text: @tr("界面语言 (点击选择语言)"); is-visible: touch_lang.has-hover; tip-offset-x: -40px; }
            }

            // Group L: Texture theme switch (扁平 / 实体) —— 负责人
            // 2026-11-16 架构定案的用户切换入口: 两主题并存, 运行时切换
            // `Tokens.texture` 即整套令牌换值 (§10 材质 + §11 结构线),
            // 全界面绑定同源 ⇒ 即时、全量生效, 不重启不重编译。与 Group K
            // 同款: Slint 内直接翻全局属性; 初始值仍由 host::apply_texture
            // (CLI --texture) 注入。克制口径: 只一个小开关, 文字即当前态。
            // 注: 本文件全部控件均无 accessible-id (文件惯例), 本钮从之,
            // 身份由可见文字 + tooltip 承担。
            Rectangle {
                width: 40px;
                height: 28px;
                background: Tokens.texture == TextureMode.physical ? Theme.accent.with-alpha(0.18) : #10141d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Tokens.texture == TextureMode.physical ? Theme.accent.with-alpha(0.5) : Theme.border-subtle;

                Text {
                    text: Tokens.texture == TextureMode.physical ? @tr("实体") : @tr("扁平");
                    font-family: Tokens.font-ui;
                    font-size: 9.5px;
                    font-weight: 600;
                    color: Tokens.texture == TextureMode.physical ? Theme.accent : #b6c2d2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                touch_texture := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        Tokens.texture = Tokens.texture == TextureMode.physical ? TextureMode.flat : TextureMode.physical;
                    }
                }
                TooltipBubble { text: Tokens.texture == TextureMode.physical ? @tr("质感主题: 实体 (点击切回扁平)") : @tr("质感主题: 扁平 (点击切换实体)"); is-visible: touch_texture.has-hover; tip-offset-x: -40px; }
            }
        }
    }
}

