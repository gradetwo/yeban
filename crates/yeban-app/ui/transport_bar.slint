// --- 2. Edit Tools ---

component IconToolPointer inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #94a3b8;

    width: 14px;
    height: 12px;

    Path {
        x: 1px;
        y: 0;
        width: 12px;
        height: 12px;
        commands: "M 2 0.5 L 2 11.5 L 5 8.5 L 8 11.5 L 9.5 10 L 6.5 7 L 10 7 Z";
        fill: root.icon-color;
    }
}

component IconToolRange inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #94a3b8;

    width: 14px;
    height: 12px;

    // Left bracket
    Rectangle {
        x: 1.5px;
        y: 1px;
        width: 1.8px;
        height: 10px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 1.5px;
        y: 1px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 1.5px;
        y: 9.5px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }

    // Center span
    Rectangle {
        x: 4.5px;
        y: 5.2px;
        width: 5px;
        height: 1.6px;
        border-radius: 0.5px;
        background: root.icon-color;
    }

    // Right bracket
    Rectangle {
        x: 10.7px;
        y: 1px;
        width: 1.8px;
        height: 10px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 9px;
        y: 1px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
    Rectangle {
        x: 9px;
        y: 9.5px;
        width: 3.5px;
        height: 1.5px;
        border-radius: 0.5px;
        background: root.icon-color;
    }
}

component IconToolSplit inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #94a3b8;

    width: 14px;
    height: 12px;

    Path {
        x: 1px;
        y: 0;
        width: 12px;
        height: 12px;
        commands: "M 2 11 L 10 1 M 6 1 L 11 1 L 11 6 M 3 11 L 1 11 L 1 9";
        stroke: root.icon-color;
        stroke-width: 1.5px;
    }
}

component IconToolDraw inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #94a3b8;

    width: 14px;
    height: 12px;

    Path {
        x: 1px;
        y: 0;
        width: 12px;
        height: 12px;
        commands: "M 1 11 L 1 8 L 8 1 L 11 4 L 4 11 Z";
        stroke: root.icon-color;
        stroke-width: 1.2px;
        fill: root.selected ? root.icon-color : root.icon-color.with-alpha(0.25);
    }
}

// --- 3. Workspace Persona Switchers ---

component IconPersonaDefault inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #94a3b8;

    width: 14px;
    height: 12px;

    // Left Inspector strip
    Rectangle {
        x: 0.5px;
        y: 0.5px;
        width: 3.5px;
        height: 11px;
        border-radius: 1px;
        background: root.icon-color;
    }
    // Top Arranger block
    Rectangle {
        x: 5px;
        y: 0.5px;
        width: 8.5px;
        height: 4.8px;
        border-radius: 1px;
        background: root.icon-color;
    }
    // Bottom Mixer dock
    Rectangle {
        x: 5px;
        y: 6.7px;
        width: 8.5px;
        height: 4.8px;
        border-radius: 1px;
        background: root.icon-color;
    }
}

component IconPersonaPerformance inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #94a3b8;

    width: 14px;
    height: 12px;

    // 6-pad performance matrix (Clip launcher pads)
    Rectangle { x: 0.5px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 5.2px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 9.9px; y: 0.5px; width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 0.5px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 5.2px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
    Rectangle { x: 9.9px; y: 7px;   width: 3.6px; height: 4.5px; border-radius: 1px; background: root.icon-color; }
}

component IconPersonaArranger inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #94a3b8;

    width: 14px;
    height: 12px;

    // Track 1
    Rectangle { x: 0.5px; y: 1px; width: 6.5px; height: 2px; border-radius: 0.5px; background: root.icon-color; }
    Rectangle { x: 8px; y: 1px; width: 5.5px; height: 2px; border-radius: 0.5px; background: root.icon-color.with-alpha(0.65); }

    // Track 2
    Rectangle { x: 1.5px; y: 5px; width: 10px; height: 2px; border-radius: 0.5px; background: root.icon-color; }

    // Track 3
    Rectangle { x: 0.5px; y: 9px; width: 5px; height: 2px; border-radius: 0.5px; background: root.icon-color; }
    Rectangle { x: 6.5px; y: 9px; width: 7px; height: 2px; border-radius: 0.5px; background: root.icon-color.with-alpha(0.65); }

    // Playhead line
    Rectangle {
        x: 6px;
        y: 0;
        width: 1.2px;
        height: 12px;
        background: root.selected ? #ffffff : Theme.accent;
    }
}

component IconPersonaMixer inherits Rectangle {
    in property <bool> selected: false;
    in property <color> icon-color: #94a3b8;

    width: 14px;
    height: 12px;

    // Fader strip 1
    Rectangle { x: 1.8px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 0.5px; y: 3px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }

    // Fader strip 2
    Rectangle { x: 6.4px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 5.1px; y: 7px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }

    // Fader strip 3
    Rectangle { x: 11px; y: 0; width: 1.2px; height: 12px; background: root.icon-color.with-alpha(0.45); }
    Rectangle { x: 9.7px; y: 4px; width: 3.8px; height: 3px; border-radius: 0.5px; background: root.icon-color; }
}

component IconEyeInsight inherits Rectangle {
    in property <bool> active: false;
    in property <color> active-color: Theme.status-warn;

    width: 14px;
    height: 12px;

    Path {
        x: 0;
        y: 0;
        width: 14px;
        height: 12px;
        commands: "M 1 6 Q 7 1, 13 6 Q 7 11, 1 6 Z";
        stroke: root.active-color;
        stroke-width: 1.2px;
        fill: root.active ? root.active-color.with-alpha(0.3) : transparent;
    }
    Rectangle {
        x: 5.5px;
        y: 4.5px;
        width: 3px;
        height: 3px;
        border-radius: 1.5px;
        background: root.active-color;
    }
}

// --- 5. Transport Cluster Vector Icons ---

component IconTransportRewind inherits Rectangle {
    in property <color> icon-color: #cbd5e1;
    width: 13px;
    height: 10px;

    Path {
        x: 0px;
        y: 0px;
        width: 6px;
        height: 10px;
        commands: "M 6 0 L 0 5 L 6 10 Z";
        fill: root.icon-color;
    }
    Path {
        x: 6.5px;
        y: 0px;
        width: 6px;
        height: 10px;
        commands: "M 6 0 L 0 5 L 6 10 Z";
        fill: root.icon-color;
    }
}

component IconTransportStop inherits Rectangle {
    in property <color> icon-color: #cbd5e1;
    width: 9px;
    height: 9px;

    Rectangle {
        width: 9px;
        height: 9px;
        border-radius: 1.5px;
        background: root.icon-color;
    }
}

component IconTransportPlay inherits Rectangle {
    in property <color> icon-color: #10b981;
    width: 10px;
    height: 11px;

    Path {
        x: 0px;
        y: 0px;
        width: 10px;
        height: 11px;
        commands: "M 0 0 L 10 5.5 L 0 11 Z";
        fill: root.icon-color;
    }
}

component IconTransportRecord inherits Rectangle {
    in property <color> icon-color: #ef4444;
    width: 9px;
    height: 9px;

    Rectangle {
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: root.icon-color;
    }
}

component IconTransportLoop inherits Rectangle {
    in property <color> icon-color: #94a3b8;
    width: 12px;
    height: 10px;

    Path {
        x: 0px;
        y: 0px;
        width: 12px;
        height: 10px;
        commands: "M 3 2 A 4 4 0 1 1 1.5 6 L 0 6 L 2.5 9 L 5 6 L 3.5 6 A 2.5 2.5 0 1 0 3.5 3 Z";
        fill: root.icon-color;
    }
}

export component TransportHeaderBar inherits Rectangle {
    in-out property <bool> show-browser: true;
    in-out property <bool> show-clipmatrix: true;
    in-out property <bool> show-lower-dock: true;
    in-out property <bool> show-control-room: true;

    in-out property <string> active-tool: "pointer"; // pointer, range, split, draw
    in-out property <bool> is-playing: false;
    in-out property <bool> is-recording: false;
    in-out property <bool> is-looping: true;
    in-out property <string> timecode-text: "003.02.01";
    in-out property <int> bpm-val: 124;
    in-out property <string> scale-text: "C Minor (自然小调)";
    in-out property <int> buffer-samples: 128;
    in-out property <int> dsp-cpu-percent: 14;

    callback toggle-zone(string);
    callback select-tool(string);
    callback toggle-play();
    callback toggle-rec();
    callback toggle-record();
    callback toggle-loop();
    callback rewind();
    callback change-bpm(int);
    callback change-scale(string);
    callback hot-swap-buffer(int);
    callback select-persona(PersonaMode);
    callback open-cmd-palette();
    callback toggle-hotspots();
    callback revert-to-last-commit();

    height: 48px;
    background: Theme.header-bg;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        // 1. Left Logic 12 Island: Brand & Zone Toggles & Edit Tools (Separated Groups)
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            // Group A: Brand Mark (Official Studio Logo Mark)
            Rectangle {
                background: #10131a;
                border-radius: 4px;
                border-width: 1px;
                border-color: #ffffff25;
                width: 36px;
                height: 28px;

                Image {
                    source: @image-url("../../../assets/brand/png/yeban-dark-64.png");
                    width: 24px;
                    height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                brand_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                TooltipBubble { text: "夜半 DAW (Yeban Studio)"; is-visible: brand_touch.has-hover; }
            }

            // Group B: Zone Visibility Toggles (检查器 [I], Clip 矩阵 [Tab], 底栏 [P/X], 监听室 [F4])
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. 检查器 [I]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-browser ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.show-browser ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconInspectorToggle {
                            active: root.show-browser;
                            active-color: Theme.accent;
                            inactive-color: #94a3b8;
                        }
                        touch_insp := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("browser"); }
                        }
                        TooltipBubble { text: "检查器与音色库 [I]"; is-visible: touch_insp.has-hover; }
                    }

                    // 2. Clip 矩阵 [Tab]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-clipmatrix ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.show-clipmatrix ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconClipMatrixToggle {
                            active: root.show-clipmatrix;
                            active-color: Theme.accent;
                            inactive-color: #94a3b8;
                        }
                        touch_clip := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("clipmatrix"); }
                        }
                        TooltipBubble { text: "Clip 激发矩阵 [Tab]"; is-visible: touch_clip.has-hover; }
                    }

                    // 3. 底栏 [P/X]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-lower-dock ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.show-lower-dock ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconLowerDockToggle {
                            active: root.show-lower-dock;
                            active-color: Theme.accent;
                            inactive-color: #94a3b8;
                        }
                        touch_dock := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("lower"); }
                        }
                        TooltipBubble { text: "统一底栏 (调音台/卷帘) [P / X]"; is-visible: touch_dock.has-hover; }
                    }

                    // 4. 监听室 [F4]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.show-control-room ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.show-control-room ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconControlRoomToggle {
                            active: root.show-control-room;
                            active-color: Theme.accent;
                            inactive-color: #94a3b8;
                        }
                        touch_room := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-zone("right"); }
                        }
                        TooltipBubble { text: "监听控制室与响度计 [F4]"; is-visible: touch_room.has-hover; }
                    }
                }
            }

            // Group C: Edit Tools (选区 [1], 范围 [2], 切分 [3], 画笔 [4])
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 选区 [1]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "pointer" ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "pointer" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolPointer {
                            selected: root.active-tool == "pointer";
                            icon-color: root.active-tool == "pointer" ? Theme.accent : #94a3b8;
                        }
                        touch_ptr := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("pointer"); }
                        }
                        TooltipBubble { text: "指针选区工具: 选择与移动 [1]"; is-visible: touch_ptr.has-hover; }
                    }

                    // 范围 [2]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "range" ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "range" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolRange {
                            selected: root.active-tool == "range";
                            icon-color: root.active-tool == "range" ? Theme.accent : #94a3b8;
                        }
                        touch_rng := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("range"); }
                        }
                        TooltipBubble { text: "时间范围选择工具 [2]"; is-visible: touch_rng.has-hover; }
                    }

                    // 切分 [3]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "split" ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "split" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolSplit {
                            selected: root.active-tool == "split";
                            icon-color: root.active-tool == "split" ? Theme.accent : #94a3b8;
                        }
                        touch_splt := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("split"); }
                        }
                        TooltipBubble { text: "剃刀切分工具 [3]"; is-visible: touch_splt.has-hover; }
                    }

                    // 画笔 [4]
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.active-tool == "draw" ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: root.active-tool == "draw" ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconToolDraw {
                            selected: root.active-tool == "draw";
                            icon-color: root.active-tool == "draw" ? Theme.accent : #94a3b8;
                        }
                        touch_drw := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-tool("draw"); }
                        }
                        TooltipBubble { text: "画笔工具: 绘制音符与自动化 [4 / B]"; is-visible: touch_drw.has-hover; }
                    }
                }
            }
        }

        // 2. Center Logic 12 Island: Unified Transport & Precision Digital LCD (Separated by Spacing)
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            alignment: center;

            // Group D: Cohesive Logic 12 Transport Control Cluster (Unified height, styling, vector iconography, and balanced visual weight)
            Rectangle {
                background: #090c12;
                border-radius: 5px;
                border-width: 1px;
                border-color: #1c2333;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. Rewind / Return to Zero (⏮)
                    btn_rewind := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: btn_rewind_touch.has-hover ? #161e2e : transparent;
                        border-width: btn_rewind_touch.has-hover ? 1px : 0;
                        border-color: #334155;
                        IconTransportRewind {
                            icon-color: btn_rewind_touch.has-hover ? #f8fafc : #cbd5e1;
                        }
                        btn_rewind_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.rewind(); }
                        }
                        TooltipBubble { text: "返回工程起点 / 归零 [Return]"; is-visible: btn_rewind_touch.has-hover; }
                    }

                    // 2. Stop Button (■)
                    btn_stop := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: (!root.is-playing && !root.is-recording) ? #161f30 : (btn_stop_touch.has-hover ? #141b29 : transparent);
                        border-width: (!root.is-playing && !root.is-recording) ? 1px : (btn_stop_touch.has-hover ? 1px : 0);
                        border-color: (!root.is-playing && !root.is-recording) ? #2e3d55 : #253347;
                        IconTransportStop {
                            icon-color: (!root.is-playing && !root.is-recording) ? #f8fafc : (btn_stop_touch.has-hover ? #cbd5e1 : #94a3b8);
                        }
                        btn_stop_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                if root.is-playing { root.toggle-play(); }
                                else if root.is-recording { root.toggle-rec(); }
                                else { root.rewind(); }
                            }
                        }
                        TooltipBubble { text: "停止播放并复位 [Space]"; is-visible: btn_stop_touch.has-hover; }
                    }

                    // 3. Play / Pause Button (▶)
                    btn_play := Rectangle {
                        width: 36px;
                        height: 24px;
                        border-radius: 3px;
                        background: root.is-playing ? #10b981 : (btn_play_touch.has-hover ? #10b981.with-alpha(0.28) : #10b981.with-alpha(0.18));
                        border-width: 1px;
                        border-color: root.is-playing ? #059669 : #10b981.with-alpha(0.45);
                        IconTransportPlay {
                            icon-color: root.is-playing ? #020617 : #10b981;
                        }
                        btn_play_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-play(); }
                        }
                        TooltipBubble { text: "播放 / 暂停走带 [Space]"; is-visible: btn_play_touch.has-hover; }
                    }

                    // 4. Record Arm / Punch-in Button (●)
                    btn_rec := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: root.is-recording ? #ef4444 : (btn_rec_touch.has-hover ? #ef4444.with-alpha(0.28) : #ef4444.with-alpha(0.18));
                        border-width: 1px;
                        border-color: root.is-recording ? #dc2626 : #ef4444.with-alpha(0.45);
                        IconTransportRecord {
                            icon-color: root.is-recording ? #ffffff : #ef4444;
                        }
                        btn_rec_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.toggle-rec();
                                root.toggle-record();
                            }
                        }
                        TooltipBubble { text: "录音准备 / 穿插录音 [R]"; is-visible: btn_rec_touch.has-hover; }
                    }

                    // 5. Loop / Cycle Toggle Button (↻)
                    btn_loop := Rectangle {
                        width: 32px;
                        height: 24px;
                        border-radius: 3px;
                        background: root.is-looping ? Theme.accent.with-alpha(0.22) : (btn_loop_touch.has-hover ? #161e2e : transparent);
                        border-width: root.is-looping ? 1px : (btn_loop_touch.has-hover ? 1px : 0);
                        border-color: root.is-looping ? Theme.accent.with-alpha(0.70) : #334155;
                        IconTransportLoop {
                            icon-color: root.is-looping ? Theme.accent : (btn_loop_touch.has-hover ? #cbd5e1 : #94a3b8);
                        }
                        btn_loop_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-loop(); }
                        }
                        TooltipBubble { text: "选区循环播放开关 [C]"; is-visible: btn_loop_touch.has-hover; }
                    }
                }
            }

            // Group E: Digital Precision LCD HUD Display Bezel (High-contrast WCAG AA)
            Rectangle {
                height: 28px;
                background: #05070a;
                border-radius: 5px;
                border-width: 1px;
                border-color: #1a202c;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    alignment: center;

                    // LCD Bar.Beat.Tick
                    Rectangle {
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "BAR / BEAT";
                                font-family: Tokens.font-mono;
                                font-size: 7.5px;
                                letter-spacing: 0.6px;
                                color: #94a3b8;
                                font-weight: 700;
                            }
                            Text {
                                text: root.timecode-text;
                                font-family: Tokens.font-mono;
                                font-size: 12px;
                                color: Theme.accent;
                                font-weight: 800;
                            }
                        }
                        lcd_beat_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                        TooltipBubble { text: "当前时间码: 小节.拍.分拍"; is-visible: lcd_beat_touch.has-hover; }
                    }

                    Rectangle { width: 1px; height: 16px; background: #ffffff14; }

                    // BPM
                    Rectangle {
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "TEMPO";
                                font-family: Tokens.font-mono;
                                font-size: 7.5px;
                                letter-spacing: 0.6px;
                                color: #94a3b8;
                                font-weight: 700;
                            }
                            Text {
                                text: "" + root.bpm-val + ".00";
                                font-family: Tokens.font-mono;
                                font-size: 12px;
                                color: Theme.track-drum;
                                font-weight: 800;
                            }
                        }
                        bpm_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                let next-bpm = root.bpm-val == 124 ? 128 : (root.bpm-val == 128 ? 140 : 124);
                                root.change-bpm(next-bpm);
                            }
                        }
                        TooltipBubble { text: "工程主速度: 点击循环切换 (124/128/140 BPM)"; is-visible: bpm_touch.has-hover; }
                    }

                    Rectangle { width: 1px; height: 16px; background: #ffffff14; }

                    // Global Scale Key
                    Rectangle {
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: "KEY / SCALE";
                                font-family: Tokens.font-mono;
                                font-size: 7.5px;
                                letter-spacing: 0.6px;
                                color: #94a3b8;
                                font-weight: 700;
                            }
                            Text {
                                text: root.scale-text;
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                color: Theme.status-ok;
                                font-weight: 700;
                            }
                        }
                        scale_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                let next-scale = root.scale-text == "C Minor (自然小调)" ? "D Dorian (多利亚)" : (root.scale-text == "D Dorian (多利亚)" ? "F Major (大调)" : "C Minor (自然小调)");
                                root.change-scale(next-scale);
                            }
                        }
                        TooltipBubble { text: "全局工程调式: 点击循环切换"; is-visible: scale_touch.has-hover; }
                    }
                }
            }
        }

        // 3. Right Logic 12 Island: Audio Engine & Workspace Persona Switcher
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            // Group F: Zero reload buffer switcher (High-contrast labels)
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                height: 28px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "BUFFER:";
                        font-family: Tokens.font-mono;
                        font-size: 8px;
                        letter-spacing: 0.5px;
                        color: #94a3b8;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "" + root.buffer-samples + " smp";
                        font-family: Tokens.font-mono;
                        font-size: 10px;
                        color: Theme.accent;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                buf_touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        if (root.buffer-samples == 64) { root.hot-swap-buffer(128); }
                        else if (root.buffer-samples == 128) { root.hot-swap-buffer(512); }
                        else if (root.buffer-samples == 512) { root.hot-swap-buffer(2048); }
                        else { root.hot-swap-buffer(64); }
                    }
                }
                TooltipBubble { text: "音频缓冲区延迟: 点击热切换 (64/128/512/2048 smp)"; is-visible: buf_touch.has-hover; tip-offset-x: -30px; }
            }

            // Group G: DSP CPU Gauge (High-contrast)
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                width: 78px;
                height: 28px;

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        Text {
                            text: "DSP";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.5px;
                            color: #94a3b8;
                            font-weight: 700;
                        }
                        Text {
                            text: "" + root.dsp-cpu-percent + "%";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            color: Theme.status-ok;
                            font-weight: 800;
                            horizontal-alignment: right;
                        }
                    }
                    Rectangle {
                        height: 3px;
                        background: #080a10;
                        border-radius: 1.5px;
                        Rectangle {
                            x: 0;
                            width: (root.dsp-cpu-percent * 62px) / 100;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.status-ok;
                        }
                    }
                }
                dsp_touch := TouchArea { mouse-cursor: MouseCursor.pointer; }
                TooltipBubble { text: "实时音频 DSP CPU 负荷率"; is-visible: dsp_touch.has-hover; tip-offset-x: -20px; }
            }

            // Group H: Workspace Persona Switcher (默认 / 演出 / 编曲 / 混音)
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff14;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    alignment: center;

                    // 1. 默认全景 (Default Production)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.YebanDefault ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.YebanDefault ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconPersonaDefault {
                            selected: Theme.persona == PersonaMode.YebanDefault;
                            icon-color: Theme.persona == PersonaMode.YebanDefault ? Theme.accent : #94a3b8;
                        }
                        touch_p_def := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.YebanDefault); }
                        }
                        TooltipBubble { text: "默认工作区"; is-visible: touch_p_def.has-hover; tip-offset-x: -20px; }
                    }

                    // 2. 现场演出 (Clip Matrix Performance Flow)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.AbletonLive ? #2d2014 : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.AbletonLive ? 1px : 0;
                        border-color: Theme.track-drum.with-alpha(0.6);
                        IconPersonaPerformance {
                            selected: Theme.persona == PersonaMode.AbletonLive;
                            icon-color: Theme.persona == PersonaMode.AbletonLive ? Theme.track-drum : #94a3b8;
                        }
                        touch_p_live := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.AbletonLive); }
                        }
                        TooltipBubble { text: "现场演出模式 (Clip 流)"; is-visible: touch_p_live.has-hover; tip-offset-x: -20px; }
                    }

                    // 3. 线性编曲 (Arrange Flow)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.LogicPro ? #132636 : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.LogicPro ? 1px : 0;
                        border-color: Theme.accent.with-alpha(0.6);
                        IconPersonaArranger {
                            selected: Theme.persona == PersonaMode.LogicPro;
                            icon-color: Theme.persona == PersonaMode.LogicPro ? Theme.accent : #94a3b8;
                        }
                        touch_p_log := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.LogicPro); }
                        }
                        TooltipBubble { text: "线性编曲模式 (时间轴流)"; is-visible: touch_p_log.has-hover; tip-offset-x: -20px; }
                    }

                    // 4. 混音控制台 (Mix & Master)
                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: Theme.persona == PersonaMode.CubasePro ? #162620 : transparent;
                        border-radius: 3px;
                        border-width: Theme.persona == PersonaMode.CubasePro ? 1px : 0;
                        border-color: Theme.track-vocal.with-alpha(0.6);
                        IconPersonaMixer {
                            selected: Theme.persona == PersonaMode.CubasePro;
                            icon-color: Theme.persona == PersonaMode.CubasePro ? Theme.track-vocal : #94a3b8;
                        }
                        touch_p_cu := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-persona(PersonaMode.CubasePro); }
                        }
                        TooltipBubble { text: "混音母带模式 (调音台流)"; is-visible: touch_p_cu.has-hover; tip-offset-x: -20px; }
                    }
                }
            }

            // Group I: Command palette button
            Rectangle {
                width: 34px;
                height: 28px;
                background: #10141d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;
                Text {
                    text: "⌘K";
                    font-family: Tokens.font-mono;
                    font-size: 10px;
                    font-weight: 800;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                touch_cmd := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-cmd-palette(); }
                }
                TooltipBubble { text: "快捷命令面板 [⌘K]"; is-visible: touch_cmd.has-hover; tip-offset-x: -30px; }
            }

            // Group J: Architecture insights toggle
            Rectangle {
                width: 28px;
                height: 28px;
                background: Theme.status-warn.with-alpha(0.18);
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.status-warn.with-alpha(0.35);
                IconEyeInsight {
                    active: false;
                    active-color: Theme.status-warn;
                }
                touch_spot := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.toggle-hotspots(); }
                }
                TooltipBubble { text: "架构透视与热区诊断 [H]"; is-visible: touch_spot.has-hover; tip-offset-x: -40px; }
            }
        }
    }
}

