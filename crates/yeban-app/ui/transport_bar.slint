import { Theme, PersonaMode, Tokens } from "tokens.slint";

export component TransportHeaderBar inherits Rectangle {
    in-out property <bool> show-browser: true;
    in-out property <bool> show-clipmatrix: true;
    in-out property <bool> show-lower-dock: true;
    in-out property <bool> show-control-room: true;

    in-out property <string> active-tool: "pointer"; // pointer, range, split, draw
    in-out property <bool> is-playing: false;
    in-out property <bool> is-recording: false;
    in-out property <bool> is-looping: true;
    in-out property <string> timecode-text: "003.02.01";
    in-out property <int> bpm-val: 124;
    in-out property <string> scale-text: "C Minor (自然小调)";
    in-out property <int> buffer-samples: 128;
    in-out property <int> dsp-cpu-percent: 14;

    callback toggle-zone(string);
    callback select-tool(string);
    callback toggle-play();
    callback toggle-rec();
    callback toggle-loop();
    callback rewind();
    callback change-bpm(int);
    callback change-scale(string);
    callback hot-swap-buffer(int);
    callback select-persona(PersonaMode);
    callback open-cmd-palette();
    callback toggle-hotspots();

    height: 48px;
    background: Theme.header-bg;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        // 1. Brand Mark & Zone Toggles & Edit Tools
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            // Brand Mark: 夜半 Studio
            Rectangle {
                background: #10131a;
                border-radius: 4px;
                border-width: 1px;
                border-color: #ffffff18;
                height: 28px;

                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 7px;
                    alignment: center;

                    // Studio emblem badge
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 3px;
                        background: Theme.accent.with-alpha(0.18);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.45);
                        Text {
                            text: "夜";
                            font-family: Tokens.font-ui;
                            font-size: 9px;
                            font-weight: 800;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "夜半";
                        font-family: Tokens.font-ui;
                        font-size: 11px;
                        font-weight: 700;
                        color: #f1f5f9;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 1px;
                        height: 10px;
                        background: #ffffff1f;
                    }

                    Text {
                        text: "PRO";
                        font-family: Tokens.font-mono;
                        font-size: 8px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
            }

            // Zone visibility toggles
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff12;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    Rectangle {
                        background: root.show-browser ? Theme.accent.with-alpha(0.18) : transparent;
                        border-radius: 3px;
                        border-width: root.show-browser ? 1px : 0;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: "◧ 检查器 [I]";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                color: root.show-browser ? Theme.accent : #94a3b8;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.toggle-zone("browser"); } }
                    }

                    Rectangle {
                        background: root.show-clipmatrix ? Theme.accent.with-alpha(0.18) : transparent;
                        border-radius: 3px;
                        border-width: root.show-clipmatrix ? 1px : 0;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: "⊞ Clip [Tab]";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                color: root.show-clipmatrix ? Theme.accent : #94a3b8;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.toggle-zone("clipmatrix"); } }
                    }

                    Rectangle {
                        background: root.show-lower-dock ? Theme.accent.with-alpha(0.18) : transparent;
                        border-radius: 3px;
                        border-width: root.show-lower-dock ? 1px : 0;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: "⬓ 底栏 [F3]";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                color: root.show-lower-dock ? Theme.accent : #94a3b8;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.toggle-zone("lower"); } }
                    }

                    Rectangle {
                        background: root.show-control-room ? Theme.accent.with-alpha(0.18) : transparent;
                        border-radius: 3px;
                        border-width: root.show-control-room ? 1px : 0;
                        border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: "◨ 监听 [F4]";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                color: root.show-control-room ? Theme.accent : #94a3b8;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.toggle-zone("right"); } }
                    }
                }
            }

            // Edit Tools
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff12;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    Rectangle {
                        background: root.active-tool == "pointer" ? Theme.accent : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "选区";
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                color: root.active-tool == "pointer" ? #020617 : #94a3b8;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-tool("pointer"); } }
                    }

                    Rectangle {
                        background: root.active-tool == "range" ? Theme.accent : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "范围";
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                color: root.active-tool == "range" ? #020617 : #94a3b8;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-tool("range"); } }
                    }

                    Rectangle {
                        background: root.active-tool == "split" ? Theme.accent : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "切分";
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                color: root.active-tool == "split" ? #020617 : #94a3b8;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-tool("split"); } }
                    }

                    Rectangle {
                        background: root.active-tool == "draw" ? Theme.accent : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: "画笔";
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                color: root.active-tool == "draw" ? #020617 : #94a3b8;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-tool("draw"); } }
                    }
                }
            }
        }

        // 2. Transport Center Controls + Digital LCD Precision HUD
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            alignment: center;

            // Physical Hardware Transport Buttons
            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                // Rewind
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 4px;
                    background: #10141d;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    Text {
                        text: "|◀";
                        font-family: Tokens.font-mono;
                        font-size: 10px;
                        font-weight: 700;
                        color: #cbd5e1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.rewind(); } }
                }

                // Play / Stop
                Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: root.is-playing ? Theme.status-ok : Theme.status-ok.with-alpha(0.18);
                    border-width: 1px;
                    border-color: root.is-playing ? Theme.status-ok : Theme.status-ok.with-alpha(0.40);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.is-playing ? "■ 停止" : "▶ 播放";
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            font-weight: 700;
                            color: root.is-playing ? #020617 : Theme.status-ok;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.toggle-play(); } }
                }

                // Rec
                Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: root.is-recording ? Theme.status-alert : Theme.status-alert.with-alpha(0.18);
                    border-width: 1px;
                    border-color: root.is-recording ? Theme.status-alert : Theme.status-alert.with-alpha(0.40);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "● 录音";
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            font-weight: 700;
                            color: root.is-recording ? #ffffff : Theme.status-alert;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.toggle-rec(); } }
                }

                // Loop
                Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: root.is-looping ? Theme.accent.with-alpha(0.2) : #10141d;
                    border-width: 1px;
                    border-color: root.is-looping ? Theme.accent : Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "↻ 循环";
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            font-weight: 600;
                            color: root.is-looping ? Theme.accent : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { root.toggle-loop(); } }
                }
            }

            // Digital Precision LCD HUD Display Bezel (Height: 28px aligned)
            Rectangle {
                height: 28px;
                background: #05070a;
                border-radius: 5px;
                border-width: 1px;
                border-color: #1a202c;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    alignment: center;

                    // LCD Bar.Beat.Tick
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: "TIME";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.8px;
                            color: #64748b;
                            font-weight: 700;
                        }
                        Text {
                            text: root.timecode-text;
                            font-family: Tokens.font-mono;
                            font-size: 12px;
                            color: Theme.accent;
                            font-weight: 800;
                        }
                    }

                    Rectangle { width: 1px; height: 16px; background: #ffffff14; }

                    // BPM
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: "BPM";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.8px;
                            color: #64748b;
                            font-weight: 700;
                        }
                        Text {
                            text: "" + root.bpm-val;
                            font-family: Tokens.font-mono;
                            font-size: 12px;
                            color: Theme.track-drum;
                            font-weight: 800;
                        }
                        TouchArea {
                            clicked => {
                                let next-bpm = root.bpm-val == 124 ? 128 : (root.bpm-val == 128 ? 140 : 124);
                                root.change-bpm(next-bpm);
                            }
                        }
                    }

                    Rectangle { width: 1px; height: 16px; background: #ffffff14; }

                    // Global Scale Key
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: "KEY / SCALE";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.8px;
                            color: #64748b;
                            font-weight: 700;
                        }
                        Text {
                            text: root.scale-text;
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            color: Theme.status-ok;
                            font-weight: 700;
                        }
                        TouchArea {
                            clicked => {
                                let next-scale = root.scale-text == "C Minor (自然小调)" ? "D Dorian (多利亚)" : (root.scale-text == "D Dorian (多利亚)" ? "F Major (大调)" : "C Minor (自然小调)");
                                root.change-scale(next-scale);
                            }
                        }
                    }
                }
            }
        }

        // 3. Audio Engine & Workspace Persona Switcher
        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            // Zero reload buffer switcher
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff12;
                height: 28px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: "BUFFER:";
                        font-family: Tokens.font-mono;
                        font-size: 8px;
                        letter-spacing: 0.5px;
                        color: #64748b;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "" + root.buffer-samples + " smp";
                        font-family: Tokens.font-mono;
                        font-size: 10px;
                        color: Theme.accent;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => {
                        if (root.buffer-samples == 64) { root.hot-swap-buffer(128); }
                        else if (root.buffer-samples == 128) { root.hot-swap-buffer(512); }
                        else if (root.buffer-samples == 512) { root.hot-swap-buffer(2048); }
                        else { root.hot-swap-buffer(64); }
                    }
                }
            }

            // DSP CPU Gauge
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff12;
                width: 76px;
                height: 28px;

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        Text {
                            text: "DSP";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.5px;
                            color: #64748b;
                            font-weight: 700;
                        }
                        Text {
                            text: "" + root.dsp-cpu-percent + "%";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            color: Theme.status-ok;
                            font-weight: 800;
                            horizontal-alignment: right;
                        }
                    }
                    Rectangle {
                        height: 3px;
                        background: #080a10;
                        border-radius: 1.5px;
                        Rectangle {
                            x: 0;
                            width: (root.dsp-cpu-percent * 60px) / 100;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.status-ok;
                        }
                    }
                }
            }

            // Workspace Persona Switcher (Professional studio workflows)
            Rectangle {
                background: #0a0d14;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #ffffff12;
                height: 28px;

                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;

                    // 1. 默认全景 (Default Production Studio)
                    Rectangle {
                        background: Theme.persona == PersonaMode.YebanDefault ? Theme.accent : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "默认";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.persona == PersonaMode.YebanDefault ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-persona(PersonaMode.YebanDefault); } }
                    }

                    // 2. 现场演出 (Clip Matrix Performance Flow)
                    Rectangle {
                        background: Theme.persona == PersonaMode.AbletonLive ? Theme.track-drum : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "演出";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.persona == PersonaMode.AbletonLive ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-persona(PersonaMode.AbletonLive); } }
                    }

                    // 3. 线性编曲 (Arrange Flow)
                    Rectangle {
                        background: Theme.persona == PersonaMode.LogicPro ? Theme.accent : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "编曲";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.persona == PersonaMode.LogicPro ? #ffffff : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-persona(PersonaMode.LogicPro); } }
                    }

                    // 4. 混音控制台 (Mix & Master Studio)
                    Rectangle {
                        background: Theme.persona == PersonaMode.CubasePro ? Theme.track-vocal : transparent;
                        border-radius: 3px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "混音";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.persona == PersonaMode.CubasePro ? #020617 : #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.select-persona(PersonaMode.CubasePro); } }
                    }
                }
            }

            // Command palette button
            Rectangle {
                width: 34px;
                height: 28px;
                background: #10141d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;
                Text {
                    text: "⌘K";
                    font-family: Tokens.font-mono;
                    font-size: 10px;
                    font-weight: 800;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.open-cmd-palette(); } }
            }

            // Architecture insights toggle
            Rectangle {
                height: 28px;
                background: Theme.status-warn.with-alpha(0.18);
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.status-warn.with-alpha(0.35);
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    Text {
                        text: "透视";
                        font-family: Tokens.font-ui;
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.status-warn;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                TouchArea { clicked => { root.toggle-hotspots(); } }
            }
        }
    }
}
