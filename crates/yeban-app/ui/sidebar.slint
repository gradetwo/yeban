// 夜半 (Yeban) — 左侧资源栏 / 浏览器 (240px, 折叠态 36px 图标导轨)
//
// 规范来源 (Normative):
//   - [UI-GRID-001] UI/UX 规范 §1.1: LEFT BROWSER & ASSET LIBRARY (240px) ——
//     乐器 / 采样 / 预置模板 / 折叠展开
//   - [UI-GRID-002] §1.2: 1366–1919 断点把左侧收成 36px 图标导轨
//   - [UI-GRID-002] §1.2: 左抽屉展开/收起快捷键 Cmd/Ctrl + Alt + B (映射在 src/input.rs)
//   - [UI-TEST-001] §12.2: `tab-{name}-button` 是**控制台标签**专用族, 因此这里的
//     分类标签用 `sidebar-category-{i}-button`, 不污染 `tab-` 前缀 (elements.rs 的
//     覆盖判据就是靠这个前缀成立的)。
//
// 数据流方向: 只读 + 通知，**一个例外** —— 搜索框里的字（`search-text` ↔
// `MainWindow.sidebar-search`）是可编辑的视图态，但它⛔ 不改工程、⛔ 不进撤销栈，
// 与折叠态同一档。折叠状态住在 app.slint 的 MainWindow。
//
// ⭐ 条目数组**不再是演示数据**（旧版在这里内联 8 个乐器名，含 "SFZ · 323 款采样预置"
// —— 一个仓库里并不存在的数字）。它由宿主按**当前分类**注入，三个来源逐字是：
//
// | 分类 | 来源 | 空的时候画什么 |
// | :--- | :--- | :--- |
// | 0 乐器 | `bridge::library_instrument_names()`（`assets/manifest.json` × 采样库根扫描，⛔ 不读样本） | 空态 + 宿主注入的理由 |
// | 1 采样 | `ViewState::asset_pool_names()`（工程素材池的投影） | "尚无素材"（新建工程就是这一档） |
// | 2 预置 | **模型里没有预置载体**（`yeban-model` 无 preset 实体、`Op` 无对应变体） | 空态 + 如实登记的缺口 |
//
// ⚠ 空态**不是**"什么都不画"：一个只写着理由的文本节点（`sidebar-empty`）。
// 把"这一类今天没有可用条目"说成缺失的 UI，比编造 8 条名字诚实得多。
//
// ⭐ D-UI-14 起，那张表是**过滤前**的来源：宿主在注入前再过一道
// `bridge::filter_sidebar_content(那份投影, 搜索框的字)`。于是"空态"有两种，理由必须分开：
// 本类一条都没有（沿用表里那个理由）vs 本类有 N 条但都不匹配「query」（新的理由，带条数）。

import { Tokens, UiText, UiMonoText, UiTitleText } from "tokens.slint";

export component Sidebar inherits Rectangle {
    in property <bool> compact: false;
    in property <string> search-hint: "搜索乐器 / 采样 / 预置";
    // ⭐ 当前分类的条目显示名。默认**空** ⇒ 这一层不再内联任何演示数据；
    // 唯一写者 = 宿主（`host::inject_sidebar`，三个调用点：`host::apply_view` 装配期注入、
    // `select-sidebar-category` 换分类重注入、`sidebar-search-changed` 换搜索词重注入），
    // 数组内容与 `MainWindow.sidebar-category` / `MainWindow.sidebar-search` **同源**。
    in property <[string]> items: [];

    // ⭐ `items` 为空时画出来的**理由**（同样由宿主按分类注入：乐器 = 采样库没下载，
    // 采样 = 工程素材池为空，预置 = 模型没有预置载体）。⛔ 不是占位文案。
    in property <string> empty-reason: "";

    // ⭐ 当前激活的资源分类（0 = 乐器 / 1 = 采样 / 2 = 预置）。
    // 唯一写者 = `app.slint` 的 MainWindow（宿主 `host::wire_sidebar_contents` 把它钳到
    // 合法区间后写回）⇒ 界面**不自己**翻转选中态。⛔ 不是工程数据（`MODEL-ISO-001`
    // 的挥发性层）、不进 `.yeban`、不进撤销栈。
    in property <int> active-category: 0;

    // ⭐ 当前选中的资源条目（合法区间 = **注入的那一份** `items` 的长度 —— 分类 ∩ 搜索词，
    // 宿主按它钳位）。与 `active-category` 同一档：唯一写者 = 宿主钳位后写
    // `MainWindow.sidebar-item`，纯视图态（⛔ 不进 `.yeban`、⛔ 不进撤销栈、⛔ 不改工程）。
    // ⚠ 条目集合一变（换分类 / 换搜索词）⇒ 宿主在重注入数组的**同一次**里将选中态落回
    // 合法值；界面**不**自己钳（那会与宿主分叉）。
    in property <int> active-item: 0;

    // ⭐ 搜索框里的**字**（D-UI-14）。两向绑定到 `MainWindow.sidebar-search`：
    // 界面这一层只承载"用户敲进去的串"，⛔ 不做任何匹配 —— Slint 1.18.1 的字符串内置集
    // 里没有 `contains`，也没有字符串版 `index-of`（实测 `i-slint-compiler-1.18.1/lookup.rs`
    // 的内置表只有 `is-float / to-float / is-empty / character-count / to-lowercase /
    // to-uppercase / starts-with / ends-with / replace-all`；数组的 `index-of / any / all /
    // find-index` 在 experimental 开关后面）。子串匹配只有一处，在 Rust：
    // `bridge::filter_sidebar_content`（宿主 `sidebar-search-changed` 调它）。
    in-out property <string> search-text: "";

    callback toggle-collapse();
    /// 点击分类标签 ⇒ 请求切到该分类；落点 = 宿主钳位后写 `MainWindow.sidebar-category`。
    callback select-category(int);
    /// 点击资源条目 ⇒ 请求选中它；落点 = 宿主钳位后写 `MainWindow.sidebar-item`。
    callback select-item(int);
    /// 搜索框**每敲一个字**报一次当前整串；落点 = 宿主重算投影并重注入条目数组。
    /// ⛔ 界面不自己过滤（见上面 `search-text` 的内置函数实测清单）。
    callback search-changed(string);
    // ⚠ **本框不接** `[UI-A11Y-002]` §7.2 那条输入法通道（`ime-composition-changed` /
    // `ime-focus-changed`），这是**登记过的边界**而不是遗漏：全仓库只有 `transport.slint`
    // 的 `bpm-input` 接了它，而宿主的 `wire_input` 把"失焦"硬编码为**回到画布**
    // （`src/host.rs` 里那条注释原话："将来有第二个敲入控件时，这里必须改成问焦点系统
    // 当前焦点是谁"）。在改好那一格之前接第二路，两个 `changed has-focus` 的**先后顺序**
    // 没有上游保证 ⇒ `InputContext` 会随点击次序落进错误状态（比"没接"更糟）。
    // 导出弹窗的 4 个输入框同样未接（实测 `ui/dialogs/export_wav_dialog.slint`）⇒ 本框
    // 与仓库现状一致。搜索这一格用不到它：过滤器的输入是 `text`，而候选词住在**另一个**
    // 属性 `preedit-text`（`i-slint-compiler-1.18.1/builtin_elements.rs:2323`）⇒ 被送进
    // `filter_sidebar_content` 的永远是已经落定的那一份字。⚠ "合成期间 `text` 一次也不被写"
    // 本机**没有**实测（无输入法可注入），故本票不把它当判据、也不依赖它才能工作。

    // ---------------------------------------------------------------- 键盘入口（D-UI-18）
    /// 把**键盘焦点**交给搜索框。焦点是 Slint 自己的状态，⛔ 不是属性 ⇒ 宿主只能
    /// **命令**它（与 `app.slint` 的 `focus-undo-tree-trap` / `focus-shortcut-layer`
    /// 同一机制：`public function` + 宿主 `ui.invoke_*`，⛔ 不新增第二份真相源）。
    /// 唯一调用者 = `host::apply_action` 的 `Action::FocusSidebarSearch` 臂
    /// （键位 `Cmd/Ctrl+F`）。
    public function focus-search() {
        sidebar-search-input.focus();
    }

    /// 上面那次取焦的**读数**：Slint 的焦点不在控件树里，因此镜像成属性
    /// （与 `app.slint: shortcut-layer-focused` 同款；唯一读者 = 宿主与无头判据）。
    /// 宿主拿它决定这一键**消费还是放行**：窄栏 / 折叠时 `sidebar-search-input`
    /// 是 `visible: false` 的，取焦落不下去 ⇒ 读数 `false` ⇒ ⛔ 不假装成功。
    out property <bool> search-has-focus: sidebar-search-input.has-focus;

    background: Tokens.bg-panel;
    border-width: 1px;
    border-color: Tokens.line;
    clip: true;

    accessible-role: complementary;
    accessible-id: "sidebar";
    accessible-label: "左侧资源浏览器与资产库";

    // ---------------------------------------------------------------- 标题行
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 32px;
        background: Tokens.bg-panel-alt;

        UiTitleText {
            x: Tokens.space-4;
            y: 0;
            width: parent.width - 40px;
            height: parent.height;
            text: "资源库";
            color: Tokens.gold;
            font-size: Tokens.font-size-md;
            visible: !root.compact;
        }

        // 折叠 / 展开
        Rectangle {
            x: root.width - 30px;
            y: 5px;
            width: 22px;
            height: 22px;
            background: collapse_area.pressed ? Tokens.bg-raised : Tokens.bg-panel;
            border-radius: Tokens.radius-sm;
            accessible-role: button;
            accessible-id: "sidebar-collapse-button";
            accessible-label: root.compact ? "展开左侧资源栏" : "收起左侧资源栏";
            accessible-expandable: true;
            accessible-expanded: !root.compact;
            // `[UI-A11Y-003]` §7.3：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
            accessible-action-default => { root.toggle-collapse(); }

            UiText {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.compact ? "»" : "«";
                color: Tokens.ink-1;
                font-size: Tokens.font-size-md;
                horizontal-alignment: center;
            }

            collapse_area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.toggle-collapse(); }
            }
        }
    }

    // ---------------------------------------------------------------- 搜索框
    // ⭐ D-UI-14：这一格**从前是假的** —— 一个 `role=text-input` 的占位矩形里放一句静态
    // `UiText`，敲进去什么都不动（与 `transport.slint:239` 记录的"上一版只有占位矩形……
    // 合成事件根本没有源"同型）。现在是**真的** `TextInput`：
    //   * 语义节点挂在 `TextInput` 自己上（外层矩形只做皮肤）⇒ 运行时树里该 id 仍然
    //     **恰好一个**节点（`tests/pane_no_overlap.rs` 的 `sidebar_controls` 按"恰好一个"
    //     计数，`tests/compact_follows_window_width.rs` 按 `!compact` 判在场性）；
    //   * 提示文案还是原来那个 `UiText`，⛔ 不换成 `TextInput.placeholder-text`：换上去
    //     字体/颜色/落点都会挪，默认帧的像素跟着搬家 ⇒ `tests/golden/**` 五张基准整批
    //     重录。它只在**框里没字**时在场，因此空框那一帧逐位不变；
    //   * 匹配⛔ 不在这里：见上面 `search-text` 处抄录的 Slint 1.18.1 内置函数实测清单
    //     （没有 `contains`）。这里只把字交给宿主那一个入口。
    Rectangle {
        x: Tokens.space-4;
        y: 40px;
        width: parent.width - 8px;
        height: 24px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-sm;
        border-width: 1px;
        border-color: Tokens.line-strong;
        visible: !root.compact;

        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: root.search-hint;
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            visible: root.search-text == "";
        }

        // 编辑面。⚠ `text` 必须**双向**（`[PATCH export-wav-dialog-binding]` 那条教训：
        // 单向绑定会被用户第一次按键打断，从此输入框与宿主各说各话）。
        sidebar-search-input := TextInput {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 8px - Tokens.space-3;
            height: parent.height;
            text <=> root.search-text;
            single-line: true;
            read-only: false;
            font-family: Tokens.font-ui;
            color: Tokens.ink-1;
            font-size: Tokens.font-size-xs;
            vertical-alignment: center;
            // ⛔ 折叠断点下这个节点必须**离场**（不是"隐身"）：在场性 == `!compact`
            // 由 `tests/pane_no_overlap.rs` 与 `tests/compact_follows_window_width.rs`
            // 两处判据钉住。Slint 的 a11y 树按**父链可见性**裁剪，但本节点自己声明一次
            // 才算把前提写死（⛔ 不依赖"父矩形会替我挡"）。
            visible: !root.compact;
            accessible-role: text-input;
            accessible-id: "sidebar-search-field";
            accessible-label: "搜索资源";
            accessible-placeholder-text: root.search-hint;
            accessible-value: root.search-text;
            accessible-read-only: false;

            // 每敲一个字报一次整串 ⇒ 宿主重算投影（过滤的唯一一处是
            // `bridge::filter_sidebar_content`）。落点⛔ 不是写回本属性：那会与
            // `text <=> root.search-text` 这条绑定互为回路。
            changed text => {
                root.search-changed(self.text);
            }
        }
    }

    // ---------------------------------------------------------------- 分类标签
    // 三类资源: 乐器 / 采样 / 预置模板 (规范 §1.1 的左栏四行)
    for category_index in 3 : Rectangle {
        x: Tokens.space-4 + 64px * category_index;
        y: 72px;
        width: 60px;
        height: 20px;
        background: category_index == root.active-category ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-sm;
        visible: !root.compact;
        accessible-role: tab;
        accessible-id: "sidebar-category-" + category_index + "-button";
        // 分类名，⛔ 不是序号：屏读器念"资源分类 0"等于没说；与 `elements.rs` 注册表逐字一致。
        accessible-label: "资源分类 " + (category_index == 0 ? "乐器" : (category_index == 1 ? "采样" : "预置"));
        accessible-item-index: category_index;
        accessible-item-count: 3;
        accessible-item-selectable: true;
        accessible-item-selected: category_index == root.active-category;
        // `[UI-A11Y-003]` §7.3 第 4 条 ①：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
        accessible-action-default => { root.select-category(category_index); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: category_index == 0 ? "乐器" : (category_index == 1 ? "采样" : "预置");
            color: category_index == root.active-category ? Tokens.selection : Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.select-category(category_index); }
        }
    }

    // ---------------------------------------------------------------- 空态
    // 0 条是**合法的**当前状态（无头/CI 里采样库没下载 ⇒ 乐器一类就是 0 条；
    // 新建工程的素材池也是 0 条；预置一类压根没有模型载体）。
    // 与下面的行循环由**同一份**长度互斥，且这里画的是宿主给的**理由**而不是空白。
    Rectangle {
        x: Tokens.space-4;
        y: 100px;
        width: parent.width - 8px;
        height: 44px;
        visible: !root.compact && root.items.length == 0;
        accessible-role: text;
        accessible-id: "sidebar-empty";
        accessible-label: root.empty-reason;

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.empty-reason;
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            wrap: word-wrap;
            overflow: elide;
        }
    }

    // ---------------------------------------------------------------- 资源条目
    // 行数**由注入的数组决定**（`for item_text[item_index] in root.items`），
    // ⛔ 不是写死的 8 条 —— 旧版在这里画 8 行编造的名字，而其中
    // "SFZ · 323 款采样预置" 这个数字在仓库里根本没有出处。
    for item_text[item_index] in root.items : Rectangle {
        x: Tokens.space-4;
        y: 100px + 28px * item_index;
        width: parent.width - 8px;
        height: 24px;
        background: item_index == root.active-item ? Tokens.bg-panel-alt : Tokens.bg-panel;
        border-radius: Tokens.radius-sm;
        clip: true;
        accessible-role: list-item;
        accessible-id: "sidebar-item-" + item_index;
        // ⚠ 折叠态**不再**把标签置空（`[UI-A11Y-003]` §7.3 第 4 条 ①：交互控件的
        // 无障碍名称不得为空）。折叠是**视觉**选择（只画 24px 图标位，见下面两个
        // `visible`），而屏读器在任何断点下都需要念得出这一条是什么。
        accessible-label: item_text;
        accessible-item-index: item_index;
        accessible-item-count: root.items.length;
        accessible-item-selectable: true;
        accessible-item-selected: item_index == root.active-item;
        // `[UI-A11Y-003]` §7.3 第 4 条 ①：无障碍动作，落点与下面 `TouchArea` 的 `clicked` 逐字相同。
        accessible-action-default => { root.select-item(item_index); }

        // 折叠态只画一个 24px 的图标位, 不画文字
        UiText {
            x: Tokens.space-3;
            y: 0;
            width: parent.width - 12px;
            height: parent.height;
            text: item_text;
            color: item_index == root.active-item ? Tokens.selection : Tokens.ink-1;
            font-size: Tokens.font-size-xs;
            overflow: elide;
            visible: !root.compact;
        }

        UiMonoText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "" + item_index;
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
            horizontal-alignment: center;
            visible: root.compact;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.select-item(item_index); }
        }
    }
}
