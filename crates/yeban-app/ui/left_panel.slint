import { Theme, BrowserItemData, Tokens, TooltipBubble, ImeAwareTextInput } from "tokens.slint";

// 检查器分组标题（Logic Pro 13 的检查器按**作用域**分组：Region / Track / Channel strip）
// 一行里只有三样东西：色标、分组名、折叠箭头 —— 分组本身要能一眼扫过，不做装饰。
component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> meta: "";
    in property <bool> open: true;
    callback toggle();
    height: 22px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        padding-left: 2px;
        // 右端留出 8px：折叠箭头原本贴着滚动指示条，三角的右侧尖角被压住。
        padding-right: 8px;

        Rectangle {
            width: 2px;
            height: 11px;
            border-radius: 1px;
            background: Theme.accent.with-alpha(0.65);
            y: 5.5px;
        }
        Text {
            text: root.title;
            font-family: Tokens.font-mono;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 0.9px;
            color: Tokens.skin-text-body;
            vertical-alignment: center;
        }
        Text {
            text: root.meta;
            font-family: Tokens.font-ui;
            font-size: 9px;
            color: Tokens.skin-text-dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // 折叠箭头必须**画出来**，不能指望字体（2026-11-19 实测）：`▾` / `▸`
        // 在本机 UI 字体里没有字形，实机渲染成一小块残缺像素 —— 就是检查器里
        // `TRACK` 行右端那个灰点（12× 帧可辨）。分组"能不能折叠"全靠这个记号，
        // 于是一整排分组头都没法读 ⇒ 改成三角 Path（与走带按钮同一门手艺）。
        // 展开 = 朝下的三角，折叠 = 朝右的三角，都在 7×7 视图里画。
        // ⚠ Path 必须裹在定尺寸盒里：直接放进 HorizontalLayout 会被纵向拉满
        // 22px 行高，三角被拉成尖长的箭头（实机第一版就是这样）。
        Rectangle {
            width: 7px;
            height: 7px;
            Path {
                width: 7px;
                height: 7px;
                commands: root.open ? "M 0 1.5 L 7 1.5 L 3.5 5.5 Z" : "M 1.5 0 L 5.5 3.5 L 1.5 7 Z";
                fill: Tokens.skin-text-dim;
            }
        }
    }
    header_touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggle(); }
    }
}

export component ZoneBrowserAndInspector inherits Rectangle {
    in-out property <string> active-tab: "inspector"; // "inspector" | "browser"
    in-out property <int> selected-track-id: 3;
    in-out property <color> selected-track-color: Theme.track-synth;
    in-out property <string> selected-track-name: "01. Lead Neuro Bass";
    in-out property <string> selected-track-badge: "TRK 01 · SYNTH";
    in-out property <string> selected-track-bus: "Bus 1 (Synth Grp)";
    in-out property <string> selected-track-pan: "C";
    // 真实 EQ 频响：MainWindow.eq-curve-svg 由 bridge::calculate_eq_curve_svg
    // 按当前轨道参量均衡参数算好并注入（与 device_rack 卡片同一路）。
    in property <string> eq-curve-svg: "M 0 50 L 420 50";
    // BUS COMP 真实压缩传递曲线（空串 = 无压缩器 ⇒ 保持「示意」）。
    in property <string> comp-curve-svg: "";
    in property <float> selected-track-pan-value: 0.0;
    in-out property <float> selected-track-vol: -2.5;
    in property <string> selected-track-vol-display: "";
    in-out property <float> selected-track-peak: 0.65;
    in-out property <[string]> selected-track-inserts: [];

    in-out property <string> bus-name: "Bus 1 · Synth";
    in-out property <float> bus-track-vol: -1.0;
    in-out property <float> bus-pan-norm: 0.0;
    in-out property <float> bus-track-peak: 0.55;
    private property <bool> bus-dragging: false;
    private property <length> bus-drag-start-y: 0px;
    private property <float> bus-drag-start-db: -1.0;
    private property <bool> bus-pan-dragging: false;
    private property <length> bus-pan-start-x: 0px;
    private property <float> bus-pan-start-norm: 0.0;
    in-out property <[string]> bus-inserts: ["Tape Saturator", "Vintage Verb", @tr("+ 添加总线效果")];
    in-out property <bool> show-bus-strip: false; // 默认折叠总线通道条，收缩至专注单轨检查器

    // ---- 片段级（Region）只读摘要 -------------------------------------------------
    // Logic 13 的检查器把参数按作用域分成三组，第一组就是"选中片段"。
    // 这里只做**只读投影**：有选中片段时显示名字与位置，没有时说清楚是没有 ——
    // 不摆一排不可用的旋钮（那正是信息过载的来源）。
    in-out property <bool> has-region: false;
    in-out property <string> region-title: "";
    in-out property <string> region-detail: "";
    in-out property <int> region-count: 1;

    // 三组折叠状态（默认全开；折叠只影响本组，互不牵连）
    in-out property <bool> show-group-region: true;
    in-out property <bool> show-group-track: true;
    in-out property <bool> show-group-channel: true;

    in-out property <string> search-query: "";
    // 分组：all | instrument | sample | preset | effect
    // （对齐 Logic Pro 13 的"统一浏览器"：采样/乐器/预设/效果链/本机位置都在一个入口里，
    //  不再让"音色库 / 采样池 / 设备机架 / 预设菜单"分散成四个入口。）
    in-out property <string> active-tag: "all";
    // ⛔ 条数是**布局契约**的一部分：左栏可用高度约 640px，search(30) + 分组行(24)
    //    + 条目(46/条) + 位置区(约 90) 必须落在其内，否则 Flickable 的 preferred-height
    //    会反压父布局，把编曲区挤扁（实测 8 条即触发）。示例数据取 5 条，四类各至少一条。
    in-out property <[BrowserItemData]> browser-items: [
        { name: "Wavetable MPE Synth", desc: @tr("双振荡器 3D 波表合成器"), tag: "instrument", format: "Native DSP" },
        { name: "Pro-QLinear 8", desc: @tr("内联实时频谱零延迟动态 EQ"), tag: "effect", format: "CLAP / Native" },
        { name: "Cyberpunk 124BPM Drum Kit", desc: @tr("含 64 个多麦克风分层鼓组"), tag: "sample", format: "Sample Pack" },
        { name: "VCA Glue Bus Compressor", desc: @tr("模拟 SSL 4000G 总线粘合压缩"), tag: "effect", format: "CLAP / Native" },
        { name: "Large Hall Verb", desc: @tr("2.8 秒大房间混响预设"), tag: "preset", format: "FX Preset" }
    ];

    in-out property <bool> show-instrument-menu: false;

    callback switch-tab(string);
    callback normalize-heights();
    callback fader-changed(float);
    callback bus-fader-changed(float);
    callback select-tag(string);
    callback load-item(string);
    callback focus-devices();
    callback track-pan-change(int, float);
    callback track-instrument-change(int, string);
    callback mixer-fader-grab(int, length);
    callback mixer-fader-drag(int, length);
    callback mixer-fader-release(int);
    callback mixer-fader-reset(int);
    callback mixer-pan-grab(int, length);
    callback mixer-pan-drag(int, length);
    callback mixer-pan-release(int);
    callback mixer-pan-reset(int);
    callback search-changed(string);
    callback execute-action(string);

    in-out property <length> panel-width: 256px;
    width: root.panel-width;
    background: Tokens.texture-physical ? Tokens.panel-brush : Theme.bg-panel;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Subtab switcher
        Rectangle {
            height: 34px;
            background: Tokens.texture-physical ? Tokens.shell-brush : Tokens.bg-shell;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding: 3px;
                spacing: 4px;

                Rectangle {
                    background: root.active-tab == "inspector" ? Theme.accent.with-alpha(0.18) : transparent;
                    border-radius: Theme.radius;
                    border-width: root.active-tab == "inspector" ? 1px : 0;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: @tr("通道检查器");
                            font-family: Tokens.font-ui;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.active-tab == "inspector" ? Theme.accent : Tokens.skin-text-dim;
                            vertical-alignment: center;
                        }
                    }
                    tab_insp_touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.active-tab = "inspector";
                            root.switch-tab("inspector");
                        }
                    }
                    TooltipBubble { text: @tr("当前音轨与总线信号链检查器"); is-visible: tab_insp_touch.has-hover; tip-offset-y: 30px; }
                }

                Rectangle {
                    background: root.active-tab == "browser" ? Theme.accent.with-alpha(0.18) : transparent;
                    border-radius: Theme.radius;
                    border-width: root.active-tab == "browser" ? 1px : 0;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: @tr("浏览器");
                            font-family: Tokens.font-ui;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.active-tab == "browser" ? Theme.accent : Tokens.skin-text-dim;
                            vertical-alignment: center;
                        }
                    }
                    tab_brow_touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.active-tab = "browser";
                            root.switch-tab("browser");
                        }
                    }
                    TooltipBubble { text: @tr("浏览器：音色 / 采样 / 预设 / 效果链 / 工程资产，一个入口 [B]"); is-visible: tab_brow_touch.has-hover; tip-offset-y: 30px; }
                }
            }
        }

        // TAB 1: DUAL INSPECTOR
        // ⭐ 外层套一个 host：滚动条要**钉在视口上**（不能跟着内容一起滚），
        //   又在 VerticalLayout 里没法绝对定位，所以用「host 包住 Flickable + 条做兄弟」。
        if root.active-tab == "inspector" : insp_host := Rectangle {
            vertical-stretch: 1;
            min-height: 120px;
            clip: true;

            insp_flick := Flickable {
            width: insp_host.width;
            height: insp_host.height;
            content-width: self.width;
            content-height: Math.max(self.height, insp_body.preferred-height);

            insp_body := VerticalLayout {
                x: 0px;
                y: 0px;
                width: insp_flick.width;
                height: Math.max(insp_flick.height, self.preferred-height);
                padding: 8px;
                spacing: 8px;

            // ── 组 1：片段级参数（Region）────────────────────────────────────
            SectionHeader {
                title: "REGION";
                meta: root.has-region ? (root.region-count > 1 ? @tr("{} 个片段", root.region-count) : @tr("片段级")) : @tr("未选中");
                open: root.show-group-region;
                toggle => { root.show-group-region = !root.show-group-region; }
            }
            if root.show-group-region : Rectangle {
                height: root.has-region ? 52px : 32px;
                background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                if root.has-region : VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: root.region-title;
                        font-family: Tokens.font-ui;
                        font-size: 11px;
                        font-weight: 700;
                        color: Tokens.skin-text-strong;
                        overflow: elide;
                    }
                    Text {
                        text: root.region-detail;
                        font-family: Tokens.font-mono;
                        font-size: 9px;
                        color: Tokens.skin-text-dim;
                        overflow: elide;
                    }
                }
                if !root.has-region : HorizontalLayout {
                    alignment: center;
                    Text {
                        text: @tr("未选中片段 · 在编曲区点一个片段");
                        font-family: Tokens.font-ui;
                        font-size: 9.5px;
                        color: Tokens.skin-text-dim;
                        vertical-alignment: center;
                    }
                }
            }

            // ── 组 2：轨道级参数（Track）────────────────────────────────────
            SectionHeader {
                title: "TRACK";
                meta: root.selected-track-name;
                open: root.show-group-track;
                toggle => { root.show-group-track = !root.show-group-track; }
            }

            // Track Header Card
            if root.show-group-track : Rectangle {
                // 二期质感: 卡面走 §10 面板刷 + 面板落影 (flat = Theme.bg-surface, 落影 alpha 为 0)。
                background: Tokens.texture-physical ? Tokens.panel-brush : Theme.bg-surface;
                drop-shadow-color: Tokens.shadow-color.with-alpha(Tokens.shadow-panel-alpha);
                drop-shadow-offset-x: Tokens.shadow-panel-offset-x;
                drop-shadow-offset-y: Tokens.shadow-panel-offset-y;
                drop-shadow-blur: Tokens.shadow-panel-blur;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;
                height: 76px;

                // Color accent bar on left edge
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 3px;
                    height: parent.height;
                    border-top-left-radius: Theme.radius;
                    border-bottom-left-radius: Theme.radius;
                    background: root.selected-track-color;
                }

                VerticalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.selected-track-badge;
                            font-family: Tokens.font-mono;
                            font-size: 9.5px;
                            font-weight: 400;
                            letter-spacing: 0.6px;
                            color: root.selected-track-color;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: inst_btn_touch.has-hover || root.show-instrument-menu ? Theme.accent.with-alpha(0.28) : Theme.accent.with-alpha(0.14);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.accent.with-alpha(0.55);
                                height: 18px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: @tr("更换音色 [v]");
                                        font-family: Tokens.font-ui;
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        color: Tokens.skin-text-strong;
                                        vertical-alignment: center;
                                    }
                                }
                                inst_btn_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.show-instrument-menu = !root.show-instrument-menu; }
                                }
                                TooltipBubble { text: @tr("为当前轨道切换内置合成器音色或插入效果器"); is-visible: inst_btn_touch.has-hover; tip-offset-x: -40px; tip-offset-y: 22px; }
                            }
                            Rectangle {
                                background: root.selected-track-color.with-alpha(0.18);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: root.selected-track-color.with-alpha(0.40);
                                height: 18px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: @tr("均分高度");
                                        font-family: Tokens.font-ui;
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        color: root.selected-track-color;
                                        vertical-alignment: center;
                                    }
                                }
                                touch_norm := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.normalize-heights(); }
                                }
                                TooltipBubble { text: @tr("重置所有音轨高度为标准紧凑视图"); is-visible: touch_norm.has-hover; tip-offset-x: -30px; tip-offset-y: 22px; }
                            }
                        }
                    }

                    Text {
                        text: root.selected-track-name;
                        font-family: Tokens.font-ui;
                        font-size: 13px;
                        font-weight: 700;
                        color: Tokens.skin-text-strong;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "ROUTING:";
                                font-family: Tokens.font-mono;
                                font-size: 9px;
                                letter-spacing: 0.4px;
                                color: Tokens.skin-text-dim;
                                font-weight: 400;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "→ " + root.selected-track-bus;
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.track-bus;
                                vertical-alignment: center;
                            }
                        }

                        // Bus strip toggle button (collapsible)
                        Rectangle {
                            background: root.show-bus-strip ? Theme.track-bus.with-alpha(0.25) : transparent;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: root.show-bus-strip ? Theme.track-bus : Tokens.skin-hairline;
                            height: 18px;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text {
                                    text: root.show-bus-strip ? @tr("折叠总线") : @tr("展开总线");
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: root.show-bus-strip ? Theme.track-bus : Tokens.skin-text-body;
                                    vertical-alignment: center;
                                }
                            }
                            touch_bus_toggle := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.show-bus-strip = !root.show-bus-strip; }
                            }
                            TooltipBubble { text: @tr("展开/折叠对应分组总线通道条"); is-visible: touch_bus_toggle.has-hover; tip-offset-x: -30px; tip-offset-y: 20px; }
                        }
                    }
                }
            }

            // Inline Instrument / FX Quick Picker Menu
            if root.show-instrument-menu && root.show-group-track : Rectangle {
                // 二期质感: 菜单面走 §10 面板刷 + 面板落影 (flat = 现行字面 Tokens.bg-panel, 落影 alpha 为 0)。
                background: Tokens.texture-physical ? Tokens.panel-brush : Tokens.bg-panel;
                drop-shadow-color: Tokens.shadow-color.with-alpha(Tokens.shadow-panel-alpha);
                drop-shadow-offset-x: Tokens.shadow-panel-offset-x;
                drop-shadow-offset-y: Tokens.shadow-panel-offset-y;
                drop-shadow-blur: Tokens.shadow-panel-blur;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.60);
                VerticalLayout {
                    padding: 6px;
                    spacing: 3px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: @tr("音色与效果器预设"); font-family: Tokens.font-ui; font-size: 9.5px; font-weight: 700; color: Theme.accent; vertical-alignment: center; }
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 3px; background: Tokens.line;
                            Text { text: "×"; font-family: Tokens.font-ui; font-size: 11px; color: Tokens.skin-text-strong; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.show-instrument-menu = false; } }
                        }
                    }
                    for opt in [
                        { id: "synth:hollow",   label: @tr("空灵合成 Pad (Hollow)") },
                        { id: "synth:organ",    label: @tr("温暖风琴 Organ") },
                        { id: "synth:vocal",    label: @tr("人声领唱 Vocal") },
                        { id: "synth:metallic", label: @tr("金属拨弦 Metallic Pluck") },
                        { id: "synth:glass",    label: @tr("玻璃钟琴 Glass Bell") },
                        { id: "synth:bass",     label: @tr("深沉贝斯 Neuro Bass") },
                        { id: "fx:eq",          label: @tr("+ 插入 参量均衡 EQ") },
                        { id: "fx:reverb",      label: @tr("+ 插入 空间混响 Reverb") },
                        { id: "fx:compressor",  label: @tr("+ 插入 动态压缩 Compressor") },
                    ] : Rectangle {
                        height: 20px;
                        border-radius: 3px;
                        background: insp_opt_t.has-hover ? Theme.accent.with-alpha(0.22) : (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-raised);
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { text: opt.label; font-family: Tokens.font-ui; font-size: 9.5px; color: Tokens.skin-text-strong; vertical-alignment: center; }
                        }
                        insp_opt_t := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.show-instrument-menu = false;
                                root.track-instrument-change(root.selected-track-id, opt.id);
                            }
                        }
                    }
                }
            }

            // ── 组 3：通道条（Channel Strip）─────────────────────────────────
            SectionHeader {
                title: "CHANNEL STRIP";
                meta: root.show-bus-strip ? @tr("含总线") : @tr("仅当前轨道");
                open: root.show-group-channel;
                toggle => { root.show-group-channel = !root.show-group-channel; }
            }

            // Dual Channel Strips Side-by-Side (Top-to-Bottom Signal Flow)
            if root.show-group-channel : HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;

                // Strip 1: Selected Track Strip (Professional Signal Flow: Inserts -> EQ -> Pan -> Fader/Meter)
                Rectangle {
                    // 二期质感: 卡面走 §10 面板刷 + 面板落影 (flat = Theme.bg-surface, 落影 alpha 为 0)。
                    background: Tokens.texture-physical ? Tokens.panel-brush : Theme.bg-surface;
                    drop-shadow-color: Tokens.shadow-color.with-alpha(Tokens.shadow-panel-alpha);
                    drop-shadow-offset-x: Tokens.shadow-panel-offset-x;
                    drop-shadow-offset-y: Tokens.shadow-panel-offset-y;
                    drop-shadow-blur: Tokens.shadow-panel-blur;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;

                        // Section 1: Channel Strip Header
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: @tr("当前通道");
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.selected-track-color;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                background: root.selected-track-color.with-alpha(0.18);
                                border-radius: 2px;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "CH 0" + root.selected-track-id;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 400;
                                        color: root.selected-track-color;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Section 2: Inserts / Effect Slots (Top-to-bottom signal flow)
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: @tr("效果器插槽 (INSERTS)");
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    color: Tokens.skin-text-body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "PRE-FADER";
                                    font-family: Tokens.font-mono;
                                    font-size: 8.5px;
                                    color: Tokens.skin-text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            if root.selected-track-inserts.length == 0
                                || (root.selected-track-inserts[0] == ""
                                    && (root.selected-track-inserts.length < 2 || root.selected-track-inserts[1] == "")
                                    && (root.selected-track-inserts.length < 3 || root.selected-track-inserts[2] == "")) : Rectangle {
                                height: 24px;
                                background: empty_ins_touch.has-hover ? Theme.accent.with-alpha(0.18) : (Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2);
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: @tr("点击 + 插入效果器或音色");
                                        font-family: Tokens.font-ui;
                                        font-size: 9.5px;
                                        color: Tokens.skin-text-body;
                                        vertical-alignment: center;
                                    }
                                }
                                empty_ins_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.show-instrument-menu = true; }
                                }
                            }

                            for ins[idx] in root.selected-track-inserts : Rectangle {
                                // [Q4] 空槽不画：投影只给**真实设备链**，没有设备就没有这一行。
                                visible: ins != "";
                                height: ins != "" ? 22px : 0px;
                                background: Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-panel;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    Text {
                                        text: "" + (idx + 1);
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 400;
                                        color: Tokens.skin-text-dim;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: ins;
                                        font-family: Tokens.font-ui;
                                        font-size: 10px;
                                        color: Tokens.skin-text-strong;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 5px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        background: root.selected-track-color;
                                        y: 8.5px;
                                    }
                                }
                                ins_touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.focus-devices(); }
                                }
                                TooltipBubble { text: @tr("效果器插槽: 点击聚焦底栏设备机架"); is-visible: ins_touch.has-hover; tip-offset-x: -30px; tip-offset-y: 24px; }
                            }
                        }

                        // Section 3: EQ Curve Thumbnail Preview
                        Rectangle {
                            height: 38px;
                            // 二期质感: EQ 屏走 §10 玻璃刷 + 斜向反光 (flat = 现行字面 Tokens.bg-lane2, 反光 alpha 为 0)。
                            background: Tokens.texture-physical ? Tokens.glass-brush : Tokens.bg-lane2;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            clip: true;

                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: 120;
                                viewbox-height: 38;
                                fill: Tokens.glass-reflection;
                                stroke-width: 0px;
                                MoveTo { x: 14; y: 0; }
                                LineTo { x: 44; y: 0; }
                                LineTo { x: 30; y: 38; }
                                LineTo { x: 0; y: 38; }
                            }

                            // 0dB 基准线（缺省帧唯一可见的绘制，保护 5 张 Linux golden）。
                            Rectangle {
                                x: 5px;
                                y: 19px;
                                width: parent.width - 10px;
                                height: 1px;
                                background: root.selected-track-color.with-alpha(0.35);
                            }
                            // 真实 EQ 频响：commands 走 root.eq-curve-svg（由
                            // bridge::calculate_eq_curve_svg 按当前轨参量均衡算好）。
                            // ⛔ 缺省 "M 0 50 L 420 50" 就是基准线本身 ⇒ 此时 Path 隐藏，
                            // 缺省帧与旧渲染逐像素一致；改 EQ 参数后曲线才显形并随参数变化。
                            // ⛔ 不画常量钟形曲线冒充频响。
                            Path {
                                visible: root.eq-curve-svg != "M 0 50 L 420 50";
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: 420;
                                viewbox-height: 100;
                                fit: ImageFit.fill;
                                commands: root.eq-curve-svg;
                                stroke: root.selected-track-color;
                                stroke-width: 1.8px;
                                fill: transparent;
                            }
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-top: 3px;
                                Text {
                                    text: "EQ CURVE";
                                    font-family: Tokens.font-mono;
                                    font-size: 8.5px;
                                    letter-spacing: 0.4px;
                                    color: Tokens.skin-text-dim;
                                    font-weight: 400;
                                }
                            }
                            eq_touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.track-instrument-change(root.selected-track-id, "fx:eq"); }
                            }
                            TooltipBubble { text: @tr("点击为当前轨道追加/聚焦参量均衡 EQ"); is-visible: eq_touch.has-hover; tip-offset-y: 40px; }
                        }

                        // Section 4: Pan (声像) Balance Control (Compact Centered DAW Widget)
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 96px;
                                height: 20px;
                                background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: space-between;
                                    Text {
                                        text: "PAN";
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 400;
                                        color: Tokens.skin-text-dim;
                                        vertical-alignment: center;
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        // Center detent balance bar with dynamic pan position
                                        Rectangle {
                                            width: 24px;
                                            height: 4px;
                                            y: 8px;
                                            background: Tokens.bg-panel-alt;
                                            border-radius: 2px;
                                            Rectangle {
                                                x: 10px + Math.max(-1.0, Math.min(1.0, root.selected-track-pan-value)) * 10px;
                                                width: 4px;
                                                height: 4px;
                                                border-radius: 2px;
                                                background: root.selected-track-color;
                                            }
                                        }
                                        Text {
                                            text: root.selected-track-pan;
                                            font-family: Tokens.font-mono;
                                            font-size: 9.5px;
                                            font-weight: 400;
                                            color: Tokens.skin-text-strong;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                pan_touch := TouchArea {
                                    mouse-cursor: MouseCursor.ew-resize;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            root.mixer-pan-grab(root.selected-track-id - 1, self.mouse-x);
                                        } else if event.kind == PointerEventKind.move {
                                            root.mixer-pan-drag(root.selected-track-id - 1, self.mouse-x);
                                        } else {
                                            root.mixer-pan-release(root.selected-track-id - 1);
                                        }
                                    }
                                    double-clicked => {
                                        root.mixer-pan-reset(root.selected-track-id - 1);
                                    }
                                }
                                TooltipBubble { text: @tr("声像平衡: {} (左右拖拽调节，双击归中)", root.selected-track-pan); is-visible: pan_touch.has-hover; tip-offset-y: 22px; }
                            }
                        }

                        // Section 5: Fader + Meter with clear dB calibration markings
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            height: 108px;

                            // Left dB numerical scale ruler
                            VerticalLayout {
                                alignment: space-between;
                                height: 104px;
                                Text { text: "+6"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                                Text { text: " 0"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-strong; horizontal-alignment: right; }
                                Text { text: "-6"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                                Text { text: "-12"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                                Text { text: "-24"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                                Text { text: "-∞"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                            }

                            // Fader rail
                            Rectangle {
                                width: 24px;
                                height: 104px;
                                background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                // Center groove
                                Rectangle {
                                    x: 10px;
                                    y: 4px;
                                    width: 4px;
                                    height: parent.height - 8px;
                                    background: Tokens.bg-void;
                                    border-radius: 1px;
                                }

                                // dB scale tick marks
                                for tick_y in [18px, 36px, 54px, 72px, 90px] : Rectangle {
                                    x: 3px;
                                    y: tick_y;
                                    width: 18px;
                                    height: 1px;
                                    background: Tokens.skin-hairline;
                                }

                                // Tactile fader cap
                                Rectangle {
                                    x: 1px;
                                    y: 4px + 81px * (1.0 - Math.max(0.0, Math.min(1.0, (root.selected-track-vol + 60.0) / 66.0)));
                                    width: 22px;
                                    height: 15px;
                                    background: Tokens.texture-physical ? Tokens.raised-brush : Tokens.ink-1;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: Tokens.skin-text-body;

                                    Rectangle {
                                        x: 0;
                                        y: 6.5px;
                                        width: parent.width;
                                        height: 2px;
                                        background: root.selected-track-color;
                                    }
                                }
                                fader_touch := TouchArea {
                                    mouse-cursor: MouseCursor.ns-resize;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            root.mixer-fader-grab(root.selected-track-id - 1, self.mouse-y);
                                        } else if event.kind == PointerEventKind.move {
                                            root.mixer-fader-drag(root.selected-track-id - 1, self.mouse-y);
                                        } else {
                                            root.mixer-fader-release(root.selected-track-id - 1);
                                        }
                                    }
                                    double-clicked => {
                                        root.mixer-fader-reset(root.selected-track-id - 1);
                                    }
                                }
                                TooltipBubble { text: @tr("音量推子: {} dB (上下拖拽调节，双击归 0dB)", root.selected-track-vol-display != "" ? root.selected-track-vol-display : ("" + Math.round(root.selected-track-vol * 10.0) / 10.0)); is-visible: fader_touch.has-hover; tip-offset-x: -30px; tip-offset-y: 106px; }
                            }

                            // Meter bar
                            Rectangle {
                                width: 8px;
                                height: 104px;
                                background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                Rectangle {
                                    x: 0;
                                    y: parent.height - (root.selected-track-peak * parent.height);
                                    width: 8px;
                                    height: root.selected-track-peak * parent.height;
                                    background: root.selected-track-peak > 0.8 ? Theme.status-warn : Theme.status-ok;
                                    border-radius: 2px;
                                }
                            }
                        }

                        // Volume dB numerical badge (Compact Centered DAW Readout Box)
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 58px;
                                height: 18px;
                                background: Tokens.texture-physical ? Tokens.glass-brush : Tokens.bg-shell;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.selected-track-vol-display != "" ? (root.selected-track-vol-display + " dB") : ("" + (Math.round(root.selected-track-vol * 10.0) / 10.0) + " dB");
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 400;
                                        color: root.selected-track-color;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Strip 2: Target Group Bus Strip (Collapsible)
                if root.show-bus-strip : Rectangle {
                    // 二期质感: 卡面走 §10 面板刷 + 面板落影 (flat = Theme.bg-surface, 落影 alpha 为 0)。
                    background: Tokens.texture-physical ? Tokens.panel-brush : Theme.bg-surface;
                    drop-shadow-color: Tokens.shadow-color.with-alpha(Tokens.shadow-panel-alpha);
                    drop-shadow-offset-x: Tokens.shadow-panel-offset-x;
                    drop-shadow-offset-y: Tokens.shadow-panel-offset-y;
                    drop-shadow-blur: Tokens.shadow-panel-blur;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;

                        // Section 1: Header
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.bus-name;
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.track-bus;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                background: Theme.track-bus.with-alpha(0.18);
                                border-radius: 2px;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "BUS";
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 400;
                                        color: Theme.track-bus;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Section 2: Bus Inserts
                        // 旧小节名「总线效果器 (BUS INSERTS)」只说明区域名
                        // (无信息/无操作), 负责人 2026-11-16 四条之 1 已删;
                        // 槽行自带槽名。注: 通道侧「效果器插槽 (INSERTS)」与
                        // PRE-FADER 同行 (信号流信息) 且删之会移动该信息, 留。
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: @tr("总线效果器 (BUS INSERTS)");
                                    font-family: Tokens.font-ui;
                                    font-size: 9.5px;
                                    color: Tokens.skin-text-body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            for ins[idx] in root.bus-inserts : Rectangle {
                                height: 22px;
                                background: Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-panel;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    Text {
                                        text: "" + (idx + 1);
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 400;
                                        color: Tokens.skin-text-dim;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: ins;
                                        font-family: Tokens.font-ui;
                                        font-size: 10px;
                                        color: Tokens.skin-text-strong;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        // Section 3: Bus Comp Preview
                        Rectangle {
                            height: 38px;
                            // 二期质感: 压缩屏走 §10 玻璃刷 + 斜向反光 (flat = 现行字面 Tokens.bg-lane2, 反光 alpha 为 0)。
                            background: Tokens.texture-physical ? Tokens.glass-brush : Tokens.bg-lane2;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            clip: true;

                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: 120;
                                viewbox-height: 38;
                                fill: Tokens.glass-reflection;
                                stroke-width: 0px;
                                MoveTo { x: 14; y: 0; }
                                LineTo { x: 44; y: 0; }
                                LineTo { x: 30; y: 38; }
                                LineTo { x: 0; y: 38; }
                            }

                            // 0dB 基准线（无压缩器时唯一可见的绘制）。
                            Rectangle {
                                x: 5px;
                                y: 19px;
                                width: parent.width - 10px;
                                height: 1px;
                                background: Theme.track-bus.with-alpha(0.35);
                            }
                            // ⭐ 真实压缩传递曲线（ADR-0076 B2）：commands 走
                            // root.comp-curve-svg（bridge::project_compressor_curve 按该轨
                            // 压缩器的 threshold_db/ratio 算好）。无压缩器 ⇒ 空串 ⇒ Path 隐藏，
                            // 标签保持「示意」。⛔ 不画常量曲线冒充响应。
                            Path {
                                visible: root.comp-curve-svg != "";
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: 420;
                                viewbox-height: 100;
                                fit: ImageFit.fill;
                                commands: root.comp-curve-svg;
                                stroke: Theme.track-bus;
                                stroke-width: 1.8px;
                                fill: transparent;
                            }
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-top: 3px;
                                Text {
                                    text: root.comp-curve-svg != "" ? "BUS COMP" : @tr("BUS COMP · 示意");
                                    font-family: Tokens.font-mono;
                                    font-size: 8.5px;
                                    letter-spacing: 0.4px;
                                    color: Tokens.skin-text-dim;
                                    font-weight: 400;
                                }
                            }
                        }

                        // Section 4: Bus Pan (Compact Centered DAW Widget)
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 96px;
                                height: 20px;
                                background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: space-between;
                                    Text {
                                        text: "PAN";
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 400;
                                        color: Tokens.skin-text-dim;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: Math.round(Math.abs(root.bus-pan-norm) * 100.0) < 1 ? "C" : (root.bus-pan-norm < 0.0 ? ("L" + Math.round(-root.bus-pan-norm * 100.0)) : ("R" + Math.round(root.bus-pan-norm * 100.0)));
                                        font-family: Tokens.font-mono;
                                        font-size: 9.5px;
                                        font-weight: 400;
                                        color: Tokens.skin-text-strong;
                                        vertical-alignment: center;
                                    }
                                }
                                bus_pan_touch := TouchArea {
                                    mouse-cursor: MouseCursor.ew-resize;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            root.bus-pan-dragging = true;
                                            root.bus-pan-start-x = self.mouse-x;
                                            root.bus-pan-start-norm = root.bus-pan-norm;
                                        } else if event.kind == PointerEventKind.move {
                                            if root.bus-pan-dragging {
                                                root.bus-pan-norm = Math.max(-1.0, Math.min(1.0, root.bus-pan-start-norm + ((self.mouse-x - root.bus-pan-start-x) / 36px) * 2.0));
                                            }
                                        } else {
                                            root.bus-pan-dragging = false;
                                        }
                                    }
                                    double-clicked => {
                                        root.bus-pan-dragging = false;
                                        root.bus-pan-norm = 0.0;
                                    }
                                }
                                TooltipBubble { text: @tr("总线声像 (左右拖拽调节，双击归中)"); is-visible: bus_pan_touch.has-hover; tip-offset-y: 22px; }
                            }
                        }

                        // Section 5: Bus Fader + Meter with dB scale
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            height: 108px;

                            VerticalLayout {
                                alignment: space-between;
                                height: 104px;
                                Text { text: "+6"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                                Text { text: " 0"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-strong; horizontal-alignment: right; }
                                Text { text: "-6"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                                Text { text: "-12"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                                Text { text: "-24"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                                Text { text: "-∞"; font-family: Tokens.font-mono; font-size: 8.5px; color: Tokens.skin-text-dim; horizontal-alignment: right; }
                            }

                            Rectangle {
                                width: 24px;
                                height: 104px;
                                background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                Rectangle {
                                    x: 10px;
                                    y: 4px;
                                    width: 4px;
                                    height: parent.height - 8px;
                                    background: Tokens.bg-void;
                                    border-radius: 1px;
                                }

                                for tick_y in [18px, 36px, 54px, 72px, 90px] : Rectangle {
                                    x: 3px;
                                    y: tick_y;
                                    width: 18px;
                                    height: 1px;
                                    background: Tokens.skin-hairline;
                                }

                                Rectangle {
                                    x: 1px;
                                    y: 4px + 81px * (1.0 - Math.max(0.0, Math.min(1.0, (root.bus-track-vol + 60.0) / 66.0)));
                                    width: 22px;
                                    height: 15px;
                                    background: Tokens.texture-physical ? Tokens.raised-brush : Tokens.ink-1;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: Tokens.skin-text-body;

                                    Rectangle {
                                        x: 0;
                                        y: 6.5px;
                                        width: parent.width;
                                        height: 2px;
                                        background: Theme.track-bus;
                                    }
                                }
                                bus_fader_touch := TouchArea {
                                    mouse-cursor: MouseCursor.ns-resize;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            root.bus-dragging = true;
                                            root.bus-drag-start-y = self.mouse-y;
                                            root.bus-drag-start-db = root.bus-track-vol;
                                        } else if event.kind == PointerEventKind.move {
                                            if root.bus-dragging {
                                                root.bus-track-vol = Math.round(Math.max(-60.0, Math.min(6.0, root.bus-drag-start-db + ((root.bus-drag-start-y - self.mouse-y) / 1px) * (66.0 / 88.0))) * 10.0) / 10.0;
                                            }
                                        } else {
                                            root.bus-dragging = false;
                                        }
                                    }
                                    double-clicked => {
                                        root.bus-dragging = false;
                                        root.bus-track-vol = 0.0;
                                    }
                                }
                                TooltipBubble { text: @tr("总线推子: {} dB (上下拖拽调节，双击归 0dB)", Math.round(root.bus-track-vol * 10.0) / 10.0); is-visible: bus_fader_touch.has-hover; tip-offset-x: -30px; tip-offset-y: 106px; }
                            }

                            Rectangle {
                                width: 8px;
                                height: 104px;
                                background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                Rectangle {
                                    x: 0;
                                    y: parent.height - (root.bus-track-peak * parent.height);
                                    width: 8px;
                                    height: root.bus-track-peak * parent.height;
                                    background: root.bus-track-peak > 0.8 ? Theme.status-warn : Theme.status-ok;
                                    border-radius: 2px;
                                }
                            }
                        }

                        // Bus Volume dB badge (Compact Centered DAW Readout Box)
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 58px;
                                height: 18px;
                                background: Tokens.texture-physical ? Tokens.glass-brush : Tokens.bg-shell;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "" + (Math.round(root.bus-track-vol * 10.0) / 10.0) + " dB";
                                        font-family: Tokens.font-mono;
                                        font-size: 10px;
                                        font-weight: 400;
                                        color: Theme.track-bus;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
            }

            // ⭐ 检查器纵向滚动指示：与编曲区同一条思路 —— 只在「内容高于视口」时出现，
            // 1080 高度下装得下 ⇒ 不新增任何像素。
            //   背景：`insp_flick` 早就能滚（见上面的 `content-height`），但窄窗里没有任何
            //   视觉提示，创作者只看到 `TRACK` 之后被切掉一半，以为「CHANNEL STRIP 根本没有」。
            // ⚠ 判据必须是 `insp_body.preferred-height`（真内容高），⛔ 不能用 `content-height`：
            //   后者写成 `Math.max(self.height, …)`，恒 >= 视口高，判据会恒真。
            insp_sb := Rectangle {
                visible: insp_body.preferred-height > insp_flick.height + 1px;
                x: insp_host.width - 11px;
                y: 4px;
                width: 4px;
                height: insp_host.height - 8px;
                border-radius: 2px;
                background: #2b3140;

                property <length> thumb-h: Math.min(
                    insp_sb.height,
                    Math.max(
                        (insp_sb.height * insp_sb.height) / max(1px, insp_body.preferred-height)
                    )
                );
                Rectangle {
                    width: insp_sb.width;
                    height: insp_sb.thumb-h;
                    // 滚动位移取反：`content-y`（旧名 `viewport-y`）向下滚为负值。
                    y: Math.min(
                        insp_sb.height - insp_sb.thumb-h,
                        Math.max(0px, (0px - insp_flick.content-y) * (insp_sb.height / max(1px, insp_body.preferred-height)))
                    );
                    border-radius: 2px;
                    background: #404c5f;
                }
            }
        }

        // TAB 2: SMART TAG BROWSER
        if root.active-tab == "browser" : browser_flick := Flickable {
            vertical-stretch: 1;
            min-height: 120px;
            content-width: self.width;
            content-height: Math.max(self.height, browser_body.preferred-height);

            browser_body := VerticalLayout {
                x: 0px;
                y: 0px;
                width: browser_flick.width;
                height: Math.max(browser_flick.height, self.preferred-height);
                padding: 8px;
            spacing: 8px;

            // Search input field (Real TextInput)
            Rectangle {
                height: 30px;
                background: Tokens.texture-physical ? Tokens.void-brush : Tokens.bg-lane2;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: browser_search_input.has-focus ? Theme.accent : Theme.border-subtle;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text {
                        text: @tr("检索");
                        font-family: Tokens.font-ui;
                        font-size: 10px;
                        font-weight: 600;
                        color: Tokens.skin-text-dim;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.search-query == "" : Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: @tr("搜索音色、插件、采样包...");
                            font-family: Tokens.font-ui;
                            font-size: 10.5px;
                            color: Tokens.skin-text-dim;
                            vertical-alignment: center;
                        }
                        browser_search_input := ImeAwareTextInput {
                            width: parent.width;
                            height: parent.height;
                            text <=> root.search-query;
                            font-family: Tokens.font-ui;
                            font-size: 10.5px;
                            color: Tokens.skin-text-strong;
                            vertical-alignment: center;
                            single-line: true;
                            edited => {
                                root.search-changed(self.text);
                            }
                        }
                    }
                    if root.search-query != "" : Rectangle {
                        width: 18px;
                        height: 18px;
                        y: 6px;
                        border-radius: 3px;
                        background: clear_q_t.has-hover ? Tokens.line : transparent;
                        Text {
                            text: "×";
                            font-family: Tokens.font-ui;
                            font-size: 11px;
                            color: Tokens.skin-text-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        clear_q_t := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.search-query = "";
                                root.search-changed("");
                            }
                        }
                    }
                }
            }

            // Tag Filter Pills (Harmonized with track mineral color order)
            HorizontalLayout {
                spacing: 5px;
                height: 22px;

                Rectangle {
                    background: root.active-tag == "all" ? Theme.accent : (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-panel);
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "all" ? Theme.accent : Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: @tr("全部");
                            font-family: Tokens.font-ui;
                            font-size: 9.5px;
                            font-weight: 600;
                            color: root.active-tag == "all" ? Tokens.skin-inset : Tokens.skin-text-body;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "all";
                            root.select-tag("all");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "instrument" ? Theme.track-synth : (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-panel);
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "instrument" ? Theme.track-synth : Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: @tr("音色");
                            font-family: Tokens.font-mono;
                            font-size: 9.5px;
                            font-weight: 400;
                            color: root.active-tag == "instrument" ? Tokens.skin-inset : Tokens.skin-text-body;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "instrument";
                            root.select-tag("instrument");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "effect" ? Theme.status-ok : (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-panel);
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "effect" ? Theme.status-ok : Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: @tr("效果");
                            font-family: Tokens.font-mono;
                            font-size: 9.5px;
                            font-weight: 400;
                            color: root.active-tag == "effect" ? Tokens.skin-inset : Tokens.skin-text-body;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "effect";
                            root.select-tag("effect");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "sample" ? Theme.track-drum : (Tokens.texture-physical ? Tokens.raised-brush : Tokens.bg-panel);
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "sample" ? Theme.track-drum : Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: @tr("采样");
                            font-family: Tokens.font-mono;
                            font-size: 9.5px;
                            font-weight: 400;
                            color: root.active-tag == "sample" ? Tokens.skin-inset : Tokens.skin-text-body;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "sample";
                            root.select-tag("sample");
                        }
                    }
                }
            }

            // Browser Items List
            VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;

                for item in root.browser-items : Rectangle {
                    if root.active-tag == "all" || item.tag == root.active-tag : Rectangle {
                        height: 50px;
                        // 二期质感: 条目卡走 §10 面板刷 + 面板落影 (flat = Theme.bg-surface, 落影 alpha 为 0)。
                        background: Tokens.texture-physical ? Tokens.panel-brush : Theme.bg-surface;
                        drop-shadow-color: Tokens.shadow-color.with-alpha(Tokens.shadow-panel-alpha);
                        drop-shadow-offset-x: Tokens.shadow-panel-offset-x;
                        drop-shadow-offset-y: Tokens.shadow-panel-offset-y;
                        drop-shadow-blur: Tokens.shadow-panel-blur;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 6px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: item.name;
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Tokens.skin-text-strong;
                                    overflow: elide;
                                }
                                Rectangle {
                                    background: Theme.accent.with-alpha(0.15);
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: "#" + item.tag;
                                            font-family: Tokens.font-mono;
                                            font-size: 9px;
                                            color: Theme.accent;
                                            font-weight: 400;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: item.desc;
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                color: Tokens.skin-text-body;
                                overflow: elide;
                            }
                        }
                        item_touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.load-item(item.name); }
                        }
                        TooltipBubble { text: @tr("点击载入 {} 至当前轨道", item.name); is-visible: item_touch.has-hover; tip-offset-y: 52px; }
                    }
                }
            }
            }
        }
    }
}
