import { Theme, BrowserItemData } from "tokens.slint";

export component ZoneBrowserAndInspector inherits Rectangle {
    in-out property <string> active-tab: "inspector"; // "inspector" | "browser"
    in-out property <string> selected-track-name: "01. Lead Neuro Bass";
    in-out property <string> selected-track-badge: "TRK 01 · SYNTH";
    in-out property <string> selected-track-bus: "Bus 1 (Synth Grp)";
    in-out property <float> selected-track-vol: -2.5;
    in-out property <float> selected-track-peak: 0.65;
    in-out property <[string]> selected-track-inserts: ["⚡ Wavetable MPE", "📈 Pro-QLinear 8", "🔥 Glue Comp VCA"];

    in-out property <string> bus-name: "Bus 1 · Synth";
    in-out property <float> bus-track-vol: -1.0;
    in-out property <float> bus-track-peak: 0.55;
    in-out property <[string]> bus-inserts: ["🎛️ Tape Saturator", "🌊 Vintage Verb", "+ 添加总线效果"];

    in-out property <string> search-query: "";
    in-out property <string> active-tag: "all"; // all, Synth, Drums, DSP, MPE
    in-out property <[BrowserItemData]> browser-items: [
        { name: "Wavetable MPE Synth", desc: "双振荡器 3D 波表合成器", tag: "Synth", format: "Native DSP" },
        { name: "Pro-QLinear 8", desc: "内联实时频谱零延迟动态 EQ", tag: "DSP", format: "Native DSP" },
        { name: "Granulator IV Cloud", desc: "支持 MPE 弯音的粒子采样器", tag: "MPE", format: "Native DSP" },
        { name: "Cyberpunk 124BPM Drum Kit", desc: "含 64 个多麦克风分层鼓组", tag: "Drums", format: "Sample Pack" },
        { name: "VCA Glue Bus Compressor", desc: "模拟 SSL 4000G 总线粘合压缩", tag: "DSP", format: "CLAP / Native" },
        { name: "Sub Bass 808 Glide Rack", desc: "带宏旋钮一键失真度映射", tag: "Synth", format: "Instrument Rack" }
    ];

    callback switch-tab(string);
    callback normalize-heights();
    callback fader-changed(float);
    callback bus-fader-changed(float);
    callback select-tag(string);
    callback load-item(string);
    callback focus-devices();

    width: 256px;
    background: Theme.bg-panel;
    // border line
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Subtab switcher
        Rectangle {
            height: 36px;
            background: #00000030;
            // border line
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding: 4px;
                spacing: 4px;

                Rectangle {
                    background: root.active-tab == "inspector" ? Theme.accent.with-alpha(0.2) : transparent;
                    border-radius: Theme.radius;
                    border-width: root.active-tab == "inspector" ? 1px : 0;
                    border-color: Theme.accent;

                    Text {
                        text: "🎛️ 双通道检查器";
                        font-size: 11px;
                        font-weight: 700;
                        color: root.active-tab == "inspector" ? Theme.accent : #94a3b8;
                        horizontal-alignment: center;
                        }
                    TouchArea {
                        clicked => {
                            root.active-tab = "inspector";
                            root.switch-tab("inspector");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tab == "browser" ? Theme.accent.with-alpha(0.2) : transparent;
                    border-radius: Theme.radius;
                    border-width: root.active-tab == "browser" ? 1px : 0;
                    border-color: Theme.accent;

                    Text {
                        text: "🏷️ 智能标签库";
                        font-size: 11px;
                        font-weight: 700;
                        color: root.active-tab == "browser" ? Theme.accent : #94a3b8;
                        horizontal-alignment: center;
                        }
                    TouchArea {
                        clicked => {
                            root.active-tab = "browser";
                            root.switch-tab("browser");
                        }
                    }
                }
            }
        }

        // TAB 1: DUAL INSPECTOR
        if root.active-tab == "inspector" : VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Track Header Card
            Rectangle {
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;
                height: 78px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    HorizontalLayout {
                        Text { text: root.selected-track-badge; font-size: 10px; font-weight: 700; color: Theme.accent; }
                        Rectangle {
                            background: #3b82f620;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #3b82f640;
                            Text { text: "↕ 12.4等高"; font-size: 9px; font-weight: 700; color: #60a5fa; }
                            TouchArea { clicked => { root.normalize-heights(); } }
                        }
                    }

                    Text { text: root.selected-track-name; font-size: 12px; font-weight: 800; color: #f8fafc; overflow: elide; }

                    HorizontalLayout {
                        Text { text: "路由: "; font-size: 10px; color: #64748b; }
                        Text { text: "→ " + root.selected-track-bus; font-size: 10px; font-weight: 700; color: #10b981; }
                    }
                }
            }

            // Dual Channel Strips Side-by-Side
            HorizontalLayout {
                spacing: 6px;
                vertical-stretch: 1;

                // Strip 1: Selected Track Strip
                Rectangle {
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        Text { text: "选中轨"; font-size: 10px; font-weight: 800; color: Theme.accent; horizontal-alignment: center; }
                        Text { text: "INSERTS (内联槽)"; font-size: 8px; color: #64748b; horizontal-alignment: center; }

                        // Inserts items
                        for ins in root.selected-track-inserts : Rectangle {
                            height: 20px;
                            background: Theme.accent.with-alpha(0.15);
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.accent.with-alpha(0.3);
                            Text { text: ins; font-size: 9px; color: #f8fafc; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                            TouchArea { clicked => { root.focus-devices(); } }
                        }

                        // EQ Thumbnail Path
                        Rectangle {
                            height: 38px;
                            background: #06090e;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #1e293b;
                            clip: true;

                            Path {
                                commands: "M 0 28 Q 20 25, 35 12 T 70 18 T 100 24";
                                stroke: Theme.accent;
                                stroke-width: 1.8px;
                            }
                            Text { x: 4px; y: 2px; text: "EQ THUMB"; font-size: 7px; color: #475569; font-weight: 700; }
                        }

                        // Fader + Meter
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            height: 60px;

                            // Fader rail
                            Rectangle {
                                width: 20px;
                                background: #0b0f17;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #1e293b;

                                Rectangle {
                                    x: 2px;
                                    y: 20px;
                                    width: 16px;
                                    height: 14px;
                                    background: #94a3b8;
                                    border-radius: 2px;
                                }
                                TouchArea {
                                    clicked => { root.fader-changed(root.selected-track-vol == -2.5 ? 0.0 : -2.5); }
                                }
                            }

                            // Meter bar
                            Rectangle {
                                width: 8px;
                                background: #0b0f17;
                                border-radius: 2px;
                                Rectangle {
                                    x: 0;
                                    y: 60px - (root.selected-track-peak * 60px);
                                    width: 8px;
                                    height: root.selected-track-peak * 60px;
                                    background: #10b981;
                                    border-radius: 2px;
                                }
                            }
                        }

                        Text {
                            text: "" + root.selected-track-vol + " dB";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.accent;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Strip 2: Target Group Bus Strip
                Rectangle {
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        Text { text: root.bus-name; font-size: 10px; font-weight: 800; color: #10b981; horizontal-alignment: center; overflow: elide; }
                        Text { text: "BUS INSERTS"; font-size: 8px; color: #64748b; horizontal-alignment: center; }

                        for ins in root.bus-inserts : Rectangle {
                            height: 20px;
                            background: #10b98115;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #10b98130;
                            Text { text: ins; font-size: 9px; color: #f8fafc; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                        }

                        // Bus Comp Thumbnail Path
                        Rectangle {
                            height: 38px;
                            background: #06090e;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #1e293b;
                            clip: true;

                            Path {
                                commands: "M 0 20 Q 35 18, 55 12 T 100 16";
                                stroke: #10b981;
                                stroke-width: 1.8px;
                            }
                            Text { x: 4px; y: 2px; text: "BUS COMP"; font-size: 7px; color: #475569; font-weight: 700; }
                        }

                        // Bus Fader + Meter
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            height: 60px;

                            Rectangle {
                                width: 20px;
                                background: #0b0f17;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #1e293b;

                                Rectangle {
                                    x: 2px;
                                    y: 25px;
                                    width: 16px;
                                    height: 14px;
                                    background: #94a3b8;
                                    border-radius: 2px;
                                }
                                TouchArea {
                                    clicked => { root.bus-fader-changed(root.bus-track-vol == -1.0 ? 0.0 : -1.0); }
                                }
                            }

                            Rectangle {
                                width: 8px;
                                background: #0b0f17;
                                border-radius: 2px;
                                Rectangle {
                                    x: 0;
                                    y: 60px - (root.bus-track-peak * 60px);
                                    width: 8px;
                                    height: root.bus-track-peak * 60px;
                                    background: #10b981;
                                    border-radius: 2px;
                                }
                            }
                        }

                        Text {
                            text: "" + root.bus-track-vol + " dB";
                            font-size: 10px;
                            font-weight: 700;
                            color: #10b981;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // TAB 2: SMART TAG BROWSER
        if root.active-tab == "browser" : VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Search input field
            Rectangle {
                height: 28px;
                background: #00000040;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #334155;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text { text: "🔍"; font-size: 11px; }
                    Text { text: "搜索音色、插件、采样..."; font-size: 10px; color: #64748b; vertical-alignment: center; }
                }
            }

            // Tag Filter Pills
            HorizontalLayout {
                spacing: 4px;
                height: 22px;

                Rectangle {
                    background: root.active-tag == "all" ? Theme.accent : #1e293b;
                    border-radius: 11px;
                    Text { text: "全部"; font-size: 9px; font-weight: 700; color: root.active-tag == "all" ? #020617 : #94a3b8; }
                    TouchArea {
                        clicked => {
                            root.active-tag = "all";
                            root.select-tag("all");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "Synth" ? Theme.accent : #1e293b;
                    border-radius: 11px;
                    Text { text: "#Synth"; font-size: 9px; font-weight: 700; color: root.active-tag == "Synth" ? #020617 : #94a3b8; }
                    TouchArea {
                        clicked => {
                            root.active-tag = "Synth";
                            root.select-tag("Synth");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "DSP" ? Theme.accent : #1e293b;
                    border-radius: 11px;
                    Text { text: "#DSP"; font-size: 9px; font-weight: 700; color: root.active-tag == "DSP" ? #020617 : #94a3b8; }
                    TouchArea {
                        clicked => {
                            root.active-tag = "DSP";
                            root.select-tag("DSP");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "Drums" ? Theme.accent : #1e293b;
                    border-radius: 11px;
                    Text { text: "#Drums"; font-size: 9px; font-weight: 700; color: root.active-tag == "Drums" ? #020617 : #94a3b8; }
                    TouchArea {
                        clicked => {
                            root.active-tag = "Drums";
                            root.select-tag("Drums");
                        }
                    }
                }
            }

            // Browser Items List
            VerticalLayout {
                spacing: 5px;
                vertical-stretch: 1;

                for item in root.browser-items : Rectangle {
                    if root.active-tag == "all" || item.tag == root.active-tag : Rectangle {
                        height: 48px;
                        background: Theme.bg-surface;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 2px;
                            alignment: center;

                            HorizontalLayout {
                                Text { text: item.name; font-size: 11px; font-weight: 700; color: #f8fafc; overflow: elide; }
                                Rectangle {
                                    background: Theme.accent.with-alpha(0.15);
                                    border-radius: 3px;
                                    Text { text: "#" + item.tag; font-size: 8px; color: Theme.accent; font-weight: 700; }
                                }
                            }

                            Text { text: item.desc; font-size: 9px; color: #94a3b8; overflow: elide; }
                        }
                        TouchArea { clicked => { root.load-item(item.name); } }
                    }
                }
            }
        }
    }
}
