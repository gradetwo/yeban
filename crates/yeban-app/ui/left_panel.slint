import { Theme, BrowserItemData, Tokens } from "tokens.slint";

export component ZoneBrowserAndInspector inherits Rectangle {
    in-out property <string> active-tab: "inspector"; // "inspector" | "browser"
    in-out property <string> selected-track-name: "01. Lead Neuro Bass";
    in-out property <string> selected-track-badge: "TRK 01 · SYNTH";
    in-out property <string> selected-track-bus: "Bus 1 (Synth Grp)";
    in-out property <float> selected-track-vol: -2.5;
    in-out property <float> selected-track-peak: 0.65;
    in-out property <[string]> selected-track-inserts: ["⚡ Wavetable MPE", "📈 Pro-QLinear 8", "🔥 Glue Comp VCA"];

    in-out property <string> bus-name: "Bus 1 · Synth";
    in-out property <float> bus-track-vol: -1.0;
    in-out property <float> bus-track-peak: 0.55;
    in-out property <[string]> bus-inserts: ["🎛️ Tape Saturator", "🌊 Vintage Verb", "+ 添加总线效果"];

    in-out property <string> search-query: "";
    in-out property <string> active-tag: "all"; // all, Synth, Drums, DSP, MPE
    in-out property <[BrowserItemData]> browser-items: [
        { name: "Wavetable MPE Synth", desc: "双振荡器 3D 波表合成器", tag: "Synth", format: "Native DSP" },
        { name: "Pro-QLinear 8", desc: "内联实时频谱零延迟动态 EQ", tag: "DSP", format: "Native DSP" },
        { name: "Granulator IV Cloud", desc: "支持 MPE 弯音的粒子采样器", tag: "MPE", format: "Native DSP" },
        { name: "Cyberpunk 124BPM Drum Kit", desc: "含 64 个多麦克风分层鼓组", tag: "Drums", format: "Sample Pack" },
        { name: "VCA Glue Bus Compressor", desc: "模拟 SSL 4000G 总线粘合压缩", tag: "DSP", format: "CLAP / Native" },
        { name: "Sub Bass 808 Glide Rack", desc: "带宏旋钮一键失真度映射", tag: "Synth", format: "Instrument Rack" }
    ];

    callback switch-tab(string);
    callback normalize-heights();
    callback fader-changed(float);
    callback bus-fader-changed(float);
    callback select-tag(string);
    callback load-item(string);
    callback focus-devices();

    width: 256px;
    background: Theme.bg-panel;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Subtab switcher
        Rectangle {
            height: 34px;
            background: #090c14;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding: 3px;
                spacing: 4px;

                Rectangle {
                    background: root.active-tab == "inspector" ? Theme.accent.with-alpha(0.18) : transparent;
                    border-radius: Theme.radius;
                    border-width: root.active-tab == "inspector" ? 1px : 0;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "🎛️ 通道检查器";
                            font-family: Tokens.font-ui;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.active-tab == "inspector" ? Theme.accent : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tab = "inspector";
                            root.switch-tab("inspector");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tab == "browser" ? Theme.accent.with-alpha(0.18) : transparent;
                    border-radius: Theme.radius;
                    border-width: root.active-tab == "browser" ? 1px : 0;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "🏷️ 智能音色库";
                            font-family: Tokens.font-ui;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.active-tab == "browser" ? Theme.accent : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tab = "browser";
                            root.switch-tab("browser");
                        }
                    }
                }
            }
        }

        // TAB 1: DUAL INSPECTOR
        if root.active-tab == "inspector" : VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Track Header Card
            Rectangle {
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;
                height: 76px;

                VerticalLayout {
                    padding: 8px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.selected-track-badge;
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 800;
                            letter-spacing: 0.8px;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            background: #3b82f618;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #3b82f640;
                            height: 18px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "↕ 12.4等高";
                                    font-family: Tokens.font-ui;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: #60a5fa;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.normalize-heights(); } }
                        }
                    }

                    Text {
                        text: root.selected-track-name;
                        font-family: Tokens.font-ui;
                        font-size: 13px;
                        font-weight: 700;
                        color: #f8fafc;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "ROUTING:";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.5px;
                            color: #64748b;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "→ " + root.selected-track-bus;
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            font-weight: 600;
                            color: #34d399;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Dual Channel Strips Side-by-Side
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;

                // Strip 1: Selected Track Strip
                Rectangle {
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 5px;

                        Text {
                            text: "选中轨";
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.accent;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "INSERTS";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.8px;
                            color: #64748b;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        // Inserts items
                        for ins in root.selected-track-inserts : Rectangle {
                            height: 22px;
                            background: #090c13;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #ffffff0a;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text {
                                    text: ins;
                                    font-family: Tokens.font-ui;
                                    font-size: 9px;
                                    color: #f1f5f9;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            TouchArea { clicked => { root.focus-devices(); } }
                        }

                        // EQ Thumbnail Path
                        Rectangle {
                            height: 42px;
                            background: #06080e;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #1a202c;
                            clip: true;

                            Path {
                                commands: "M 0 30 Q 20 27, 35 14 T 70 20 T 100 26";
                                stroke: Theme.accent;
                                stroke-width: 1.8px;
                            }
                            Text {
                                x: 5px;
                                y: 3px;
                                text: "EQ THUMB";
                                font-family: Tokens.font-mono;
                                font-size: 7px;
                                letter-spacing: 0.5px;
                                color: #475569;
                                font-weight: 700;
                            }
                        }

                        // Fader + Meter
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            height: 68px;

                            // Fader rail
                            Rectangle {
                                width: 22px;
                                background: #06080e;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #1a202c;

                                Rectangle {
                                    x: 10px;
                                    y: 0;
                                    width: 2px;
                                    height: parent.height;
                                    background: #000000;
                                }

                                Rectangle {
                                    x: 2px;
                                    y: 22px;
                                    width: 18px;
                                    height: 14px;
                                    background: #94a3b8;
                                    border-radius: 2px;

                                    Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: 18px;
                                        height: 2px;
                                        background: #ffffff;
                                    }
                                }
                                TouchArea {
                                    clicked => { root.fader-changed(root.selected-track-vol == -2.5 ? 0.0 : -2.5); }
                                }
                            }

                            // Meter bar
                            Rectangle {
                                width: 8px;
                                background: #06080e;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #1a202c;

                                Rectangle {
                                    x: 0;
                                    y: 68px - (root.selected-track-peak * 68px);
                                    width: 8px;
                                    height: root.selected-track-peak * 68px;
                                    background: root.selected-track-peak > 0.8 ? #f59e0b : #10b981;
                                    border-radius: 2px;
                                }
                            }
                        }

                        Text {
                            text: "" + root.selected-track-vol + " dB";
                            font-family: Tokens.font-mono;
                            font-size: 10px;
                            font-weight: 800;
                            color: Theme.accent;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Strip 2: Target Group Bus Strip
                Rectangle {
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 5px;

                        Text {
                            text: root.bus-name;
                            font-family: Tokens.font-ui;
                            font-size: 10px;
                            font-weight: 700;
                            color: #34d399;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: "BUS INSERTS";
                            font-family: Tokens.font-mono;
                            font-size: 8px;
                            letter-spacing: 0.8px;
                            color: #64748b;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        for ins in root.bus-inserts : Rectangle {
                            height: 22px;
                            background: #090c13;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #ffffff0a;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text {
                                    text: ins;
                                    font-family: Tokens.font-ui;
                                    font-size: 9px;
                                    color: #f1f5f9;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // Bus Comp Thumbnail Path
                        Rectangle {
                            height: 42px;
                            background: #06080e;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #1a202c;
                            clip: true;

                            Path {
                                commands: "M 0 22 Q 35 20, 55 14 T 100 18";
                                stroke: #10b981;
                                stroke-width: 1.8px;
                            }
                            Text {
                                x: 5px;
                                y: 3px;
                                text: "BUS COMP";
                                font-family: Tokens.font-mono;
                                font-size: 7px;
                                letter-spacing: 0.5px;
                                color: #475569;
                                font-weight: 700;
                            }
                        }

                        // Bus Fader + Meter
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            height: 68px;

                            Rectangle {
                                width: 22px;
                                background: #06080e;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: #1a202c;

                                Rectangle {
                                    x: 10px;
                                    y: 0;
                                    width: 2px;
                                    height: parent.height;
                                    background: #000000;
                                }

                                Rectangle {
                                    x: 2px;
                                    y: 28px;
                                    width: 18px;
                                    height: 14px;
                                    background: #94a3b8;
                                    border-radius: 2px;

                                    Rectangle {
                                        x: 0;
                                        y: 6px;
                                        width: 18px;
                                        height: 2px;
                                        background: #ffffff;
                                    }
                                }
                                TouchArea {
                                    clicked => { root.bus-fader-changed(root.bus-track-vol == -1.0 ? 0.0 : -1.0); }
                                }
                            }

                            Rectangle {
                                width: 8px;
                                background: #06080e;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: #1a202c;

                                Rectangle {
                                    x: 0;
                                    y: 68px - (root.bus-track-peak * 68px);
                                    width: 8px;
                                    height: root.bus-track-peak * 68px;
                                    background: root.bus-track-peak > 0.8 ? #f59e0b : #10b981;
                                    border-radius: 2px;
                                }
                            }
                        }

                        Text {
                            text: "" + root.bus-track-vol + " dB";
                            font-family: Tokens.font-mono;
                            font-size: 10px;
                            font-weight: 800;
                            color: #34d399;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // TAB 2: SMART TAG BROWSER
        if root.active-tab == "browser" : VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Search input field
            Rectangle {
                height: 30px;
                background: #07090e;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #1e2433;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text { text: "🔍"; font-size: 11px; vertical-alignment: center; }
                    Text {
                        text: "搜索音色、插件、采样包...";
                        font-family: Tokens.font-ui;
                        font-size: 10px;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }
            }

            // Tag Filter Pills
            HorizontalLayout {
                spacing: 5px;
                height: 22px;

                Rectangle {
                    background: root.active-tag == "all" ? Theme.accent : #161a24;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "all" ? Theme.accent : #ffffff0a;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "全部";
                            font-family: Tokens.font-ui;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-tag == "all" ? #020617 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "all";
                            root.select-tag("all");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "Synth" ? Theme.accent : #161a24;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "Synth" ? Theme.accent : #ffffff0a;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "#Synth";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-tag == "Synth" ? #020617 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "Synth";
                            root.select-tag("Synth");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "DSP" ? Theme.accent : #161a24;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "DSP" ? Theme.accent : #ffffff0a;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "#DSP";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-tag == "DSP" ? #020617 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "DSP";
                            root.select-tag("DSP");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "Drums" ? Theme.accent : #161a24;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "Drums" ? Theme.accent : #ffffff0a;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "#Drums";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-tag == "Drums" ? #020617 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "Drums";
                            root.select-tag("Drums");
                        }
                    }
                }
            }

            // Browser Items List
            VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;

                for item in root.browser-items : Rectangle {
                    if root.active-tag == "all" || item.tag == root.active-tag : Rectangle {
                        height: 50px;
                        background: Theme.bg-surface;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 6px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: item.name;
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    overflow: elide;
                                }
                                Rectangle {
                                    background: Theme.accent.with-alpha(0.15);
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: "#" + item.tag;
                                            font-family: Tokens.font-mono;
                                            font-size: 8px;
                                            color: Theme.accent;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: item.desc;
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                color: #94a3b8;
                                overflow: elide;
                            }
                        }
                        TouchArea { clicked => { root.load-item(item.name); } }
                    }
                }
            }
        }
    }
}
