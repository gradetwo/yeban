import { Theme, BrowserItemData, Tokens } from "tokens.slint";

export component ZoneBrowserAndInspector inherits Rectangle {
    in-out property <string> active-tab: "inspector"; // "inspector" | "browser"
    in-out property <int> selected-track-id: 3;
    in-out property <color> selected-track-color: #387691;
    in-out property <string> selected-track-name: "01. Lead Neuro Bass";
    in-out property <string> selected-track-badge: "TRK 01 · SYNTH";
    in-out property <string> selected-track-bus: "Bus 1 (Synth Grp)";
    in-out property <string> selected-track-pan: "C";
    in-out property <float> selected-track-vol: -2.5;
    in-out property <float> selected-track-peak: 0.65;
    in-out property <[string]> selected-track-inserts: ["Wavetable MPE", "Pro-QLinear 8", "Glue Comp VCA"];

    in-out property <string> bus-name: "Bus 1 · Synth";
    in-out property <float> bus-track-vol: -1.0;
    in-out property <float> bus-track-peak: 0.55;
    in-out property <[string]> bus-inserts: ["Tape Saturator", "Vintage Verb", "+ 添加总线效果"];
    in-out property <bool> show-bus-strip: false; // 默认折叠总线通道条，收缩至专注单轨检查器

    in-out property <string> search-query: "";
    in-out property <string> active-tag: "all"; // all, Synth, Drums, DSP, MPE
    in-out property <[BrowserItemData]> browser-items: [
        { name: "Wavetable MPE Synth", desc: "双振荡器 3D 波表合成器", tag: "Synth", format: "Native DSP" },
        { name: "Pro-QLinear 8", desc: "内联实时频谱零延迟动态 EQ", tag: "DSP", format: "Native DSP" },
        { name: "Granulator IV Cloud", desc: "支持 MPE 弯音的粒子采样器", tag: "MPE", format: "Native DSP" },
        { name: "Cyberpunk 124BPM Drum Kit", desc: "含 64 个多麦克风分层鼓组", tag: "Drums", format: "Sample Pack" },
        { name: "VCA Glue Bus Compressor", desc: "模拟 SSL 4000G 总线粘合压缩", tag: "DSP", format: "CLAP / Native" },
        { name: "Sub Bass 808 Glide Rack", desc: "带宏旋钮一键失真度映射", tag: "Synth", format: "Instrument Rack" }
    ];

    callback switch-tab(string);
    callback normalize-heights();
    callback fader-changed(float);
    callback bus-fader-changed(float);
    callback select-tag(string);
    callback load-item(string);
    callback focus-devices();

    in-out property <length> panel-width: 256px;
    width: root.panel-width;
    background: Theme.bg-panel;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Subtab switcher
        Rectangle {
            height: 34px;
            background: #080a10;
            border-color: Theme.border-subtle;

            HorizontalLayout {
                padding: 3px;
                spacing: 4px;

                Rectangle {
                    background: root.active-tab == "inspector" ? Theme.accent.with-alpha(0.18) : transparent;
                    border-radius: Theme.radius;
                    border-width: root.active-tab == "inspector" ? 1px : 0;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "通道检查器";
                            font-family: Tokens.font-ui;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.active-tab == "inspector" ? Theme.accent : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tab = "inspector";
                            root.switch-tab("inspector");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tab == "browser" ? Theme.accent.with-alpha(0.18) : transparent;
                    border-radius: Theme.radius;
                    border-width: root.active-tab == "browser" ? 1px : 0;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "智能音色库";
                            font-family: Tokens.font-ui;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.active-tab == "browser" ? Theme.accent : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tab = "browser";
                            root.switch-tab("browser");
                        }
                    }
                }
            }
        }

        // TAB 1: DUAL INSPECTOR
        if root.active-tab == "inspector" : VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Track Header Card
            Rectangle {
                background: Theme.bg-surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;
                height: 76px;

                // Color accent bar on left edge
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 3px;
                    height: parent.height;
                    border-top-left-radius: Theme.radius;
                    border-bottom-left-radius: Theme.radius;
                    background: root.selected-track-color;
                }

                VerticalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.selected-track-badge;
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 800;
                            letter-spacing: 0.8px;
                            color: root.selected-track-color;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            background: root.selected-track-color.with-alpha(0.18);
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.selected-track-color.with-alpha(0.40);
                            height: 18px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "均分高度";
                                    font-family: Tokens.font-ui;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: root.selected-track-color;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.normalize-heights(); } }
                        }
                    }

                    Text {
                        text: root.selected-track-name;
                        font-family: Tokens.font-ui;
                        font-size: 13px;
                        font-weight: 700;
                        color: #f8fafc;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "ROUTING:";
                                font-family: Tokens.font-mono;
                                font-size: 8px;
                                letter-spacing: 0.5px;
                                color: #64748b;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "→ " + root.selected-track-bus;
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.track-bus;
                                vertical-alignment: center;
                            }
                        }

                        // Bus strip toggle button (collapsible)
                        Rectangle {
                            background: root.show-bus-strip ? Theme.track-bus.with-alpha(0.25) : transparent;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: root.show-bus-strip ? Theme.track-bus : #ffffff15;
                            height: 16px;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text {
                                    text: root.show-bus-strip ? "折叠总线" : "展开总线";
                                    font-family: Tokens.font-ui;
                                    font-size: 8px;
                                    font-weight: 600;
                                    color: root.show-bus-strip ? Theme.track-bus : #94a3b8;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.show-bus-strip = !root.show-bus-strip; } }
                        }
                    }
                }
            }

            // Dual Channel Strips Side-by-Side (Top-to-Bottom Signal Flow)
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;

                // Strip 1: Selected Track Strip (Professional Signal Flow: Inserts -> EQ -> Pan -> Fader/Meter)
                Rectangle {
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;

                        // Section 1: Channel Strip Header
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "当前通道";
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: root.selected-track-color;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                background: root.selected-track-color.with-alpha(0.18);
                                border-radius: 2px;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "CH 0" + root.selected-track-id;
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 800;
                                        color: root.selected-track-color;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Section 2: Inserts / Effect Slots (Top-to-bottom signal flow)
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "效果器插槽 (INSERTS)";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    letter-spacing: 0.6px;
                                    color: #94a3b8;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "PRE-FADER";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    color: #64748b;
                                    vertical-alignment: center;
                                }
                            }

                            for ins[idx] in root.selected-track-inserts : Rectangle {
                                height: 22px;
                                background: #10141d;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    Text {
                                        text: "" + (idx + 1);
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: #64748b;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: ins;
                                        font-family: Tokens.font-ui;
                                        font-size: 9px;
                                        color: #f1f5f9;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 5px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        background: root.selected-track-color;
                                        y: 8.5px;
                                    }
                                }
                                TouchArea { clicked => { root.focus-devices(); } }
                            }
                        }

                        // Section 3: EQ Curve Thumbnail Preview
                        Rectangle {
                            height: 38px;
                            background: #06080d;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            clip: true;

                            Path {
                                commands: "M 0 28 Q 20 25, 35 12 T 70 18 T 100 24";
                                stroke: root.selected-track-color;
                                stroke-width: 1.8px;
                            }
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-top: 3px;
                                Text {
                                    text: "EQ CURVE";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    letter-spacing: 0.5px;
                                    color: #94a3b8;
                                    font-weight: 700;
                                }
                            }
                        }

                        // Section 4: Pan (声像) Balance Control
                        Rectangle {
                            height: 22px;
                            background: #0a0d14;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: space-between;
                                Text {
                                    text: "PAN";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    font-weight: 700;
                                    color: #94a3b8;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    // Center detent balance bar with dynamic pan position
                                    Rectangle {
                                        width: 24px;
                                        height: 4px;
                                        y: 9px;
                                        background: #141a24;
                                        border-radius: 2px;
                                        Rectangle {
                                            x: root.selected-track-pan == "C" ? 10px : (root.selected-track-pan == "12L" ? 4px : (root.selected-track-pan == "18R" ? 16px : 10px));
                                            width: 4px;
                                            height: 4px;
                                            border-radius: 2px;
                                            background: root.selected-track-color;
                                        }
                                    }
                                    Text {
                                        text: root.selected-track-pan;
                                        font-family: Tokens.font-mono;
                                        font-size: 9px;
                                        font-weight: 800;
                                        color: #f1f5f9;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Section 5: Fader + Meter with clear dB calibration markings
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            height: 108px;

                            // Left dB numerical scale ruler
                            VerticalLayout {
                                alignment: space-between;
                                height: 104px;
                                Text { text: "+6"; font-family: Tokens.font-mono; font-size: 7px; color: #94a3b8; horizontal-alignment: right; }
                                Text { text: " 0"; font-family: Tokens.font-mono; font-size: 7px; font-weight: 800; color: #f8fafc; horizontal-alignment: right; }
                                Text { text: "-6"; font-family: Tokens.font-mono; font-size: 7px; color: #94a3b8; horizontal-alignment: right; }
                                Text { text: "-12"; font-family: Tokens.font-mono; font-size: 7px; color: #94a3b8; horizontal-alignment: right; }
                                Text { text: "-24"; font-family: Tokens.font-mono; font-size: 7px; color: #64748b; horizontal-alignment: right; }
                                Text { text: "-∞"; font-family: Tokens.font-mono; font-size: 7px; color: #64748b; horizontal-alignment: right; }
                            }

                            // Fader rail
                            Rectangle {
                                width: 24px;
                                height: 104px;
                                background: #06080d;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                // Center groove
                                Rectangle {
                                    x: 10px;
                                    y: 4px;
                                    width: 4px;
                                    height: parent.height - 8px;
                                    background: #000000;
                                    border-radius: 1px;
                                }

                                // dB scale tick marks
                                for tick_y in [18px, 36px, 54px, 72px, 90px] : Rectangle {
                                    x: 3px;
                                    y: tick_y;
                                    width: 18px;
                                    height: 1px;
                                    background: #ffffff14;
                                }

                                // Tactile fader cap
                                Rectangle {
                                    x: 1px;
                                    y: root.selected-track-vol == -2.5 ? 42px : (root.selected-track-vol == 0.0 ? 22px : 64px);
                                    width: 22px;
                                    height: 15px;
                                    background: #94a3b8;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #cbd5e1;

                                    Rectangle {
                                        x: 0;
                                        y: 6.5px;
                                        width: parent.width;
                                        height: 2px;
                                        background: root.selected-track-color;
                                    }
                                }
                                TouchArea {
                                    clicked => { root.fader-changed(root.selected-track-vol == -2.5 ? 0.0 : -2.5); }
                                }
                            }

                            // Meter bar
                            Rectangle {
                                width: 8px;
                                height: 104px;
                                background: #06080d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                Rectangle {
                                    x: 0;
                                    y: parent.height - (root.selected-track-peak * parent.height);
                                    width: 8px;
                                    height: root.selected-track-peak * parent.height;
                                    background: root.selected-track-peak > 0.8 ? Theme.status-warn : Theme.status-ok;
                                    border-radius: 2px;
                                }
                            }
                        }

                        // Volume dB numerical badge
                        Rectangle {
                            height: 20px;
                            background: #0a0d14;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "" + root.selected-track-vol + " dB";
                                    font-family: Tokens.font-mono;
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: root.selected-track-color;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Strip 2: Target Group Bus Strip (Collapsible)
                if root.show-bus-strip : Rectangle {
                    background: Theme.bg-surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;

                        // Section 1: Header
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.bus-name;
                                font-family: Tokens.font-ui;
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.track-bus;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                background: Theme.track-bus.with-alpha(0.18);
                                border-radius: 2px;
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: "BUS";
                                        font-family: Tokens.font-mono;
                                        font-size: 7px;
                                        font-weight: 800;
                                        color: Theme.track-bus;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Section 2: Bus Inserts
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "总线效果器 (BUS INSERTS)";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    letter-spacing: 0.6px;
                                    color: #94a3b8;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            for ins[idx] in root.bus-inserts : Rectangle {
                                height: 22px;
                                background: #10141d;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    Text {
                                        text: "" + (idx + 1);
                                        font-family: Tokens.font-mono;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: #64748b;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: ins;
                                        font-family: Tokens.font-ui;
                                        font-size: 9px;
                                        color: #f1f5f9;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        // Section 3: Bus Comp Preview
                        Rectangle {
                            height: 38px;
                            background: #06080d;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            clip: true;

                            Path {
                                commands: "M 0 20 Q 35 18, 55 12 T 100 16";
                                stroke: Theme.track-bus;
                                stroke-width: 1.8px;
                            }
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-top: 3px;
                                Text {
                                    text: "BUS COMP";
                                    font-family: Tokens.font-mono;
                                    font-size: 7px;
                                    letter-spacing: 0.5px;
                                    color: #94a3b8;
                                    font-weight: 700;
                                }
                            }
                        }

                        // Section 4: Bus Pan
                        Rectangle {
                            height: 22px;
                            background: #0a0d14;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: space-between;
                                Text {
                                    text: "PAN";
                                    font-family: Tokens.font-mono;
                                    font-size: 8px;
                                    font-weight: 700;
                                    color: #94a3b8;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "C";
                                    font-family: Tokens.font-mono;
                                    font-size: 9px;
                                    font-weight: 800;
                                    color: #f1f5f9;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Section 5: Bus Fader + Meter with dB scale
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            height: 108px;

                            VerticalLayout {
                                alignment: space-between;
                                height: 104px;
                                Text { text: "+6"; font-family: Tokens.font-mono; font-size: 7px; color: #94a3b8; horizontal-alignment: right; }
                                Text { text: " 0"; font-family: Tokens.font-mono; font-size: 7px; font-weight: 800; color: #f8fafc; horizontal-alignment: right; }
                                Text { text: "-6"; font-family: Tokens.font-mono; font-size: 7px; color: #94a3b8; horizontal-alignment: right; }
                                Text { text: "-12"; font-family: Tokens.font-mono; font-size: 7px; color: #94a3b8; horizontal-alignment: right; }
                                Text { text: "-24"; font-family: Tokens.font-mono; font-size: 7px; color: #64748b; horizontal-alignment: right; }
                                Text { text: "-∞"; font-family: Tokens.font-mono; font-size: 7px; color: #64748b; horizontal-alignment: right; }
                            }

                            Rectangle {
                                width: 24px;
                                height: 104px;
                                background: #06080d;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                Rectangle {
                                    x: 10px;
                                    y: 4px;
                                    width: 4px;
                                    height: parent.height - 8px;
                                    background: #000000;
                                    border-radius: 1px;
                                }

                                for tick_y in [18px, 36px, 54px, 72px, 90px] : Rectangle {
                                    x: 3px;
                                    y: tick_y;
                                    width: 18px;
                                    height: 1px;
                                    background: #ffffff14;
                                }

                                Rectangle {
                                    x: 1px;
                                    y: root.bus-track-vol == -1.0 ? 36px : (root.bus-track-vol == 0.0 ? 22px : 64px);
                                    width: 22px;
                                    height: 15px;
                                    background: #94a3b8;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: #cbd5e1;

                                    Rectangle {
                                        x: 0;
                                        y: 6.5px;
                                        width: parent.width;
                                        height: 2px;
                                        background: Theme.track-bus;
                                    }
                                }
                                TouchArea {
                                    clicked => { root.bus-fader-changed(root.bus-track-vol == -1.0 ? 0.0 : -1.0); }
                                }
                            }

                            Rectangle {
                                width: 8px;
                                height: 104px;
                                background: #06080d;
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                clip: true;

                                Rectangle {
                                    x: 0;
                                    y: parent.height - (root.bus-track-peak * parent.height);
                                    width: 8px;
                                    height: root.bus-track-peak * parent.height;
                                    background: root.bus-track-peak > 0.8 ? Theme.status-warn : Theme.status-ok;
                                    border-radius: 2px;
                                }
                            }
                        }

                        // Bus Volume dB badge
                        Rectangle {
                            height: 20px;
                            background: #0a0d14;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "" + root.bus-track-vol + " dB";
                                    font-family: Tokens.font-mono;
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: Theme.track-bus;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 2: SMART TAG BROWSER
        if root.active-tab == "browser" : VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Search input field
            Rectangle {
                height: 30px;
                background: #06080d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border-subtle;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text {
                        text: "检索";
                        font-family: Tokens.font-ui;
                        font-size: 9px;
                        font-weight: 700;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "搜索音色、插件、采样包...";
                        font-family: Tokens.font-ui;
                        font-size: 10px;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }
            }

            // Tag Filter Pills (Harmonized with track mineral color order)
            HorizontalLayout {
                spacing: 5px;
                height: 22px;

                Rectangle {
                    background: root.active-tag == "all" ? Theme.accent : #10141d;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "all" ? Theme.accent : Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "全部";
                            font-family: Tokens.font-ui;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-tag == "all" ? #020617 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "all";
                            root.select-tag("all");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "Synth" ? Theme.track-synth : #10141d;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "Synth" ? Theme.track-synth : Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "#Synth";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-tag == "Synth" ? #020617 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "Synth";
                            root.select-tag("Synth");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "DSP" ? Theme.status-ok : #10141d;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "DSP" ? Theme.status-ok : Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "#DSP";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-tag == "DSP" ? #020617 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "DSP";
                            root.select-tag("DSP");
                        }
                    }
                }

                Rectangle {
                    background: root.active-tag == "Drums" ? Theme.track-drum : #10141d;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.active-tag == "Drums" ? Theme.track-drum : Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "#Drums";
                            font-family: Tokens.font-mono;
                            font-size: 9px;
                            font-weight: 700;
                            color: root.active-tag == "Drums" ? #020617 : #94a3b8;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.active-tag = "Drums";
                            root.select-tag("Drums");
                        }
                    }
                }
            }

            // Browser Items List
            VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;

                for item in root.browser-items : Rectangle {
                    if root.active-tag == "all" || item.tag == root.active-tag : Rectangle {
                        height: 50px;
                        background: Theme.bg-surface;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 6px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: item.name;
                                    font-family: Tokens.font-ui;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f8fafc;
                                    overflow: elide;
                                }
                                Rectangle {
                                    background: Theme.accent.with-alpha(0.15);
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: "#" + item.tag;
                                            font-family: Tokens.font-mono;
                                            font-size: 8px;
                                            color: Theme.accent;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: item.desc;
                                font-family: Tokens.font-ui;
                                font-size: 9px;
                                color: #94a3b8;
                                overflow: elide;
                            }
                        }
                        TouchArea { clicked => { root.load-item(item.name); } }
                    }
                }
            }
        }
    }
}
