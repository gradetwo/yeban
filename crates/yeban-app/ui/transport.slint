// 夜半 (Yeban) — 顶栏走带控制条 (48px)
//
// 规范来源 (Normative):
//   - [UI-GRID-001] UI/UX 规范 §1.1: TOP CONTROL BAR (48px) = 走带 / BPM /
//     [Branch: main ▼] / [Commit ↺ ↻] / [🟣 AI提案 (1)] / 视图切换
//   - [UI-GRID-002] §1.2: F5/F6 与视图切换按钮的双通道
//   - [UI-TEST-001] §12.2: 语义 Element ID —— 本文件用 `transport-…` 族
//   - [UI-A11Y-003] §7.3: 无障碍树暴露 (accessible-role / -label / -value)
//
// 架构约束 [ARCH-UI-002]: UI 线程绝不直接读音频实时上下文 —— 实时线程只往无锁 Meter SPSC
// 压 60Hz 电平, UI 侧批量出队更新 Slint Properties。本文件出现的所有数值都是**演示数据**,
// 没有任何一处读取真实引擎状态。真实绑定要等 `yeban-engine` 的 `EngineSnapshot` 落地 ——
// 见 docs/ledger/ui-shell-notes.md 的 pending 清单。
//
// 数据流方向 (与 app.slint 的契约): 子组件只"读" (in property) 和"通知" (callback),
// 绝不写自己的状态。唯一写者是 app.slint 的 MainWindow —— 这样不会出现
// 「外部 binding + 组件内部赋值」的冲突, 也不需要双向绑定。
//
// BPM 为什么是 string 而不是 float: 这是**显示值**。数字→字符串的格式化 (小数位、
// 千分位、本地化) 属于模型层的职责; UI 层只画它拿到的字符串。避免在 .slint 里做
// 未核验过的 float→string 隐式转换。

import { Tokens, UiText, UiMonoText } from "tokens.slint";

export component Transport inherits Rectangle {
    in property <bool> playing: false;
    in property <string> timecode: "001.01.000";
    in property <string> bpm-display: "120.00";
    in property <string> branch-name: "main";
    in property <bool> arrangement-view: true;
    in property <bool> ai-drawer-open: false;

    // 时间码的**格式化网格**（每拍 / 每小节的 tick 数）由宿主从投影注入 ——
    // 但注入点是 `MainWindow`（见 app.slint 的 `timecode-ticks-*`），
    // 因为换算发生在 Rust 侧的唯一实现 `bridge::timecode_for_ticks`，
    // 而不是在 `.slint` 里再做一份拍号算术。

    callback toggle-play();
    // 停止 = **停住并回到起始点**（引擎侧是 `Stop` + `SeekTicks(0)` 两条命令，
    // 见 `src/host.rs` 的 `wire_transport`）。它与 `playing` 显示态走同一条注入面。
    callback stop();
    // `ROAD-M4-008` 选项 (a)：**保存当前工程**。
    // 落点由宿主决定，界面**不**自己写盘、也不猜路径：挂了进程内控制面时它走那个会话的
    // 宿主保存动作（那个会话是这份文档的唯一磁盘写者），没挂时走本地原子写。
    // 成功 / 被拒（例如另一个形态正持 `.yeban.lock`）的**原话**由宿主写进
    // `MainWindow.save-status`，由 `status_bar.slint` 画出来。
    callback save-project();
    callback toggle-view();
    callback show-session();
    callback show-arrangement();
    callback toggle-ai-drawer();
    // 顶栏 AI 徽章的唯一动作。它不是"第二个真相源"：`app.slint` 把它原样转到
    // `MainWindow.open-musical-pr`（与右栏 `ai-rail-musical-pr-button` **同一个**回调），
    // 而 `musical-pr-open` 的唯一写者仍是 `host::wire_view_callbacks`。
    callback open-ai-proposals();
    // [UI-A11Y-002] §7.2 输入法合成态：BPM 参数敲入控件里的**真** TextInput 一有
    // preedit（候选词）就置位，上屏 / 取消 / 失焦时清零。宿主（src/host.rs 的
    // wire_input）把它翻成 `InputContext::begin_composition` / `end_composition`
    // —— 界面**不**自己做"合成中"的判断。
    callback ime-composition-changed(bool);
    callback ime-focus-changed(bool);

    min-height: Tokens.top-bar-height;
    max-height: Tokens.top-bar-height;
    background: Tokens.bg-panel;
    border-width: 1px;
    border-color: Tokens.line;

    // ---------------------------------------------------------------- 走带
    // 播放 / 暂停 — [UI-A11Y-001] Space
    Rectangle {
        x: Tokens.space-4;
        y: Tokens.space-4;
        width: 32px;
        height: 32px;
        background: play_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "transport-play-button";
        accessible-label: "播放 / 暂停 (Space)";
        accessible-checkable: true;
        accessible-checked: root.playing;
        // `[UI-A11Y-003]` §7.3：无障碍动作。落点与 `play_area` 的 `clicked` 逐字相同 ——
        // 没有它 accesskit 不给这个节点挂 `Action::Click`，屏读器只能读、不能按。
        accessible-action-default => { root.toggle-play(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.playing ? "‖" : "▶";
            // 播放/走带 = 负责人的 铜绿 (`playing`, 原则 ③)。brand 分支 = #e2c77e = 原来的 `gold`,
            // 所以**品牌调色板** (`--theme brand`, 2026-10-07 之前的默认主题) 下这一处一位未变。
            color: Tokens.playing;
            font-size: Tokens.font-size-xl;
            horizontal-alignment: center;
        }

        play_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.toggle-play(); }
        }
    }

    // 停止 — 回到起始点
    Rectangle {
        x: 44px;
        y: Tokens.space-4;
        width: 32px;
        height: 32px;
        background: stop_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "transport-stop-button";
        accessible-label: "停止 (回到起始点)";
        // `[UI-A11Y-003]` §7.3：落点与 `stop_area` 的 `clicked` 逐字相同。
        accessible-action-default => { root.stop(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "■";
            color: Tokens.ink-1;
            font-size: Tokens.font-size-lg;
            horizontal-alignment: center;
        }

        stop_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.stop(); }
        }
    }

    // 录音 — 规范未定义快捷键, 只登记控件与 ID
    //
    // 圆点 (●) 的颜色是 `Tokens.accent`（2026-10-07 `HD-54`）：负责人裁决「录音键——
    // 落日：唯一带光环的圆」⇒ 整份界面**唯一**的暖强调色落在**录音键**上，AI 徽章
    // 改用别的角色。这里只换**颜色表达式**：`accent` 的 brand 分支 = #d94a4a =
    // `record-red` 的 brand 值（圆点原来画的就是它），所以 `--theme brand`
    //（2026-10-07 之前的默认主题）下一位未变。
    Rectangle {
        x: 80px;
        y: Tokens.space-4;
        width: 32px;
        height: 32px;
        background: rec_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "transport-record-button";
        accessible-label: "录音";
        // **不得**声明 `accessible-checkable`：录音今天没有任何状态（`[ARCH-REC-001]` 只有
        // 规范、没有实现），所以"可勾选"是假话。Slint 的 winit/accesskit 后端只在
        // `accessible-checkable` 为真时才把勾选态交给屏读器
        // （`i-slint-backend-winit-1.18.1/accesskit.rs` 的 `is_checkable` / `is_checked`），
        // 故下面这行留下的 `accessible-checked` 对无障碍树**不再产生任何输出** ——
        // 它只是为了不动 `src/test_port_adapter.rs` 的既有读数而**原样保留**
        // （见判据 `pressing_the_record_button_today_changes_nothing`）。谁真接了录音，
        // 就把这行连同该判据一并改成真实状态源。
        accessible-checked: false;

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "●";
            color: Tokens.accent;
            font-size: Tokens.font-size-lg;
            horizontal-alignment: center;
        }

        rec_area := TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }

    // ---------------------------------------------------------------- BPM
    // 参数敲入类控件: 规范 §7.2 明文要求这类控件挂 `is_composing` 防护。
    //
    // **事件源就在这里**：`bpm-input` 是真的 Slint `TextInput`（上一版只有
    // `role=text-input` 的占位矩形 + 一句"随模型线落地"的注释 —— 合成事件根本没有源）。
    // 上游把输入法的候选词写进 `TextInput.preedit-text`
    // （`i-slint-compiler-1.18.1/builtin_elements.rs:2323` 的 `out property <string> preedit-text`，
    // 由 winit 后端的 `Ime::Preedit` 事件驱动：`i-slint-backend-winit-1.18.1/winitwindowadapter.rs:1429`），
    // 因此"是否正在合成"在 `.slint` 侧只有一个判据：preedit 非空。
    //
    // 这两个 `changed` 处理器**只通知**（callback），不自己保存任何状态 ——
    // 状态的唯一载体是 `src/input.rs` 的 `InputContext`（宿主 `wire_input` 写它）。
    Rectangle {
        x: 120px;
        y: Tokens.space-4;
        width: 96px;
        height: 32px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line-strong;
        accessible-role: text-input;
        accessible-id: "transport-bpm-field";
        accessible-label: "速度 BPM";
        accessible-value: root.bpm-display;
        accessible-read-only: false;

        UiMonoText {
            x: Tokens.space-4;
            y: 0;
            width: 40px;
            height: parent.height;
            text: "BPM";
            color: Tokens.ink-2;
            font-size: Tokens.font-size-xs;
        }

        // 真正的编辑面（数值校验 / 提交回模型仍属后续线：本线只接**合成态事件源**）。
        // 它**不**挂 accessible-id —— 语义节点仍然只有外层那一个 `transport-bpm-field`
        // （`[UI-TEST-001]` §12.2：`ui/coverage` 要求运行时树 ⊆ 投影注册表，
        // 而多出来的节点必须有登记；编辑面不是语义节点，因此不进树）。
        bpm-input := TextInput {
            x: 44px;
            y: 0;
            width: parent.width - 48px;
            height: parent.height;
            text: root.bpm-display;
            // BPM 是**数值读数** ⇒ 必须与 UiMonoText 同族, 否则它与时间码的
            // 数字宽度不同源, 两处读数不会对齐 (负责人 mock: BPM 与时间码同列)。
            // TextInput 不继承 UiText, 所以这里显式写族名。
            font-family: Tokens.font-mono;
            color: Tokens.gold;
            font-size: Tokens.font-size-lg;
            horizontal-alignment: right;
            vertical-alignment: center;
            single-line: true;
            read-only: false;

            changed preedit-text => {
                root.ime-composition-changed(self.preedit-text != "");
            }
            changed has-focus => {
                root.ime-focus-changed(self.has-focus);
            }
        }
    }

    // 时间码液晶屏 — [UI-MCP-002] 高频刷新区域, 无头截图比对前必须被动态遮罩
    Rectangle {
        x: 224px;
        y: Tokens.space-4;
        width: 128px;
        height: 32px;
        background: Tokens.bg-void;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.line-strong;
        accessible-role: text;
        accessible-id: "transport-timecode";
        accessible-label: "主时间码";

        UiMonoText {
            x: Tokens.space-4;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            text: root.timecode;
            color: Tokens.gold-bright;
            font-size: Tokens.font-size-lg;
        }
    }

    // 竖分隔线 (纯装饰, 不挂无障碍属性)
    Rectangle {
        x: 360px;
        y: Tokens.space-5;
        width: 1px;
        height: 24px;
        background: Tokens.line-strong;
    }

    // ------------------------------------------------- 分支 / 提交 / 回滚
    Rectangle {
        x: 372px;
        y: Tokens.space-4;
        width: 128px;
        height: 32px;
        background: Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: combobox;
        accessible-id: "transport-branch-button";
        accessible-label: "当前分支";
        accessible-value: root.branch-name;

        UiText {
            x: Tokens.space-4;
            y: 0;
            width: parent.width - 24px;
            height: parent.height;
            text: "分支: " + root.branch-name;
            color: Tokens.ink-0;
            font-size: Tokens.font-size-md;
        }
    }

    // Commit — 规范 ASCII 图的 ↺
    Rectangle {
        x: 508px;
        y: Tokens.space-4;
        width: 32px;
        height: 32px;
        background: commit_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "transport-commit-button";
        accessible-label: "提交当前编辑为一个 Commit";

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "↺";
            color: Tokens.gold;
            font-size: Tokens.font-size-lg;
            horizontal-alignment: center;
        }

        commit_area := TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }

    // 回滚 — 规范 ASCII 图的 ↻
    Rectangle {
        x: 544px;
        y: Tokens.space-4;
        width: 32px;
        height: 32px;
        background: revert_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "transport-revert-button";
        accessible-label: "回滚到上一个 Commit";

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "↻";
            color: Tokens.ink-1;
            font-size: Tokens.font-size-lg;
            horizontal-alignment: center;
        }

        revert_area := TouchArea {
            width: parent.width;
            height: parent.height;
        }
    }

    // 保存 — `ROAD-M4-008` 选项 (a)：用户够得到的保存入口。
    //
    // 位置：紧随"分支 / 提交 / 回滚"这一组**文档级**动作（保存也是文档级动作，
    // 而回滚那条线右边是 AI 提案徽章，语义上不该插进去）。
    // `TouchArea` 是**唯一**的点击源，`clicked` 只调 `save-project()` 回调 ——
    // 界面不写盘、不改任何属性（成功/失败的原话由宿主写 `MainWindow.save-status`）。
    //
    // 底色是 `Tokens.bg-control` 而**不是** `bg-panel-alt`（2026-10-06 修）：本控件右边缘
    // 636 px、AI 提案徽章左边缘 640 px，两者只隔 **4 px**，用同一个 `bg-panel-alt`
    // 就会在顶栏并排出现两块一模一样的亮色板（负责人报的缺陷）。`bg-control` 在
    // `--theme brand`（2026-10-07 之前的默认主题）下的取值**就是** `#1b2447`
    // （= 原来的 `bg-panel-alt`），所以**品牌分支**的渲染一位未变；默认主题现在是
    // `--theme default` = yeban，它取 §6c 的绀灰 #1e2733（比徽章板亮 1.11:1）。
    Rectangle {
        x: 580px;
        y: Tokens.space-4;
        width: 56px;
        height: 32px;
        background: save_area.pressed ? Tokens.bg-raised : Tokens.bg-control;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "transport-save-button";
        accessible-label: "保存工程";
        // `[UI-A11Y-003]` §7.3：落点与 `save_area` 的 `clicked` 逐字相同。
        accessible-action-default => { root.save-project(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "保存";
            color: Tokens.gold;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }

        save_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.save-project(); }
        }
    }

    // ------------------------------------------------- AI 提案徽章 (§10 Musical PR 入口)
    //
    // ⚠ 诚实性（2026-10-08）：这一处曾经是**假控件 + 假状态**三连 ——
    //   ① `accessible-role: button` 却**没有** `TouchArea`、没有回调、没有人能点；
    //   ② `accessible-value: "1"` 与可见文案 "AI提案 (待审查)" 声称"有 1 条待审查提案"，
    //      而**没有任何宿主写者**（`git grep 'ai-proposal-badge'` 只命中语义注册表与测试）
    //      ⇒ 那个"1"是编造的；同一件事的载体 `MusicalPrDrawer` 此刻也如实显示 0 条
    //      （`ui/dialogs/musical_pr_drawer.slint` 的空态）。两处互相矛盾，用户看到的
    //      是这枚徽章。
    //   ② 的处置 = **删掉假读数**；① 的处置 = **真接一个存在的动作**：点它打开同一个
    //      提案抽屉（`open-ai-proposals` → `app.slint` → `open-musical-pr`，与右栏
    //      `ai-rail-musical-pr-button` 落到同一个宿主写者）。
    // 未改的：几何（`x: 640px` / 120 × 32）与描边色 —— `ADR-0003` 的槽位裁决与
    // `tests/theme_selection.rs` 对 `Tokens.ai-suggestion` 的判据都依赖它们。
    // 判据：`crates/yeban-app/tests/undo_tree_honesty.rs` 的
    // `the_ai_badge_claims_no_pending_proposal_and_has_a_real_action`。
    //
    // 描边用 `Tokens.ai-suggestion`（2026-10-07 `HD-54` 改）：整份界面**唯一**的暖强调色
    // 已移到**录音键**的 ● 上，AI 徽章因此**另找角色**。这一处原来画的是 `accent`，
    // 而 `accent` 移动前的 brand 值就是 `#a855f7` (= `ai-suggestion` 的 brand 分支)，
    // 所以 `--theme brand`（2026-10-07 之前的默认主题）下这 1 px 描边一位未变。三支自绘皮肤下它现在拿到的是
    // 愁眠 / 愁眠 / 归雁的**冷**色（对 bg-panel-alt 4.89 / 6.10 / 5.93:1，≥ 3:1），
    // 暖强调确实不在徽章上了。`ai-suggestion` 本身仍按 §9.1 的语义用在钢琴卷帘的
    // AI 建议层（45% 半透明 + 虚线描边），**没有**改语义。
    Rectangle {
        x: 640px;
        y: Tokens.space-4;
        width: 120px;
        height: 32px;
        background: proposal_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Tokens.ai-suggestion;
        accessible-role: button;
        accessible-id: "transport-ai-proposal-badge";
        // 标签**只描述动作**，不再声称"有待审查的提案"（那个读数没有数据源）。
        accessible-label: "打开 AI 编曲提案审核抽屉";
        // `[UI-A11Y-003]` §7.3：落点与 `proposal_area` 的 `clicked` 逐字相同。
        accessible-action-default => { root.open-ai-proposals(); }
        // ⛔ 这里**不许**再出现 `accessible-value`：提案条数今天没有数据源，
        // 任何写死的数字都是编造的读数。条数的**唯一**诚实来源是提案抽屉自己的
        // `accessible-value`（= `MusicalPrDrawer.proposal-count`，此刻为 `"0"`）。

        UiText {
            x: Tokens.space-4;
            y: 0;
            width: parent.width - 8px;
            height: parent.height;
            // ⛔ 这里**不许**再出现 "(待审查)"：它声称的状态没有数据源。
            text: "AI提案";
            // AI 文案 = 负责人的 愁眠 (`selection`, 原则 ③「AI=愁眠」); brand 分支 = #f7e6b0
            // = 原来的 `gold-bright` ⇒ **品牌分支**一位未变（它在 2026-10-07 之前是默认主题）。
            color: Tokens.selection;
            font-size: Tokens.font-size-md;
        }

        // 唯一的点击源：把"一个看起来像按钮的东西"变成**真的**按钮。
        // 它只发一个回调；`musical-pr-open` 的写者仍是宿主（没有第二个真相源）。
        proposal_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.open-ai-proposals(); }
        }
    }

    // ------------------------------------------------- 视图切换 [UI-GRID-002]
    Rectangle {
        x: root.width - 304px;
        y: Tokens.space-4;
        width: 92px;
        height: 32px;
        background: !root.arrangement-view ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: tab;
        accessible-id: "transport-view-session-button";
        accessible-label: "Session 触发矩阵 (F5)";
        accessible-item-selected: !root.arrangement-view;
        accessible-item-selectable: true;
        // `[UI-A11Y-003]` §7.3：落点与 `view_session_area` 的 `clicked` 逐字相同。
        accessible-action-default => { root.show-session(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "Session";
            color: !root.arrangement-view ? Tokens.selection : Tokens.ink-2;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }

        view_session_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.show-session(); }
        }
    }

    Rectangle {
        x: root.width - 208px;
        y: Tokens.space-4;
        width: 104px;
        height: 32px;
        background: root.arrangement-view ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: tab;
        accessible-id: "transport-view-arrangement-button";
        accessible-label: "Arrangement 时间轴 (F6)";
        accessible-item-selected: root.arrangement-view;
        accessible-item-selectable: true;
        // `[UI-A11Y-003]` §7.3：落点与 `view_arr_area` 的 `clicked` 逐字相同。
        accessible-action-default => { root.show-arrangement(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "Arrangement";
            color: root.arrangement-view ? Tokens.selection : Tokens.ink-2;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }

        view_arr_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.show-arrangement(); }
        }
    }

    // Tab 键在画布聚焦时切换视图 (键盘映射住在 src/input.rs, 这里只是可点等价物)
    Rectangle {
        x: root.width - 96px;
        y: Tokens.space-4;
        width: 32px;
        height: 32px;
        background: toggle_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "transport-view-toggle-button";
        accessible-label: "切换 Session / Arrangement (Tab, 仅画布聚焦时)";
        // `[UI-A11Y-003]` §7.3：落点与 `toggle_area` 的 `clicked` 逐字相同。
        accessible-action-default => { root.toggle-view(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "⇄";
            color: Tokens.ink-0;
            font-size: Tokens.font-size-lg;
            horizontal-alignment: center;
        }

        toggle_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.toggle-view(); }
        }
    }

    // ------------------------------------------------- 右侧 AI 协作栏抽屉开关
    Rectangle {
        x: root.width - 56px;
        y: Tokens.space-4;
        width: 32px;
        height: 32px;
        background: drawer_area.pressed ? Tokens.bg-raised : Tokens.bg-panel-alt;
        border-radius: Tokens.radius-md;
        accessible-role: button;
        accessible-id: "transport-ai-drawer-button";
        accessible-label: "AI 协作栏抽屉 (Cmd/Ctrl + 反斜杠)";
        accessible-expandable: true;
        accessible-expanded: root.ai-drawer-open;
        // `[UI-A11Y-003]` §7.3：落点与 `drawer_area` 的 `clicked` 逐字相同。
        accessible-action-default => { root.toggle-ai-drawer(); }

        UiText {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: "AI";
            color: Tokens.gold;
            font-size: Tokens.font-size-md;
            horizontal-alignment: center;
        }

        drawer_area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.toggle-ai-drawer(); }
        }
    }
}
